@page
@model QD.ERP.IMS.Areas.IMS.Pages.StoreStockAvalibilitysModel
    
@{
    var salesOrderNoFromQuery = ViewContext.HttpContext.Request.Query["salesOrderNo"].ToString();
}

<style>
    .mainContainer{
        width:100%;
    }

    .dx-button-text{
        color:black;
    }
    .titleCard-toggle1 {
        display: none;
    }
</style>
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders

<div class="dx-card-container">
    <div class="dx-card-header minimal-header">
        <div class="card-title-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div id="StoreStockAvalibility" class="titleText no-border-title"></div>
    </div>
</div>

<div style=" padding: 0px 20px;display: flex; align-items: center; gap: 10px;">

    @(Html.DevExtreme().DropDownBox()
        .ID("storeBox")
        .ValueExpr("StoreId")
        .DisplayExpr("StoreName")
        .DataSource(ds => ds
        .Mvc()
        .Controller("SalesOrders")
        .LoadAction("GetStoreToIssueItem")
        .LoadParams(new { salesOrderNo = salesOrderNoFromQuery }) // ✅ Pass query param
        .LoadMode(DataSourceLoadMode.Raw)
        .Key("StoreId")
        )
        .Label("Select the Store to Issue Items:")
        .LabelMode(EditorLabelMode.Floating)
        .DropDownOptions(options => options.Width(450))
        .Value(null)
        .Width(250)
        .ContentTemplate(new TemplateName("StoreToIssueItemDropDownTemplate"))
        )
    

    @(Html.DevExtreme().Button()
            .ID("prepareDeliveryNoteBtn")
            .Text("Prepare Delivery Note")
            .Icon("save")
            .Type(ButtonType.Default)
            .StylingMode(ButtonStylingMode.Contained))
</div>
<div style="padding:10px 20px;">
    @(Html.DevExtreme().DataGrid()
        .ID("deliveryNoteGrid")
        .ShowBorders(true)
        .ColumnAutoWidth(true)
        .Height(250)
        .Selection(s => s.Mode(SelectionMode.Multiple).ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always))
        .Columns(columns =>
        {
            columns.Add().Type(GridCommandColumnType.Selection).Width(40);
            columns.Add().DataField("IsServicesGroup").Caption("Service");
            columns.Add().DataField("SalesOrderChildId").Caption("Order ID");
            columns.Add().DataField("Gscode").Caption("GS Code");
            columns.Add().DataField("Gsdescrpition").Caption("Stock Description");
            columns.Add().DataField("UnitDesc").Caption("Unit");
            columns.Add().DataField("TotalOrderedQty").Caption("Total Ordered Qty");
            columns.Add().DataField("TotalIssdQty").Caption("Total Issd Qty");
            columns.Add().DataField("BalanceToDeliver").Caption("Balance To Deliver");
            columns.Add().DataField("CurrentyQty").Caption("Current Qty In Ordered Unit");
            columns.Add().DataField("AvailabilityStatus").Caption("Availability Status");
            columns.Add().DataField("DeliveringQuantity").Caption("Delivering Quantity");
        }))
</div>
<div id="pivotGridContainer" style="padding: 0 20px;"></div>
@using (Html.DevExtreme().NamedTemplate("StoreToIssueItemDropDownTemplate"))
{
    @(Html.DevExtreme().DataGrid()
            .ID("StoreToIssueItemDropDown")
            .DataSource(ds => ds
                .Mvc()
                .Controller("SalesOrders")
                .LoadAction("GetStoreToIssueItem")
                .LoadParams(new { salesOrderNo = salesOrderNoFromQuery }) // ✅ Pass here too
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("StoreId")
            )
            .Height(300)
            .ShowBorders(true)
            .FilterRow(f => f.Visible(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Selection(s => s.Mode(SelectionMode.Single))
            .Columns(columns =>
            {
                columns.Add().DataField("StoreId").Caption("Store Id");
                columns.Add().DataField("StoreName").Caption("Store Name");
            })
            .OnSelectionChanged("StoretoIssueItems")
        )
}
