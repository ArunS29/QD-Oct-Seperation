        }
    });
             // Helper: Returns true if row is already delivered (customize as needed)
            function isRowDelivered(rowData) {
                // Adjust this logic if you have a different field for delivery status
                return rowData.BalanceToDeliver === 0 || rowData.AvailabilityStatus === "Delivered";
            }
    function loadGridData(storeId) {
        if (!salesOrderNoFromQuery || !storeId) return;

        const grid = $("#deliveryNoteGrid").dxDataGrid("instance");

        $.ajax({
            url: '/api/SalesOrders/GetStoreStockGrid',
            type: 'GET',
            data: {
                salesOrderNo: salesOrderNoFromQuery,
                storeId: storeId
            },
                    success: function (data) {
                        grid.option("dataSource", data);
                        // Deselect delivered rows after data load
                        setTimeout(function () {
                            const deliveredKeys = data.filter(isRowDelivered).map(r => r.SalesOrderChildId);
                            grid.deselectRows(deliveredKeys);
                        }, 100);
                    },
            error: function () {
                DevExpress.ui.notify("Failed to load store stock data.", "error", 3000);
            }
        });
    }


       function StoretoIssueItems(e) {
        const selected = e.selectedRowsData[0];
        if (selected) {
            const dropDownBox = $("#storeBox").dxDropDownBox("instance");
            if (dropDownBox) {
                dropDownBox.option("value", selected.StoreId);
                dropDownBox.close();

                // ✅ Only load delivery grid for selected store
                loadGridData(selected.StoreId);
            }
        }
    }
 // ...existing code...

$(function () {
    const buttonInstance = $("#prepareDeliveryNoteBtn").dxButton("instance");

    if (buttonInstance) {
        buttonInstance.option("onClick", function () {
            const grid = $("#deliveryNoteGrid").dxDataGrid("instance");
            const selectedData = grid.getSelectedRowsData();

            if (!selectedData || selectedData.length === 0) {
                DevExpress.ui.notify("Please select at least one row.", "warning", 3000);
                return;
            }

            // Only allow undelivered rows
            const undeliveredRows = selectedData.filter(function(row) {
                return row.BalanceToDeliver !== 0 && row.AvailabilityStatus !== "Delivered";
            });

            if (undeliveredRows.length === 0) {
                DevExpress.ui.notify("Selected row was already Created DeliveryNote.", "warning", 2000);
                return;
            }

            // Get all selected SalesOrderChildIds from undelivered rows
            const salesOrderChildIds = undeliveredRows
                .map(row => row.SalesOrderChildId)
                .filter(id => id != null);

            if (salesOrderChildIds.length === 0) {
                DevExpress.ui.notify("Selected rows do not have valid SalesOrderChildId.", "error", 3000);
                return;
            }

            const tenantName = window.tenantName || "defaultTenant";
            const firstChildId = salesOrderChildIds[0];

            $.get("/api/SalesOrders/GetSalesOrderNoByChildId", { salesOrderChildId: firstChildId })
                .done(function (res) {
                    if (res.success) {
                        const salesOrderNo = res.salesOrderNo;

                        // Step 2: Generate Delivery Note No
                        $.get("/api/DeliveryNote/GetAutoGeneratedDeliveryNoteNumberForTenant", {
                            tenantName,
                            salesOrderNo
                        })
                        .done(function (dnRes) {
                            if (dnRes.success) {
                                const deliveryNoteNo = dnRes.deliveryNoteNo;

                                // Step 3: Pass all selected SalesOrderChildIds in query string
                                const query = salesOrderChildIds.map(id => `salesOrderChildId=${id}`).join("&");
                                const url = `/${tenantName}/IMS/DeliveryEditForm?deliveryNoteNo=${encodeURIComponent(deliveryNoteNo)}&${query}&mode=create`;

                                window.location.href = url;
                            } else {
                                DevExpress.ui.notify(dnRes.message || "Failed to generate Delivery Note No.", "error", 3000);
                            }
                        })
                        .fail(function (xhr) {
                            const msg = xhr.responseJSON?.message || "Failed to generate Delivery Note No.";
                            DevExpress.ui.notify(msg, "error", 3000);
                        });
                    } else {
                        DevExpress.ui.notify("Failed to find Sales Order for selected child row.", "error", 3000);
                    }
                })
                .fail(function () {
                    DevExpress.ui.notify("Error fetching SalesOrderNo by child ID.", "error", 3000);
                });
        });
    } else {
        console.error("prepareDeliveryNoteBtn not initialized yet.");
    }
});

            // Patch: On grid ready, set up row styling and selection logic
            $(function () {
                const grid = $("#deliveryNoteGrid").dxDataGrid("instance");
                if (!grid) return;

                grid.option({
                    onRowPrepared: function (e) {
                        if (e.rowType === "data" && isRowDelivered(e.data)) {
                            e.rowElement.css({ background: "#f5f5f5", color: "#aaa" });
                        }
                    },
                    onSelectionChanged: function (e) {
                        // Deselect delivered rows if user tries to select them
                        const grid = e.component;
                        const deliveredKeys = e.selectedRowsData
                            .filter(isRowDelivered)
                            .map(r => r.SalesOrderChildId);

                        if (deliveredKeys.length > 0) {
                            grid.deselectRows(deliveredKeys);
                            DevExpress.ui.notify("Already delivered rows cannot be selected.", "warning", 2000);
                        }
                    }
                });
            });
</script>
