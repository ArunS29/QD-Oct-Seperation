          function loadPivotGridDataForAllStores() {
        if (!salesOrderNoFromQuery) return;

        $.ajax({
            url: '/api/SalesOrders/GetStoreStockGrid',
            type: 'GET',
            data: {
                salesOrderNo: salesOrderNoFromQuery
            },
            success: function (data) {
                const pivotInstance = $("#pivotGridContainer").dxPivotGrid("instance");

                if (pivotInstance) {
                    pivotInstance.option("dataSource", {
                        store: {
                            type: "array",
                            data: data
                        },
                        fields: [
                            { dataField: "StoreCode", caption: "Store", area: "row" },
                            { dataField: "Gscode", caption: "GS Code", area: "row" },
                            { dataField: "Gsdescrpition", caption: "GS Description", area: "column" },
                            { dataField: "UnitDesc", caption: "Ordered UOM", area: "column" },
                            { dataField: "TotalOrderedQty", caption: "Ordered Qty", area: "data", dataType: "number", summaryType: "sum" },
                            { dataField: "TotalIssdQty", caption: "Issued Qty", area: "data", dataType: "number", summaryType: "sum" },
                            { dataField: "CurrentyQty", caption: "Current Stock", area: "data", dataType: "number", summaryType: "sum" },
                            { dataField: "BalanceToDeliver", caption: "Balance", area: "data", dataType: "number", summaryType: "sum" }
                        ]
                    });
                }
            },
            error: function () {
                DevExpress.ui.notify("Failed to load pivot grid data.", "error", 3000);
            }
        });
    }

