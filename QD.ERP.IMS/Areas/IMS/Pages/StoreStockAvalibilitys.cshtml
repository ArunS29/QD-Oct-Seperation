         //Costcenter

      // ✅ Define salesOrderNoFromQuery at top
    const salesOrderNoFromQuery = new URLSearchParams(window.location.search).get("salesOrderNo");

    $(function () {
        if (salesOrderNoFromQuery) {
            // ✅ Load pivot grid for all stores immediately on page load
