<div class="dx-fieldset horizontal-container">
	

	@(Html.DevExtreme().DateBox()
		.ID("endDateBox")
		.Label(new JS("formatMessage('End Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(3)
		)

	@(Html.DevExtreme().DropDownButton()
		.ID("ddBtnShowRecords")
		.Text(new JS("formatMessage('Show Records')"))
		.Icon("smalliconslayout")
		.Width(180)
		.ElementAttr("class", "button-alignment-up")
		.TabIndex(4)
		.SplitButton(true)
		.OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }") // MAIN button click
				.DropDownOptions(options => options.Width(230))
				.Items(items =>
				{
					items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").Option("color", "#4285F4").OnClick("function() { ddBtnShowRecords_click('range'); }");
					items.Add().Text(new JS("formatMessage('Today')")).Icon("event").Option("color", "#34A853").OnClick("function() { ddBtnShowRecords_click('today'); }");
					items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").Option("color", "#EA4335").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
					items.Add().Text(new JS("formatMessage('By Quarter')")).Icon("event").Option("color", "#00ACC1").OnClick("quarterSubMenu");
					items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").Option("color", "#FBBC05").OnClick("function() { ddBtnShowRecords_click('week'); }");
					items.Add().Text(new JS("formatMessage('This Month Till Date')")).Option("color", "#AB47BC").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
					items.Add().Text(new JS("formatMessage('This Month (Full)')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
					items.Add().Text(new JS("formatMessage('This Year Till Date')")).Option("color", "#FF7043").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
					items.Add().Text(new JS("formatMessage('This Year (Full)')")).Option("color", "#4285F4").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
					items.Add().Text(new JS("formatMessage('Last Month')")).Option("color", "#FBBC05").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
					items.Add().Text(new JS("formatMessage('Last Year')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
				})
				.ItemTemplate(@<text>
            <div class="custom-dropdown-item" >
                  <div style="background-color:<%- color %>;height:90%" class="side-bar"></div>
                <div class="item-content">
                    <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                    <div>
                        <div class="item-title"><%- text %></div>
                    </div>
                </div>
            </div>
        </text>)
		)


</div>
<div class="dx-field ledgerResult">
	@(Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.Qry665MtlStockMasterAvgCost03WtDetail002>()
		.ID("dataGrid")
		.RemoteOperations(false)
		.DataSource(new JS("[]"))
		.Columns(columns =>
		{
				columns.Add().Caption(new JS("formatMessage('Stock Details')")).Columns(subColumns =>
			{
				subColumns.AddFor(m => m.IsServicesGroup).Caption(new JS("formatMessage('Is Services Group')")).Alignment(HorizontalAlignment.Center).CellTemplate(@<text>
		<div class="dx-icon">
			<%= data.IsSubmitted ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
		</div>
	</text>).Visible(true);
				subColumns.AddFor(m => m.ReceiptNo).Caption(new JS("formatMessage('Document No')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.TransactionDate).Caption(new JS("formatMessage('Transaction Date')")).Alignment(HorizontalAlignment.Center).Format("dd-MMM-yyyy").Visible(true);
				subColumns.AddFor(m => m.Transactions).Caption(new JS("formatMessage('Transaction Type')")).Alignment(HorizontalAlignment.Center).Visible(true);
								subColumns.AddFor(m => m.Gscode).Caption(new JS("formatMessage('Item Code')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Gscode).Caption(new JS("formatMessage('Item Code')")).Alignment(HorizontalAlignment.Center).Visible(true).GroupIndex(0);
				subColumns.AddFor(m => m.Gsdescrpition).Caption(new JS("formatMessage('Stock Description')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.UnitDesc).Caption(new JS("formatMessage('Unit')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.StockReceivedQty).Caption(new JS("formatMessage('Quantity')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.UnitPrice).Caption(new JS("formatMessage('Unit Price')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.TransactionTotal).Caption(new JS("formatMessage('Transaction Total')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.GsgroupName).Caption(new JS("formatMessage('GS Group Name')")).Alignment(HorizontalAlignment.Center).Visible(true);

				// Unused fields (hidden but available in data model)
				subColumns.AddFor(m => m.QtyReceived)
			.Caption(new JS("formatMessage('Qty Received')"))
			.Visible(false);

				subColumns.AddFor(m => m.UnitCodeOfConversion)
			.Caption(new JS("formatMessage('Unit Code of Conversion')"))
			.Visible(false);

				subColumns.AddFor(m => m.UnitsConverted)
			.Caption(new JS("formatMessage('Units Converted')"))
			.Visible(false);

				subColumns.AddFor(m => m.StockReceivedUnitPrice)
			.Caption(new JS("formatMessage('Stock Received Unit Price')"))
			.Visible(false);

				subColumns.AddFor(m => m.StoreCode)
			.Caption(new JS("formatMessage('Store Code')"))
			.Visible(false);

				subColumns.AddFor(m => m.UnitDesc)
			.Caption(new JS("formatMessage('Unit Description')"))
			.Visible(false);


			});
		})
		.Height("70vh") // Fixed height for the grid
		.ColumnAutoWidth(true)
		.Width("98%")
		.WordWrapEnabled(true)
		.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.Paging(p => p.PageSize(10)) // Set desired page size (e.g., 10 rows per page)
		.Pager(pager =>
		{
			pager.ShowPageSizeSelector(true);
			pager.AllowedPageSizes(new[] { 5, 10, 20, 50 });
			pager.ShowNavigationButtons(true);
			pager.Visible(true);
		})

		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.ShowRowLines(true)
		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.StateStoring(stateStoring =>
		{
			stateStoring
			.Enabled(true)
			.Type(StateStoringType.LocalStorage)
			.StorageKey("gridContainerState");
		})
		.Summary(summary =>
		{
			summary.GroupItems(items =>
			{
				items.Add().Column("ReceiptNo")
			.SummaryType(SummaryType.Count)
			.ShowInGroupFooter(true)
			.CustomizeText(@"
		function(e) {
		if (e.value === null || e.value === undefined) {
		return '';
		}
		return 'No of Items: ' + e.value;
		}
		");
				items.Add().Column("StockReceivedQty")
			.SummaryType(SummaryType.Sum)
			.ShowInGroupFooter(true)
			.CustomizeText(@"
		function(e) {
		if (e.value === null || e.value === undefined) {
		return '';
		}
		return 'SUM: ' + e.value.toLocaleString(undefined, {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2
		});
		}
		");
				items.Add().Column("TransactionTotal")
			.SummaryType(SummaryType.Sum)
			.ShowInGroupFooter(true)
			.CustomizeText(@"
		function(e) {
		if (e.value === null || e.value === undefined) {
		return '';
		}
		return 'SUM: ' + e.value.toLocaleString(undefined, {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2
		});
		}
		");
			});

			summary.TotalItems(items =>
			{
				

				items.Add().Column("TransactionTotal")
			.SummaryType(SummaryType.Sum)
			.CustomizeText(@"
		function(e) {
		if (e.value === null || e.value === undefined) {
		return '';
		}
		return 'SUM:' + e.value.toLocaleString(undefined, {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2
		});
		}
		");
			});

		})
		)




</div>
<div id="invoiceErrorPopup"></div>
<script>
		 $(function () {
	$("#stockMovementReport").dxTextBox({
	text: formatMessage("Stock Movement Report"),
		readOnly: true,
		onContentReady: function (e) {
		$(e.element).addClass("dx-textbox-heading");
		}
		});
	});
		$(function () {
		var now = new Date();
		$("#endDateBox").dxDateBox("instance").option("value", now);
		ddBtnShowRecords_click('today');
	});

		function ddBtnShowRecords_click(duration) {
		var toDateBox = $("#endDateBox").dxDateBox("instance");
		var currentDate = new Date();
		var toDate = new Date(toDateBox.option("value"));

		switch (duration) {
			case 'today':
				toDate = currentDate;
				break;
			case 'yesterday':
				toDate = new Date(currentDate.setDate(currentDate.getDate() - 1));
				break;
			case 'week':
				// End of the current week (Saturday)
				var dayOfWeek = currentDate.getDay();
				var endOfWeek = currentDate.getDate() + (6 - dayOfWeek);
				toDate = new Date(currentDate.setDate(endOfWeek));
				break;
			case 'tillmonth':
				// Till today of current month
				toDate = new Date();
				break;
			case 'fullmonth':
				// Full current month
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				// Till today of this year
				toDate = new Date();
				break;
			case 'fullyear':
				// End of this year
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastmonth':
				// Last day of previous month
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
			case 'lastyear':
				// End of last year
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'q1':
				toDate = new Date(currentDate.getFullYear(), 2, 31);
				break;
			case 'q2':
				toDate = new Date(currentDate.getFullYear(), 5, 30);
				break;
			case 'q3':
				toDate = new Date(currentDate.getFullYear(), 8, 30);
				break;
			case 'q4':
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
		}

		hidequarterSubmenus();

		// Set value in UI
		toDateBox.option("value", toDate);

		// Convert to yyyy-MM-dd
		var formattedDate = toDate.toISOString().split('T')[0];

		// 🔹 Call the backend API using only toDate
		$.ajax({
			url: '/api/StockInventory/GetStockMomentReport',
			type: 'GET',
			data: { toDate: formattedDate },
			success: function (data) {
				console.log("Returned Data: ", data);
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
			},
			error: function (xhr) {
				console.log("AJAX Error", xhr.responseText);
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}



</script>