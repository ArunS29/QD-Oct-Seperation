@page
@model QD.ERP.IMS.Areas.IMS.Pages.AdditionalCostOnItemsModel
@{
}
<style>

    .dx-datagrid-column-chooser-button {
        display: none !important;
    }

    .dx-fieldset {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 15px;
        padding: 20px;
        background-color: transparent;
        width: 250px;
        height: 10%;
    }


    .dx-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-left: 10px;
    }

    .field-label {
        font-weight: bold;
    }

    .aligned-input {
        width: 100%;
    }

    .input-group {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .dx-textarea {
        width: 100%;
        height: 60px;
    }

    .dx-card {
        width: 1000px;
        background: var(--background-color);
    }

    .limited-footer .btn-container:not(:has(#btnUpdate,#btnBack)) {
        display: none !important;
    }

    .container {
        display: none !important;
    }

    .dx-button-text {
        color: black;
    }

    .input-button {
        color: black;
    }

    .dx-button-mode-contained.dx-button-success .dx-icon {
        color: black;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .playIcon {
        display: none;
    }

    .dx-label-cell {
        text-align: right;
        font-weight: bold;
        padding-right: 8px;
        white-space: nowrap;
    }

    .dx-field-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 10px 6px;
    }

        .dx-field-table td {
            vertical-align: middle;
        }

    .form-header {
        color: white;
        padding: 10px;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
    }
</style>



<table class="dx-field-table" style="padding:10px;">
    <tr>
        <td>
            @(Html.DevExtreme().TextBox()
                .ID("QuotationNo")
                .LabelMode(EditorLabelMode.Floating)
                        .ReadOnly(true)
                        .Label(new JS("formatMessage('Quotation No')")))
        </td>

        <td>
            @(Html.DevExtreme().TextBox()
                .ID("StockCode")
                .LabelMode(EditorLabelMode.Floating)
                .ReadOnly(true)
                .Label(new JS("formatMessage('Stock Item Code:')")))
        </td>

        <td>
            @(Html.DevExtreme().TextBox()
                .ID("StockDescription")
                .LabelMode(EditorLabelMode.Floating)
                 .ReadOnly(true)
                .Label(new JS("formatMessage('Stock Description:')")))
        </td>
        <td >
            @(Html.DevExtreme().NumberBox()
                .ID("Quantity")
                .ShowSpinButtons(true)
                .Width("100%")
                 .ReadOnly(true)
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Quantity')")))
        </td>
        <td>
            @(Html.DevExtreme().NumberBox()
                .ID("CostPrice")
                .Width("100%")
                 .ReadOnly(true)
                .Format("#,##0.00")
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Cost Price')")))
        </td>
    </tr>
</table>

<table class="dx-field-table" style="padding:10px;"  >
    <tr>
        <td colspan="3">
            @(Html.DevExtreme().DropDownBox()
                        .AcceptCustomValue(true)
                        .Label(new JS("formatMessage('Cost Item:')"))
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewQuotation")
                        .LoadAction("GetCostitem")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("CostItemCode")
                        )
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("CostItem")
                        .OpenOnFieldClick(false)
                        .Option("GetProjectDropDown", "GetProject-datagrid")
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("CostItemCode")
                        .DisplayExpr("CostItem")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                                                //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetClientContentTemplate"))
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message(new JS("formatMessage('Cost Item should be entered')"));
                        })
                       )
            
        </td>

        <td>
            @(Html.DevExtreme().NumberBox()
                .ID("Percentage")
                .Min(0).Max(100).Format("#0.00")
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Percentage (%)')")))
        </td>

        <td>
            @(Html.DevExtreme().NumberBox()
                .ID("ItemQty")
                .Min(1)
                .ShowSpinButtons(true)
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Quantity')")))
        </td>
        <td>
            @(Html.DevExtreme().NumberBox()
                .ID("CostAmount")
                .Format("#,##0.00")
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Cost Amount:')")))
        </td>

        <td style="display:flex; align-items:end;">
            @(Html.DevExtreme().NumberBox()
                .ID("TotalCost")
                .Format("#,##0.00")
                .Width("70%")
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Total Cost:')")))
     
            @(Html.DevExtreme().Button()
                .ID("btnAdd")
                .Text("Add")
                .Type(ButtonType.Success)
                .Icon("plus")
                .OnClick("addCostItem")
                )
        </td>
    </tr>
</table>


<div style="padding:20px;" >
<!-- Data Grid -->
  
        @(Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.Qry60114quotationItemCostEditView>()
        .ID("CostItemGrid")
        .KeyExpr("QuoteCostSlNo")
        .RemoteOperations(false)
     
        .Editing(editing => editing
        .Mode(GridEditMode.Batch)
        .AllowUpdating(true)
    
        )
        .Toolbar(toolbar =>
        {
            toolbar.Items(items =>
            {
                items.Add()
            .Name("saveButton")
            .Location(ToolbarItemLocation.After)
            .Visible(false);

                items.Add()
            .Name("revertButton")
            .Location(ToolbarItemLocation.After)
            .Visible(false);
            });
        })

        .OnRowUpdating("onStoryUpdating")                       // Handles saving
        .Columns(columns =>
        {
            columns.Add().DataField("CostItemCode").Caption("Cost Item Code").AllowEditing(false);
            columns.Add().DataField("CostItemDescription").Caption("Cost Item Description").AllowEditing(false);
            columns.Add().DataField("CostPercentage").Caption("Cost Percentage");
            columns.Add().DataField("CostItemQty").Caption("Cost Item Qty");
            columns.Add().DataField("CostItemPrice").Caption("Cost Item Price");
            columns.Add().DataField("CostItemSubTotal").Caption("Total Cost").AllowEditing(false);
            columns.Add().DataField("QuoteCostSlNo").Caption("QuoteCostSlNo").AllowEditing(false);
           
           
                  })
        .Height("55vh")
        .ColumnAutoWidth(true)
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(f => f.Enabled(true))
        .Paging(p => p.Enabled(true))
        .Scrolling(s => s
        .Mode(GridScrollingMode.Virtual)
        .RowRenderingMode(GridRowRenderingMode.Virtual)
        .PreloadEnabled(true)
        .ScrollByContent(true)
        )
        .ShowBorders(true)
        .ShowRowLines(true)
        .Width("100%")
        )
</div>
<!-- Footer Buttons -->
<div class="footer-buttons" style="padding:20px;">
    @(Html.DevExtreme().Button().Text("Update").ID("btnUpdate").Icon("save").Type(ButtonType.Success))
    @(Html.DevExtreme().Button().Text("Delete").Icon("remove").OnClick("DeleteRecord").Type(ButtonType.Danger))
    @(Html.DevExtreme().Button().Text("Back").Icon("arrowleft").OnClick("Goback").Type(ButtonType.Default))
</div>
@using (Html.DevExtreme().NamedTemplate("GetClientContentTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                            .ID("GetProject-datagrid")
                            .DataSource(d => d.WebApi()
                            .Controller("AddNewQuotation")
                                    .LoadAction("GetCostitem")
                            .LoadMode(DataSourceLoadMode.Raw)
                                .Key("CostItemCode")
                            )
                            .WordWrapEnabled(true)
                            .ShowBorders(true)
                            .ColumnChooser(c => c
                            .Enabled(true)
                            .Title(new JS("formatMessage('Show/Hide Column')"))
                            .Mode(GridColumnChooserMode.DragAndDrop)
                            )
                           
                              @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
                            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                            .OnSelectionChanged("dataGridSelectionChanged1")
                            .OnInitialized("dataGridInitialized1")
                            .HeaderFilter(p => p.Visible(true))
                            .ShowBorders(true)
                            .HoverStateEnabled(true)
                            .Paging(p => p.PageSize(15))
                            .FilterRow(f => f.Visible(false))
                            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                            .Height(385)
                            .Selection(s => s.Mode(SelectionMode.Single))
                            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                            .Columns(columns =>
                            {
                                    columns.Add().DataField("CostItemCode").Caption(new JS("formatMessage('Code')")).Width("80");

                                    columns.Add().DataField("CostItem").Caption(new JS("formatMessage('Cost Item')"));

                            })
                            )
}

<script>
    function onOpened(e) {
        const gridId = e.component.option("dataGridId"); // 👈 Get common ID
        const grid = gridId ? $("#" + gridId).dxDataGrid("instance") : null;

        if (grid) {
            grid.getDataSource().reload(); // refresh data
        }

        setTimeout(() => {
            e.component.focus();
        });
    }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }

        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }
    function dataGridInitialized1(e) {
        dataGrid = e.component;
    }
    function dataGridSelectionChanged1(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#CostItem").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }

    let gsCode = null;let QuoteChildId=null;
        $(function () {
        const params = new URLSearchParams(window.location.search);
         gsCode = params.get("GsCode") || "";

         QuoteChildId = params.get("QuoteChildId") || "";
         alert(QuoteChildId);
        const quoteNo = params.get("QuoteNos") || "";
        const totalCost = parseFloat(params.get("TotalCost")) || 0;
        const discount = params.get("Discount") || 0;
        const costPrice = params.get("CostPrice") || 0;
        const QuotedQuantity = params.get("QuotedQuantity") || 0;
        getGsDescription(gsCode);
       
        $("#QuotationNo").dxTextBox("instance").option("value", quoteNo);
        $("#StockCode").dxTextBox("instance").option("value", gsCode);
        // $("#StockDescription").dxTextBox("instance").option("value", unitPrice);
        $("#Quantity").dxNumberBox("instance").option("value", QuotedQuantity);
        $("#CostPrice").dxNumberBox("instance").option("value", costPrice);
          GridLoad();
    });

    function getGsDescription(gsCode){

        $.ajax({
            type: "GET",
            url: `/api/AddNewQuotation/getGsDescriptionByCode?gsCode=${encodeURIComponent(gsCode)}`,
            success: function (data) {
                if (data && data.GsDescription) {
                    $("#StockDescription").dxTextBox("instance").option("value", data.GsDescription);
                }
            },
            error: function (xhr) {
                console.log("SalesPerson fetch failed:", xhr.responseText);
            }
        });
    }
 

        function GridLoad(){
        $.ajax({
            url: `/api/AddNewQuotation/GetCostItem1?QuoteChildId=${encodeURIComponent(QuoteChildId)}`,
            type: 'GET',
            success: function (statusData) {
                const grid = $("#CostItemGrid").dxDataGrid("instance");
                if (grid) {
                    grid.option("dataSource", statusData);
                    grid.refresh();
                }
            },
            error: function () {
                DevExpress.ui.notify("Failed to load material receipt data", "error", 3000);
            }
        });
        }

    function formatMessage(labelText) {
        return labelText;
    }

        $(function () {
        $("#AddQuotationCostItem").dxTextBox({
            text: formatMessage("Additional Cost On Items"),
                readOnly: true,
                onContentReady: function (e) {
                    $(e.element).addClass("dx-textbox-heading");
                }
            });
        });
            function Goback() {
        window.parent.closeModal(); // This closes the current window/tab
    }

    function addCostItem() {
               var CostItemvalidator = $("#CostItem").dxValidator("instance");
              
             var CostItemvalidation = CostItemvalidator.validate();
        
    // If the branch name is valid, proceed with the AJAX request
    if (CostItemvalidation.isValid) {

        const data = {
            CostItemCode: $("#CostItem").dxDropDownBox("instance").option("value"),
            CostPercentage: $("#Percentage").dxNumberBox("instance").option("value"),
            CostItemQty: $("#ItemQty").dxNumberBox("instance").option("value"),
            CostItemPrice: $("#CostAmount").dxNumberBox("instance").option("value"),
            QuoteNo: $("#QuotationNo").dxTextBox("instance").option("value"),
            GSCode: $("#StockCode").dxTextBox("instance").option("value"),
            QuoteChildId:QuoteChildId,
        };

        $.ajax({
            url: '/api/AddNewQuotation/SaveOrUpdateCostItem',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Story saved successfully!", "success", 2000);
                 GridLoad();
                $("#CostItemGrid").dxDataGrid("instance").refresh();
                $("#CostItem").dxDropDownBox("instance").option("value",""),
                 $("#Percentage").dxNumberBox("instance").option("value",""),
                 $("#ItemQty").dxNumberBox("instance").option("value",""),
                $("#CostAmount").dxNumberBox("instance").option("value","")
             

                 $("#CostItem").dxValidator("instance").reset();
               

            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || "Failed to save.";
                DevExpress.ui.notify(msg, "error", 3000);
            }
        });
        } else {
            // If validation fails, show a notification
            DevExpress.ui.notify(formatMessage('Please fill required details!'), "error", 2000);
        }
    }


    $("#btnUpdate").on("click", function () {
        const grid = $("#CostItemGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


    function onStoryUpdating(e) {

        const data = {
            QuoteCostSlNo: e.oldData.QuoteCostSlNo, 
        CostItemCode: e.newData.CostItemCode ?? e.oldData.CostItemCode,
        CostPercentage: e.newData.CostPercentage ?? e.oldData.CostPercentage,
        CostItemQty: e.newData.CostItemQty ?? e.oldData.CostItemQty,
        CostItemPrice: e.newData.CostItemPrice ?? e.oldData.CostItemPrice,
        QuoteNo: e.newData.QuoteNo ?? e.oldData.QuoteNo,     
        GSCode: e.newData.GSCode ?? e.oldData.GSCode,          
        QuoteChildId: e.newData.QuoteChildId ?? e.oldData.QuoteChildId

        };

        e.cancel = true; // prevents grid from doing its own update

        return $.ajax({
            url: '/api/AddNewQuotation/SaveOrUpdateCostItem',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                 GridLoad();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }

        
    function DeleteRecord() {
        var QuoteChildId = QuoteChildId;

        if (!QuoteChildId) {
            DevExpress.ui.notify("Please enter or select a QuoteChildId  Details to delete.", "warning", 3000);
            return;
        }

        DevExpress.ui.dialog.confirm(
            "You are about to delete the CostItem from the Database. Click Yes if you would like to continue.",
            "Confirm Deletion"
        ).done(function (dialogResult) {
            if (dialogResult) {
                // User clicked 'Yes'
                $.ajax({
                    url: `/api/AddNewQuotation/DeleteCostItem?QuoteNo=${encodeURIComponent(QuoteChildId)}`,
                    type: 'DELETE',
                    success: function (response) {
                        DevExpress.ui.dialog.alert("CostItem has been successfully removed from the database.", "Deleted").done(function () {
                           window.history.back();
                        });
                    },
                    error: function (xhr) {
                        const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                        DevExpress.ui.notify(msg, 'error', 3000);
                    }
                });
            }
            // else: user clicked 'No' - do nothing
        });
    }

</script>