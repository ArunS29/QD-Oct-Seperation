<!-- FORM LAYOUT -->
<div style="display:flex;gap:100px;">
    <div style="display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap; width:100%;">
        <!-- Stock Code -->
        <div style="flex: 1;">
            @(Html.DevExtreme().SelectBox()
                    .ID("txtStockCode")
                    .Label(new JS("formatMessage('Stock Code')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .Disabled(true)
                    .StylingMode(EditorStylingMode.Outlined)
                    )
        </div>

        <!-- Description -->
        <div style="flex: 2;">
            @(Html.DevExtreme().TextBox()
                    .ID("txtStockDescription")
                    .Label(new JS("formatMessage('Stock Item Description')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Disabled(true)
                    )
        </div>

        <!-- Opening Balance -->
        <div style="flex: 1;">
            @(Html.DevExtreme().NumberBox()
                    .ID("txtOpeningBalance")
                        .Format(f => f
                        .Type(Format.FixedPoint)
                        .Precision(2)
                        )
                    .Label(new JS("formatMessage('Opening Balance')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .Disabled(true)
                    .StylingMode(EditorStylingMode.Outlined)
                    )
        </div>
        <div style="gap: 10px;display: flex;flex-direction: column;padding:0 10px;">
            @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
            .Label(new JS("formatMessage('Unit of Measure : *')"))
                    .Placeholder("Qty")
                .DataSource(d => d.WebApi()
                    .Controller("StockInventory")
                    .LoadAction("GetUnitCodes")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("UnitCode")
                )
                .LabelMode(EditorLabelMode.Floating)
                .ID("UnitOfMeasure")
                .Option("dataGridId", "GetUOM-datagrid")
                .Width("90%")
                .OpenOnFieldClick(false)
                .ValueExpr("UnitCode")
                .DisplayExpr("UnitType")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .TabIndex(1)
                .Disabled(true)
                .Value(unitCodeValue)
                .Width("100%")
                .OnKeyDown("onKeyDown")
                //.OnValueChanged("dropDownBoxValueChanged")
                .ContentTemplate(new TemplateName("GetTypeOfUOMContentTemplate"))
                )
            @(Html.DevExtreme().NumberBox()
                    .ID("txtOpeningRate")
                    .Disabled(true)
                    .Format(f => f
                    .Type(Format.FixedPoint)
                    .Precision(2)
                    )
                    .ShowSpinButtons(true)
                    )
        </div>
    </div>
</div>
@using (Html.DevExtreme().NamedTemplate("GetTypeOfUOMContentTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                    .ID("GetUOM-datagrid")
                    .DataSource(d => d.WebApi()
                        .Controller("StockInventory")
                        .LoadAction("GetUnitCodes")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("UnitCode")
                    )
                    .WordWrapEnabled(true)
                    .ShowBorders(true)
                    @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
                    .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                    .OnSelectionChanged("dataGridSelectionChanged4")
                    .OnInitialized("dataGridInitialized4")
                    .HeaderFilter(p => p.Visible(true))
                    .FilterRow(f => f.Visible(false))
                    .ShowBorders(true)
                    .HoverStateEnabled(true)
                    .Paging(p => p.PageSize(15))
                    //.SearchPanel(sp => sp.Visible(true).HighlightSearchText(true).Width(235))
                    .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                    .Height(345)
                    .Selection(s => s.Mode(SelectionMode.Single))
                    .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                    .Columns(columns =>
                    {
                            columns.Add().DataField("UnitType").Caption(new JS("formatMessage('Unit Type')"));



                    })
                    )
}
<!-- GRID -->
<div>
    @(
    Html.DevExtreme().DataGrid()
            .ID("gridOpeningBalance")
            .DataSource(new object[] { }) // You can bind actual data here
            .Columns(columns =>
            {
                columns.Add().DataField("ReceiptChildSlNo").AllowEditing(false).Visible(false);
            columns.Add().DataField("Gscode").Caption(new JS("formatMessage('Stock Code')")).AllowEditing(false);
            columns.Add().DataField("Unit").Caption(new JS("formatMessage('Unit')"))
                    .Lookup(lookup => lookup
                    .DataSource(d => d.WebApi()
                    .Controller("StockInventory")
                    .LoadAction("GetUnitCodes")
                    .Key("UnitCode") // Assuming this is the key
                    )
                    .ValueExpr("UnitCode")       // The value from your grid's data
                    .DisplayExpr("UnitType"))
                    .AllowEditing(false);

            columns.Add()
                .DataField("UnitPrice")
                .Caption(new JS("formatMessage('Unit Price')"))
                .AllowEditing(false)
                .Format(f => f
                    .Type(Format.FixedPoint)
                    .Precision(4)
                );
            columns.Add().DataField("Quantity").Caption(new JS("formatMessage('Quantity')")).AllowEditing(true)
            .Format(f => f
                .Type(Format.FixedPoint)
                .Precision(3)
                );
            columns.Add().DataField("ExpiryDate").Caption(new JS("formatMessage('Expiry Date')")).DataType(GridColumnDataType.Date).AllowEditing(true);
            columns.Add().DataField("BatchNo").Caption(new JS("formatMessage('Batch No')")).AllowEditing(true);
            columns.Add().Type(GridCommandColumnType.Buttons).Buttons(b =>
                {
                    b.Add().Name(GridColumnButtonName.Delete)
                        .Icon("trash")
                        .Hint("Delete")
                        .OnClick("onDeleteOpeningBalance");
                });
            })
                .Editing(editing =>
                {
                    editing.Mode(GridEditMode.Cell); // or Row, depending on your preference
                    editing.AllowUpdating(true);
                    editing.AllowAdding(false);
                    editing.AllowDeleting(false);

                })
                //.OnCellClick("onStoryUpdating")
                .OnRowUpdating("onStoryUpdating")
                .ShowBorders(true)
                .ShowRowLines(true)
                .RowAlternationEnabled(true)
                .ColumnAutoWidth(true)
                .Height("65vh")
                .Width("100%")
                .OnCellPrepared("onOpeningBalanceCellPrepared")
            )
    </div>

    <!-- BUTTON FOOTER -->
    <div class="footer-fixed" style="display:flex; gap:10px;">
    @(Html.DevExtreme().Button().ID("btnUpdate").Text(new JS("formatMessage('Save & Close')")).Type(ButtonType.Success).ElementAttr(new { @class = "dx-button-custom btn-save" }).Icon("save"))
    @(Html.DevExtreme().Button().ID("btnPrint").Text(new JS("formatMessage('Print')")).Icon("print"))
    @(Html.DevExtreme().Button().ID("btnDelete").Text(new JS("formatMessage('Delete')")).Icon("trash").ElementAttr(new { @class = "dx-button-custom btn-delete" }).Type(ButtonType.Danger))
    @(Html.DevExtreme().Button().ID("btnBack").Text(new JS("formatMessage('Back')")).Icon("arrowleft").ElementAttr(new { @class = "dx-button-custom btn-back" }).Type(ButtonType.Normal))
    </div>

 <script>

    $(document).on("click", "#btnBack", function () {
        window.parent.closeModal();
    });
    $(document).on("click", "#btnUpdate", function () {
        window.parent.closeModal();
    });

      $(function () {
            $("#DatabaseSignatories").dxTextBox({
                text: formatMessage("Database "),
                readOnly: true,
                           

            });
        });

    $(function () {
        $("#Openingbalance").dxTextBox({
            text: formatMessage("Opening Balance Entries"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    async function convertToArabic(sourceId, targetId) {
        const sourceBox = $("#" + sourceId).dxTextBox("instance");
        const targetBox = $("#" + targetId).dxTextBox("instance");

        if (!sourceBox || !targetBox) {
            console.error("TextBox not initialized.");
            return;
        }

        const sourceText = sourceBox.option("value");

        if (!sourceText || sourceText.trim() === "") {
            alert("Please enter a value to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(sourceText);
            targetBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    


    $("#btnUpdate").on("click", function () {
        const grid = $("#gridOpeningBalance").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });

    function onDeleteOpeningBalance(e) {
        var grid = $("#gridOpeningBalance").dxDataGrid("instance");
            var key = e.row.data.ReceiptChildSlNo;
            if (confirm("Are you sure you want to delete this row?")) {
                $.ajax({
                    url: '/api/StockInventory/DeleteOpeningBalance/' + key,
                    type: 'DELETE',
                    success: function () {
                        grid.refresh();
                        DevExpress.ui.notify("Deleted successfully", "success", 2000);
                    },
                    error: function () {
                        DevExpress.ui.notify("Delete failed", "error", 2000);
                    }
                });
            }
    }

    function onStoryUpdating(e) {
        const allowedFields = ['Quantity','BatchNo', 'ExpiryDate'];
        const filteredNewData = {};

        for (const key of allowedFields) {
            if (key in e.newData) {
                filteredNewData[key] = e.newData[key];
            }
        }

        const data = {
            ReceiptChildSlNo: e.oldData.ReceiptChildSlNo,
            Gscode: e.oldData.Gscode,
            QtyReceived: filteredNewData.Quantity ?? e.oldData.Quantity,
            BatchNo: filteredNewData.BatchNo ?? e.oldData.BatchNo,
            ExpiryDate: filteredNewData.ExpiryDate ?? e.oldData.ExpiryDate
        };

        e.promise = $.ajax({
            url: '/api/StockInventory/UpdateOpeningBalanceItem',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data)
        })
        .done(() => {
            $("#gridOpeningBalance").dxDataGrid("instance").refresh();
            DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
        })
        .fail(() => {
            DevExpress.ui.notify("Failed to save.", "error", 1500);
        });
    }




    $(function () {
        setTimeout(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const gscode = urlParams.get('gscode');
            const description = urlParams.get('description');
            const openingbal = urlParams.get('OpeningBalance');
            const costPrice = urlParams.get('CostPrice');
            const unitCode = urlParams.get('UnitCode');
            console.log("URL Params - gscode:", gscode, "description:", description);

            const stockBox = $("#txtStockCode").dxSelectBox("instance");
            const descBox = $("#txtStockDescription").dxTextBox("instance");
            const openingBalBox = $("#txtOpeningBalance").dxNumberBox("instance");
            const costPriceBox = $("#txtOpeningRate").dxNumberBox("instance");
            const unitTypeBox = $("#UnitOfMeasure").dxDropDownBox("instance");

            if (gscode) {
                stockBox.option("acceptCustomValue", true); // This is important
                stockBox.option("value", gscode);
            }

            if (description) {
                descBox.option("value", description);
            }

            if (openingbal) {
                openingBalBox.option("value", openingbal);
            }

            if (costPrice) {
                costPriceBox.option("value", costPrice);
            }

            if (unitCode) {
                unitCodeValue = parseInt(unitCode);
                unitTypeBox.option("value", unitCodeValue);
            }

            loadOpeningBalanceGrid(gscode);
        }, 300);
    });

    function loadOpeningBalanceGrid(gscode) {
        if (!gscode) return;

        $.ajax({
            url: `/api/StockInventory/GetOpeningBalanceByGscode`,  // Your API endpoint
            data: { gscode: gscode },
            method: "GET",
            success: function(data) {
                // Assuming data is an array of records matching your grid columns
                $("#gridOpeningBalance").dxDataGrid("instance").option("dataSource", data);
            },
            error: function(err) {
                console.error("Error loading opening balance data", err);
            }
        });
    }
    function onOpeningBalanceCellPrepared(e) {
        if (e.rowType === "data") {
            const greenColumns = ["Quantity", "ExpiryDate", "BatchNo"];
            if (greenColumns.includes(e.column.dataField)) {
                e.cellElement.css("background-color", "#d4edda"); // light green
            }
        }
    }

   
    function dataGridSelectionChanged4(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#UnitOfMeasure").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }
    function dataGridInitialized4(e) {
        dataGrid = e.component;
    }
    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();

        const text = ddbInstance.option("text");
        const gridId = ddbInstance.option("dataGridId");
        if (gridId) {
            const grid = $("#" + gridId).dxDataGrid("instance");
            if (grid) {
                grid.option("searchPanel.text", text);
            }
        }
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;

        const gridId = ddbInstance.option("dataGridId");
        const grid = gridId ? $("#" + gridId).dxDataGrid("instance") : null;

        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else if (grid) {
            let focusedIndex = grid.option("focusedRowIndex");
            let visibleRows = grid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            grid.focus(grid.getRowElement(focusedIndex));
        }
    }

    function onOpened(e) {
        const gridId = e.component.option("dataGridId"); // 👈 Get common ID
        const grid = gridId ? $("#" + gridId).dxDataGrid("instance") : null;

        if (grid) {
            grid.getDataSource().reload(); // refresh data
        }

        setTimeout(() => {
            e.component.focus();
        });
    }

    </script>