<script>
				function onStatusCardReady(e) {
		const gridInstance = e.component;
		const dataSource = gridInstance.getDataSource();
		const gridId = e.element.attr("id");

		if (!dataSource || !gridId) return;

		const handleData = (data) => {
			if (gridId === "dataGrid") {
				updateNewQuotationTotal(data);          // ✅ pass data
				updateWaitingSaleOrderCount(data);      // ✅ pass data
				updateQuotationRaiseTodayCount(data);   // ✅ pass data
				updateTotalQuotationCount(data);        // ✅ pass data
			} else {
				updateVoucherCounts(data);
				updateNewQuotationTotal(data);          // ✅ pass data
				updatePendingApprovalCount(data);       // ✅ pass data
			}
		};

		dataSource.load().done(handleData);
	}

		function updateNewQuotationTotal(data) {
		if (!data || !Array.isArray(data)) return;

		let total = 0;
		data.forEach(item => {
			const value = parseFloat(item.TotalWithTax);
			if (!isNaN(value)) {
				total += value;
			}
		});

		document.getElementById("newquotationtotals").innerHTML = total.toLocaleString(undefined, {
			minimumFractionDigits: 2,
			maximumFractionDigits: 2
		});
	}

		function updatePendingApprovalCount(data) {
		if (!data || !Array.isArray(data)) return;

		let totalQuotes = 0;
		let approvedCount = 0;

		data.forEach(item => {
			if (item.QuoteNo) {
				totalQuotes++;
				if (item.IsApproved === true || item.IsApproved === "true") {
					approvedCount++;
				}
			}
		});

		const pendingCount = totalQuotes - approvedCount;
		document.getElementById("pendingofapproval").innerHTML = pendingCount.toLocaleString();
	}

			function updateWaitingSaleOrderCount(data) {
		if (!data || !Array.isArray(data)) return;

		let totalQuotes = 0;
		let withSalesOrder = 0;

		data.forEach(item => {
			if (item.QuoteNo) {
				totalQuotes++;
				if (item.SalesOrderNo && item.SalesOrderNo.trim() !== "") {
					withSalesOrder++;
				}
			}
		});

		const waitingCount = totalQuotes - withSalesOrder;
		document.getElementById("waitingsaleorder").innerHTML = waitingCount.toLocaleString();
	}

		function updateQuotationRaiseTodayCount(data) {
		if (!data || !Array.isArray(data)) return;

		let todayCount = 0;
		const today = new Date();
		const todayString = today.toISOString().split('T')[0];

		data.forEach(item => {
			if (item.QuoteDate) {
				const quoteDate = new Date(item.QuoteDate);
				const quoteDateString = quoteDate.toISOString().split('T')[0];

				if (quoteDateString === todayString) {
					todayCount++;
				}
			}
		});

		document.getElementById("quotationraisetoday").innerHTML = todayCount.toLocaleString();
	}

		function updateTotalQuotationCount(data) {
		if (!data || !Array.isArray(data)) return;

		const totalCount = data.filter(item => item.QuoteNo !== null && item.QuoteNo !== undefined && item.QuoteNo !== '').length;

		document.getElementById("totalnoofquotation").innerHTML = totalCount.toLocaleString();
	}

