@page
@model QD.ERP.Web.Areas.IMS.Pages.UnitOfMeasureModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Goods and Services</title>
    <style>
        .dx-datagrid-column-chooser-button {
            display: none !important;
        }


        .dx-field {
            display: flex;
            flex-direction: column;
            margin-left:10px;
        }

        .field-label {
            font-weight: bold;
        }

        .aligned-input {
            width: 100%;
        }

    /*     .dx-card {
            padding: 20px;
            background-color: transparent;
            width: 100%;
            margin: auto;
            border-radius: 8px;
        } */

        .input-group {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dx-textarea {
            width: 100%;
            height: 60px;
        }
        .dx-card{
            width : 1000px;
        }

        .limited-footer .btn-container:not(:has(#btnSave,#btnBack)) {
            display: none !important;
        }

        .container {
            display: none !important;
        }

        .frame {
            display: none !important;
        }

        .footerContainer {
            display: none !important;
        }

        .bodyContainer {
            display: flex;
            justify-content: center;
        }

        .mainContainer {
            width:98%;
        }

        .playIcon {
            display:  none;
        }
    </style>
   
</head>
<body>
      @* <h3>Database Master Module:Unit of Measure</h3> *@
        <!-- Row 1: Type a New UOM & Add to the Existing List: -->
            <div class="dx-field">
                <table>
                    <tr>
                        <td colspan="2">
                            
                            @(Html.DevExtreme().TextBox()
                                .Label(new JS("formatMessage('Type a New UOM & Add to the Existing List:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("txtGoodsCode7").Width("69%")
                                .ValidationRules(rules =>
                                {
                                    rules.AddRequired().Message("Fill the UOM field");
                                }))
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextArea()
                                .Label(new JS("formatMessage('UoM Description:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("txtDescription8").Width("95%").Height(60)
                                .ValidationRules(rules =>
                                {
                                    rules.AddRequired().Message("Fill the Description Field");
                                }))
                        </td>
                        <td>
                            <div style="display: flex; gap: 10px; width: 100%; align-items:end;">
                                <!-- Language Button -->
                                <div>
                                    @(Html.DevExtreme().Button()
                                        .ID("convertToArabic1")
                                        .Width(60)
                                        .Height(40)
                                        .Icon("fas fa-language")
                                        .ElementAttr(new { @class = "input-button" })
                                        .OnClick("function() { convertToArabic(); }"))
                                </div>

                                <!-- Arabic TextArea -->
                                <div style="flex: 1;">
                                    @(Html.DevExtreme().TextArea()
                                        .Label(new JS("formatMessage('UoM Description(in Arabic):')"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        .ID("txtDescriptionArabic")
                                        .Width("100%")
                                        .InputAttr("dir", "rtl")
                                        .Height(45))
                                </div>
                                <div style="flex: 1;">
                                    @(Html.DevExtreme().Button()
                                        .Text(new JS("formatMessage('Add')"))
                                        .ID("btnAddGroup3").Icon("plus").Height(60)
                                        .ElementAttr(new { @class = "custom-ui-button" })
                                        .OnClick("addUomToDatabase"))
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.Tbl40111PropertyUnitCode>()

            .ID("dataGrid")
            .RemoteOperations(false)
            .DataSource(d => d.WebApi()
            .Controller("VATModule") 
            .LoadAction("GetAccountGroups") 
            .LoadMode(DataSourceLoadMode.Raw)

            )
                .Columns(columns =>
                {
                    columns.Add().DataField("UnitCode")
                    .Caption(new JS("formatMessage('ID')"))
                    .Width(134)
                    .VisibleIndex(0)
                    .AllowEditing(false)
                    .Alignment(HorizontalAlignment.Center);

                    columns.Add().DataField("UnitType")
                    .Caption(new JS("formatMessage('Unit Type')"))
                    .Width(378)
                    .VisibleIndex(1)
                    .AllowEditing(true)
                    .Alignment(HorizontalAlignment.Center);

                    columns.Add().DataField("UnitDesc")
                    .Caption(new JS("formatMessage('Description')"))
                    .Width(349)
                    .VisibleIndex(2)
                    .AllowEditing(true)
                    .Alignment(HorizontalAlignment.Center);

                    columns.Add().DataField("UnitDescAr")
                    .Caption(new JS("formatMessage('Description (Arabic)')"))
                    .Width(371)
                    .VisibleIndex(3)
                    .AllowEditing(true)
                    .Alignment(HorizontalAlignment.Center);
                                                            // Add delete button column
                    columns.Add()
                    .Type(GridCommandColumnType.Buttons)
                    .Buttons(buttons =>
                    {
                        buttons.Add()
                    .Name(GridColumnButtonName.Delete)
                    .Icon("trash") // Use a trash icon
                    .Hint("Delete Row") // Tooltip
                    .OnClick("onDeleteButtonClick");
                    });

                })
                .KeyExpr("UnitCode") // 👈 Must be unique
                .Editing(editing => editing
                .Mode(GridEditMode.Batch)
                .AllowUpdating(true)
                .AllowDeleting(true)
                )
            .Toolbar(toolbar =>
            {
                toolbar.Items(items =>
                {
                    items.Add()
                .Name("saveButton")
                .Location(ToolbarItemLocation.After)
                .Visible(false);

                    items.Add()
                .Name("revertButton")
                .Location(ToolbarItemLocation.After)
                .Visible(false);
                });
            })

              .OnRowUpdating("onUnitRowUpdating")
               
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .Paging(p => p.Enabled(false))
            .HeaderFilter(filter => filter.Visible(false))
            .Height("55vh")
            .SearchPanel(p => p.HighlightSearchText(true)) 
            .FilterRow(filterRow => filterRow.Visible(false))
            .GroupPanel(groupPanel => groupPanel.Visible(false))
            .ShowBorders(true)
            .ShowRowLines(true)
             .ColumnChooser(c => c.Enabled(false))
            .Width("100%")

            )

   


    </div>


        <div class="footer-fixed" style="display:flex; gap:20px;">
            <div class="btn-container">
                @(Html.DevExtreme().Button()
                                .ID("btnSave")
                                .Text(new JS("formatMessage('Save')"))
                                .Type(ButtonType.Normal)
                                .StylingMode(ButtonStylingMode.Outlined)
                                .Icon("save")
                        .ElementAttr(new { @class = "dx-button-custom btn-save" })
                                )

            </div>
            <div class="btn-container">

                @(Html.DevExtreme().Button()
                                .ID("btnBack")
                                .Text(new JS("formatMessage('Back')"))
                                .Icon("arrowleft")
                                .OnClick("onBack")
                                .ElementAttr(new { @class = "dx-button-custom btn-back" })
                        )
            </div>
        </div>
</body>
</html>
<script>
     $(document).ready(function () {
        $(document).on('click', '#btnBack', function () {
            window.parent.closeModal();
        });

    });


        async function convertToArabic() {
            const englishBox = $("#txtDescription8").dxTextArea("instance");
            const arabicBox = $("#txtDescriptionArabic").dxTextArea("instance");

            if (!englishBox || !arabicBox) {
                console.error("TextAreas not initialized.");
                return;
            }

            const englishText = englishBox.option("value");

            if (!englishText || englishText.trim() === "") {
                alert("Please enter the UoM description to translate.");
                return;
            }

            try {
                const translatedText = await translateToArabic(englishText);
                arabicBox.option("value", translatedText);
            } catch (error) {
                console.error("Translation failed", error);
                alert("Translation failed. Please try again.");
            }
        }

    function addUomToDatabase() {
        
        const isUnit = $("#txtGoodsCode7").dxValidator("instance").validate().isValid;
        const isUnitDes = $("#txtDescription8").dxValidator("instance").validate().isValid;
        if (!isUnit || !isUnitDes) {
            DevExpress.ui.notify("Please enter both Unit Type and Description.", "error", 2000);
            return;
        }
        const unitType = $("#txtGoodsCode7").dxTextBox("instance").option("value");
        const unitDesc = $("#txtDescription8").dxTextArea("instance").option("value");
        const unitDescAr = $("#txtDescriptionArabic").dxTextArea("instance").option("value");
        $.ajax({
            url: `/api/VATModule/AddUom`,
            type: 'POST',
            data: {
                unitType: unitType,
                unitDesc: unitDesc,
                unitDescAr: unitDescAr
            },
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify("UOM added successfully!", "success", 2000);

                    // Clear inputs
                    $("#txtGoodsCode7").dxTextBox("instance").option("value", "");
                    $("#txtDescription8").dxTextArea("instance").option("value", "");
                    $("#txtDescriptionArabic").dxTextArea("instance").option("value", "");
                    $("#txtGoodsCode7").dxValidator("instance").reset();
                    $("#txtDescription8").dxValidator("instance").reset();
                    // ✅ Refresh the grid
                    $("#dataGrid").dxDataGrid("instance").refresh();
                } else {
                    // ❌ Notify the user of the exact backend error message
                    DevExpress.ui.notify(response.message || "This Unit Rate Method already exists.", "error", 3000);
                }
            },
            error: function () {
                DevExpress.ui.notify("An error occurred while adding the UOM.", "error", 3000);
            }
        });
    }
    $("#btnSave").on("click", function () {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.saveEditData(); // Triggers onUnitRowUpdating
    });


    function onUnitRowUpdating(e) {
        
        const data = {
            unitCode: e.oldData.UnitCode, // Include when updating
            unitType: e.newData.UnitType ?? e.oldData.UnitType,
            unitDesc: e.newData.UnitDesc ?? e.oldData.UnitDesc ,
            unitDescAr: (e.newData.UnitDescAr !== undefined)
            ? e.newData.UnitDescAr  // allow empty string if cleared
            : e.oldData.UnitDescAr
        };

    if (!data.unitType || !data.unitType.trim()) {
        DevExpress.ui.notify("Unit Type cannot be empty.", "error", 1500);
        e.cancel = true; // stop the update
        return;
    }

    if (!data.unitDesc || !data.unitDesc.trim()) {
        DevExpress.ui.notify("Unit Description cannot be empty.", "error", 1500);
        e.cancel = true; // stop the update
        return;
    }

        return $.ajax({
            url: '/api/VATModule/UpdateUom',
            method: "POST",
            data: data, // No need to stringify if not using JSON
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 1500);
                    $("#dataGrid").dxDataGrid("instance").refresh();
                } else {
                    DevExpress.ui.notify(response.message, "error", 1500);
                }
            },
            error: function () {
                DevExpress.ui.notify("Server error", "error", 1500);
            }
        });
    }

    $(function () {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.hideColumnChooser(); // just in case it was opened previously
    });
      
       function onDeleteButtonClick(e) {
        e.event.preventDefault(); // Prevent default delete

        var grid = $("#dataGrid").dxDataGrid("instance");
        var key = e.row.data.UnitCode; // Get the ID of the row

        // DevExtreme confirmation dialog
        DevExpress.ui.dialog.confirm(
            "Are you sure you want to delete this row?",
            "Delete Confirmation"
        ).done(function (result) {
            if (result) { // User clicked Yes
                $.ajax({
                    url: '/api/VATModule/DeleteUOM?key=' + key,
                    type: 'DELETE',
                    success: function () {
                        grid.refresh(); // Refresh the grid
                        DevExpress.ui.notify("Deleted successfully", "success", 2000);
                    },
                    error: function () {
                        DevExpress.ui.notify("Delete failed", "error", 2000);
                    }
                });
            }
        });
    }

        function onBack(){
            window.parent.closeModal();
        }

</script>