@page
@model QD.ERP.IMS.Areas.IMS.Pages.DetailedDescriptionQuotationModel
@{
}


<style>

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }
</style>
<div style="padding: 10px; border-radius: 5px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <label style="font-weight: bold;" id="detailquotationspecification"></label>
        <div>
            @(Html.DevExtreme().Button()
                        .ID("btnUseDetailedDescription")
                        .Text(new JS("formatMessage('Use Detailed Description')"))
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Contained)
                        .ElementAttr("style", "margin-right: 10px;")
                        .OnClick("getDetailedDescription") )
            @(Html.DevExtreme().Button()
                        .ID("btnUseItemDesc")
            .Text(new JS("formatMessage('Use Item Description')"))
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Contained)
                        .OnClick("getItemDescription"))
        </div>
    </div>

    <!-- TextArea -->
    <div style="margin-top: 10px;">
        @(Html.DevExtreme().TextArea()
                .ID("DetailedDescription")
                .Height(100)
        .Label(new JS("formatMessage('Detailed Description / Specification')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))

        @(Html.DevExtreme().TextBox()
                .ID("ReferenceNo")
        .Label(new JS("formatMessage('Client Item Reference No')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))
    </div>

    <!-- 3 Column Row: Purpose / Priority / Expected Date -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">

        @(Html.DevExtreme().TextBox()
                .ID("Remarks")
                .Label("Remarks")
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))
        @(Html.DevExtreme().NumberBox()
                .ID("itemGroupCode")
        .Label(new JS("formatMessage('Item Group Code')"))
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                .Label(new JS("formatMessage('Item Sub Grouping')"))
                .DataSource(d => d.WebApi()
                .Controller("AddNewQuotation")
                .LoadAction("GetItemSubGroup")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("QuoteGroupItemSlNo")
                )
                .LabelMode(EditorLabelMode.Floating)
                .ID("GetQuoteGroupDropDown")
                .Width(900)
        @*  .ShowClearButton(true)
                 .AcceptCustomValue(true) *@
                .OpenOnFieldClick(false)//
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("QuoteGroupItemSlNo")
                .DisplayExpr("GroupName")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .TabIndex(1)
                .Width("100%")
                .OnKeyDown("onKeyDown")
                                        //.OnValueChanged("dropDownBoxValueChanged")
                .ContentTemplate(new TemplateName("GetProjectContentTemplate"))
                .Buttons(buttons =>
                {
                    buttons.Add()
                    .Name("AddDebits")
                    .Location(TextEditorButtonLocation.After)
                    .Widget(w => w.Button()
                    .Type(ButtonType.Default)
                    .Icon("plus")
                    .ElementAttr(new { @class = "custom-hover-button add-hover" })
                    .OnClick("AddNewClient"));
                    buttons.Add()
                    .Name("dropDown");
                }))



    </div>



    <!-- Size / Manufacturer / Brand -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("Size")
        .Label(new JS("formatMessage('Size')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("Manufacturer")
        .Label(new JS("formatMessage('Manufacturer')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("Brand")
        .Label(new JS("formatMessage('Brand')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))
    </div>

    <!-- Part No / Delivery Period / Plan No -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("PartNo")
        .Label(new JS("formatMessage('Part No')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("DeliveryPeriod")
        .Label(new JS("formatMessage('Delivery Period')"))
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("PlanNo")
        .Label(new JS("formatMessage('Plan No')"))
                .LabelMode(EditorLabelMode.Floating))
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">


    </div>
    @(Html.DevExtreme().Button()
        .ID("btnApplyAndClose")
    .Text(new JS("formatMessage('Apply & Close')"))
        .Icon("check")
        .OnClick("applyAndClose"))

</div>
@using (Html.DevExtreme().NamedTemplate("GetProjectContentTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                            .ID("GetProject-datagrid")
                            .DataSource(d => d.WebApi()
                                .Controller("AddNewQuotation")
                                .LoadAction("GetItemSubGroup")
                            .LoadMode(DataSourceLoadMode.Raw)
                                .Key("QuoteGroupItemSlNo")
                            )
                            .WordWrapEnabled(true)
                            .ShowBorders(true)
                                               @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
                            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                            .OnSelectionChanged("dataGridSelectionChanged")
                            .OnInitialized("dataGridInitialized")
                            .HeaderFilter(p => p.Visible(true))
                            .ShowBorders(true)
                            .HoverStateEnabled(true)
                            .Paging(p => p.PageSize(15))
                            .FilterRow(f => f.Visible(false))
                            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                            .Height("65vh")
                            .Selection(s => s.Mode(SelectionMode.Single))
                            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                            .SearchPanel(sp => sp.Visible(false).HighlightSearchText(true).Width(235))
                            .Columns(columns =>
                            {
                                columns.Add().Caption(new JS("formatMessage('Code')")).DataField("QuoteGroupItemSlNo");
                                columns.Add().Caption(new JS("formatMessage('Sub Group Name')")).DataField("GroupName");
                                columns.Add().Caption(new JS("formatMessage('Notes')")).DataField("GroupRemarks");

                            })
                            )
				}
                <script>

          function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

            function dataGridSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#GetQuoteGroupDropDown").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }
    function dataGridInitialized(e) {
        dataGrid = e.component;
    }




    let GSCode = null;
    let QuoteChildId1=null;

    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
         const QuoteChildIds = urlParams.get("QuoteChildId");
          QuoteChildId1 = QuoteChildIds ? QuoteChildIds.split("?")[0] : null;

          if(QuoteChildId1){
              loadeditData(QuoteChildId1);
          }

        const GSCodes = urlParams.get("gsCode");
           GSCode = GSCodes ? GSCodes.split("?")[0] : null;


        if (GSCode) {
                // If Mprno is present, load client details
                loadClientDetails(GSCode);
            }

    });


        function loadClientDetails(GSCode) {
       $.ajax({
            url: `/api/AddNewClientRequest/GetdataByGSCode?GSCode=${encodeURIComponent(GSCode)}`,
            type: 'GET',
            dataType: 'json',
            success: function (res)  {
                console.log("ddd",res);
            $("#Size").dxTextBox("instance").option("value",res.ItemSize);
            $("#Manufacturer").dxTextBox("instance").option("value",res.ItemMake);
            $("#Brand").dxTextBox("instance").option("value",res.ItemBrand);
            $("#PartNo").dxTextBox("instance").option("value",res.ItemPartNo);
            },
            error: function (xhr) {
                console.log("data fetch failed:", xhr.responseText);
            }
        });
    }
      function  loadeditData(QuoteChildId1) {
       $.ajax({
           url: `/api/AddNewQuotation/GetDetaildescriptiondata1?QuoteChildId=${encodeURIComponent(QuoteChildId1)}`,
            type: 'GET',
            dataType: 'json',
            success: function (res)  {
                console.log("ddd111",res);
    $("#DetailedDescription").dxTextArea("instance").option("value", res.AddlDescription);
    $("#PlanNo").dxTextBox("instance").option("value", res.PlanNo);
    $("#DeliveryPeriod").dxTextBox("instance").option("value", res.DeliveryPeriod);
    $("#Remarks").dxTextBox("instance").option("value", res.QuoteRemarks);
    $("#itemGroupCode").dxNumberBox("instance").option("value", res.QuoteGroupCode);
    $("#ReferenceNo").dxTextBox("instance").option("value", res.ClientItemLineRefNo);
    $("#GetQuoteGroupDropDown").dxDropDownBox("instance").option("value", res.QuoteGroupItemSlNo);

            },
            error: function (xhr) {
                console.log("data fetch failed:", xhr.responseText);
            }
        });
    }

    // 🔧 This must be globally accessible
    function getItemDescription() {
        if (!GSCode) {
            DevExpress.ui.notify("GSCode is missing", "error", 2000);
            return;
        }

        $.ajax({

            url: `/api/AddNewClientRequest/GetGSCodeDescription?gsCode=${encodeURIComponent(GSCode)}`,
            type: "GET",
            success: function (data) {
                $("#DetailedDescription").dxTextArea("instance").option("value", data);
            },
            error: function () {
                DevExpress.ui.notify("Failed to fetch description", "error", 2000);
            }
        });
    }

    function getDetailedDescription() {
        if (!GSCode) {
            DevExpress.ui.notify("GSCode is missing", "error", 2000);
            return;
        }

        $.ajax({
            url: `/api/AddNewClientRequest/GetGSCodeDetailedDescription?gsCode=${encodeURIComponent(GSCode)}`,
            type: "GET",
            success: function (data) {
                $("#DetailedDescription").dxTextArea("instance").option("value", data);
            },
            error: function () {
                DevExpress.ui.notify("Failed to fetch detailed description", "error", 2000);
            }
        });
    }




        function collectModalFields() {
        return {
            GSCode: GSCode,
       AddlDescription:$("#DetailedDescription").dxTextArea("instance").option("value"),
     PlanNo:$("#PlanNo").dxTextBox("instance").option("value"),
    DeliveryPeriod:$("#DeliveryPeriod").dxTextBox("instance").option("value"),
    QuoteRemarks:$("#Remarks").dxTextBox("instance").option("value"),
    QuoteGroupCode: $("#itemGroupCode").dxNumberBox("instance").option("value"),
     ClientItemLineRefNo:$("#ReferenceNo").dxTextBox("instance").option("value"),
     QuoteGroupItemSlNo:$("#GetQuoteGroupDropDown").dxDropDownBox("instance").option("value")
        };
    }

    // Send data to Page 1 when window is closing
    window.onbeforeunload = function () {
        if (window.opener && typeof window.opener.receiveModalFieldData === "function") {
            const fieldValues = collectModalFields();
            window.opener.receiveModalFieldData(fieldValues);
        }
    };
       function applyAndClose() {
        const modalData = {
          AddlDescription:$("#DetailedDescription").dxTextArea("instance").option("value"),
     PlanNo:$("#PlanNo").dxTextBox("instance").option("value"),
    DeliveryPeriod:$("#DeliveryPeriod").dxTextBox("instance").option("value"),
    QuoteRemarks:$("#Remarks").dxTextBox("instance").option("value"),
    QuoteGroupCode: $("#itemGroupCode").dxNumberBox("instance").option("value"),
     ClientItemLineRefNo:$("#ReferenceNo").dxTextBox("instance").option("value"),
     QuoteGroupItemSlNo:$("#GetQuoteGroupDropDown").dxDropDownBox("instance").option("value")
         };

          console.log("📤 Sending to parent:", modalData);
        if (window.parent && typeof window.parent.receiveModalFieldData === "function") {
            window.parent.receiveModalFieldData(modalData);
            window.parent.closeModal(); // or your custom modal close logic
        } else {
            alert("Could not send to parent.");
        }
    }

         function AddNewClient(){
                    const url = `/${tenantName}/IMS/addNewQuotationItemSubGroup`;
                  const title = formatMessage("Quotation Item Sub Group");
                      openModal(url, title);
                  }

                    $(function () {
        $("#detailquotationspecification").text(formatMessage("Detailed Description / Specification:"));
    });
</script>

