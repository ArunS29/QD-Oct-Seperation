			function updateTodayRequestCount() {
		const grid = $("#dataGrid").dxDataGrid("instance");
		if (!grid) return;

		const today = new Date();
		const todayDateStr = today.toDateString();

		const allData = grid.getDataSource().items();

		const count = allData.filter(item => {
			const mprDate = new Date(item.Mprdate);
			return mprDate.toDateString() === todayDateStr;
		}).length;

		document.getElementById("netqoutedamount").innerHTML = `
			<div style="font-weight: bold;">${count}</div>
		`;
	}

	function updateTotalRequestCount() {
		const grid = $("#dataGrid").dxDataGrid("instance");
		if (!grid) return;

		const allData = grid.getDataSource().items();
		const totalCount = allData.length;

		document.getElementById("totalRequestCount").innerHTML = `
				<div>${totalCount}</div>
		`;
	}

	function updateRequestCancelledCount(data) {
		const cancelledCount = data.filter(item => item.IsCancelled === true || item.IsCancelled === "true").length;

		document.getElementById("requestcanceledcount").innerHTML = `
				<div>${cancelledCount}</div>
		`;
	}



		function onGridReady(e) {
		const gridInstance = e.component;
		const dataSource = gridInstance.getDataSource();

		if (dataSource) {
			const items = gridInstance.option("dataSource");

			if (Array.isArray(items)) {
				updateTotalRequestCount(); // 👈 Added here
				updateRequestCancelledCount(items); // 👈 Add this
			    updateStatusTabCounts(items);
			} else {
				dataSource.load().done(function (loadedData) {
				updateTotalRequestCount(); // 👈 Added here
				updateRequestCancelledCount(loadedData); // 👈 Add this
				updateStatusTabCounts(loadedData);
				});
			}
		}
	}

	const card = document.getElementById('mainCard');
	
	
	// Count elements for each tab
	const countEls = [
		document.getElementById("counts0"),
		document.getElementById("counts1"),
		document.getElementById("counts2"),
	];

	const tabs = document.querySelectorAll(".tab-text");
	const contents = document.querySelectorAll(".tab-content");

	// Hold dynamic count values here
	let counts = [0, 0, 0];

	function animateCount(el, target) {
		let i = 0;
		el.innerText = i;
		el.classList.remove('bounce');

		const interval = setInterval(() => {
			if (i >= target) {
				el.innerText = target;
				el.classList.add('bounce');
				clearInterval(interval);
			} else {
				el.innerText = i++;
			}
		}, 20);
	}

	function switchTab(index) {
		tabs.forEach((tab, i) => {
			tab.classList.toggle('active', i === index);
			contents[i].classList.toggle('active', i === index);
		});

		  if (index === 0) card.classList.add("today-bg");
		  if (index === 1) card.classList.add("week-bg");
		  if (index === 2) card.classList.add("month-bg");
		animateCount(countEls[index], counts[index]);
	}

	// 🔄 Update count values dynamically from DevExtreme grid data
		function updateStatusTabCounts(data) {
		let verified = 0, approved = 0, submitted = 0;

		data.forEach(row => {
			if (row.IsVerified === true || row.IsVerified === "true") verified++;
			if (row.IsApproved === true || row.IsApproved === "true") approved++;
			if (row.IsSubmitted === true || row.IsSubmitted === "true") submitted++;
		});

		counts = [verified, approved, submitted];

		const activeIndex = [...tabs].findIndex(tab => tab.classList.contains('active'));
		if (activeIndex >= 0) {
			animateCount(countEls[activeIndex], counts[activeIndex]);
		}
	}

	// ✅ Auto-run Verified count on load
	window.addEventListener("DOMContentLoaded", () => {
		switchTab(0); // Default tab
	});

