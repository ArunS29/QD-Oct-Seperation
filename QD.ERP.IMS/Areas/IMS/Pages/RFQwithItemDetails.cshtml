<style>
	.overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1000;
	}

	.titleCard-toggle1 {
		display: none;
	}
	.overlay-content {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100%;
		height: 80%;
		background: #fff;
		box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
		border-radius: 8px;
		overflow: hidden;
	}
	#overlay-frame {
		width: 100%;
		height: 100%;
	}

	

	.close-btn {
		position: absolute;
		top: 10px;
		right: 20px;
		font-size: 30px;
		cursor: pointer;
	}

	.custom-toolbar {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.filter-btn {
		background-color: #007bff;
		color: white;
		border: none;
		padding: 6px 12px;
		border-radius: 5px;
		cursor: pointer;
		font-family: 'Inter', sans-serif;
	}

		.filter-btn:hover {
			background-color: #0056b3;
		}

	.no-border-input {
		border: none !important;
		outline: none !important;
		box-shadow: none !important;
		background: transparent !important;
		font-weight: bold;
		font-size: 16px;
		color: black;
		pointer-events: none;
	}

	.context-menuInvoice {
		position: absolute;
		background: #fff;
		border-radius: 8px;
		box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
		width: 200px;
		display: none;
		flex-direction: column;
		padding: 5px 0;
		z-index: 1000;
	}

	.context-menu-itemInvoice {
		display: flex;
		align-items: center;
		padding: 10px 15px;
		font-size: 14px;
		cursor: pointer;
		transition: background 0.2s ease-in-out;
		color: #333;
	}

		.context-menu-itemInvoice i {
			margin-right: 10px;
			font-size: 16px;
			color: #007bff;
		}

		.context-menu-itemInvoice:hover {
			background: #f0f0f0;
		}

		.context-menu-itemInvoice:not(:last-child) {
			border-bottom: 1px solid #e0e0e0;
		}

	.ledgerResult{
		overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
		width: 100%;
	}

	.mainContainer {
		width: 100%;
		overflow: hidden;
	}
</style>

