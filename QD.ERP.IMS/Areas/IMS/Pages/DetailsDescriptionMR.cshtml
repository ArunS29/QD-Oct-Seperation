@page
@model QD.ERP.IMS.Areas.IMS.Pages.DetailsDescriptionMRModel
@{
}
<style>

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        width: 100%;
    }

    .playIcon {
        display: none;
    }

    .modal-content {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70%;
        max-width: 1400px;
        height: 90%;
        max-height: 470px;
        background: white;
        border-radius: 8px;
        padding: 0;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

</style>

<div style="padding: 10px; border-radius: 5px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <label style="font-weight: bold;" id="detailmr"></label>
        <div>
            @(Html.DevExtreme().Button()
                        .ID("btnUseDetailedDescription")
                        .Text(new JS("formatMessage('Use Detailed Description')"))
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Contained)
                        .ElementAttr("style", "margin-right: 10px;")
                        .OnClick("getDetailedDescription")
                        )
            @(Html.DevExtreme().Button()
                        .ID("btnUseItemDesc")
                        .Text(new JS("formatMessage('Use Item Description')"))
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Contained)
                        .OnClick("getItemDescription"))
        </div>
    </div>

    <!-- TextArea -->
    <div style="margin-top: 10px;">
        @(Html.DevExtreme().TextArea()
                .ID("DetailedDescription")
                .Height(100)
                .Label(new JS("formatMessage('Detailed Description / Specification')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))
    </div>

    <!-- 3 Column Row: Purpose / Priority / Expected Date -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("PurposeOfRequest")
                .Label(new JS("formatMessage('Purpose of Request')"))
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().SelectBox()
                .ID("PriorityOfRequest")
                .Items(new[] { "Low", "Medium", "High" })
                .Label(new JS("formatMessage('Priority of Request')"))
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().DateBox()
                .ID("ExpectedDate")
                .Type(DateBoxType.Date)
                .Label(new JS("formatMessage('Expected Date')"))
                .LabelMode(EditorLabelMode.Floating))
    </div>

    <!-- Remarks -->
    <div style="margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("Remarks")
                .Label(new JS("formatMessage('Remarks')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))
    </div>

    <!-- Size / Manufacturer / Brand -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("Size")
                .Label(new JS("formatMessage('Size')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("Manufacturer")
                .Label(new JS("formatMessage('Manufacturer')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("Brand")
                .Label(new JS("formatMessage('Brand')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))
    </div>

    <!-- Part No / Delivery Period / Plan No -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("PartNo")
                .Label(new JS("formatMessage('Part No')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("DeliveryPeriod")
                .Label(new JS("formatMessage('Delivery Period')"))
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("PlanNo")
                .Label(new JS("formatMessage('Plan No')"))
                .LabelMode(EditorLabelMode.Floating))
    </div>
    @(Html.DevExtreme().Button()
        .ID("btnApplyAndClose")
        .Text(new JS("formatMessage('Apply & Close')"))
        .Icon("check")
        .OnClick("applyAndClose"))

</div>
<script>
    let GSCode = null;
    let MprchildSlNo1=null;

    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
         const MprchildSlNos = urlParams.get("MprchildSlNo");
          MprchildSlNo1 = MprchildSlNos ? MprchildSlNos.split("?")[0] : null;
          if(MprchildSlNo1){
              loadeditData(MprchildSlNo1);
          }

        const GSCodes = urlParams.get("gsCode");
       GSCode = GSCodes ? GSCodes.split("?")[0] : null;
        console.log("Loaded GSCode:", GSCode);
        if (GSCode) {
                // If Mprno is present, load client details
                loadClientDetails(GSCode);
            }

    });


        function loadClientDetails(GSCode) {
       $.ajax({
            url: `/api/AddNewClientRequest/GetdataByGSCode?GSCode=${encodeURIComponent(GSCode)}`,
            type: 'GET',
            dataType: 'json',
            success: function (res)  {
                console.log("ddd",res);
            $("#Size").dxTextBox("instance").option("value",res.ItemSize);
            $("#Manufacturer").dxTextBox("instance").option("value",res.ItemMake);
            $("#Brand").dxTextBox("instance").option("value",res.ItemBrand);
            $("#PartNo").dxTextBox("instance").option("value",res.ItemPartNo);
            },
            error: function (xhr) {
                console.log("data fetch failed:", xhr.responseText);
            }
        });
    }
      function  loadeditData(MprchildSlNo1) {
       $.ajax({
           url: `/api/AddNewClientRequest/GetDetaildescriptiondata?MprchildSlNo=${encodeURIComponent(MprchildSlNo1)}`,
            type: 'GET',
            dataType: 'json',
            success: function (res)  {
                console.log("ddd111",res);
            $("#DetailedDescription").dxTextArea("instance").option("value",res.AddlDescription);
            $("#PlanNo").dxTextBox("instance").option("value",res.PlanNo);
            $("#DeliveryPeriod").dxTextBox("instance").option("value",res.DeliveryPeriod);
            $("#PurposeOfRequest").dxTextBox("instance").option("value",res.ItemReqPurpose);
            $("#PriorityOfRequest").dxSelectBox("instance").option("value",res.ItemReqPriority);
           $("#ExpectedDate").dxDateBox("instance").option("value",res.ItemReqExpectedDate);
           $("#Remarks").dxTextBox("instance").option("value",res.ItemRemarks);
            },
            error: function (xhr) {
                console.log("data fetch failed:", xhr.responseText);
            }
        });
    }

    // 🔧 This must be globally accessible
    function getItemDescription() {
        if (!GSCode) {
            DevExpress.ui.notify("GSCode is missing", "error", 2000);
            return;
        }

        $.ajax({

            url: `/api/AddNewClientRequest/GetGSCodeDescription?gsCode=${encodeURIComponent(GSCode)}`,
            type: "GET",
            success: function (data) {
                $("#DetailedDescription").dxTextArea("instance").option("value", data);
            },
            error: function () {
                DevExpress.ui.notify("Failed to fetch description", "error", 2000);
            }
        });
    }

    function getDetailedDescription() {
        if (!GSCode) {
            DevExpress.ui.notify("GSCode is missing", "error", 2000);
            return;
        }

        $.ajax({
            url: `/api/AddNewClientRequest/GetGSCodeDetailedDescription?gsCode=${encodeURIComponent(GSCode)}`,
            type: "GET",
            success: function (data) {
                $("#DetailedDescription").dxTextArea("instance").option("value", data);
            },
            error: function () {
                DevExpress.ui.notify("Failed to fetch detailed description", "error", 2000);
            }
        });
    }




        function collectModalFields() {
        return {
            GSCode: GSCode,
            AddlDescription: $("#DetailedDescription").dxTextArea("instance").option("value"),
            ItemReqPurpose: $("#PurposeOfRequest").dxTextBox("instance").option("value"),
            ItemReqPriority: $("#PriorityOfRequest").dxSelectBox("instance").option("value"),
            ItemReqExpectedDate: $("#ExpectedDate").dxDateBox("instance").option("value"),
            ItemRemarks: $("#Remarks").dxTextBox("instance").option("value"),
           // ItemSize: $("#Size").dxTextBox("instance").option("value"),
           // ItemMake: $("#Manufacturer").dxTextBox("instance").option("value"),
           // ItemBrand: $("#Brand").dxTextBox("instance").option("value"),
          //  ItemPartNo: $("#PartNo").dxTextBox("instance").option("value"),
            DeliveryPeriod: $("#DeliveryPeriod").dxTextBox("instance").option("value"),
            PlanNo: $("#PlanNo").dxTextBox("instance").option("value")
        };
    }

    // Send data to Page 1 when window is closing
    window.onbeforeunload = function () {
        if (window.opener && typeof window.opener.receiveModalFieldData === "function") {
            const fieldValues = collectModalFields();
            window.opener.receiveModalFieldData(fieldValues);
        }
    };
       function applyAndClose() {
        const modalData = {
            AddlDescription: $("#DetailedDescription").dxTextArea("instance").option("value"),
            PlanNo: $("#PlanNo").dxTextBox("instance").option("value"),
            DeliveryPeriod: $("#DeliveryPeriod").dxTextBox("instance").option("value"),
            ItemReqPurpose: $("#PurposeOfRequest").dxTextBox("instance").option("value"),
            ItemReqPriority: $("#PriorityOfRequest").dxSelectBox("instance").option("value"),
            ItemReqExpectedDate: $("#ExpectedDate").dxDateBox("instance").option("value"),
            ItemRemarks: $("#Remarks").dxTextBox("instance").option("value")
        };

        console.log("📤 Sending to parent:", modalData);

        if (window.parent && typeof window.parent.receiveModalFieldData === "function") {
            window.parent.receiveModalFieldData(modalData);
            window.parent.closeModal(); // or your custom modal close logic
        } else {
            alert("Could not send to parent.");
        }
    }


    $(function () {
        $("#detailmr").text(formatMessage("Detailed Description / Specification:"));
    });

</script>
