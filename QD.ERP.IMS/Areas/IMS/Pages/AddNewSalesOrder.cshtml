        function showGenerateJobOrderModal(event) {
        const modal = $("#generateJobOrderModal");

        if (event) {
            // Position modal at the mouse click
            modal.css({
                left: event.pageX + "px",
                top: event.pageY + "px",
                transform: "translate(0, 0)"
            });
        }

        modal.fadeIn(200);

        // Delay to prevent immediate closure
        setTimeout(() => {
            $(document).on("click.generateJO", function (e) {
                if (!$(e.target).closest("#generateJobOrderModal").length) {
                    closeGenerateJobOrderModal();
                }
            });
        }, 100);
    }


        function closeGenerateJobOrderModal() {
            $("#generateJobOrderModal").fadeOut(200);
            $(document).off("click.generateJO");
        }

