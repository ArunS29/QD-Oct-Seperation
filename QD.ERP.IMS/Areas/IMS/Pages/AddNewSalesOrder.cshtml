    function validateAndSave() {
        // ✅ Validate required DropDown fields
        const requiredFields = [
            { id: "#ClientNames", label: "Client Name" },
            // { id: "#TypeOFSalesOrder", label: "Type of Sales Order" },
            // { id: "#CompanyBranch", label: "Company Branch" },
            // Add more if needed
        ];

        let allValid = true;
        let missingLabels = [];

        requiredFields.forEach(field => {
            const $el = $(field.id);
            const inst = $el.dxDropDownBox("instance");

            if (inst) {
                const value = inst.option("value");
                if (!value) {
                    allValid = false;
                    missingLabels.push(field.label);
                    $el.addClass("dx-invalid");
                } else {
                    $el.removeClass("dx-invalid");
                }
            } else {
                console.warn("Instance not found:", field.id);
            }
        });

        if (!allValid) {
            DevExpress.ui.dialog.alert(
                "Please fill the required field(s): " + missingLabels.join(", "),
                "Validation Failed"
            );
            return;
        }
    }

$("#B2BdataGrid").dxDataGrid({
    dataSource: window.B2BdataGridDataSource,
    keyExpr: "LineOrderNo",
    selection: { mode: "multiple" },
    onContextMenuPreparing: function(e) {
        if (e.row && e.row.rowType === "data") {
            e.items = [
                // Delete single row
                {
                    text: formatMessage("Delete Line Item"),
                    icon: "trash",
                    onItemClick: function() {
                        const grid = $("#B2BdataGrid").dxDataGrid("instance");
                        const rowData = e.row.data;

                        DevExpress.ui.dialog.confirm(
                            "Delete this row permanently?",
                            "Confirm"
                        ).done(function(result) {
                            if (!result) return;

                            if (rowData.SalesOrderChildId > 0) {
                                // Delete saved row via API
                                $.ajax({
                                    url: `/api/SalesOrders/DeleteChildById?childId=${encodeURIComponent(rowData.SalesOrderChildId)}`,
                                    type: "DELETE",
                                    success: function(res) {
                                        if (res.success) {
                                            removeRowsFromGrid([rowData]);
                                            DevExpress.ui.notify(res.message || "Row deleted", "success", 2000);
                                        } else {
                                            DevExpress.ui.notify(res.message || "Delete failed", "error", 2000);
                                        }
                                    },
                                    error: function(xhr) {
                                        const err = xhr.responseJSON?.message || "Server error on delete";
                                        DevExpress.ui.notify(err, "error", 3000);
                                    }
                                });
                            } else {
                                // Unsaved row
                                removeRowsFromGrid([rowData]);
                                DevExpress.ui.notify("Unsaved row deleted", "success", 2000);
                            }
                        });
                    }
                },

                // Delete multiple selected rows
                {
                    text: formatMessage("Delete Selected Items"),
                    icon: "remove",
                    onItemClick: function() {
                        const grid = $("#B2BdataGrid").dxDataGrid("instance");
                        const selectedRows = grid.getSelectedRowsData();
                        if (selectedRows.length === 0) {
                            DevExpress.ui.notify("No rows selected", "warning", 2000);
                            return;
                        }

                        setTimeout(() => {
                            DevExpress.ui.dialog.confirm(
                                `Delete ${selectedRows.length} selected row(s) permanently?`,
                                "Confirm"
                            ).done(function(result) {
                                if (!result) return;

                                const savedRows = selectedRows.filter(r => r.SalesOrderChildId > 0);
                                const unsavedRows = selectedRows.filter(r => !r.SalesOrderChildId);

                                // Delete saved rows via API
                                if (savedRows.length) {
                                    const savedIds = savedRows.map(r => r.SalesOrderChildId);
                                    $.ajax({
                                        url: "/api/SalesOrders/DeleteMultipleChild",
                                        type: "DELETE",
                                        contentType: "application/json",
                                        data: JSON.stringify(savedIds),
                                        success: function(res) {
                                            if (res.success) {
                                                removeRowsFromGrid(savedRows);
                                                DevExpress.ui.notify(res.message, "success", 2000);
                                            } else {
                                                DevExpress.ui.notify(res.message || "Delete failed", "error", 2000);
                                            }
                                        },
                                        error: function(xhr) {
                                            const err = xhr.responseJSON?.message || "Server error on delete";
                                            DevExpress.ui.notify(err, "error", 3000);
                                        }
                                    });
                                }

                                // Delete unsaved rows locally
                                if (unsavedRows.length) {
                                    removeRowsFromGrid(unsavedRows);
                                    DevExpress.ui.notify(`${unsavedRows.length} unsaved row(s) deleted`, "success", 2000);
                                }
                            });
                        }, 0);
                    }
                },

                // Add Line Item
                {
                    text: formatMessage("Add Line Item"),
                    icon: "add",
                    onItemClick: function() {
                        $("#B2BdataGrid").dxDataGrid("instance").addRow();
                    }
                },

                // Generate Job Orders
                {
                    text: formatMessage("Generate Job Orders"),
                    icon: "chart",
                    onItemClick: function() {
                        $("#generateJobOrderModal").fadeIn(200);
                    }
                }
            ];
        }
    }
});

// 🔹 Helper function to remove rows and resequence LineOrderNo
function removeRowsFromGrid(rows) {
    const grid = $("#B2BdataGrid").dxDataGrid("instance");
    let ds = grid.getDataSource().items();

    rows.forEach(r => {
        const idx = ds.indexOf(r);
        if (idx >= 0) ds.splice(idx, 1);
    });

    // Resequence LineOrderNo
    ds.forEach((row, index) => row.LineOrderNo = index + 1);

    grid.option("dataSource", ds);
    grid.refresh();
}

