    $(function () {
    const grid = $("#B2BdataGrid").dxDataGrid("instance");

  grid.option("onRowRemoving", function (e) {
    const row = e.data;

    // Case 1: Already saved row (delete from DB)
    if (row.SalesOrderChildId && row.SalesOrderChildId > 0) {
        e.cancel = true; // stop default delete until confirmed

        DevExpress.ui.dialog.confirm("Delete this row permanently?", "Confirm")
            .done(function (result) {
                if (!result) return;

                $.ajax({
                    url: `/api/SalesOrders/DeleteChildById?childId=${encodeURIComponent(row.SalesOrderChildId)}`, // ✅ query string style
                    type: "DELETE",
                    success: function (res) {
                        if (res.success) {
                            // remove from grid
                            let store = grid.getDataSource().store();
                            store.remove(row.LineOrderNo);
                            grid.refresh();
                            resequenceLineOrderNo(grid);

                            DevExpress.ui.notify(res.message || "Row deleted", "success", 2000);
                        } else {
                            DevExpress.ui.notify(res.message || "Delete failed", "error", 2000);
                        }
                    },
                    error: function (xhr) {
                        const err = xhr.responseJSON?.message || "Server error on delete";
                        DevExpress.ui.notify(err, "error", 3000);
                    }
                });
            });
    }
    // Case 2: Unsaved row (just remove locally)
    else {
        setTimeout(() => resequenceLineOrderNo(grid), 100);
    }
});
});
// resequence LineOrderNo
function resequenceLineOrderNo(grid) {
    let ds = grid.option("dataSource") || [];
    ds.forEach((row, idx) => row.LineOrderNo = idx + 1);
    grid.option("dataSource", ds);
    grid.refresh();
}



