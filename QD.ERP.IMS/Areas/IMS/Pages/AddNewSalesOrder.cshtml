    "ClientNames",      
  ];



$("#btnSave").on("click", function (e) {
    e.preventDefault();
    e.stopPropagation();

    const $btn = $(this).dxButton("instance");
    $btn.option("disabled", true);

    if (!validateFields(requiredFields)) {
        DevExpress.ui.notify("Please fill in all required fields.", "error", 3000);
        $btn.option("disabled", false);
        return;
    }

    if (!edit) {
        NewSalesOrderNoForSave().done(function (soNoNew) {
            $("#SalesOrderNO").dxTextBox("instance").option("value", soNoNew);
            saveButtonSave(soNoNew, $btn);
        }).fail(function (err) {
            $btn.option("disabled", false);
            DevExpress.ui.dialog.alert(err || "Failed to generate Sales Order No.", "Error");
        });
    } else {
        const soNoExisting = $("#SalesOrderNO").dxTextBox("instance").option("value") || null;
        saveButtonSave(soNoExisting, $btn);
    }
});

// Save button function (stay on page)
function saveButtonSave(salesOrderNo, $btn) {
    const gridInstance = $("#B2BdataGrid").dxDataGrid("instance");

    const saveChildren = () => {
        const children = gridInstance.getDataSource().items().map(row => ({
            SalesOrderChildId: row.SalesOrderChildId ?? 0,
            SalesOrderNo: salesOrderNo,
            Gscode: row.Gscode ?? "",
            QuotedQuantity: row.QuotedQuantity ?? null,
            UnitRateMethod: row.UnitRateMethod ?? null,
            QuotedUnitPrice: row.QuotedUnitPrice ?? null,
            QuotedDiscount: row.QuotedDiscount ?? null,
            QuotedTaxSlab: row.QuotedTaxSlab ?? null,
            CostPrice: row.CostPrice ?? null,
            AddlDescription: row.AddlDescription ?? null,
            QuoteRemarks: row.QuoteRemarks ?? null,
            DeliveryPeriod: row.DeliveryPeriod ?? null,
            PlanNo: row.PlanNo ?? null,
        }));

        const master = {
            SalesOrderNo: salesOrderNo,
            SalesOrderDate: getDateOnlyValue("#SalesOrderDate"),
            ClientPono: $("#ClientPoNo").dxTextBox("instance").option("value"),
            ClientPodate: $("#ClientPoDate").dxDateBox("instance").option("value"),
            QuoteNo: $("#QuotationNo").dxTextBox("instance").option("value"),
            QuoteDate: $("#QuotationDate").dxDateBox("instance").option("value"),
            OrderExpiryDate: $("#OrderExpiryDate").dxDateBox("instance").option("value"),
            ExpectedDeliveryDate: $("#ExpectedDeliveryDate").dxDateBox("instance").option("value"),
            Attention: $("#ClientRefName").dxTextBox("instance").option("value"),
            ClientContactEmail: $("#ClientEmail").dxTextBox("instance").option("value"),
            SalesOrderRemarks: $("#SalesOrderRemarks").dxTextArea("instance").option("value"),
            ClientContactNo: $("#ClientContact").dxTextBox("instance").option("value"),
            TypeOfRequest: $("#TypeOFSalesOrder").dxDropDownBox("instance").option("value"),
            ClientCode: $("#ClientNames").dxDropDownBox("instance").option("value"),
            Project: $("#ReferenceNo").dxTextBox("instance").option("value"),
            ProjectMasterCode: $("#Project").dxDropDownBox("instance").option("value"),
            ClientRefNo: $("#ReferenceNo1").dxTextBox("instance").option("value"),
            QuoteSignatory: $("#preparedBy").dxDropDownBox("instance").option("value"),
            SalesPersonCode: $("#SalesPerson").dxDropDownBox("instance").option("value"),
            AdditionsText: $("#AdditionsText").dxTextBox("instance").option("value"),
            DiscountsText: $("#DeductionsText").dxTextBox("instance").option("value"),
            QuoteDiscount: $("#DeductionsAmount").dxNumberBox("instance").option("value"),
            QuoteTransport: $("#AdditionsAmount").dxNumberBox("instance").option("value"),
            CostAllocationMasterGroup: $("#CostCenter").dxDropDownBox("instance").option("value"),
            CompanyBranch: $("#CompanyBranch").dxDropDownBox("instance").option("value"),
            InventoryMasterGroupId: $("#InventoryGroup").dxDropDownBox("instance").option("value"),
            CurrencyRate: $("#currencyexchangerate").dxNumberBox("instance").option("value"),
            BaseCurrencyId: $("#ddlGoodsGroup4").dxDropDownBox("instance").option("value"),
            CurrencyId: $("#ddlGoodsGroup3").dxDropDownBox("instance").option("value"),
            SalesOrderChildren: children
        };

        $.ajax({
            url: "/api/SalesOrders/SaveSalesOrder",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(master),
            success: function (response) {
                isVoucherSaved = true;
                updateWorkflowVisual(getWorkflowStatusFromFields());
                DevExpress.ui.notify(response.message, "success", 3000);
                const salesOrderNo = response.salesOrderNo;
                loadSODetails(salesOrderNo);
                loadSODetails1(salesOrderNo);
                edit = true;
                isSaved = true;
                $btn.option("disabled", false);

                // Reload grid
                $.get("/api/SalesOrders/GetSalesOrderChildren?quoteNo=" + master.SalesOrderNo, function (data) {
                    window.B2BdataGridDataSource = data;
                    gridInstance.option("dataSource", data);
                });
            },
            error: function () {
                DevExpress.ui.notify("Failed to save sales order.", "error", 3000);
                $btn.option("disabled", false);
            }
        });
    };

    if (gridInstance.hasEditData()) {
        gridInstance.saveEditData().done(saveChildren);
    } else {
        saveChildren();
    }
}

