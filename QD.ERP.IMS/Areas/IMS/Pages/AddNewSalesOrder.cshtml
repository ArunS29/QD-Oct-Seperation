function NewSalesOrderNoForSave() {
    return $.ajax({
        url: "/api/SalesOrders/SalesOrderNoIncrease",
        type: "GET"
    }).then(function (data) {
        if (data && data.salesOrderNo) {
            return data.salesOrderNo; // ✅ return just the string
        } else {
            return $.Deferred().reject("Sales order number not found.");
        }
    }).fail(function (xhr) {
        console.error("Error fetching Sales Order No:", xhr);
        return $.Deferred().reject("Error fetching Sales Order No");
    });
}

