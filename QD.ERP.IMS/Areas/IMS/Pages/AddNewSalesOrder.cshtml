        function getFlatData(items) {
            var flatData = [];

            function flatten(items) {
                items.forEach(item => {
                    if (item.items) {
                        flatten(item.items); // Recursively flatten groups
                    } else {
                        flatData.push(item); // Push raw row data
                    }
                });
            }

            flatten(items); // Flatten all grouped items

            return flatData;
        }

            //MoveupDown functionality
        function moveRowUp() {
            
                var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
            var dataSource = dataGrid.getDataSource();
            var data = getFlatData(dataSource.items()); // Flatten the grouped data
            //   var selectedRowKeys = dataGrid.option("selectedRowKeys");

            console.log("Flattened Data:", data); // Log flattened data for debugging


            // Find the row index based on the selected row key (AccountGroupId)
            var rowIndex = data.findIndex(item => item.LineOrderNo === selectedSNo);

            console.log("Row Index:", rowIndex); // Log row index for debugging

            // Proceed only if a valid row is selected and it's not the first row
            if (rowIndex > 0) {
                swapRows(data, rowIndex, rowIndex - 1); // Swap rows in the data

                // Update the data source with the new data order
                dataSource.store().update(data[rowIndex].LineOrderNo, data[rowIndex]);
                dataSource.store().update(data[rowIndex - 1].LineOrderNo, data[rowIndex - 1]);

                // After swap, select the moved row
                dataGrid.selectRows([data[rowIndex - 1].LineOrderNo]);
            }
        }


        function moveRowDown() {

            var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
            var dataSource = dataGrid.getDataSource();
            var data = getFlatData(dataSource.items()); // Get flattened data
            // var selectedRowKeys = dataGrid.option("selectedRowKeys");


            var rowIndex = data.findIndex(item => item.LineOrderNo === selectedSNo);

            console.log("Row Index:", rowIndex);

            if (rowIndex < data.length - 1) {
                swapRows(data, rowIndex, rowIndex + 1);
                dataGrid.refresh();
                dataGrid.selectRows([data[rowIndex + 1].LineOrderNo]);
            } else {
