function loadSODetails1(salesOrderNo) {
    edit = true;

    const salesOrderTextBox = $("#SalesOrderNO").dxTextBox("instance");
    const grid = $("#B2BdataGrid").dxDataGrid("instance");

    $.get(`/api/SalesOrders/GetSalesOrderByNo`, { salesOrderNo: salesOrderNo })
        .done(function (data) {
            if (salesOrderTextBox) {
                salesOrderTextBox.option("value", data.SalesOrderNo);
            }

            if (data.IsSubmitted) {
                $("#btnSubmit").dxButton("instance").option("disabled", true);
            }
            if (data.IsVerified) {
                $("#btnVerify").dxButton("instance").option("disabled", true);
            }

            if (data.SalesOrderChildren && data.SalesOrderChildren.length > 0) {
                // Ensure LineOrderNo exists
                data.SalesOrderChildren.forEach((row, index) => {
                    if (!row.LineOrderNo || row.LineOrderNo === 0) {
                        row.LineOrderNo = index + 1;
                    }
                });

                // Update global counter for future inserts
                nextLineOrderNo = data.SalesOrderChildren.length + 1;

                if (grid) {
                    grid.option("dataSource", data.SalesOrderChildren);
                }
            }

            if (data.IsApproved === true) {
                disableAllControls();
            }
        })
        .fail(function () {
            DevExpress.ui.notify("Failed to load sales order details.", "error", 2000);
        });
}


