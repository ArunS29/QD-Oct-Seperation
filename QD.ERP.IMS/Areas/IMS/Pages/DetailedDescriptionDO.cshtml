@page
@model QD.ERP.Web.Areas.IMS.Pages.DetailedDescriptionDOModel
@{
}
<style>
 
    .container {

        display: none !important;

    }
 
    .frame {

        display: none !important;

    }
 
    .footerContainer {

        display: none !important;

    }
 
    .bodyContainer {

        display: flex;

        justify-content: center;

    }
 
    .imagecontainer {

        border-bottom: 2px;

    }
 
    .mainContainer {

        margin-top: 1em;

        width: 100%;

    }
 
    .playIcon {

        display: none;

    }
 
    .modal-content {

        position: absolute;

        top: 40%;

        left: 50%;

        transform: translate(-50%, -50%);

        width: 70%;

        max-width: 1400px;

        height: 90%;

        max-height: 470px;

        background: white;

        border-radius: 8px;

        padding: 0;

        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);

        overflow: hidden;

    }
 
</style>
 
<div style="padding: 10px; border-radius: 5px;">
<div style="display: flex; justify-content: space-between; align-items: center;">
<label style="font-weight: bold;" id="detaileddescriptiondelivery"></label>
<div>

            @(Html.DevExtreme().Button()

                        .ID("btnUseDetailedDescription")

                        .Text(new JS("formatMessage('Use Detailed Description')"))

                        .Icon("info")

                        .Type(ButtonType.Normal)

                        .StylingMode(ButtonStylingMode.Contained)
                        .OnClick("getDetailedDescription")

                        .ElementAttr("style", "margin-right: 10px;"))

            @(Html.DevExtreme().Button()

                        .ID("btnUseItemDesc")

                        .Text(new JS("formatMessage('Use Item Description')"))

                        .Icon("info")

                        .Type(ButtonType.Normal)
                        .OnClick("getItemDescription")

                        .StylingMode(ButtonStylingMode.Contained))
</div>
</div>
 
    <!-- TextArea -->
<div style="margin-top: 10px;">

        @(Html.DevExtreme().TextArea()

                .ID("DetailedDescription")

                .Label(new JS("formatMessage('Detailed Description / Specification')"))

                .LabelMode(EditorLabelMode.Floating)

                .ElementAttr("style", "width: 100%; height: 80px !important;"))
</div>
 
    <!-- Remarks -->
<div style="margin-top: 15px;">

        @(Html.DevExtreme().TextBox()

                .ID("Remarks")

                .Label(new JS("formatMessage('Remarks')"))

                .LabelMode(EditorLabelMode.Floating)

                .ElementAttr("style", "width: 100%;"))
</div>
 
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">

       


        @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                .Label(new JS("formatMessage('Cost Allocation for Employees:')"))
                .DataSource(d => d.WebApi()
                .Controller("DeliveryNote")
                .LoadAction("GetEmployeeDetails")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("EmployeeId")
                )
                .LabelMode(EditorLabelMode.Floating)
                .ID("Costallocationemployees")
                .Width(900)
        @*  .ShowClearButton(true)
                           .AcceptCustomValue(true) *@
                .OpenOnFieldClick(false)//
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("EmployeeId")
                .DisplayExpr("EmployeeName")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .TabIndex(1)
                .Width("100%")
                .OnKeyDown("onKeyDown")
                                        //.OnValueChanged("dropDownBoxValueChanged")
                .ContentTemplate(new TemplateName("GetModeOfRequestContentTemplate1"))
               )
 
    
        @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                .Label(new JS("formatMessage('Cost Allocation for Property/Equipments:')"))
                .DataSource(d => d.WebApi()
                .Controller("DeliveryNote")
                .LoadAction("GetPropertyDetails")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("PropertyNo")
                )
                .LabelMode(EditorLabelMode.Floating)
                .ID("Costallocationproperty")
                .Width(900)
        @*  .ShowClearButton(true)
                           .AcceptCustomValue(true) *@
                .OpenOnFieldClick(false)//
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("PropertyNo")
                .DisplayExpr("PropertyDescription")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .TabIndex(1)
                .Width("100%")
                .OnKeyDown("onKeyDown")
                                        //.OnValueChanged("dropDownBoxValueChanged")
                .ContentTemplate(new TemplateName("GetModeOfRequestContentTemplate2"))
                )
</div>
 @(Html.DevExtreme().Button()
        .ID("btnApplyAndClose")
        .Text(new JS("formatMessage('Apply & Close')"))
        .Icon("check")
        .OnClick("applyAndClose"))
</div>
@using (Html.DevExtreme().NamedTemplate("GetModeOfRequestContentTemplate1"))
{
    @(Html.DevExtreme().DataGrid()
                        .ID("GetProject-datagrid1")
                        .DataSource(d => d.WebApi()
                            .Controller("DeliveryNote")
                            .LoadAction("GetEmployeeDetails")
                        .LoadMode(DataSourceLoadMode.Raw)
                            .Key("EmployeeId")
                        )
                        .WordWrapEnabled(true)
                        .ShowBorders(true)
                                           @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
                        .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                        .OnSelectionChanged("dataGridSelectionChanged2")
                        .OnInitialized("dataGridInitialized2")
                        .HeaderFilter(p => p.Visible(true))
                        .FilterRow(f => f.Visible(false))
                        .ShowBorders(true)
                        .HoverStateEnabled(true)
                        .Paging(p => p.PageSize(15))
                                                     //.SearchPanel(sp => sp.Visible(true).HighlightSearchText(true).Width(235))
                        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                        .Height(345)
                        .Selection(s => s.Mode(SelectionMode.Single))
                        .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                        .Columns(columns =>
                        {
                                columns.Add().DataField("EmployeeId").Caption(new JS("formatMessage('Employee ID')"));
                                columns.Add().DataField("EmployeeName").Caption(new JS("formatMessage('Employee Name')"));



                        })
                        )
				}
                @using (Html.DevExtreme().NamedTemplate("GetModeOfRequestContentTemplate2"))
{
    @(Html.DevExtreme().DataGrid()
                        .ID("GetProject-datagrid2")
                        .DataSource(d => d.WebApi()
                            .Controller("DeliveryNote")
                            .LoadAction("GetPropertyDetails")
                        .LoadMode(DataSourceLoadMode.Raw)
                            .Key("PropertyNo")
                        )
                        .WordWrapEnabled(true)
                        .ShowBorders(true)
                                           @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
                        .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                        .OnSelectionChanged("dataGridSelectionChanged3")
                        .OnInitialized("dataGridInitialized3")
                        .HeaderFilter(p => p.Visible(true))
                        .FilterRow(f => f.Visible(false))
                        .ShowBorders(true)
                        .HoverStateEnabled(true)
                        .Paging(p => p.PageSize(15))
                                                     //.SearchPanel(sp => sp.Visible(true).HighlightSearchText(true).Width(235))
                        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                        .Height(345)
                        .Selection(s => s.Mode(SelectionMode.Single))
                        .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                        .Columns(columns =>
                        {
                                columns.Add().DataField("PropertyNo").Caption(new JS("formatMessage('Property No')"));
                                columns.Add().DataField("PropertyDescription").Caption(new JS("formatMessage('Property Description')"));



                        })
                        )
				}
<script>
     function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }

        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }

                function dataGridSelectionChanged2(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#Costallocationemployees").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }
    function dataGridInitialized2(e) {
        dataGrid = e.component;
    }
      function dataGridSelectionChanged3(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#Costallocationproperty").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }
    function dataGridInitialized3(e) {
        dataGrid = e.component;
    }

    let GSCode = null;
    let DeliveryNoteSlNo1=null;

    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
         const DeliveryNoteSlNos = urlParams.get("DeliveryNoteSlNo");
       
          DeliveryNoteSlNo1 = DeliveryNoteSlNos ? DeliveryNoteSlNos.split("?")[0] : null;
          if(DeliveryNoteSlNo1){
              loadeditData(DeliveryNoteSlNo1);
          }

        const GSCodes = urlParams.get("gsCode");
       GSCode = GSCodes ? GSCodes.split("?")[0] : null;
        console.log("Loaded GSCode:", GSCode);
        if (GSCode) {
                // If Mprno is present, load client details
                loadClientDetails(GSCode);
            }

    });


        function loadClientDetails(GSCode) {
       $.ajax({
            url: `/api/AddNewClientRequest/GetdataByGSCode?GSCode=${encodeURIComponent(GSCode)}`,
            type: 'GET',
            dataType: 'json',
            success: function (res)  {
                console.log("ddd",res);
            $("#Size").dxTextBox("instance").option("value",res.ItemSize);
            $("#Manufacturer").dxTextBox("instance").option("value",res.ItemMake);
            $("#Brand").dxTextBox("instance").option("value",res.ItemBrand);
            $("#PartNo").dxTextBox("instance").option("value",res.ItemPartNo);
            },
            error: function (xhr) {
                console.log("data fetch failed:", xhr.responseText);
            }

        });
    }
      function  loadeditData(DeliveryNoteSlNo1) {
       $.ajax({
           url: `/api/DeliveryNote/GetDetaildescriptiondata?DeliveryNoteSlNo=${encodeURIComponent(DeliveryNoteSlNo1)}`,
            type: 'GET',
            dataType: 'json',
            success: function (res)  {
                console.log("ddd111",res);
              $("#DetailedDescription").dxTextArea("instance").option("value",res.AddlDescription);
              $("#Remarks").dxTextBox("instance").option("value",res.DeliveryRemarks);
             $("#Costallocationemployees").dxDropDownBox("instance").option("value",res.EmployeeNo);
            $("#Costallocationproperty").dxDropDownBox("instance").option("value",res.PropertyNo);
            },
            error: function (xhr) {
                console.log("data fetch failed:", xhr.responseText);
            }
        });
    }

    // 🔧 This must be globally accessible
    function getItemDescription() {
        if (!GSCode) {
            DevExpress.ui.notify("GSCode is missing", "error", 2000);
            return;
        }

        $.ajax({

            url: `/api/AddNewClientRequest/GetGSCodeDescription?gsCode=${encodeURIComponent(GSCode)}`,
            type: "GET",
            success: function (data) {
                $("#DetailedDescription").dxTextArea("instance").option("value", data);
            },
            error: function () {
                DevExpress.ui.notify("Failed to fetch description", "error", 2000);
            }
        });
    }

    function getDetailedDescription() {
        if (!GSCode) {
            DevExpress.ui.notify("GSCode is missing", "error", 2000);
            return;
        }

        $.ajax({
            url: `/api/AddNewClientRequest/GetGSCodeDetailedDescription?gsCode=${encodeURIComponent(GSCode)}`,
            type: "GET",
            success: function (data) {
                $("#DetailedDescription").dxTextArea("instance").option("value", data);
            },
            error: function () {
                DevExpress.ui.notify("Failed to fetch detailed description", "error", 2000);
            }
        });
    }




        function collectModalFields() {
        return {
            GSCode: GSCode,
            AddlDescription: $("#DetailedDescription").dxTextArea("instance").option("value"),
            DeliveryRemarks: $("#Remarks").dxTextBox("instance").option("value"),
            EmployeeNo: $("#Costallocationemployees").dxDropDownBox("instance").option("value"),
           PropertyNo: $("#Costallocationproperty").dxDropDownBox("instance").option("value"),
      
        };
    }

    // Send data to Page 1 when window is closing
    window.onbeforeunload = function () {
        if (window.opener && typeof window.opener.receiveModalFieldData === "function") {
            const fieldValues = collectModalFields();
            window.opener.receiveModalFieldData(fieldValues);
        }
    };
       function applyAndClose() {
        const modalData = {
             AddlDescription: $("#DetailedDescription").dxTextArea("instance").option("value"),
            DeliveryRemarks: $("#Remarks").dxTextBox("instance").option("value"),
            EmployeeNo: $("#Costallocationemployees").dxDropDownBox("instance").option("value"),
           PropertyNo: $("#Costallocationproperty").dxDropDownBox("instance").option("value"),
        };

        console.log("📤 Sending to parent:", modalData);

        if (window.parent && typeof window.parent.receiveModalFieldData === "function") {
            window.parent.receiveModalFieldData(modalData);
            window.parent.closeModal(); // or your custom modal close logic
        } else {
            alert("Could not send to parent.");
        }
    }


      $(function () {
            $("#detaileddescriptiondelivery").text(formatMessage("Detailed Description / Specification:"));
         });

</script>