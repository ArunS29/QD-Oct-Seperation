@page
@model QD.ERP.IMS.Areas.IMS.Pages.EditMaterialReceiptsNoteModel
@{
}
<style>
    

    .ledgerResult {
        overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
        width: 100%;
    }

    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold;
        font-size: 14px;
        padding: 10px 15px;
    }


        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue;
            color: white !important;
        }

    .dx-tabpanel {
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        padding: 5px 10px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .select-box {
        width: 20vh;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .layout-container {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-column {
        flex: 1 1 48%;
        display: flex;
        flex-direction: column;
    }

    .field-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.3rem;
    }

    .field-label {
        font-size: 0.95rem;
        font-weight: 500;
        color: #333;
    }

    .field-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-solid {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: #6c757d;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-outline {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: transparent;
        color: #6c757d;
        border: 1px solid #6c757d;
        border-radius: 4px;
        cursor: pointer;
    }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .containers {
        display: flex;
    }

    .dx-card {
        background: var(--background-color);
    }

    .important-height {
        height: 190px !important;
    }

</style>
<meta charset="UTF-8">
<div class="title">
    <div class="header-container">
        <div id="addNewDeliverytoClient" class="no-border-title"></div>
    </div>
</div>
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("MaterialReciptsdetails").Width("100%")
                .Items(item =>
                {
                    item.Add()
                .Title("Material Recipts Details")
                .Icon("folder")
                .Text("Material Recipts Details")
                .Template(@<text>
            <div style="padding: 20px;">
                <!-- Row 1 -->
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                        .ID("MaterialReceiptNo")
                        .Label("Material Receipt No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Value("AIC-MR-2025-00001")
                        .ReadOnly(true)
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().DateBox()
                        .ID("ReceiptDate")
                        .Label("Receipt Date")
                        .LabelMode(EditorLabelMode.Floating)
                        .Value(DateTime.Now)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierDeliveryNoteNo")
                        .Label("Supplier Delivery Note No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div style="flex: 2; display:flex; align-items:end;">
                        @(Html.DevExtreme().SelectBox()
                        .ID("SupplierName")
                        .Label("Supplier Name:")
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "Supplier A", "Supplier B" })
                        .SearchEnabled(true)
                        .ShowClearButton(true)
                        .Width("100%"))

                        @(Html.DevExtreme()
                        .Button()
                        .ID("Addplusbtn")
                        .Icon("plus"))
                    </div>
                </div>

                <!-- Row 2 -->
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                        .ID("MaterialRequestNo")
                        .Label("Material Request No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierQuotationNo")
                        .Label("Supplier Quotation No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().SelectBox()
                        .ID("JobCode")
                        .Label("Job Code:")
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "Job 001", "Job 002" }) // Replace accordingly
                        .Width("100%"))
                    </div>
                    <div style="flex: 2;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientName")
                        .Label("Client Name:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                </div>

                <!-- Row 3 -->
                <div style="display: flex; gap: 10px;">
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                        .ID("RFQNo")
                        .Label("RFQ No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                        .ID("PurchaseOrderNo")
                        .Label("Purchase Order No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().SelectBox()
                        .ID("SalesPerson")
                        .Label("Sales Person:")
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "John", "Ali", "Sara" })
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().SelectBox()
                        .ID("ItemsReceived")
                        .Label("Items Received In Store:")
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "Yes", "No" })
                        .Width("100%"))
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                        .ID("Project")
                        .Label("Project:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                </div>
            </div>


        </text>);

                    item.Add().Title("Signatories").Icon("detailslayout").Text("Signatories").Template(@<text>

            <div style="padding: 15px; margin-top: 15px;">
                <div style="display: flex; gap: 10px; align-items: flex-start;">
                    <!-- Signatory and Checkboxes -->
                    <div style="flex: 1;">
                        <div style="margin-bottom: 5px;">
                            @(Html.DevExtreme().SelectBox()
                            .ID("Signatory")
                            .Label("Signatory:")
                            .LabelMode(EditorLabelMode.Floating)
                            .DataSource(new[] { "Manager", "Director", "Supervisor" }) // Example values
                            .ShowClearButton(true)
                            .ShowDropDownButton(true)
                            .Width("100%"))
                        </div>
                        <div>
                            @(Html.DevExtreme().CheckBox().ID("ShowSignature").Value(true).Text("Show Signature"))
                        </div>
                        <div>
                            @(Html.DevExtreme().CheckBox().ID("ShowCompanySeal").Value(true).Text("Show Company Seal"))
                        </div>
                        <div>
                            @(Html.DevExtreme().CheckBox().ID("PrintInLetterHead").Value(true).Text("Print in Letter Head"))
                        </div>
                        <div>
                            @(Html.DevExtreme().CheckBox().ID("IsServiceEntrySheet").Value(false).Text("Is Service Entry Sheet"))
                        </div>
                    </div>

                    <!-- Remarks / Notes -->
                    <div style="flex: 2;">
                        @(Html.DevExtreme().TextArea()
                        .ID("RemarksNotes")
                        .Label("Remarks / Notes:")
                        .LabelMode(EditorLabelMode.Floating)
                        .ElementAttr("style", "height: 100px !important;")
                        .Width("100%"))
                    </div>
                </div>
            </div>

        </text>);
        item.Add().Text("Branch / Division").Icon("home").Title("Branch / Division").Template(@<text>
            <div style="padding: 15px;">
                <div>
                    @(Html.DevExtreme().SelectBox()
                    .ID("CompanyBranchDivision")
                    .Label("Company Branch/Division")
                    .LabelMode(EditorLabelMode.Floating)
                    .Width("30%"))
                </div>
                <div>
                    @(Html.DevExtreme().SelectBox()
                    .ID("InventoryGroupMaster")
                    .Label("Inventory Group Master:*")
                    .LabelMode(EditorLabelMode.Floating)
                    .Width("30%"))
                </div>
                <div>
                    @(Html.DevExtreme().SelectBox()
                    .ID("MaterialRecievedType")
                    .Label("Material Recieved Type")
                    .LabelMode(EditorLabelMode.Floating)
                    .Width("30%"))
                </div>
            </div>
        </text>);

                })
            )

    </div>
    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("600px")
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )
        .Columns(columns =>
        {
            columns.Add().Caption("#").CellTemplate(@<text>
        @(ViewData["rowIndex"] = ((int)(ViewData["rowIndex"] ?? 0)) + 1)
        @ViewData["rowIndex"]
    </text>).Width(100);
            columns.Add().DataField("ItemCode").Caption("Item Code");
            columns.Add().DataField("Description").Caption("Description");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("UnitRateMethod").Caption("Unit Rate Method");
            columns.Add().DataField("Qty").Caption("Qty");
            columns.Add().DataField("UnitCostPrice").Caption("Unit Cost Price").Format("currency");
            columns.Add().DataField("...").Caption("...").Format("currency");
            columns.Add().DataField("UnitPrice").Caption("Unit Price");
            columns.Add().DataField("QuotedDiscount").Caption("Quoted Discount");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("VATDesc").Caption("VAT Desc");
            columns.Add().DataField("VAT").Caption("VAT");
            columns.Add().DataField("Total").Caption("Total");
            columns.Add().DataField("TotalCost").Caption("Total Cost");
            columns.Add().DataField("ProfitOrLose").Caption("Profit Or Lose");
        })
        .ColumnAutoWidth(true)
        .Width("100%")
        .WordWrapEnabled(true)
        .OnCellClick("function(e) {handleCellClick(e);}")
        .ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(false))
        .Paging(p => p.Enabled(false))
        .Pager(pager => pager.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .ShowRowLines(true)
        )
</div>

<div class="form-container">
    <div class="footer-buttons">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-2">
                    @(Html.DevExtreme()
                        .Button()
                        .ID("btnSave")
                        .Text("Save")
                        .Icon("check")
                        .OnClick("onSaveSupplierMasterClick"))
                </div>
                <div class="col-md-2">
                    @(Html.DevExtreme()
                        .Button()
                        .ID("btnSaveClose")
                        .Text("Save & Close")
                        .Icon("check"))
                </div>
                <div class="col-md-2">
                    @(Html.DevExtreme()
                        .Button()
                        .ID("btnDelete")
                        .Text("Delete")
                        .Icon("trash"))
                </div>
                <div class="col-md-2">
                    @(Html.DevExtreme()
                        .Button()
                        .ID("btnBack")
                        .Text("Back")
                        .Icon("arrowleft"))
                </div>
            </div>
        </div>
    </div>
</div>
<div class="Head">
    <div class="footer-fixed">
        @await Html.PartialAsync("VATModuleFooter")
    </div>
</div>
         