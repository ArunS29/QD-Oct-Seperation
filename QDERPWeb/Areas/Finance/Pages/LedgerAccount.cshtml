    let acgid, accgrp = "", accgrpunder = null, IsAccGrp = false, accunderid = null, accountgroup = "";
    let getidfromCOA;//IsChart=false;
    let getUN=null;
    let userNames=null;
    let accgrpId = null;
    console.log("agid:", accgrpId);
    $(document).ready(function () {
        var urlParams = new URLSearchParams(window.location.search);
        var accountGroupId = urlParams.get('AccountGroupId');
        var accountheadid = urlParams.get('AccountHeadID');
        var refno = urlParams.get('ReferenceNo') || " ";
        var accheadname = urlParams.get('AccountHeadName') || "";
        var accgroup = urlParams.get('AccountGroup') || "";
        accountgroup = accgroup;
        var isedit = urlParams.get('IsEdit') === "true"; // Explicit comparison to string "true"
        var accgroupid = urlParams.get('AccountGroupID') || "";
        acgid = accgroupid;

        var accheadar = urlParams.get('AccountHeadAr') || "";

        const IsCharOfAccounts = urlParams.get('IsCharOfAccounts'); // This will be a string ('true' or 'false')

        if (IsCharOfAccounts === 'true') {
            // Directly assign AccountId to the already declared accountheadid variable
            accountheadid = urlParams.get('AccountId');  // Use the already declared accountheadid

        }

        // alert(IsCharOfAccounts);
        // Check if IsCharOfAccounts is 'true' (string comparison)
        // alert("AccountHeadId: " + accountheadid);
         $.ajax({
             url: "/api/AccountLedgerMaster/getUserName",
            type: 'GET',//
            dataType: 'json',  // Expecting JSON response
            success: function (response) {
                  getUN=response.UserName;
                //   $("#CreatedBy").dxTextBox("instance").option("value", getUN);
                  console.log("userN:",getUN);
            }
         });
        function formatDate(date) {
            if (date) {
                const dateObj = new Date(date);
                return dateObj.toISOString().split("T")[0]; // Extracts only the YYYY-MM-DD part
            }
            return '';
        }
        

        // If AccountGroupId exists, set it in the DropDownBox and make it readonly

        if (accountGroupId) {
            var ddlAccountGroup = $('#ddlAccountGroup').dxDropDownBox('instance');
            if (ddlAccountGroup) {
                ddlAccountGroup.option('value', accountGroupId);
                ddlAccountGroup.option('disabled', true); // Make it readonly
            }
        }
