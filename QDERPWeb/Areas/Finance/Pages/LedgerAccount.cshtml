        iframe.src = `/${tenantName}/Finance/LedgerAccountMaster?AccountGroup=${encodeURIComponent(accgrp)}&AccountGroupUnder=${encodeURIComponent(accgrpunder)}&AccountGroupId=${encodeURIComponent(accgrpId)} `;

        modal.style.display = "block";

        const closeBtn = modal.querySelector(".close");
        closeBtn.onclick = () => {
            modal.style.display = "none";
            refreshaccountledgerSelectBox();
        };

        window.onclick = (event) => {
            if (event.target === modal) {
                modal.style.display = "none";
                refreshaccountledgerSelectBox();
            }
        };
    }
    //Disable Tabs
    function disableTabs(tabIds) {
        tabIds.forEach(tabId => {
            const tabElement = document.getElementById(tabId);

            if (tabElement) {
                console.log(`Disabling tab: ${tabId}`);

                // Hide the tab content
                //tabElement.style.display = 'none';

                tabElement.style.backgroundColor = '#d3d3d3'; // Light gray background
                tabElement.style.color = '#a0a0a0'; // Gray text
                tabElement.style.pointerEvents = 'none'; // Disable all pointer events (makes it non-clickable)
                tabElement.style.opacity = '0.6'; // Make it look disabled


            } else {
                console.error(`Tab with ID "${tabId}" not found.`);
            }
        });
    }




    async function onDownArrowClick() {
        // Get the TextBox instances
        const clientBillingTextBox = $("#txtClientBilling").dxTextBox("instance");
        const accountHeadTextBox = $("#txtAccountHead").dxTextBox("instance");
        const clientBillingTextBoxAr = $("#txtClientBillingAr").dxTextBox("instance");

        // Ensure the text box instances are defined
        if (!clientBillingTextBox || !accountHeadTextBox || !clientBillingTextBoxAr) {
            alert("One or more TextBox instances could not be initialized.");
            return;
        }

        // Get the value from txtAccountHead
        const accountHeadValue = accountHeadTextBox.option("value");

        // Check if the value is not empty
        if (accountHeadValue && accountHeadValue.trim() !== "") {
            try {
                // Get Arabic translation
                const arabicTranslation = await translateToArabic(accountHeadValue);

                // Set the value of txtClientBilling and txtClientBillingAr
                clientBillingTextBox.option("value", accountHeadValue);
                clientBillingTextBoxAr.option("value", arabicTranslation);
            } catch (error) {
                console.error("Error during translation:", error);
                alert("Failed to translate Account Head Name to Arabic.");
            }
        } else {
            // If txtAccountHead is empty or null, show an alert
            alert("Account Head Name cannot be empty.");
        }
    }
