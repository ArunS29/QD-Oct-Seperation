    function txtAccountHeadFocusOut(e) {

        var sTextVal = $('#txtAccountHead').dxTextBox('option', 'value');

        if (sTextVal) {
            $.ajax({
                url: '/api/AccountLedgerMaster/FindDuplicatesOnAccountHead',
                type: 'GET',
                dataType: 'json',  // The type of data you're expecting back from the server
                data: {
                    stAccountHeadValue: sTextVal
                },
                success: function (response) {

                    response.forEach(function (item) {
                        var AcId = item.MaxAccountId;
                        var isValid = item.IsValid;

                        if (isValid == true) {
                            alert("This Account Head Name is already mapped the Account Ledger No : '" + AcId + "'");
                            $('#txtAccountHead').dxTextBox('option', 'value', '');
                            return false;
                        } else {
                            //console.log("No account ID returned.");
                        }
                    });


                },
                error: function (xhr, status, error) {
                    // Handle any error that occurred during the request
                    console.log("Error: " + error);
                }
            });
        }
        else {
            //  alert("Account Head Cannot be empty");
            DevExpress.ui.notify("Account Head Cannot be empty", "error", 2000);

        }


    }

