    function handleFileSelection() {
        const fileInput = document.getElementById("fileInput");

        if (!fileInput) {
            console.error("Error: fileInput element not found!");
            return;
        }

        fileInput.multiple = false; // Force single file selection
        fileInput.click(); // Open file picker
    }

    // Handle file selection
    document.addEventListener("DOMContentLoaded", function () {
        const fileInput = document.getElementById("fileInput");

        if (fileInput) {
            fileInput.addEventListener("change", function () {
                const files = this.files;
                console.log("Selected file:", files[0]); // Log the selected file
            });
        } else {
            console.error("Error: fileInput element not found on page load!");
        }
    });

