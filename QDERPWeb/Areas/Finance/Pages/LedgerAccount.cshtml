@page
@using DevExtreme.AspNet.Mvc
@model QD.ERP.Web.Areas.Finance.Pages.LedgerAccountModel
@{
}

<style>
    .body {
        padding-top: 0px;
    }

    .content {
        margin: 0px;
    }

    .content-container-top {
        width: 1100px;
    }
    /* Custom CSS to adjust the height of tab headers */
    .dx-tabpanel .dx-tab {
        padding: 10px 15px; /* Adjust padding to change height */
        font-size: 16px; /* Adjust font size to change header height */
    }

    /* Ensuring the content area also adjusts in height */
    .dx-tabpanel .dx-tab-content {
        padding: 20px;
        min-height: 200px; /* Minimum height for the tab content */
    }

    .dx-fieldset {
        margin: 3px 3px !important;
        padding: 0px;
    }

    .dx-datagrid-headers th {
        text-align: center; /* Centers the text */
    }

    .columnheader {
        text-align: center;
    }
    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

        .tab-content h3 {
            color: #333;
        }

        .tab-content p {
            line-height: 1.6;
            color: #555;
        }

    .dx-dropdownbox .dx-dropdownbox-wrapper .dx-dropdownbox-header {
        display: none;
    }

    .button-group {
        margin-left: 1px !important;
    }

    .button-alignment-up {
        margin-top: 25px !important;
    }

    .button-alignment-down {
        margin-top: 0px !important;
    }

    /*     .dx-editor-outlined .dx-label span {
                    font-weight:bold !important;
                    } */

    .custom-textbox input {
        font-weight: bold !important;
        color: black !important; /* Use !important to override DevExtreme styles */
        /*   border: 3px solid #282222;
                    border-radius: 8px !important; */
    }

    .custom-textbox1 input {
        border: 3px solid #282222;
        /* border-radius: 8px !important; */
    }

    .custom-textbox1 .dx-dropdowneditor-icon {
        border: 3px solid #282222 !important;
        /*  border-radius: 8px !important; */
    }
    /* Modal Styles */
    .modal {
        display: none; /* Hidden by default */
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
    }

    .modal-content {
        background-color: var(--menu-color);
        margin: 5% auto;
        padding: 20px;
        border: 1px solid #888;
        border-radius: 10px;
        width: 80%;
        max-width: 1200px;
        position: relative;
        display: flex;
        align-items: end;
        justify-content: end;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

        .close:hover,
        .close:focus {
            color: black;
        }

    .containerLedgerAccount {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .titleLedgerAccount {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5em;
    }

    .no-border-input {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        font-weight: bold;
        font-size: 16px;
        color: black;
        pointer-events: none; /* Prevents hover and click effects */
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width:100%;
    }

    .playIcon{
        display:none;
    }
    
</style>
<link rel="stylesheet" href="~/css/Site.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
<input id="formId" value="frm201LedgerAccount" type="hidden" />
<div class="title">
    <div class="header-container">
        <div id="Ledgeraccount" class="no-border-title"></div>
    </div>
</div>
<div class="containerLedgerAccount">

    <div class="content-container-top">
        <div class="dx-fieldset horizontal-container">
            @(Html.DevExtreme().TextBox()
                .ID("txtAccountId")
                .Label(new JS("formatMessage('Account ID')"))
                .Disabled(true)
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Text")
                .ElementAttr(new { @class = "custom-textbox" })
                .Width("20%")
                .TabIndex(1)
                )
            @(Html.DevExtreme().TextBox()
                .ID("txtReferenceNo")
                .Label(new JS("formatMessage('Reference No')"))
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Text")
                @* .ElementAttr(new { @class = "custom-textbox1" }) *@
                .Width("30%")
                .TabIndex(2)
                )
            @(Html.DevExtreme().TextBox()
                .ID("txtAccountHead")
                .Label(new JS("formatMessage('Account Head Name')"))
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Text")
                @*  .ElementAttr(new { @class = "custom-textbox1" }) *@
                .TabIndex(3)
                .Width("100%")
                .ValidationRules(value => value.AddRequired().Message(new JS("formatMessage('Account Head Name cannot be empty')")))
                .OnFocusOut("txtAccountHeadFocusOut")
                )
            <!-- Container for txtAccountHeadAr and button -->
            <div style="display: flex; align-items: center; width: 100%;gap:5px;">
                @(Html.DevExtreme().TextBox()
                    .ID("txtAccountHeadAr")
                    .Label(new JS("formatMessage('Account Head in Arabic')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .InputAttr("aria-label", "Text")

                    .Width("100%")
                    .TabIndex(2)
                    //.ValidationRules(value => value.AddRequired().Message("Account Head Name cannot be empty"))
                    .OnFocusOut("txtAccountHeadFocusOut")
                    )
                <span class="input-group-prepend" style="margin-top: 22px;">

                    @(
                        Html.DevExtreme().Button()
                        .ID("convertToArabic1")
                        .Width(75)
                        .Height(33)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { convertToArabic(); }")
                        )
                </span>


            </div>

        </div>
        <!-- Create a wrapper div for the row layout -->
        <div class="d-flex align-items-center">
            @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("AccountLedgerMaster")
                .LoadAction("getAccountingLedger")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountGroupId") // This is the unique key for the data source
                )
                .LabelMode(EditorLabelMode.Outside)
                .Label(new JS("formatMessage('Account Group')"))
                .ID("ddlAccountGroup")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("AccountGroupId")
                .DisplayExpr("AccountGroup")
                .OnInput("ddlAccountGroupOnInput")
                .OnOpened("ddlAccountGrouponOpened")
                .Width("70%")
                .TabIndex(4)
                .ValidationRules(value => value.AddRequired().Message(new JS("formatMessage('Account Group cannot be empty')")))
                .ValidationMessageMode(ValidationMessageMode.Auto)
                .DropDownOptions(o => o
                .Width("100%")
                )
                .OnKeyDown("ddlAccountGrouponKeyDown")
                .OnValueChanged("ddlAccountGroupValueChanged")
                .ContentTemplate(new TemplateName("AccountGroupContentTemplate"))
                )

            @(Html.DevExtreme().Button()
                .ID("btnAddAccount")
                .Icon("plus")
                .ElementAttr("class", "button-alignment-up button-group")
                .OnClick("redirectledgerAccountMaster")
                )
            @(Html.DevExtreme().Button()
                .ID("btnEditAccount")
                .Icon("edit")
                .ElementAttr("class", "button-alignment-up button-group")
                .OnClick("function() {  var dropDownBox = $('#ddlAccountGroup').dxDropDownBox('instance');  var selectedValue = dropDownBox.option('value');  if (selectedValue === null || selectedValue === '') { alert('Please Select the Account Group.');  return;  } redirectledgerAccountMaster() }")
                )
        </div>
        <br />

        <div class="dx-fieldset horizontal-container">
            @(
                Html.DevExtreme().Tabs()
                .Items(items =>
                {
                    //tab-content-1
                    items.Add()
                    .Icon("optionsgear")
                    .Text(new JS("formatMessage('Settings')"));
                    //  .Disabled(false);

                    //tab-content-2
                    items.Add()
                    .Icon("accountbox")
                    .Text(new JS("formatMessage('Contact Details')"));
                    // .Disabled(false);
                    //tab-content-3
                    items.Add()
                    .Icon("description")
                    .Text(new JS("formatMessage('Bank Details')"));
                    // .Disabled(false);
                    //tab-content-4
                    items.Add()
                    .Icon("card")
                    .Text(new JS("formatMessage('Client Details')"));
                    //.Disabled(false);
                    //tab-content-5
                    items.Add()
                    .Icon("group")
                    .Text(new JS("formatMessage('Supplier Details')"));
                    // .Disabled(false);
                    //tab-content-6
                    items.Add()
                    .Icon("attach")
                    .Text(new JS("formatMessage('Attachments')"));
                    //   .Disabled(false);
                    //tab-content-7
                    items.Add()
                    .Icon("file")
                    .Text(new JS("formatMessage('Billing Details')"));
                    //.Disabled(false);
                    //tab-content-8
                    items.Add()
                    .Icon("description")
                    .Text(new JS("formatMessage('Obsolete (for Old Version)')"));
                    //.Disabled(false);
                })
                .SelectedIndex(0) // Default selected tab is the first one
                .OnSelectionChanged("onTabSelectionChanged") // Event handler for tab selection changes
                )
        </div>


        <!-- Tab Content -->
        <div class="dx-fieldset">
            <div id="tab-content-1" class="tab-content" style="display: none;">
                <div>
                    <table width="100%" style="font-size:14px; margin-top:10px;margin-bottom:10px;" cellpadding="5">
                        <tr>
                            <td>
                                <div id="OpeningBalance" class="no-border-input"></div>
                            </td>
                            <td>
                                @(
                                    Html.DevExtreme().NumberBox()
                                    .ID("txtOpeningBalance")
                                    .Value(0)
                                    .Min(0.00)
                                    .Format(format => format.Type("fixedPoint").Precision(2))
                                    .Width("100%")// Initial value
                                    @*  .Min(0)              // Minimum value
                                .Max(1000)  *@              // Maximum value
                                    .Step(1)             // Increment step
                                    .ShowSpinButtons(true) // Show spin buttons for up/down
                                                           //.Format("fixedPoint")  // Format as fixed-point (number with decimals)
                                                           //.FormatOptions(options => options.Precision(2))  // 2 decimal places
                                    .InputAttr(new { style = "text-align: right; color:darkred; font-weight:bold;" }) //.OnValueChanged("onValueChangedHandler") // Optional JS function for value change
                                    )
                            </td>
                            <td>
                                @(Html.DevExtreme().DropDownBox()
                                    .DataSource(d => d.WebApi()
                                    .Controller("AccountLedgerMaster")
                                    .LoadAction("getCreditDebit")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("OpeningBalanceDrCr")
                                    )
                                    .ID("ddlCreditDebit")
                                    .ShowClearButton(true)
                                    .AcceptCustomValue(false)
                                    .OpenOnFieldClick(false)
                                    .ValueChangeEvent("input")
                                    .HoverStateEnabled(true)
                                    .ValueExpr("OpeningBalanceDrCr")
                                    .DisplayExpr("OpeningBalanceDrCr")
                                    .OnInput("DrCrOnInput")
                                    .OnOpened("onOpenedDrCr")
                                    .Width("100%")
                                    .TabIndex(4)
                                    .DropDownOptions(o => o
                                    .Width("100%") // Set the desired width for the dropdown content*@
                                    )
                                    .OnKeyDown("DrCrKeyDown")
                                    .OnValueChanged("DrCrValueChanged")
                                    .ContentTemplate(new TemplateName("DrCrContentTemplate"))
                                    )
                            </td>
                            <td>
                                @(Html.DevExtreme().Button()
                                    .ID("btnPost")
                                    .Icon("datausage")
                                    .Text(new JS("formatMessage('Post')"))
                                    .Width("100%")
                                    .OnClick("onPostButtonClick")
                                    )
                            </td>
                            <td>
                                @(Html.DevExtreme().Button()
                                    .ID("btnOpeningBills")
                                    .Icon("contentlayout")
                                    .Text(new JS("formatMessage('Opening Bills')"))
                                    .Width("100%")
                                    .Disabled(false)
                                    )
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="DefaultEntry" class="no-border-input"></div>
                            </td>
                            <td colspan="2">
                                @(Html.DevExtreme().CheckBox()
                                    .ID("chkDefaultEntry")
                                    .Text(new JS("formatMessage('Choose if you want this to be Default Entry in vouchers')"))
                                    .Value(false)
                                    // .Disabled(true)
                                    .ElementAttr("style", "font-style:italic;font-weight:bold;")
                                    )
                            </td>
                            <td>
                                <div id="VoucherNoAbbr" class="no-border-input"></div>
                            </td>
                            <td>
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtVoucherNoAbbr")
                                    .InputAttr("aria-label", "Text")
                                    .Width("100%")
                                    .MaxLength(3)
                                    )
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="MaintainBillEntry" class="no-border-input"></div>
                            </td>
                            <td colspan="2">
                                @(Html.DevExtreme().CheckBox()
                                    .ID("chkMaintainBillEntry")
                                    .Text(new JS("formatMessage('Choose if you want to Maintain Billwise Details')"))
                                    .Value(false)
                                    //.Disabled(true)
                                    .ElementAttr("style", "font-style:italic;font-weight:bold;")
                                    )
                            </td>
                            <td>
                                <div id="NoDays" class="no-border-input"></div>
                            </td>
                            <td>
                                @(Html.DevExtreme().NumberBox()
                                    .ID("txtNoDays")
                                    .Value(0)
                                    .Min(0)
                                    .Step(1)             // Increment step
                                    .ShowSpinButtons(true) // Show spin buttons for up/down
                                    .Format("fixedpoint")
                                    .InputAttr(new { style = "text-align: left; color:darkblack; font-weight:bold;" })
                                    )
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div id="EmployeeDBEntry" class="no-border-input"></div>
                            </td>
                            <td colspan="4">
                                @(Html.DevExtreme().CheckBox()
                                    .ID("chkEmployeeDBEntry")
                                    .Text(new JS("formatMessage('Choose if you want this account to link with Employee Database')"))
                                    .Value(false)
                                    //.Disabled(true)
                                    .ElementAttr("style", "font-style:italic;font-weight:bold;")
                                    )
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div id="PropertyDBEntry" class="no-border-input"></div>
                            </td>
                            <td colspan="4">
                                @(Html.DevExtreme().CheckBox()
                                    .ID("chkPropertyDBEntry")
                                    .Text(new JS("formatMessage('Choose if you want this account to link with Property Database')"))
                                    .Value(false)
                                    //.Disabled(true)
                                    .ElementAttr("style", "font-style:italic;font-weight:bold;")
                                    )
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div id="LoanAccountEntry" class="no-border-input"></div>
                            </td>
                            <td colspan="4">
                                @(
                                    Html.DevExtreme().CheckBox()
                                    .ID("chkLoanAccountEntry")
                                    .Text(new JS("formatMessage('Choose if you want this account to link with Employees Salary Advance')"))
                                    .Value(false)
                                    //.Disabled(true)
                                    .ElementAttr("style", "font-style:italic;font-weight:bold;")
                                    )
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2">
                            </td>
                            <td colspan="2">
                                <div id="LedgerActive" class="no-border-input"></div>
                            </td>
                            <td>
                                @(Html.DevExtreme().Switch()
                                    .ID("schLedgerActive")
                                    .Value(false)  // Set initial state to "on"
                                    .SwitchedOffText("No") // Text to display when the toggle is on
                                    .SwitchedOnText("Yes") // Text to display when the toggle is off
                                    .Width(100) // Width of the toggle switch
                                    )
                            </td>
                        </tr>

                    </table>
                </div>
            </div>

            <div id="tab-content-2" class="tab-content" style="display: none;">
                <div>
                    <table width="100%" style="font-size:14px; margin-top:10px;margin-bottom:10px;" cellpadding="5">
                        <tr>
                            <td>
                                <div id="branch" class="no-border-input"></div>
                            </td>
                            <td>
                                @(Html.DevExtreme().DropDownBox()
                                    .DataSource(d => d.WebApi()
                                    .Controller("AccountLedgerMaster")
                                    .LoadAction("getAccountBranch")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("BranchCode")
                                    )
                                    .ID("ddlbranch")
                                    .ShowClearButton(true)
                                    .AcceptCustomValue(true)
                                    .OpenOnFieldClick(false)
                                    .ValueChangeEvent("input")
                                    .HoverStateEnabled(true)
                                    .ValueExpr("BranchCode")
                                    .DisplayExpr("BranchName")
                                    .OnInput("ddlbranchOnInput")
                                    .OnOpened("ddlbranchonOpened")
                                    .Width("100%")
                                    .DropDownOptions(o => o
                                    .Width("100%")
                                    )
                                    .OnKeyDown("ddlbranchonKeyDown")
                                    .OnValueChanged("ddlbranchValueChanged")
                                    .ContentTemplate(new TemplateName("BranchContentTemplate"))
                                    )


                            </td>
                            <td>
                                @(Html.DevExtreme().Button()
                                    .ID("btnAddDivision")
                                    .Icon("plus")
                                    .ElementAttr("class", "button-alignment-down button-group")
                                    .OnClick("redirectToBranchMaster")
                                    )
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="Subgroup" class="no-border-input"></div>
                            </td>
                            <td>
                                @(Html.DevExtreme().DropDownBox()
                                    .DataSource(d => d.WebApi()
                                    .Controller("AccountLedgerMaster")
                                    .LoadAction("getSubGroup")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("LedgerSubGroupCode")
                                    )
                                    .ID("ddlSubgroup")
                                    .ShowClearButton(true)
                                    .AcceptCustomValue(true)
                                    .OpenOnFieldClick(false)
                                    .ValueChangeEvent("input")
                                    .HoverStateEnabled(true)
                                    .ValueExpr("LedgerSubGroupCode")
                                    .DisplayExpr("SubGroupName")
                                    .OnInput("ddlsubGroupOnInput")
                                    .OnOpened("ddlsubGrouponOpened")
                                    .Width("100%")
                                    .TabIndex(4)
                                    .DropDownOptions(o => o
                                    .Width("100%")
                                    )
                                    .OnKeyDown("ddlsubGrouponKeyDown")
                                    .OnValueChanged("ddlsubGroupValueChanged")
                                    .ContentTemplate(new TemplateName("SubGroupContentTemplate"))
                                    )

                            </td>
                            <td>
                                @(Html.DevExtreme().Button()
                                    .ID("btnAddSubgroup")
                                    .Icon("plus")
                                    .ElementAttr("class", "button-alignment-down button-group")
                                    .OnClick("redirecttoledgersubgroup")
                                    )
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="Sales" class="no-border-input"></div>
                            </td>
                            <td>
                                @(Html.DevExtreme().DropDownBox()
                                    .DataSource(d => d.WebApi()
                                    .Controller("AccountLedgerMaster")
                                    .LoadAction("getSalesPersonList")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("SalesPersonCode")
                                    )
                                    .ID("ddlSales")
                                    .ShowClearButton(true)
                                    .AcceptCustomValue(true)
                                    .OpenOnFieldClick(false)
                                    .ValueChangeEvent("input")
                                    .HoverStateEnabled(true)
                                    .ValueExpr("SalesPersonCode")
                                    .DisplayExpr("SalesPersonName")
                                    .OnInput("ddlSalesOnInput")
                                    .OnOpened("ddlSalesonOpened")
                                    .Width("100%")
                                    .TabIndex(4)
                                    .DropDownOptions(o => o
                                    .Width("100%")
                                    )
                                    .OnKeyDown("ddlSalesonKeyDown")
                                    .OnValueChanged("ddlSalesValueChanged")
                                    .ContentTemplate(new TemplateName("SalesContentTemplate"))
                                    )
                            </td>
                            <td>
                                @(Html.DevExtreme().Button()
                                    .ID("btnAddSalesperson")
                                    .Icon("plus")
                                    .ElementAttr("class", "button-alignment-down button-group")
                                    .OnClick("redirecttosalespersonmaster")
                                    )
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div id="ContactPerson" class="no-border-input"></div>
                            </td>
                            <td colspan="2">
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtContactPerson")
                                    .InputAttr("aria-label", "Text")// Dynamic value
                                    .Width("100%")
                                    )
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div id="PersonTitle" class="no-border-input"></div>
                            </td>
                            <td colspan="2">
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtPersonTitle")
                                    .InputAttr("aria-label", "Text")
                                    .Width("100%")
                                    )
                            </td>

                        </tr>

                        <tr>
                            <td>
                                <div id="Email" class="no-border-input"></div>
                            </td>
                            <td colspan="2">
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtEmail")
                                    .ValidationRules(value => value.AddEmail().Message(new JS("formatMessage('Please Enter the Valid Email Address')")))
                                    .InputAttr("aria-label", "Text")// Dynamic value
                                    .Width("100%")
                                    )
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="MobileNo" class="no-border-input"></div>
                            </td>
                            <td colspan="2">
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtPersonMobile")
                                    .InputAttr("aria-label", "Text")
                                    .Width("100%")
                                    )
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div id="Remarks" class="no-border-input"></div>
                            </td>
                            <td colspan="2">
                                @(Html.DevExtreme().TextBox()
                                    @*  .Label(new JS("formatMessage('Remarks')")).LabelMode(EditorLabelMode.Outside) *@
                                    .ID("txtRemarks")
                                    .InputAttr("aria-label", "Text")
                                    .Width("100%")
                                    )
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <div id="tab-content-3" class="tab-content" style="display: none;">
                <div class="background">
                    <table width="100%" style="font-size:14px; margin-top:10px;margin-bottom:10px;" cellpadding="5">
                        <tr>
                            <td style="width: 15%;">
                                <div id="BankAccountName" class="no-border-input"></div>
                            </td>
                            <td style="width: 35%;">
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtBankAccountName")
                                    .InputAttr("aria-label", "Text")
                                    .Width("100%")
                                    )
                            </td>
                            <td style="width: 17%;">
                                <div id="ConvertAccountName" class="no-border-input"></div>
                            </td>
                            <td colspan="3" style="display: flex; align-items: center;gap: 5px;">
                                @(Html.DevExtreme().Button()
                                    .ID("btnConvertAccountName")
                                    .Width(75)
                                    .Height(32)
                                    .Icon("fas fa-language") // Add an icon
                                    .ElementAttr(new { @class = "convert-button" })
                                    .OnClick("convertAccountNameToArabic") // Define the function
                                    )
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtBankAccountNameAr")
                                    .InputAttr("aria-label", "Text")
                                    .Width("100%")
                                    .RtlEnabled(true)

                                    )
