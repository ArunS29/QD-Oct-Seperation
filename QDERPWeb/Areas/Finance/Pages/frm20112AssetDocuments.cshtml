    function UpdateVoucherEntry(DocNo) {
        if (!DocNo) {
            DevExpress.ui.notify("Asset Documents List has been successfully updated.", "success", 2000);
            return;
        }

        // Get the DataGrid instance
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        if (!dataGrid) {
            DevExpress.ui.notify("Error: DataGrid instance not found.", "error", 3000);
            return;
        }

        // Fetch all data asynchronously to ensure we have the correct dataset
        dataGrid.getDataSource().store().load().done(function (allData) {
            if (!allData || allData.length === 0) {
                DevExpress.ui.notify("No data found in the grid.", "error", 3000);
                return;
            }

            // Find the specific row using the provided DocNo
            const updatedRow = allData.find(row => row.DocumentNo === DocNo);

            if (!updatedRow) {
                DevExpress.ui.notify("Document number not found in grid data.", "error", 3000);
                return;
            }

            // Prepare the data to send to the server
            const documentData = { DocumentNo: updatedRow.DocumentNo };

            console.log("Document to send:", documentData);

            // Send the `DocumentNo` to the server
            $.ajax({
                url: "/api/LedgerAccountMaster/UpdateAssetDocument", // API endpoint
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(documentData),
                success: function (response) {
                    //dataGrid.refresh(); // Refresh the grid after successful update
                    //   DevExpress.ui.notify("Document updated successfully!", "success", 2000);
                },
                error: function (xhr, status, error) {
                    // Handle error and notify user
                    const errorMessage = xhr.responseJSON ? xhr.responseJSON.message : error;
                    DevExpress.ui.notify(`Failed to update document: ${errorMessage}`, "error", 4000);
                }
            });
        }).fail(function (error) {
            DevExpress.ui.notify("Error loading data from DataGrid.", "error", 3000);
            console.error("Data load error:", error);
        });
    }



    function onDropDownBoxValueChanged(e) {
        const selectedDropDownValue = e.value; // Update the selected value

        // Update the DataGrid selection to match the DropDownBox value
        const dataGrid = $("#DocumentTypeDropdownGrid").dxDataGrid("instance");
        if (dataGrid) {
            const items = dataGrid.getDataSource().items();
            const selectedItem = items.find(item => item.DocumentType === selectedDropDownValue);
            if (selectedItem) {
                selectedDocumentTypeIdID = selectedItem.DocumentTypeId; // Store the ID
                dataGrid.selectRows([selectedDocumentTypeIdID]);
            } else {
                selectedDocumentTypeIdID = null; // Clear the ID if no match
                dataGrid.clearSelection();
            }
        }
    }


    function onDataGridContentReady(e) {
        const dataGrid = e.component;

        // Ensure the DataGrid selection reflects the DropDownBox value
        const items = dataGrid.getDataSource().items();
        const selectedItem = items.find(item => item.DocumentType === selectedDropDownValue);
        if (selectedItem) {
            selectedDocumentTypeIdID = selectedItem.DocumentTypeId; // Update the ID
            dataGrid.selectRows([selectedDocumentTypeIdID]);
        } else {
            selectedDocumentTypeIdID = null; // Clear the ID if no match
            dataGrid.clearSelection();
        }
    }


    function gridBox_valueChanged(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var rowIndex = e.element.closest("tr").index(); // Get the edited row index
        var rowData = grid.getVisibleRows()[rowIndex].data;

        let DocumentTypeDropdownGrid = $("#DocumentTypeDropdownGrid").dxDataGrid("instance");
        let selectedRowData = DocumentTypeDropdownGrid.getSelectedRowsData()[0]; // Get first selected row

        if (selectedRowData) {
            rowData.DocumentTypeId = selectedRowData.DocumentTypeId; // Store ID
            rowData.DocumentType = selectedRowData.DocumentType; // Store text

            // Update grid cell values to reflect selection
            grid.cellValue(rowIndex, "DocumentTypeId", selectedRowData.DocumentTypeId);
            grid.cellValue(rowIndex, "DocumentType", selectedRowData.DocumentType);
        }

        grid.refresh(); // Ensure UI updates properly
    }



