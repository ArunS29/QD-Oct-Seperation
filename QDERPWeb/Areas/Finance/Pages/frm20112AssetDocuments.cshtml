            }
        }

        var selectedValue = selectedKey;

        $.ajax({

            type: "GET",
            url: `/api/LedgerAccountMaster/GetAccountMasterAR?MasterGroup=${encodeURIComponent(selectedValue)}`, // Pass value as a query parameter
            contentType: "application/json",
            dataType: "json",
            success: function (response) {
                if (response) {

                    mARresponse = response;


