                    // $("#accountDropDownBoxArabic").dxDataGrid("instance").option("dataSource", [response]); // Ensure response is array
                    //const responseKey = response[0]?.key || response.key; // Adjust based on response structure
                    dataGridAccountMasterSelectionChangedAr({ selectedRowKeys: [mARresponse] });

