<script>
$(function () {

										$("#AssetDocuments").dxTextBox({
													text:formatMessage("Asset Documents"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
$(function () {

										$("#EnteraNewDocumentAddtotheExistingList").dxTextBox({
													text:formatMessage("Enter a New Document Add to the Existing List"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading10");
		}

                                    });
									});
    var mARkey = null;
    let mARresponse = null, DocNo = null, DocType = null;


    $(document).ready(function () {
        // Retrieve VoucherNo from query parameters
        const urlParams = new URLSearchParams(window.location.search);
        const voucherNo = urlParams.get('VoucherNo');
        // alert(voucherNo);

        if (voucherNo) {
            // Wait for DevExtreme TextBox to initialize
            const interval = setInterval(() => {
                const voucherRefernceNoInstance = $("#ReferenceNo").dxTextBox("instance");

                if (voucherRefernceNoInstance) {
                    // Set the value and stop the interval
                    voucherRefernceNoInstance.option("value", voucherNo);

                    clearInterval(interval);
                }
            }, 100); // Retry every 100ms
        }
    });


    $(function () {
        $.ajax({
            url: "/api/LedgerAccountMaster/GetAssetDocumentNo",
            type: 'GET',
            success: function (data) {
                // Set the value in the VoucherNo TextBox
                $("#DocumentNo").dxTextBox("instance").option("value", data);

            },
            error: function (xhr, status, error) {
                console.error("Error loading Voucher No:", error);
            }
        });
    });

    function addVoucherEntry() {
        // Get the validator instance for the dropdown
        var accountMasterDropDownBoxValidator = $("#accountMasterDropDownBox").dxValidator("instance");
        var accountMasterDropDownBoxValidation = accountMasterDropDownBoxValidator.validate();
        var accountMasterDropDownBoxNotificationValidator = $("#accountMasterDropDownBoxNotification").dxValidator("instance");
        var accountMasterDropDownBoxNotificationValidation = accountMasterDropDownBoxNotificationValidator.validate();
        var accountMasterDropDownBoxExpiryValidator = $("#accountMasterDropDownBoxExpiry").dxValidator("instance");
        var accountMasterDropDownBoxNotificationValidation = accountMasterDropDownBoxExpiryValidator.validate();
        // accountMasterDropDownBoxNotification
        // accountMasterDropDownBoxExpiry

        // Validate input fields
        if (accountMasterDropDownBoxValidation.isValid && accountMasterDropDownBoxNotificationValidation.isValid && accountMasterDropDownBoxNotificationValidation.isValid) {
            // Prepare the VM (View Model) for the API call
            var VM = {
                "DocumentNo": $("#DocumentNo").dxTextBox("instance").option("value"),
                "DocumentType": $("#accountMasterDropDownBox").dxDropDownBox("instance").option("value"),
                "DocumentRefNo": $("#ReferenceNo").dxTextBox("instance").option("value"),
                "DocumentRemarks": $("#Remarks").dxTextBox("instance").option("value"),
                "DocumentExpDate": $("#accountMasterDropDownBoxExpiry").dxDateBox("instance").option("value"),
                "DocumentExpDateAr": $("#ExpiryDate").dxTextBox("instance").option("value"),
                "DocumentNotificationDate": $("#accountMasterDropDownBoxNotification").dxDateBox("instance").option("value")
            };

            // Get selected row data from the data grid
            var selectedRowData = $("#accountpaymentamount-datagrid").dxDataGrid("instance").getSelectedRowsData();

            // Check if selectedRowData is valid and has at least one row
            if (!selectedRowData || selectedRowData.length === 0) {
                DevExpress.ui.notify("Please select a row in the grid!", "error", 2000);
                return;
            }

            // Extract DocumentType from the selected row
            var documentType = selectedRowData[0].DocumentType;

            // Make the AJAX POST request
            $.ajax({
                type: "POST",
                url: `/api/LedgerAccountMaster/AddAssetDocumentsEntry?DocumentType=${encodeURIComponent(documentType)}`,
                contentType: "application/json",
                data: JSON.stringify(VM),
                dataType: "json",
                success: function (response) {
                    // Update the grid data source with the new response
                    $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

                    // Notify the user of successful operation
                    DevExpress.ui.notify("Document details added successfully!", "success", 2000);
                    accountMasterDropDownBoxValidator.reset();
                    accountMasterDropDownBoxNotificationValidator.reset();
                    accountMasterDropDownBoxExpiryValidator.reset();
                    // Reset form fields
                    resetFormFields();

                    // Refresh the DocumentNo field
                    fetchNewDocumentNo();
                },
                error: function (xhr, status, error) {
                    console.error("Error occurred while updating data:", error);
                    DevExpress.ui.notify("Error occurred while updating data: " + error, "error", 2000);
                }
            });
        } else {
            DevExpress.ui.notify("Cannot save while the entry have errors,Please clear the errors to continue.", "error", 2000);
        }
    }


    // Function to reset form fields
    function resetFormFields() {

        // Reset validation states
        // $("#accountMasterDropDownBox").dxDropDownBox("instance").option("value", "-");
        $("#Remarks").dxTextBox("instance").option("value", "");
        $("#accountMasterDropDownBoxExpiry").dxDateBox("instance").option("value", null);
        $("#accountMasterDropDownBoxNotification").dxDateBox("instance").option("value", null);
    }

    // Function to fetch the new DocumentNo
    function fetchNewDocumentNo() {
        $.ajax({
            url: "/api/LedgerAccountMaster/GetAssetDocumentNo",
            type: "GET",
            success: function (data) {
                // Set the value in the DocumentNo TextBox
                $("#DocumentNo").dxTextBox("instance").option("value", data);
            },
            error: function (xhr, status, error) {
                console.error("Error loading DocumentNo:", error);
                DevExpress.ui.notify("Error loading DocumentNo!", "error", 2000);
            }
        });
    }


    $("#btnBack").on("click", function (e) {
        e.preventDefault();
        alert("Are you sure want to exit?");
        window.location.href = "http://localhost:5000/";
        // debugger;
    });


    function addCostAllocation() {
        $("#costAllocationPopup").dxPopup("instance").show();
    }
    function saveCostAllocation() {
        $("#costAllocationPopup").dxPopup("instance").close();
    }
    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    //debugger;

    function dataGridSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#accountMasterDropDownBox").dxDropDownBox("instance");
        DocType = selectedKey;

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }

    }

