<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<style type="text/css">
    /* General body background and text color */
    body {
        color: navy; /* Navy for text to ensure readability */
    }


    /* Cards container and cards styling */
    .cards-container {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: space-between;
    }

    .card {
        border: 1px solid #ddd; /* Navy border for cards */
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        width: 49%;
        box-sizing: border-box;
    }

    /* Form group styling */
    .form-group label {
        color: navy; /* Navy for labels */
    }

    .form-group-row {
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-bottom: 1rem;
    }

    /* Title styling */
    .cards-container-title {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 30px;
        color: navy; /* Navy for the title */
    }

    /* Button styling */
    .dx-button {
        background-color: navy; /* Navy for buttons */
        color: black; /* White text for buttons */
        border: 1px solid navy;
        border-radius: 4px;
        padding: 8px 16px;
    }

        .dx-button:hover {
            background-color: #003366;
            color: white;
        }

    /* Checkbox styling */
    .dx-checkbox-icon {
        border-color: #ddd; /* #ddd for checkbox borders */
    }

    .dx-checkbox-checked .dx-checkbox-icon {
        background-color: navy; /* #ddd for checked checkboxes */
    }

    /* Dropdown box styling */
    .dx-dropdownbox {
        border-color: #ddd; /* #ddd for dropdown borders */
    }

        .dx-dropdownbox .dx-texteditor-input {
            color: #ddd; /* #ddd for dropdown text */
        }

    /* Textbox styling */
    .dx-textbox {
        border-color: #ddd; /* Navy for textbox borders */
    }

    .vertical-container {
        display: flex;
        flex-direction: column;
        gap: 1rem; /* Adds space between fields */
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between fields */
        justify-content: start;
        align-items: center;
        margin: 15px 0;
    }

    .form-group {
        margin-bottom: 10px;
    }

    .form-group-row {
        display: flex;
        align-items: center;
        gap: 2rem; /* Adjust gap between fields */
        margin-bottom: 1rem; /* Add spacing between rows */
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }



    .cards-container-title {
        text-align: center; /* Centers the title */
        font-size: 1.5rem; /* Adjust font size */
        color: black; /* Optional: sets the color */
        /*  background-color: blue; */
        position: relative;
    }

    .content-container {
        width: 100%; /* Full width for responsiveness */
        max-width: 100%; /* Matches the max-width of cards-container */
        /* background-color: #f5f5f5; /* Optional background color */ */ box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); /* Optional shadow for aesthetics */
        border-radius: 8px; /* Rounded corners */
    }

    .form-group-row1 {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 6em; /* Space between sections */
    }

    .form-group1 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 100px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width:100%;
    }
    .checkbox-label {
        font-size: 16px; /* Adjust text size */
        white-space: nowrap; /* Prevents text wrapping */
    }

    .playIcon {
        display: none;
    }

    .rtl-text {
        direction: rtl !important;
        text-align: right !important;
    }

    .title {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 20px !important;
        font-weight: bold !important;
        background: linear-gradient(135deg, #6a11cb, #2575fc) !important;
        color: white !important;
        width: 100% !important;
        padding: 0px !important;
        border-radius: 0px !important;
        margin: 0px !important;
        height: 50px !important;
    }

    .titleCard-toggle {
        display: none !important;
    }

</style>


