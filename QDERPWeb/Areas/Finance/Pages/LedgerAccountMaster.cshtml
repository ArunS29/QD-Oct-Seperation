    $("#AMbtnSave").on("click", function (e) {
        e.preventDefault();

        // **Validate Inputs**
        var accountMasterDropDownBoxValidator = $("#accountMasterDropDownBox").dxValidator("instance");
        var AccountGroupValidator = $("#AccountGroup").dxValidator("instance");

        var aAccountMasterDropDownBoxValidator = accountMasterDropDownBoxValidator.validate();
        var aAccountGroupValidator = AccountGroupValidator.validate();

        if (aAccountMasterDropDownBoxValidator.isValid && aAccountGroupValidator.isValid) {

            
            let CreatedBy = $("#CreatedBy").dxTextBox("instance").option("value");
            let CreatedOn = $("#CreatedOn").dxTextBox("instance").option("value");

            if (!CreatedOn || !Date.parse(CreatedOn)) {
                CreatedOn = new Date().toISOString(); // Assign current timestamp if not set
            }

            // **Retrieve AccountGroupId from TextBox and URL Parameter**
            let accountGroupIdTextbox = $("#AccountGroupID").dxTextBox("instance").option("value");
            const urlParams = new URLSearchParams(window.location.search);
            let accountGroupIdParam = urlParams.get("AccountGroupId");

            // **Determine if it's an update**
            let isUpdate = accountGroupIdParam && accountGroupIdParam.trim() !== "" && accountGroupIdParam !== "null";

            // **Set API Method & URL**
            let apiUrl = isUpdate
                ? `/api/LedgerAccountMaster/UpdateLedgerMasterDetails?AccountGroupId=${encodeURIComponent(accountGroupIdParam)}`
                : "/api/LedgerAccountMaster/SaveLedgerMasterDetails";

            let requestType = isUpdate ? "PUT" : "POST"; // PUT for update, POST for insert

            // **Prepare Data Object**
            var VM = {
                "AccountGroupId": isUpdate ? accountGroupIdParam : accountGroupIdTextbox,  // Use param for update, textbox for save
                "AccountGroup": $("#AccountGroup").dxTextBox("instance").option("value"),
                "AccountMaster": $("#accountMasterDropDownBox").dxDropDownBox("instance").option("value"),
                "AccountGroupIDAr": $("#AccountGroupID1").dxTextBox("instance").option("value"),
                "AccountGroupAr": $("#AccountGroup1").dxTextBox("instance").option("value"),
                "AccountMasterAr": $("#accountDropDownBoxArabic").dxDropDownBox("instance").option("value"),
               "AccountGroupUnder": mARresponse,
              // "AccountGroupUnder": mARresponseMasterGroupId,


            };

            // **Assign CreatedBy / CreatedOn for new records, ModifiedBy / ModifiedOn for updates**



            if (!isUpdate) {
                // **For Save: Assign CreatedBy & CreatedOn**
                VM["RecordCreatedBy"] = CreatedBy;
                VM["RecordCreatedOn"] = CreatedOn;
            } else {
                VM["RecordCreatedBy"] = CreatedBys;
                console.log("savefun:", CreatedBys);
                VM["RecordCreatedOn"] = CreatedOns;
                console.log("savefun:", CreatedOns);
                // **For Update: Assign ModifiedBy & ModifiedOn**
                let modifiedOn = new Date().toISOString();
                $("#ModifiedOn").dxTextBox("instance").option("value", modifiedOn);

                VM["RecordModifiedBy"] = getUN;
                VM["RecordModifiedOn"] = modifiedOn;
            }

            console.log("API URL:", apiUrl);
            console.log("Request Type:", requestType);
            console.log("Data Sent:", VM);

            $.ajax({
                type: requestType,
                url: apiUrl,
                contentType: "application/json",
                data: JSON.stringify(VM),
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        DevExpress.ui.notify(
                            isUpdate ? "Data updated successfully!" : "Data saved successfully!",
                            "success",
                            2000
                        );

                        // Log success for debugging
                        console.log("Success Response:", response);

                        // Populate audit fields based on operation type
                        if (isUpdate) {
                            const modifiedBy = VM.RecordModifiedBy;
                            const modifiedOn = new Date(VM.RecordModifiedOn);

                            // Format to dd-MMM-yyyy
                            const formattedDate = modifiedOn.toLocaleDateString('en-GB', {
                                day: '2-digit',
                                month: 'short',
                                year: 'numeric'
                            }).replace(/ /g, '-');
                            $("#ModifiedBy").dxTextBox("instance").option("value", modifiedBy || "");
                            $("#ModifiedOn").dxTextBox("instance").option("value", formattedDate || new Date().toISOString());
                        } else {
                            const createdBy = data.AG.RecordCreatedBy;
                            const createdOn = new Date(data.AG.RecordCreatedOn);

                            // Format to dd-MMM-yyyy
                            const formattedDate = createdOn.toLocaleDateString('en-GB', {
                                day: '2-digit',
                                month: 'short',
                                year: 'numeric'
                            }).replace(/ /g, '-');
                            $("#CreatedBy").dxTextBox("instance").option("value", createdBy || "");
                            $("#CreatedOn").dxTextBox("instance").option("value", formattedDate || new Date().toISOString());
                        }
                    } else {
                        alert("Operation failed: " + response.message);
                        console.error("API Error Response:", response);
                    }
                },
                error: function (xhr, status, error) {
                    alert("Error occurred: " + error);
                    console.error("AJAX Error:", xhr.responseText);
                }
            });


        } else {
            // **Validation Failed - Show Error Dialog**
            DevExpress.ui.dialog.custom({
                title: "Validation Errors",
                messageHtml: `
                    <div style="display: flex; align-items: center;">
                        <i class="dx-icon-warning" style="font-size: 24px; margin-right: 10px; color: #e74c3c;"></i>
                        <span>Cannot save while the entry has errors. Please clear the errors to continue.</span>
                    </div>
                `,
                buttons: [{ text: "OK", onClick: () => true }]
            }).show();
        }
    });




