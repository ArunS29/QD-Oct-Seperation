    function allowOnlyText(e) {
        const input = e.event.target.value;
        const regex = /^[A-Za-z\s]*$/; // Allows only letters and spaces
        if (!regex.test(input)) {
            e.event.target.value = input.replace(/[^A-Za-z\s]/g, ''); // Remove invalid characters
        }
    }




