                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("MasterGroup")
                    )
                    .LabelMode(EditorLabelMode.Floating)
                    .ID("accountDropDownBoxArabic")
                    .ShowClearButton(true)
                    .AcceptCustomValue(true)
                    .OpenOnFieldClick(false)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .ValueExpr("MasterGroup")
                    .DisplayExpr("MasterGroupAr")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(250)
                    .TabIndex(1)
                    .RtlEnabled(true)
                    .DropDownOptions(o => o
                    .Width(500)

                    )
                    .OnKeyDown("onKeyDown")
                    //.OnValueChanged("dropDownBoxValueChanged")
                    .ContentTemplate(new TemplateName("AccountMasterContentTemplate1"))
                    )

            </div>
