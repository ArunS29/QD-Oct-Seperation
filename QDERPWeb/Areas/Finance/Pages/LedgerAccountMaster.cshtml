<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<style type="text/css">
    /* General body background and text color */
    body {
        background-color: aliceblue; /* Light and soft background */
        color: navy; /* Navy for text to ensure readability */
    }

    /* DataGrid styling */
    .dx-datagrid {
        background-color: white; /* Keep the grid background white for contrast */
        border: 1px solid navy; /* Navy border for the grid */
    }

        .dx-datagrid .dx-row {
            border-bottom: 1px solid #ccc; /* Keep the row borders subtle */
        }

        .dx-datagrid .dx-header-row {
            background-color: navy; /* Navy for header background */
            color: white; /* White text for headers */
        }

    /* Cards container and cards styling */
    .cards-container {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: space-between;
    }

    .card {
        border: 1px solid navy; /* Navy border for cards */
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        background-color: aliceblue; /* Alice Blue background for cards */
        width: 49%;
        box-sizing: border-box;
    }

    /* Form group styling */
    .form-group label {
        color: navy; /* Navy for labels */
    }

    .form-group-row {
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-bottom: 1rem;
    }

    /* Title styling */
    .cards-container-title {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 30px;
        color: navy; /* Navy for the title */
    }

    /* Content container styling */
    .content-container {
        width: 100%;
    }

    /* Button styling */
    .dx-button {
        background-color: navy; /* Navy for buttons */
        color: black; /* White text for buttons */
        border: 1px solid navy;
        border-radius: 4px;
        padding: 8px 16px;
    }

        .dx-button:hover {
            background-color: #003366;
            color: white;
        }

    /* Checkbox styling */
    .dx-checkbox-icon {
        border-color: navy; /* Navy for checkbox borders */
    }

    .dx-checkbox-checked .dx-checkbox-icon {
        background-color: navy; /* Navy for checked checkboxes */
    }

    /* Dropdown box styling */
    .dx-dropdownbox {
        border-color: navy; /* Navy for dropdown borders */
    }

        .dx-dropdownbox .dx-texteditor-input {
            color: navy; /* Navy for dropdown text */
        }

    /* Textbox styling */
    .dx-textbox {
        border-color: navy; /* Navy for textbox borders */
    }

        .dx-textbox .dx-texteditor-input {
            color: navy; /* Navy for textbox text */
        }


    .vertical-container {
        display: flex;
        flex-direction: column;
        gap: 1rem; /* Adds space between fields */
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between fields */
        justify-content: start;
        align-items: center;
        margin: 15px 0;
    }

    .form-group {
        margin-bottom: 10px;
    }

    .form-group-row {
        display: flex;
        align-items: center;
        gap: 2rem; /* Adjust gap between fields */
        margin-bottom: 1rem; /* Add spacing between rows */
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }



    .cards-container-title {
        text-align: center; /* Centers the title */
        font-size: 1.5rem; /* Adjust font size */
        color: black; /* Optional: sets the color */
        /*  background-color: blue; */
        position: relative;
    }

    .content-container {
        width: 100%; /* Full width for responsiveness */
        max-width: 100%; /* Matches the max-width of cards-container */
        margin: 20px auto; /* Center align the container */
        padding: 20px; /* Adds some inner spacing */
        /* background-color: #f5f5f5; /* Optional background color */ */ box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); /* Optional shadow for aesthetics */
        border-radius: 8px; /* Rounded corners */
    }

    .form-group-row1 {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 6em; /* Space between sections */
    }

    .form-group1 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 100px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
        background-color: aliceblue;
    }

    .mainContainer {
        margin-top: 1em;
    }

</style>


    <div id="AccountingLedgerGroups" class="no-border-title"></div>

<div class="cards-container">
    @*    <h2>@ViewData["Title"]</h2> *@
    <!-- Card 1: General Account Group Information -->
    <div class="card">
        <div class="dx-fieldset vertical-container">
            <div class="form-group">
                @(
                    Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Account Group ID')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("AccountGroupID")
                    .Value(null)
                    .Width(250)
                    .Disabled(true)
                    @* .ElementAttr(new { style = "background-color: #FFCC99; color: #FFCC99;" }) *@
                    )
            </div>
            <div class="form-group">
                @(
                    Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Account Group')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("AccountGroup")
                    .Value(null)
                    .Width(250)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()

                        .Message("Account Group is required");
                    })
                    .OnInput("allowOnlyText")
                    )

            </div>

            <div class="form-group">
                @(Html.DevExtreme().DropDownBox()
                    .Label(new JS("formatMessage('Account Master')"))
                    .DataSource(d => d.WebApi()
                    .Controller("LedgerAccountMaster")
                    .LoadAction("GetAccountMaster")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("MasterGroup")
                    )
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Account Master is required");
                    })
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("accountMasterDropDownBox")
                    .ShowClearButton(true)
                    .AcceptCustomValue(false)
                    .OpenOnFieldClick(true)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .ValueExpr("MasterGroup")
                    .DisplayExpr("MasterGroup")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(250)
                    .TabIndex(1)
                    .DropDownOptions(o => o
                    .Width(500)
                    )
                    .OnKeyDown("onKeyDown")
                    //.OnValueChanged("dropDownBoxValueChanged")
                    .ContentTemplate(new TemplateName("AccountMasterContentTemplate"))
                    )

            </div>
        </div>
    </div>


    <!-- Card 2: Sales and Purchases -->
