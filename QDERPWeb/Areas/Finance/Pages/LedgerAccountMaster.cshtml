                        .Value(null)
                        .Width(250)
                        .RtlEnabled(true)
                        )
                </div>
            </div>


            <div class="form-group">
                @(Html.DevExtreme().DropDownBox()
                    .Label(new JS("formatMessage('Account Group')"))
                    .DataSource(d => d.WebApi()
                    .Controller("LedgerAccountMaster")
