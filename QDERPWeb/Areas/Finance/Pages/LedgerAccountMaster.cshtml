                    .ValueExpr("MasterGroupAr")
                    .DisplayExpr("MasterGroupAr")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(250)
                    .TabIndex(1)
                    .RtlEnabled(true)
                    .DropDownOptions(o => o
                    .Width(500)

                    )
                    .OnKeyDown("onKeyDown")
                    //.OnValueChanged("dropDownBoxValueChanged")
                    .ContentTemplate(new TemplateName("AccountMasterContentTemplate1"))
                    )

            </div>
