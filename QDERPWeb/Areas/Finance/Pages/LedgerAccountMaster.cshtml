<div class="cards-container">
    @*    <h2>@ViewData["Title"]</h2> *@
    <!-- Card 1: General Account Group Information -->
    <div class="card">
        <div class="vertical-container">
            <div class="form-group">
                @(
                    Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Account Group ID')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ID("AccountGroupID")
                    .Value(null)
                    .Width(250)
                    .Disabled(true)
                    @* .ElementAttr(new { style = "background-color: #FFCC99; color: #FFCC99;" }) *@
                    )
            </div>
            <div class="form-group">
                @(
                    Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Account Group')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ID("AccountGroup")
                    .Value(null)
                    .Width(250)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()

                        .Message("Account Group is required");
                    })
                    .OnInput("allowOnlyText")
                    )

            </div>

            <div class="form-group">
                @(Html.DevExtreme().DropDownBox()
                    .Label(new JS("formatMessage('Account Master')"))
                    .DataSource(d => d.WebApi()
                    .Controller("LedgerAccountMaster")
                    .LoadAction("GetAccountMaster")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("MasterGroup")
                    )
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Account Master is required");
                    })
                    .LabelMode(EditorLabelMode.Floating)
                    .ID("accountMasterDropDownBox")
                    .ShowClearButton(true)
                    .AcceptCustomValue(false)
                    .OpenOnFieldClick(true)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .ValueExpr("MasterGroup")
                    .DisplayExpr("MasterGroup")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(250)
                    .TabIndex(1)
                    .DropDownOptions(o => o
                    .Width(500)
                    )
                    .OnKeyDown("onKeyDown")
                    //.OnValueChanged("dropDownBoxValueChanged")
                    .ContentTemplate(new TemplateName("AccountMasterContentTemplate"))
                    )

            </div>
        </div>
    </div>


    <!-- Card 2: Sales and Purchases -->
    @* <div class="cards-container right-aligned-card"> *@
    <div class="card" style="text-align: right;">
        <div class="vertical-container" style="align-items: flex-end;">
            <div class="form-group">
                @(
                    Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Number')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ID("AccountGroupID1")
                    .Value(null)
                    .Width(250)
                    .RtlEnabled(true)
                    .Disabled(true)
                    @* .ElementAttr(new { style = "background-color: #FFCC99; color: #FFCC99;" }) *@

                    // .InputAttr(new { lang = "ar", dir = "rtl" })
                    )
            </div>
            <div class="form-group" style="display: flex;">
                <div class="input-group" style="display: flex; align-items: end; width: 100%;justify-content: end;">
                    <span class="input-group-prepend" style="margin-right: 10px;">
                        @(
                            Html.DevExtreme().Button()
                            .ID("convertToArabic1")
