                    )
            </div>
            <div class="form-group" style="display: flex;">
                <div class="input-group" style="display: flex; align-items: center; width: 100%;justify-content: end;">
                    <span class="input-group-prepend" style="margin-right: 10px;">
                        @(
                            Html.DevExtreme().Button()
                            .ID("convertToArabic1")
