<script>
        $(function () {
            $("#AccountingLedgerGroups").dxTextBox({
            text: formatMessage("Accounting Ledger Groups"),
            readOnly: true,
            onContentReady: function (e) {
            $(e.element).addClass("dx-textbox-heading");
            }
            });
        });
    $(function () {
                                $("#ModifiedOn").dxTextBox({
                                            text:formatMessage("Modified On:"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#ModifiedBy").dxTextBox({
                                            text:formatMessage("Modified By:"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#CreatedOn").dxTextBox({
                                            text:formatMessage("Created On:"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#CreatedBy").dxTextBox({
                                            text:formatMessage("Created By:"),
                                            readOnly: true

                            });
                    });
                    $(function () {
                                $("#BankReconciliation").dxTextBox({
                                            text:formatMessage("Bank Reconciliation"),
                                            readOnly: true

                            });
                    });
                $(function () {
                                $("#SalaryPayableGroup").dxTextBox({
                                            text:formatMessage("Salary Payable Group"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#PurchaseGroup").dxTextBox({
                                            text:formatMessage("Purchase Group"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#SalesGroup").dxTextBox({
                                            text:formatMessage("Sales Group"),
                                            readOnly: true

                            });
                    });

    var mARkey = null;
    let mARresponse = null, IsArabic = true;

    let getUN = null;
    let CreatedBys = null;
    let CreatedOns = null;

    $(document).ready(function () {
        // Retrieve query parameters
        const urlParams = new URLSearchParams(window.location.search);
        const accountGroup = urlParams.get("AccountGroup");
        const accountGroupID = urlParams.get("AccountGroupId");
        const accountGroupUnder = urlParams.get("AccountGroupUnder");
      //  alert(accountGroupID);
        console.log("URL Parameters:", { accountGroup, accountGroupID, accountGroupUnder });

        if (accountGroupID!=null) {
            // Case 1: AccountGroupId exists ? Fetch existing data
            
            $.ajax({
                type: "GET",
                url: `/api/LedgerAccountMaster/GetAccountGroupsData?AccountGroupId=${encodeURIComponent(accountGroupID)}`,
                dataType: "json",
                success: function (response) {
                    if (response) {
                        function formatDate(date) {
                            if (date) {
                                const dateObj = new Date(date);
                                const day = String(dateObj.getDate()).padStart(2, '0');
                                const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                                    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                                const month = monthNames[dateObj.getMonth()];
                                const year = dateObj.getFullYear();
                                return `${day}-${month}-${year}`;
                            }
                            return '';
                        }
                        console.log("Account Group Data:", response);
                        $("#AMbtnSave").dxButton("instance").option("text", "Update");
                        // Assign values to DevExtreme textboxes
                        $("#AccountGroupID").dxTextBox("instance").option("value", response.AccountGroupId);
                        $("#AccountGroup").dxTextBox("instance").option("value", response.AccountGroup);
                         $("#accountDropDownBoxArabic").dxDropDownBox("instance").option("value", response.AccountGroupAr);
                        $("#AccountGroupID1").dxTextBox("instance").option("value", response.AccountGroupId);
                        $("#AccountGroup1").dxTextBox("instance").option("value", response.AccountGroupAr); 
                        $("#CreatedBy").dxTextBox("instance").option("value", response.RecordCreatedBy);
                        CreatedBys = response.RecordCreatedBy;
                            console.log("getres:", CreatedBys);
                        $("#CreatedOn").dxTextBox("instance").option("value", formatDate(response.RecordCreatedOn));
                        CreatedOns = response.RecordCreatedOn;  
                        console.log("getres:", CreatedOns);
                        $("#ModifiedBy").dxTextBox("instance").option("value", getUN);
                      
                    
                        $("#ModifiedOn").dxTextBox("instance").option("value", formatDate(new Date()));
                        // Change button text to "Update"
                  

                    } else {
                        console.warn("No data received for the provided AccountGroupId.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching Account Group data:", error);
                }
            });
        } 
         if (accountGroupID == "null") {
           
            // Case 2: AccountGroupId is NULL ? Generate new AccountGroupId
            $.ajax({
                type: "GET",
                url: `/api/LedgerAccountMaster/GetAccountGroupId`,
                dataType: "json",
                success: function (data) {
                    console.log("Generated New AccountGroupId:", data);

                    // Assign the new AccountGroupId to the textboxes
                    $("#AccountGroupID").dxTextBox("instance").option("value", data);
                    $("#AccountGroupID1").dxTextBox("instance").option("value", data);
                },
                error: function (xhr, status, error) {
                    console.error("Error generating AccountGroupId:", error);
                }
            });
        }


        // If AccountGroup exists, wait for DevExtreme to initialize and then set the value
        if (accountGroup) {
            let retryCount = 0;
            const maxRetries = 20;
            const interval = setInterval(() => {
                const accountGroupInstance = $("#AccountGroup").dxTextBox("instance");
                if (accountGroupInstance) {
                    accountGroupInstance.option("value", accountGroup);
                    clearInterval(interval);
                }
                retryCount++;
                if (retryCount >= maxRetries) {
                    console.error("Failed to initialize DevExtreme TextBox within retry limit.");
                    clearInterval(interval);
                }   
            }, 100);
        }

        // Fetch User Name
        $.ajax({
            url: "/api/AccountLedgerMaster/getUserName",
            type: "GET",
            dataType: "json",
            success: function (response) {
                console.log("User Name:", response.UserName);
                getUN = response.UserName;
            }
        });

        // Fetch Account Ledger Under if parameter exists
        if (accountGroupUnder) {
            $.ajax({
                type: "GET",
                url: `/api/LedgerAccountMaster/GetAccountLedgerUnder?AccountGroupUnder=${encodeURIComponent(accountGroupUnder)}`,
                dataType: "json",
                success: function (response) {
                    if (response) {
                        console.log("Account Group Under Data:", response);
                        IsArabic = false;
                        dataGridAccountMasterSelectionChanged({ selectedRowKeys: [response.masterGroup] });
                    } else {
                        console.warn("No data received for AccountGroupUnder.");
                    }
                },
