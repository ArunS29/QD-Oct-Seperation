                                            text:formatMessage("Modified By:"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#CreatedOn").dxTextBox({
                                            text:formatMessage("Created On:"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#CreatedBy").dxTextBox({
                                            text:formatMessage("Created By:"),
                                            readOnly: true

                            });
                    });
                    $(function () {
                                $("#BankReconciliation").dxTextBox({
                                            text:formatMessage("Bank Reconciliation"),
                                            readOnly: true

                            });
                    });
                $(function () {
                                $("#SalaryPayableGroup").dxTextBox({
                                            text:formatMessage("Salary Payable Group"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#PurchaseGroup").dxTextBox({
                                            text:formatMessage("Purchase Group"),
                                            readOnly: true

                            });
                    });
    $(function () {
                                $("#SalesGroup").dxTextBox({
                                            text:formatMessage("Sales Group"),
                                            readOnly: true

                            });
                    });

    var mARkey = null;
    let mARresponse = null, IsArabic = true;



    $(document).ready(function () {
        // Retrieve query parameters
        const urlParams = new URLSearchParams(window.location.search);
        const accountGroup = urlParams.get('AccountGroup');
        const accountGroupUnder = urlParams.get('AccountGroupUnder');

        if (accountGroup) {
            // Wait for DevExtreme TextBox to initialize
            let retryCount = 0; // Retry counter
            const maxRetries = 20; // Maximum retries to avoid infinite loop
            const interval = setInterval(() => {
                const $accountGroupElement = $("#AccountGroup");

                if ($accountGroupElement.length) {
                    const accountGroupInstance = $accountGroupElement.dxTextBox("instance");

                    if (accountGroupInstance) {
                        // Set the value and clear the interval
                        accountGroupInstance.option("value", accountGroup);
                        clearInterval(interval);
                    }
                }

                retryCount++;
                if (retryCount >= maxRetries) {
                    console.error("Failed to initialize DevExtreme TextBox within retry limit.");
                    clearInterval(interval);
                }
            }, 100); // Retry every 100ms
        }

        // AJAX call to fetch the next Account ID
        if (accountGroupUnder) {

            $.ajax({
                type: 'GET',
                url: `/api/LedgerAccountMaster/GetAccountLedgerUnder?AccountGroupUnder=${encodeURIComponent(accountGroupUnder)}`,
                dataType: 'json', // Expecting JSON response
                success: function (response) {
                    if (response) {
                        console.log(response)
