            `, // Content with an icon and message
                buttons: [
                    {
                        text: "OK",
                        onClick: () => {
                            return true; // Close the dialog
                        },
                    },
                ],
            }).show();

            // DevExpress.ui.notify("Ca", "error", 2000);
        }
    });

