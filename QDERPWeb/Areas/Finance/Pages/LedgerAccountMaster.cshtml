            Html.DevExtreme().TextBox()
            .ID("AccountMaster1")
            .Value(null)
            .Width(520)
            .RtlEnabled(true)
            //.InputAttr(new { lang = "ar", dir = "rtl" })
            )
            </div> *@
        </div>
    </div>

