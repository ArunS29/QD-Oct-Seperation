<script>
		  function viewInvoice(tenantName) {
				let url = `/${tenantName}/Finance/frm20161VATInvoiceEdit`;
			window.location.href = url; // Navigate to the form
		}

	
$(document).ready(function () {
		console.log('Start permission handling AccountingLedgers');
		var formId = "frm201LedgerView";
		$.ajax({
			url: '/api/Permissions/GetAccessDetails?formId=' + formId,
			type: 'GET',
			contentType: 'application/json',
			success: function (response) {
				console.log("API Response:", response);

				if (response.success && response.permissions) {
					var controlStates = {
						"ddBtnShowRecords": { "Visible": false, "Enabled": false },

					};
					var fullAccess = response.permissions.find(p =>
						p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
					);

					if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
						Object.keys(controlStates).forEach(key => {
							controlStates[key] = { "Visible": true, "Enabled": true };
						});
					} else {
						Object.keys(controlStates).forEach(key => {
							var controlPermission = response.permissions.find(p =>
								p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
							);
							if (controlPermission) {
								controlStates[key] = {
									"Visible": controlPermission.ItemVisible || false,
									"Enabled": controlPermission.ItemEnabled || false
								};
							}
						});
					}
                    console.log("Control States:", controlStates);
                    Object.keys(controlStates).forEach(key => {
						var button = document.getElementById(key);
						if (button) {
						
							button.style.display = controlStates[key].Visible ? "inline-block" : "none";
							
							button.disabled = !controlStates[key].Enabled;
							console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
						} else {
							console.warn(`Button with ID "${key}" not found in the DOM.`);
						}
					});
				} else {
					console.warn("Failed to fetch permissions or no permissions available.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching permissions:", error);
				alert('An error occurred while fetching permissions. Please try again.');
			}
		});
         console.log('End permission handling');
	});
    let selectedVoucherNo = null;
	$(function () {
		$("#VATInvoiceRegister").dxTextBox({
			text: formatMessage("VAT Invoice Register"),
			readOnly: true,
			onContentReady: function (e) {
				$(e.element).addClass("dx-textbox-heading");
			}
		});
	});
    $(function () {
	    var inputPopupInstance = $("#inputPopupContainer").dxPopup({
			width: 600,
			height: 400,
			showTitle: true,
			title: "Details",
			visible: false,
			dragEnabled: true,
			closeOnOutsideClick: true,
			contentTemplate: function () {
				return $("<div>").attr("id", "popupFormContent");
			}
		}).dxPopup("instance");
        var contextMenu = $("#contextMenu");
        $(document).on("click", function () {
			contextMenu.hide();
		});
        $("#dataGrid").customizeGridContextMenu();
        $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
			e.preventDefault();
			var rowIndex = $(this).index();
			var rowData = $("#dataGrid").dxDataGrid("instance").getDataSource().items()[rowIndex];
			console.log(rowData);
			contextMenu.css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
		});
	});

	function ddBtnShowRecords_click(duration) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var frmDate = new Date(frmDateBox.option("value"));
		var toDate = new Date(toDateBox.option("value"));
		var currentDate = new Date();

		switch (duration) {
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
		}

		frmDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		toDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		FromDate = frmDate;
		ToDate = toDate;

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		$.ajax({
			url: '/api/VATModule/GetVatInvoices',
			type: 'GET',
			data: {
				frmDate: frmDate,
				toDate: toDate
			},
			success: function (data) {
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
				var dataGrid = $("#dataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.option("dataSource");
				if (dataSource && dataSource.length > 0) {
					var lastRow = dataSource[dataSource.length - 1];
					VoucherAmountFormatted = lastRow.VoucherAmountFormatted;
					var firstRow = dataSource[0];
					firstrowVoucherAmountFormatted = firstRow.VoucherAmountFormatted;
				}
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}
    function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
