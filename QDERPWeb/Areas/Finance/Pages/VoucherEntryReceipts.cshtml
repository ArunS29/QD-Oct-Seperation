<script>




    // let selectedAccountKey = null;
    let isUpdatingCell = false; // Add a flag to prevent recursive triggering

    function addVoucherEntry() {

        var accountHead = $("#AccountHeadDropDown").dxDropDownBox("instance");
        var sbDrCr = $("#TransactionTypeComboBox").dxSelectBox("instance").option("value");
        var receivingAccount = $("#accountDropDownBox").dxDropDownBox("instance");
        var amount = $("#Amount").dxNumberBox("instance");

        var accountHeadValidator = $("#AccountHeadDropDown").dxValidator("instance");
        var voucherAmtValidator = $("#Amount").dxValidator("instance");
        var receivingaccountvalidator = $("#accountDropDownBox").dxValidator("instance");

        var accountHeadValidation = accountHeadValidator.validate();
        var voucherAmtValidation = voucherAmtValidator.validate();
        var receivingaccountvalidation = receivingaccountvalidator.validate();

        if (accountHeadValidation.isValid && voucherAmtValidation.isValid && receivingaccountvalidation.isValid) {

            var VE = [{
                "VoucherNo": $("#VoucherNo").dxTextBox("instance").option("value"),
                // "VoucherDate": $("#VoucherDate").dxDateBox("instance").option("value"),
                // "EffectiveDate": $("#EffectiveDate").dxDateBox("instance").option("value"),
                "AccountHead": $("#AccountHeadDropDown").dxDropDownBox("instance").option("value"),
                "VoucherAmount": $("#Amount").dxNumberBox("instance").option("value"),
                "DrCr": $("#TransactionTypeComboBox").dxSelectBox("instance").option("value"),

                "AddedBy": "102",
                "AddedOn": new Date(),
                "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),
                "SysRemarks": "Received By:" + $("#AccountHeadDropDown").dxDropDownBox("instance").option("value")
            },
            {
                "VoucherNo": $("#VoucherNo").dxTextBox("instance").option("value"),
                // "VoucherDate": $("#VoucherDate").dxDateBox("instance").option("value"),
                // "EffectiveDate": $("#EffectiveDate").dxDateBox("instance").option("value"),
