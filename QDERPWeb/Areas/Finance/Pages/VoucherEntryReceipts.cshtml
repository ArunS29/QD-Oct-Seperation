@page
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Data
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Routing
@model Form.Areas.Finance.Pages.VoucherEntryReceiptsModel
@{
    ViewData["Title"] = "Receipt Voucher Details";

}




<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }
    /* Target the header row to set the background color */
    
    /* Optional: Ensure header text doesn't conflict with the background */
    .aliceblue-header .dx-header-row .dx-datagrid-text-content {
        color: #333; /* Make sure text is readable */
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .button-alignment-down {
        margin-bottom: 10px
    }

    .content-container {
        border-radius: 10px;
        padding: 5px;
        background-color: white;
    }
    /* Style for edit button */
    .dx-command-edit .dx-icon-edit {
        color: green; /* Green color for edit */
    }

    /* Style for delete button */
    .dx-command-edit .dx-icon-trash {
        color: red; /* Red color for delete */
    }


    #CostAllocationModal .modal-dialog.fullscreen {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1050; /* Ensures it stays on top */
        width: 100%;
        height: 100%;
        margin: 0;
        max-width: none;
        overflow: hidden;
    }

    #CostAllocationModal .modal-content {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    #CostAllocationModal .modal-body {
        flex: 1; /* Takes up remaining space */
        overflow-y: auto; /* Enables vertical scrolling */
        overflow-x: hidden; /* Disables horizontal scrolling */
        padding: 15px; /* Optional: Adjust padding to make it visually better */
    }

    #CostAllocationModal .card {
        background-color: #ffffff !important;
        color: #fff;
        border: none;
        border-radius: 5px;
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        list-style: none;
        padding: 8px 0;
        z-index: 1000;
    }

        .context-menu li {
            padding: 8px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

            .context-menu li:hover {
                background-color: #f0f0f0;
            }

    td {
        padding: 5px;
    }

    .custom-popup-button {
        height: 250px !important;
        width: 100px !important;
    }
</style>

<div class="title">
    <div class="header-container">
        <div id="ReceiptsVoucherDetails" class="no-border-input"></div>
    </div>
</div>
<div class="content-container-top" style="background-color:#909ead00;">


    <div class="dx-fieldset horizontal-container" style="margin-top:10px">
        <div class="form-group">
           

            @(
                        Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Voucher No')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("VoucherNo")
                        .OnValueChanged("onVoucherNoChanged")
                        .Value(null)
                        .ReadOnly(true)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Voucher No is required");
                        })
                        )
        </div>

        <div class="form-group">
           

            @(Html.DevExtreme().DateBox()
                        .Label(new JS("formatMessage('Voucher Date')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("VoucherDate")
                        .OnValueChanged("onVoucherDateChanged")
                        .InputAttr("aria-label", "Date")
                        .Type(DateBoxType.Date)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Value(DateTime.Now)

                        )
        </div>
        <div class="form-group">
          

            @(Html.DevExtreme().DateBox()
                        .Label(new JS("formatMessage('Effective Date')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("VoucherEffectiveDate")
                        .InputAttr("aria-label", "Date")
                        .Type(DateBoxType.Date)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Value(DateTime.Now)
                        )
        </div>
        <div class="form-group">
            
            @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Receiving Account')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .DataSource(d => d.WebApi()
                        .Controller("VoucherEntryReceipts")
                        .LoadAction("GetReceivingAccount")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AccountId")
                        )
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Receiving Account is required");
                        })
                       
                        .ID("accountDropDownBox")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("change") // Detects changes in the dropdown
                        .HoverStateEnabled(true)
                        
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnValueChanged("onReceivingAccountChange") // Call the change handler
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .Width(720)
                        .TabIndex(1)
                        .DropDownOptions(o => o.Width(1000))
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                        )
        </div>



    </div>



    <div class="dx-fieldset horizontal-container " style="margin-top:15px;margin-bottom:0px;">

        <div class="form-group">
            <div class="button-alignment-down">
                
            </div>
            @(
                        Html.DevExtreme().SelectBox()
                        .Label(new JS("formatMessage('Dr/Cr')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("TransactionTypeComboBox")
                        .DataSource(new[] { "Dr", "Cr" })
                        .Value("Cr")
                        .Placeholder("Select Transaction Type")
                        .Width(90)
                        .ReadOnly(true)
                        )
        </div>


        <div class="form-group">
            
            @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Account Head')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .DataSource(d => d.WebApi()
                        .Controller("VoucherEntryReceipts")
                        .LoadAction("GetAccountHead")
                        .LoadParams(new { SelectedPaymentAccount = new JS("$('#accountDropDownBox').dxDropDownBox('instance').option('value')") }) // Pass the selected Receiving Account value
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AccountId")
                        )
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Account Head is required");
                        })
                        .ID("AccountHeadDropDown")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
             
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnInput("dropDownBoxOnInput")
                        .OnClosed("onDropDownBoxClosed")
                        .OnOpened("onOpened")
                        @* .OnOpened("onDropDownBoxOpened") *@
                        .Width(315)
                        .TabIndex(1)
                        .DropDownOptions(o => o.Width(1000))
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                        )
        </div>


        <div class="form-group" style="margin-top:25px">
            @(Html.DevExtreme().Button()
                        .ID("btnAddAHead")
                        .Icon("plus")
                            .OnClick("showLedgerAccountPopup") // Attach the onClick event handler
                        )

            <!-- DevExtreme Popup -->
            @(Html.DevExtreme().Popup()
                        .ID("ledgerAccountPopup")
                        .Width("93%")
                        .Height("85%")
                        .Title("Add Ledger Account")
                        .ShowTitle(true)
                        .CloseOnOutsideClick(true)
                        .Visible(false)
                        .ResizeEnabled(true)
                        .ContentTemplate(@<text>
                <div id="popupContent" class="background" style="width:100%; height:100%;">
                    <iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
                </div>
            </text>)
                        )
        </div>
        <div id="popupContainer"></div>
        <div class="form-group" style="margin-top:25px;">
            @(Html.DevExtreme().Button()
                        .ID("btnEditAHead")
                        .Icon("edit")
                            .OnClick("showLedgerAccountEditPopup")
                        )

            @(Html.DevExtreme().Popup()
                        .ID("ledgerEditAccountPopup")
                        .Width("93%")
                        .Height("85%")
                        .Title("Edit Ledger Account")
                        .ShowTitle(true)
                        .CloseOnOutsideClick(true)
                        .Visible(false)  // Hidden by default
                        .ResizeEnabled(true)
                        .ContentTemplate(@<text>
                <div id="popupContent" style="width:100%; height:100%;">
                    <iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
                </div>
            </text>)
                        )
        </div>
        <div class="form-group">
            @(
                        Html.DevExtreme().NumberBox()
                        .ID("Amount")
                        .Label(new JS("formatMessage('Amount')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .Value(null)
                        .Width(160)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Amount value doesnot allow to add Zero or negative");
                        })
                        .Min(0)
                        .Placeholder("0.00")
                        .Format("#,##0.00")
                        .InputAttr(new
                        {
                            style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                            type = "number",
                            step = "0.01"
                        })

                        )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().DropDownBox()
                .Label("Base Currency")
                .Label(new JS("formatMessage('Base Currency')"))
                .DataSource(d => d.WebApi()
                .Controller("Utility") // Use same controller or change if needed
                .LoadAction("GetCurrencyList")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CurrencyExchangeId")
                )
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message("Please select a base currency.");
                })
                .LabelMode(EditorLabelMode.Outside)
                .ID("ddlBaseCurrency")
                .ShowClearButton(true)
                .AcceptCustomValue(false)
                .OpenOnFieldClick(true)
                .Value(1) // Change default value if needed
                .ValueExpr("CurrencyID")
                .DisplayExpr("CurrencyName")
                .OnInput("dropDownBoxOnInput") // Reuse or define separate handler if needed
                .OnOpened("onOpened")
                .Width(210)
                .TabIndex(2) // Different tabindex to separate from the first
                .DropDownOptions(o => o.Width(700))
                .OnKeyDown("onKeyDown")
                //.OnValueChanged("dropDownBoxValueChanged") // Optional
                .ContentTemplate(new TemplateName("BaseCurrencyContentTemplate"))
                )
        </div>

        @using (Html.DevExtreme().NamedTemplate("BaseCurrencyContentTemplate"))
        {
            @(Html.DevExtreme().DataGrid()
                .ID("basecurrency-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("Utility")
                .LoadAction("GetCurrencyList")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CurrencyExchangeId")
                )
                .WordWrapEnabled(true)
                .ShowBorders(true)
                .Selection(sl => sl.Mode(SelectionMode.Single))
                .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
                .OnSelectionChanged("onBaseCurrencySelectionChanged") // Define this JS function
                .Paging(p => p.PageSize(10))
                .Height(300)
                .Columns(columns =>
                {
                    columns.Add().DataField("CurrencyExchangeId").Caption(new JS("formatMessage('ID')")).Visible(true);
                    columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')"));
                    columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Symbol')"));
                    columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')"));
                    columns.Add().DataField("CurrencyMasterCode").Caption(new JS("formatMessage('unicode')")).DataType(GridColumnDataType.Boolean);
                    columns.Add().DataField("CurrencyPoints").Caption(new JS("formatMessage('point')")).DataType(GridColumnDataType.Boolean);
                })
                )
        }
        <div class="form-group">
            @(Html.DevExtreme().DropDownBox()
                .Label(new JS("formatMessage('Convertion Currency')"))
                .DataSource(d => d.WebApi()
                .Controller("Utility") // Adjust if needed
                .LoadAction("GetCurrencyList")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CurrencyExchangeId")
                )
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message("Please select a currency.");
                })
                .LabelMode(EditorLabelMode.Outside)
                .ID("ddCurrency")
                .ShowClearButton(true)
                .AcceptCustomValue(false)
                .OpenOnFieldClick(true)
                .Value(1)
                .ValueExpr("CurrencyExchangeId")
                .DisplayExpr("CurrencyName")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .Width(210)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(700))
                .OnKeyDown("onKeyDown")
                //.OnValueChanged("dropDownBoxValueChanged")
                .ContentTemplate(new TemplateName("CurrencyContentTemplate"))
                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().TextBox()
                .Label(new JS("formatMessage('Convertion Rate')"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("txtCurrencyRate")
                .Value("0.00")
                //  .ReadOnly(true) // Make it read-only
                .Width(160)
                )
        </div>
        @using (Html.DevExtreme().NamedTemplate("CurrencyContentTemplate"))
        {
            @(Html.DevExtreme().DataGrid()
                .ID("currency-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("Utility")
                .LoadAction("GetCurrencyList")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CurrencyExchangeId")
                )
                .WordWrapEnabled(true)
                .ShowBorders(true)
                .Selection(sl => sl.Mode(SelectionMode.Single))
                .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
                .OnSelectionChanged("onCurrencySelectionChanged")
                .Paging(p => p.PageSize(10))
                .Height(300)
                .Columns(columns =>
                {
                    columns.Add().DataField("CurrencyExchangeId").Caption(new JS("formatMessage('ID')")).Visible(true);
                    columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')"));
                    columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Symbol')"));
                    columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')"));
                    columns.Add().DataField("CurrencyMasterCode").Caption(new JS("formatMessage('unicode')")).DataType(GridColumnDataType.Boolean);
                    columns.Add().DataField("CurrencyPoints").Caption(new JS("formatMessage('point')")).DataType(GridColumnDataType.Boolean);
                })
                )
        }

    </div>

    <div class="dx-fieldset horizontal-container " style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px;">
        <div class="form-group">
            <label id="narration" for="Amount" class="button-alignment-down" style="margin-right:25px;height:40px;">Narration:</label>
        </div>
        <div class="form-group">
            @(
                        Html.DevExtreme().TextArea()
                        .ID("Narration")
                        .Value("")
                        .Height(40)
                        .Width(720)
                        .Placeholder("Enter your comments here...")
                        .MaxLength(500)
                        )
        </div>
        <div class="form-group" style="">
            @(Html.DevExtreme().Button()
                        .ID("btnaddCostAllocation")
                        .Text(new JS("formatMessage('Add')"))
                        .Height(40)
                        .Width(178)
                        .Icon("plus")
                        .OnClick("function() { addVoucherEntry(); }")
                        )
        </div>

    </div>
    <div class="dx-field ledgerResult">
        <div class="dx-row dx-column-lines dx-header-row ">
            @(
                            Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                            .ID("dataGrid")
                            .RemoteOperations(false)
                            .Columns(columns =>
                            {
                                columns.AddFor(m => m.VoucherEntryNo)
                            .Caption("VoucherEntryNo")
                            .Visible(false);

                        columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('Dr/Cr')"))
                    .DataType(GridColumnDataType.String).Lookup(lookup => lookup
                            .DataSource(new[] { "Dr", "Cr" })
                            .ValueExpr("this")
                            .DisplayExpr("this")
                            );

                        columns.AddFor(m => m.AccountHead).DataField("AccountHead").Caption(new JS("formatMessage('Account Head')")).Width("350")
                            .CellTemplate(@<text>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="account-head-span">
                        <%- data.AccountHead ? data.AccountHead : "No Selection" %>
                    </span>
                </div>
            </text>)
                        .EditCellTemplate(@<text>


                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryReceipts")
                .LoadAction("GetEditAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )

                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBoxEdit")
                .ShowClearButton(true)
                .AcceptCustomValue(false)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change")
                .HoverStateEnabled(true)
                .Value(new JS("data.AccountHead"))
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .OnValueChanged("gridData_valueChanged")
                .OnOpened("onOpened")
                .Width(350)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(500))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("ReceivingAccountDropdownContentTemplate"))
                )


            </text>);



                        columns.AddFor(m => m.DrAmount).Caption(new JS("formatMessage('Debit')"))
                    .Alignment(HorizontalAlignment.Right).AllowEditing(false).CustomizeText(
                            "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                            );
                        columns.AddFor(m => m.CrAmount).Caption(new JS("formatMessage('Credit')"))
                    .Alignment(HorizontalAlignment.Right).AllowEditing(false).CustomizeText(
                            "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                            );
                        columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('Entry Narration')"))
                    .Width(300);
                        columns.AddFor(m => m.SysRemarks)
                                .Caption(new JS("formatMessage('Remarks')"))
                                .Width(300);
                            })
                        .Selection(selection => selection.Mode(SelectionMode.Single))
                        //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
                        .AllowColumnReordering(true) // Enable column reordering
                        .AllowColumnResizing(true)   // Enable column resizing
                        .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                        .HeaderFilter(filter => filter.Visible(true))
                        .Height(250)
                        .ColumnAutoWidth(true)
                        .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                        .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                        .ShowBorders(true)
                        .Width("100%")
                        .Editing(editing => editing
                        .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                        .AllowUpdating(true)   // Enable editing of existing rows
                        .AllowDeleting(true)   // Enable deleting rows
            .UseIcons(true)                       // Enables icons for editing buttons
                        )
                        .OnEditorPreparing("onEditorPreparing")
                        .OnRowUpdating("onRowUpdating")
                        .OnRowRemoving("onRowRemoving") 
                        .Summary(summary =>
                        {
                            summary.TotalItems(totalItems =>
                            {

                                totalItems.Add().Column("DrAmount").SummaryType(SummaryType.Sum)
                            .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                                totalItems.Add().Column("CrAmount").SummaryType(SummaryType.Sum)
                            .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                            });
                        })
                        )
        </div>
    </div>



    <!-- Context Menu for Actions -->
    <ul id="contextMenu" class="context-menu" style="display: none;">
        <li onclick="editCostAllocation()">
            <i class="fas fa-edit" style="margin-right: 8px;"></i><div id="EditCostAllocation">Edit Cost Allocation</div>
        </li>
        <li onclick="editBillsReceivable()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditBillReceivable">Edit Bill Receivable</div>
        </li>

        <li onclick="editEmployeeAllocation()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i> <div id="EditEmployeeAllocation">Edit Employee Allocation</div>
        </li>
        <li onclick="editPropertyAllocation()">
            <i class="fas fa-cogs" style="margin-right: 8px;"></i><div id="EditPropertyAllocation">Edit Property Allocation</div>
        </li>

        <li onclick="onAllRowRemoving()">
            <i class="fas fa-trash-alt" style="margin-right: 8px;"></i> <div id="DeleteAllLineEntries">Delete All Line Entries</div>
        </li>
    </ul>

