@page
@model Form.Areas.Finance.Pages.VoucherEntryReceiptsModel
@{
    ViewData["Title"] = "Receipt Voucher Details";

}
<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        padding: 15px;
        margin: 20px auto;
        max-width: 1300px;
        background-color: #595959;
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .button-alignment-down {
        margin-bottom: 10px
    }

    .content-container {
        background-color: #595959;
        border-radius: 10px;
        padding: 5px;
    }
    /* Style for edit button */
    .dx-command-edit .dx-icon-edit {
        color: green; /* Green color for edit */
    }

    /* Style for delete button */
    .dx-command-edit .dx-icon-trash {
        color: red; /* Red color for delete */
    }
</style>
<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="card">
    <div class="content-container">
        <div class="card-header" style=" color: white; font-weight:bolder; font-size: 24px;background-color:  #595959;">

            Receipts Voucher Details:
        </div>


        <div class="dx-fieldset horizontal-container" style="margin-bottom:0px">
            <div class="form-group">
                <label for="VoucherNo" class="button-alignment-down" style="color: white;"><strong>Voucher No:</strong></label>

                @(
                    Html.DevExtreme().TextBox()
                    .ID("VoucherNo")
                    .Value(null)
                    .ReadOnly(true)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Voucher No is required");
                    })
                    )
            </div>

            <div class="form-group">
                <label for="VoucherDate" class="button-alignment-down" style="color: white;"><strong>Voucher Date:</strong></label>

                @(Html.DevExtreme().DateBox()

                    .ID("VoucherDate")

                    .InputAttr("aria-label", "Date")

                    .LabelMode(EditorLabelMode.Outside)

                    .Type(DateBoxType.Date)

                    .DisplayFormat("dd-MMM-yyyy")

                    .Value(DateTime.Now)

                    )
            </div>
            <div class="form-group">
                <label for="EffectiveDate" class="button-alignment-down" style="color: white;"><strong>Effective Date:</strong></label>

                @(Html.DevExtreme().DateBox()

                    .ID("EffectiveDate")

                    .InputAttr("aria-label", "Date")

                    .LabelMode(EditorLabelMode.Outside)

                    .Type(DateBoxType.Date)

                    .DisplayFormat("dd-MMM-yyyy")

                    .Value(DateTime.Now)

                    )
            </div>
            <div class="form-group">
                <label for="" class="button-alignment-down" style="color: white;"><strong>Receiving Account:</strong></label>
                @(Html.DevExtreme().DropDownBox()
                    .DataSource(d => d.WebApi()
                    .Controller("VoucherEntryReceipts")
                    .LoadAction("GetReceivingAccount")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("AccountId")
                    )
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Receiving Account is required");
                    })
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("accountDropDownBox")
                    .ShowClearButton(true)
                    .AcceptCustomValue(true)
                    .OpenOnFieldClick(false)
                    .ValueChangeEvent("change") // Detects changes in the dropdown
                    .HoverStateEnabled(true)
                    .ValueExpr("AccountId")
                    .DisplayExpr("AccountHead")
                    .OnValueChanged("onReceivingAccountChange") // Call the change handler
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(720)
                    .TabIndex(1)
                    .DropDownOptions(o => o.Width(1000))
                    .OnKeyDown("onKeyDown")
                    .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                    )
            </div>



        </div>



        <div class="dx-fieldset horizontal-container " style="margin-top:15px;margin-bottom:0px;background-color: #f0f0f0">

            <div class="form-group" style="padding-left:20px">
                <div class="button-alignment-down">
                    <label for="DrCr"><strong>Dr/Cr:</strong></label>
                </div>
                @(
                    Html.DevExtreme().SelectBox()
                    .ID("TransactionTypeComboBox")
                    .DataSource(new[] { "Dr", "Cr" })
                    .Value("Cr")
                    .Placeholder("Select Transaction Type")
                    .Width(90)
                    )
            </div>


            <div class="form-group">
                <label for="" class="button-alignment-down" style="color: black;"><strong>Account Head:</strong></label>
                @(Html.DevExtreme().DropDownBox()
                    .DataSource(d => d.WebApi()
                    .Controller("VoucherEntryReceipts")
                    .LoadAction("GetAccountHead")
                    .LoadParams(new { SelectedPaymentAccount = new JS("$('#accountDropDownBox').dxDropDownBox('instance').option('value')") }) // Pass the selected Receiving Account value
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("AccountId")
                    )
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Account Head is required");
                    })
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("AccountHeadDropDown")
                    .ShowClearButton(true)
                    .AcceptCustomValue(true)
                    .OpenOnFieldClick(false)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .ValueExpr("AccountId")
                    .DisplayExpr("AccountHead")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    @* .OnOpened("onDropDownBoxOpened") *@
                    .Width(720)
                    .TabIndex(1)
                    .DropDownOptions(o => o.Width(1000))
                    .OnKeyDown("onKeyDown")
                    .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                    )
            </div>


            <div class="form-group" style="margin-top:56px;margin-left:-10px">
                @(Html.DevExtreme().Button()
                    .ID("btnAddAHead")
                    .Icon("plus")
                    .OnClick("showPopup") // Attach the onClick event handler
                    )
            </div>
            <div id="popupContainer"></div>
            <div class="form-group" style="margin-top:56px;margin-left:-10px">
                @(Html.DevExtreme().Button()
                    .ID("btnEditAHead")
                    .Icon("edit")
                    .OnClick("showPopup")
                    )
            </div>
            <div class="form-group">
                <label for="Amount" class="button-alignment-down"><strong>Amount:</strong></label>
                @(
                    Html.DevExtreme().NumberBox()
                    .ID("Amount")
                    .Value(null)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Voucher Amount is required");
                    })

                    .Placeholder("0.00")
                    .Format("#,##0.00")
                    .InputAttr(new
                    {
                        style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                        type = "number",
                        step = "0.01"
                    })

                    )
            </div>
        </div>

        <div class="dx-fieldset horizontal-container " style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px;background-color: #f0f0f0;">
            <div class="form-group" style="padding-left:20px">
                <label for="Amount" class="button-alignment-down" style="margin-right:25px"><strong>Narration:</strong></label>
            </div>
            <div class="form-group">
                @(
                    Html.DevExtreme().TextArea()
                    .ID("Narration")
                    .Value("")
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Narration is required");
                    })
                    .Height(70)
                    .Width(720)
                    .Placeholder("Enter your comments here...")
                    .MaxLength(500)
                    )
            </div>
            <div class="form-group" style="">
                @(Html.DevExtreme().Button()
                    .ID("btnaddCostAllocation")
                    .Text("ADD")
                    .Height(70)
                    .Width(178)
                    .Icon("plus")
                    .OnClick("function() { addVoucherEntry(); }")
                    )
            </div>

        </div>
        <div class="dx-field ledgerResult">

            @(
                Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                .ID("dataGrid")
                .RemoteOperations(false)
                .Columns(columns =>
                {
                    columns.AddFor(m => m.VoucherEntryNo)
                    .Caption("VoucherEntryNo")
                    .Visible(false);

                    columns.AddFor(m => m.DrCr).Caption("Dr/Cr").DataType(GridColumnDataType.String).Lookup(lookup => lookup
                    .DataSource(new[] { "Dr", "Cr" }) // Data source for dropdown
                    .ValueExpr("this")
                    .DisplayExpr("this")
                    );

                    columns.AddFor(m => m.AccountHead)
                    .Caption("Account Head") // Column header text
                    .DataType(GridColumnDataType.String) // Column data type
                    .Lookup(lookup => lookup
                    .DataSource(ds => ds.WebApi() // Web API data source
                    .Controller("VoucherEntryReceipts") // Controller handling the data
                    .LoadAction("GetAccountHead") // Action to fetch data from the API
                    )
                    .ValueExpr("AccountId") // Field in the API response for the value of the dropdown
                    .DisplayExpr("AccountHead") // Field in the API response to be displayed in the dropdown
                    );
                    columns.AddFor(m => m.DrAmount).Caption("Debit").Alignment(HorizontalAlignment.Right).CustomizeText(
                    "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                    );
                    columns.AddFor(m => m.CrAmount).Caption("Credit").Alignment(HorizontalAlignment.Right).CustomizeText(
                    "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                    );
                    columns.AddFor(m => m.EntryNarration).Caption("Entry Narration");
                    columns.AddFor(m => m.SysRemarks).Caption("Remarks");
                })

                //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
                .AllowColumnReordering(true) // Enable column reordering
                .AllowColumnResizing(true)   // Enable column resizing
                .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                .HeaderFilter(filter => filter.Visible(true))
                .Height(250)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                .ShowBorders(true)
                .Width("100%")
                .Editing(editing => editing
                .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                .AllowUpdating(true)   // Enable editing of existing rows
                .AllowDeleting(true)   // Enable deleting rows
                .UseIcons(true) // Enables icons for editing buttons
                )
                .OnEditorPreparing("onEditorPreparing")
                .OnRowRemoving("onRowRemoving")
                )

        </div>
        <div id="footerTotals" style="display: flex; background-color: #666; color: white; padding: 5px 10px; font-size: 14px;">
            <div style="flex: 3.4;">&nbsp;</div> <!-- Aligns with Dr/Cr and Account Head columns -->
            <!-- TextBox for Debit -->
            <div style="flex: 1; text-align: center;">
                @(Html.DevExtreme().TextBox()
                    .ID("totalDebitTextbox")
                    .Value("0.00")
                    .ReadOnly(true)
                    .Width("100%")
                    )
            </div>
            <!-- TextBox for Credit -->
            <div style="flex: 1; text-align: center;">
                @(Html.DevExtreme().TextBox()
                    .ID("totalCreditTextbox")
                    .Value("0.00")
                    .ReadOnly(true)
                    .Width("100%")
                    )
            </div>
            <div style="flex: 4;">&nbsp;</div> <!-- Aligns with Entry Narration and Remarks columns -->
        </div>

        <div style="flex: 2;">&nbsp;</div> <!-- Aligns with Entry Narration and Remarks columns -->
    </div>

    <div class="container" style="margin-top:0px;margin-bottom:0px;padding-top:15px;background-color: #f0f0f0;padding-bottom:30px">
        <div class="row g-3">
            <div class="col-md-3 backgroundcolor" style="padding-top:10px;padding-bottom:10px">

                <div class="form-group">
                    <label for="Cheque No/Reference No"><strong>Cheque No/Reference No:</strong></label>
                    @(
                        Html.DevExtreme().TextBox()
                        .ID("ChequeNoReferenceNo")
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Cheque No is required");
                        })
                        .Value(null)
                        )
                </div>
                <div class="form-group mt-3">
                    <label for="VoucherType"><strong>Voucher Type:</strong></label>
                    @(
                        Html.DevExtreme().SelectBox()
                        .ID("VoucherType")
                        .DataSource(new[] { "Bank Receipts" }) // DataSource
                        .Value("Bank Receipts") // Default value
                        .Disabled(true) // Disable the dropdown
                        )
                </div>
            </div>

            <div class="col-md-8 backgroundcolor" style="padding-top:10px;padding-bottom:10px">
                <div class="form-group">
                    <label for="VoucherNarration"><strong>Voucher Narration:</strong></label>
                    @(
                        Html.DevExtreme().TextBox()
                        .ID("VoucherNarration")
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Voucher Narration is required");
                        })
                        .Value(null)

                        )
                </div>
                <div class="form-group mt-3">
                    <label for="Remarks"><strong>Remarks:</strong></label>
                    @(
                        Html.DevExtreme().TextBox()
                        .ID("Remarks")
                        .Value(null)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Remarks is required");
                        })

                        )

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <!-- Verified By -->
                        <div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
                            @(Html.DevExtreme().CheckBox().ID("VerifiedBy"))
                            <span style="margin-left:5px"><strong>Verified By:</strong></span>
                            @(Html.DevExtreme().TextBox()
                                .ID("VerifiedBytext")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                )
                        </div>
                        <!-- Verified On -->
                        <div class="form-group d-flex align-items-center mt-2">
                            <span><strong>Verified On:</strong></span>
                            @(Html.DevExtreme().TextBox()
                                .ID("VerifiedOnDate")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                .ElementAttr(new { style = "margin-left: 10px;" })
                                )
                        </div>
                    </div>
                    <div class="col-md-6">
                        <!-- Approved By -->
                        <div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
                            @(Html.DevExtreme().CheckBox().ID("ApprovedBy"))
                            <span style="margin-left:5px"><strong>Approved By:</strong></span>
                            @(Html.DevExtreme().TextBox()
                                .ID("ApprovedBytext")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                )
                        </div>
                        <!-- Approved On -->
                        <div class="form-group d-flex align-items-center mt-2">
                            <span><strong>Approved On:</strong></span>
                            @(Html.DevExtreme().TextBox()
                                .ID("ApprovedOntext")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                .ElementAttr(new { style = "margin-left: 10px;" })
                                )
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-1 backgroundcolor">
                <div class="form-group" style="padding-top:50px;padding-left:7px;">
                    <!-- Attach Button -->
                    @(Html.DevExtreme().Button()
                        .ID("btnAttachment")
                        .Icon("attach")
                        .Height(100)
                        .Width(100)
                        .OnClick("openAttachmentOptions")
                        )
                </div>
                <input type="file" id="fileInput" style="display:none;" />
            </div>
        </div>
    </div>
    <div>
        @await Html.PartialAsync("_Formfooter")
    </div>
    <!-- Drop Down Grid Template -->
