    {
        @(
                Html.DevExtreme().DataGrid()
                .ID("accounthead-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryReceipts")

                .LoadAction("GetAccountHead")
                .LoadParams(new { SelectedPaymentAccount = new JS("$('#accountDropDownBox').dxDropDownBox('instance').option('value')") }) // Exclude Receiving Account
