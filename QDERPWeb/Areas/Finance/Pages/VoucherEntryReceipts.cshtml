<script>

    let acchead, spentry, accheadid, accheadname, vno, paymentaccheadname, paymentaccheadId, isUpdatingCell = false, verifiedby, griddatacount, employeeval, empName, refno, accgroup, IsEdit = false, accgroupid, accheadar, vouentryid,
        IsNotification = false, storedAccountHead, IsObeselete = false;

    function addVoucherEntry() {

        var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

        var amount = $("#Amount").dxNumberBox("instance").option("value");

        var accountHead = $("#AccountHeadDropDown").dxDropDownBox("instance").option("value");

        var sbDrCr = $("#TransactionTypeComboBox").dxSelectBox("instance").option("value");

        var accountHeadValidator = $("#AccountHeadDropDown").dxValidator("instance");

        var voucherAmtValidator = $("#Amount").dxValidator("instance");

        var accountHeadValidation = accountHeadValidator.validate();

        var voucherAmtValidation = voucherAmtValidator.validate();

        // Ensure paymentaccheadname and paymentaccheadId are assigned before use
        if (!paymentaccheadname || !paymentaccheadId) {
            DevExpress.ui.dialog.alert(
                "Default Receiving Account not set. Please refresh the page or check the setup.",
                "Error"
            );
            return;
        }

        var dataGrid = $("#dataGrid").dxDataGrid("instance"); // Get the DataGrid instance

        var rowCount = dataGrid.getVisibleRows().length; // Get the number of rows in the grid

        griddatacount = rowCount;

        if (accountHeadValidation.isValid && voucherAmtValidation.isValid && amount != "0.00") {

            var sysRemarks1 = paymentaccheadname ? `Received by : ${paymentaccheadname}` : "";

            var sysRemarks2 = accheadname || "";

            var VE = [];

            var gridData = $("#dataGrid").dxDataGrid("instance").option("dataSource") || [];

            // Check if "Petty Cash - Shabbir" already exists in the grid

            var exists = gridData.some(function (row) {

                return row.AccountHead === paymentaccheadname;

            });

            if (!exists) {

                // Add both entries if "Petty Cash - Shabbir" does not exist

                VE = [

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": accountHead,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr,

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

                        "SysRemarks": sysRemarks1

                    },

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": paymentaccheadId,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr === "Cr" ? "Dr" : "Cr",

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value", ""),

                        "SysRemarks": sysRemarks2

                    }

                ];

            }

            else if (paymentaccheadname != paymentaccheadname) {

                // Add only the first entry if "Petty Cash - Shabbir" exists

                VE = [

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": accountHead,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr,

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

                        "SysRemarks": sysRemarks1

                    },

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": paymentaccheadId,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr === "Cr" ? "Dr" : "Cr",

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value", ""),

                        "SysRemarks": sysRemarks2

                    }

                ];

            }

            else {

                // Add only the first entry if "Petty Cash - Shabbir" exists

                VE = [

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": accountHead,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr,

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

                        "SysRemarks": sysRemarks1

                    }

                ];

            }

            // Perform the AJAX request

            $.ajax({

                type: "POST",

                url: `/api/VoucherEntryReceipts/AddVoucherEntry?AccountHead=${encodeURIComponent(sysRemarks2)}&PaymentAccoutHeadName=${encodeURIComponent(paymentaccheadId)}&Gridcount=${encodeURIComponent(griddatacount)}`,

                contentType: "application/json",

                data: JSON.stringify(VE),

                dataType: "json",

                success: function (response) {



                     $("#Narration").dxTextArea("instance").option("value", "");
                     var accountHeadValidator = $("#AccountHeadDropDown").dxValidator("instance");
                     accountHeadValidator.reset();
                     var voucherAmtValidator = $("#Amount").dxValidator("instance");
                     voucherAmtValidator.reset();

                    $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
                     var button = $("#btnSave").dxButton("instance");
                    button.option("text", "Update");
                    //   DevExpress.ui.notify("Data saved successfully!", "success", 2000);
                    // Get accounthead-datagrid instance
    var accountGrid = $("#accounthead-datagrid").dxDataGrid("instance");

    // Unselect the selected row
    accountGrid.clearSelection();  

   
                     
                    //console.log(response.data);
                    // Retrieve the newly added row from response or datagrid instance
                    var updatedGridData = $("#dataGrid").dxDataGrid("instance").option("dataSource");

                    // Filter entries where DrCr is "Cr"
                    var filteredData = updatedGridData.filter(entry => entry.DrCr === "Cr");

                    // Get the latest entry from the filtered data
                    var latestEntry = filteredData.length > 0 ? filteredData[filteredData.length - 1] : null;
                    console.log(latestEntry);
                    if (accheadname && accheadname.startsWith("Cost")) {

                        const params = {
                            VoucherNo: encodeURIComponent(voucherNo),
                            VoucherEntryNo: encodeURIComponent(latestEntry.VoucherEntryNo),
                            AccountHead: encodeURIComponent(accheadname),
                            VoucherAmount: encodeURIComponent(amount),
                            DrCr: encodeURIComponent(sbDrCr)

                        };
                        openCostAllocationPopup(params); // Open DevExtreme Popup with dynamic content
                    } else if (accheadname) {
                        debugger;

                        // Function to check allocation
                        function checkAllocation(url, successCallback) {
                            $.ajax({
                                type: "GET",
                                url: url,
                                data: {
                                    AccountHead: accheadname,
                                    AccountID: accheadid
                                },
                                success: function (response) {
                                    if (response.isAllocated) {
                                        const params = {
                                            VoucherNo: encodeURIComponent(voucherNo),
                                            VoucherEntryNo: encodeURIComponent(latestEntry.VoucherEntryNo),
                                            AccountHead: encodeURIComponent(accheadname),
                                            VoucherAmount: encodeURIComponent(amount),
                                            DrCr: encodeURIComponent(sbDrCr),
                                            AccountID: encodeURIComponent(accheadid)
                                        };
                                        successCallback(params);
                                    }
                                },
                                error: function (xhr, status, error) {
                                    console.error(`Error checking allocation: ${error}`);
                                }
                            });
                        }

                        // Check Property Allocation
                        checkAllocation(`/api/VoucherEntryCashReceipts/CheckPropertyAllocation`, openPropertyAllocationPopup);

                        // Check Employee Allocation
                        checkAllocation(`/api/VoucherEntryCashReceipts/CheckEmployeeAllocation`, openEmployeeAllocationPopup);

                        checkAllocation(`/api/VoucherEntryReceipts/CheckIsMaintainBillByBill`, openBillsReceivablePopup);
                    }

                },

                error: function (xhr, status, error) {

                    alert("Error occurred while updating data: " + error);

                }

            });

        } else {
            IsNotification=true;
                         // Append the stored value back when the user clicks Add again                    
    if (storedAccountHead) {

   const ddbInstance = $("#AccountHeadDropDown").dxDropDownBox("instance");
            ddbInstance.option("value", storedAccountHead);
        var currentValue = accountHeadInstance.option("value");

        if (!currentValue.includes(storedAccountHead)) {

            accountHeadInstance.option("value", storedAccountHead);
        }
    }

             DevExpress.ui.dialog.alert(
                "Cannot continue saving with errors,please clear the errors and continue.",
                "Clear Errors"
            );


        }
        // alert(accheadname)
        // if(accheadname!=null)
        // {
        var accountHeadInstance = $("#AccountHeadDropDown").dxDropDownBox("instance");

        storedAccountHead = accountHeadInstance.option("value"); // Store before reset

        if (accheadname != null) {

            if (accheadname.startsWith("Salary Payable")) {

                var voucherNo1 = $("#VoucherNo").dxTextBox("instance").option("value");

                $("#VoucherEntryID").dxTextBox("instance").option("value", voucherNo1);

                dataGridSelectionChangedPaymentAccount({ selectedRowKeys: [accheadname] });

                $("#SPtxtVoucherAmount").dxNumberBox("instance").option("value", amount + ".00");

                // Show the button

                // alert("1");

                //       window.location.href = `/Finance/SalaryPaidEntryRes?VoucherNo=${encodeURIComponent(voucherNo)}&PaymentAmount=${encodeURIComponent(accheadname)}&Amount=${encodeURIComponent(amount)}&AccountHeadID=${encodeURIComponent(accheadid)}`;

                // return;

            }

        }

    }


