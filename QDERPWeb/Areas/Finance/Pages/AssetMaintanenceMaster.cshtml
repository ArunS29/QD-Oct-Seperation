@page
@model QD.ERP.Web.Areas.Finance.Pages.AssetMaintanenceMasterModel
@{
}
@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Add SweetAlert CSS and JS CDN -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.js"></script>

<style type="text/css">
    /* Card container styling */
    .card-container {
        background-color: White; /* Set background color for the card */
        padding: 20px; /* Add some padding inside the card */
        border-radius: 8px; /* Rounded corners */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Soft shadow for the card */
    }

        /* Label text color blue */
        .card-container label {
            color: blue; /* Set label text color to blue */
        }

    /* Style for the textboxes */
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    /* Grid Column Header Text Color */
    .dx-datagrid-headers .dx-header-row .dx-datagrid-text-content {
        color: #2d5799; /* Set header text color */
    }

    /* Grid Column Header Background Color */
  .dx-header-row {
        background-color: white; /* Set background color for column headers */
    }
    .dx-datagrid-headers{
        background-color:aliceblue;
    }

    /* Button customization */
    .dx-button-add {
        background-color: #f5f8fb !important; /* Set background color to #cfddee */
        color: red !important; /* Set text color to red */
        border: 1px solid #b0c4de; /* Light border around the button */
    }

        .dx-button-add .dx-icon {
            color: green !important; /* Set icon color to green */
        }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }

    .backgroundcolor {
        background-color: #89f0b5;
    }

    .button-alignment-down {
        margin-bottom: 10px;
    }

    /* Style for the Save and Refresh buttons */
    .action-buttons-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

        .action-buttons-container .dx-button {
            margin-right: 10px; /* Space between buttons */
        }
</style>

<div class="content-container-top">
    <div class="container">
        <h2>Asset Maintenance Master</h2>
        <div class="row g-6">
            <div class="card-container">

                <div class="col-md-8">
                    <div class="form-group">
                        <label for="SalesInvoiceNo" class="button-alignment-down">Type a New Maintenance Type & Add to the Existing List</label>
                        @(
                            Html.DevExtreme().TextBox()
                            .ID("txtmaintanence")
                            .Value(null)
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired()
                                .Message("Maintanence Type is required");
                            })
                            )
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @(Html.DevExtreme().Button()
                            .ID("btnadd")
                            .Text("ADD")
                            .Height(70)
                            .Width(178)
                            .Icon("plus")
                            .OnClick("function() { addVoucherEntry(); }")
                            .ElementAttr(new { @class = "dx-button-add" })
                            )
                    </div>
                </div>
            </div>
        </div>
        <div class="clear"></div>
        <br />
        <div id="gridContainer"></div>
    </div> <!-- End of card-container -->
</div>
<script type="text/javascript">
    $(function () {
        // Initialize DevExtreme DataGrid with CustomStore for Asset Maintenance Type
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "AssetMaintenanceTypeId",
                load: function () {
                    return $.getJSON('/api/Master/GetAssetMaintanencetype'); // Fetch data from the API
                },
                update: function (key, values) {
                    var updatedAssetMaintenanceType = {
                        AssetMaintenanceTypeId: key,
                        AssetMaintenanceType: values.AssetMaintenanceType
                    };

                    // Get existing asset maintenance types from the grid
                    var existingTypes = $("#gridContainer").dxDataGrid("instance").getDataSource().items();

                    // Check if the updated maintenance type already exists in the grid (excluding the current row)
                    var duplicate = existingTypes.some(function (item) {
                        return item.AssetMaintenanceType.toLowerCase() === updatedAssetMaintenanceType.AssetMaintenanceType.toLowerCase() && item.AssetMaintenanceTypeId !== key;
                    });

                    if (duplicate) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Duplicate Type',
                            text: 'This maintenance type already exists!',
                            confirmButtonText: 'OK'
                        });
                        return; // Prevent the update if a duplicate exists
                    }

                    // If no duplicate, proceed with the update
                    return $.ajax({
                        type: "POST",
                        url: "/api/Master/UpdateAssetMaintanencetype",
                        data: JSON.stringify(updatedAssetMaintenanceType),
                        contentType: "application/json",
                        success: function () {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: 'Asset maintenance type updated successfully.',
                                confirmButtonText: 'OK'
                            });
                        },
                        error: function (xhr) {
                            var errorMessage = xhr.status === 500
                                ? "Server error: Please try again later."
                                : "Validation error: " + xhr.responseText;
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: errorMessage,
                                confirmButtonText: 'OK'
                            });
                        }
                    });
                }
            }),
            editing: {
                mode: "batch",
                allowUpdating: true,
                allowAdding: true,  // Allow adding records
                allowDeleting: true,  // Allow deleting records
                useIcons: true,
                texts: {
                    saveAll: "Update",
                    cancelAll: "Cancel All Changes"
                }
            },
            columns: [
                { dataField: "AssetMaintenanceTypeId", caption: "Maintenance Type ID", width: 100, allowFiltering: false, editorOptions: { readOnly: true } },
                { dataField: "AssetMaintenanceType", caption: "Maintenance Type", allowFiltering: false },
                {
                    type: "buttons",
                    width: 100,
                    buttons: [
                        {
                            icon: "trash",
                            hint: "Delete",
                            onClick: function (e) {
                                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                var selectedData = e.row.data;
                                var assetMaintenanceTypeId = selectedData.AssetMaintenanceTypeId;

                                // Send delete request to the API
                                $.ajax({
                                    type: "POST",
                                    url: "/api/Master/DeleteAssetMaintanencetype",
                                    data: JSON.stringify({ AssetMaintenanceTypeId: assetMaintenanceTypeId }),
                                    contentType: "application/json",
                                    success: function (response) {
                                        if (response.success) {
                                            dataGrid.refresh(); // Refresh the grid
                                            Swal.fire({
                                                icon: 'success',
                                                title: 'Success',
                                                text: 'Asset maintenance type deleted successfully.',
                                                confirmButtonText: 'OK'
                                            });
                                        } else {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'Error',
                                                text: response.message,
                                                confirmButtonText: 'OK'
                                            });
                                        }
                                    },
                                    error: function (xhr) {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error',
                                            text: xhr.responseText,
                                            confirmButtonText: 'OK'
                                        });
                                    }
                                });
                            }
                        }
                    ]
                }
            ],
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: {
                visible: false,
                applyFilter: "auto"
            },
            toolbar: {
                items: [
                    {
                        widget: "dxButton",
                        options: {
                            icon: "save",
                            text: "Update",
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").saveEditData();  // Save all changes
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",
                        options: {
                            icon: "close",
                            text: "Cancel",
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").cancelEditData();  // Cancel all edits
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",
                        options: {
                            icon: "arrowleft",
                            text: "Back",
                            onClick: function () {
                                window.close(); // Close the current window/tab
                            }
                        },
                        location: "after"
                    }
                ]
            },
            scrolling: {
                mode: "virtual",
                rowRenderingMode: "virtual",
                useNative: true
            },
            height: 400,
            width: "100%"
        });
    });

    // Function to add a new Asset Maintenance Type
    function addVoucherEntry() {
        var AssetMaintenanceType = $("#txtmaintanence").dxTextBox("instance").option("value");

        var AssetMaintenanceTypeValidator = $("#txtmaintanence").dxValidator("instance");
        var AssetMaintenanceTypeValidation = AssetMaintenanceTypeValidator.validate();

        if (AssetMaintenanceTypeValidation.isValid) {
            // Get the data array from the grid's data source
            var existingTypes = $("#gridContainer").dxDataGrid("instance").getDataSource().items();

            // Check if the maintenance type already exists in the grid data
            var duplicate = existingTypes.some(function (item) {
                return item.AssetMaintenanceType.toLowerCase() === AssetMaintenanceType.toLowerCase();
            });

            if (duplicate) {
                Swal.fire({
                    icon: 'error',
                    title: 'Duplicate Type',
                    text: 'This maintenance type already exists!',
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Add the new maintenance type to the grid
            $.ajax({
                type: "POST",
                url: "/api/Master/AddAssetMaintanencetype",
                data: JSON.stringify({ AssetMaintenanceType: AssetMaintenanceType }),
                contentType: "application/json",
                success: function () {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Asset maintenance type added successfully.',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        // Refresh the grid after successful addition
                        $("#gridContainer").dxDataGrid("instance").refresh();
                    });
                },
                error: function (xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: xhr.responseText,
                        confirmButtonText: 'OK'
                    });
                }
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Invalid Input',
                text: 'Please provide a valid maintenance type.',
                confirmButtonText: 'OK'
            });
        }
    }

</script>

