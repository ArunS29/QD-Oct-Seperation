<div id="voucherPopup"></div>
<script>
    $(function () {
        $("#AssetView").dxTextBox({
            text: formatMessage("Asset View"),
            readOnly: true,
            onContentReady: function(e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        
        });

        let selectedVoucherId = null;

        $("#voucherPopup").dxPopup({
            width: 250,
            height: "auto",
            maxHeight: 300,
            visible: false,
            dragEnabled: true,
            closeOnOutsideClick: true,
            showTitle: false,
            contentTemplate: function () {
                return $("<div>")
                    .css({ overflow: "hidden", padding: "10px" })
                    .append(
                        $("<ul>")
                            .addClass("voucher-actions")
                            .css({ "list-style": "none", margin: "0", padding: "0" })
                            .append(
                                createMenuItem(formatMessage("Edit Asset Details"), "edit", editVoucher, "black"),
                                createMenuItem(formatMessage("Delete Asset Details"), "trash", deleteVoucher, "red")
                            )
                    );
            },
        });

        function createMenuItem(text, icon, clickHandler, iconColor) {
            return $("<li>")
                .addClass("menu-item")
                .append(
                    $("<i>")
                        .addClass("dx-icon dx-icon-" + icon)
                        .css({ color: iconColor, "font-size": "18px", "margin-right": "8px" }),
                    $("<span>")
                        .text(text)
                        .css({ "font-size": "14px", "font-weight": "bold" })
                )
                .on("click", clickHandler)
                .css({
                    padding: "10px 15px",
                    cursor: "pointer",
                    color: "#000",
                    "background-color": "#fff",
                    border: "1px solid #ddd",
                    "border-radius": "4px",
                    "margin-bottom": "5px",
                    "font-family": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
                    display: "flex",
                    "align-items": "center",
                    transition: "background-color 0.3s ease",
                })
                .hover(
                    function () { $(this).css("background-color", "#f0f0f0"); },
                    function () { $(this).css("background-color", "#fff"); }
                );
        }

        function editVoucher() {
            if (!selectedVoucherId) {
                alert("Please select a voucher to edit.");
                return;
            }
            window.location.href = `/${tenantName}/Finance/Asset?assetLedgerNo=${selectedVoucherId}`;
        }
            function deleteVoucher() {
                
        if (!selectedVoucherId) {
            alert("Please select a voucher to delete.");
            return;
        }

        if (confirm("Are you sure you want to delete this voucher?")) {
            $.ajax({
                url: `/api/AssetView/Delete?assetLedgerNo=${encodeURIComponent(selectedVoucherId)}`,  // Include tenantName and Finance in URL
                type: "POST",  // Ensure it matches the API method
                contentType: "application/json",
                dataType: "json",  // Ensure JSON response parsing
                data: JSON.stringify({ assetLedgerNo: selectedVoucherId }),
                success: function (response) {
                    alert(response.message || "Voucher deleted successfully.");
                    $("#dataGrid").dxDataGrid("instance").refresh();
                },
                error: function (xhr) {
                    console.error("Error deleting voucher:", xhr.responseText);
                    alert(xhr.responseJSON?.message || "An error occurred while deleting the voucher.");
                },
            });
        }
    }



        $("#dataGrid").dxDataGrid({
            selection: {
                mode: "single",
                showCheckBoxesMode: "none",
            },
            onSelectionChanged: function (e) {
                const selectedRows = e.selectedRowsData;
                if (selectedRows.length > 0) {
                    selectedVoucherId = selectedRows[0].AssetLedgerNo;
                } else {
                    selectedVoucherId = null;
                }
            },
        });
    $(document).on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault(); // Prevent default right-click menu

        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowIndex = $(this).index(); // Get the row index from DOM
        const rowData = dataGrid.getVisibleRows()[rowIndex]?.data;

        if (rowData) {
            selectedVoucherId = rowData.AssetLedgerNo; // Set selected ID manually
            dataGrid.selectRowsByIndexes([rowIndex]); // Visually select the row
        }

        const popup = $("#voucherPopup").dxPopup("instance");
        popup.option("position", { my: "left top", at: "left bottom", of: e });
        popup.show();
    });

        $(document).on("click", function (e) {
            if (!$(e.target).closest("#voucherPopup").length && !$(e.target).closest(".dx-data-row").length) {
                $("#voucherPopup").dxPopup("instance").hide();
            }
        });
    });

    function showDepreciationSchedule() {
       window.location.href = `/${tenantName}/Finance/DepreciationMaster`;
    }
    function applyShowWhenGroupedToAllGroupedColumns(grid) {
        const columns = grid.getVisibleColumns();

        // Recursive function to handle nested columns
        function processColumns(cols) {
            cols.forEach((col) => {
                if (col.columns) {
                    processColumns(col.columns);
                } else if (col.groupIndex >= 0 && col.showWhenGrouped !== true) {
                    grid.columnOption(col.dataField, "showWhenGrouped", true);
                }
            });
        }

        processColumns(columns);
    }

    function onGridInitialized(e) {
        applyShowWhenGroupedToAllGroupedColumns(e.component);
    }

    function onGridOptionChanged(e) {
        if (e.fullName?.startsWith("columns") && e.fullName.endsWith("groupIndex")) {
            const grid = e.component;
            applyShowWhenGroupedToAllGroupedColumns(grid);
        }
    }
     function NewDepreciation() {
        window.location.href = `/${tenantName}/Finance/CreateDepreciation`;
    }
</script>





