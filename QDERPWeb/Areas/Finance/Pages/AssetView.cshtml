@page
@model QDWEB.Pages.Shared.GridforAssetViewModel
<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }



    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }




    .button-alignment-down {
        margin-bottom: 10px
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    .dx-datagrid {
        color: #000000;
    }

    .center-checkbox {
        display: block;
        margin-left: 0;
        margin-right: 0;
    }

    .dx-datagrid .dx-cell {
        display: flex;
        justify-content: center;
        align-items: center;
    }


    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    #DepreciationModal .modal-dialog.fullscreen {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1050; /* Ensures it stays on top */
        width: 100%;
        height: 100%;
        margin: 0;
        max-width: none;
        overflow: hidden;
    }

    #DepreciationModal .modal-content {
        height: 600px;
        display: flex;
        flex-direction: column;
        width:1200px;
        margin-top:130px;
        margin-left:160px;
    }

    #DepreciationModal .modal-body {
        flex: 1; /* Takes up remaining space */
        overflow-y: auto; /* Enables vertical scrolling */
        overflow-x: hidden; /* Disables horizontal scrolling */
        padding: 15px; /* Optional: Adjust padding to make it visually better */
    }

    #DepreciationModal .card {
        background-color: #ffffff !important;
        color: #fff;
        border: none;
        border-radius: 5px;
    }

</style>
<div class="card" style="margin: 20px; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);">
    <div class="card-header" style=" color:black; font-weight: bold;">
        AssetView
    </div>
    <div class="card-body" style="padding: 20px;  border-radius: 5px;">


        <div class="dx-field ledgerResult">
            @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.sp20157AssetRegisterViewResult>()
                .ID("dataGrid")
                .KeyExpr("AccountID")
                .RemoteOperations(false)
                .DataSource(ds => ds.Mvc()
                .Controller("AssetView")
                .LoadAction("GetAssetView"))
                .Columns(columns =>
                {
                    columns.Add().DataField("AccountGroup").Caption("Account Group").GroupIndex(0);
                    columns.Add().DataField("AccountID").Visible(false);
                    columns.Add().Caption("AssetDetails").Columns(group =>
                    {
                        group.Add().DataField("AssetLedgerNo").Caption("Asset Ledger");
                        group.Add().DataField("AccountHead").Caption("Asset Ledger Name");
                        group.Add().DataField("AssetDescription").Caption("Asset Description");
                        group.Add().DataField("Specifications").Caption("Specifications");
                        group.Add().DataField("AccountGroup").Caption("Account  Group");
                        group.Add().DataField("PropertyNo").Caption("Property No");
                    });

                    columns.Add().Caption("Depreciation Details").Columns(group =>
                    {
                        group.Add().DataField("DepreciationMethod").Caption("Depreciation Method");
                        group.Add().DataField("ScrapValueOfProperty").Caption("Scrap Value").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("LifeSpanOfProperty").Caption("Life Span of Property").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("DepreciationPercentage").Caption("Depreciation").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("OpeningTotal").Caption("Opening Total").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("TotalDebit").Caption("Total Debit").Alignment(HorizontalAlignment.Right);

                        group.Add()
                    .DataField("TotalCredit")
                    .Caption("TotalCredit")
                    .Alignment(HorizontalAlignment.Right) // Ensure right alignment
                    .CustomizeText(@"
            function(e) {
            let value = e.value || 0; // Get the value
            let formattedValue = Math.abs(value).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
            });
            // Append 'Cr' only for negative values
            return value < 0 ? formattedValue + 'Cr' : formattedValue;
            }");

                        group.Add().DataField("ClosingBalance").Caption("Closing Balance").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("TotalDepreciatedAmount").Caption("Total Depreciated").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("NetBookValue").Caption("Net Book Value").Alignment(HorizontalAlignment.Right);
                    });

                    columns.Add().Caption("Specifications").Columns(group =>
                    {
                        group.Add().DataField("AssetCategory").Caption("Asset Category");
                        group.Add().DataField("AssetLocation").Caption("Asset Location");
                        group.Add().DataField("Brand").Caption("Brand");
                        group.Add().DataField("PlateNo").Caption("Plate No");
                        group.Add().DataField("Model").Caption("Model");
                        group.Add().DataField("Year").Caption("Year");
                        group.Add().DataField("Ownership").Caption("Ownership");
                        group.Add().DataField("PurchaseDate").Caption("Purchase Date");
                        group.Add().DataField("ValueOfProperty").Caption("Purchased Value").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("PurchasedAs").Caption("Purchased As");
                    });

                    columns.Add().Caption("Installment Details").Columns(group =>
                    {
                        group.Add().DataField("IsFinanced").Caption("Is Financed");
                        group.Add().DataField("FinancedFrom").Caption("Financed From");
                        group.Add().DataField("NoOfInstallments").Caption("No of Installments").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("InitialDownPayment").Caption("Initial Down Payment").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("InitialDocCharges").Caption("Initial Doc Charges").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("MonthlyInstallment").Caption("Monthly Installment").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("FinalInstallment").Caption("Final Installment").Alignment(HorizontalAlignment.Right);
                        group.Add().DataField("InstallmentStartDate").Caption("Installment Start Date").Format("dd-MMM-yyyy");
                        group.Add().DataField("InstallmentEndDate").Caption("Installment End Date").Format("dd-MMM-yyyy");
                    });
                })


                .Summary(summary =>
                {

                    summary.GroupItems(items =>
                    {
                        items.Add()
                    .Column("AccountHead")
                    .SummaryType(SummaryType.Count)
                    .ShowInGroupFooter(true);

                        items.Add()
                    .Column("OpeningTotal")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TotalDebit")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                        items.Add()
                    .Column("TotalCredit")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .CustomizeText(@"
            function(e) {
            let total = Math.abs(e.value || 0);
            return total.toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
            }) + 'Cr';
            }");

                        items.Add()
                    .Column("ClosingBalance")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TotalDepreciatedAmount")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("NetBookValue")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("ValueOfProperty")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                    });

                    summary.TotalItems(items =>
                    {
                        items.Add()
                    .Column("AccountHead")
                    .SummaryType(SummaryType.Count);

                        items.Add()
                    .Column("OpeningTotal")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TotalDebit")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TotalCredit")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"
            function(e) {
            let total = Math.abs(e.value || 0);
            return total.toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
            }) + 'Cr'; // Append 'Cr' for credits
            }");


                        items.Add()
                    .Column("ClosingBalance")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TotalDepreciatedAmount")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("NetBookValue")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("ValueOfProperty")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                    });
                })

                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(fixing => fixing.Enabled(true))
                .HeaderFilter(filter => filter.Visible(true))
                .Height(500)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false))
                .Grouping(grouping => grouping.AutoExpandAll(true))
                .GroupPanel(groupPanel => groupPanel.Visible(false))
                .ShowBorders(true)
                .Width("100%")
                )
        </div>
        <!-- Modal for Depreciation -->
        <div id="DepreciationModal" class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog fullscreen" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Depreciation Schedule</h5>
                        <!-- Close Button -->
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <!-- Content will be loaded dynamically -->
                        <div id="DepreciationContent"></div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            @await Html.PartialAsync("GridforAssetView")
        </div>
        <div id="voucherPopup"></div>
    </div>
</div>
    <script>
        $(function () {
            let selectedVoucherId = null;

            $("#voucherPopup").dxPopup({
                width: 250,
                height: "auto",
                maxHeight: 300,
                visible: false,
                dragEnabled: true,
                closeOnOutsideClick: true,
                showTitle: false,
                contentTemplate: function () {
                    return $("<div>")
                        .css({
                            overflow: "hidden",
                            padding: "10px",
                        })
                        .append(
                            $("<ul>")
                                .addClass("voucher-actions")
                                .css({
                                    "list-style": "none",
                                    margin: "0",
                                    padding: "0",
                                })
                                .append(
                                    createMenuItem("Edit Asset Details", "edit", editVoucher, "black"),
                                    createMenuItem("Delete Asset Details", "trash", deleteVoucher, "red")
                                )
                        );
                },
            });


            function createMenuItem(text, icon, clickHandler, iconColor) {
                return $("<li>")
                    .addClass("menu-item")
                    .append(
                        $("<i>")
                            .addClass("dx-icon dx-icon-" + icon)
                            .css({
                                color: iconColor,
                                "font-size": "18px",
                                "margin-right": "8px",
                            }),
                        $("<span>")
                            .text(text)
                            .css({
                                "font-size": "14px",
                                "font-weight": "bold",
                            })
                    )
                    .on("click", clickHandler)
                    .css({
                        padding: "10px 15px",
                        cursor: "pointer",
                        color: "#000",
                        "background-color": "#fff",
                        border: "1px solid #ddd",
                        "border-radius": "4px",
                        "margin-bottom": "5px",
                        "font-family": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
                        display: "flex",
                        "align-items": "center",
                        transition: "background-color 0.3s ease",
                    })
                    .hover(
                        function () {
                            $(this).css("background-color", "#f0f0f0");
                        },
                        function () {
                            $(this).css("background-color", "#fff");
                        }
                    );
            }


            function editVoucher() {
                if (!selectedVoucherId) {
                    alert("Please select a voucher to edit.");
                    return;
                }

                window.location.href = `/Finance/Asset?assetLedgerNo=${selectedVoucherId}`;
            }


            function deleteVoucher() {
                if (!selectedVoucherId) {
                    alert("Please select a voucher to delete.");
                    return;
                }

                if (confirm("Are you sure you want to delete this voucher?")) {

                    $.ajax({
                        url: `/AssetView/Delete/${selectedVoucherId}`,
                        type: "POST",
                        success: function (response) {
                            alert("Voucher deleted successfully.");

                        $("#dataGrid").dxDataGrid("instance").refresh();
                        },
                        error: function (xhr, status, error) {
                            console.error("Error deleting voucher:", error);
                            alert("An error occurred while deleting the voucher.");
                        },
                    });
                }
            }


            $("#dataGrid").dxDataGrid({
                selection: {
                    mode: "single",
                    showCheckBoxesMode: "none",
                },
                onSelectionChanged: function (e) {
                    const selectedRows = e.selectedRowsData;
                    if (selectedRows.length > 0) {
                        selectedVoucherId = selectedRows[0].AssetLedgerNo;
                    } else {
                        selectedVoucherId = null;
                    }
                },
            });


            $(document).on("click", ".dx-data-row", function (e) {
                $("#voucherPopup").dxPopup("instance").show();
            });


            $(document).on("click", function (e) {
                if (
                    !$(e.target).closest("#voucherPopup").length &&
                    !$(e.target).closest(".dx-data-row").length
                ) {
                    $("#voucherPopup").dxPopup("instance").hide();
                }
            });
        });
        function showDepreciationSchedule() {
            $("#DepreciationContent").load("/Finance/DepreciationMaster", function () {
                $("#DepreciationModal").modal('show');
                $(".close").on("click", function () {
                    $("#DepreciationModal").modal('hide');
                });


            });
        }

    </script>





