                                       }
                                       %>
                                       <div class="credit-pill">(<%- displayValue %>)</div>
                                   </text>);
                        



                group.Add().DataField("ClosingBalance").Caption(new JS("formatMessage('Trans ClosingBalance')")).Alignment(HorizontalAlignment.Right)
                .CellTemplate(@<text>                                                                                                                                                                                                    
