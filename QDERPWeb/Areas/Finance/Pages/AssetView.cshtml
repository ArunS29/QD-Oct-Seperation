                group.Add().DataField("InstallmentEndDate")
            .Caption(new JS("formatMessage('InstallmentEndDate')"))
            .DataType(GridColumnDataType.Date)
            .Format("dd-MMM-yyyy");
            });

        })


        .Summary(summary =>
        {

            summary.GroupItems(items =>
            {
                items.Add()
            .Column("AccountHead")
            .SummaryType(SummaryType.Count)
            .ShowInGroupFooter(true);

