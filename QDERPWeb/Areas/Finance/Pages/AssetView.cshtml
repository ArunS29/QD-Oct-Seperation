@page
@model QDWEB.Pages.Shared.GridforAssetViewModel
<link rel="stylesheet" href="~/css/animationCardFinance.css" />
<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }

    .dx-popup-content{
        padding: 5px;
    }
    .mainContainer {
        width: 100%;
        overflow-x: hidden;
    }

    .button-alignment-down {
        margin-bottom: 10px
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    .dx-datagrid {
        color: #000000;
    }

    .center-checkbox {
        display: block;
        margin-left: 0;
        margin-right: 0;
    }

    .dx-datagrid .dx-cell {
        display: flex;
        justify-content: center;
        align-items: center;
    }


    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    #DepreciationModal .modal-dialog.fullscreen {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1050; /* Ensures it stays on top */
        width: 100%;
        height: 100%;
        margin: 0;
        max-width: none;
        overflow: hidden;
    }

    #DepreciationModal .modal-content {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    #DepreciationModal .modal-body {
        flex: 1; /* Takes up remaining space */
        overflow-y: auto; /* Enables vertical scrolling */
        overflow-x: hidden; /* Disables horizontal scrolling */
        padding: 15px; /* Optional: Adjust padding to make it visually better */
    }

    #DepreciationModal .card {
        background-color: #ffffff !important;
        color: #fff;
        border: none;
        border-radius: 5px;
    }

    .wrap-text {
        white-space: normal !important;
        word-wrap: break-word;
        word-break: break-word;
    }

    #dataGrid .debit-pill, #dataGrid .credit-pill, #dataGrid .closing-pill, #dataGrid .depreciation-pill, #dataGrid .book-pill {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    #dataGrid .debit-pill {
        background: rgba(255, 77, 79, .15);
        color: #ff4d4f;
    }

    #dataGrid .closing-pill {
        background: rgba(255, 77, 79, .15);
        color: #ff4d4f;
    }


    #dataGrid .credit-pill {
        background: rgba(82, 196, 26, .15);
        color: #52c41a;
    }

    #dataGrid .depreciation-pill {
        background: rgba(255, 193, 7, 0.15); /* Light yellow background */
        color: #ffc107; /* Bootstrap yellow */
    }

    #dataGrid .book-pill {
        background: rgba(255, 193, 7, 0.15); /* Light yellow background */
        color: #ffc107; /* Bootstrap yellow */
    }

</style>
