<div id="DepreciationModal" class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog fullscreen" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <!-- Close Button -->
                <div class="close">&times;</div>
            </div>
            <div class="modal-body">
                <!-- Content will be loaded dynamically -->
                <div id="DepreciationContent"></div>
            </div>
        </div>
    </div>
</div>

<div>
    @await Html.PartialAsync("GridforAssetView")
</div>
<div id="voucherPopup"></div>
</div>
<script>
    $(function () {
        $("#AssetView").dxTextBox({
            text: formatMessage("Asset View"),
            readOnly: true,
            onContentReady: function(e) {
                $(e.element).addClass("dx-textbox-heading");
            }

        });

        let selectedVoucherId = null;

        $("#voucherPopup").dxPopup({
            width: 250,
            height: "auto",
            maxHeight: 300,
            visible: false,
            dragEnabled: true,
            closeOnOutsideClick: true,
            showTitle: false,
            contentTemplate: function () {
                return $("<div>")
                    .css({ overflow: "hidden" })
                    .append(
                        $("<ul>")
                            .addClass("voucher-actions")
                            .css({ "list-style": "none", margin: "0", padding: "0" })
                            .append(
                                createMenuItem(formatMessage("Edit Asset Details"), "edit", editVoucher, "black"),
                                createMenuItem(formatMessage("Delete Asset Details"), "trash", deleteVoucher, "red")
                            )
                    );
            },
        });

        function createMenuItem(text, icon, clickHandler, iconColor) {
            return $("<li>")
                .addClass("menu-item")
                .append(
                    $("<i>")
                        .addClass("dx-icon dx-icon-" + icon)
                        .css({ color: iconColor, "font-size": "18px", "margin-right": "8px" }),
                    $("<span>")
                        .text(text)
                        .css({ "font-size": "14px", "font-weight": "bold" })
                )
                .on("click", clickHandler)
                .css({
                    padding: "10px 15px",
                    cursor: "pointer",
                    color: "#000",
                    "background-color": "#fff",
                    border: "1px solid #ddd",
                    "border-radius": "4px",
                    "margin-bottom": "5px",
                    "font-family": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
                    display: "flex",
                    "align-items": "center",
                    transition: "background-color 0.3s ease",
                })
                .hover(
                    function () { $(this).css("background-color", "#f0f0f0"); },
                    function () { $(this).css("background-color", "#fff"); }
                );
        }

        function editVoucher() {
            if (!selectedVoucherId) {
                alert("Please select a voucher to edit.");
                return;
            }
            window.location.href = `/${tenantName}/Finance/Asset?assetLedgerNo=${selectedVoucherId}`;
        }
            function deleteVoucher() {
                if (!selectedVoucherId) {
                    DevExpress.ui.dialog.alert("Please select a Asset to delete.", "Warning");
                    return;
                }

                DevExpress.ui.dialog.confirm("Are you sure you want to delete this Asset?", "Confirm Deletion")
                    .done(function (dialogResult) {
                        if (dialogResult) {
                            $.ajax({
                                url: `/api/AssetView/Delete?assetLedgerNo=${encodeURIComponent(selectedVoucherId)}`,
                                type: "POST",
                                contentType: "application/json",
                                dataType: "json",
                                data: JSON.stringify({ assetLedgerNo: selectedVoucherId }),
                                success: function (response) {
                                    DevExpress.ui.dialog.alert(response.message || "Voucher deleted successfully.", "Success");
                                    $("#dataGrid").dxDataGrid("instance").refresh();
                                    injectHeaderSVG();
                                    injectCurrencyToCards();
                                },
                                error: function (xhr) {
                                    console.error("Error deleting voucher:", xhr.responseText);
                                    DevExpress.ui.dialog.alert(xhr.responseJSON?.message || "An error occurred while deleting the voucher.", "Error");
                                },
                            });
                        }
                    });
            }




        $("#dataGrid").dxDataGrid({
            selection: {
                mode: "single",
                showCheckBoxesMode: "none",
            },
            onSelectionChanged: function (e) {
                const selectedRows = e.selectedRowsData;
                if (selectedRows.length > 0) {
                    //selectedVoucherId = selectedRows[0].AssetLedgerNo;
                    selectedVoucherId = selectedRows[0].AccountId;
                } else {
                    selectedVoucherId = null;
                }
            },
        });
    $(document).on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault(); // Prevent default right-click menu

        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowIndex = $(this).index(); // Get the row index from DOM
        const rowData = dataGrid.getVisibleRows()[rowIndex]?.data;

        if (rowData) {
            //selectedVoucherId = rowData.AssetLedgerNo; // Set selected ID manually
            selectedVoucherId = rowData.AccountId;
            dataGrid.selectRowsByIndexes([rowIndex]); // Visually select the row
        }

        const popup = $("#voucherPopup").dxPopup("instance");
        popup.option("position", { my: "left top", at: "left bottom", of: e });
        popup.show();
    });

        $(document).on("click", function (e) {
            if (!$(e.target).closest("#voucherPopup").length && !$(e.target).closest(".dx-data-row").length) {
                $("#voucherPopup").dxPopup("instance").hide();
            }
        });
    });

    function showDepreciationSchedule() {
       window.location.href = `/${tenantName}/Finance/DepreciationMaster`;
    }
    function applyShowWhenGroupedToAllGroupedColumns(grid) {
        const columns = grid.getVisibleColumns();

        // Recursive function to handle nested columns
        function processColumns(cols) {
            cols.forEach((col) => {
                if (col.columns) {
                    processColumns(col.columns);
                } else if (col.groupIndex >= 0 && col.showWhenGrouped !== true) {
                    grid.columnOption(col.dataField, "showWhenGrouped", true);
                }
            });
        }

        processColumns(columns);
    }

    function onGridInitialized(e) {
        applyShowWhenGroupedToAllGroupedColumns(e.component);
          
    }

    function onGridOptionChanged(e) {
        if (e.fullName?.startsWith("columns") && e.fullName.endsWith("groupIndex")) {
            const grid = e.component;
            applyShowWhenGroupedToAllGroupedColumns(grid);
        }
    }
     function NewDepreciation() {
        window.location.href = `/${tenantName}/Finance/CreateDepreciation`;
    }


        function handleGridOptionChanged(e) {
        if (e.name === "columns" || e.name === "visible") {
            // Columns changed, so re-inject SVG
            injectHeaderSVG(); // slight delay to wait for DOM re-render
            injectCurrencyToCards();
        }
    }
      function injectHeaderSVG() {
            $.ajax({
                url: '/api/AccountingLedgers/GetCurrencyIcon',
                type: 'GET',
                success: function (response) {
                   
                    let svgIcon = response.Icon;
                    if (!svgIcon) return;

                    // Set default width/height for SVG if needed
                    if (svgIcon.startsWith("<svg")) {
                        svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);
                    } else {
                        // If symbol is text (e.g., "$" or "SAR"), wrap in styled span
                        svgIcon = `<span style="font-weight: bold;">${svgIcon}</span>`;
                    }

                    let $grid = $('#dataGrid');
                    let gridInstance = $grid.dxDataGrid("instance");
                    if (!gridInstance) return;

                    $grid.find(".dx-header-row td").each(function () {
                        const $cell = $(this);

                            const $debitHeader = $(".debit-header");
                            const debitText = $debitHeader.data("original-text") || $debitHeader.text().trim();
                            $debitHeader.data("original-text", debitText); // Save original once

                            $debitHeader.html(`
                                <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                    ${svgIcon}
                                    <span style="font-weight: bold;">${debitText}</span>
                                </div>
                            `);

                            // 👉 Credit
                            const $creditHeader = $(".credit-header");
                            const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                            $creditHeader.data("original-text", creditText);

                            $creditHeader.html(`
                                <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                    ${svgIcon}
                                    <span style="font-weight: bold;">${creditText}</span>
                                </div>
                            `);


                            const $closingHeader = $(".closing-header");
                            const closingText = $closingHeader.data("original-text") || $closingHeader.text().trim();
                            $closingHeader.data("original-text", closingText);

                            $closingHeader.html(`
                                <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                    ${svgIcon}
                                    <span style="font-weight: bold;">${closingText}</span>
                                </div>
                            `);




                            const $depreciationHeader = $(".depreciation-header");
                            const depreciationText = $depreciationHeader.data("original-text") || $depreciationHeader.text().trim();
                            $depreciationHeader.data("original-text", depreciationText);

                            $depreciationHeader.html(`
                                <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                    ${svgIcon}
                                    <span style="font-weight: bold;">${depreciationText}</span>
                                </div>
                            `);




                            const $bookHeader = $(".book-header");
                            const bookText = $bookHeader.data("original-text") || $bookHeader.text().trim();
                            $bookHeader.data("original-text", bookText);

                            $bookHeader.html(`
                                <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                    ${svgIcon}
                                    <span style="font-weight: bold;">${bookText}</span>
                                </div>
                            `);


                    });
                },
                error: function (xhr) {
                    console.error("Failed to load currency icon:", xhr.responseText);
                }
            });
      }

        function injectCurrencyToCards() {
            $.ajax({
                url: "/api/AccountingLedgers/GetCurrencyIcon",
                method: "GET",
                success: function (response) {
                    
                    if (!response || !response.Icon) return;

                    const icon = response.Icon.trim();



                    // Inject into Debit
                    $('#cardDebit .value-slider span').each(function () {
                        $(this).html(icon + $(this).text().trim().replace(icon, ''));
                    });

                    // Inject into Credit
                    $('#cardCredit .value-slider span').each(function () {
                        $(this).html(icon + $(this).text().trim().replace(icon, ''));
                    });
                },
                error: function (err) {
                    console.error("Failed to load currency icon:", err);
                }
            });
        }

    function handleGridContentReady(e){

          injectHeaderSVG();
           injectCurrencyToCards();
            e.component.getDataSource().store().load().then(function (fullData) {
                updateCards(fullData);
            });
             
    }
   function updateCards(data) {
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const thisWeekStart = new Date(today);
        thisWeekStart.setDate(today.getDate() - today.getDay());
        const thisMonthStart = new Date(today.getFullYear(), today.getMonth(), 1);

        let totalConvertedDepreciated = 0;
        let totalConvertedCredit = 0;
        let totalConvertedDebit = 0;

        const groupCount = {};

        data.forEach(item => {
            totalConvertedDepreciated += parseFloat(item.ConvertedDepreciatedAmount || 0);
            totalConvertedCredit += parseFloat(item.ConvertedTotalCredit || 0);
            totalConvertedDebit += parseFloat(item.ConvertedTotalDebit || 0);

            const group = item.AccountGroup || "Unknown";
            groupCount[group] = (groupCount[group] || 0) + 1;
        });

         const format = num => num.toLocaleString(undefined, {
             minimumFractionDigits: 2,
             maximumFractionDigits: 2
         });

        // === Card Debit: Show Depreciated, Credit, Debit ===
          $("#cardDebit .value-slider span").eq(0).html(format(totalConvertedDepreciated));
          $("#cardDebit .value-slider span").eq(1).html(format(totalConvertedCredit));
          $("#cardDebit .value-slider span").eq(2).html(format(totalConvertedDebit));
            $("#cardDebit .overlay .detail").eq(0).html(`Depreciated: ${format(totalConvertedDepreciated)}`);
           $("#cardDebit .overlay .detail").eq(1).html(`Credit: ${format(totalConvertedCredit)}`);
           $("#cardDebit .overlay .detail").eq(2).html(`Debit: ${format(totalConvertedDebit)}`);
        // const debitOverlay = $("#cardDebit .overlay");
        // debitOverlay.children().eq(0).html(`Depreciated: ${format(totalConvertedDepreciated)}`);
        // debitOverlay.children().eq(1).html(`Credit: ${format(totalConvertedCredit)}`);
        // debitOverlay.children().eq(2).html(`Debit: ${format(totalConvertedDebit)}`);

        // === Card Credit: Top 3 Majority Used AccountGroup Names ===
        const topGroups = Object.entries(groupCount)
            .sort((a, b) => b[1] - a[1])  // sort by count desc
            .slice(0, 3);  // top 3

        const creditSlider = $("#cardCredit .value-slider");
        const creditOverlay = $("#cardCredit .overlay");

           creditSlider.each(function (i) {
                if (topGroups[i]) {
                    const [groupName, count] = topGroups[i];
                    $(this).html(`<strong>${groupName} (${count})</strong>`);
                } else {
                    $(this).html(""); // Clear extra slots
                }
            });


        creditOverlay.children().each(function (i) {
            if (topGroups[i]) {
                const [groupName, count] = topGroups[i];
                $(this).html(` ${groupName} (${count})`);
            } else {
                $(this).html("");
            }

        });
             // === Card Voucher: Total/Month/Year Asset Count by PurchaseDate ===
     let totalAssets = 0;
     let thisMonthCount = 0;
     let thisYearCount = 0;

     data.forEach(item => {
         const accountId = item.AccountId;
         const purchaseDate = new Date(item.PurchaseDate);

         if (accountId) {
             totalAssets++;

             if (purchaseDate.getFullYear() === now.getFullYear()) {
                 thisYearCount++;

                 if (purchaseDate.getMonth() === now.getMonth()) {
                     thisMonthCount++;
                 }
             }
         }
     });

     // Update cardVoucher value-slider spans
     const voucherSlider = $("#cardVoucher .value-slider span");
      voucherSlider.eq(0).html(`<i class="fa-solid fa-truck"></i> ${totalAssets}`);
     voucherSlider.eq(1).html(`<i class="fa-solid fa-truck"></i> ${thisMonthCount}`);
     voucherSlider.eq(2).html(`<i class="fa-solid fa-truck"></i> ${thisYearCount}`);

     // Update cardVoucher overlay details
     const voucherOverlay = $("#cardVoucher .overlay .detail");
      voucherOverlay.eq(0).html(`<i class="fa-solid fa-truck"></i> Total: ${totalAssets}`);
     voucherOverlay.eq(1).html(`<i class="fa-solid fa-truck"></i> This Month: ${thisMonthCount}`);
      voucherOverlay.eq(2).html(`<i class="fa-solid fa-truck"></i> This Year: ${thisYearCount}`);


       injectCurrencyToCards();

   }

    // Utility format function
    function format(value) {
        return value.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }






        // Utility: check if two dates are the same (ignoring time)
        function isSameDate(d1, d2) {
            return d1.getFullYear() === d2.getFullYear() &&
                   d1.getMonth() === d2.getMonth() &&
                   d1.getDate() === d2.getDate();
        }
            $(function () {
                 $("#Assetview").text(formatMessage("Journal Register"));
    });
    $(function () {
        $("#QuickDiceERPSolutions6").text(formatMessage("Quick Dice ERP Solutions"));
    });
    $(function () {
              $("#Totalassets").text(formatMessage("Total Assets"));
    });
    $(function () {
          $("#Totaldepreciated").text(formatMessage("Total Depreciated"));
    });
    $(function () {
         $("#Topassets").text(formatMessage("Top Assets"));
    });

</script>





