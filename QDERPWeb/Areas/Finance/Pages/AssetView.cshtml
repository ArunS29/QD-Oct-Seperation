                items.Add()
            .Column("NetBookValue")
            .SummaryType(SummaryType.Sum)
            .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                items.Add()
            .Column("ValueOfProperty")
            .SummaryType(SummaryType.Sum)
            .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
            });
        })
        .ColumnChooser(columnChooser => columnChooser.Enabled(false).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.DragAndDrop))

        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(false))
        .ColumnResizingMode(ColumnResizingMode.Widget)
        .Height("65vh")
        .ColumnAutoWidth(true)
        .Paging(p => p.Enabled(true).PageSize(15))    // enable paging with 15 rows per page
        .Pager(pager => pager
        .Visible(true)                            // show pager UI (page numbers etc)
        .ShowPageSizeSelector(true)              // allow user to change page size
        .AllowedPageSizes(new[] { 10, 15, 20 })  // optional page size options
        .ShowInfo(true)                          // show info like "Page 1 of 10"
        )

        .FilterRow(filterRow => filterRow.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .OnInitialized("onGridInitialized")
        .OnOptionChanged("onGridOptionChanged")
        .OnOptionChanged("handleGridOptionChanged")
        .OnContentReady("function(e) { handleGridContentReady(e); }")
        .Width("100%")
        )
</div>
