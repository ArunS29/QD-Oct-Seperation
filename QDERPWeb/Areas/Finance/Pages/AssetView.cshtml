                group.Add().DataField("AccountHead").Caption(new JS("formatMessage('AccountHead')"));
                group.Add().DataField("AssetDescription").Caption(new JS("formatMessage('AssetDescription')"));
                group.Add().DataField("Specifications").Caption(new JS("formatMessage('Specifications')")).CssClass("wrap-text");
                group.Add().DataField("AccountGroup").Caption(new JS("formatMessage('AccountGroup')")).GroupIndex(0); ;
                group.Add().DataField("PropertyNo").Caption(new JS("formatMessage('PropertyNo')"));

            });

            columns.Add().Caption(new JS("formatMessage('DepreciationDetails')")).Columns(group =>
            {
                group.Add().DataField("DepreciationMethod").Caption(new JS("formatMessage('DepreciationMethod')"));
