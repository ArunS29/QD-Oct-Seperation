                            <%- data.TotalDebit != null ? data.TotalDebit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00" %>
                            </div>
                         </text>                                                                                                                                                                                                                                
                    ).Visible(false);

                        group.Add().DataField("ConvertedTotalDebit").Caption(new JS("formatMessage('TotalDebit')")).Alignment(HorizontalAlignment.Right)
                 .HeaderCellTemplate(@<text>
                                     <div class='debit-header' style='font-weight: bold;'>
                                         <%= column.caption %>
                                     </div>
                                 </text>
        )
                    .CellTemplate(@<text>
                                       <%
                                       var val = data.ConvertedTotalDebit;
                                       let displayValue;
