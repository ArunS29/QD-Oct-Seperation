                                       let positive = Math.abs(val);
                                       displayValue = positive.toLocaleString(undefined, {
                                       minimumFractionDigits: 2,
                                       maximumFractionDigits: 2
                                       });
                                       } else {
                                       displayValue = "0.00";
                                       }
                                       %>
                                       <div class="debit-pill">(<%- displayValue %>)</div>
                                   </text>);
                        

      group.Add()
