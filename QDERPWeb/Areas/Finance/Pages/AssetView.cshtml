                    ).Visible(false);

                      group.Add().DataField("ConvertedClosingBalance").Caption(new JS("formatMessage('ClosingBalance')")).Alignment(HorizontalAlignment.Right)
                      .HeaderCellTemplate(@<text>
                                     <div class='closing-header' style='font-weight: bold;'>
