<div id="voucherPopup"></div>
</div>
<script>
    $(function () {
        $("#AssetView").dxTextBox({
            text: formatMessage("Asset View"),
            readOnly: true,
            onContentReady: function(e) {
                $(e.element).addClass("dx-textbox-heading");
            }

        });

        let selectedVoucherId = null;

        $("#voucherPopup").dxPopup({
            width: 250,
            height: "auto",
            maxHeight: 300,
            visible: false,
            dragEnabled: true,
            closeOnOutsideClick: true,
            showTitle: false,
            contentTemplate: function () {
                return $("<div>")
                    .css({ overflow: "hidden" })
                    .append(
                        $("<ul>")
                            .addClass("voucher-actions")
                            .css({ "list-style": "none", margin: "0", padding: "0" })
                            .append(
                                createMenuItem(formatMessage("Edit Asset Details"), "edit", editVoucher, "black"),
                                createMenuItem(formatMessage("Delete Asset Details"), "trash", deleteVoucher, "red")
                            )
                    );
            },
        });

        function createMenuItem(text, icon, clickHandler, iconColor) {
            return $("<li>")
                .addClass("menu-item")
                .append(
                    $("<i>")
                        .addClass("dx-icon dx-icon-" + icon)
                        .css({ color: iconColor, "font-size": "18px", "margin-right": "8px" }),
                    $("<span>")
                        .text(text)
                        .css({ "font-size": "14px", "font-weight": "bold" })
                )
                .on("click", clickHandler)
                .css({
                    padding: "10px 15px",
                    cursor: "pointer",
                    color: "#000",
                    "background-color": "#fff",
                    border: "1px solid #ddd",
                    "border-radius": "4px",
                    "margin-bottom": "5px",
                    "font-family": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
                    display: "flex",
                    "align-items": "center",
                    transition: "background-color 0.3s ease",
                })
                .hover(
                    function () { $(this).css("background-color", "#f0f0f0"); },
                    function () { $(this).css("background-color", "#fff"); }
                );
        }

        function editVoucher() {
            if (!selectedVoucherId) {
                alert("Please select a voucher to edit.");
                return;
            }
            window.location.href = `/${tenantName}/Finance/Asset?assetLedgerNo=${selectedVoucherId}`;
        }
            function deleteVoucher() {
                if (!selectedVoucherId) {
                    DevExpress.ui.dialog.alert("Please select a Asset to delete.", "Warning");
                    return;
                }

                DevExpress.ui.dialog.confirm("Are you sure you want to delete this Asset?", "Confirm Deletion")
                    .done(function (dialogResult) {
                        if (dialogResult) {
                            $.ajax({
                                url: `/api/AssetView/Delete?assetLedgerNo=${encodeURIComponent(selectedVoucherId)}`,
                                type: "POST",
                                contentType: "application/json",
                                dataType: "json",
                                data: JSON.stringify({ assetLedgerNo: selectedVoucherId }),
                                success: function (response) {
                                    DevExpress.ui.dialog.alert(response.message || "Voucher deleted successfully.", "Success");
                                    $("#dataGrid").dxDataGrid("instance").refresh();
                                    injectHeaderSVG();
                                },
                                error: function (xhr) {
                                    console.error("Error deleting voucher:", xhr.responseText);
                                    DevExpress.ui.dialog.alert(xhr.responseJSON?.message || "An error occurred while deleting the voucher.", "Error");
                                },
                            });
                        }
                    });
            }




        $("#dataGrid").dxDataGrid({
            selection: {
                mode: "single",
                showCheckBoxesMode: "none",
            },
            onSelectionChanged: function (e) {
                const selectedRows = e.selectedRowsData;
                if (selectedRows.length > 0) {
                    //selectedVoucherId = selectedRows[0].AssetLedgerNo;
                    selectedVoucherId = selectedRows[0].AccountId;
                } else {
                    selectedVoucherId = null;
                }
            },
        });
    $(document).on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault(); // Prevent default right-click menu

        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowIndex = $(this).index(); // Get the row index from DOM
        const rowData = dataGrid.getVisibleRows()[rowIndex]?.data;

        if (rowData) {
            //selectedVoucherId = rowData.AssetLedgerNo; // Set selected ID manually
            selectedVoucherId = rowData.AccountId;
            dataGrid.selectRowsByIndexes([rowIndex]); // Visually select the row
        }

        const popup = $("#voucherPopup").dxPopup("instance");
        popup.option("position", { my: "left top", at: "left bottom", of: e });
        popup.show();
    });

        $(document).on("click", function (e) {
            if (!$(e.target).closest("#voucherPopup").length && !$(e.target).closest(".dx-data-row").length) {
                $("#voucherPopup").dxPopup("instance").hide();
            }
        });
    });

    function showDepreciationSchedule() {
       window.location.href = `/${tenantName}/Finance/DepreciationMaster`;
    }
    function applyShowWhenGroupedToAllGroupedColumns(grid) {
        const columns = grid.getVisibleColumns();

        // Recursive function to handle nested columns
        function processColumns(cols) {
            cols.forEach((col) => {
                if (col.columns) {
                    processColumns(col.columns);
                } else if (col.groupIndex >= 0 && col.showWhenGrouped !== true) {
                    grid.columnOption(col.dataField, "showWhenGrouped", true);
                }
            });
        }

        processColumns(columns);
    }

    function onGridInitialized(e) {
        applyShowWhenGroupedToAllGroupedColumns(e.component);
    }

    function onGridOptionChanged(e) {
        if (e.fullName?.startsWith("columns") && e.fullName.endsWith("groupIndex")) {
            const grid = e.component;
            applyShowWhenGroupedToAllGroupedColumns(grid);
        }
    }
     function NewDepreciation() {
        window.location.href = `/${tenantName}/Finance/CreateDepreciation`;
    }


        function handleGridOptionChanged(e) {
        if (e.name === "columns" || e.name === "visible") {
            // Columns changed, so re-inject SVG
            injectHeaderSVG(); // slight delay to wait for DOM re-render
        }
    }
    function injectHeaderSVG() {
         debugger;
           let gridElement = $('#dataGrid');
    let dataGrid = gridElement.dxDataGrid("instance");
    if (!dataGrid) return;

    // Get grouped data (with .items containing groups)
    let groupedData = dataGrid.getDataSource()?.items();
    if (!groupedData || groupedData.length === 0) return;

    // Get the first row from the first group
    let firstGroup = groupedData[0];
    let firstRowInGroup = firstGroup?.items?.[0];

    let svgIcon = firstRowInGroup?.CurrencyImage;
        if (!svgIcon) return;

        svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);

        gridElement.find(".dx-header-row td").each(function () {

            const $cell = $(this);
            const dataField = $cell.attr("data-field");  // 👈 This is key

                const $debitHeader = $(".debit-header");
                const debitText = $debitHeader.data("original-text") || $debitHeader.text().trim();
                $debitHeader.data("original-text", debitText); // Save original once

                $debitHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${debitText}</span>
                    </div>
                `);

                // 👉 Credit
                const $creditHeader = $(".credit-header");
                const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                $creditHeader.data("original-text", creditText);

                $creditHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${creditText}</span>
                    </div>
                `);


                const $closingHeader = $(".closing-header");
                const closingText = $closingHeader.data("original-text") || $closingHeader.text().trim();
                $closingHeader.data("original-text", closingText);

                $closingHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${closingText}</span>
                    </div>
                `);




                const $depreciationHeader = $(".depreciation-header");
                const depreciationText = $depreciationHeader.data("original-text") || $depreciationHeader.text().trim();
                $depreciationHeader.data("original-text", depreciationText);

                $depreciationHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${depreciationText}</span>
                    </div>
                `);




                const $bookHeader = $(".book-header");
                const bookText = $bookHeader.data("original-text") || $bookHeader.text().trim();
                $bookHeader.data("original-text", bookText);

                $bookHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${bookText}</span>
                    </div>
                `);


        });
    }

    function handleGridContentReady(e){

          injectHeaderSVG();


    }
         function updateCards(data) {
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const thisWeekStart = new Date(today);
        thisWeekStart.setDate(today.getDate() - today.getDay());
        const thisMonthStart = new Date(today.getFullYear(), today.getMonth(), 1);
        const thisYearStart = new Date(today.getFullYear(), 0, 1);

        let totalDr = 0, totalCr = 0;
        let todayDr = 0, weekDr = 0, monthDr = 0, yearDr = 0;
        let todayCr = 0, weekCr = 0, monthCr = 0, yearCr = 0;

        const uniqueVoucherToday = new Set();
        const uniqueVoucherWeek = new Set();
        const uniqueVoucherMonth = new Set();
        const uniqueVoucherYear = new Set();

        data.forEach(item => {
            if (!item.PurchaseDate) return;

            const voucherDate = new Date(item.PurchaseDate);
            const dateOnly = new Date(voucherDate.getFullYear(), voucherDate.getMonth(), voucherDate.getDate());

            const dr = parseFloat(item.ValueOfProperty || 0);
            const cr = parseFloat(item.CreditAmount || 0);

            totalDr += dr;
            totalCr += cr;

            const voucherNo = item.ClaimRefNo;

            if (+dateOnly === +today) {
                todayDr += dr;
                todayCr += cr;
                if (voucherNo) uniqueVoucherToday.add(voucherNo);
            }

            if (dateOnly >= thisWeekStart && dateOnly <= today) {
                weekDr += dr;
                weekCr += cr;
                if (voucherNo) uniqueVoucherWeek.add(voucherNo);
            }

            if (dateOnly >= thisMonthStart && dateOnly <= today) {
                monthDr += dr;
                monthCr += cr;
                if (voucherNo) uniqueVoucherMonth.add(voucherNo);
            }

            if (dateOnly >= thisYearStart && dateOnly <= today) {
                yearDr += dr;
                yearCr += cr;
                if (voucherNo) uniqueVoucherYear.add(voucherNo);
            }
        });

        const format = num => num.toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        // ========== Update Total Debit Card ==========
        $("#cardDebit .value-slider span").eq(0).html(format(todayDr));
        $("#cardDebit .value-slider span").eq(1).html(format(weekDr));
        $("#cardDebit .value-slider span").eq(2).html(format(monthDr));
        if ($("#cardDebit .value-slider span").length < 4) {
            $("#cardDebit .value-slider").append(`<span>${format(yearDr)}</span>`);
        } else {
            $("#cardDebit .value-slider span").eq(3).html(format(yearDr));
        }

        $("#cardDebit .overlay .detail").eq(0).html(`Today: ${format(todayDr)}`);
        $("#cardDebit .overlay .detail").eq(1).html(`This Week: ${format(weekDr)}`);
        $("#cardDebit .overlay .detail").eq(2).html(`This Month: ${format(monthDr)}`);
        if ($("#cardDebit .overlay .detail").length < 4) {
            $("#cardDebit .overlay").append(`<div class="detail">This Year: ${format(yearDr)}</div>`);
        } else {
            $("#cardDebit .overlay .detail").eq(3).html(`This Year: ${format(yearDr)}`);
        }

        // ========== Update Total Credit Card ==========
        $("#cardCredit .value-slider span").eq(0).html(format(todayCr));
        $("#cardCredit .value-slider span").eq(1).html(format(weekCr));
        $("#cardCredit .value-slider span").eq(2).html(format(monthCr));
        if ($("#cardCredit .value-slider span").length < 4) {
            $("#cardCredit .value-slider").append(`<span>${format(yearCr)}</span>`);
        } else {
            $("#cardCredit .value-slider span").eq(3).html(format(yearCr));
        }

        $("#cardCredit .overlay .detail").eq(0).html(`Today: ${format(todayCr)}`);
        $("#cardCredit .overlay .detail").eq(1).html(`This Week: ${format(weekCr)}`);
        $("#cardCredit .overlay .detail").eq(2).html(`This Month: ${format(monthCr)}`);
        if ($("#cardCredit .overlay .detail").length < 4) {
            $("#cardCredit .overlay").append(`<div class="detail">This Year: ${format(yearCr)}</div>`);
        } else {
            $("#cardCredit .overlay .detail").eq(3).html(`This Year: ${format(yearCr)}`);
        }

        // ========== Voucher Summary Helper ==========
        function getVoucherStatus(voucherSet, startDate, endDate) {
            let approved = 0, posted = 0;
            voucherSet.forEach(voucherNo => {
                const filtered = data.filter(item =>
                    item.ClaimRefNo === voucherNo &&
                    item.ClaimDate &&
                    new Date(item.ClaimDate) >= startDate &&
                    new Date(item.ClaimDate) <= endDate
                );
                if (filtered.some(x => x.IsApproved)) approved++;
                if (filtered.some(x => x.IsPaid)) posted++;
            });
            return {
                total: voucherSet.size,
                approved,
                posted
            };
        }

        const todayStatus = getVoucherStatus(uniqueVoucherToday, today, today);
        const weekStatus = getVoucherStatus(uniqueVoucherWeek, thisWeekStart, today);
        const monthStatus = getVoucherStatus(uniqueVoucherMonth, thisMonthStart, today);
        const yearStatus = getVoucherStatus(uniqueVoucherYear, thisYearStart, today);

        let totalCount = 0, approvedCount = 0, postedCount = 0;
        const countedVouchers = new Set();

        data.forEach(item => {
            if (!item.ClaimRefNo) return;
            totalCount++;
            if (!countedVouchers.has(item.ClaimRefNo)) {
                const matching = data.filter(x => x.ClaimRefNo === item.ClaimRefNo);
                if (matching.some(x => x.IsApproved)) approvedCount++;
                if (matching.some(x => x.IsPaid)) postedCount++;
                countedVouchers.add(item.ClaimRefNo);
            }
        });

        // ========== Update Voucher Card ==========
        const icon = `<i class="fa-solid fa-truck-ramp-box"></i>`;
        const vs = $("#cardVoucher .value-slider");
        vs.children().eq(0).html(`${icon} Today: ${todayStatus.total}`);
        vs.children().eq(1).html(`${icon} This Week: ${weekStatus.total}`);
        vs.children().eq(2).html(`${icon} This Month: ${monthStatus.total}`);
        if (vs.children().length < 4) {
            vs.append(`<span>${icon} This Year: ${yearStatus.total}</span>`);
        } else {
            vs.children().eq(3).html(`${icon} This Year: ${yearStatus.total}`);
        }

        const ov = $("#cardVoucher .overlay");
        ov.children().eq(0).html(`${icon} Total: ${totalCount}`);
        ov.children().eq(1).html(`${icon} Approved: ${approvedCount}`);
        ov.children().eq(2).html(`${icon} Paid: ${postedCount}`);
        if (ov.children().length < 4) {
            ov.append(`<div class="detail">${icon} This Year: ${yearStatus.total}</div>`);
        } else {
            ov.children().eq(3).html(`${icon} This Year: ${yearStatus.total}`);
        }
    }




        // Utility: check if two dates are the same (ignoring time)
        function isSameDate(d1, d2) {
            return d1.getFullYear() === d2.getFullYear() &&
                   d1.getMonth() === d2.getMonth() &&
                   d1.getDate() === d2.getDate();
        }
</script>





