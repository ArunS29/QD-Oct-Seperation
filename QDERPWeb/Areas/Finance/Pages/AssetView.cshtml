 *@
                group.Add().DataField("ScrapValueOfProperty")
.Caption(new JS("formatMessage('ScrapValue')"))
.Alignment(HorizontalAlignment.Right)
.CustomizeText("function(e) { return (e.value || 0).toFixed(2); }");
