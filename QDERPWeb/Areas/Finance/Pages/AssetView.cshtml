                        </div>
                    </text>
                    )
    .Visible(false); // Make it visible to test output



               group.Add()
    .DataField("ConvertedTotalCredit")
    .Caption(new JS("formatMessage('TotalCredit')"))
    .Alignment(HorizontalAlignment.Right)
    .HeaderCellTemplate(@<text>
                                             <div class='credit-header' style='font-weight: bold;'>
            <%= column.caption %>
        </div>
    </text>)
