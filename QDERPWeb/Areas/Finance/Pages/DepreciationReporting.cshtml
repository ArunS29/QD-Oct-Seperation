@page
@model QD.ERP.Web.Areas.Finance.Pages.DepreciationReportingModel
@{
}
<style>
    .pivot-row-total {
        background-color: royalblue !important;
        color: white !important;
        font-weight: bold;
    }

    .pivot-grand-total {
        background-color: royalblue !important;
        color: white !important;
        font-weight: bold;
    }

    .titleCard-toggle1 {
        display: none;
    }
</style>

<div class="dx-fieldset horizontal-container" style="margin-bottom: 0px;display: flex;align-items: baseline;">


    @(Html.DevExtreme().DateBox()

        .ID("StartDate")

        .Type(DateBoxType.Date)
        .DisplayFormat("dd-MMM-yyyy")

        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
        )


    @(Html.DevExtreme().DateBox()

        .ID("EndDate")

        .Type(DateBoxType.Date)
        .DisplayFormat("dd-MMM-yyyy")

        .Value(DateTime.Now))

    @(Html.DevExtreme().DropDownButton()
        .ID("ddBtnShowRecords")
        .Text(new JS("formatMessage('Show Records')"))
        .Icon("smalliconslayout")
        .Width(180)

        .TabIndex(4)
        .DropDownOptions(options => options.Width(230))
        .SplitButton(true)
        .OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }")
        .Items(items =>
        {
            items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").Option("color", "#4285F4").OnClick("function() { ddBtnShowRecords_click('range'); }");
            items.Add().Text(new JS("formatMessage('Today')")).Icon("event").Option("color", "#34A853").OnClick("function() { ddBtnShowRecords_click('today'); }");
            items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").Option("color", "#EA4335").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
            items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").Option("color", "#FBBC05").OnClick("function() { ddBtnShowRecords_click('week'); }");
            items.Add().Text(new JS("formatMessage('This Month Till Date')")).Option("color", "#AB47BC").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
            items.Add().Text(new JS("formatMessage('This Month (Full)')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
            items.Add().Text(new JS("formatMessage('This Year Till Date')")).Option("color", "#FF7043").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
            items.Add().Text(new JS("formatMessage('This Year (Full)')")).Option("color", "#4285F4").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
            items.Add().Text(new JS("formatMessage('Last Month')")).Option("color", "#FBBC05").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
            items.Add().Text(new JS("formatMessage('Last Year')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
        })
        .ItemTemplate(@<text>
        <div class="custom-dropdown-item">
            <div style="background-color:<%- color %>;height:90%" class="side-bar"></div>
            <div class="item-content">
                <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                <div>
                    <div class="item-title"><%- text %></div>
                </div>
            </div>
        </div>
    </text>)
        )

</div>
<div class="dx-field ledgerResult">  

    <div id="pivotGrid"></div>

    @section Scripts {
        <script>
            $(function () {
                $("#pivotGrid").dxPivotGrid({
                    allowSortingBySummary: true,
                    allowFiltering: true,
                    showBorders: true,
                    height: 500,
                    wordWrapEnabled: true,
                    showRowTotals: true,
                    showColumnTotals: true,
                    showRowGrandTotals: true,
                    showColumnGrandTotals: true,

                    fieldChooser: {
                        enabled: true,
                        allowSearch: true,
                        layout: 0
                    },
                    scrolling: {
                        mode: "virtual"
                    },
                    fieldPanel: {
                        visible: true,
                        allowFieldDragging: true,
                        showColumnFields: true,
                        showDataFields: true,
                        showFilterFields: true,
                        showRowFields: true
                    },
                    loadPanel: { enabled: true },

                    dataSource: {
                        fields: [
                            { dataField: "AccountGroup", caption: formatMessage("Account Group"), area: "row", expanded: true },
                            { dataField: "AssetLedgerNo", caption: formatMessage("Ledger No"), area: "row", expanded: true, showTotals: false },
                            { dataField: "AccountHead", caption: formatMessage("Fixed Asset Ledger"), area: "row", expanded: true, showTotals: false },
                            { dataField: "Months", caption: formatMessage("Month(s)"), area: "column" },
                            {
                                dataField: "AccDeprTotalAmount",
                                caption: formatMessage("Accumulated Depreciation"),
                                area: "data",
                                summaryType: "sum",
                                dataType: "number",
                                format: { type: "fixedPoint", precision: 2 }
                            }
                        ],
                        store: DevExpress.data.AspNet.createStore({
                            key: "DepreciationDocNo",
                            loadUrl: "/api/DepreciationMaster/GetDepreciationPivotData"
                        })
                    },

                        onCellPrepared: function (e) {
                            if (e.area === "data") {
                                const isRowTotal = e.rowType === "T";
                                const isRowGrandTotal = e.rowType === "GT";
                                const isColGrandTotal = e.columnType === "GT";

                                // ✅ Row Total (only at AccountGroup level)
                                if (isRowTotal && e.rowPath.length === 1) {
                                    e.cellElement.addClass("pivot-row-total");
                                }

                                // ✅ Grand Total in data cells (either row or column GT)
                                if (isRowGrandTotal || isColGrandTotal) {
                                    e.cellElement.addClass("pivot-grand-total");
                                }
                            }

                            // ✅ Grand Total labels (header cells)
                            if ((e.area === "row" || e.area === "column") && e.cell?.type === "GT") {
                                e.cellElement.addClass("pivot-grand-total");
                            }
                        }



                });
            });
        </script>

    }



</div>
<script>
    function ddBtnShowRecords_click(filterType) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");

        const today = new Date();
        let startDate = null, endDate = null;


        switch (filterType) {
            case 'today':
                startDate = new Date(today.setHours(0, 0, 0, 0));
                endDate = new Date(today.setHours(23, 59, 59, 999));
                break;

            case 'yesterday':
                startDate = new Date(today);
                startDate.setDate(today.getDate() - 1);
                startDate.setHours(0, 0, 0, 0);
                endDate = new Date(startDate);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'week':
                startDate = new Date(today);
                startDate.setDate(today.getDate() - today.getDay());
                startDate.setHours(0, 0, 0, 0);
                endDate = new Date(startDate);
                endDate.setDate(startDate.getDate() + 6);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'lastmonth':
                startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'lastyear':
                startDate = new Date(today.getFullYear() - 1, 0, 1);
                endDate = new Date(today.getFullYear() - 1, 11, 31);
                endDate.setHours(23, 59, 59, 999);
                break;

            default:

                dataGrid.option("dataSource", {
                    load: function () {
                        return $.ajax({
                            url: "/api/ExpensesClaim/GetExpensesClaims",
                            type: "GET"
                        });
                    }
                });
                dataGrid.refresh();
                return;
        }

        if (startDate && endDate) {

            $("#VoucherDate").dxDateBox("instance").option("value", startDate);
            $("#EffectiveDate").dxDateBox("instance").option("value", endDate);


            dataGrid.option("dataSource", {
                load: function () {
                    return $.ajax({
                        url: "/api/ExpensesClaim/GetExpensesClaims",
                        data: {
                            startDate: startDate.toISOString(),
                            endDate: endDate.toISOString()
                        },
                        type: "GET"
                    });
                }
            });


            dataGrid.refresh();
        }
    }
    

</script>
