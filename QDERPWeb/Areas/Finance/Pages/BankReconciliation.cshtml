<script>

            let LastAmt = 0;
            let FirstAmt = 0;


      function formatVoucherDate(data) {
        if (!data.VoucherDate) return "";
        var date = new Date(data.VoucherDate);
        return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }
        

    $(function () {

										$("#BankReconciliation").dxTextBox({
													text:formatMessage("Bank Reconciliation"),
