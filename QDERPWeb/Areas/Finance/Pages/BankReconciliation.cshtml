// Function to format date as dd-MMM-yyyy
function formatDate(date) {
    var d = new Date(date);
    if (isNaN(d.getTime())) return ""; // Handle invalid date

    var day = d.getDate().toString().padStart(2, '0'); // Get day and ensure 2 digits
    var month = d.toLocaleString('en-US', { month: 'short' }); // Get short month name (e.g., Feb)
    var year = d.getFullYear(); // Get full year

    return `${day}-${month}-${year}`;
}
       $(document).ready(function () {
        function getQueryParam(name) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(name);
        }

        const acchedid = getQueryParam("acchedid");
        const accheadname = getQueryParam("accheadname");
        const accid = getQueryParam("accid");
        const FromDate = getQueryParam("FromDate");
        const ToDate = getQueryParam("ToDate");
        const lastRowBalance = getQueryParam("lastRowBalance") || "0";
        const cleanedBalanceLR = lastRowBalance.replace(/[^0-9.-]/g, "");
        const lastRowBalanceVal = parseFloat(cleanedBalanceLR) || 0;

        const firstRowBalance = getQueryParam("firstRowBalance") || "0";
        const cleanedBalanceFR = firstRowBalance.replace(/[^0-9.-]/g, "");
        const firstRowBalanceVal = parseFloat(cleanedBalanceFR) || 0;

        const balanceOurBooksInstance = $("#BalanceAsPerOurBooks").dxTextBox("instance");
        const balanceBankStatementInstance = $("#BalanceAsPerBankStatement").dxTextBox("instance");
        const amountNotReflectedInstance = $("#AmountNotReflectedinBank").dxTextBox("instance");

        if (balanceOurBooksInstance) {
            LastAmt = Math.abs(lastRowBalanceVal);
            balanceOurBooksInstance.option("value", LastAmt);
        }

        if (balanceBankStatementInstance) {
            FirstAmt = Math.abs(firstRowBalanceVal);
            balanceBankStatementInstance.option("value", FirstAmt);
        }

        // const TotalVal = LastAmt - FirstAmt;
        // const TotalAmtNotReflectedInBank = Math.abs(TotalVal);

        // if (amountNotReflectedInstance) {
        //     amountNotReflectedInstance.option("value", TotalAmtNotReflectedInBank);
        // }

        if (accheadname && ToDate) {
            $("#titleHeader").text(`${accheadname} as on ${ToDate}`);
        }

        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        if (dataGrid) {
            dataGrid.option("dataSource", {
                store: DevExpress.data.AspNet.createStore({
                    loadUrl: "/api/SalaryPayableMapping/GetBankReconciliation",
                    loadParams: { accid: accid }
                })
            });

            console.log({ accid: accid });
            dataGrid.refresh();
        }
    });







    function ddBtnShowRecords_click(filterType) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");

        const today = new Date();
        let startDate = new Date(today);
        startDate.setMonth(today.getMonth() - 1);
        let endDate = today;

        dataGrid.option("dataSource", {
            load: function () {
                return $.ajax({
                    url: `/api/SalaryPayableMapping/GetBankReconciliation?accid=${encodeURIComponent(getQueryParam("accid"))}`,
                    data: { startDate: startDate.toISOString(), endDate: endDate.toISOString() },
                    type: "GET"
                }).then(data => data.map(item => ({ ...item, dateField: new Date(item.dateField).toLocaleDateString("en-GB") })));
            }
        });
    }

    function customizeDrCrColors() {
    $(".dx-datagrid-rowsview").find("td").each(function () {
        let cell = $(this);
        let columnIndex = cell.index();
        let row = cell.closest("tr");
        let drCrValue = cell.text().trim();

        if (drCrValue === "Cr") {
            cell.css("background-color", "green").css("color", "white"); 
        } else if (drCrValue === "Dr") {
            cell.css("background-color", "red").css("color", "white"); 
        }
    });
}

// Call this function after the DataGrid is rendered
$(document).ready(function () {
    setTimeout(customizeDrCrColors, 500);

    // Reapply colors after DataGrid updates
    $("#dataGrid").dxDataGrid("instance").on("contentReady", function () {
        customizeDrCrColors();
    });
});

$(document).ready(function () {
    $("#dataGrid").dxDataGrid({
        onContextMenuPreparing: function (e) {
            if (e.row && e.target === "content") {
                e.event.preventDefault();

                e.items = [
                    {
                        text: "Clear All Selected Voucher",
                        onItemClick: function () {
                            if (selectedVoucherEntryNo.length === 0 || selectedVoucherDate.length === 0) {
                                alert("Please select at least one row.");
                                return;
                            }

                            // Pick the first date if all entries should have the same BankClearedOn value
                            let formattedDate = encodeURIComponent(selectedVoucherDate[0]); 

                            // Construct query parameters
                            let queryParams = selectedVoucherEntryNo.map(v => `VoucherEntryNo=${encodeURIComponent(v)}`).join("&");
                            let url = `/api/SalaryPayableMapping/UpdateClearSelectedVoucher?${queryParams}&BankClearedOn=${formattedDate}`;

                            //alert("Cost Allocation clicked for rows: " + selectedVoucherEntryNo.join(", "));

                            $.ajax({
                                url: url,
                                type: "POST",
                                success: function (response) {
                                    alert("All selected vouchers hss been set as reconciled.");
                                    alert("Bank Reconciliation updated Successfully!");
                                    var dataGrid = $("#dataGrid").dxDataGrid("instance");
                                    dataGrid.refresh();
                                },
                                error: function (xhr) {
                                    alert("Error updating BankClearedOn: " + xhr.responseText);
                                }
                            });
                        }
                    }
                ];
            }
        }
    });
});



    $(function () {

        let totatReceipts;

        const dataGrid = $("#dataGrid").dxDataGrid("instance");

        const totalDebitTextbox = $("#totalDebitTextbox").dxTextBox("instance");

        const totalCreditTextbox = $("#totalCreditTextbox").dxTextBox("instance");

        function calculateTotals() {

            const data = dataGrid.getVisibleRows().map(row => row.data);

            const totalDebit = data.reduce((sum, row) => sum + (row.DrAmount || 0), 0);

            const totalCredit = data.reduce((sum, row) => sum + (row.CrAmount || 0), 0);

            const balance = totalDebit - totalCredit;

            const TotalAmtNotReflectedInBank = Math.abs(balance);

            $("#AmountNotReflectedinBank").dxTextBox("instance").option("value", TotalAmtNotReflectedInBank);

            // Update TextBox values dynamically

            totalDebitTextbox.option("value", totalDebit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

            totalCreditTextbox.option("value", totalCredit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        }

        // Recalculate totals on content changes

        dataGrid.on("contentReady", calculateTotals);

        dataGrid.on("dataSourceChanged", calculateTotals);



    });


    function onUpdateClick() {
    // Validate the inputs
    if (!voucherEntryNo || !bankclearedOn) {
        alert("Please provide both Voucher Entry No. and Bank Cleared On date.");
        return;
    }

    // Convert the bankclearedOn value to a Date object if it's a string
    let bankClearedDate = new Date(bankclearedOn);
    if (isNaN(bankClearedDate.getTime())) {
        alert("Invalid BankClearedOn date.");
        return;
    }

    // Convert to ISO 8601 format
    let formattedDate = bankClearedDate.toISOString(); // e.g., "2024-10-30T18:30:00.000Z"

    // Send AJAX request to update the BankClearedOn field
    $.ajax({
        url: `/api/SalaryPayableMapping/UpdateBankClearedOn?VoucherEntryNo=${encodeURIComponent(voucherEntryNo)}&BankClearedOn=${encodeURIComponent(formattedDate)}`,
        type: "POST",
        success: function (response) {
            alert("BankClearedOn updated successfully!");
            // Refresh the DataGrid after a successful update
            var dataGrid = $("#dataGrid").dxDataGrid("instance");
            dataGrid.refresh();
        },
        error: function (xhr) {
            alert("Error updating BankClearedOn: " + xhr.responseText);
        }
    });
}



    
    
</script>
