													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});

     let voucherEntryNo,bankclearedOn,selectedVoucherEntryNo=[],selectedVoucherDate=[];


      function getSelectedVoucherEntryNo() {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var selectedRows = dataGrid.getSelectedRowsData();

