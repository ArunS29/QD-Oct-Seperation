    .content-container {
        background-color: #c0dceb;
        border-radius: 10px;
        padding: 5px;
    }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        border-radius: 5px;
    }

    .context-menu-item {
        padding: 20px 15px;
        cursor: pointer;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

        .context-menu-item i {
            margin-right: 10px; /* Space for the icon */
        }

        .context-menu-item:hover {
            background-color: #f1f1f1;
        }

    .popup-message {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #4CAF50; /* Success green color */
        color: white;
        padding: 20px 30px;
        border-radius: 10px;
        font-size: 16px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        z-index: 1001;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 0em;
        padding: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }
</style>
<input id="formId" value="uc20101ChartOfAccounts" type="hidden" />
<div class="content-container-top">
    <div class="Head">
        <div class="header-container">
            <div class="footer">@await Html.PartialAsync("ADOFooter")</div>
        </div>
    </div>
    <div id="AccountsGroupsOrdering" class="title no-border-input"></div>
    @(
        Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201207accountGroupOrdering>()
        .ID("dataGrid")
        .KeyExpr("AccountGroupId")
        .DataSource(ds => ds.Mvc()
            .Controller("AccountGroupsOrdering") // Specify the controller name
        .LoadAction("GetAccountGroupsOrdering") // Specify the action that returns data
        )
        .RemoteOperations(true)// Enable remote data operations

        .Columns(columns =>
        {
            columns.AddFor(m => m.ChartOfAccountsOrder).Caption(new JS("formatMessage('Chart Of Accounts Order')")).Alignment(HorizontalAlignment.Center);
            columns.AddFor(m => m.ChartOfAccountsOrder).Caption(new JS("formatMessage('Chart Of Accounts Order')")).Alignment(HorizontalAlignment.Center)
            .GroupIndex(0);
            columns.AddFor(m => m.MasterGroup).Caption(new JS("formatMessage('Master Group')")).Alignment(HorizontalAlignment.Center);
            columns.AddFor(m => m.MasterGroup).Caption(new JS("formatMessage('Master Group')")).Alignment(HorizontalAlignment.Center)
            .GroupIndex(1);
            columns.AddFor(m => m.AccountGroupId).Caption(new JS("formatMessage('Account Group Id')")).Alignment(HorizontalAlignment.Left);
            columns.AddFor(m => m.AccountGroup).Caption(new JS("formatMessage('Account Group')")).Alignment(HorizontalAlignment.Left);
            columns.AddFor(m => m.AccountGroupOrderNo).Caption(new JS("formatMessage('Account Group Order No')")).Alignment(HorizontalAlignment.Left)
           // .SortOrder(SortOrder.Asc)
            .Alignment(HorizontalAlignment.Center)
            .AllowEditing(true);

        })
        @* .Selection(selection => selection.Mode(SelectionMode.Multiple)) *@
        .Editing(editing => editing
        .Mode(GridEditMode.Batch)// ✅ Ensure inline cell editing is enabled
        .AllowUpdating(true) // ✅ Enable editing
        )

        .Paging(p => p.PageSize(10))
        .AllowColumnReordering(true) // Enable column reordering
        .AllowColumnResizing(true)   // Enable column resizing
        .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixings
        .HeaderFilter(filter => filter.Visible(true))
        .Height(500)
        .ColumnAutoWidth(true)
        .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
        .GroupPanel(groupPanel => groupPanel.Visible(false)) // Hide group panel
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .ShowBorders(true)
            .RemoteOperations(true)
        .Width("100%")

        )
</div>


<script>
$(function () {

										$("#AccountsGroupsOrdering").dxTextBox({
													text:formatMessage("Accounts Groups Ordering"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
    let selectedAccountGroupId;

    $("#btnSave").click(function () {
        
        var dataGrid = $("#dataGrid").dxDataGrid("instance");

        $.ajax({
                    type: "POST",
                    url: `/api/AccountGroupsOrdering/GetAccountGroupsOrdering`,
                    contentType: "application/json",
                  //  data: JSON.stringify(VE),
                    dataType: "json",
                    success: function (response) {
                         $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

                    }
        });

        console.log("Save function triggered");

        // ✅ Get only the edited/changed rows
        var changes = dataGrid.option("editing.changes") || [];

        if (changes.length === 0) {
            alert("No changes to save.");
            return;
        }

        console.log(changes);

        var updatedRows = changes.map(change => {
            let accountGroupId = change.key?.AccountGroupId; // ✅ Extract AccountGroupId from the object
            let accountGroupOrderNo = change.data ? change.data.AccountGroupOrderNo : null;

            console.log("Extracted AccountGroupId:", accountGroupId); // ✅ Log the correct ID

            return {
                AccountGroupId: accountGroupId,
                AccountGroupOrderNo: accountGroupOrderNo
            };
        });

        console.log("Updated rows:", updatedRows);

        // ✅ Send updated rows to the server via AJAX
        $.ajax({
            url: "/api/AccountGroupsOrdering/UpdateAccountGroupOrder", // Ensure this is the correct API endpoint
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(updatedRows),
            success: function (response) {
                DevExpress.ui.notify(response.message, "success", 3000);
                //  window.location.reload(); // This is for only particular page reload
                setTimeout(function () {
                    window.location.reload();
                }, 3000);

            },
            error: function () {
                alert("Error saving data.");
            }
        });
    });
    // $(document).ready(function () {
    //     // Binding 'moveRowUp' function to the 'btnMoveUp' button
    //     $("#btnMoveUp").dxButton({
    //         onClick: function () {
    //             moveRowUp();
    //         }
    //     });

    //     // Binding 'moveRowDown' function to the 'btnMoveDown' button
