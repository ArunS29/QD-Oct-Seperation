<script>
$(function () {

										$("#AccountsGroupsOrdering").dxTextBox({
													text:formatMessage("Accounts Groups Ordering"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
    let selectedAccountGroupId;

    $("#btnSave").click(function () {
        
        var dataGrid = $("#dataGrid").dxDataGrid("instance");

        $.ajax({
                    type: "POST",
                    url: `/api/AccountGroupsOrdering/GetAccountGroupsOrdering`,
                    contentType: "application/json",
                  //  data: JSON.stringify(VE),
                    dataType: "json",
                    success: function (response) {
                         $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

                    }
        });

        console.log("Save function triggered");

        // ✅ Get only the edited/changed rows
        var changes = dataGrid.option("editing.changes") || [];

        if (changes.length === 0) {
            alert("No changes to save.");
            return;
        }

        console.log(changes);

        var updatedRows = changes.map(change => {
            let accountGroupId = change.key?.AccountGroupId; // ✅ Extract AccountGroupId from the object
            let accountGroupOrderNo = change.data ? change.data.AccountGroupOrderNo : null;

            console.log("Extracted AccountGroupId:", accountGroupId); // ✅ Log the correct ID

            return {
                AccountGroupId: accountGroupId,
                AccountGroupOrderNo: accountGroupOrderNo
            };
        });

        console.log("Updated rows:", updatedRows);

        // ✅ Send updated rows to the server via AJAX
        $.ajax({
            url: "/api/AccountGroupsOrdering/UpdateAccountGroupOrder", // Ensure this is the correct API endpoint
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(updatedRows),
            success: function (response) {
                DevExpress.ui.notify(response.message, "success", 3000);
                //  window.location.reload(); // This is for only particular page reload
                setTimeout(function () {
                    window.location.reload();
                }, 3000);

            },
            error: function () {
                alert("Error saving data.");
            }
        });
    });
    
    $(document).ready(function () {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");
  

        // Attach the 'selectionChanged' event handler
        dataGrid.on("selectionChanged", function (e) {
            // Get the selected row data
            var selectedRowData = e.selectedRowsData[0]; // We assume only one row is selected at a time
            if (selectedRowData) {
                selectedAccountGroupId = selectedRowData.AccountGroupId; // Assign AccountGroupId to the global variable
                console.log("Selected AccountGroupId: ", selectedAccountGroupId); // Log the global variable
            }
        });

        // Binding 'moveRowUp' function to the 'btnMoveUp' button
        $("#btnMoveUp").dxButton({
            onClick: function () {
                 moveWithinGroup("up");
            }
        });

        // Binding 'moveRowDown' function to the 'btnMoveDown' button
        $("#btnMoveDown").dxButton({
            onClick: function () {
                moveWithinGroup("down");
            }
        });
    });

                function moveWithinGroup(direction) {
        debugger;
        const grid = $("#dataGrid").dxDataGrid("instance");
        const selectedRows = grid.getSelectedRowsData();
        if (!selectedRows.length) return;

        const selectedRow = selectedRows[0];
        const selectedKey = selectedRow.AccountGroupId;

        const ds = grid.getDataSource();
        if (!ds) return;

        // Root items (grouped response)
        let rootItems = ds.items();
        if (!Array.isArray(rootItems) || !rootItems.length) return;

        // Flatten into actual data rows
        let flatItems = [];
        rootItems.forEach(level1 => {
            (level1.items || []).forEach(level2 => {
                (level2.items || []).forEach(row => {
                    flatItems.push(row);
                });
            });
        });

        // Find current index
        const currentIndex = flatItems.findIndex(it => it.AccountGroupId === selectedKey);
        if (currentIndex === -1) return;

        // Determine target index
        const targetIndex = direction === "up" ? currentIndex - 1 : currentIndex + 1;
        if (targetIndex < 0 || targetIndex >= flatItems.length) return;

        // Swap rows
        [flatItems[currentIndex], flatItems[targetIndex]] = [flatItems[targetIndex], flatItems[currentIndex]];

        // Swap order numbers if present
        const a = flatItems[currentIndex], b = flatItems[targetIndex];
        if (a && b && "AccountGroupOrderNo" in a && "AccountGroupOrderNo" in b) {
            const tmp = a.AccountGroupOrderNo;
            a.AccountGroupOrderNo = b.AccountGroupOrderNo;
            b.AccountGroupOrderNo = tmp;
        }

        // Update grid dataSource (flattened)
        grid.option("dataSource", flatItems);
        grid.refresh();

        // Reselect moved row
        const movedItem = flatItems[targetIndex];
        if (movedItem) {
            grid.selectRows([movedItem.AccountGroupId], true);
            grid.navigateToRow(movedItem.AccountGroupId);
        }
    }

   
    $(function() {
    let dataGrid = $("#dataGrid").dxDataGrid("instance");

    dataGrid.refresh(); // Force refresh to reload correctly ordered data
});


             function getSelectedKey(grid) {
            const keys = grid.getSelectedRowKeys();
            return keys.length > 0 ? keys[0] : null;
        }

        function onRowSelected(e) {
            const grid = e.component;
            const key = getSelectedKey(grid);
            if (!key) return;
            const rowIndex = grid.getRowIndexByKey(key);
            const orderColIndex = grid.getVisibleColumns().findIndex(c => c.dataField === "AccountGroupOrderNo");
            if (rowIndex >= 0 && orderColIndex >= 0) {
                setTimeout(() => grid.editCell(rowIndex, orderColIndex), 10);
            }
        }

        // Also ensure when focused row changes programmatically or via keyboard, we open the last column editor
        function onFocusedRowChanged(e) {
            const grid = e.component;
            const key = e.row && e.row.key;
            if (!key) return;

            const rowIndex = grid.getRowIndexByKey(key);
            const colIndex = getOrderColumnIndex(grid);
            if (rowIndex >= 0 && colIndex >= 0) {
                setTimeout(function () {
                    grid.editCell(rowIndex, colIndex);
                }, 10);
            }
        }
        $(function () {
                    $("#accountgroupsorderings").text(formatMessage("Account Groups Ordering"));
        });
</script>
