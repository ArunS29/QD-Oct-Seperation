    $(document).ready(function () {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");

        // Attach the 'selectionChanged' event handler
        dataGrid.on("selectionChanged", function (e) {
            // Get the selected row data
            var selectedRowData = e.selectedRowsData[0]; // We assume only one row is selected at a time
            if (selectedRowData) {
                selectedAccountGroupId = selectedRowData.AccountGroupId; // Assign AccountGroupId to the global variable
                console.log("Selected AccountGroupId: ", selectedAccountGroupId); // Log the global variable
            }
        });

        // Binding 'moveRowUp' function to the 'btnMoveUp' button
        $("#btnMoveUp").dxButton({
            onClick: function () {
                 moveWithinGroup("up");
            }
        });

        // Binding 'moveRowDown' function to the 'btnMoveDown' button
        $("#btnMoveDown").dxButton({
            onClick: function () {
                moveWithinGroup("down");
            }
        });
    });


        function moveWithinGroup(direction) {
        const grid = $("#dataGrid").dxDataGrid("instance");
        const selectedRow = grid.getSelectedRowsData()[0];

        if (!selectedRow) {
            DevExpress.ui.notify("Please select a row first", "warning", 2000);
            return;
        }

        const payload = {
            accountGroupId: selectedRow.AccountGroupId,
            direction: direction
        };

        $.ajax({
            url: "/api/AccountGroupsOrdering/SwapWithinGroup",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload), // send proper JSON
            success: function (response) {
                if (response.success) {
                    grid.refresh().done(() => {
                        grid.selectRows([selectedRow.AccountGroupId], false);
                        grid.editCell(selectedRow.AccountGroupId, "AccountGroupOrderNo");
                    });
                } else {
                    DevExpress.ui.notify(response.message, "error", 2000);
                }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
                DevExpress.ui.notify("Error occurred while moving row", "error", 2000);
            }
        });
    }




    // Utility function to flatten grouped data
    function getFlatData(items) {
        var flatData = [];

        function flatten(items) {
            items.forEach(item => {
                if (item.items) {
                    flatten(item.items); // Recursively flatten groups
                } else {
                    flatData.push(item); // Push raw row data
                }
            });
        }

        flatten(items); // Flatten all grouped items

        return flatData;
    }
    function moveRowDown() {
             var grid = $("#dataGrid").dxDataGrid("instance");
            var index = grid.getRowIndexByKey(grid.getSelectedRowKeys()[0]);
            var totalRows = grid.totalCount();
            if (index >= totalRows - 1) return;

            let dataSource = grid.getDataSource();
            let store = dataSource.store();

            dataSource.load().done(function(data) {
                let currentRow = data[index];
                let nextRow = data[index + 1];

                // Swap order numbers
                let temp = currentRow.AccountGroupOrderNo;
                currentRow.AccountGroupOrderNo = nextRow.AccountGroupOrderNo;
                nextRow.AccountGroupOrderNo = temp;

                // Update both rows in store
                store.update(currentRow.AccountGroupId, currentRow);
                store.update(nextRow.AccountGroupId, nextRow);

                dataSource.reload().done(function() {
                    grid.selectRows([currentRow.AccountGroupId], false);
                });
            });
    }








    function swapRows(data, index1, index2) {
        var temp = data[index1];
        console.log("Swap Data1:", temp);

        // Swap the rows
        data[index1] = data[index2];
        console.log("Swap Data2:", data[index2]);

        data[index2] = temp;
        console.log("Swapped Data:", data);

        // Get the DataGrid instance and update the data source
        var dataGrid1 = $("#dataGrid").dxDataGrid("instance");
        var dataGrid = $("#dataGrid").dxDataGrid("instance").option("dataSource", data);


        dataGrid1.refresh();
    }


    $(function() {
    let dataGrid = $("#dataGrid").dxDataGrid("instance");

    dataGrid.refresh(); // Force refresh to reload correctly ordered data
});


             function getSelectedKey(grid) {
            const keys = grid.getSelectedRowKeys();
            return keys.length > 0 ? keys[0] : null;
        }

        function onRowSelected(e) {
            const grid = e.component;
            const key = getSelectedKey(grid);
            if (!key) return;
            const rowIndex = grid.getRowIndexByKey(key);
            const orderColIndex = grid.getVisibleColumns().findIndex(c => c.dataField === "AccountGroupOrderNo");
            if (rowIndex >= 0 && orderColIndex >= 0) {
                setTimeout(() => grid.editCell(rowIndex, orderColIndex), 10);
            }
        }

        // Also ensure when focused row changes programmatically or via keyboard, we open the last column editor
        function onFocusedRowChanged(e) {
            const grid = e.component;
            const key = e.row && e.row.key;
            if (!key) return;

            const rowIndex = grid.getRowIndexByKey(key);
            const colIndex = getOrderColumnIndex(grid);
            if (rowIndex >= 0 && colIndex >= 0) {
                setTimeout(function () {
                    grid.editCell(rowIndex, colIndex);
                }, 10);
            }
        }
        $(function () {
                    $("#accountgroupsorderings").text(formatMessage("Account Groups Ordering"));
        });
</script>
