@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities
@model Form.Areas.Finance.Pages.CostCenterMasterModel
@{
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }



    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .card {
        background-color: white;
    }

    .dx-datagrid-pager .dx-page.dx-selection,
    .pagination .active a {
        color: black !important; /* Set the active page number to yellow */
        font-weight: bold; /* Optional: Make the active page bold */
    }

    .button-alignment-down {
        margin-bottom: 10px
    }

    .dx-field {
        background-color: white;
    }

    .card-footer {
        background-color: white;
    }

    .card-header {
        background-color: white; /* Blue background */
        color: black; /* White text */
        padding: 20px; /* Padding around the header */
        
        display: flex; /* Flex container for alignment */
        align-items: center; /* Vertically align icon and text */
    }

    .header-icon {
        font-size: 40px; /* Icon size */
        margin-right: 15px; /* Space between icon and text */
        color: goldenrod; /* Golden color for the icon */
        text-shadow: 2px 2px 4px black; /* Black shadow around the icon for contrast */
    }


    .header-text {
        font-size: 25px; /* Font size for text */
    }






    .left-text {
        color: blue; /* Sets the text color to blue */
        text-decoration: underline; /* Underlines the text */
        margin-right: 20px;
    }

    .row {
        margin-top: 20px;
        margin-left: 20px;
    }

    .button-alignment-down {
        margin-top: 23px;
    }

    .button-group {
        margin-left: -10px !important;
    }


    .dx-button {
        background-color: whitesmoke;
    }

    .right-text {
        color: blue; /* Sets the text color to blue */
        text-decoration: underline; /* Underlines the text */
    }

    label {
        color: black;
        
    }
</style>
<div id="costAllocationPopup" style="display:none;">
    <div style="margin-bottom:10px">
        @(Html.DevExtreme().Button()
            .ID("btnSaveCostAllocation")
            .Icon("save")
            .Text("Save")
            .OnClick("function() { saveCostAllocation(); }")
            )
    </div>
</div>

<div class="card">
    <div class="content-container-top">
        <div class="card-header">
            <i class="fas fa-pen-nib header-icon"></i> <!-- Font Awesome pen nib icon -->
            <span class="header-text"style="background-color:lightgrey">Cost Center's</span>
        </div>

        <br />
        <div class="container">
            <div class="card">
                <h5 style="margin-left:10px;background-color:aliceblue">Cost Center Details</h5>
            </div>
        </div>


        <div class="container">

            <div class="row">
                <div class="form-group">
                    <div class="col-md-2">
                        <label for="CostAllocationUnitID" >
                            Cost Center Code:
                        </label>
                    </div>

                    <div class="col-md-6">
                        @(Html.DevExtreme()
                            .TextBox()
                            .ID("CostAllocationUnitID")
                            .Value(null)
                            .Width("100%")
                            .MaxLength(50)
                            )
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="form-group">
                    <div class="col-md-2">
                        <label for="CostAllocationUnit" >
                            Cost Center Unit:
                        </label>
                    </div>
                    <div class="col-md-10">
                        @(Html.DevExtreme()
                            .TextBox()
                            .ID("CostAllocationUnit")
                            .Value(null)
                            .Width("100%")
                            )
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    <div class="col-md-2">
                        <label for="CostCenterGroup" >
                            Cost Center Group:
                        </label>
                    </div>
                    <div class="col-md-10">

                        <!-- ComboBox for Cost Center Group -->
                        <div id="costCenterComboBox"></div>

                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    <div class="col-md-2">

                        <label for="CostAllocationMasterGroup">
                            Cost Center Master
                            :
                        </label>
                    </div>
                    <div class="col-md-10">
                        <!-- ComboBox for Cost Center Group -->
                        <div id="costCenterMaster1"></div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group">
                    <div class="col-md-2">
                        <label for="CostUnitRemarks" >
                            Cost Center Remarks:
                        </label>
                    </div>
                    <div class="col-md-10">
                        @(Html.DevExtreme()
                            .TextBox()
                            .ID("CostUnitRemarks")
                            .Value(null)
                            .Width("100%")
                            .MaxLength(250)
                            )
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="form-group">

                        <label for="CostCenterIncharge" >
                            Cost Center Incharge:
                        </label>
                        @(Html.DevExtreme().TextBox().ID("CostCenterIncharge").Value(null).Width("100%"))
                    </div>
                </div>
                @*  <div class="button-alignment-down">
                <label for="UseSubmittedDate">Received Date</label>
                @(Html.DevExtreme().CheckBox()
                .ID("UseSubmittedDate")
                )
                </div> *@
                <div class="col-md-5">
                    <div class="form-group">
                        <label for="Branch" style=" display: flex; justify-content: space-between; align-items: center;">
                            <span>Project:</span>
                            <span class="right-text">Add from the Project</span>
                        </label>


                        @(Html.DevExtreme().DropDownBox()
                            .DataSource(d => d.WebApi()
                            .Controller("CostCenterMaster")
                            .LoadAction("GetProject")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("ProjectId")
                            )

                            .LabelMode(EditorLabelMode.Outside)
                            .ID("GetProjectDropDown")
                            @*  .ShowClearButton(true)
                        .AcceptCustomValue(true) *@
                            .OpenOnFieldClick(false)//
                            .ValueChangeEvent("input")
                            .HoverStateEnabled(true)
                            .ValueExpr("ProjectId")
                            .DisplayExpr("ProjectDescription")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("onOpened")
                            .TabIndex(1)
                            .OnKeyDown("onKeyDown")
                            //.OnValueChanged("dropDownBoxValueChanged")
                            .ContentTemplate(new TemplateName("GetProjectContentTemplate"))
                            )


                    </div>
                </div>

            </div>

            <div class="row">
                <!-- Dropdown Section -->
                <div class="col-md-5">
                    <div class="form-group">
                        <label for="Branch" >Division/Branch:</label>
                        @(Html.DevExtreme().DropDownBox()
                            .DataSource(d => d.WebApi()
                            .Controller("CostCenterMaster")
                            .LoadAction("GetBranchCode")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("Branch")
                            )
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("GetBranchCodeDropDown")
                            @*   .ShowClearButton(true)
                        .AcceptCustomValue(true) *@
                            .OpenOnFieldClick(true)//
                            .ValueChangeEvent("input")
                            .HoverStateEnabled(true)
                            .ValueExpr("BranchCode")
                            .DisplayExpr("BranchName")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("onOpened")
                            .TabIndex(1)
                            .OnKeyDown("onKeyDown")
                            .ContentTemplate(new TemplateName("GetBranchCodeContentTemplate"))
                            )
                    </div>
                </div>

                <!-- Checkbox Section -->
                <div class="col-md-6" style="margin-top:25px;">
                    <div class="form-group">
                        <label style="margin-right: 10px;color:crimson">Discontinued:</label>
                        @(Html.DevExtreme().CheckBox()
                            .ID("Discontinued")
                            )
                    </div>
                </div>
            </div>



        </div>

    </div>
    <br />
    <hr />
    <div class="container">
        <div class="row">
            <div class="col-md-2">
                <label for="CreatedBy" >Created By:</label>
            </div>
            <div class="col-md-2">
                @(Html.DevExtreme().TextBox().ID("CreatedBy").Value(null).Width("100%").ReadOnly(false))
            </div>

            <div class="col-md-2">
                <label for="CreatedOn" style="color: aliceblue">Created On:</label>
            </div>
            <div class="col-md-2">
                @(Html.DevExtreme().TextBox().ID("CreatedOn").Value(null).Width("100%").ReadOnly(false))
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label for="ModifiedBy" >Modified By:</label>
            </div>
            <div class="col-md-2">
                @(Html.DevExtreme().TextBox().ID("ModifiedBy").Value(null).Width("100%").ReadOnly(false))
            </div>

            <div class="col-md-2">
                <label for="ModifiedOn" >Modified On:</label>
            </div>
            <div class="col-md-2">
                @(Html.DevExtreme().TextBox().ID("ModifiedOn").Value(null).Width("100%").ReadOnly(false))
            </div>
        </div>

    </div>

    <br />
    <div class="container">
        <div class="card-footer">
            <div class="dx-fieldset horizontal-container mt-2">

                @(Html.DevExtreme().Button()
                    .ID("btnSave")
                    .Text("Save")
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    .Icon("save")
                    )
                @* @(Html.DevExtreme().Button()
                    .ID("btnUpdate")
                    .Text("Update")
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    .Icon("save")
                    )   *@
                @(Html.DevExtreme().Button()
                    .ID("btnBack")
                    .Text("Back")
                    .Icon("arrowleft")
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    .OnClick("navigateToHome")
                    )
            </div>
        </div>

    </div>

    <!-- Drop Down Grid Template -->
    @using (Html.DevExtreme().NamedTemplate("GetBranchCodeContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("GetBranchCode-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("CostCenterMaster")
            .LoadAction("GetBranchCode")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("BranchCode")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
            .OnSelectionChanged("dataGridSelectionChangedbranch")
            .OnInitialized("dataGridInitializedbranch")
            .HeaderFilter(p => p.Visible(true))
            .ShowBorders(true)
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .FilterRow(f => f.Visible(false))//
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Columns(columns =>
            {
                @* columns.Add().DataField("CostAllocationUnitId"); *@
                @*  columns.Add().DataField("BranchCode"); *@
                columns.Add().DataField("BranchName").Caption("Division/Branch");


            })
            )
    }
    <!-- Drop Down Grid Template -->
    @using (Html.DevExtreme().NamedTemplate("GetProjectContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("GetProject-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("CostCenterMaster")
            .LoadAction("GetProject")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("ProjectId")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
            .OnSelectionChanged("dataGridSelectionChanged")
            .OnInitialized("dataGridInitialized")
            .HeaderFilter(p => p.Visible(true))
            .ShowBorders(true)
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .FilterRow(f => f.Visible(false))//
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Columns(columns =>
            {
                columns.Add().DataField("ProjectId");
                columns.Add().DataField("ProjectDescription");


            })
            )
    }


</div>





<script>
    let dataGrid;
    let CreatedOnvalue = null;

    $(function () {
        $("#costCenterComboBox").dxSelectBox({
            dataSource: new DevExpress.data.CustomStore({
                load: function (loadOptions) {
                    return $.ajax({
                        url: "/api/CostCenterMaster/GetCostAllocationGroup", // Replace with your API endpoint
                        dataType: "json",
                        data: loadOptions,
                        type: "GET"
                    });
                },
                byKey: function (key) {
                    return $.ajax({
                        url: "/api/CostCenterMaster/GetCostCenterByKey", // Use an appropriate API endpoint for this
                        data: { key: key },
                        type: "GET"
                    });
                }
            }),
            displayExpr: "CostAllocationGroup", // Field to display in ComboBox
            valueExpr: "CostAllocationUnitId", // Field to use as the value
            placeholder: "Select or Enter a Cost Center Group",
            searchEnabled: true, // Enable search functionality
            acceptCustomValue: true, // Allow user to input custom values
            inputAttr: { style: "text-align: left;" },
            onCustomItemCreating: function (args) {
                const newValue = args.text; // The custom value entered by the user
                return {
                    CostAllocationUnitId: newValue, // Assign a unique ID or key
                    CostAllocationGroup: newValue  // Use the entered value as the display text
                };
            },
            onValueChanged: function (args) {
                const selectedValue = args.value;
                console.log("Selected/Entered Value:", selectedValue);
            }
        });
    });

    $(function () {
        $("#costCenterMaster1").dxSelectBox({
            dataSource: new DevExpress.data.CustomStore({
                load: function (loadOptions) {
                    return $.ajax({
                        url: "/api/CostCenterMaster/GetCostAllocationMasterGroup", // Replace with your API endpoint
                        dataType: "json",
                        data: loadOptions,
                        type: "GET"
                    });
                },
                byKey: function (key) {
                    return $.ajax({
                        url: "/api/CostCenterMaster/GetCostCenterMasterGroupByKey", // Use your specific endpoint for fetching a single record by key
                        data: { key: key },
                        type: "GET"
                    });
                }
            }),
            displayExpr: "CostAllocationMasterGroup", // Field to display in ComboBox
            valueExpr: "CostAllocationUnitId", // Field to use as the value
            placeholder: "Select or Enter a Cost Center MasterGroup",
            searchEnabled: true, // Enable search functionality
            acceptCustomValue: true, // Allow user to input custom values
            inputAttr: { style: "text-align: left;" },
            onCustomItemCreating: function (args) {
                const newValue = args.text; // The custom value entered by the user
                return {
                    CostAllocationUnitId: newValue, // Assign a unique ID or key
                    CostAllocationMasterGroup: newValue  // Use the entered value as the display text
                };
            },
            onValueChanged: function (args) {
                const selectedValue = args.value;
                console.log("Selected/Entered Value:", selectedValue);
            }
        });
    });

    // GetBranchDropDown
    function dataGridSelectionChangedbranch(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#GetBranchCodeDropDown").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }

    function dataGridInitializedbranch(e) {
        dataGrid = e.component;
    }

    function dataGridSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#GetProjectDropDown").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }

    function dataGridInitialized(e) {
        dataGrid = e.component;
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();
        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

    function onOpened() {
        console.log("DropDownBox opened");
    }

    function onKeyDown(event) {
        console.log("Key pressed:", event.key);
    }

    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const costAllocationUnitId = urlParams.get('CostAllocationUnitId');

        if (costAllocationUnitId) {
            // Change the Save button to Update
            // $("#btnSave").text("Update");
              var button = $("#btnSave").dxButton("instance");
             button.option("text", "Update");

            // Fetch and bind data to form fields if CostAllocationUnitId is in the query string
            $.ajax({
                url: `/api/ChartOfCostCenters/GetCostCenterById?id=${costAllocationUnitId}`,
                type: "GET",
                success: function (response) {
                    if (response.success) {
                        alert(response.data.IsDisabled);
                        //alert(formatDate(response.data.CreatedOn));
                        // Bind data to form fields
                        $("#CostAllocationUnitID").dxTextBox("instance").option("value", response.data.CostAllocationUnitId);
                        $("#CostAllocationUnitID").dxTextBox("instance").option("readOnly", true);  // Make it read-only
                        $("#CostAllocationUnit").dxTextBox("instance").option("value", response.data.CostAllocationUnit);
                        $("#costCenterComboBox").dxSelectBox("instance").option("value", response.data.CostAllocationGroup);
                        $("#costCenterMaster1").dxSelectBox("instance").option("value", response.data.CostAllocationMasterGroup);
                        $("#GetProjectDropDown").dxDropDownBox("instance").option("value", response.data.ProjectMasterCode);
                        $("#GetBranchCodeDropDown").dxDropDownBox("instance").option("value", response.data.BranchCode);
                        $("#CostUnitRemarks").dxTextBox("instance").option("value", response.data.CostUnitRemarks);
                        $("#CostCenterIncharge").dxTextBox("instance").option("value", response.data.CostCenterIncharge);
                        $("#Discontinued").dxCheckBox("instance").option("value", response.data.IsDisabled);
                        // Dates
                        $("#CreatedBy").dxTextBox("instance").option("value", response.data.CreatedBy);
                        $("#CreatedOn").dxTextBox("instance").option("value", formatDate(response.data.CreatedOn));
                        $("#ModifiedBy").dxTextBox("instance").option("value", response.data.ModifiedBy);
                        $("#ModifiedOn").dxTextBox("instance").option("value", formatDate(new Date()));
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert("An error occurred while fetching the Cost Center data.");
                }


            });

        }

        // Define the fields array for validation
        const fields = [
            { id: "#CostAllocationUnitID", message: "Cost Allocation Unit ID is required." },
            { id: "#CostAllocationUnit", message: "Cost Allocation Unit is required." },
            { id: "#costCenterComboBox", message: "Cost Allocation Group is required." },
            { id: "#costCenterMaster1", message: "Cost Allocation Master Group is required." },
            { id: "#CostUnitRemarks", message: "Remarks are required." },
            { id: "#CostCenterIncharge", message: "Cost Center Incharge is required." },
            { id: "#GetProjectDropDown", message: "Project Code is required." },
            { id: "#GetBranchCodeDropDown", message: "Branch Code is required." }
        ];

        // Initialize DevExtreme Widgets and Validators
        $("#CostAllocationUnitID").dxTextBox();
        $("#CostAllocationUnit").dxTextBox();
        $("#costCenterComboBox").dxSelectBox();
        $("#costCenterMaster1").dxSelectBox();
        $("#CostUnitRemarks").dxTextBox();
        $("#CostCenterIncharge").dxTextBox();
        $("#GetProjectDropDown").dxDropDownBox();
        $("#GetBranchCodeDropDown").dxDropDownBox();
        $("#Discontinued").dxCheckBox();

        // Add Validators
        fields.forEach((field) => {
            $(field.id).dxValidator({
                validationRules: [{ type: "required", message: field.message }]
            });
        });

        $("#Discontinued").dxValidator({
            validationRules: [{ type: "required", message: "Please confirm if discontinued." }]
        });

        // Function to check if the CostAllocationUnitId exists
        function checkIfCostAllocationUnitIdExists(costAllocationUnitId) {
            return $.ajax({
                url: "/api/CostCenterMaster/CheckCostAllocationUnitId", // Create a new API endpoint
                type: "GET",
                data: { costAllocationUnitId: costAllocationUnitId },
                dataType: "json"
            });
        }

        function updateCostCenterMaster(costAllocationUnitId) {
            const costAllocationUnit = $("#CostAllocationUnit").dxTextBox("instance").option("value");
            const costAllocationGroup = $("#costCenterComboBox").dxSelectBox("instance").option("value");
            const costAllocationMasterGroup = $("#costCenterMaster1").dxSelectBox("instance").option("value");
            const costUnitRemarks = $("#CostUnitRemarks").dxTextBox("instance").option("value");
            const costCenterIncharge = $("#CostCenterIncharge").dxTextBox("instance").option("value");
            const projectMasterCode = $("#GetProjectDropDown").dxDropDownBox("instance").option("value");
            const branchCode = $("#GetBranchCodeDropDown").dxDropDownBox("instance").option("value");
            const isDisabled = $("#Discontinued").dxCheckBox("instance").option("value");



           // CreatedBy = $("#CreatedBy").dxTextBox("instance").option("value");
         // let CreatedOn = $("#CreatedOn").dxTextBox("instance").option("value"); // Get CreatedOn value
            const ModifiedBy = $("#ModifiedBy").dxTextBox("instance").option("value");
            const ModifiedOn = new Date().toISOString(); // Current date in ISO format

            // Ensure CreatedOn is a valid date or null
            //if (!CreatedOn || !Date.parse(CreatedOn)) {
             //   CreatedOn = null;  // Set CreatedOn to null if it's invalid or empty
           // }

            const data = {
                CostAllocationUnitId: costAllocationUnitId,
                CostAllocationUnit: costAllocationUnit,
                CostAllocationGroup: costAllocationGroup,
                CostAllocationMasterGroup: costAllocationMasterGroup,
                CostUnitRemarks: costUnitRemarks,
                CostCenterIncharge: costCenterIncharge,
                ProjectMasterCode: projectMasterCode,
                BranchCode: branchCode,
                IsDisabled: isDisabled,
               //CreatedBy: CreatedBy,
               //CreatedOn: CreatedOn,
                ModifiedBy: ModifiedBy,
                ModifiedOn: ModifiedOn

            };

            $.ajax({
                url: "/api/CostCenterMaster/UpdateCostCenterMaster", // Use API endpoint for update
                type: "PUT", // PUT request for updating
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (response) {
                    if (response.success) {
                        DevExpress.ui.notify(response.message, "success", 5000);
                         location.reload();
                    } else {
                        DevExpress.ui.notify(response.message, "error", 3000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("An error occurred while updating the data.", "error", 3000);
                }
            });
        }
        // Format date function
        function formatDate(date) {
            if (date) {
                const dateObj = new Date(date);
                return dateObj.toISOString().slice(0, 19).replace("T", " "); // Adjust format as needed
            }
            return '';
        }

        function saveCostCenterMaster() {
            const costAllocationUnitId = $("#CostAllocationUnitID").dxTextBox("instance").option("value");
            const costAllocationUnit = $("#CostAllocationUnit").dxTextBox("instance").option("value");
            const costAllocationGroup = $("#costCenterComboBox").dxSelectBox("instance").option("value");
            const costAllocationMasterGroup = $("#costCenterMaster1").dxSelectBox("instance").option("value");
            const costUnitRemarks = $("#CostUnitRemarks").dxTextBox("instance").option("value");
            const costCenterIncharge = $("#CostCenterIncharge").dxTextBox("instance").option("value");
            const projectMasterCode = $("#GetProjectDropDown").dxDropDownBox("instance").option("value");
            const branchCode = $("#GetBranchCodeDropDown").dxDropDownBox("instance").option("value");
            const isDisabled = $("#Discontinued").dxCheckBox("instance").option("value");
            const CreatedBy = $("#CreatedBy").dxTextBox("instance").option("value");
            // Handle CreatedOn for new records
            let CreatedOn = $("#CreatedOn").dxTextBox("instance").option("value");
            if (!CreatedOn || !Date.parse(CreatedOn)) {
                CreatedOn = new Date().toISOString(); // Set to current date if empty or invalid
            }

            // Array to hold error messages for missing fields
            let missingFields = [];

            // Validate required fields
            if (!costAllocationUnitId) {
                missingFields.push("Cost Allocation Unit ID");
            }
            if (!costAllocationUnit) {
                missingFields.push("Cost Allocation Unit");
            }
            if (!costAllocationGroup) {
                missingFields.push("Cost Allocation Group");
            }
            if (!costAllocationMasterGroup) {
                missingFields.push("Cost Allocation Master Group");
            }

            // If any required field is missing, show an error message and stop execution
            if (missingFields.length > 0) {
                DevExpress.ui.notify(
                    `Please fill in the following required fields: ${missingFields.join(", ")}`,
                    "error",
                    3000
                );
                return; // Stop execution if validation fails
            }

            // Proceed with saving if validation passes
            checkIfCostAllocationUnitIdExists(costAllocationUnitId).done(function (response) {
                if (response.exists) {
                    DevExpress.ui.notify("Cost Allocation Unit ID already exists!", "error", 3000);
                } else {
                    const data = {
                        CostAllocationUnitId: costAllocationUnitId,
                        CostAllocationUnit: costAllocationUnit,
                        CostAllocationGroup: costAllocationGroup,
                        CostAllocationMasterGroup: costAllocationMasterGroup,
                        CostUnitRemarks: costUnitRemarks,
                        CostCenterIncharge: costCenterIncharge,
                        ProjectMasterCode: projectMasterCode,
                        BranchCode: branchCode,
                        IsDisabled: isDisabled,
                        CreatedBy: CreatedBy,
                        CreatedOn: CreatedOn
                    };

                    $.ajax({
                        url: "/api/CostCenterMaster/SaveCostCenterMaster",
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(data),
                        success: function (response) {
                            if (response.success) {
                                DevExpress.ui.notify(response.message, "success", 3000);
                                // Change button label to "Update"
                              //  location.reload();
                                var button = $("#btnSave").dxButton("instance");
                                button.option("text", "Update");

                            } else {
                                DevExpress.ui.notify(response.message, "error", 3000);
                            }
                        },
                        error: function () {
                            DevExpress.ui.notify("An error occurred while saving the data.", "error", 3000);
                        }
                    });
                }
            }).fail(function () {
                DevExpress.ui.notify("Failed to check for duplicate ID.", "error", 3000);
            });
        }


        // Save/Update Button Click Event
        $("#btnSave").on("click", function () {
            if (costAllocationUnitId) {
                // If CostAllocationUnitId is present, perform update
                updateCostCenterMaster(costAllocationUnitId);
            } else {
                // Otherwise, perform save
                saveCostCenterMaster();
            }
        });
    });

    function navigateToHome() {
        window.location.href = '/Finance/ChartOfCostCenters';
    }

</script>


