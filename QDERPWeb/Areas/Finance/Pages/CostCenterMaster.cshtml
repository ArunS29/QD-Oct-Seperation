<div>
    <div id="costAllocationPopup" style="display:none;">
        <div style="margin-bottom:10px">
            @(Html.DevExtreme().Button()
                .ID("btnSaveCostAllocation")
                .Icon("save")
                .Text("Save")
                .OnClick("function() { saveCostAllocation(); }")
                )
        </div>
    </div>
    <div class="title">
        <div class="header-container" style="gap:10px;padding:10px">
            <i class="fas fa-pen-nib header-icon" style="font-size: 1.5rem; color: goldenrod;"></i>
            <div id="CostAllocationPopup" class="no-border-title">Cost Center's</div>
        </div>
    </div>
    <div class="container5">
        <div class="dx-fieldset horizontal-container ">
            <label for="CostAllocationUnitID">Cost Center Code:</label>
            @(Html.DevExtreme()
                .TextBox()
                .ID("CostAllocationUnitID")
                .Value(null)
                .Width("30%")
                .MaxLength(50)
               // .ValidationRules(value => value.AddRequired().Message(new JS("formatMessage('Account Head Name cannot be empty')")))

                )

            <label for="CostAllocationUnit">Cost Center Unit:</label>
            @(Html.DevExtreme()
                .TextBox()
                .ID("CostAllocationUnit")
                .Value(null)
                .Width("30%")
              //  .ValidationRules(value => value.AddRequired().Message(new JS("formatMessage('Account Head Name cannot be empty')")))
                )

            <label for="CostCenterGroup">Cost Center Group:</label>
            <div id="costCenterComboBox"></div>
            <label for="CostAllocationMasterGroup">Cost Center Master:</label>
            <div id="costCenterMaster1"></div>
        </div>
        <div class="dx-fieldset horizontal-container ">
            <label for="CostUnitRemarks">Cost Center Remarks:</label>
            @(Html.DevExtreme()
                .TextBox()
                .ID("CostUnitRemarks")
                .Value(null)
                .Width("100%")
                .MaxLength(250)
                )
        </div>

        <div class="dx-fieldset horizontal-container ">
            <div class="row">
                <div class="col-md-5">
                    <div class="form-group">

                        <label for="CostCenterIncharge">
                            Cost Center Incharge:
                        </label>
                        @(Html.DevExtreme().TextBox().ID("CostCenterIncharge").Value(null).Width("100%"))
                    </div>
                </div>
                @*  <div class="button-alignment-down">
                <label for="UseSubmittedDate">Received Date</label>
                @(Html.DevExtreme().CheckBox()
                .ID("UseSubmittedDate")
                )
                </div> *@
                <div class="col-md-5">
                    <div class="form-group" style="width: 120%;">
                        <label for="Branch" style=" display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: bold;">Project:</span>
                            <a class="right-text" style="color: #0398fc; text-decoration: underline;">Add from the Project</a>

                        </label>


                        @(Html.DevExtreme().DropDownBox()
                            .DataSource(d => d.WebApi()
                            .Controller("CostCenterMaster")
                            .LoadAction("GetProject")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("ProjectId")
                            )

                            .LabelMode(EditorLabelMode.Outside)
                            .ID("GetProjectDropDown")
                            @*  .ShowClearButton(true)
                        .AcceptCustomValue(true) *@
                            .OpenOnFieldClick(false)//
                            .ValueChangeEvent("input")
                            .HoverStateEnabled(true)
                            .ValueExpr("ProjectId")
                            .DisplayExpr("ProjectDescription")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("onOpened")
                            .TabIndex(1)
                            .OnKeyDown("onKeyDown")
                            //.OnValueChanged("dropDownBoxValueChanged")
                            .ContentTemplate(new TemplateName("GetProjectContentTemplate"))
                            )


                    </div>
                </div>

            </div>

            <div class="row">
                <!-- Dropdown Section -->
                <div class="col-md-5">
                    <div class="form-group" style="width: 100%;">
                        <label for="Branch">Division/Branch:</label>
                        @(Html.DevExtreme().DropDownBox()
                            .DataSource(d => d.WebApi()
                            .Controller("CostCenterMaster")
                            .LoadAction("GetBranchCode")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("Branch")
                            )
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("GetBranchCodeDropDown")
                            @*   .ShowClearButton(true)
                        .AcceptCustomValue(true) *@
                            .OpenOnFieldClick(true)//
                            .ValueChangeEvent("input")
                            .HoverStateEnabled(true)
                            .ValueExpr("BranchCode")
                            .DisplayExpr("BranchName")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("onOpened")
                            .TabIndex(1)
                            .OnKeyDown("onKeyDown")
                            .ContentTemplate(new TemplateName("GetBranchCodeContentTemplate"))
                            )
                    </div>
                </div>

                <!-- Checkbox Section -->
                <div class="col-md-6" style="margin-top:25px;">
                    <div class="form-group">
                        <label style="margin-right: 10px;color:crimson">Discontinued:</label>
                        @(Html.DevExtreme().CheckBox()
                            .ID("Discontinued")
                            )
                    </div>
                </div>
            </div>
        </div>


    </div>

</div>
