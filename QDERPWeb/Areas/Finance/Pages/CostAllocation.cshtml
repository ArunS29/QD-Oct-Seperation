                </text>);
                            columns.Add().Caption("Effective Date").DataField("EffectiveDate").AllowEditing(false);
                            columns.Add().Caption("Amount").DataField("VoucherAmount").DataType(GridColumnDataType.Number).Format("#,##0.00").AllowEditing(true);
                            columns.Add().Caption("Remarks").DataField("Remarks").AllowEditing(true);

                        })
                    //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
