@page
@model QD.ERP.Web.Areas.Finance.Pages.CostAllocationModel
@using System.Text.Json

@{
    Layout = null;
    string voucherNo = Request.Query["VoucherNo"];
    string drCr = Request.Query["DrCr"];
    string accountHead = Request.Query["AccountHead"];
    string voucherAmount = Request.Query["VoucherAmount"];
    string effectiveDate = Request.Query["EffectiveDate"];
    double? voucherAmountParsed = null;
    string voucherentryid = Request.Query["VoucherEntryID"];

    // Try parsing the voucherAmount to a nullable double
    if (!string.IsNullOrEmpty(voucherAmount))
    {
        double parsedAmount;
        if (double.TryParse(voucherAmount, out parsedAmount))
        {
            voucherAmountParsed = parsedAmount;
        }
    }

    // If voucherAmountParsed is not null, ensure it's formatted to 2 decimal places
    if (voucherAmountParsed.HasValue)
    {
        // Format the amount to 2 decimal places and then parse it back to double
        voucherAmountParsed = Math.Round(voucherAmountParsed.Value, 2);
    }

}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
