                @*  @(Html.DevExtreme().TextBox()
                .ID("ApprovedBytext")
                .Value(null)
                .Disabled(true)
                .Width("200px")
                )
                *@
                <!-- Approved On Section -->
                <div class="mt-2" style="margin-left: 40px;">
                    <span style="color:black">Approved On:</span>
                    @* @(Html.DevExtreme().TextBox()
                    .ID("ApprovedOntext")
                    .Value(null)
                    .Disabled(true)
                    .Width("200px")
                    .ElementAttr(new { style = "margin-left: 10px;" })
                    ) *@
                </div>
            </div>


            <!-- DataGrid Section -->
            <div class="dx-field ledgerResult" style="padding-top:20px">
                @(
                        Html.DevExtreme().DataGrid()
                        .ID("costdataGrid")
                        .RemoteOperations(false)
                        .RowAlternationEnabled(true)
                        .DataSource(new object[] { })
                        .Columns(columns =>
                        {
                            columns.Add().Caption("Dr/Cr").DataField("DrCr").Width(100).AllowEditing(false);
                            columns.Add().Caption("Cost Allocated (Projects/Jobs)")
                        .Width(400).AllowEditing(false)
                        .CellTemplate(@<text>
                    <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().DropDownBox()
                            .DataSource(d => d.WebApi()
                            .Controller("CostAllocation")
                            .LoadAction("GetCostAllocationUnits")
