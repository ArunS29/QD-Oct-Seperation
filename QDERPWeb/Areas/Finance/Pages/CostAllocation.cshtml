        </div>


        <div class="card-footer text-center">
            <div class="dx-fieldset horizontal-container mt-2">


                @(Html.DevExtreme().Button()
                    .ID("btnSaveAndClose")
                    .Text("Save and Close")
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    .Icon("save")
                    .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                    )

                @(Html.DevExtreme().Button()
                    .ID("btnDelete")
                    .Text("Delete")
                    .Icon("close")
                    .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                    )
                @(Html.DevExtreme().Button()
                    .ID("btncostBack")
                    .Text("Back")
                    .Icon("arrowleft")
                    .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                    )
                @(Html.DevExtreme().Button()
                    .ID("btnaddcost")
                    .Text("Add New Cost Center")
                    .Icon("plus")
                    .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                    )
            </div>
            @using (Html.DevExtreme().NamedTemplate("costAllocationDropdownContentTemplate"))
            {
                @(
                        Html.DevExtreme().DataGrid()
                        .ID("costAllocationDropdownGrid")
                        .DataSource(d => d.WebApi()
                        .Controller("CostAllocation")
                        .LoadAction("GetCostAllocationUnits")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("CostAllocationUnitId")
                        )
                        .WordWrapEnabled(true)
                        .ShowBorders(true)
                        .SearchPanel(sp => sp.HighlightSearchText(true))
                        .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                        .OnSelectionChanged("dataGridSelectionChanged")
                        .OnContentReady("onDataGridContentReady")

                        .HeaderFilter(p => p.Visible(true))
                        .ShowBorders(true)
                        .HoverStateEnabled(true)
                        .Paging(p => p.PageSize(15))
                        .FilterRow(f => f.Visible(true))
                        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                        .Height(345)
                        .Selection(s => s.Mode(SelectionMode.Single))
                        .Columns(columns =>
                        {
                            columns.Add().Caption("Cost Allocation UnitID").DataField("CostAllocationUnitId");
                            columns.Add().Caption("Cost Allocation Unit").DataField("CostAllocationUnit");
                            columns.Add().Caption("Cost Allocation Group").DataField("CostAllocationGroup");
                            columns.Add().Caption("Is Disabled").DataField("IsDisabled")
                        .CellTemplate(@<text>
                <div class="dx-icon">
                    <%= data.IsDisabled ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
                </div>
            </text>);
                        })
                    )
            }
        </div>
    </div>
    <script>


        let selectedDropDownValue = "Common Overheads"; // Default value
        let selectedCostAllocationUnitID;

        function onDropDownBoxValueChanged(e) {
            const selectedDropDownValue = e.value; // Update the selected value

            // Update the DataGrid selection to match the DropDownBox value
            const dataGrid = $("#costAllocationDropdownGrid").dxDataGrid("instance");
            if (dataGrid) {
                const items = dataGrid.getDataSource().items();
                const selectedItem = items.find(item => item.CostAllocationUnit === selectedDropDownValue);
                if (selectedItem) {
                    selectedCostAllocationUnitID = selectedItem.CostAllocationUnitId; // Store the ID
                    dataGrid.selectRows([selectedCostAllocationUnitID]);
                } else {
                    selectedCostAllocationUnitID = null; // Clear the ID if no match
                    dataGrid.clearSelection();
                }
            }
        }

        function onDataGridContentReady(e) {
            const dataGrid = e.component;

            // Ensure the DataGrid selection reflects the DropDownBox value
            const items = dataGrid.getDataSource().items();
            const selectedItem = items.find(item => item.CostAllocationUnit === selectedDropDownValue);
            if (selectedItem) {
                selectedCostAllocationUnitID = selectedItem.CostAllocationUnitId; // Update the ID
                dataGrid.selectRows([selectedCostAllocationUnitID]);
            } else {
                selectedCostAllocationUnitID = null; // Clear the ID if no match
                dataGrid.clearSelection();
            }
        }

        $(document).ready(function () {
            // Capture the initial value of the NumberBox
            const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;

            // Sample data with initial value of VoucherAmount
            const costData = [
                {
                    DrCr: '@drCr',  // Ensure @drCr is correctly rendered as a string value

                    EffectiveDate: new Date().toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                    }),
                    VoucherAmount: initialVoucherAmount.toFixed(2),
                    Remarks: ''
                }
            ];
            // alert(voucherentryid)
            // Debug to check the formatted data
            console.log('Cost Data:', costData);

            // Get the DataGrid instance
            const costdataGrid = $('#costdataGrid').dxDataGrid('instance');

            if (costdataGrid) {
                costdataGrid.option('dataSource', costData);
            }

            // Function to handle changes to the NumberBox value
            $('#CostAmount').dxNumberBox({
                valueChanged: function (e) {
                    const newVoucherAmount = e.value.toFixed(2);

                    // Update the data in the DataGrid
                    if (costdataGrid) {
                        // Find the first row (assuming only one row in this case)
                        const updatedData = [{
                            DrCr: '@drCr', // Make sure @drCr is a valid string
                            CostAllocated: '',
                            EffectiveDate: new Date().toLocaleDateString('en-GB', {
                                day: 'numeric',
                                month: 'short',
                                year: 'numeric',
                            }),
                            VoucherAmount: newVoucherAmount,
                            Remarks: 'N/A'
                        }];

                        costdataGrid.option('dataSource', updatedData);
                    }
                }
            });

            // Function to format the EffectiveDate
            function formatEffectiveDate(dateString) {
                if (!dateString) return 'N/A'; // Handle null or empty dates

                const dateObj = new Date(dateString);
                const options = { day: 'numeric', month: 'short', year: 'numeric' };
                return dateObj.toLocaleDateString('en-GB', options).replace(/ /g, '-');
            }
        });

        function dataGridSelectionChanged(e) {
            const selectedData = e.selectedRowsData[0];

            if (selectedData) {
                // Update the DropDownBox value to the selected value in the DataGrid
                const dropDownBox = $("#Costgriddropdown").dxDropDownBox("instance");
                dropDownBox.option("value", selectedData.CostAllocationUnit);

                dropDownBox.close();
            }

        }

        //       function dataGridInitialized(e) {
        // 	dataGrid = e.component;
        // }
        //       function collapseRowsIfNeeded(e) {
        //       if (!e.component.option('dataSource').length) {
        //           e.component.collapseAll();
        //       }
        //   }


        $("#btnSaveAndClose").on("click", function (e) {
            e.preventDefault();

            // Get the DataGrid instance
            const costdataGrid = $("#costdataGrid").dxDataGrid("instance");

            if (!costdataGrid) {
                DevExpress.ui.notify("DataGrid instance not found.", "error", 2000);
                return;
            }

            // Get the data from the first row of the DataGrid
            const dataGridData = costdataGrid.getDataSource().items();
            if (!dataGridData || dataGridData.length === 0) {
                DevExpress.ui.notify("No data in the grid to save.", "error", 2000);
                return;
            }

            // Extract values from the first row (you can adjust logic for multiple rows if needed)
            const firstRowData = dataGridData[0];
            const selectedCostAllocUnit = selectedCostAllocationUnitID || "ADMIN-0001"; // From dropdown column
            const remarks = firstRowData.Remarks || null; // Remarks column value
            const effectiveDate = '@effectiveDate'; // Ensure this is populated from server-side Request.Query["EffectiveDate"]

            // Extract VoucherEntryID and increment for a new entry
            const currentVoucherEntryID = parseInt($("#VoucherEntryID").val() || "1", 10); // Default to 1 if not set
            const newVoucherEntryID = currentVoucherEntryID + 1; // Increment ID

            // Construct the ViewModel object
            const VM = {
                VoucherEntryID: newVoucherEntryID,
                CostAllocationUnitID: selectedCostAllocUnit,
                EffectiveDate: new Date().toISOString().split('T')[0],
                AmountAllocated: '@voucherAmountParsed', // Ensure server-side value is correctly populated
                CostAllocRemarks: remarks,
                VoucherNo: '@voucherNo',
                CostAllocDrCr: '@drCr'
            };

            // Debug to ensure VM is correctly populated
            console.log("VM to be sent:", VM);
            // debugger;
            $.ajax({
                type: "POST",
                url: "/api/CostAllocation/SaveCostAllocation",
                contentType: "application/json",
                data: JSON.stringify(VM),
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        DevExpress.ui.notify("Cost Allocation Details updated Successfully.", "success", 2000);
                        //     window.location.reload();
                        // CostAllocationPopup.hide();
                        $("#CostAllocationModal").modal('hide');

                    } else {
                        alert("Update failed: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    DevExpress.ui.notify("Voucher has no line items to be saved, please enter transaction to save.!", "error", 2000);
                }

            });


        });

        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }
        function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }

        $(document).ready(function () {
            // Bind the click event to the Delete button
            $("#btnDelete").dxButton("instance").on("click", function () {
                // Show Swal confirmation dialog
                Swal.fire({
                    title: "Are you sure?",
                    text: "You are about to reset Cost allocation details for the voucher entry. Are you sure you want to reset the Cost Allocation?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes",
                    cancelButtonText: "No",
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // If confirmed, reset the dropdown value to "Common Overheads"
                        const dropDownBoxInstance = $("#Costgriddropdown").dxDropDownBox("instance");
                        dropDownBoxInstance.option("value", "Common Overheads");

                        // // Optionally, you can perform additional actions here (e.g., server call, logging, etc.)
                        // Swal.fire("Reset!", "Cost allocation details have been reset.", "success");
                    }
                });
            });
        });

    </script>
