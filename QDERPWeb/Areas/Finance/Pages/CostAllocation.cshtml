                    )
            </div>
            <div id="footerTotals" style="display: flex; justify-content: space-between; background-color: #F5F5F5; color: white; padding: 5px 10px; margin-top: -3px; font-size: 14px;">
                <div style="flex: 6;">&nbsp;</div> <!-- Aligns with Dr/Cr column -->
                <div style="flex: 5;">&nbsp;</div> <!-- Aligns with Account Head column -->
                <!-- TextBox for Debit -->
                <div style="flex: none; text-align: right;">
                    @(Html.DevExtreme().NumberBox()
                        .ID("totalAmountTextbox")
                        .Value(voucherAmountParsed)
                        .ReadOnly(true)
                        .Width("60%")
                        .Format("#,##0.00")
