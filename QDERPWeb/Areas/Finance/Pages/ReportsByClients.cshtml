<script>

    let dataGrid;
    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function onOpened() {
        console.log("DropDownBox opened");
    }

    function onKeyDown(event) {
        console.log("Key pressed:", event.key);
    }


    let selectedValues = []; // Array to store selected values
    function dataGridSelectionChanged1(e) {
        selectedKeys = e.selectedRowKeys; // Get all selected values
        console.log("Selected Values:", selectedValues);
       const ddbInstance = $("#GetAccountHeadDropDown").dxDropDownBox("instance");

       ddbInstance.option("value", selectedKeys); // Assign array of selected values
    }
    // Update DropDownBox value when selection changes
    function onDropDownValueChanged(e) {
        selectedValues = e.value || []; // Store selected values in the array
    }
    function dataGridInitialized1(e) {
        dataGrid = e.component;
    }


    let selectedValues1 = []; // Store selected values

    function dataGridSelectionChanged2(e) {
        selectedValues1 = e.selectedRowKeys; // Update array with selected keys
        console.log("Selected Values1:", selectedValues1);

        // Ensure DropDownBox updates correctly
        const ddbInstance = $("#GetSalesPersonDropDown").dxDropDownBox("instance");
        if (ddbInstance) {
            ddbInstance.option("value", selectedValues1);
        }
    }

      function onDropDownValueChanged1(e) {
        selectedValues1 = e.value || []; // Store selected values in the array
    }


    function dataGridInitialized2(e) {
        dataGrid = e.component;
    }
    let selectedValues2 = []; // Store selected Branch values

    function dataGridSelectionChanged3(e) {
        selectedValues2 = e.selectedRowKeys; // Update array with selected keys
        console.log("Selected Branch Records:", selectedValues2);

        // Ensure DropDownBox updates correctly
        const ddbInstance = $("#GetCompanyBranchDropDown").dxDropDownBox("instance");
        if (ddbInstance) {
            ddbInstance.option("value", selectedValues2);
        }
    }

    function dataGridInitialized3(e) {
        dataGrid = e.component;
    }
    

    async function saveGridAsPDF() {
        const dataGrid = $("#GetAccountHead-datagrid").dxDataGrid("instance");

        // Load jsPDF from the global `window.jspdf`
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        // Get selected rows
        const selectedRows = dataGrid.getSelectedRowsData();
        console.log("Selected Row:", selectedRows);

        if (selectedRows.length > 0) {
            DevExpress.pdfExporter.exportDataGrid({
                component: dataGrid,
                jsPDFDocument: doc,
                autoTableOptions: {

                    headStyles: { fontStyle: 'bold' }, // Bold headers
                    bodyStyles: { fontStyle: 'normal' },
                },
                selectedRowsOnly: true // Ensure only selected rows are exported
            }).then(() => {
                doc.save("SelectedGridData.pdf");
            });
        } else {
            alert("Please select rows to export.");
        }
    }

    // Print Grid with Selected Records
    function printGrid() {
        if (selectedValues.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }
        debugger;
        // Send selected values using POST request
        fetch("/api/ReportsByClients/GenerateReportAccountHead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues)  // Send array as JSON
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; // Redirect to report page
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }



    // Print Grid with Selected Records
    function printGrid1() {
        if (selectedValues1.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }

        // Send selected values using POST request
        fetch("/api/ReportsByClients/GenerateReportSalesPerson", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues1)  // Send array as JSON
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; // Redirect to report page
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }


    // Print Grid with Selected Records
    function printGrid2() {
        if (selectedValues2.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }

        // Send selected values using POST request
        fetch("/api/ReportsByClients/GenerateReportBranch", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues2)  // Send array as JSON
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; // Redirect to report page
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }



</script>
