@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<!-- Include jsPDF library -->
<!-- Include AutoTable plugin for table exports -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>


<style>
    .container {
        display: none !important;
        background-color:transparent;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
    }

        .dx-datagrid .dx-row {
            border-bottom: 1px solid #ccc; 

        }

    .dx-multiview-wrapper {
        flex-grow: 1;
        overflow: auto; 
    }

    .dx-tabpanel {
        height: 500px !important; 
        display: flex;
        flex-direction: column;
    }

    .dx-tabpanel .dx-tab {
        flex-shrink: 0;
        }

        .dx-tabpanel .dx-tab-panel {
            height: 600px;
            overflow-y: auto; 
        }
        

            .dx-tabpanel .dx-tab.dx-selection {
              background-color: lightblue; 
                color: white !important; 
            }

            .card{
                height:600px;
                background-color:white;
                width:580px;
            }
</style>

<div class="card">
   
    <div class="card-header" style="background-color: #c0dceb; color: black; font-weight: bold;">
        Bills Receivable Reports
    </div>

   
    @(
        Html.DevExtreme().TabPanel()
        .ID("AssetTabs")
        .Items(item =>
        {
            item.Add().Title("BillsReceivableByClient").Text("Bills Receivable By Client").Template(@<text>
        <div class="form-group">

          
            
            <label for="Branch">AccountHead:</label>
            <br />
            @(Html.DevExtreme().DropDownBox()
            .ID("GetAccountHeadDropDown")
            .DataSource(d => d.WebApi()
            .Controller("ReportsByClients")
            .LoadAction("GetAccountHead")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("AccountId")
            )
            .LabelMode(EditorLabelMode.Outside)
            .ShowClearButton(true)
            .AcceptCustomValue(true)
            .OpenOnFieldClick(true) 
            .ValueExpr("AccountId") 
            .DisplayExpr("AccountHead")
            .ContentTemplate(new TemplateName("GetAccountHeadContentTemplate"))
            .OnValueChanged("onDropDownValueChanged")
            )




        </div>

    </text>);
            item.Add().Title("BillsReceivableBySalesPerson").Text("Bills Receivable By Sales Person").Template(@<text>
        <div class="form-group">

            <label for="Branch">Sales Person:</label>
            <br />
            @(Html.DevExtreme().DropDownBox()
            .ID("GetSalesPersonDropDown")
            .DataSource(d => d.WebApi()
            .Controller("ReportsByClients")
            .LoadAction("GetSalesPerson")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("SalesPersonCode")
            )
            .LabelMode(EditorLabelMode.Outside)
            .ShowClearButton(true)
            .AcceptCustomValue(true)
            .OpenOnFieldClick(true) 
            .ValueExpr("SalesPersonCode") 
            .DisplayExpr("SalesPersonName")
            .ContentTemplate(new TemplateName("GetSalesPersonContentTemplate"))
            )


        </div>

    </text>);
            item.Add().Title("BillsReceivableByBranch").Text("Bills Receivable By Branch/Division").Template(@<text>

        <div class="form-group">

            <label for="Branch">Division/Branch:</label>
            <br />
            @(Html.DevExtreme().DropDownBox()
            .ID("GetCompanyBranchDropDown")
            .DataSource(d => d.WebApi()
            .Controller("ReportsByClients")
            .LoadAction("GetCompanyBranch")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("BranchCode")
            )
            .LabelMode(EditorLabelMode.Outside)
            .ShowClearButton(true)
            .AcceptCustomValue(true)
            .OpenOnFieldClick(true) 
            .ValueExpr("BranchCode") 
            .DisplayExpr("BranchName")
            .ContentTemplate(new TemplateName("GetCompanyBranchContentTemplate"))
            )


        </div>


    </text>
        );
        })
        )
</div>


@using (Html.DevExtreme().NamedTemplate("GetAccountHeadContentTemplate"))
{

    @(Html.DevExtreme().DataGrid()
                .ID("GetAccountHead-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("ReportsByClients")
                .LoadAction("GetAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )
                .ShowBorders(true)
                .SearchPanel(sp => sp
                .Visible(true)  
                .HighlightSearchText(true)
                )
                .Selection(sl => sl
                .Mode(SelectionMode.Multiple)  
                .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always) 
                )
                .OnSelectionChanged("dataGridSelectionChanged1")    
                .Paging(p => p.PageSize(15))
                .Scrolling(s => s.Mode(GridScrollingMode.Virtual)) 
                .Height(400)
                .Columns(columns =>
                {
                    columns.Add().DataField("AccountHead").Caption("Account Name");
                })
                )
    
}
<div class="toolbar-container">
    <div id="gridToolbar">
        @(Html.DevExtreme().Button()
            .Text("Save as PDF")
            .Icon("exportpdf")
            .OnClick("saveGridAsPDF")
            )
        @(Html.DevExtreme().Button()
            .Text("Print")
            .Icon("print")
            .OnClick("printGrid")
            )
    </div>
</div>
@using (Html.DevExtreme().NamedTemplate("GetSalesPersonContentTemplate"))
{

    @(Html.DevExtreme().DataGrid()
                .ID("GetSalesPerson-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("ReportsByClients")
                .LoadAction("GetSalesPerson")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("SalesPersonCode")
                )
                .ShowBorders(true)
                .SearchPanel(sp => sp
                .Visible(true)  
                .HighlightSearchText(true)
                )
                .Selection(sl => sl
                .Mode(SelectionMode.Multiple)  
                .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always) 
                )
                .OnSelectionChanged("dataGridSelectionChanged2") 
                .Paging(p => p.PageSize(15))
                .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                .Height(400)
                .Columns(columns =>
                {
                    columns.Add().DataField("SalesPersonName").Caption("SalesPerson Name");
                })
                )

}
@using (Html.DevExtreme().NamedTemplate("GetCompanyBranchContentTemplate"))
{

    @(Html.DevExtreme().DataGrid()
                        .ID("GetCompanyBranch-datagrid")
                    .DataSource(d => d.WebApi()
                    .Controller("ReportsByClients")
                        .LoadAction("GetCompanyBranch")
                    .LoadMode(DataSourceLoadMode.Raw)
                        .Key("BranchCode")
                    )
                    .ShowBorders(true)
                    .SearchPanel(sp => sp
                    .Visible(true)  
                    .HighlightSearchText(true)
                    )
                    .Selection(sl => sl
                    .Mode(SelectionMode.Multiple)  
                    .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always) 
                    )
                    .OnSelectionChanged("dataGridSelectionChanged3") 
                    .Paging(p => p.PageSize(15))
                    .Scrolling(s => s.Mode(GridScrollingMode.Virtual)) 
                    .Height(400)
                    .Columns(columns =>
                    {
                        columns.Add().DataField("BranchName").Caption("Branch Name");
                    })
                    )

}


<script>

    let dataGrid;
    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function onOpened() {
        console.log("DropDownBox opened");
    }

    function onKeyDown(event) {
        console.log("Key pressed:", event.key);
    }


    let selectedValues = []; 
    function dataGridSelectionChanged1(e) {
        selectedKeys = e.selectedRowKeys; 
        console.log("Selected Values:", selectedValues);
       const ddbInstance = $("#GetAccountHeadDropDown").dxDropDownBox("instance");

       ddbInstance.option("value", selectedKeys); 
    }
    function onDropDownValueChanged(e) {
        selectedValues = e.value || []; 
    }
    function dataGridInitialized1(e) {
        dataGrid = e.component;
    }


    let selectedValues1 = []; 

    function dataGridSelectionChanged2(e) {
        selectedValues1 = e.selectedRowKeys; 
        console.log("Selected Values1:", selectedValues1);
        const ddbInstance = $("#GetSalesPersonDropDown").dxDropDownBox("instance");
        if (ddbInstance) {
            ddbInstance.option("value", selectedValues1);
        }
    }

      function onDropDownValueChanged1(e) {
        selectedValues1 = e.value || []; 
    }


    function dataGridInitialized2(e) {
        dataGrid = e.component;
    }
    let selectedValues2 = []; 

    function dataGridSelectionChanged3(e) {
        selectedValues2 = e.selectedRowKeys; 
        console.log("Selected Branch Records:", selectedValues2);
        const ddbInstance = $("#GetCompanyBranchDropDown").dxDropDownBox("instance");
        if (ddbInstance) {
            ddbInstance.option("value", selectedValues2);
        }
    }

    function dataGridInitialized3(e) {
        dataGrid = e.component;
    }


    function saveGridAsPDF() {
        if (selectedValues.length === 0) {
            alert("Please select at least one record.");
            return;
        }

        const reportName = "XtraRecivableReport";

        
        const selectedParams = selectedValues.map(val => `selectedValues=${encodeURIComponent(val)}`).join('&');

            
        const reportUrl = `/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}&${selectedParams}`;

        
        window.open(reportUrl, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
    }
    function printGrid() {
        if (selectedValues.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }
            fetch("/api/ReportsByClients/GenerateReportAccountHead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues)  
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; 
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }
    function printGrid1() {
        if (selectedValues1.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }
        fetch("/api/ReportsByClients/GenerateReportSalesPerson", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues1) 
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; 
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }
    function printGrid2() {
        if (selectedValues2.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }
        fetch("/api/ReportsByClients/GenerateReportBranch", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues2)  
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; 
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }



</script>
