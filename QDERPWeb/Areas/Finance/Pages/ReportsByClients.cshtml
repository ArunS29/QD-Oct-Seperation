    function downloadSelectedReport() {
        let selectedParams = "";

        if (selectedValues.length > 0) {
            selectedParams = selectedValues.map(val => `selectedValues=${encodeURIComponent(val)}`).join('&');
        } else if (selectedValues1.length > 0) {
            selectedParams = selectedValues1.map(val => `selectedValues=${encodeURIComponent(val)}`).join('&');
        } else if (selectedValues2.length > 0) {
            selectedParams = selectedValues2.map(val => `selectedValues=${encodeURIComponent(val)}`).join('&');
        } else {
            alert("Please select at least one record.");
            return;
        }

        const reportName = "XtraRecivableReport"; // Change as needed
        const downloadUrl = `/api/Report/Download?reportName=${encodeURIComponent(reportName)}&${selectedParams}`;

        // Trigger direct download
        window.location.href = downloadUrl;
    }

    function saveGridAsPDF() {
        let selectedParams = "";

        if (selectedValues.length > 0) {
            selectedParams = selectedValues.map(val => `selectedValues=${encodeURIComponent(val)}`).join('&');
        } else if (selectedValues1.length > 0) {
            selectedParams = selectedValues1.map(val => `selectedValues=${encodeURIComponent(val)}`).join('&');
        } else if (selectedValues2.length > 0) {
            selectedParams = selectedValues2.map(val => `selectedValues=${encodeURIComponent(val)}`).join('&');
        } else {
            alert("Please select at least one record.");
            return;
        }

        const reportName = "XtraRecivableReport";
        const reportUrl = `/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}&${selectedParams}`;

        window.open(reportUrl, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
    }

    function printGrid() {
        if (selectedValues.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }
            fetch("/api/ReportsByClients/GenerateReportAccountHead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues)  
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; 
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }
