@page
@using QD.ERP.Web.DAL.Entities
@{

}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<style type="text/css">
    .cards-container-title {
        text-align: left;
        font-size: 2rem;
        margin-bottom: 10px;
        color: white;
       /*  background-color: black; */
        padding: 5px;

    }

    .card {
        border: 1px solid #ddd;
        border-radius: 2px;
        /* box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); */
        background-color: black;
         color: white;
        width: 100%;
        padding: 0px;
        box-sizing: border-box;
    }

    /* Override Bootstrap padding/margin if necessary */
    .container {
       /*  max-width: 65%; */
         width: 100%;
        padding: 20px;
        margin: 0 auto;
        background-color: #595959;
    }
     .horizontal-container {
        display: flex;
        gap: 5px; /* Adds spacing between fields */
        justify-content: start;
        align-items: center;
        margin: 5px 0;
    }

</style>
<h2 id="EmployeeSalaryPayables" class="cards-container-title"></h2>

<div class="container my-3">
    <div class="row g-3">
        <div class="col-12">
            <div class="card p-3 shadow-sm bg-blue text-danger" style="background-color: #B4E1F5;">

                <!-- Row for Voucher Entry ID, Payment Account, Amount, Dr/Cr, Salary Paid -->
                <div class="row mb-3">
                    <!-- Voucher Entry ID -->
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessge('Voucher Entry ID')"))
                            .LabelMode(EditorLabelMode.Outside)
                                .ID("VoucherEntryID")
                                .Value(null)
                                .Disabled(true)
                                .Width("100%"))
                    </div>

                    <!-- Payment Account -->
                    <div class="col-md-3">
                        @(Html.DevExtreme().DropDownBox()
                            .Label(new JS("formatMessge('Payment Account')"))
                                .DataSource(d => d.WebApi()
                                    .Controller("LedgerAccoutMaster")
                                    .LoadAction("GetPaymentAccounts")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("AccountId"))
                                .LabelMode(EditorLabelMode.Outside)
                                .ID("accountDropDownBox")
                                .ShowClearButton(true)
                                .AcceptCustomValue(true)
                                .OpenOnFieldClick(false)
                                .ValueChangeEvent("input")
                                .HoverStateEnabled(true)
                                .ValueExpr("AccountId")
                                .DisplayExpr("AccountHead")
                                .Width("100%")
                                .Disabled(true)
                                .ContentTemplate(new TemplateName("PaymentAmountContentTemplate")))
                    </div>

                    <!-- Add Button 1 -->
                    <div class="col-md-1 d-flex align-items-end">
                        @(Html.DevExtreme().Button()
                                .ID("PayAddAHead")
                                .Icon("plus")
                                .Width("100%")
                                     .Disabled(true))
                    </div>

                    <!-- Amount -->
                    <div class="col-md-2">
                        @(Html.DevExtreme().NumberBox()
                            .Label(new JS("formatMessge('Amount')"))
                            .LabelMode(EditorLabelMode.Outside)
                                .ID("txtVoucherAmount")
                                .Value(null)
                                .ValidationRules(rules =>
                                {
                                rules.AddRequired().Message(new JS("formatMessge('Voucher Amount is required')"));
                                rules.AddRange().Min(0).Message(new JS("formatMessge('Voucher Amount cannot be negative')"));
                                })
                                .Placeholder("0.000")
                                .Format("#,##0.000")
                                .InputAttr(new { style = "text-align: right;" })
                                .Min(0)
                                .Width("100%")
                                     .Disabled(true))
                    </div>

                    <!-- Dr/Cr -->
                    <div class="col-md-2">
                        @(Html.DevExtreme().SelectBox()
                            .Label(new JS("formatMessge('Dr/Cr')"))
                            .LabelMode(EditorLabelMode.Outside)
                                .ID("sbDrCr")
                                .DataSource(new[] { "Dr", "Cr" })
                                .Value("Dr")
                                .Placeholder(new JS("formatMessage('Select Transaction Type')"))
                                .Width("100%"))
                    </div>

                    <!-- Salary Paid -->
                    <div class="col-md-2">
                        @(Html.DevExtreme().SelectBox()
                            .Label(new JS("formatMessge('Reference')"))
                            .LabelMode(EditorLabelMode.Outside)
                                .ID("SalaryPaid")
                                .DataSource(new[] { "Salary Paid", "Salary Payable" })
                                .Value("Salary Paid")
                            .Placeholder(new JS("formatMessge('Select Reference Type')"))
                                .Width("100%"))
                    </div>
                </div>
            </div>
        </div>

        <!-- Card -->
        <div class="col-12">
            <div class="card p-3 shadow-sm">
                <!-- Row for Employee, Buttons, Payable, Amount, Add Button -->
                <div class="row mb-3 align-items-end">
                    <!-- Employee Dropdown -->
                    <div class="col-md-3">
                        @(Html.DevExtreme().DropDownBox()
                            .Label(new JS("formatMessge('Select the Employee')"))
                                .DataSource(d => d.WebApi()
                                    .Controller("LedgerAccountMaster")
                                    .LoadAction("GetEmployeeDetails")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("EmployeeNo"))
                                          .ValidationRules(rules => {   
                                              rules.AddRequired()
                                             .Message(new JS("formatMessage('Employee details is required')"));
                                                                            })
                                .LabelMode(EditorLabelMode.Outside)
                                .ID("accountEmployeeDropDownBox")
                                .ShowClearButton(true)
                                .AcceptCustomValue(true)
                                .Width("100%")
                                     .OpenOnFieldClick(false)
                                            .ValueChangeEvent("input")
                                            .HoverStateEnabled(true)
                                                    .ValueExpr("EmployeeNo")
                                                    .DisplayExpr("EmployeeName")
                                            .OnInput("dropDownBoxOnInput")
                                                .OnOpened("onOpened")
                                                .OnKeyDown("onKeyDown")
                                                    .TabIndex(1)
                                                .DropDownOptions(o => o
                                                .Width(1000)
                                                )
                                                    //.OnValueChanged("dropDownBoxValueChanged")
                                                        .ContentTemplate(new TemplateName("EmployeeContentTemplate")))
                    </div>

                    <!-- Add Button 1 -->
                    <div class="col-md-1 d-flex align-items-end">
                        @(Html.DevExtreme().Button()
                                .ID("btnAddAHead")
                                .Icon("plus")
                                .Width("100%"))
                    </div>

                    <!-- Against Payable For -->
                    <div class="col-md-3">
                        @(Html.DevExtreme().DropDownBox()
                            .Label(new JS("formatMessge('Against Payable For')"))
                                .DataSource(d => d.WebApi()
                                    .Controller("LedgerAccountMaster")
                                    .LoadAction("GetAgainstPayable")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("EmployeeNo"))
                                        .ValidationRules(rules =>
                                                                  {
                                                                        rules.AddRequired()
                                                                        .Message(new JS("formatMessage('Against Payable is required')"));
                                                                    })
                                .LabelMode(EditorLabelMode.Outside)
                                .ID("againstDropDownBoxPayable")
                                .ShowClearButton(true)
                                .AcceptCustomValue(true)
                                    .OpenOnFieldClick(false)
                                                 .ValueChangeEvent("input")
                                                 .HoverStateEnabled(true)
                                                    .ValueExpr("EmployeeNo")
                                                      .DisplayExpr("ReferenceNo")
                                                    .OnInput("dropDownBoxOnInput")
                                                    .OnOpened("onOpened")
                                .Width("100%")
                                      .OnKeyDown("onKeyDown")
                                                    .TabIndex(1)
                                                .DropDownOptions(o => o
                                                .Width(1000)
                                                )
                                          .ContentTemplate(new TemplateName("AgainstPayableContentTemplate")))
                    </div>

                    <!-- Add Button 2 -->
                    <div class="col-md-1 d-flex align-items-end">
                        @(Html.DevExtreme().Button()
                                .ID("btnAddAHead1")
                                .Icon("plus")
                                .Width("100%"))
                    </div>

                    <!-- Amount Field -->
                       <div class="col-md-2">
                        @(
                                                    Html.DevExtreme().NumberBox()
                            .Label(new JS("formatMessge('Amount')"))
                            .LabelMode(EditorLabelMode.Outside)
                                                    .ID("txtVoucherAmount1")
                                                    .Value(null)
                                                    .ValidationRules(rules =>
                                                    {
                                                        rules.AddRequired()
                                .Message(new JS("formatMessge('Voucher Amount is required')"));
                                rules.AddRange().Min(0).Message(new JS("formatMessge('Voucher Amount cannot be negative')"));
                                                    })
                                                    .Placeholder("0.000")
                                                         .Format("###,###,###,##0.00")  // Numeric format with thousands separator and two decimal places
                                                .InputAttr(new { type = "number", step = "0.01", style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;", maxLength = 16, autocomplete = "off" })
                                                             .Width("100%")// HTML attribute to allow decimal input
                                                    )

        </div>
                  
                        

                    <!-- Add Voucher Entry Button -->
                    <div class="col-md-2 d-flex align-items-end">
                        @(Html.DevExtreme().Button()
                                .ID("btnVoucherEntry")
                                .Text(new JS("formatMessage('ADD')"))
                                .Icon("plus")
                                .Width("100%")
                                     .OnClick("function() { addVoucherEntry(); }"))
                    </div>
                </div>
 <!-- DataGrid -->
                <div>
                    @(Html.DevExtreme().DataGrid<QD.ERP.Web.Areas.Finance.Models.CombinedEntityViewModel>()
       // PaymentForm.DAL.Entities.Tbl20114SalaryPayableMaster
                            .ID("dataGrid")
                            .RemoteOperations(false)
                            .Columns(columns =>
                            {
                            columns.AddFor(m => m.SalaryPayableLedgerNo).Caption(new JS("formatMessge('Salary Payable Ledger')")).Alignment(HorizontalAlignment.Center);
                            columns.AddFor(m => m.ReferenceType).Caption(new JS("formatMessge('Reference Type')")).Alignment(HorizontalAlignment.Center);
                            columns.AddFor(m => m.ReferenceNo).Caption(new JS("formatMessge('Reference No')")).Alignment(HorizontalAlignment.Center);
                            columns.AddFor(m => m.EmployeeNo).Caption(new JS("formatMessge('Employee ID')")).Alignment(HorizontalAlignment.Center);
                            columns.AddFor(m => m.EmployeeName).Caption(new JS("formatMessge('Employee Name')")).Alignment(HorizontalAlignment.Center);
                            columns.AddFor(m => m.Amount).Caption(new JS("formatMessge('Amount')"));
                            columns.AddFor(m => m.DrCr).Caption(new JS("formatMessge('Dr/Cr')")).Alignment(HorizontalAlignment.Center);
                            })
                            .AllowColumnReordering(true)
                            .AllowColumnResizing(true)
                            .ColumnFixing(fixing => fixing.Enabled(true))
                            .HeaderFilter(filter => filter.Visible(true))
                            .Height(250)
                            .ColumnAutoWidth(true)
                            .FilterRow(filterRow => filterRow.Visible(true))
                            //.FilterBuilderPopup(popup => popup.Position(pos => pos.Of("#dataGrid").At("left top").My("left top")))
                            .GroupPanel(groupPanel => groupPanel.Visible(false))
                            .ShowBorders(true)
                            .Width("100%"))
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-3 d-flex justify-content-between">
                @(Html.DevExtreme().Button()
                        .ID("btnPreview")
                    .Text(new JS("formatMessge('Preview')"))
                        .Icon("fullscreen"))

                @(Html.DevExtreme().Button()
                        .ID("btnBack")
                    .Text(new JS("formatMessge('Back')"))
                        .Icon("arrowleft"))
            </div>
        </div>
