            if (selectedKey) {

                ddbInstance.option("value", selectedKey);
                if (ddbInstance.option("opened")) {
                    ddbInstance.close();
                }
            const voucherAmountBox = $("#txtVoucherAmount1").dxNumberBox("instance");
            voucherAmountBox.option("value", payableAmount);
            }

        }

