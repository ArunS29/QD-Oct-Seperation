     $(document).ready(function () {
    // Retrieve VoucherNo from query parameters
    const urlParams = new URLSearchParams(window.location.search);
    const voucherNo = urlParams.get('VoucherNo');
    const paymentamount = urlParams.get('PaymentAmount');
    const amount = urlParams.get('Amount');
         const aid = urlParams.get('AccountHeadID');
         accheadid = aid;

    if (voucherNo) {
        // Wait for DevExtreme TextBox to initialize
        const interval = setInterval(() => {
            const voucherEntryIDInstance = $("#VoucherEntryID").dxTextBox("instance");
             const voucheramountIDInstance = $("#txtVoucherAmount").dxNumberBox("instance");
            if (voucherEntryIDInstance) {
                // Set the value and stop the interval
                voucherEntryIDInstance.option("value", voucherNo);
                 dataGridSelectionChanged({ selectedRowKeys: [paymentamount] });
                  voucheramountIDInstance.option("value", amount);
                clearInterval(interval);
            }
        }, 100); // Retry every 100ms
    }
});


    $("#AMbtnSave").on("click", function (e) {
        e.preventDefault();

        // debugger;
        var VM = {
            // alert($("#VoucherNo").dxTextBox("instance").option("value"));
            "AccountGroupId": $("#AccountGroupID").dxTextBox("instance").option("value"),

            "AccountGroup": $("#AccountGroup").dxTextBox("instance").option("value"),

            "AccountMaster": $("#accountMasterDropDownBox").dxDropDownBox("instance").option("value"),

            "AccountGroupIDAr": $("#AccountGroupID1").dxTextBox("instance").option("value"),
            "AccountGroupAr": $("#AccountGroup1").dxTextBox("instance").option("value"),
            "AccountMasterAr": $("#accountDropDownBoxArabic").dxDropDownBox("instance").option("value"),
            "AccountGroupUnder": mARresponse

        };

        $.ajax({
            type: "POST",
            url: "/api/LedgerAccountMaster/SaveLedgerMasterDetails",
            contentType: "application/json",
            data: JSON.stringify(VM),
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    alert("Data saved successfully..");
                 //   window.location.href = "http://localhost:5000/";

                } else {
                    alert("Update failed: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert("Error occurred while updating data: " + error);
            }
        });
    });

    $("#btnBack").on("click", function (e) {
        e.preventDefault();
        alert("Are you sure want to exit?");
        window.location.href = "http://localhost:5000/";
        // debugger;
    });


        function addCostAllocation() {
            $("#costAllocationPopup").dxPopup("instance").show();
        }
        function saveCostAllocation() {
            $("#costAllocationPopup").dxPopup("instance").close();
        }
        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }

        function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }

        //debugger;

