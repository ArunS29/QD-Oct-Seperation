@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }



    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    S

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .card {
        background-color: #c0dceb;
    }

    .dx-datagrid-pager .dx-page.dx-selection,
    .pagination .active a {
        color: black !important; /* Set the active page number to yellow */
        font-weight: bold; /* Optional: Make the active page bold */
    }

    .button-alignment-down {
        margin-bottom: 10px
    }

    .dx-field {
        background-color: whitesmoke;
    }

    .card-footer {
        background-color: #c0dceb;
    }

    .card-header {
        background-color: #124eb0; /* Sets the background color to blue */
        color: white; /* Changes the text color to white for contrast */
        text-align: right; /* Aligns the text to the right */
        padding: 20px; /* Adds some padding around the text */
        font-weight: bold;
        padding-right: 20px;
    }

    .left-text {
        color: blue; /* Sets the text color to blue */
        text-decoration: underline; /* Underlines the text */
        margin-right: 20px;
    }

    .col-md-6 {
        margin-top: 20px; /* Adjust this value to control the space */
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }
</style>


<div class="card">
    <div class="content-container-top">
        <div class="container-fluid"></div>


        <div class="card-header">Finance Management : Dashboard</div>
        <div class="container">
            <div class="row">
                <!-- Left Text Section -->
                <div class="col-md-6" style="padding-top: 10px; padding-bottom: 10px;">
                    <h4 class="left-text">Bills Payable</h4>
                </div>

                <!-- Right Button Section -->
                <div class="form-group col-md-6" style="padding-top: 10px; padding-bottom: 10px; text-align: right;">
                    <div>
                        @(Html.DevExtreme().Button()
                            .ID("btnBillsWithBalance")
                            .Text("Show All Bills(Only with Balance)")
                            .Height(30)
                            .Width(350)
                            .Icon("checklist")
                            .OnClick("function() { switchButtons('btnBillsWithBalance'); }")
                            )
                    </div>

                    <div>
                        @(Html.DevExtreme().Button()
                            .ID("btnBillsFullyPaid")
                            .Text("Show Bills Receivable(Including fully Paid)")
                            .Height(30)
                            .Width(350)
                            .Icon("checklist")
                            .Visible(false)//Initially hidden
                            .OnClick("function() { switchButtons('btnBillsFullyPaid'); }")
                            )
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dx-field ledgerResult" style="overflow: hidden;">

        @(
                Html.DevExtreme().DataGrid<Qry201SubLedgerPayablesMaster>()

                .ID("dataGrid")

                .DataSource(ds => ds.Mvc()

                .Controller("BillsPayable") // Specify the controller name

                .LoadAction("Get")) // Specify the action that returns data



                .RemoteOperations(false) // Enable remote data operations


                .Columns(columns =>

                {
                    // Grid Band: Bills Payable
                    columns.Add().Caption("Bills Payable").Columns(band =>
                {

                    band.AddFor(m => m.AccountHeadNo).Alignment(HorizontalAlignment.Center)
                .Width(120);

                    // Account Head column
                    band.AddFor(m => m.AccountHead)
                .Caption("Ledger Account")
                .Alignment(HorizontalAlignment.Left)
                .Width(200);

                    // Account Head column
                    band.AddFor(m => m.AccountHead)
                .Caption("Ledger Account")
                .Alignment(HorizontalAlignment.Left)
                .Width(200)
                .GroupIndex(0); // Group by this column



                    band.AddFor(m => m.ReferenceNo).Alignment(HorizontalAlignment.Center)
                .Width(120).CellTemplate(@<text>
            <a href="/Finance/PurchaseVoucher?VoucherNo=<%-data.ReferenceNo%>" target="_blank"> <%-data.ReferenceNo%></a>
        </text>);

                    band.AddFor(m => m.VoucherDate).Alignment(HorizontalAlignment.Center)
            .Width(120).Format(format => format
            .Type(Format.ShortDate)
            .Formatter("function(value) { return DevExpress.localization.formatDate(new Date(value), 'dd-MMM-yyyy'); }"));


                    band.AddFor(m => m.VoucherRefNo).Alignment(HorizontalAlignment.Center)
            .Width(150);

                    band.AddFor(m => m.InvoiceAmountBeforeRetention)
            .Caption("Invoice Amount")
            .Alignment(HorizontalAlignment.Right)
            .Width(140)
            .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        let positiveValue = Math.abs(e.value); // Convert to positive
        let formattedValue = positiveValue.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        return '(' + formattedValue + ')'; // Add parentheses around the value
        }
        ");



                    band.AddFor(m => m.Paid).Alignment(HorizontalAlignment.Right)
            .Width(140).CustomizeText(@"
        function(e) {
        if(e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        return e.value.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }
        "); band.AddFor(m => m.Balance)
            .Alignment(HorizontalAlignment.Right)
            .Width(140)
            .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        let positiveValue = Math.abs(e.value); // Convert to positive
        let formattedValue = positiveValue.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        return '(' + formattedValue + ')'; // Add parentheses around the value
        }
        ");

                    band.AddFor(m => m.InvoiceDueDate).Alignment(HorizontalAlignment.Center)
            .Width(120).Format(format => format
            .Type(Format.ShortDate)
            .Formatter("function(value) { return DevExpress.localization.formatDate(new Date(value), 'dd-MMM-yyyy'); }"))
            ;
                    band.AddFor(m => m.NoOfDaysCreditPeriod).Alignment(HorizontalAlignment.Center)
            .Width(100);
                    band.AddFor(m => m.OverdueDays).Alignment(HorizontalAlignment.Center)
            .Width(100);
                });
                })


            .Paging(p => p.PageSize(10))

            .AllowColumnReordering(true) // Enable column reordering

            .AllowColumnResizing(true)   // Enable column resizing

            .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)

            .HeaderFilter(filter => filter.Visible(true))

            .Height(600)

            .ColumnAutoWidth(true)
            .WordWrapEnabled(false)
            .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
            .Grouping(grouping => grouping.AutoExpandAll(true))
            .GroupPanel(groupPanel => groupPanel.Visible(false))

            .ShowBorders(true)

            .Width("100%")
            .Summary(summary =>
            {
                // Group-level summaries (for each group footer)
                summary.GroupItems(items =>
                {
                    items.Add().Column("VoucherRefNo")
                .SummaryType(SummaryType.Count)
                .ShowInGroupFooter(true)
                .DisplayFormat("No of Invoices: {0}");


                    items.Add().Column("InvoiceAmountBeforeRetention")
                .SummaryType(SummaryType.Sum)
                .ShowInGroupFooter(true)
                .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        let positiveValue = Math.abs(e.value); // Convert to positive
        let formattedValue = positiveValue.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        return '(' + formattedValue + ')'; // Add parentheses around the value
        }
        ");
                    items.Add().Column("Paid")
                .SummaryType(SummaryType.Sum)
                .ShowInGroupFooter(true)
                .CustomizeText(@"
        function(e) {
        if(e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        return e.value.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }
        ");
                    items.Add().Column("Balance")
                .SummaryType(SummaryType.Sum)
                .ShowInGroupFooter(true)
                .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        let positiveValue = Math.abs(e.value); // Convert to positive
        let formattedValue = positiveValue.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        return '(' + formattedValue + ')'; // Add parentheses around the value
        }
        ");


                });

                // Total summary (for grid-wide totals)
                summary.TotalItems(items =>
                {
                    items.Add().Column("VoucherRefNo")
                .SummaryType(SummaryType.Count)
                .DisplayFormat("No of Invoices: {0}");


                    items.Add().Column("InvoiceAmountBeforeRetention")
                .SummaryType(SummaryType.Sum)
                .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        let positiveValue = Math.abs(e.value); // Convert to positive
        let formattedValue = positiveValue.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        return '(' + formattedValue + ')'; // Add parentheses around the value
        }
        ");

                    items.Add().Column("Paid")
                .SummaryType(SummaryType.Sum)
                .CustomizeText(@"
        function(e) {
        if(e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        return e.value.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }
        ");

                    items.Add().Column("Balance")
                .SummaryType(SummaryType.Sum)
                .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        let positiveValue = Math.abs(e.value); // Convert to positive
        let formattedValue = positiveValue.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        return '(' + formattedValue + ')'; // Add parentheses around the value
        }
        ");

                });
            })


            // Store the DataGrid instance
            .OnInitialized("dataGridInitialized")
            .OnContextMenuPreparing("onContextMenuPreparing") // Bind the context menu event
            )

    </div>



    <div class="card-footer">
        @await Html.PartialAsync("_GridFooter2")
    </div>

</div>

<script>
    let dataGrid; // Global reference to the DataGrid instance

    // Initialize the DataGrid and store its instance
    function dataGridInitialized(e) {
        dataGrid = e.component;
    }

    function switchButtons(buttonId) {
        let hideBtn, showBtn, filterType;

        // Determine which buttons to toggle and set the filter type
        if (buttonId === "btnBillsWithBalance") {
            showBtn = "btnBillsFullyPaid";
            hideBtn = "btnBillsWithBalance";
            filterType = "WithBalance"; // Filter: Balance > 0
        } else if (buttonId === "btnBillsFullyPaid") {
            showBtn = "btnBillsWithBalance";
            hideBtn = "btnBillsFullyPaid";
            filterType = "FullyPaid"; // Filter: Balance = 0
        }

        // Use DevExtreme APIs to toggle button visibility
        const hideButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(hideBtn));
        const showButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(showBtn));

        hideButtonInstance.option("visible", false);
        showButtonInstance.option("visible", true);

        // Reload the DataGrid with the appropriate filter based on the button clicked
        if (dataGrid) {
            dataGrid.option("dataSource", {
                load: function () {
                    return $.getJSON("/Finance/api/BillsPayable/Get", { filterType: filterType });
                }
            });
            dataGrid.refresh();
        }
    }


    function onContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") { // Only for data rows
            e.items = [
                {
                    text: "View Ledger Transactions",
                    onItemClick: function () {
                        // Navigate to frm201LedgerView with the selected client details
                        const clientID = e.row.data.AccountHeadNo; // Example: Assuming AccountHeadNo is the client identifier
                        const url = `/Finance/frm201LedgerView?clientID=${clientID}`;
                        window.open(url, '_blank'); // Opens in a new tab
                    }
                }
            ];
        }
    }
</script>
