            .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let positiveValue = Math.abs(e.value);
    let formattedValue = positiveValue.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ')';
    }
    ");
            });
        })
        .OnInitialized("dataGridInitialized")
        .OnOptionChanged("handleGridOptionChanged")
        .OnContentReady("function(e) { handleGridContentReady(e); }")
        
        )

    </div>
</div>

    


<script>
    $(function () {

										$("#FinanceManagementDashboard").dxTextBox({
													text:formatMessage("Finance Management : Dashboard"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
    $(function () {

										$("#BillsPayable").dxTextBox({
													text:formatMessage("Bills Payable"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
    let dataGrid; // Global reference to the DataGrid instance

    // Initialize the DataGrid and store its instance
    function dataGridInitialized(e) {
        dataGrid = e.component;
    }

    function switchButtons(buttonId) {
        let hideBtn, showBtn, filterType;

        // Determine which buttons to toggle and set the filter type
        if (buttonId === "btnBillsWithBalance") {
            showBtn = "btnBillsFullyPaid";
            hideBtn = "btnBillsWithBalance";
            filterType = "WithBalance"; // Filter: Balance > 0
        } else if (buttonId === "btnBillsFullyPaid") {
            showBtn = "btnBillsWithBalance";
            hideBtn = "btnBillsFullyPaid";
            filterType = "FullyPaid"; // Filter: Balance = 0
        }

        // Use DevExtreme APIs to toggle button visibility
        const hideButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(hideBtn));
        const showButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(showBtn));

        hideButtonInstance.option("visible", false);
        showButtonInstance.option("visible", true);

        // Reload the DataGrid with the appropriate filter based on the button clicked
        if (dataGrid) {
            dataGrid.option("dataSource", {
                load: function () {
                    return $.getJSON(`/api/BillsPayable/Get`, { filterType: filterType });
                }
            });
            dataGrid.refresh();
        }
    }

        function handleGridOptionChanged(e) {
        if (e.name === "columns" || e.name === "visible") {
            // Columns changed, so re-inject SVG
            injectHeaderSVG(); // slight delay to wait for DOM re-render
        }
    }
    function injectHeaderSVG() {
               $.ajax({
                   url: '/api/AccountingLedgers/GetCurrencyIcon',
                   type: 'GET',
                   success: function (response) {

                       let svgIcon = response.Icon;
                       if (!svgIcon) return;

                       // Set default width/height for SVG if needed
                       if (svgIcon.startsWith("<svg")) {
                           svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);
                       } else {
                           // If symbol is text (e.g., "$" or "SAR"), wrap in styled span
                           svgIcon = `<span style="font-weight: bold;">${svgIcon}</span>`;
                       }

                       let $grid = $('#dataGrid');
                       let gridInstance = $grid.dxDataGrid("instance");
                       if (!gridInstance) return;

                       $grid.find(".dx-header-row td").each(function () {
                                                       const $cell = $(this);
                            const dataField = $cell.attr("data-field");  // 👈 This is key

                                const $debitHeader = $(".invoice-header");
                                const debitText = $debitHeader.data("original-text") || $debitHeader.text().trim();
                                $debitHeader.data("original-text", debitText); // Save original once

                                $debitHeader.html(`
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                        ${svgIcon}
                                        <span style="font-weight: bold;">${debitText}</span>
                                    </div>
                                `);

                                // 👉 Credit
                                const $creditHeader = $(".received-header");
                                const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                                $creditHeader.data("original-text", creditText);

                                $creditHeader.html(`
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                        ${svgIcon}
                                        <span style="font-weight: bold;">${creditText}</span>
                                    </div>
                                `);


                                const $balanceHeader = $(".balance-header");
                                const balanceText = $balanceHeader.data("original-text") || $balanceHeader.text().trim();
                                $balanceHeader.data("original-text", balanceText);

                                $balanceHeader.html(`
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                        ${svgIcon}
                                        <span style="font-weight: bold;">${balanceText}</span>
                                    </div>
                                `);


                       });
                   },
                   error: function (xhr) {
                       console.error("Failed to load currency icon:", xhr.responseText);
                   }
               });
           }

        function handleGridContentReady(e){

          injectHeaderSVG();
           injectCurrencyToCards();
           const grid = e.component;

        // Get all summary values
        let summaryItems = grid.getTotalSummaryValue();

        // If using named columns, fetch like this:
        let totalReceivable = grid.getTotalSummaryValue("InvoiceAmountBeforeRetention");
        let totalReceived   = grid.getTotalSummaryValue("Paid");
        let totalBalance    = grid.getTotalSummaryValue("Balance");

        // Format numbers
        function format(val) {
            if (val === null || val === undefined) return "0.00";
            return Math.abs(val).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        // Update Balance Card
        $("#cardBalance .value-slider span").each(function(i) {
            $(this).text(format(totalBalance));
        });
        $("#cardBalance .overlay .detail").eq(0).text(" ");
        $("#cardBalance .overlay .detail").eq(1).text(`${formatMessage("Total Balance")}: ${format(totalBalance)}`);
        $("#cardBalance .overlay .detail").eq(2).text(" ");

        // Update Debit Card (Total Invoiced)
        $("#cardDebit .value-slider span").each(function(i) {
            $(this).text(format(totalReceivable));
        });
        $("#cardDebit .overlay .detail").eq(0).text(" ");
        $("#cardDebit .overlay .detail").eq(1).text(`${formatMessage("Total Invoiced")}: ${format(totalReceivable)}`);
        $("#cardDebit .overlay .detail").eq(2).text(" ");

        // Update Credit Card (Total Received)
        $("#cardCredit .value-slider span").each(function(i) {
            $(this).text(format(totalReceived));
        });
        $("#cardCredit .overlay .detail").eq(0).text(" ");
        $("#cardCredit .overlay .detail").eq(1).text(`${formatMessage("Total paid")}: ${format(totalReceived)}`);
        $("#cardCredit .overlay .detail").eq(2).text(" ");

    }

    function injectCurrencyToCards() {
        $.ajax({
            url: "/api/AccountingLedgers/GetCurrencyIcon",
            method: "GET",
            success: function (response) {

                if (!response || !response.Icon) return;

                const icon = response.Icon.trim();

                // Inject into Balance
                $('#cardBalance .value-slider span').each(function () {
                    $(this).html(icon + $(this).text().trim().replace(icon, ''));
                });

                // Inject into Debit
                $('#cardDebit .value-slider span').each(function () {
                    $(this).html(icon + $(this).text().trim().replace(icon, ''));
                });

                // Inject into Credit
                $('#cardCredit .value-slider span').each(function () {
                    $(this).html(icon + $(this).text().trim().replace(icon, ''));
                });
            },
            error: function (err) {
                console.error("Failed to load currency icon:", err);
            }
        });
    }

     $(function () {
        $("#totalpaidbillspayable").text(formatMessage("Total paid"));
    });
     $(function () {
        $("#totalinvoicedbillspayable").text(formatMessage("Total Invoiced"));
    });
     $(function () {
        $("#totalbillsbalancepayable").text(formatMessage("Total Balance"));
    });
     $(function () {
        $("#billspayable").text(formatMessage("Bills Payable"));
    });
        $(function () {
        $("#QuickDiceERPSolutionsbillspayable").text(formatMessage("Quick Dice ERP Solutions"));
    });

  
</script>
