@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="~/css/animationCardFinance.css" />


<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }



    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .card {
        background-color: white;
    }

    .dx-datagrid-pager .dx-page.dx-selection,
    .pagination .active a {
        color: black !important; /* Set the active page number to yellow */
      
    }

    .button-alignment-down {
        margin-bottom: 10px
    }

    .dx-field {
        background-color: whitesmoke;
    }



    .card-header {
        /* Sets the background color to blue */
        color: black; /* Changes the text color to white for contrast */
        text-align: right; /* Aligns the text to the right */
        padding: 20px; /* Adds some padding around the text */
        font-weight: bold;
        padding-right: 20px;
    }

    /* .left-text { */
    /*     color: black; /* Sets the text color to blue */ */
    /*     text-decoration: underline; /* Underlines the text */ */
    /*     margin-right: 20px; */
    /* } */

    .col-md-6 {
        margin-top: 20px; /* Adjust this value to control the space */
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
       
        color: black;
    }


    #dataGrid .debit-pill, #dataGrid .credit-pill, #dataGrid .received-pill {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    #dataGrid .debit-pill {
        background: rgba(255, 77, 79, .15);
        color: #ff4d4f;
    }

    #dataGrid .credit-pill {
        background: rgba(82, 196, 26, .15);
        color: #52c41a;
    }

    #dataGrid .received-pill {
        background: rgba(255, 193, 7, 0.15); /* Light yellow background */
        color: #ffc107; /* Bootstrap yellow */
    }
</style>
