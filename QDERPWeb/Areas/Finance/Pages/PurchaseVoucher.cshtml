	function onVoucherNoChanged(e) {
		const paramVoucherNo = getQueryParam('VoucherNo');

		// Fetch voucher details
		$.ajax({
			type: "GET",
			url: "/api/PurchaseVoucher/GetVoucherDetails",
			contentType: "application/json",
			data: { voucherNo: e.value },
			success: function (response) {
				if (response.success === false && paramVoucherNo) {
					DevExpress.ui.notify(response.message, "error", 2000);
					return;
				}

				if (response.data.length > 0) {
					// Populate fields with voucher details
					const data = response.data[0];
					$("#VoucherDate").dxDateBox("instance").option("value", data.VoucherDate || null);
					$("#VoucherEffectiveDate").dxDateBox("instance").option("value", data.VoucherEffectiveDate || null);
					$("#InvoiceSubmittedDate").dxDateBox("instance").option("value", data.InvoiceSubmittedDate || null);
					$("#InvoiceDueDate").dxDateBox("instance").option("value", data.InvoiceDueDate || null);
					$("#InvoiceNoOfDays").dxNumberBox("instance").option("value", data.InvoiceNoOfDays || null);
					$("#VoucherRefNo").dxTextBox("instance").option("value", data.VoucherRefNo || "");
					$("#ReferenceNote").dxTextBox("instance").option("value", data.ReferenceNote || "");
					$("#VoucharNarration").dxTextBox("instance").option("value", data.VoucharNarration || "");
					$("#VoucherType").dxSelectBox("instance").option("value", data.VoucherType || null);
					$("#BillRemarks").dxTextBox("instance").option("value", data.BillRemarks || "");
					$("#IsVerified").dxCheckBox("instance").option("value", data.IsVerified || false);
					$("#IsApproved").dxCheckBox("instance").option("value", data.IsApproved || false);
					$("#UseSubmittedDate").dxCheckBox("instance").option("value", data.UseSubmittedDate || false);
				}
			},
			error: function (xhr, status, error) {
				if (paramVoucherNo) {
					DevExpress.ui.notify("Error fetching voucher details.", "error", 2000);
				}
			}
		});

		// Fetch voucher entries
		$.ajax({
			type: "GET",
			url: "/api/PurchaseVoucher/GetVoucherEntries",
			contentType: "application/json",
			data: { voucherNo: e.value },
			success: function (response) {
				const data = response.data || [];
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
			},
			error: function (xhr, status, error) {
				DevExpress.ui.notify("Error fetching voucher entries.", "error", 2000);
			}
		});
	}


