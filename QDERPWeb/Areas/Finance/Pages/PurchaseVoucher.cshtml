	function addVoucherEntry() {
		var accountHead = $("#ddAccountHead").dxDropDownBox("instance");
		var SupplierName = $("#SupplierNameDropDown").dxDropDownBox("instance");
		var txtVoucherAmt = $("#txtVoucherAmount").dxNumberBox("instance");
		var accountHeadValidator = $("#ddAccountHead").dxValidator("instance");
		var SupplierNameValidator = $("#SupplierNameDropDown").dxValidator("instance");
		var voucherAmtValidator = $("#txtVoucherAmount").dxValidator("instance");

		// Validate controls explicitly
		var accountHeadValidation = accountHeadValidator.validate();
		var voucherAmtValidation = voucherAmtValidator.validate();
		var SupplierNameValidation = SupplierNameValidator.validate();

		if (accountHeadValidation.isValid && voucherAmtValidation.isValid && SupplierNameValidation.isValid) {
			var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
			var entryNarration = $("#txtEntryNarration").dxTextArea("instance").option("value");

			// Prepare the Voucher Entries
			var VE = [
				{
					"VoucherNo": voucherNo,
					"AccountHead": accountHead.option("value"),
					"VoucherAmount": txtVoucherAmt.option("value"),
					"DrCr": $("#sbDrCr").dxSelectBox("instance").option("value"),
					"AddedBy": "102",
					"AddedOn": new Date(),
					"EntryNarration": entryNarration,
					"SysRemarks": "Bill of: " + SupplierName.option("value")
				},
				{
					"VoucherNo": voucherNo,
					"AccountHead": SupplierName.option("value"),
					"VoucherAmount": txtVoucherAmt.option("value"),
					"DrCr": ($("#sbDrCr").dxSelectBox("instance").option("value") === "Cr") ? "Dr" : "Cr",
					"AddedBy": "102",
					"AddedOn": new Date(),
					"EntryNarration": entryNarration,
					"SysRemarks": accountHead.option("value")
				}
			];

			// Get the current data from the grid
			var grid = $("#dataGrid").dxDataGrid("instance");
			var existingData = grid.option("dataSource");

			var drEntry = VE[0]; // Dr entry (AccountHead)
			var crEntry = VE[1]; // Cr entry (SupplierName)

			var isDuplicateDr = false;
			var isDuplicateCr = false;

			// Check if Cr entry (SupplierName) already exists in the grid
			existingData.forEach(function (entry) {
				if (crEntry.DrCr === "Cr" && entry.SysRemarks === crEntry.SysRemarks) {
					isDuplicateCr = true; // Duplicate found for Cr (SupplierName)
				}
			});

			// If duplicate found for Cr (SupplierName), don't add Cr row but add Dr row
			if (isDuplicateCr) {
				DevExpress.ui.notify("Duplicate entry for SupplierName (Cr). Only Dr entry will be added.", "warning", 2000);
				VE = [drEntry]; // Only add Dr entry, not Cr
			} else {
				// If Cr entry does not exist, add both Cr and Dr rows
				VE = [drEntry, crEntry]; // Add both rows (Dr and Cr)
			}

			// Proceed with the AJAX request to save the valid rows
			$.ajax({
				type: "POST",
				url: "/api/VoucherEntryCashReceipts/AddVoucherEntry",
				contentType: "application/json",
				data: JSON.stringify(VE),
				dataType: "json",
				success: function (response) {
					$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

					// Clear AccountHead and VoucherAmount after successful response
					accountHead.option("value", null); // Clear AccountHead
					txtVoucherAmt.option("value", null); // Clear VoucherAmount

					// Reset validation states
					accountHeadValidator.reset();
					voucherAmtValidator.reset();
				},
				error: function (xhr, status, error) {
					alert("Error occurred while updating data: " + error);
				}
			});
		} else {
			DevExpress.ui.notify("Cannot continue saving with errors,please clear the errors and continue.", "error", 2000);
		}
	}



