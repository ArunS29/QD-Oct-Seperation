												)
						<label for="UseSubmittedDate" style="margin: 0; font-size: 13px;">@Html.Raw("Received Date")</label>
					</div>

					<div >
						@(Html.DevExtreme().DateBox()
												.ID("InvoiceSubmittedDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Floating)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })
												)
					</div>
				</div>

		<div class="form-group col-md-2 col-sm-6">
			@(Html.DevExtreme().DateBox()
						.Label(new JS("formatMessage('DueDate or Payment Terms')"))
						.ID("InvoiceDueDate")
						.InputAttr("aria-label", "Date")
						.LabelMode(EditorLabelMode.Floating)
						.Type(DateBoxType.Date)
						.DisplayFormat("dd-MMM-yyyy")
						.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })

						.Value(DateTime.Now)
