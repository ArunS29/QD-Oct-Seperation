@page
@model QD.ERP.Web.Areas.Finance.Pages.PurchaseVoucherModel
<style type="text/css">
	.dx-datagrid .dx-row {
		border-bottom: 1px solid #ccc; /* Border between rows */
	}



	.horizontal-container {
		display: flex;
		gap: 10px; /* Adds spacing between buttons */
		justify-content: start; /* Aligns buttons to the left */
		align-items: center; /* Vertically centers the buttons */
		margin: 15px;
	}

	.dx-selectbox .dx-texteditor-input {
		text-align: center; /* Centers the text inside the input */
	}

	.backgroundcolor {
		background-color: #89f0b5;
	}

	.button-alignment-down {
		margin-bottom: 10px
	}
</style>
<div id="costAllocationPopup" style="display:none;">
	<div style="margin-bottom:10px">
		@(Html.DevExtreme().Button()
				.ID("btnSaveCostAllocation")
				.Icon("save")
				.Text("Save")
				.OnClick("function() { saveCostAllocation(); }")
				)
	</div>
</div>
<div class="content-container-top">
	<div class="container">
		<div class="row g-4">
			<div class="col-md-3">
				<div class="form-group">
					<label for="SalesInvoiceNo" class="button-alignment-down">Purchase Voucher No</label>
					@(
												Html.DevExtreme().TextBox()
												.ID("VoucherNo")
												.Value(null)
												.OnValueChanged("onVoucherNoChanged")
												.Disabled(true)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="InvoiceDate" class="button-alignment-down">Voucher Date</label>
					@(Html.DevExtreme().DateBox()
												.ID("VoucherDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												//.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="EffectiveDate" class="button-alignment-down">Effective Date</label>
					@(Html.DevExtreme().DateBox()
												.ID("VoucherEffectiveDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												//.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<div class="button-alignment-down">
						<label for="UseSubmittedDate">Received Date</label>
						@(Html.DevExtreme().CheckBox()
													.ID("UseSubmittedDate")
													)
					</div>
					@(Html.DevExtreme().DateBox()
												.ID("InvoiceSubmittedDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>

			</div>

		</div>
	</div>
	<div class="clear"></div>
	<div class="container  mt-3">
		<div class="row g-5">
			<div class="col-md-6" style="padding-right:0px">
				<div class="form-group">
					<label for="SupplierName" class="">Supplier Name:</label>
					@(Html.DevExtreme().DropDownBox()
												.DataSource(d => d.WebApi()
												.Controller("PurchaseVoucher")
												.LoadAction("GetSupplierName")
												.LoadMode(DataSourceLoadMode.Raw)
												.Key("AccountId")
												)
												.ValidationRules(rules =>
												{
													rules.AddRequired()
													.Message("Supplier Name is required");
												})
												.LabelMode(EditorLabelMode.Outside)
												.ID("SupplierNameDropDown")
												.ShowClearButton(true)
												.AcceptCustomValue(true)
												.OpenOnFieldClick(false)
												.ValueChangeEvent("input")
												.HoverStateEnabled(true)
												.ValueExpr("AccountId")
												.DisplayExpr("AccountHead")
												.OnInput("dropDownBoxOnInput")
												.OnOpened("onOpened")
												.TabIndex(1)
												.OnKeyDown("onKeyDown")
												//.OnValueChanged("dropDownBoxValueChanged")
												.ContentTemplate(new TemplateName("SupplierNameContentTemplate"))
												)

				</div>
			</div>

			<div class="col-md-1" style="margin-top:72px;padding-left:0px;padding-right:0px;width:3%">
				@(Html.DevExtreme().Button()
								.ID("btnAddVoucher")
								.Icon("plus")
								)
			</div>
			<div class="col-md-1" style="margin-top:72px;padding-left:0px;width:3%;padding-right:0px">
				@(Html.DevExtreme().Button()
								.ID("btnEditVoucher")
								.Icon("edit")
								)
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="InvoiceDueDate" class="">DueDate or Payment Terms</label>
					@(Html.DevExtreme().DateBox()
												.ID("InvoiceDueDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-2">
				<div class="form-group">
					<label for="InvoiceNoOfDays" class="">No. Of Days</label>
					<div style="display:flex;">
						@(
													Html.DevExtreme().NumberBox()
													.ID("InvoiceNoOfDays")

													.Value(0)
													.ShowSpinButtons(true)
													.Min(0)
													.Max(1000)
													.Step(1)
													)
						<label style="margin-top:10px;" for="InvoiceNoOfDays">Days</label>
					</div>
				</div>

			</div>
		</div>
	</div>




	<div class="dx-fieldset horizontal-container backgroundcolor" style="margin-top:15px;margin-bottom:0px;">
		<div class="form-group" style="padding-left:20px">
			<div class="button-alignment-down">
				<label for="DrCr">Dr/Cr</label>
			</div>
			@(
						Html.DevExtreme().SelectBox()
						.ID("sbDrCr")
						.DataSource(new[] { "Dr", "Cr" })
						.Value("Dr")
						.Placeholder("Select Transaction Type")
						.Width(90)
						)
		</div>
		<div class="form-group">
			<label for="AccountHead" class="button-alignment-down">Account Head:</label>
			@(Html.DevExtreme().DropDownBox()
						.DataSource(d => d.WebApi()
						.Controller("PurchaseVoucher")
						.LoadAction("GetAccountHead")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message("Account Head is required");
						})
						.LabelMode(EditorLabelMode.Outside)
						.ID("ddAccountHead")
						.ShowClearButton(true)
						.AcceptCustomValue(true)
						.OpenOnFieldClick(false)
						.ValueChangeEvent("input")
						.HoverStateEnabled(true)
						.ValueExpr("AccountId")
						.DisplayExpr("AccountHead")
						.OnInput("dropDownBoxOnInput")
						.OnOpened("onOpened")
						.Width(650)
						.TabIndex(1)
						.DropDownOptions(o => o
						.Width(1000)
						)
						.OnKeyDown("onKeyDown")
						//.OnValueChanged("dropDownBoxValueChanged")
						.ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
						)
		</div>
		<div class="form-group" style="margin-top:56px;margin-left:-10px">
			@(Html.DevExtreme().Button()
						.ID("btnAddAHead")
						.Icon("plus")
						.OnClick("redirectToLedgerAccount")
						)
		</div>
		<div class="form-group" style="margin-top:56px;margin-left:-10px">
			@(Html.DevExtreme().Button()
						.ID("btnEditAHead")
						.Icon("edit")
						)
		</div>
		<div class="form-group">
			<label for="Amount" class="button-alignment-down">Amount</label>
			@(
						Html.DevExtreme().NumberBox()
						.ID("txtVoucherAmount")
						.Value(null)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message("Voucher Amount is required");
						})
					
						.Placeholder("0.00")
						.Format("#,##0.00")
						.InputAttr(new
						{
							style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
							type = "number",
							step = "0.01"
						})
						)

		</div>
	</div>
	<div class="dx-fieldset horizontal-container backgroundcolor" style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px">
		<div class="form-group" style="padding-left:20px">
			<label for="Amount" class="button-alignment-down" style="margin-right:25px">Narration</label>
		</div>
		<div class="form-group">
			@(
						Html.DevExtreme().TextArea()
						.ID("txtEntryNarration")
						.Value("")
						.Height(70)
						.Width(720)
						.Placeholder("Enter your comments here...")
						.MaxLength(500)
						)
		</div>
		<div class="form-group" style="">
			@(Html.DevExtreme().Button()
						.ID("btnVoucherEntry")
						.Text("ADD")
						.Height(70)
						.Width(178)
						.Icon("plus")
						.OnClick("function() { addVoucherEntry(); }")
						)
		</div>
	</div>
	<div class="dx-field ledgerResult">
		@(
				Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
				.ID("dataGrid")
				.RemoteOperations(false)
				.Columns(columns =>
				{
					columns.AddFor(m => m.DrCr).Caption("Dr/Cr");
					columns.AddFor(m => m.AccountHead)
					.Caption("Account Head") // Column header text
					.DataType(GridColumnDataType.String) // Column data type
					.Lookup(lookup => lookup
					.DataSource(ds => ds.WebApi() // Web API data source
					.Controller("VoucherEntryCashReceipts") // Controller handling the data
					.LoadAction("GetAccountHead") // Action to fetch data from the API
					)
					.ValueExpr("AccountId") // Field in the API response for the value of the dropdown
					.DisplayExpr("AccountHead") // Field in the API response to be displayed in the dropdown
					);
						columns.AddFor(m => m.DrAmount).Caption("Debit").Alignment(HorizontalAlignment.Right).CustomizeText(
					"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"
					).AllowEditing(false).HeaderCellTemplate(@<div style="font-weight: bold;">Debit</div>);
						columns.AddFor(m => m.CrAmount)
					.Caption("Credit")
					.AllowEditing(false)
					.Alignment(HorizontalAlignment.Right)
					.HeaderCellTemplate(@<div style="font-weight: bold;">Credit</div>)
				@* .EditCellTemplate(@<input dx-number-box data-bind="value: $data.CrAmount" />) *@
				.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");


					columns.AddFor(m => m.EntryNarration).Caption("Entry Narration");
					columns.AddFor(m => m.SysRemarks).Caption("Remarks");
				})
				//.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
				.AllowColumnReordering(true) // Enable column reordering
				.AllowColumnResizing(true)   // Enable column resizing
				.ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
				.HeaderFilter(filter => filter.Visible(true))
				.Height(250)
				.ColumnAutoWidth(true)
				.FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
				.GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
				.ShowBorders(true)
				.Width("100%")
				)
	</div>
	<!-- Footer with TextBoxes Aligned Directly Under Debit and Credit -->
	<div id="footerTotals" style="display: flex; justify-content: space-between; background-color: #f5f5f5; color: white; padding:10px; margin-top: -11px; font-size: 14px; max-width:1245px;position:relative;left:15px;">
		<div style="flex: 1;">&nbsp;</div> <!-- Aligns with Dr/Cr column -->
		<div style="flex: 1;">&nbsp;</div> <!-- Aligns with Account Head column -->
		<!-- TextBox for Debit -->
		<div style="flex: none; text-align: right;">

			@(Html.DevExtreme().TextBox()

						.ID("totalDebitTextbox")

						.Value("0.00")

						.ReadOnly(true)

						.Width("60%")

						)
		</div>

		<!-- TextBox for Credit -->
		<div style="flex: none; text-align: right;">

			@(Html.DevExtreme().TextBox()

						.ID("totalCreditTextbox")

						.Value("0.00")

						.ReadOnly(true)

						.Width("60%")

						)
		</div>

		<div style="flex: 2;">&nbsp;</div> <!-- Aligns with Entry Narration and Remarks columns -->
	</div>


	<div class="container">
		<div class="row g-3">
			<div class="col-md-2 backgroundcolor" style="padding-top:10px;padding-bottom:10px">
				<div class="form-group">
					<label for="VoucherRefNo">Our PO/ Reference No</label>
					@(
												Html.DevExtreme().TextBox()
												.ID("VoucherRefNo")

												.Value(null)
												)
				</div>
				<div class="form-group">
					<label for="VoucherRefNo">Reference Note</label>
					@(
												Html.DevExtreme().TextBox()
												.ID("ReferenceNote")
												.Value(null)
												)
				</div>
				<div class="form-group">
					<label for="VoucherType">VoucherType</label>
					@(
												Html.DevExtreme().SelectBox()
												.ID("VoucherType")
												.DataSource(new[] { "Sales", "Purchase", "Journal" })
												.Value("Purchase")
												.Disabled(true)
												)
				</div>
			</div>
			<div class="col-md-9 backgroundcolor" style="padding-top:10px;padding-bottom:10px">
				<div class="form-group">
					<label for="VoucharNarration">Voucher Narration</label>
					@(
												Html.DevExtreme().TextBox()
												.ID("VoucharNarration")
												.Value(null)

												)
				</div>
				<div class="form-group mt-1">
					<label for="BillRemarks">Remarks</label>
					@(
												Html.DevExtreme().TextBox()
												.ID("BillRemarks")
												.Value(null)

												)

				</div>
				<div class="row">
					<div class="col-md-5">
						<div>
							@(Html.DevExtreme().CheckBox()
														.ID("IsVerified")
														)<span style="margin-left:5px">Verified By:</span>
						</div>
						<div style="margin-left:25px">Verified On:<span id="VoucherVerifiedOn"></span></div>
					</div>
					<div class="col-md-5">
						<div>
							@(Html.DevExtreme().CheckBox()
														.ID("IsApproved")
														)<span style="margin-left:5px">Approved By:</span>
						</div>
						<div style="margin-left:25px">Approved On:<span id="VoucherApprovedOn"></span></div>
					</div>
				</div>
			</div>
			<div class="col-md-1 backgroundcolor">
				<div class="form-group " style="padding-top:50px;padding-left:7px;">
					@(Html.DevExtreme().Button()
												.ID("btnAttachment")
												.Icon("fa fa-book")
												.Height(70)
												.Width(70)
												)
				</div>
			</div>
		</div>
	</div>


	<br />

	<div>
		@await Html.PartialAsync("_InputFormFooter")
	</div>
	<!-- Drop Down Grid Template -->
	@using (Html.DevExtreme().NamedTemplate("SupplierNameContentTemplate"))
	{
		@(Html.DevExtreme().DataGrid()
				.ID("suppliername-datagrid")
				.DataSource(d => d.WebApi()
				.Controller("PurchaseVoucher")
				.LoadAction("GetSupplierName")
				.LoadMode(DataSourceLoadMode.Raw)
				.Key("AccountId")
				)
				.WordWrapEnabled(true)
				.ShowBorders(true)
				.SearchPanel(sp => sp.HighlightSearchText(true))
				.Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
				.OnSelectionChanged("dataGridSelectionChanged")
				.OnInitialized("dataGridInitialized")
				.HeaderFilter(p => p.Visible(true))
				.ShowBorders(true)
				.HoverStateEnabled(true)
				.Paging(p => p.PageSize(15))
				.FilterRow(f => f.Visible(true))
				.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
				.Height(345)
				.Selection(s => s.Mode(SelectionMode.Single))
				.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
				.Columns(columns =>
				{
					columns.Add().DataField("AccountId");
					columns.Add().DataField("AccountHead");
					columns.Add().DataField("AccountHeadArabic");
					columns.Add().DataField("IsLedgerObselete").Alignment(HorizontalAlignment.Center)
				.CellTemplate(@<text>
		<div class="dx-icon">
			<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
		</div>
	</text>);

				})
			)
	}
	<!-- Drop Down Account Head Grid Template -->
	@using (Html.DevExtreme().NamedTemplate("AccountHeadContentTemplate"))
	{
		@(Html.DevExtreme().DataGrid()
				.ID("accounthead-datagrid")
				.DataSource(d => d.WebApi()
				.Controller("PurchaseVoucher")
				.LoadAction("GetAccountHead")
				.LoadMode(DataSourceLoadMode.Raw)
				.Key("AccountId")
				)
				.WordWrapEnabled(true)
				.ShowBorders(true)
				.SearchPanel(sp => sp.HighlightSearchText(true))
				.Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
				.OnSelectionChanged("dataGridAccountHeadSelectionChanged")
				.OnInitialized("dataGridAccountHeadInitialized")
				.HeaderFilter(p => p.Visible(true))
				.ShowBorders(true)
				.HoverStateEnabled(true)
				.Paging(p => p.PageSize(15))
				.FilterRow(f => f.Visible(true))
				.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
				.Height(345)
				.Selection(s => s.Mode(SelectionMode.Single))
				.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
				.Columns(columns =>
				{
					columns.Add().DataField("AccountId");
					columns.Add().DataField("AccountHead");
					columns.Add().DataField("AccountHeadArabic");
					columns.Add().DataField("IsLedgerObselete").Alignment(HorizontalAlignment.Center)
				.CellTemplate(@<text>
		<div class="dx-icon">
			<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
		</div>
	</text>);

				})
			)
	}


</div>
<script>
	$(function () {
	const voucherNo = getQueryParam('VoucherNo');
		//alert(voucherNo);
		if(voucherNo)
		{
			$("#VoucherNo").dxTextBox("instance").option("value", voucherNo);
		}else{
			$.ajax({
			url: "/api/PurchaseVoucher/GetNewVoucherNo",
			type: 'GET',
			success: function (data) {
				// Set the value in the TextBox
				$("#VoucherNo").dxTextBox("instance").option("value", data);
			},
			error: function (xhr, status, error) {
				console.error("Error loading Voucher No:", error);
			}
		});
		}
		$("#costAllocationPopup").dxPopup({
			title: "Cost Allocation",
			width: 300,
			height: 200,
			visible: false,
			showCloseButton: true,
			closeOnOutsideClick: true,

		});


	});
	function getQueryParam(param) {
	const urlParams = new URLSearchParams(window.location.search);

	// Use case-insensitive comparison to find the parameter
	for (const [key, value] of urlParams.entries()) {
		if (key.toLowerCase() === param.toLowerCase()) {
			return value;
		}
	}
	return null; // Return null if parameter not found
	}
	function addCostAllocation() {
		$("#costAllocationPopup").dxPopup("instance").show();
	}
	function saveCostAllocation() {
		$("#costAllocationPopup").dxPopup("instance").close();
	}
	function onVoucherNoChanged(e) {
		const paramVoucherNo = getQueryParam('VoucherNo');
	$.ajax({
				type: "GET",
				url: "/api/PurchaseVoucher/GetVoucherDetails",
				contentType: "application/json",
				data: {
					voucherNo: e.value
				},
				success: function (response) {
					if (response.success === false && paramVoucherNo) {
						DevExpress.ui.notify(response.message, "error", 2000); // Notify if voucher not found
						return;
					}
					console.log(response);
					// Populate fields with the response data
		$("#VoucherDate").dxDateBox("instance").option("value", response.data[0].VoucherDate);
		$("#VoucherEffectiveDate").dxDateBox("instance").option("value", response.data[0].VoucherEffectiveDate);
		$("#InvoiceSubmittedDate").dxDateBox("instance").option("value", response.data[0].InvoiceSubmittedDate);
		$("#InvoiceDueDate").dxDateBox("instance").option("value", response.data[0].InvoiceDueDate);
		$("#InvoiceNoOfDays").dxNumberBox("instance").option("value", response.data[0].InvoiceNoOfDays || null);
		$("#VoucherRefNo").dxTextBox("instance").option("value", response.data[0].VoucherRefNo || "");
		$("#ReferenceNote").dxTextBox("instance").option("value", response.data[0].ReferenceNote || "");
		$("#VoucharNarration").dxTextBox("instance").option("value", response.data[0].VoucharNarration || "");
		$("#VoucherType").dxSelectBox("instance").option("value", response.data[0].VoucherType || null);
		$("#BillRemarks").dxTextBox("instance").option("value", response.data[0].BillRemarks || "");
		$("#IsVerified").dxCheckBox("instance").option("value", response.data[0].IsVerified || false);
		$("#IsApproved").dxCheckBox("instance").option("value", response.data[0].IsApproved || false);
		$("#UseSubmittedDate").dxCheckBox("instance").option("value", response.data[0].UseSubmittedDate || false);
				},
				error: function (xhr, status, error) {
					if (paramVoucherNo) {
						DevExpress.ui.notify(response.message, "error", 2000); // Notify if voucher not found
						return;
					}
				}
			});
	$.ajax({
			type: "GET",
			url: "/api/PurchaseVoucher/GetVoucherEntries",
			contentType: "application/json",
			data: {
				voucherNo: e.value
			},
			success: function (response) {
				$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
			},
			error: function (xhr, status, error) {
				alert("Error occurred while updating data: " + error);
			}
		});

	}
	function addVoucherEntry() {
		var accountHead = $("#ddAccountHead").dxDropDownBox("instance");
		var SupplierName = $("#SupplierNameDropDown").dxDropDownBox("instance");
		var txtVoucherAmt = $("#txtVoucherAmount").dxNumberBox("instance");
