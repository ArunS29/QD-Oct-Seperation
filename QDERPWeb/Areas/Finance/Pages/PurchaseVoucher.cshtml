<div class="dx-card-body">
	<div class="form-container" style="display: flex; flex-wrap: wrap;align-items: flex-end; position: relative; padding: 0 15px; overflow-x: hidden;">
		<!-- Top Row -->
		  <div class="row w-100 align-items-center" >
		 <div class="form-group col-md-2 col-sm-6">
			@(Html.DevExtreme().TextBox()
						.Label(new JS("formatMessage('Purchase Voucher No')"))
						.ID("VoucherNo")
						.LabelMode(EditorLabelMode.Floating)
						.Value("")
										.ElementAttr(new { @class = "custom-disabled-textbox" })

						.OnValueChanged("onVoucherNoChanged")
						.Disabled(false)
						)
		</div>
			 <div class="form-group col-md-1 col-sm-6">
			@(
						Html.DevExtreme().SelectBox()
						.Label(new JS("formatMessage('Dr/Cr')"))
						.LabelMode(EditorLabelMode.Floating)
						.ID("sbDrCr")
						.DataSource(new[] { "Dr", "Cr" })
						.Value("Dr")
						.Placeholder(new JS("formatMessage('Select Transaction Type')"))
						.OnValueChanged("onVoucherDrCrValueChanged") // JS function name
						
					   			//.Disabled(true)
						)

		</div>
		<div class="form-group col-md-2 col-sm-6">
			@(Html.DevExtreme().DateBox()
						.Label(new JS("formatMessage('Voucher Date')"))
						.ID("VoucherDate")
						.InputAttr("aria-label", "Date")
						.LabelMode(EditorLabelMode.Floating)
						.Type(DateBoxType.Date)
						.DisplayFormat("dd-MMM-yyyy")
						.Value(DateTime.Now)
						.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })

						.OnValueChanged("onpurchaseVoucherDateChanged") // JS function name

						)
		</div>
		<div class="form-group col-md-2 col-sm-6">
			@(Html.DevExtreme().DateBox()
						.Label(new JS("formatMessage('Effective Date')"))
						.ID("VoucherEffectiveDate")
						.InputAttr("aria-label", "Date")
						.LabelMode(EditorLabelMode.Floating)
						.Type(DateBoxType.Date)
						.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })

						.DisplayFormat("dd-MMM-yyyy")
						.Value(DateTime.Now)
						)
		</div>

				 <div class="form-group col-md-2 col-sm-6" style="margin-bottom:15px;">
				  <div class="d-flex align-items-center mb-1">
						@(Html.DevExtreme().CheckBox()
												.Text("") // Empty so label appears separately
												.ID("UseSubmittedDate")
