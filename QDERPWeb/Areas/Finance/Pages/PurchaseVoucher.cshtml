	function onAllRowRemoving() {
		var dataGrid = $("#dataGrid").dxDataGrid("instance");

		// Retrieve the unique identifier for the row
		var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

		// **Ask for confirmation before proceeding**
		confirmDeleteAll(function () {
			// User clicked "Yes", proceed with deletion
			$.ajax({
				url: `/api/VoucherMaster/DeleteAllVoucherEntry?VoucherNo=${encodeURIComponent(voucherNo)}`,
				type: "POST",
				success: function (response) {
					if (response.data) {
						$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
						// DevExpress.ui.notify("Record deleted successfully!", "success", 2000);
					} else {
						DevExpress.ui.notify("No updated data returned from the server.", "error", 2000);
					}
				},
				error: function (xhr, status, error) {
					DevExpress.ui.notify("Error deleting record: " + error, "error", 2000);
				}
			});
		});
	}

	function confirmDeleteAll(onConfirm) {
		DevExpress.ui.dialog.confirm(
			"You are about to delete the Voucher Entries from the database. You cannot revert the changes. Are you sure you want to delete?",
			"Delete Confirm."
		).done(function (dialogResult) {
			if (dialogResult) {
				onConfirm(); // Proceed only if the user clicks "Yes"
				DevExpress.ui.dialog.alert(
					"All Entries has been successfully removed from the database.",
					"Data Deleted Successfully"
				);
			}
		});
	}
