	function fetchVoucherDetails(voucherNo) {


		$.ajax({
			type: "GET",
			url: "/api/PurchaseVoucher/GetVoucherDetails",
			contentType: "application/json",
			data: { voucherNo: voucherNo },
			success: function (response) {
				if (!response.success) {
					// DevExpress.ui.notify(response.message, "error", 2000);
					//return;
				}
				console.log(response.data[0]);
				const data = response.data[0];
				if (data) {
					//alert(data.VoucherEffectiveDate);
					//alert(data.VoucherDate);
					//alert(data.InvoiceSubmittedDate);

					$("#VoucherDate").dxDateBox("instance").option("value", data.VoucherDate);
					$("#VoucherEffectiveDate").dxDateBox("instance").option("value", data.VoucherEffectiveDate);
					$("#InvoiceSubmittedDate").dxDateBox("instance").option("value", data.InvoiceSubmittedDate);
					$("#InvoiceDueDate").dxDateBox("instance").option("value", data.InvoiceDueDate);
					$("#InvoiceNoOfDays").dxNumberBox("instance").option("value", data.InvoiceNoOfDays || null);
					$("#VoucherRefNo").dxTextBox("instance").option("value", data.VoucherRefNo || "");
					$("#VoucharNarration").dxTextBox("instance").option("value", data.VoucherNarration || "");
					$("#VoucherType").dxSelectBox("instance").option("value", data.VoucherType || null);
					$("#BillRemarks").dxTextBox("instance").option("value", data.BillRemarks || "");
					$("#ReferenceNote").dxTextBox("instance").option("value", data.ReferenceNote || "");
					$("#VerifiedBy").dxCheckBox("instance").option("value", data.IsVerified || false);
					$("#VerifiedBytext").dxTextBox("instance").option("value", data.VoucherVerifiedBy || "");
					$("#VerifiedOnDate").dxTextBox("instance").option("value", data.VoucherVerifiedOn || "");
					$("#ApprovedBy").dxCheckBox("instance").option("value", data.IsApproved || false);
					$("#ApprovedBytext").dxTextBox("instance").option("value", data.VoucherApprovedBy || "");
					$("#ApprovedOntext").dxTextBox("instance").option("value", data.VoucherApprovedOn || "");
					$("#UseSubmittedDate").dxCheckBox("instance").option("value", data.UseSubmittedDate || false);

					var verifiedDate = data.VoucherVerifiedOn ? new Date(data.VoucherVerifiedOn) : null;
					var formattedDate = verifiedDate
						? verifiedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
						: "";

					$("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate);
					var approvedDate = data.VoucherApprovedOn ? new Date(data.VoucherApprovedOn) : null;
					var formattedApprovedDate = approvedDate
						? approvedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
						: "";

					$("#ApprovedOntext").dxTextBox("instance").option("value", formattedApprovedDate);

					// Check if both VerifiedOnDate and ApprovedOntext have values
					if (formattedDate && formattedApprovedDate) {
						disableEditing();
					}
				}
			},
			error: function () {
				//	DevExpress.ui.notify("Error fetching voucher details.", "error", 2000);
			}
		});
	}
	function fetchVoucherEntries(voucherNo) {
		$.ajax({
			type: "GET",
			url: "/api/VoucherMaster/LoadreceiptEntries",
			contentType: "application/json",
			data: { voucherNo: voucherNo },
			success: function (response) {
				if (!response || !response.data || response.data.length === 0) {
					// DevExpress.ui.notify("No voucher entries found.", "warning", 2000);
					return;
				}
				var voucherTextBox = $("#VoucherNo").dxTextBox("instance");
				if (voucherTextBox) {
					voucherTextBox.option("readOnly", true);
				}
				var dataGrid = $("#dataGrid").dxDataGrid("instance");
				if (dataGrid) {
					dataGrid.option("dataSource", response.data);
					var button = $("#btnSave").dxButton("instance");
					button.option("text", "Update");
				} else {
					$("#dataGrid").dxDataGrid({
						dataSource: response.data,
						keyExpr: "VoucherEntryNo",
						repaintChangesOnly: true,
						editing: {
							mode: "cell",
							allowUpdating: true, // Enable editing
						},
						onRowUpdated: function (e) {
							saveUpdatedVoucherEntry(e.data);
						},
						columns: [
							{ dataField: "VoucherEntryNo", caption: "Entry No", allowEditing: false },
							{ dataField: "DrCr", caption: "Dr/Cr", allowEditing: false },
							{
								dataField: "AccountHead",
								caption: "Account Head",
								allowEditing: true, // Make this column editable
								lookup: {
									dataSource: new DevExpress.data.CustomStore({
										loadMode: "raw",
										key: "AccountId",
										load: function () {
											return $.getJSON("/api/VoucherMaster/GetEditAccountHead");
										}
									}),
									valueExpr: "AccountId",
									displayExpr: "AccountHead"
								}
							},
							{ dataField: "DrAmount", caption: "Debit Amount", dataType: "number", allowEditing: false },
							{ dataField: "CrAmount", caption: "Credit Amount", dataType: "number", allowEditing: false },
							{ dataField: "EntryNarration", caption: "Narration", allowEditing: false },
							{ dataField: "SysRemarks", caption: "Remarks", allowEditing: false }
						]
					});
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching voucher entries:", error);
				DevExpress.ui.notify("Error fetching voucher entries.", "error", 2000);
			}
		});
	}
