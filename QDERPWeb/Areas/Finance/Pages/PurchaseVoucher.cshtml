		 <div class="form-group col-md-2 col-sm-6">
			@(Html.DevExtreme().TextBox()
						.Label(new JS("formatMessage('Purchase Voucher No')"))
						.ID("VoucherNo")
						.LabelMode(EditorLabelMode.Floating)
						.Value("")
										.ElementAttr(new { @class = "custom-disabled-textbox" })

						.OnValueChanged("onVoucherNoChanged")
						.Disabled(true)
						)
		</div>
			 <div class="form-group col-md-1 col-sm-6">
