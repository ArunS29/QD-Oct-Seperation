		var SupplierNameValidator = $("#SupplierNameDropDown").dxValidator("instance");
		var voucherAmtValidator = $("#txtVoucherAmount").dxValidator("instance");
		// Validate controls explicitly
		var accountHeadValidation = accountHeadValidator.validate();
		var voucherAmtValidation = voucherAmtValidator.validate();
		var SupplierNameValidation = SupplierNameValidator.validate();
		if (accountHeadValidation.isValid && voucherAmtValidation.isValid && SupplierNameValidation.isValid ){
			var VE1 = {
				"VoucherNo": $("#VoucherNo").dxTextBox("instance").option("value"),
				"AccountHead": $("#ddAccountHead").dxDropDownBox("instance").option("value"),
				"VoucherAmount": $("#txtVoucherAmount").dxNumberBox("instance").option("value"),
				"DrCr": $("#sbDrCr").dxSelectBox("instance").option("value"),
				"AddedBy": "102",
				"AddedOn": new Date(),
				"EntryNarration": $("#txtEntryNarration").dxTextArea("instance").option("value")
			};
			var VE2 = {
				"VoucherNo": $("#VoucherNo").dxTextBox("instance").option("value"),
				"AccountHead": $("#SupplierNameDropDown").dxDropDownBox("instance").option("value"),
				"VoucherAmount": $("#txtVoucherAmount").dxNumberBox("instance").option("value"),
				"DrCr": ($("#sbDrCr").dxSelectBox("instance").option("value")==="Dr"?"Cr":"Dr"),
				"AddedBy": "102",
				"AddedOn": new Date(),
				"EntryNarration": $("#txtEntryNarration").dxTextArea("instance").option("value")
			};

			$.ajax({
				type: "POST",
				url: "/api/PurchaseVoucher/AddVoucherEntry",
				contentType: "application/json",
				data: JSON.stringify(VE1),
				dataType: "json",
				success: function (response) {
					$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
				},
				error: function (xhr, status, error) {
					alert("Error occurred while updating data: " + error);
				}
			});
			$.ajax({
				type: "POST",
				url: "/api/PurchaseVoucher/AddVoucherEntry",
				contentType: "application/json",
				data: JSON.stringify(VE2),
				dataType: "json",
				success: function (response) {
					$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
					DevExpress.ui.notify("Voucher entry saved succfully!", "success", 2000);
					accountHead.option("value", null);
					txtVoucherAmt.option("value", null);
					$("#txtEntryNarration").dxTextArea("instance").option("value", "");
				},
				error: function (xhr, status, error) {
					alert("Error occurred while updating data: " + error);
				}
			});
			//$("#costAllocationPopup").dxPopup("instance").show();
		}else{
			DevExpress.ui.notify("Please fill required details!", "error", 2000);
		}

	}
