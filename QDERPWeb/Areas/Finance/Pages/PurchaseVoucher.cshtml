								Html.DevExtreme().NumberBox()
								.Label(new JS("formatMessage('Amount')"))
								.LabelMode(EditorLabelMode.Floating)
								.ID("txtVoucherAmount")
								.Value(0)
								.Max(99999999)
								.ValidationRules(rules =>
								{
									 rules.AddRequired().Message("Voucher Amount Cannot be Zero Or Negative");
                                    rules.AddRange().Min(1).Message("Voucher Amount Cannot be Zero Or Negative");
								})
								.Placeholder("0.00")
								.Format("#,##0.00")
								.InputAttr(new
								{
									 type = "number",
									step = "0.01",
									style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
