	function onRowRemoving() {
		var dataGrid = $("#dataGrid").dxDataGrid("instance"); // Get the DataGrid instance

		// Get the selected row's data
		var selectedRows = dataGrid.getSelectedRowsData(); // Array of selected rows
		var selectedRowData = selectedRows.length > 0 ? selectedRows[0] : null;

		if (!selectedRowData) {
			DevExpress.ui.notify("No row selected. Please select a row first.", "error", 2000);
			return;
		}


		// Retrieve the unique identifier for the row
		var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
		var voucherEntryNo = selectedRowData.VoucherEntryNo;
		// Validate VoucherEntryNo
		if (!voucherEntryNo) {
			DevExpress.ui.notify("Invalid entry number. Cannot delete.", "error", 2000);
			return;
		}

		// Send an AJAX request to the API to delete the record
		$.ajax({
			url: `/api/PurchaseVoucher/DeleteVoucherEntry?voucherEntryNo=${encodeURIComponent(voucherEntryNo)}&VoucherNo=${encodeURIComponent(voucherNo)}`, // API URL with the identifier
			type: "POST", // HTTP POST request
			success: function (response) {
				if (response.data) {
					// Update the DataGrid's data source with the updated data
					$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
					DevExpress.ui.notify("Record deleted successfully!", "success", 2000);
				} else {
					DevExpress.ui.notify("No updated data returned from the server.", "error", 2000);
				}
			},
			error: function (xhr, status, error) {
				DevExpress.ui.notify("Error deleting record: " + error, "error", 2000);
			}
		});
	}
	function onVerifyButtonClick() {
		const dataGrid = $("#dataGrid").dxDataGrid("instance");
		const rowCount = dataGrid.getVisibleRows().length;

		// Check if dataGrid exists and contains rows
		if (rowCount == 0) {
			Swal.fire({
				title: "Voucher is not Verified",
				text: "Voucher has not been Approved, Click Yes if you want to Verify and Approve this Voucher.",
				icon: "warning",
				showCancelButton: true,
				confirmButtonText: "Yes",
				cancelButtonText: "No"
			})
		} else {
			proceedWithVerification(); // If data exists, proceed with verification
		}
	}

	function proceedWithVerification() {
		// Set VerifiedBy checkbox to true
		$("#VerifiedBy").dxCheckBox("instance").option("value", true);
		const vno = $("#VoucherNo").dxTextBox("instance").option("value");

		// Prepare data for verification
		const currentDate = new Date();
		const formattedDate = currentDate.toLocaleDateString("en-GB", {
			day: "2-digit",
			month: "short",
			year: "numeric"
		}).replace(/ /g, '-');

		const data = {
			voucherNo: vno,
			verifiedBy: "Admin",
			verifiedOn: new Date().toISOString()
		};

		$.ajax({
			data: JSON.stringify(data),
			success: function (response) {
				Swal.fire({
					title: "Success!",
					text: `Voucher has been Verified.`,
					icon: "success",
					confirmButtonText: "OK"
				}).then(() => {
					$("#VerifiedBytext").dxTextBox("instance").option("value", "Admin");
					$("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate);
				});
			},
			error: function () {
				Swal.fire({
					title: "Error",
					text: "Please save the transactions after proceeding!!",
					icon: "error",
					confirmButtonText: "OK"
				});
			}
		});
	}


	function disableEditing() {
		// Disable all input fields and buttons except for specific ones
		$('input, select, textarea').prop('disabled', true);

		$('.dx-button').each(function () {
			const allowedButtons = ['btnBack', 'btnPreview', 'btnPrint', 'btnAttach', 'btnDelete'];
			if (!allowedButtons.includes($(this).attr('id'))) {
				$(this).dxButton('option', 'disabled', true);
			}
		});
	}

