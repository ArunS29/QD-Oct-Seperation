@page
@model QD.ERP.Web.Areas.Finance.Pages.PurchaseVoucherModel
<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style type="text/css">
	.dx-datagrid .dx-row {
		border-bottom: 1px solid #ccc; /* Border between rows */
	}



	.horizontal-container {
		display: flex;
		gap: 10px; /* Adds spacing between buttons */
		justify-content: start; /* Aligns buttons to the left */
		align-items: center; /* Vertically centers the buttons */
		margin: 15px;
	}

	.dx-selectbox .dx-texteditor-input {
		text-align: center; /* Centers the text inside the input */
	}


	.button-alignment-down {
		margin-bottom: 10px
	}


	.context-menu {
		display: none;
		position: absolute;
		background-color: white;
		border: 1px solid #ccc;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
		list-style: none;
		padding: 8px 0;
		z-index: 1000;
	}

		.context-menu li {
			padding: 8px 16px;
			cursor: pointer;
			display: flex;
			align-items: center;
		}

			.context-menu li:hover {
				background-color: #f0f0f0;
			}

</style>
<div id="costAllocationPopup" style="display:none;">
	<div style="margin-bottom:10px">
		@(Html.DevExtreme().Button()
				.ID("btnSaveCostAllocation")
				.Icon("save")
				.Text("Save")
				.OnClick("function() { saveCostAllocation(); }")
				)
	</div>
</div>
	<div class="title">
		<div class="header-container">
			<div id="PurchaseVoucher" class="title no-border-input"></div>
		</div>
</div>
<div class="content-container-top">
	<div class="container">
		<div class="row g-4">
			<div class="col-md-3">
				<div class="form-group">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Purchase Voucher No')"))
												.ID("VoucherNo")
												.LabelMode(EditorLabelMode.Outside)
												.Value("")
												.OnValueChanged("onVoucherNoChanged")
												.Disabled(false)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					@(Html.DevExtreme().DateBox()
												.Label(new JS("formatMessage('Voucher Date')"))
												.ID("VoucherDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												//.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
												.Value(DateTime.Now)
												@* .OnValueChanged("onDateChange") *@
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					@(Html.DevExtreme().DateBox()
												.Label(new JS("formatMessage('Effective Date')"))
												.ID("VoucherEffectiveDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												//.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<div class="button-alignment-down">
						@(Html.DevExtreme().CheckBox()
						                            .Text(new JS("formatMessage('Received Date')"))
													.ID("UseSubmittedDate")
													.OnValueChanged("updateDueDate")
													)
					</div>
					@(Html.DevExtreme().DateBox()
												.ID("InvoiceSubmittedDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												@* .OnValueChanged("onDateChange") *@
												)
				</div>

			</div>

		</div>
	</div>
	<div class="clear"></div>
	<div class="row g-5" style="padding:0em 1em;gap:1px">
		<div class="col-md-6" style="padding-right:0px">
			<div class="form-group">
				@(Html.DevExtreme().DropDownBox()
				.Label(new JS("formatMessage('Supplier Name')"))
								.DataSource(d => d.WebApi()
								.Controller("PurchaseVoucher")
								.LoadAction("GetSupplierName")
								.LoadMode(DataSourceLoadMode.Raw)
								.Key("AccountId")
								)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message(new JS("formatMessage('Supplier Name is required')"));
								})
								.LabelMode(EditorLabelMode.Outside)
												.ID("SupplierNameDropDown")
								.ShowClearButton(true)
								.AcceptCustomValue(true)
								.OpenOnFieldClick(false)
								.ValueChangeEvent("input")
								.HoverStateEnabled(true)
								.ValueExpr("AccountId")
								.DisplayExpr("AccountHead")
								.OnInput("dropDownBoxOnInput")
								.OnOpened("onOpened")
								.TabIndex(1)
								.OnKeyDown("onKeyDown")
												//.OnValueChanged("dropDownBoxValueChanged")
								.ContentTemplate(new TemplateName("SupplierNameContentTemplate"))
								)

			</div>
		</div>

		<div class="col-md-1" style="margin-top: 62px;padding-left:0px;padding-right:0px;width: 4%;">
			@(Html.DevExtreme().Button()
						.ID("btnAddVoucher")
						.Icon("plus")
						)
		</div>
		<div class="col-md-1" style="margin-top: 62px;padding-left:0px;padding-right:0px;width: 4%;">
			@(Html.DevExtreme().Button()
						.ID("btnEditVoucher")
						.Icon("edit")
						)
		</div>
		<div class="col-md-3">
			<div class="form-group">
				@(Html.DevExtreme().DateBox()
				.Label(new JS("formatMessage('DueDate or Payment Terms')"))
								.ID("InvoiceDueDate")
								.InputAttr("aria-label", "Date")
								.LabelMode(EditorLabelMode.Outside)
								.Type(DateBoxType.Date)
								.DisplayFormat("dd-MMM-yyyy")
								.Value(DateTime.Now)
								)
			</div>
		</div>
		<div class="col-md-2">
			<div class="form-group">
				<div style="display:flex;">
					@(Html.DevExtreme().NumberBox()
					.Label(new JS("formatMessage('No. Of Days')"))
					.LabelMode(EditorLabelMode.Outside)
												.ID("InvoiceNoOfDays")
												.Value(0)
												.ShowSpinButtons(true)
												.Min(0)
												.Max(1000)
												.Step(1)

													)
						<label id="Days" class="no-border-input" style="margin-top:10px;" for="InvoiceNoOfDays"></label>
					
				</div>
			</div>
		</div>
	</div>

	<div class="dx-fieldset horizontal-container" style="margin-bottom:0px;">
		<div class="form-group" style="padding-left:20px">
			<div class="button-alignment-down">
			</div>
			@(
						Html.DevExtreme().SelectBox()
						.Label(new JS("formatMessage('Dr/Cr')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("sbDrCr")
						.DataSource(new[] { "Dr", "Cr" })
						.Value("Dr")
						.Placeholder(new JS("formatMessage('Select Transaction Type')"))
						.Width(90)
						)
		</div>
		<div class="form-group">
			@(Html.DevExtreme().DropDownBox()
						.Label(new JS("formatMessage('Account Head')"))
						.DataSource(d => d.WebApi()
						.Controller("PurchaseVoucher")
						.LoadAction("GetAccountHead")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message(new JS("formatMessage('Account Head is required')"));
						})
						.LabelMode(EditorLabelMode.Outside)
						.ID("ddAccountHead")
						.ShowClearButton(true)
						.AcceptCustomValue(true)
						.OpenOnFieldClick(false)
						.ValueChangeEvent("input")
						.HoverStateEnabled(true)
						.ValueExpr("AccountId")
						.DisplayExpr("AccountHead")
						.OnInput("dropDownBoxOnInput")
						.OnOpened("onOpened")
						.Width(650)
						.TabIndex(1)
						.DropDownOptions(o => o
						.Width(1000)
						)
						.OnKeyDown("onKeyDown")
						//.OnValueChanged("dropDownBoxValueChanged")
						.ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
						)
		</div>
		<div class="form-group" style="margin-top:52px;">
			@(Html.DevExtreme().Button()
						.ID("btnAddAHead")
						.Icon("plus")
						.OnClick("redirectToLedgerAccount")
						)
		</div>
		<div class="form-group" style="margin-top:52px;">
			@(Html.DevExtreme().Button()
						.ID("btnEditAHead")
						.Icon("edit")
						)
		</div>
		<div class="form-group">
			@(
						Html.DevExtreme().NumberBox()
						.Label(new JS("formatMessage('Amount')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("txtVoucherAmount")
						.Value(null)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message(new JS("formatMessage('Voucher Amount is required')"));
						})

						.Placeholder("0.00")
						.Format("#,##0.00")
						.InputAttr(new
						{
							style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
							type = "number",
							step = "0.01"
						})
						)

		</div>
	</div>
	<div class="dx-fieldset horizontal-container" style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px">
		<div class="form-group" style="padding-left:20px">
		</div>
		<div class="form-group">
			@(
						Html.DevExtreme().TextArea()
						.Label(new JS("formatMessage('Narration')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("txtEntryNarration")
						.Value("")
						.Height(70)
						.Width(720)
						.Placeholder(new JS("formatMessage('Enter your comments here...')"))
						.MaxLength(500)
						)
		</div>
		<div class="form-group" style="">
			@(Html.DevExtreme().Button()
						.ID("btnVoucherEntry")
						.Text(new JS("formatMessage('ADD')"))
						.Height(70)
						.Width(178)
						.Icon("plus")
						.OnClick("function() { addVoucherEntry(); }")
						)
		</div>
	</div>
	<div class="dx-field ledgerResult">
		@(
				Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
				.ID("dataGrid")
				.RemoteOperations(false)
				.Columns(columns =>
				{
					columns.AddFor(m => m.VoucherEntryNo)
					.Caption(new JS("formatMessage('Voucher Entry No')"))
					.Visible(false);

					columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('Dr/Cr')")).DataType(GridColumnDataType.String).Lookup(lookup => lookup
					.DataSource(new[] { "Dr", "Cr" }) // Data source for dropdown
					.ValueExpr("this")
					.DisplayExpr("this")
					);

					columns.AddFor(m => m.AccountHead)
					.Caption(new JS("formatMessage('Account Head')")); // Column header text
					@* .DataType(GridColumnDataType.String) // Column data type
		.Lookup(lookup => lookup
		.DataSource(ds => ds.WebApi() // Web API data source
		.Controller("VoucherEntryCashReceipts") // Controller handling the data
		.LoadAction("GetAccountHead") // Action to fetch data from the API
		)
		.ValueExpr("AccountId") // Field in the API response for the value of the dropdown
		.DisplayExpr("AccountHead") // Field in the API response to be displayed in the dropdown
		); *@
					columns.AddFor(m => m.DrAmount).Caption(new JS("formatMessage('Debit')")).Alignment(HorizontalAlignment.Right).CustomizeText(
			"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

			);
					columns.AddFor(m => m.CrAmount).Caption(new JS("formatMessage('Credit')")).Alignment(HorizontalAlignment.Right).CustomizeText(
					"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

					);
					columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('Entry Narration')"));
					columns.AddFor(m => m.SysRemarks).Caption(new JS("formatMessage('Remarks')"));
				})
				.Selection(selection => selection.Mode(SelectionMode.Single))
				//.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
				.AllowColumnReordering(true) // Enable column reordering
				.AllowColumnResizing(true)   // Enable column resizing
				.ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
				.HeaderFilter(filter => filter.Visible(true))
				.Height(250)
				.ColumnAutoWidth(true)
				.FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
				.GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
				.ShowBorders(true)
				.Width("100%")
				@* .Editing(editing => editing
		.Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
		.AllowUpdating(true)   // Enable editing of existing rows
		.AllowDeleting(true)   // Enable deleting rows
		.UseIcons(true) // Enables icons for editing buttons
		) *@
				.OnEditorPreparing("onEditorPreparing")
				//.OnRowRemoving("onRowRemoving")

				)
	</div>

	<div id="footerTotals" style="display: flex; justify-content: space-between; color: white; padding:10px; font-size: 14px; max-width:1245px;position:relative;">
		<div style="flex: 2;">&nbsp;</div>
		<div style="flex: 2;">&nbsp;</div>
		<div style="flex: none; text-align: right;">
			@(Html.DevExtreme().TextBox()

						.ID("totalDebitTextbox")

						.Value("0.00")

						.ReadOnly(true)

						.Width("60%")
						.RtlEnabled(true)

						)
		</div>

		<!-- TextBox for Credit -->
		<div style="flex: none; text-align: right;">

			@(Html.DevExtreme().TextBox()

						.ID("totalCreditTextbox")

						.Value("0.00")

						.ReadOnly(true)

						.Width("60%")
						.RtlEnabled(true)
						)
		</div>

		<div style="flex: 2;">&nbsp;</div> <!-- Aligns with Entry Narration and Remarks columns -->
	</div>

	<!-- Context Menu for Actions -->
		<ul id="contextMenu" class="context-menu" style="display: none;">
			<li onclick="editCostAllocation()">
            <i class="fas fa-edit" style="margin-right: 8px;"></i><div id="EditCostAllocation" class="no-border-input"></div>
        </li>
			<li onclick="editBillReceivable()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditBillReceivable" class="no-border-input"></div>
        </li>
		    <li onclick="editPropertyAllocation()">
            <i class="fas fa-cogs" style="margin-right: 8px;"></i><div id="EditPropertyAllocation" class="no-border-input"></div>
        </li>
			<li onclick="onRowRemoving()">
            <i class="fas fa-trash-alt" style="margin-right: 8px;"></i><div id="DeleteLineEntry" class="no-border-input"></div>
        </li>
		</ul>

	<div class="row g-3" style="padding:1em">
			<div class="col-md-2" style="padding-top:10px;padding-bottom:10px">
				<div class="form-group">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Our PO/ Reference No')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("VoucherRefNo")

												.Value(null)
												)
				</div>
				<div class="form-group">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Reference Note')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("ReferenceNote")
												.Value(null)
												)
				</div>
				<div class="form-group">
					@(
												Html.DevExtreme().SelectBox()
												.Label(new JS("formatMessage('Voucher Type')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("VoucherType")
												.DataSource(new[] { "Sales", "Purchase", "Journal" })
												.Value("Purchase")
												.Disabled(true)
												)
				</div>
			</div>
			<div class="col-md-9" style="padding-top:10px;padding-bottom:10px">
				<div class="form-group">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Voucher Narration')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("VoucharNarration")
												.Value(null)

												)
				</div>
				<div class="form-group mt-1">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Remarks')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("BillRemarks")
												.Value(null)

												)

				</div>
				<div class="row">
					<div class="col-md-5">
						<div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
							@(Html.DevExtreme().CheckBox().ID("VerifiedBy").Text(new JS("formatMessage('Verified By:')")))
							@(Html.DevExtreme().TextBox()
														.ID("VerifiedBytext")
														.Value(null)
														.Disabled(true)
														.Width("200px")
														)
						</div>
						<!-- Verified On -->
						<div class="form-group d-flex align-items-center mt-2">
							<span id="VerifiedOn" class="no-border-input"></span>
							@(Html.DevExtreme().TextBox()
														.ID("VerifiedOnDate")
														.Value(null)
														.Disabled(true)
														.Width("200px")
														.ElementAttr(new { style = "margin-left: 10px;" })
														)
						</div>
					</div>
					<div class="col-md-5">
						<div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
							@(Html.DevExtreme().CheckBox().ID("ApprovedBy").Text(new JS("formatMessage('Approved By:')")))
							<span id="ApprovedBy" class="no-border-input" style="margin-left:5px"></span>
							@(Html.DevExtreme().TextBox()
														.ID("ApprovedBytext")
														.Value(null)
														.Disabled(true)
														.Width("200px")
														)
						</div>
						<!-- Approved On -->
						<div class="form-group d-flex align-items-center mt-2">
							<span id="ApprovedOn" class="no-border-input"></span>
							@(Html.DevExtreme().TextBox()
														.ID("ApprovedOntext")
														.Value(null)
														.Disabled(true)
														.Width("200px")
														.ElementAttr(new { style = "margin-left: 10px;" })
														)
						</div>
					</div>
				</div>
			</div>
			<div class="col-md-1">
				<div class="form-group " style="padding-top:50px;padding-left:7px;">
					@(Html.DevExtreme().Button()
												.ID("btnAttachment")
												.Icon("fa fa-book")
												.Height(70)
												.Width(70)
												)
				</div>
			</div>
		</div>


	<br />

	<div>
		@await Html.PartialAsync("_Formfooter")
	</div>
	<!-- Drop Down Grid Template -->
	@using (Html.DevExtreme().NamedTemplate("SupplierNameContentTemplate"))
	{
		@(Html.DevExtreme().DataGrid()
				.ID("suppliername-datagrid")
				.DataSource(d => d.WebApi()
				.Controller("PurchaseVoucher")
				.LoadAction("GetSupplierName")
				.LoadMode(DataSourceLoadMode.Raw)
				.Key("AccountId")
				)
				.WordWrapEnabled(true)
				.ShowBorders(true)
				.SearchPanel(sp => sp.HighlightSearchText(true))
				.Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
				.OnSelectionChanged("dataGridSelectionChanged")
				.OnInitialized("dataGridInitialized")
				.HeaderFilter(p => p.Visible(true))
				.ShowBorders(true)
				.HoverStateEnabled(true)
				.Paging(p => p.PageSize(15))
				.FilterRow(f => f.Visible(true))
				.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
				.Height(345)
				.Selection(s => s.Mode(SelectionMode.Single))
				.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
				.Columns(columns =>
				{
					columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
					columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"));
					columns.Add().DataField("AccountHeadArabic").Caption(new JS("formatMessage('Account Head Arabic')"));
					columns.Add().DataField("IsLedgerObselete").Caption(new JS("formatMessage('Is Ledger Obselete')")).Alignment(HorizontalAlignment.Center)
				.CellTemplate(@<text>
		<div class="dx-icon">
			<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
		</div>
	</text>);

				})
			)
	}
	<!-- Drop Down Account Head Grid Template -->
	@using (Html.DevExtreme().NamedTemplate("AccountHeadContentTemplate"))
	{
		@(Html.DevExtreme().DataGrid()
				.ID("accounthead-datagrid")
				.DataSource(d => d.WebApi()
				.Controller("PurchaseVoucher")
				.LoadAction("GetAccountHead")
				.LoadMode(DataSourceLoadMode.Raw)
				.Key("AccountId")
				)
				.WordWrapEnabled(true)
				.ShowBorders(true)
				.SearchPanel(sp => sp.HighlightSearchText(true))
				.Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
				.OnSelectionChanged("dataGridAccountHeadSelectionChanged")
				.OnInitialized("dataGridAccountHeadInitialized")
				.HeaderFilter(p => p.Visible(true))
				.ShowBorders(true)
				.HoverStateEnabled(true)
				.Paging(p => p.PageSize(15))
				.FilterRow(f => f.Visible(true))
				.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
				.Height(345)
				.Selection(s => s.Mode(SelectionMode.Single))
				.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
				.Columns(columns =>
				{
					columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
