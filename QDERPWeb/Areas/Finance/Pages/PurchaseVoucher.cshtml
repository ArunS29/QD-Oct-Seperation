			html: "<p>How would you like to attach files?</p>",
			showCancelButton: true,
			confirmButtonText: "Single File",
			cancelButtonText: "Multiple Files",
			reverseButtons: true
		}).then((result) => {
			if (result.isConfirmed) {
				handleFileSelection(false); // Single file selection
			} else if (result.dismiss === Swal.DismissReason.cancel) {
				handleFileSelection(true); // Multiple file selection
			}
		});
	}

	function handleFileSelection(isMultiple) {
		// Configure the file input
		const fileInput = document.getElementById("fileInput");
		fileInput.multiple = isMultiple; // Allow multiple files if selected
		fileInput.click(); // Trigger file input click
	}

	// File Input Change Handler (Optional: Log or Process Files)
	document.getElementById("fileInput").addEventListener("change", function () {
		const files = this.files;
		console.log("Selected files:", files);
		// Handle file upload logic here
	});
</script>