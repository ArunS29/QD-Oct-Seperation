	function addVoucherEntry() {
		var accountHead = $("#ddAccountHead").dxDropDownBox("instance");
		var SupplierName = $("#SupplierNameDropDown").dxDropDownBox("instance");
		var txtVoucherAmt = $("#txtVoucherAmount").dxNumberBox("instance");
		var accountHeadValidator = $("#ddAccountHead").dxValidator("instance");
		var SupplierNameValidator = $("#SupplierNameDropDown").dxValidator("instance");
		var voucherAmtValidator = $("#txtVoucherAmount").dxValidator("instance");

		// Validate controls explicitly
		var accountHeadValidation = accountHeadValidator.validate();
		var voucherAmtValidation = voucherAmtValidator.validate();
		var SupplierNameValidation = SupplierNameValidator.validate();

		var dataGrid = $("#dataGrid").dxDataGrid("instance"); // Get the DataGrid instance
		var rowCount = dataGrid.getVisibleRows().length; // Get the number of rows in the grid
		griddatacount = rowCount;

		if (accountHeadValidation.isValid && voucherAmtValidation.isValid && SupplierNameValidation.isValid) {
			var sysRemarks1 = suppliername ? `Bill of ${suppliername}` : "";
			var sysRemarks2 = accheadname || "";
			var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
			var entryNarration = $("#txtEntryNarration").dxTextArea("instance").option("value");

			var gridData = $("#dataGrid").dxDataGrid("instance").option("dataSource") || [];

			// Check if "Petty Cash - Shabbir" already exists in the grid
			var exists = gridData.some(function (row) {
				return row.AccountHead === suppliername;
			});


			if (!exists) {
				// Add both entries if "Petty Cash - Shabbir" does not exist
				VE = [
					{
						"VoucherNo": voucherNo,
						"AccountHead": accountHead.option("value"),
						"VoucherAmount": txtVoucherAmt.option("value"),
						"DrCr": $("#sbDrCr").dxSelectBox("instance").option("value"),
						"AddedBy": "102",
						"AddedOn": new Date(),
						"EntryNarration": entryNarration,
						"SysRemarks": sysRemarks1
					},
					{
						"VoucherNo": voucherNo,
						"AccountHead": SupplierName.option("value"),
						"VoucherAmount": txtVoucherAmt.option("value"),
						"DrCr": ($("#sbDrCr").dxSelectBox("instance").option("value") === "Cr") ? "Cr" : "Cr",
						"AddedBy": "102",
