	function proceedWithVerification() {
		// Set VerifiedBy checkbox to true
		$("#VerifiedBy").dxCheckBox("instance").option("value", true);

		const vno = $("#VoucherNo").dxTextBox("instance").option("value");

		if (!vno) {
			DevExpress.ui.notify("Voucher number is required!", "error", 2000);
			return;
		}

		const currentDate = new Date();

		const formattedDate = currentDate.toLocaleDateString("en-GB", {

			day: "2-digit",

			month: "short",

			year: "numeric"

		}).replace(/ /g, '-');

		$.ajax({
			type: "POST",
			url: "/api/VoucherMaster/VerifyVoucher",
			contentType: "application/json",
			dataType: "json",
			data: JSON.stringify({ voucherNo: vno }), // Send as JSON in request body
			success: function (response) {
				if (response && response.Message) {
					DevExpress.ui.dialog.alert(
						"Voucher has been Verified.",
						"Verified"
					).done(() => {
						$("#VerifiedBytext").dxTextBox("instance").option("value", response.VoucherVerifiedBy || "N/A");
						$("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate || "N/A");
					});
				}
				else {
					DevExpress.ui.notify("Update failed: Unable to reload details!", "error", 2000);
				}
			},
			error: function (xhr, status, error) {
				let errorMessage = xhr.responseJSON && xhr.responseJSON.Message
					? xhr.responseJSON.Message
					: "An error occurred.";
			}
		});
	}



	function disableEditing() {
		// Disable all input fields and buttons except for specific ones
		$('input, select, textarea').prop('disabled', true);

		$('.dx-button').each(function () {
			const allowedButtons = ['btnBack', 'btnPrint', 'btnAttach', 'btnAttachment', 'btnEditAHead', 'btnAddAHead', 'btncostBack'];
			if (!allowedButtons.includes($(this).attr('id'))) {
				$(this).dxButton('option', 'disabled', true);
			}
		});
		// Enable the DropDownButton explicitly
		const previewButton = $("#btnPreview1").dxDropDownButton("instance");

		if (previewButton) {
			previewButton.option("disabled", false);
			previewButton.repaint();  // Force UI refresh
		} else {
			console.error("btnPreview1 instance not found");
		}
		// Modify context menu items
		$("#EditCostAllocation").text("View Cost Allocation");
		$("#EditBillReceivable").text("View Bill Receivable");
		$("#EditSalaryPayable").text("View Salary Payable");
		$("#EditEmployeeAllocation").text("View Employee Allocation");
		$("#EditPropertyAllocation").text("View Property Allocation");

		// Completely disable DeleteAllLineEntries
		$("#DeleteAllLineEntries").parent().css({
			"pointer-events": "none",  // Disables interaction
			"opacity": "0.5",  // Makes it look disabled
			"cursor": "default"  // Prevents pointer cursor
		}).attr("aria-disabled", "true");

		// Disable DevExtreme DateBox components
		$("#VoucherDate").dxDateBox("instance").option("disabled", true);
		$("#VoucherEffectiveDate").dxDateBox("instance").option("disabled", true);


		// Disable DevExtreme DropDownBox component
		$("#accountDropDownBox").dxDropDownBox("instance").option("disabled", true);

		// Disable DataGrid Editing and Deleting
		var dataGrid = $("#dataGrid").dxDataGrid("instance");
		if (dataGrid) {
			dataGrid.option("editing.allowUpdating", false);
			dataGrid.option("editing.allowDeleting", false);
		}

	}


	function onApproveButtonClick() {
		const dataGrid = $("#dataGrid").dxDataGrid("instance");

		if (!dataGrid) {
			console.error("DataGrid instance not found.");
			return;
		}

		const rowCount = dataGrid.getVisibleRows().length;

		if (rowCount === 0) {
			DevExpress.ui.dialog.custom({
				title: "Voucher approval has failed.",
				message: "Voucher has not been Approved. Please enter transactions to proceed with approval.",
				buttons: [{ text: "Ok", onClick: () => false }],
				showTitle: true
			}).show();
			return;
		}

		// Assume verification status is fetched from a field or variable, update accordingly
		const isVerified = $("#VerifiedBy").dxCheckBox("instance").option("value"); // or fetch it based on your model

		if (!isVerified) {
			DevExpress.ui.dialog.custom({
				title: "Voucher Not Verified",
				message: "Voucher has not been verified. Click Yes if you want to verify and approve this voucher.",
				buttons: [
					{ text: "Yes", onClick: () => true },
					{ text: "No", onClick: () => false }
				],
				showTitle: true
			}).show().done(function (dialogResult) {
				if (dialogResult) {
					// Mark as verified
					$("#VerifiedBy").dxCheckBox("instance").option("value", true);
					// Now proceed with approval
					proceedWithApproval();
				}
			});
		} else {
			DevExpress.ui.dialog.custom({
				title: "Confirm Approval",
				message: "Are you sure you want to approve this voucher?",
				buttons: [
					{ text: "Yes", onClick: () => true },
					{ text: "No", onClick: () => false }
				],
				showTitle: true
			}).show().done(function (dialogResult) {
				if (dialogResult) {
					proceedWithApproval();
				}
			});
		}
	}
	function proceedWithApproval() {
		// Set ApprovedBy checkbox to true
		$("#ApprovedBy").dxCheckBox("instance").option("value", true);

		const vno = $("#VoucherNo").dxTextBox("instance").option("value");

		if (!vno) {
			DevExpress.ui.notify("Voucher number is required!", "error", 2000);
			return;
		}

		// Define IsDirect if not already defined (adjust as needed)
		const IsDirect = true; // or false, depending on your logic

		const currentDate = new Date();
		const formattedDate = currentDate.toLocaleDateString("en-GB", {
			day: "2-digit",
			month: "short",
			year: "numeric"
		}).replace(/ /g, '-');

		$.ajax({
			type: "POST",
			url: `/api/VoucherMaster/ApproveVoucher?VoucherNo=${encodeURIComponent(vno)}&IsDirect=${encodeURIComponent(IsDirect)}`,
			contentType: "application/json",
			dataType: "json",
			// Uncomment the following line if the API expects data in the request body:
			// data: JSON.stringify({ voucherNo: vno }),
			success: function (response) {
				if (response && response.Message) {
					DevExpress.ui.dialog.alert(
						"Voucher has been Approved.",
						"Approved"
					).done(() => {
						disableEditing();
						$("#ApprovedBytext").dxTextBox("instance").option("value", response.VoucherApprovedBy || "N/A");
						$("#ApprovedOntext").dxTextBox("instance").option("value", formattedDate || "N/A");

						if (IsDirect === true) {
							$("#VerifiedBy").dxCheckBox("instance").option("value", true);
							$("#VerifiedBytext").dxTextBox("instance").option("value", response.VoucherApprovedBy || "N/A");
							$("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate || "N/A");
						}
					});
				} else {
					DevExpress.ui.notify("Update failed: Unable to reload details!", "error", 2000);
				}
			},
			error: function (xhr, status, error) {
				let errorMessage = (xhr.responseJSON && xhr.responseJSON.Message)
					? xhr.responseJSON.Message
					: "An error occurred.";
				DevExpress.ui.notify(errorMessage, "error", 2000);
			}
		});
	}

