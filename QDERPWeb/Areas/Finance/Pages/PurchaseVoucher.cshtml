	function onpurchaseVoucherDateChanged(e) {
            console.log("Selected Date:", e.value);
			debugger
            var voucherDate = $("#PurchaseVoucherDate").dxDateBox("instance");
            var effectiveDate = $("#purchaseVoucherEffectiveDate").dxDateBox("instance");
   
            voucherDate.option("onValueChanged", function (e) {
                let voucherDateval = e.value; // Get Date from DevExtreme DateBox

                // Check if voucherDateval is valid
                if (!voucherDateval) return;

                // Set effectiveDate to the same value as voucherDate
                effectiveDate.option("value", voucherDateval);

                // Convert to 'yyyy-MM-dd' format
                let formattedDate = new Date(voucherDateval).toISOString().split("T")[0];

                // Define the cutoff date (2021-12-31)
                let cutoffDate = new Date("2021-12-31");

                // Get the current date to set if the voucher date is blocked
                let currentdate = new Date();
                let formattedCurrentDate = currentdate.toISOString().split("T")[0]; // Format it as 'yyyy-MM-dd'

                // Check if the formatted voucher date is before the cutoff date
                if (new Date(formattedDate) < cutoffDate) {
                    // Show alert for blocked entry
                    DevExpress.ui.dialog.alert("This Voucher Entry date has been blocked. Please review your entry date.", "Blocked Entry");

                    // Set both voucherDate and effectiveDate to the current date
                    voucherDate.option("value", formattedCurrentDate);
                    effectiveDate.option("value", formattedCurrentDate);
                }
            });
        }
	function updateDueDate() {
		// Get checkbox value and "No of Days"
		const useSubmittedDate = $("#UseSubmittedDate").dxCheckBox("instance").option("value");
		const noOfDays = $("#InvoiceNoOfDays").dxNumberBox("instance").option("value");

		// Determine the base date (Submitted Date or Voucher Date)
		const baseDate = useSubmittedDate
			? $("#InvoiceSubmittedDate").dxDateBox("instance").option("value")
			: $("#PurchaseVoucherDate").dxDateBox("instance").option("value");

		// Validate the base date
		if (!baseDate) {
			alert("Please select a valid base date!");
			return;
		}

		// Calculate the Due Date
		const calculatedDate = new Date(baseDate);
		calculatedDate.setDate(calculatedDate.getDate() + noOfDays);

		// Update Due Date
		$("#InvoiceDueDate").dxDateBox("instance").option("value", calculatedDate);
	}

	function onDateChange() {
		// Get Voucher Date and Due Date
		const voucherDate = new Date($("#PurchaseVoucherDate").dxDateBox("instance").option("value"));
		const dueDate = new Date($("#InvoiceDueDate").dxDateBox("instance").option("value"));

		// Validate that Due Date is not earlier than Voucher Date
		if (dueDate < voucherDate) {
			alert("Due Date cannot be earlier than Voucher Date.");
			$("#InvoiceDueDate").dxDateBox("instance").option("value", voucherDate); // Reset Due Date to Voucher Date
			return;
		}

		// Calculate the difference in days and update "No of Days"
		const diffTime = dueDate - voucherDate;
		const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
		$("#InvoiceNoOfDays").dxNumberBox("instance").option("value", diffDays);
	}

	// Initialize the event handlers
	$(function () {
		$("#InvoiceSubmittedDate").dxDateBox({
			onValueChanged: updateDueDate, // Recalculate Due Date on change
		});

		// $("#PurchaseVoucherDate").dxDateBox({
		// 	onValueChanged: updateDueDate, // Recalculate Due Date on change
		// });

		$("#InvoiceNoOfDays").dxNumberBox({
			onValueChanged: function () {
				const noOfDays = $("#InvoiceNoOfDays").dxNumberBox("instance").option("value");
				const useSubmittedDate = $("#UseSubmittedDate").dxCheckBox("instance").option("value");

				const baseDate = useSubmittedDate
					? $("#InvoiceSubmittedDate").dxDateBox("instance").option("value")
					: $("#PurchaseVoucherDate").dxDateBox("instance").option("value");

				if (baseDate) {
					const calculatedDate = new Date(baseDate);
					calculatedDate.setDate(calculatedDate.getDate() + noOfDays);
					$("#InvoiceDueDate").dxDateBox("instance").option("value", calculatedDate);
				}
			},
		});

		$("#UseSubmittedDate").dxCheckBox({
			value: true, // Default: Checked
			onValueChanged: function () {
				updateDueDate(); // Recalculate Due Date when checkbox is toggled
			},
		});
	});




	$(function () {

		const dataGrid = $("#dataGrid").dxDataGrid("instance");

		const totalDebitTextbox = $("#totalDebitTextbox").dxTextBox("instance");

		const totalCreditTextbox = $("#totalCreditTextbox").dxTextBox("instance");

		function calculateTotals() {

			const data = dataGrid.getVisibleRows().map(row => row.data);

			const totalDebit = data.reduce((sum, row) => sum + (row.DrAmount || 0), 0);

			const totalCredit = data.reduce((sum, row) => sum + (row.CrAmount || 0), 0);

			// Update TextBox values dynamically

			totalDebitTextbox.option("value", totalDebit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

			totalCreditTextbox.option("value", totalCredit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

		}

		// Recalculate totals on content changes

		dataGrid.on("contentReady", calculateTotals);

		dataGrid.on("dataSourceChanged", calculateTotals);
	});
