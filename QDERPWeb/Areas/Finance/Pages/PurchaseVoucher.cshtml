	</div>

	<div id="popupContainer">
		@(Html.DevExtreme().Popup()
				.ID("BillsReceivablePopup")
				.Title("Finance Module: Receivables / Payables")
				.Width("90%")
				.Height(500)
				.Visible(false)
				.ShowCloseButton(true)
				.ResizeEnabled(true)
				.DragEnabled(true)
				.ShowTitle(true)
				@* .ToolbarItems(toolbar =>
		{
		toolbar.Add()
		.Widget(w => w.Button()
		.Icon("minus")
		.OnClick("minimizePopup")
		)
		.Location(ToolbarItemLocation.After);
		toolbar.Add()
		.Widget(w => w.Button()
		.Icon("expand")
		.OnClick("maximizePopup")
		)
		.Location(ToolbarItemLocation.After);
		}) *@
				)
	</div>

	<div class="row g-3" style="padding:1em">
			<div class="col-md-2" style="padding-top:10px;padding-bottom:10px">
				<div class="form-group">
				@(
																		Html.DevExtreme().TextBox()
																		.Label(new JS("formatMessage('Our PO/ Reference No')"))
																		.LabelMode(EditorLabelMode.Outside)
																		.ID("VoucherRefNo")

																		.Value(null)
																		)
				</div>
				<div class="form-group">
				@(
																		Html.DevExtreme().TextBox()
																		.Label(new JS("formatMessage('Reference Note')"))
																		.LabelMode(EditorLabelMode.Outside)
																		.ID("ReferenceNote")
																		.Value("")
																		)
				</div>
				<div class="form-group">
				@(
																		Html.DevExtreme().SelectBox()
																		.Label(new JS("formatMessage('Voucher Type')"))
																		.LabelMode(EditorLabelMode.Outside)
																		.ID("VoucherType")
																		.DataSource(new[] { "Sales", "Purchases", "Journal" })
																		.Value("Purchases")
																		.Disabled(true)
																		)
