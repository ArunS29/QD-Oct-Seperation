										.ContentTemplate(new TemplateName("SupplierNameContentTemplate"))
.Buttons(buttons => {
        // Built-in clear button
        buttons.Add()
            .Name("clear");

     buttons.Add()
    .Name("addLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("plus")
        .ElementAttr(new { @class = "custom-hover-button add-hover" })
        .OnClick("showLedgerAccountPopup"));

buttons.Add()
