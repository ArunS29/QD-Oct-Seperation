								.Key("AccountId")
								)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message(new JS("formatMessage('Account Head is required')"));
								})
								.LabelMode(EditorLabelMode.Floating)
								.ID("ddAccountHead")
								.ShowClearButton(true)
								.AcceptCustomValue(true)
								.OpenOnFieldClick(false)
								.ValueChangeEvent("input")
								.HoverStateEnabled(true)
								.ValueExpr("AccountId")
								.DisplayExpr("AccountHead")
								.OnInput("dropDownBoxOnInput")
								.OnOpened("onOpened")
								
												.ElementAttr(new { @class = "white-dropdownbox" })

								.TabIndex(1)
								.DropDownOptions(o => o
								.Width(1000)
								)
								.OnKeyDown("onKeyDown")
														//.OnValueChanged("dropDownBoxValueChanged")
								.ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
								.Buttons(buttons => {
        // Built-in clear button
        buttons.Add()
            .Name("clear");

     buttons.Add()
    .Name("addLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("plus")
        .ElementAttr(new { @class = "custom-hover-button add-hover" })
        .OnClick("showLedgerAccountPopup"));

buttons.Add()
    .Name("editLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("edit")
        .ElementAttr(new { @class = "custom-hover-button edit-hover" })
        .OnClick("showLedgerAccountEditPopup"));



        buttons.Add()
        .Name("dropDown");
    })

								)
			</div>
	
				<div class="form-group col-md-3 col-sm-6">
					@(Html.DevExtreme().DropDownBox()
										.Label(new JS("formatMessage('Supplier Name')"))
										.DataSource(d => d.WebApi()
										.Controller("PurchaseVoucher")
										.LoadAction("GetSupplierName")
										.LoadMode(DataSourceLoadMode.Raw)
										.Key("AccountId")
										)
										.ValidationRules(rules =>
										{
											rules.AddRequired()
											.Message(new JS("formatMessage('Supplier Name is required')"));
										})
										.LabelMode(EditorLabelMode.Floating)
										.ID("accountDropDownBox")
										.ShowClearButton(true)
										.AcceptCustomValue(true)
										.OpenOnFieldClick(false)
										.ValueChangeEvent("input")
										.HoverStateEnabled(true)
										.ValueExpr("AccountId")
										.DisplayExpr("AccountHead")
										.OnInput("dropDownBoxOnInput")
										.OnOpened("onOpened")
													.DropDownOptions(o => o
													.Width(1000)
													)
										.TabIndex(1)
										 .DropDownOptions(o => o.Width(1000))
										.OnKeyDown("onKeyDown")
										.OnValueChanged("onSupplierNameChanged")
										.ContentTemplate(new TemplateName("SupplierNameContentTemplate"))
.Buttons(buttons => {
        // Built-in clear button
        buttons.Add()
            .Name("clear");

     buttons.Add()
    .Name("addLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("plus")
        .ElementAttr(new { @class = "custom-hover-button add-hover" })
        .OnClick("showLedgerAccountPopup"));

buttons.Add()
    .Name("editLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("edit")
        .ElementAttr(new { @class = "custom-hover-button edit-hover" })
        .OnClick("showLedgerAccountEditPopup"));



        buttons.Add()
        .Name("dropDown");
    })

										)
				</div>


			<div class="form-group col-md-1 col-sm-6">
				@(
								Html.DevExtreme().NumberBox()
								.Label(new JS("formatMessage('Amount')"))
								.LabelMode(EditorLabelMode.Floating)
								.ID("txtVoucherAmount")
								.Value(null)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message(new JS("formatMessage('Voucher Amount is required')"));
									rules.AddCustom()
									.ValidationCallback("validateAmount")
									.Message("Negative value is not allowed.");
								})
								.Placeholder("0.00")
								.Format("#,##0.00")
								.InputAttr(new
								{
									style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
									type = "number",
									step = "0.01"
								})
								)
			</div>
			<div class="form-group col-md-2 col-sm-6">
    @(Html.DevExtreme().DropDownBox()
        .ID("ddlBaseCurrency")
        .DataSource(d => d.WebApi()
            .Controller("Utility")
            .LoadAction("GetCurrencyList")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("CurrencyExchangeId")
        )
        .ValueExpr("CurrencyExchangeId")
        .DisplayExpr("CurrencyName")
        // now use your renamed variable
        .Value(baseCurrencyIdnew)
        .Label(new JS("formatMessage('Base Currency')"))
        .LabelMode(EditorLabelMode.Floating)
        .ValidationRules(rules => rules.AddRequired().Message("Please select a base currency."))
        .ShowClearButton(true)
        .AcceptCustomValue(false)
        .DropDownOptions(o => o.Width(300))
        .ReadOnly(true)
        .ElementAttr(new { @class = "custom-disabled-selectbox" })
    )
</div>
		<div class="form-group col-md-2 col-sm-6">
			@(Html.DevExtreme().DropDownBox()
						.Label("Convertion Currency")
						.DataSource(d => d.WebApi()
						.Controller("Utility") // Adjust if needed
						.LoadAction("GetCurrencyList")
