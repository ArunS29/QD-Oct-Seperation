@page
@using QD.ERP.Web.DAL.Entities
@{
    ViewData["Title"] = "Payment Voucher Details";
    var popvno = "";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<style type="text/css">
    .overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5); /* Transparent background */

        z-index: 1000;
    }

    .overlay-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 80%;
        background: #909ead00;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
        border-radius: 8px;
        overflow: hidden;
    }

    #overlay-frame {
        width: 100%;
        height: 100%;
    }

    .Maincontainer.Maincontainer {
        background-color: white;
    }

    .close-btn {
        position: absolute;
        top: 10px;
        right: 20px;
        font-size: 30px;
        cursor: pointer;
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        list-style: none;
        padding: 8px 0;
        z-index: 1000;
    }

        .context-menu li {
            padding: 8px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

            .context-menu li:hover {
                background-color: #f0f0f0;
            }

</style>
<div class="title">
    <div class="header-container">
        <div id="PaymentVoucherDetails" class="no-border-title"></div>
    </div>
</div>


<div class="content-container-top" style="background-color:#909ead00;">

    <div class="content-container">
        <div class="dx-fieldset horizontal-container" style="margin-bottom:0px">
            <div class="form-group">
                @(
                        Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Voucher No')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("VoucherNo")
                        .Value("")
                        .Disabled(true)
                        .OnValueChanged("onVoucherNoChanged")
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("VoucherNo is required");
                        })
                        )
            </div>
            <div class="form-group">
                @(Html.DevExtreme().DateBox()
                        .Label(new JS("formatMessage('Voucher Date')"))
                        .ID("VoucherDate")
                        .InputAttr("aria-label", "Date")
                        .LabelMode(EditorLabelMode.Outside)
                        .Type(DateBoxType.Date)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Value(DateTime.Now)
                        .OnValueChanged("onVoucherDateChanged") // JS function name

                        )
            </div>
            <div class="form-group">
                @(Html.DevExtreme().DateBox()
                        .Label(new JS("formatMessage('Effective Date')"))
                        .ID("VoucherEffectiveDate")
                        .InputAttr("aria-label", "Date")
                        .LabelMode(EditorLabelMode.Outside)
                        .Type(DateBoxType.Date)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Value(DateTime.Now)
                        )
            </div>
            <div class="form-group">
                @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Payment Account')"))
                        .DataSource(d => d.WebApi()
                        .Controller("VoucherMaster")
                        .LoadAction("GetBPPaymentAccounts")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AccountHead")
                        )
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("accountDropDownBox")

                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .Value("Riyadh Bank")
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .Width(720)
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        .Width(1000)
                        )
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                        )

            </div>
        </div>


        <div class="dx-fieldset horizontal-container " style="margin-bottom:0px;">

            <div class="form-group">
                <div class="button-alignment-down">
                </div>
                @(
                        Html.DevExtreme().SelectBox()
                        .Label(new JS("formatMessage('Dr/Cr')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("sbDrCr")
                        .DataSource(new[] { "Dr", "Cr" })
                        .Value("Dr")
                        .OnValueChanged("onVoucherDrCrValueChanged") // JS function name
                        .Placeholder("Select Transaction Type")
                        .Width(112)
                        )
            </div>
            <div class="form-group">
                @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Account Head')"))
                        .DataSource(d => d.WebApi()
                        .Controller("VoucherMaster")
                        .LoadAction("GetAccountHead")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AccountHead")
                        )
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message(new JS("formatMessage('Ledger Account should be entered')"));
                        })
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddAccountHead")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .Width(650)
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        .Width(1000)
                        )
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                        )
            </div>
            <div class="plusBtn">
                <div class="form-group">
                    @(Html.DevExtreme().Button()
                            .ID("btnAddAHead")
                            .Icon("plus")
                            .OnClick("showLedgerAccountPopup")
                            )

                    <!-- DevExtreme Popup -->
                    @(Html.DevExtreme().Popup()
                            .ID("ledgerAccountPopup")
                            .Width("93%")
                            .Height("85%")
                            .Title("Add Ledger Account")
                            .ShowTitle(true)
                            .CloseOnOutsideClick(true)
                            .Visible(false)
                            .ResizeEnabled(true)
                            .ContentTemplate(@<text>
                        <div id="popupContent" class="background" style="width:100%; height:100%;">
                            <iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
                        </div>
                    </text>)
                            )

                </div>
                <div class="form-group">
                    @(Html.DevExtreme().Button()
                            .ID("btnEditAHead")
                            .Icon("edit")
                            .OnClick("showLedgerAccountEditPopup")
                            )

                    @(Html.DevExtreme().Popup()
                            .ID("ledgerEditAccountPopup")
                            .Width("93%")
                            .Height("85%")
                            .Title("Edit Ledger Account")
                            .ShowTitle(true)
                            .CloseOnOutsideClick(true)
                            .Visible(false)  // Hidden by default
                            .ResizeEnabled(true)
                            .ContentTemplate(@<text>
                        <div id="popupContent" style="width:100%; height:100%;">
                            <iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
                        </div>
                    </text>)
                            )
                </div>
            </div>

            <div class="form-group">
                @(
                        Html.DevExtreme().NumberBox()
                        .Label(new JS("formatMessage('Amount')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("txtVoucherAmount")
                        .Value(null)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Voucher Amount Cannot be Zero Or Negative");
                            rules.AddRange().Min(0).Message("Voucher Amount Cannot be Zero Or Negative");
                        })
                        .Placeholder("0.000")
                        .Format("###,###,###,##0.00")  // Numeric format with thousands separator and two decimal places
                        .InputAttr(new { type = "number", step = "0.01", style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;", maxLength = 16, autocomplete = "off" })
                        .Width(180)// HTML attribute to allow decimal input
                        )

            </div>


        </div>

        <div class="dx-fieldset horizontal-container " style="margin-top:0px;margin-bottom:0px;padding-top:10px;">
            <div class="form-group">
            </div>
            <div class="form-group">
                @(
                        Html.DevExtreme().TextArea()
                        .Label(new JS("formatMessage('Narration')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("txtEntryNarration")
                        .Value("")
                        .Height(40)
                        .Width(720)
                        .Placeholder(new JS("formatMessage('Enter your comments here...')"))
                        .MaxLength(111500)

                        )
            </div>
            <div class="form-group plusBtn" style="">
                @(Html.DevExtreme().Button()
                        .ID("btnVoucherEntry")
                        .Text(new JS("formatMessage('ADD')"))
                        .Height(40)
                        .Width(178)
                        .Icon("plus")
                        .OnClick("function() { addVoucherEntry(); }")
                        )
            </div>

        </div>

        <div class="dx-field ledgerResult">

            @(
                        Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                        .ID("dataGrid")
                        .RemoteOperations(false)
                        .Columns(columns =>
                        {
                            columns.AddFor(m => m.VoucherEntryNo)
                        .Caption(new JS("formatMessage('Voucher Entry No')"))
                        .Visible(false);

                            columns.AddFor(m => m.DrCr)
                        .Caption(new JS("formatMessage('Dr/Cr')"))
                        .DataType(GridColumnDataType.String).Lookup(lookup => lookup
                        .DataSource(new[] { "Dr", "Cr" }) // Data source for dropdown
                        .ValueExpr("this")
                        .DisplayExpr("this")
                        );



                            columns.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('Account Head')"))
                        .CellTemplate(@<text>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span>
                        <%- data.AccountHead ? data.AccountHead : "No Selection" %>
                    </span>
                </div>
            </text>)
                    .EditCellTemplate(@<text>


                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("VoucherMaster")
                .LoadAction("GetEditAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )

                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBoxEdit")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change")
                .HoverStateEnabled(true)
                .Value(new JS("data.AccountHead"))
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .OnValueChanged("gridBox_valueChanged")
                .OnOpened("onOpened")
                @* .Width(250) *@
                .TabIndex(1)
                .DropDownOptions(o => o.Width(500))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("AccountHeadEditDropdownContentTemplate"))
                )


            </text>);

                            columns.AddFor(m => m.DrAmount).Caption(new JS("formatMessage('Debit')")).Alignment(HorizontalAlignment.Right).CustomizeText(
                        "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                        ).AllowEditing(false);


                            columns.AddFor(m => m.CrAmount)
                        .Caption(new JS("formatMessage('Credit')"))
                        .AllowEditing(false)
                        .Alignment(HorizontalAlignment.Right)

                    @* .EditCellTemplate(@<input dx-number-box data-bind="value: $data.CrAmount" />) *@
                    .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");


                            columns.AddFor(m => m.EntryNarration)
                        .Caption(new JS("formatMessage('Entry Narration')"))
                        .AllowEditing(true) // Allow editing for this column

                        ;


                            columns.AddFor(m => m.SysRemarks)
                        .Caption(new JS("formatMessage('Remarks')"))
                        .AllowEditing(false)
                        ;


                        })
                    .Selection(selection => selection.Mode(SelectionMode.Single))
                    .AllowColumnReordering(true) // Enable column reordering
                    .AllowColumnResizing(true)   // Enable column resizing
                    .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                                                                  //.HeaderFilter(filter => filter.Visible(true))
                    .Height(250)
                    .ColumnAutoWidth(true)
                    .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                    .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                    .ShowBorders(true)
                    .Width("100%")
                    .Editing(editing => editing
                    .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                    .AllowUpdating(true)   // Enable editing of existing rows
                     .AllowDeleting(true)   // Enable deleting rows
                     .UseIcons(true) // Enables icons for editing buttons
                    )
                    .OnEditorPreparing("onEditorPreparing")
                    .OnRowUpdating("onRowUpdating")
                    .OnRowRemoving("onRowRemoving") // Ensure correct capitalization
                        .OnRowPrepared(@"
            function(e) {
            if (e.rowType === 'data' && e.data.DrCr === 'Cr') {
            $(e.rowElement).css('background-color', 'lightgray');
            }
            }
            ")
                    .Summary(summary =>

                    {

                        summary.TotalItems(totalItems =>

                        {

                            totalItems.Add().Column("DrAmount").SummaryType(SummaryType.Sum)

                        .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                            totalItems.Add().Column("CrAmount").SummaryType(SummaryType.Sum)

                        .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        });

                    })
                    )


        </div>



        <div id="chequePopupContainer"></div>


        <!-- Context Menu for Actions -->
        <ul id="contextMenu" class="context-menu" style="display: none;">
            <li onclick="editCostAllocation()">
                <i class="fas fa-edit" style="margin-right: 8px;"></i><div id="EditCostAllocation" class="no-border-input"></div>
            </li>
            <li onclick="editBillsReceivable()">
                <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditBillReceivable" class="no-border-input"></div>
            </li>
            <li onclick="editSalaryPayable()">
                <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditSalaryPayable" class="no-border-input"></div>
            </li>
            <li onclick="editEmployeeAllocation()">
                <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditEmployeeAllocation" class="no-border-input"></div>
            </li>
            <li onclick="editPropertyAllocation()">
                <i class="fas fa-cogs" style="margin-right: 8px;"></i><div id="EditPropertyAllocation" class="no-border-input"></div>
            </li>
          @*   <li onclick="onRowRemoving()">
                <i class="fas fa-trash-alt" style="margin-right: 8px;"></i><div id="DeleteLineEntry" class="no-border-input"></div>
            </li> *@
            <li onclick="onAllRowRemoving()">
                <i class="fas fa-trash-alt" style="margin-right: 8px;"></i><div id="DeleteAllLineEntries" class="no-border-input"></div>
            </li>
        </ul>

