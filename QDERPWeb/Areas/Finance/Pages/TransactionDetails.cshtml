function loadPivotGridData() {
    // Show loader
    $("#pivotLoader").show();
    $("#pivotGridContainer").hide(); // Hide grid until ready

    $.ajax({
        url: '/api/TransactionDetails/GetVoucherForAudits',
        type: 'GET',
        success: function (data) {
            // Filter out rows with "Opening Balance"
            const filteredData = data.filter(item => item.VoucherNo !== "Opening Balance");

            $("#pivotGridContainer").dxPivotGrid({
                dataSource: {
                    store: {
                        type: "array",
                        data: filteredData
                    },
                    fields: [
                        // Your fields here (as before)
                        { dataField: "VoucherNo", area: "row", caption:formatMessage("Voucher No"), expanded: true, width: 150, allowSorting: true, allowFiltering: true },
                        { dataField: "AccountHeadName", area: "row", caption:formatMessage("Account Head Name"), expanded: true, width: 250, allowSorting: true, allowFiltering: true },
                        { dataField: "DrCr", area: "row", caption:formatMessage("DrCr"), expanded: true, width: 100, allowSorting: true, allowFiltering: true },
                        { dataField: "CrAmount", area: "data", caption:formatMessage("CrAmount"), summaryType: "sum", format: { type: "fixedPoint", precision: 2 }, width: 180 },
                        { dataField: "DrAmount", area: "data", caption:formatMessage("DrAmount"), summaryType: "sum", format: { type: "fixedPoint", precision: 2 }, width: 180 }
                    ]
                },
                // ... Other pivotGrid options ...
                allowSortingBySummary: true,
                allowSorting: true,
                allowFiltering: true,
                allowExpandAll: true,
                showBorders: true,
                showColumnHeaders: true,
                showColumnTotals: true,
                showRowTotals: false,
                showColumnGrandTotals: true,
                showRowGrandTotals: false,
                wordWrapEnabled: true,
                height: 500,
                fieldChooser: {
                    enabled: true,
                    allowSearch: true,
                    layout: 0
                },
                scrolling: {
                    mode: "virtual"
                },
                fieldPanel: {
                    visible: true,
                    allowFieldDragging: true,
                    showColumnFields: true,
                    showDataFields: true,
                    showFilterFields: true,
                    showRowFields: true
                },
                loadPanel: { enabled: true }
            }).dxPivotGrid("instance");

            // Hide loader and show grid
            $("#pivotLoader").hide();
            $("#pivotGridContainer").show();
        },
        error: function (xhr, status, error) {
            $("#pivotLoader").hide();
            $("#pivotGridContainer").show();
            console.error("Error fetching data: ", error);
        }
    });
}


        $("#btnShowRowTotals").on("click", function (e) {
            e.preventDefault();

            const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");

            if (pivotGrid) {
                const currentSetting = pivotGrid.option("showRowTotals");
                pivotGrid.option("showRowTotals", !currentSetting);
            }
        });

        $("#btnShowFields").on("click", function (e) {
            e.preventDefault();

            const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");

            if (!pivotGrid) return;

            const dataSource = pivotGrid.getDataSource();
            const currentFields = dataSource.fields();

            const allFields = [
                
                { dataField: "VoucherDate", caption:formatMessage("Voucher Date") },
                { dataField: "VoucherRefNo", caption:formatMessage("Voucher Ref No") },
                { dataField: "VoucherNarration", caption:formatMessage("Voucher Narration") },
                { dataField: "VoucherEnteredBy", caption:formatMessage("Voucher Entered By") },
                { dataField: "VoucherEnteredOn", caption:formatMessage("Voucher Entered On") },
                { dataField: "VoucherVerifiedBy", caption:formatMessage("Voucher Verified By")},
                { dataField: "VoucherVerifiedOn", caption:formatMessage("Voucher Verified On") },
                { dataField: "VoucherApprovedBy", caption:formatMessage("Voucher Approved By") },
                { dataField: "VoucherApprovedOn", caption:formatMessage("Voucher Approved On") },
                { dataField: "VoucherEntryNo", caption:formatMessage("Voucher Entry No") },
                { dataField: "AccountHead", caption:formatMessage("Account Head") },
                { dataField: "VoucherAmountFormatted", caption:formatMessage("Voucher Amount Formatted") },
                { dataField: "EntryNarration", caption:formatMessage("Entry Narration") },
                { dataField: "AccountGroup", caption:formatMessage("Account Group") }
            ];

            // Check if all fields are already in the "filter" area
            const allInFilter = allFields.every(f =>
                currentFields.find(c => c.dataField === f.dataField && c.area === "filter")
            );

            const updatedFields = currentFields.map(field => {
                const isTargetField = allFields.find(f => f.dataField === field.dataField);
                if (isTargetField) {
                    return {
                        ...field,
                        area: allInFilter ? null : "filter"
                    };
                }
                return field;
            });

            dataSource.fields(updatedFields);
            dataSource.load();

           
        });




    $(document).ready(function () {
        loadPivotGridData();
    });
</script>

