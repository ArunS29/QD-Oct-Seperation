@* @model YourNamespace.YourPageModel
@{
    Layout = null;
} *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Goods and Services</title>
    <style>
        .dx-fieldset {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            padding: 20px;
            background-color: transparent;
            width: 250px;
            height:10%;

        }
       

        .dx-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-left:10px;
        }

        .field-label {
            font-weight: bold;
        }

        .aligned-input {
            width: 100%;
        }

        .dx-card {
            padding: 20px;
            background-color: transparent;
            width: 100%;
            margin: auto;
            border-radius: 8px;
        }

        .input-group {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dx-textarea {
            width: 100%;
            height: 60px;
        }
        .dx-card{
            width : 1460px;
        }

        .limited-footer .btn-container:not(:has(#btnSave,#btnBack)) {
            display: none !important;
        }
    </style>
   
</head>
<body>
    <div class="dx-card">
        <h3>Database Master Module:Unit of Measure</h3>
        <!-- Row 1: Type a New UOM & Add to the Existing List: -->
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 800%;">
                    <tr>
                        <td colspan="2">
                            
                            @(Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessage('Type a New UOM & Add to the Existing List:')"))
                                .LabelMode(EditorLabelMode.Outside)
                            .ID("txtGoodsCode7").Width("75%"))
                        </td>
                    </tr>
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextArea()
                                .Label(new JS("formatMessage('UoM Description:')"))
                                .LabelMode(EditorLabelMode.Outside)
                            .ID("txtDescription8").Width("95%").Height(60))
                        </td>
                        <td>
                            <div style="display: flex; gap: 10px; width: 100%;">
                                <!-- Language Button -->
                                <div style="padding-top:25px;">
                                    @(Html.DevExtreme().Button()
                                        .ID("convertToArabic1")
                                        .Width(45)
                                        .Height(40)
                                        .Icon("fas fa-language")
                                        .ElementAttr(new { @class = "input-button" })
                                        .OnClick("function() { convertToArabic(); }"))
                                </div>

                                <!-- Arabic TextArea -->
                                <div style="flex: 1;">
                                    @(Html.DevExtreme().TextArea()
                                        .Label(new JS("formatMessage('UoM Description(in Arabic):')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        .ID("txtDescriptionArabic")
                                        .Width("100%")
                                        .Height(45))
                                </div>
                                <div style="flex: 1; padding-top:25px;">
                                    @(Html.DevExtreme().Button()
                                        .Text(new JS("formatMessage('Add')"))
                                        .ID("btnAddGroup3").Icon("plus").Height(60))
                                </div>
                            </div>

                        </td>
    
                    </tr>
                </table>
            </div>
				
           

        </div>
        </div>


    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201617vatinvoiceInDetail>()
            .ID("dataGrid")
            .RemoteOperations(false)
            .DataSource(new JS("[]"))
            .Columns(columns =>
            {
                columns.Add().DataField("ID").Caption(new JS("formatMessage('ID')")).Alignment(HorizontalAlignment.Center);
                columns.Add().DataField("Unit Type").Caption(new JS("formatMessage('Unit Type')")).Alignment(HorizontalAlignment.Center);
                columns.Add().DataField("Description").Caption(new JS("formatMessage('Description')")).Alignment(HorizontalAlignment.Center);
                columns.Add().DataField("Description (Arabic)").Caption(new JS("formatMessage('Description (Arabic)')")).Alignment(HorizontalAlignment.Center);
            })
            .Editing(editing => editing
            .Mode(GridEditMode.Row)
            .AllowUpdating(true)
            )
            .OnCellClick("function(e) {handleCellClick(e);}")
            .AllowColumnReordering(true)
           @*  .ColumnChooser(columnChooser => columnChooser.Enabled(false)) *@
            .AllowColumnResizing(true)
         @*    .ColumnFixing(fixing => fixing.Enabled(true)) *@
            .HeaderFilter(filter => filter.Visible(false))
            .Height(300)
            .FilterRow(filterRow => filterRow.Visible(false))
            .GroupPanel(groupPanel => groupPanel.Visible(false))
            .ShowBorders(true)
            .ShowRowLines(true)
            .Width("100%")
            )
    </div>

    <div class="Head">
        <div class="limited-footer">
            @await Html.PartialAsync("VATModuleFooter")
        </div>
    </div>
</body>
</html>
<script>
       $(document).ready(function () {

        $(".limited-footer .btn-containerIvoiceEdit").each(function () {

            if (!$(this).find("#btnSave,#btnBack").length) {

                $(this).remove();

            }

        });

    });
</script>
