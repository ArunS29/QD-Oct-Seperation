<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Goods and Services</title>
    <style>
        .dx-fieldset {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            padding: 15px;
            background-color: transparent;
            width: 200px;

        }
       

        .dx-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .field-label {
            font-weight: bold;
        }

        .aligned-input {
            width: 100%;
        }

        .dx-card {
            padding: 20px;
            background-color: transparent;
            width: 100%;
            margin: auto;
            border-radius: 8px;
        }

        .input-group {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dx-textarea {
            width: 100%;
            height: 60px;
        }
        .dx-card{
            width : 1460px;
        }
         
        .limited-footer .btn-containerIvoiceEdit:not(:has(#btnSave,#btnBack)) {
            display: none !important;
        }
    </style>
   
</head>
