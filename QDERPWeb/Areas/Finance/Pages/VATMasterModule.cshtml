                    <div class="dx-field ledgerResult">
                @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201617vatinvoiceInDetail>()
                    .ID("dataGrid")
                    .RemoteOperations(false)
                    .DataSource(new JS("[]"))
                    .Columns(columns =>
                    {

                        columns.AddFor(m => m.InvoiceNo).Caption(new JS("formatMessage('ID')")).Alignment(HorizontalAlignment.Center).Visible(true);
                        columns.AddFor(m => m.InvoiceNo).Caption(new JS("formatMessage('Unit Type')")).Alignment(HorizontalAlignment.Center).Visible(true);
                        columns.AddFor(m => m.InvoiceDate).Caption(new JS("formatMessage('Description')")).Alignment(HorizontalAlignment.Center).Visible(true);
                        columns.AddFor(m => m.ClientName).Caption(new JS("formatMessage('Description (in Arabic)')")).Alignment(HorizontalAlignment.Center).Visible(true);
            })
                    .Editing(editing => editing
                    .Mode(GridEditMode.Row)
                    .AllowUpdating(true)
                    ) 

                    .OnCellClick("function(e) {handleCellClick(e);}")
                    //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.Select))
                    .AllowColumnReordering(true)
                    .AllowColumnResizing(true)
                    .ColumnFixing(fixing => fixing.Enabled(true))
                    .HeaderFilter(filter => filter.Visible(false))
                    .Height(300)
                    .FilterRow(filterRow => filterRow.Visible(false))
                    .GroupPanel(groupPanel => groupPanel.Visible(false))
                    .ShowBorders(true)
                    .ShowRowLines(true)
                    .Width("100%")
                    )
            </div>
    <div class="Head">
        <div class="limited-footer">
            @await Html.PartialAsync("VATModuleFooter")
        </div>
    </div>
</body>
</html>
<script>
        $(document).ready(function () {

        $(".limited-footer .btn-containerIvoiceEdit").each(function () {
            if (!$(this).find("#btnSave,#btnBack").length) {
                $(this).remove();

            }

        });

    });
</script>
