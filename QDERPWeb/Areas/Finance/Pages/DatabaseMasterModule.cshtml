@page
@model QD.ERP.Web.Areas.Finance.Pages.DatabaseMasterModuleModel
@{
}

<style>
    .dx-fieldset {
        border: 1px solid #d3d3d3;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        background-color: #f8f9fa; /* Light background */
    }

    .dx-field {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }

        .dx-field label {
            width: 200px; /* Adjust label width for alignment */
            font-weight: bold;
            color: #333;
            text-align: right; /* Align labels properly */
            padding-right: 10px;
        }

        .dx-field .dx-textbox,
        .dx-field .dx-numberbox {
            flex-grow: 1; /* Makes input fields take remaining space */
            max-width: 400px; /* Ensures width consistency */
        }

    .dx-fieldset .dx-field-container {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .dx-field-container div {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .dx-button {
        margin-left: 10px;
        height: 38px;
        display: flex;
        align-items: center;
    }

    #gridCurrencyMaster .dx-datagrid-headers .dx-header-row {
        background-color: #007bff;
        color: white;
        font-weight: bold;
    }

    .dx-datagrid {
        margin-top: 15px;
    }

    .limited-footer .btn-container:not(:has(#btnMoveDown,#btnMoveUp,#btnSave,#btnSaveAndClose,#btnPrint1,#btnAddNew,#btnDelete,#btnBack,#btnVerify,#btnApprove,#btnAttach,#btnPostToLedgers,#btnPostTag)) {
        display: none !important;
    }

</style>

<div class="dx-fieldset">
    <label style="font-size: 14px; font-weight: bold;">Type a New Currency Details & Add to the Existing List:</label>

    <div class="dx-field">
        
        @(Html.DevExtreme().TextBox()
            .Label("Currency Name:")
        .ID("txtCurrencyName").Width(400))
    </div>

    <div class="dx-field">
        
        @(Html.DevExtreme().TextBox()
        .Label("Currency Name (In Arabic):")
        .ID("txtCurrencyNameAr").Width(400))
    </div>

    <div class="dx-field">
        
        @(Html.DevExtreme().NumberBox()
            .ID("currencyexchangerate")
            .Label("Currency Exchange Rate:")
            .Min(1)
            .Step(1)
            .ShowSpinButtons(true)
            .Width(200)
            )
    </div>

    <div>
        <div class="dx-field-container">
            <div>
               
                @(Html.DevExtreme().TextBox()
                .Label("Currency Code:")
                .ID("txtCurrencyCode").Width("100%"))
            </div>
            <div>
               
                @(Html.DevExtreme().TextBox()
                .Label("Currency Code (In Arabic):")
                .ID("txtCurrencyCodeAr").Width("100%"))
            </div>
            <div>
                @(Html.DevExtreme().Button()
                    .ID("btnAddCurrency")
                    .Text("Add")
                    .Icon("plus")
                    .Type(ButtonType.Success)
                    .Width("50%")
                    .OnClick("addCurrency")
                    )
            </div>
        </div>
    </div>
</div>


@(Html.DevExtreme().DataGrid()
    .ID("gridCurrencyMaster")
   .DataSource(new JS("[]")) // Assuming a Model with Currency List.
    .ShowBorders(true)
    .Columns(columns =>
    {
        columns.Add().DataField("ID").Caption("ID").Width(50);
        columns.Add().DataField("CurrencyName").Caption("Currency Name").Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("CurrencyNameAr").Caption("Currency Name Ar").Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("ExchangeRate").Caption("Exchange Rate").Format("#,##0.##").Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("CurrencyCode").Caption("Currency Code").Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("CurrencyCodeAr").Caption("Currency Code Ar").Alignment(HorizontalAlignment.Center);
    })
)
<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("VATModuleFooter")
    </div>
</div>


<script>
    $(document).ready(function () {

        $(".limited-footer .btn-containerIvoiceEdit").each(function () {

            if (!$(this).find("#btnSave,#btnBack").length) {

                $(this).remove();

            }

        });

    });
    function addCurrency() {
        // Add currency logic here
        DevExpress.ui.notify("Currency Added Successfully", "success", 2000);
    }

    function updateCurrency() {
        // Update logic here
        DevExpress.ui.notify("Updated Successfully", "success", 2000);
    }

    function goBack() {
        // Navigation logic here
        window.history.back();
    }
</script>

