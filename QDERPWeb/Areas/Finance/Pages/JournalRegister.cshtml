        $(".limited-footer .btn-containerIvoiceEdit").each(function () {
            if (!$(this).find("#btnPrint, #btnToggleSearch, #btntoggleGroupPanel, #btnCreateNew, #ddButtonLayout").length) {
                $(this).remove();
            }
        });
    });

</script>

