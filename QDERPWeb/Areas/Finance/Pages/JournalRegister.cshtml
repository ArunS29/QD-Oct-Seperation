<script type="text/javascript">
    $(function () {
                $("#JournalRegister").dxTextBox({
                        text:formatMessage("Journal Register"),
                        readOnly: true,
                        onContentReady: function(e) {
                        $(e.element).addClass("dx-textbox-heading");
                }
                });
        getJournalOnLoad();
        var contextMenu = $("#contextMenu");
        var contextMenuContent = $("#contextMenuContent");
        // Apply the custom context menu plugin
        $("#dataGrid").customizeGridContextMenu();

        $(document).on('keydown', function (e) {
            if (e.ctrlKey && e.key === 'r') {
                e.preventDefault();
                $("#requestedBy").dxSelectBox("instance").focus();
            }
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                $("#startDate").dxDateBox("instance").focus();
            }
            if (e.ctrlKey && e.key === 'e') {
                e.preventDefault();
                $("#endDate").dxDateBox("instance").focus();
            }
        });

        // Hide context menu on click outside
        $(document).on("click", function () {
            contextMenu.hide();
        });
        $('.spneditJournal').click(function () {
            let dataGrid = $("#dataGrid").dxDataGrid("instance");
            let selectedRow = dataGrid.getSelectedRowsData();

            if (selectedRow.length > 0) {
                let journalRefNo = selectedRow[0].JournalRefNo;

                if (journalRefNo && journalRefNo.toString().trim() !== "") {
                    // Proceed only with JournalRefNo
                    let targetUrl = `/${tenantName}/Finance/JournalEntryEdit?journalRefNo=${encodeURIComponent(journalRefNo)}`;
                    console.log("Navigating to:", targetUrl);
                    window.location.href = targetUrl;
                } else {
                    alert("Journal Reference Number is missing.");
                }
            } else {
                alert("Please select a row to edit.");
            }
        });


        // Handle right-click event on the DataGrid rows
        $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
            e.preventDefault(); // Prevent the default context menu
            var rowIndex = $(this).index(); // Get the row index
            var rowData = $("#dataGrid").dxDataGrid("instance").getDataSource().items()[rowIndex]; // Get the data for the row
            console.log(rowData); // Log or use the row data as needed
            // Clear previous content
            contextMenuContent.empty();
            // Add column titles and values to the context menu
            contextMenuContent.append("<div style='display:none'><strong>Voucher No:</strong> " + rowData.VoucherNo + "</div>");
            // Show custom context menu
            contextMenu.css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
        });
        $("#dataGrid").dxDataGrid({
            onRowUpdating: function (e) {
                console.log("Row is updating", e);
            },
            onSaving: function (e) {
                const changes = e.changes;

                // Prepare data to send to the server
                //alert(JSON.stringify(changes));
                const updatedData = changes.map(change => change.data);

                // If no changes are made, exit early
                if (updatedData.length === 0) {
                    return;
                }

                // Send the data to the server via AJAX
                $.ajax({
                    type: "POST",
                    url: "/api/JournalRegister/UpdateData", // Adjust the URL to your controller and action
                    contentType: "application/json",
                    data: JSON.stringify(updatedData),
                    success: function (response) {
                        if (response.success) {
                            // Reload or refresh the grid if needed
                            $("#dataGrid").dxDataGrid("instance").refresh();
                        } else {
                            alert("Update failed: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        // alert("Error occurred while updating data: " + error);
                    }
                });
            }
        });
    });
    function formatedate(dateval) {
        var dateObject = new Date(dateval);
        // Extract year, month, and day
        var year = dateObject.getFullYear(); // 2024
        var month = ('0' + (dateObject.getMonth() + 1)).slice(-2); // Months are 0-based, so add 1 and format
        var day = ('0' + dateObject.getDate()).slice(-2); // Format day to ensure two digits
        // Format as YYYY-MM-DD
        var formattedDate = `${year}-${month}-${day}`;
        return formattedDate;
    }
    function getJournalOnLoad() {
        var requesterID = 102;
        // Get the current date
        var currentDate = new Date();
        // Get the start date of the current month
        var startDateval = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
        var startDate = formatedate(startDateval);
        // Get the end date of the current month
        var endDateval = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
        var endDate = formatedate(endDateval);

        $.ajax({
            url: '/api/JournalRegister/GetJournalview',  // API endpoint
            type: 'GET',
            data: {
                RequesterID: requesterID, // Set this according to your logic
                StartDate: startDate, // Start date
                EndDate: endDate, // End date
                IfShowAll: false // Set to
            },
            success: function (data) {
                // Bind the data to the DataGrid
                $("#dataGrid").dxDataGrid("instance").option("dataSource", data);
                // DevExpress.ui.notify("Data fetched successfully", "success", 2000);
            },
            error: function () {
              //  DevExpress.ui.notify("Error while loading data", "error", 2000);
            }
        });

    }
    function getAllSubmissionJournal() {
        var startDateInstance = $("#startDate").dxDateBox("instance");
        var startDateval = startDateInstance.option("value");
        var startDate = formatedate(startDateval);

        var endDateInstance = $("#endDate").dxDateBox("instance");
        var endDateval = endDateInstance.option("value");
        var endDate = formatedate(endDateval);

        $.ajax({
            url: '/api/JournalRegister/GetJournalview',  // API endpoint
            type: 'GET',
            data: {
                RequesterID: "", // Set this according to your logic
                StartDate: startDate, // Start date
                EndDate: endDate, // End date
                IfShowAll: true
            },
            success: function (data) {
                // Bind the data to the DataGrid
                $("#dataGrid").dxDataGrid("instance").option("dataSource", data);
                // DevExpress.ui.notify("Data fetched successfully", "success", 2000);
            },
            error: function () {
                // DevExpress.ui.notify("Error while loading data", "error", 2000);
            }
        });
    }



    // This function used to call API to get records for the selected values.
    function ddBtnShowRecords_click(duration) {

        var dropDownBoxInstance = $("#requestedBy").dxSelectBox("instance");
        var selectedValue = dropDownBoxInstance.option("value");
        var requesterID = selectedValue ? selectedValue.UserId : null;

        if (dropDownBoxInstance.option("value") === null) {
            alert("Please select a requestedBy.");
            return;
        }
        var frmDateBox = $("#startDate").dxDateBox("instance");
        var toDateBox = $("#endDate").dxDateBox("instance");
        var frmDate = new Date(frmDateBox.option("value"));
        var toDate = new Date(toDateBox.option("value"));
        var currentDate = new Date();
        switch (duration) {
            case 'today':
                frmDate = toDate = currentDate;
                break;
            case 'yesterday':
                var dateObj = new Date();
                // Subtract one day from current time
                dateObj.setDate(dateObj.getDate() - 1);
                frmDate = toDate = dateObj;
                break;
            case 'week':
                var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

                // Calculate the start of the week (Saturday)
                var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

                // Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
                frmDate = new Date(currentDate.setDate(startOfWeek - 7)); // 7 days before Saturday
                toDate = new Date(currentDate.setDate(startOfWeek - 1));
                break;
            case 'tillmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
                toDate = currentDate; //Today
                break;
            case 'fullmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
                break;
            case 'tillyear':
                // Get the first and last day of the current year
                frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
                toDate = currentDate;// Today
                break;
            case 'fullyear':
                // Get the first and last day of the current year
                frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
                break;
            case 'lastyear':
                // Get the first and last day of the last year
                frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
                toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
                break;
            case 'lastmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
                break;
        }
        frmDate = frmDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        toDate = toDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        frmDateBox.option("value", frmDate);  // Set frmDateBox value
        toDateBox.option("value", toDate);    // Set toDateBox value
        $.ajax({
            url: '/api/JournalRegister/GetJournalview',  // API endpoint
            type: 'GET',
            data: {
                RequesterID: requesterID, // Set this according to your logic
                StartDate: frmDate, // Start date
                EndDate: toDate, // End date
                IfShowAll: false // Set to
            },
            success: function (data) {
                // Bind the data to the DataGrid
                $("#dataGrid").dxDataGrid("instance").option("dataSource", data);
                DevExpress.ui.notify("Data fetched successfully", "success", 2000);
            },
            error: function () {
              //  DevExpress.ui.notify("Error while loading data", "error", 2000);
            }
        });
    }
    // Function to format date in required format



