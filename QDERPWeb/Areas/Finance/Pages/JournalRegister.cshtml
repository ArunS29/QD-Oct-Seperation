@page
@using DevExtreme.AspNet.Mvc
<style>

    /* CSS */
    .context-menu {
        width: 250px;
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        padding: 10px;
        font-family: Arial, sans-serif;
    }

    .context-menu-item .menu-item {
        display: flex;
        align-items: center;
        padding: 8px;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s ease;
        margin-bottom: 5px;
    }

        .context-menu-item .menu-item:last-child {
            margin-bottom: 0;
        }

        .context-menu-item .menu-item:hover {
            background-color: #d5e3f5;
        }

    .context-menu-item i {
        margin-right: 10px;
        font-size: 16px;
        color: #333;
    }

    .spnRightClickGride {
        color: #333;
        font-size: 14px;
    }


    .spnRightClickGride {
        margin-left: 10px;
    }

    #dropdownContainer {
        position: absolute;
        z-index: 1000;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
        padding: 10px;
    } 

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    .limited-footer .btn-container:not(:has(#btnPrint, #btnToggleSearch, #btntoggleGroupPanel, #btnCreateNew, #ddButtonLayout)) {
        display: none !important;
    }
</style>
