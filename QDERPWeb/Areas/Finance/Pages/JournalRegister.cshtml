            $(".context-menu").on("click", ".menu-item", function () {
                const actionLabel = $(this).find(".spnRightClickGride").text().trim();

                switch (actionLabel) {
                    case "Edit Journal Entry Form":
                        handleEditJournalEntry();
                        break;
                    case "Delete Journal Entry Form":
                        handleDeleteJournalEntry();
                        break;
                    case "Unlock Journal Entry Form":
                        handleUnlockJournalEntry();
                        break;
                    case "Clone Journal Entry Form":
                        handleCloneJournalEntry();
                        break;
                    default:
                        DevExpress.ui.notify("Unknown action.", "warning", 2000);
                }
            });

            function handleEditJournalEntry() {
                const dataGrid = $("#dataGrid").dxDataGrid("instance");
                const selectedRow = dataGrid.getSelectedRowsData();

                if (selectedRow.length > 0) {
                    const journalRefNo = selectedRow[0].JournalRefNo;
                    if (journalRefNo && journalRefNo.trim() !== "") {
                        const targetUrl = `/${tenantName}/Finance/JournalEntryEdit?journalRefNo=${encodeURIComponent(journalRefNo)}`;
                        window.location.href = targetUrl;
                    } else {
                        alert("Journal Reference Number is missing.");
                    }
                } else {
                    alert("Please select a row to edit.");
                }
            }

            function handleDeleteJournalEntry() {
                const dataGrid = $("#dataGrid").dxDataGrid("instance");
                const selectedRow = dataGrid.getSelectedRowsData();

                if (selectedRow.length > 0) {
                    const journalRefNo = selectedRow[0].JournalRefNo;

                    if (journalRefNo && journalRefNo.trim() !== "") {
                        $.ajax({
                            type: "GET",
                            url: "/api/JournalRegister/GetJournalStatus",
                            contentType: "application/json",
                            data: { journalRefNo: journalRefNo },
                            success: function (response) {
                                if (response) {
                                    const { isSubmitted, isApproved, isPosted } = response;

                                    if (isSubmitted) {
                                        DevExpress.ui.dialog.alert("Journal Entry is already Submitted, You cannot delete the Submitted JV.", "JV is submitted already");
                                    } else if (!isSubmitted && isApproved || isPosted) {
                                        DevExpress.ui.dialog.alert("Journal Entry is already Approved, You cannot delete the Approved JV.", "JV is Approved already");
                                    } else if (isSubmitted && isApproved && isPosted) {
                                        DevExpress.ui.dialog.alert("Journal Entry is already Paid, You cannot delete the Posted JV.", "Warning");
                                    } else if (!isSubmitted && !isApproved && !isPosted) {
                                        let result = DevExpress.ui.dialog.confirm(
                                            "You are about to delete the Journal Entry from the Register,<br/>Click Yes if you would like to continue.",
                                            "Confirm Deletion"
                                        );
                                        result.done(function (dialogResult) {
                                            if (dialogResult) {
                                                $.ajax({
                                                    type: "POST",
                                                    url: `/api/JournalRegister/DeleteJournalEntry?journalRefNo=${encodeURIComponent(journalRefNo)}`,
                                                    contentType: "application/json",
                                                    success: function (deleteResponse) {
                                                        if (deleteResponse.success) {
                                                            getAllSubmissionJournal();
                                                            DevExpress.ui.notify("Journal Entry deleted successfully.", "success", 2000);
                                                        } else {
                                                            DevExpress.ui.notify("Failed to delete Journal Entry.", "error", 2000);
                                                        }
                                                    },
                                                    error: function () {
                                                        DevExpress.ui.notify("Error occurred during deletion.", "error", 2000);
                                                    }
                                                });
                                            }
                                        });
                                    }
                                } else {
                                    DevExpress.ui.notify("Failed to fetch journal status.", "error", 2000);
                                }
                            },
                            error: function () {
                                DevExpress.ui.notify("Error fetching journal status.", "error", 2000);
                            }
                        });
                    } else {
                        DevExpress.ui.dialog.alert("Journal Reference Number is missing.", "Error");
                    }
                } else {
                    DevExpress.ui.dialog.alert("Please select a row to delete.", "Error");
                }
            }
            

            function handleUnlockJournalEntry() {
                const dataGrid = $("#dataGrid").dxDataGrid("instance");
                const selectedRow = dataGrid.getSelectedRowsData();
                if (!selectedRow || selectedRow.length === 0) {
                    DevExpress.ui.notify("Please select a row to unlock.", "warning", 2000);
                     return;
                 }
    

                   const journalRefNo = selectedRow[0].JournalRefNo;
                    const isPosted = selectedRow[0].IsPosted;

                  if (isPosted) {
                         DevExpress.ui.dialog.alert("Claim is already Posted, You can't unlock the Posted JV.", "JV is posted already");
                         return;
                   }

                   DevExpress.ui.dialog.confirm(
                        "You are about to unlock the JV.</br>Click Yes if you would like to continue.",
                        "Unlock Confirmation"
                    ).done(function (dialogResult) {
                 if (dialogResult) {
                  // Perform AJAX request to update the database
                   $.ajax({
                   url:  `/api/JournalRegister/UnlockJournalEntry?journalRefNo=${encodeURIComponent(journalRefNo)}`,
                   type: 'POST',
                   contentType: "application/json",
                
                    success: function (response) {
                    if (response.success) {
                        getAllSubmissionJournal();
                        DevExpress.ui.notify("Journal Entry unlocked successfully.", "success", 2000);
                        // Optionally refresh your DataGrid here
                    } else {
                        DevExpress.ui.notify("Failed to unlock Journal Entry: " + response.message, "error", 3000);
                    }
                   },
                     error: function () {
                    DevExpress.ui.notify("An error occurred while unlocking the Journal Entry.", "error", 3000);
                      }
                   });
                    }
                  });
            }
                 function handleCloneJournalEntry() {
                     const dataGrid = $("#dataGrid").dxDataGrid("instance");
                const selectedRow = dataGrid.getSelectedRowsData();
    if (!selectedRow || selectedRow.length === 0) {
        DevExpress.ui.notify("No Journal Entry selected.", "warning", 2000);
        return;
    }

    DevExpress.ui.dialog.confirm(
        "You are about to clone the Journal Entry.</br>Click Yes if you would like to continue.",
        "Confirm Clone"
    ).done(function (dialogResult) {
        if (dialogResult) {
            const journalRefNo = selectedRow[0].JournalRefNo;
            const requesterId = selectedRow[0].RequesterID;

            // Step 1: Get new voucher number
            $.get('/api/JournalEntryEdit/GetNewVoucherNo', function (newVoucherNo) {
                // Step 2: Call clone action
                $.ajax({
                    url: '/api/JournalRegister/CloneJournalEntry',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        fromJournalRefNo: journalRefNo,
                        toJournalRefNo: newVoucherNo,
                        requesterId: requesterId
                    }),
                    success: function (response) {
                        if (response.success) {
                            getAllSubmissionJournal();
                            DevExpress.ui.notify("Journal Entry cloned successfully.", "success", 2000);
                            // Optionally refresh DataGrid
                        } else {
                            DevExpress.ui.notify("Clone failed: " + response.message, "error", 3000);
                        }
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("Error: " + xhr.statusText, "error", 3000);
                    }
                });
            });
        }
    });
}


