@page
<link rel="stylesheet" href="~/css/animationCardFinance.css" />

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }
    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }


    #voucherPopup {
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }


    .voucher-actions {
        list-style-type: none;
        padding: 0;
        margin: 0;
        background-color: #fff;
        border-radius: 5px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .voucher-actions .menu-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 14px;
            color: #333;
            border-bottom: 1px solid #f0f0f0;
        }

            .voucher-actions .menu-item:hover {
                background-color: #f0f0f0;
            }

            .voucher-actions .menu-item:last-child {
                border-bottom: none;
            }


    .dx-icon {
        font-size: 16px;
        margin-right: 10px;
    }


    .dx-checkbox {
        margin: 10px;
    }

    /* Row height */
    .dx-datagrid-rowsview .dx-row {
        height: 25px; /* Reduced row height */
    }

    /* Cell padding */
    .dx-datagrid-rowsview .dx-row .dx-datagrid-cell {
        padding: 2px 5px; /* Further reduced cell padding */
    }

    .dx-datagrid-rowsview .dx-header-row .dx-datagrid-cell {
        padding: 5px 5px; /* Further reduced header cell padding */
    }

    /* Footer row adjustments */
    .dx-datagrid-rowsview .dx-footer-row .dx-datagrid-cell {
        padding: 2px 5px; /* Reduced footer cell padding */
        font-size: 12px; /* Font size for footer */
        line-height: 1.2; /* Tightened line height in footer */
    }

    /* General text content styling */
    .dx-datagrid .dx-datagrid-text-content {
        font-size: 12px; /* Reduced font size */
    }

    .dx-datagrid-rowsview .dx-row .dx-datagrid-cell .dx-datagrid-text-content {
        line-height: 1.2; /* Tightened line height */
    }

    #dataGrid .balance-pill, #dataGrid .credit-pill, #dataGrid .paid-pill {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    #dataGrid .balance-pill {
        background: rgba(255, 77, 79, .15);
        color: #ff4d4f;
    }

    #dataGrid .credit-pill {
        background: rgba(82, 196, 26, .15);
        color: #52c41a;
    }

    #dataGrid .paid-pill {
        background: rgba(255, 193, 7, 0.15); /* Light yellow background */
        color: #ffc107; /* Bootstrap yellow */
    }
</style>


