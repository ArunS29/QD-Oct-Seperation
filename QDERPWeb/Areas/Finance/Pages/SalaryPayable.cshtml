</div>

<div class="">
        @await Html.PartialAsync("SalaryPayableFooter")
</div>
<div class="d-flex align-items-center" style="margin-left: 1em;">

            <div class="me-3">
                @(Html.DevExtreme().DateBox()
                    
                    .ID("EffectiveDate")
                    .InputAttr("aria-label", "Salary Payable Report End Date")
                    .Label(new JS("formatMessage('Salary Payable Report End Date')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(DateTime.Now)
                    .ElementAttr("class", "dynamicFormatDateBox"))
            </div>

            <div style="margin-top:25px;">
                @(Html.DevExtreme().Button()
								.ID("btnShowRecords")
								.Text(new JS("formatMessage('Show Records')"))
								.Type(ButtonType.Normal)
								.StylingMode(ButtonStylingMode.Outlined)
								.Icon("save")
								)
                @*<button id="btnShowRecords ShowRecords"
                        style="width: 200px; height: 50px; color: #333; border: 1px solid #e2c035; border-radius: 5px; cursor: pointer; font-size: 12px; display: flex; align-items: center; padding: 0 10px;">
                    <i class="dx-icon dx-icon-smalliconslayout" style="font-size: 20px; margin-right: 10px;"></i>
                </button>*@
            </div>


        </div>
    <div class="table-responsive ledgerResult">
            @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                .ID("dataGrid")
                .KeyExpr("VoucherNo")
                .RemoteOperations(false)
                .DataSource(ds => ds.Mvc()
                .Controller("SalaryPayable")
                .LoadAction("GetSalarybydate"))
                .Columns(columns =>
                {
                    columns.Add().DataField("EmployeeName").Caption(new JS("formatMessage('EmployeeName')")).GroupIndex(0);
                    columns.Add().DataField("EmployeeNo").Caption(new JS("formatMessage('Employee No')")).Width(120);
                    columns.Add().DataField("EmployeeName").Caption(new JS("formatMessage('Employee Name')")).Width(150);
                    columns.Add().DataField("NationalId").Caption(new JS("formatMessage('National ID')")).Alignment(HorizontalAlignment.Center).Width(120);
                    columns.Add()
                    .DataField("ReferenceNo")
                    .Caption(new JS("formatMessage('Reference No')"))
                    .Alignment(HorizontalAlignment.Center)
                    .Width(120)
                    .CellTemplate(@"
            <a href='/Finance/SalesVoucher?VoucherNo=<%- data.ReferenceNo %>' target='_blank'>
            <%- data.ReferenceNo %>
            </a>
            ");

                    columns.Add().DataField("MonthOf").Caption(new JS("formatMessage('Month Of')")).Alignment(HorizontalAlignment.Center).Width(120);

                    // Payable Amount
                    columns.Add()
                    .DataField("PayableAmount")
                    .Caption(new JS("formatMessage('Trans Payable Amount')"))
                    .Alignment(HorizontalAlignment.Right)
                    .CustomizeText(@"
            function(e) {
            let value = e.value || 0;
            let formattedValue = Math.abs(value).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
            });
            return value < 0 ? '(' + formattedValue + ' )' : formattedValue + '.00';
        }").CellTemplate(@<text>
                              <div class="received-pill">
                                  <span style="color: black; font-weight: bold;"><%- data.TransactionCurrencySymbol %></span>
                                  <%- data.Paid != null ? data.Received.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00" %>
                              </div>
                          </text>) .Visible(false);

            columns.Add()
            .DataField("ConvertedPayableAmount")
            .Caption(new JS("formatMessage('Payable Amount')"))
            .Alignment(HorizontalAlignment.Right)
            .HeaderCellTemplate(@<text>
                                    <div class="credit-header" style="font-weight: bold;">
                                        <%= column.caption %>
                                    </div>
                                </text>)
            .CellTemplate(@<text>
                               <%
                               var val = data.ConvertedPayableAmount;
                               if (val !== null && val !== undefined) {
                               let positive = Math.abs(val);
                               let formatted = positive.toLocaleString(undefined, {
                               minimumFractionDigits: 2,
                               maximumFractionDigits: 2
                               });
                               %>
                               <div class="credit-pill"><%- formatted %></div>
                               <%
                               }
                               %>
                           </text>);

                    // Paid
                    columns.Add()
                    .DataField("Paid")
                    .Caption(new JS("formatMessage('Trans Paid')"))
                    .Width(100)
            .Alignment(HorizontalAlignment.Right).CellTemplate(@<text>
                                                                    <div class="paid-pill">
                                                                                       <span style="color: black; font-weight: bold;"><%- data.TransactionCurrencySymbol %></span>
                                                                                       <%- data.Paid != null ? data.Received.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00" %>
                                                                                   </div>
                                                                </text>).Visible(false);

            columns.Add()
            .DataField("ConvertedPaid")
            .Caption(new JS("formatMessage('Paid')"))
            .Width(100)
            .Alignment(HorizontalAlignment.Right)
            .HeaderCellTemplate(@<text>
                                                                          <div class="paid-header" style="font-weight: bold;">
                                                                              <%= column.caption %>
                                                                          </div>
                                                                      </text>)
            .CellTemplate(@<text>
                               <%
                               var val = data.ConvertedPaid;
                               if (val !== null && val !== undefined) {
                               let positive = Math.abs(val);
                               let formatted = positive.toLocaleString(undefined, {
                               minimumFractionDigits: 2,
                               maximumFractionDigits: 2
                               });
                               %>
                               <div class="paid-pill"><%- formatted %></div>
                               <%
                               }
                               %>
                           </text>);

                    // Balance
                    columns.Add()
                    .DataField("ConvertedBalance")
                    .Caption(new JS("formatMessage('Balance')"))
                    .Alignment(HorizontalAlignment.Right)
        .HeaderCellTemplate(@<text>
                                                   <div class="balance-header" style="font-weight: bold;">
                                                       <%= column.caption %>
                                                   </div>
                                               </text>)
            .CellTemplate(@<text>
                               <%
                               var val = data.ConvertedBalance;
                               if (val !== null && val !== undefined) {
                               let positive = Math.abs(val);
                               let formatted = positive.toLocaleString(undefined, {
                               minimumFractionDigits: 2,
                               maximumFractionDigits: 2
                               });
                               %>
                               <div class="balance-pill"><%- formatted %></div>
                               <%
                               }
                               %>
                           </text>);

            columns.Add()
            .DataField("Balance")
            .Caption(new JS("formatMessage('Trans Balance')"))
            .Alignment(HorizontalAlignment.Right)
            .CustomizeText(@"
        function(e) {
        let value = e.value || 0;
        let formattedValue = Math.abs(value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        return value < 0 ? '(' + formattedValue + ' )' : formattedValue + '.00';
        }").CellTemplate(@<text>
                              <div class="balance-pill">
                                  <span style="color: black; font-weight: bold;"><%- data.TransactionCurrencySymbol %></span>
                                  <%- data.Paid != null ? data.Received.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00" %>
                              </div>
                          </text>).Visible(false);
                })
                .Summary(summary =>
                {
                    summary.TotalItems(items =>
                    {
                        // Payable Amount Summary
                        items.Add()
                    .Column("PayableAmount")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"
            function(e) {
            let total = e.value || 0;
            let formattedValue = Math.abs(total).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
            });
            return total < 0 ? '(' + formattedValue + ' )' : formattedValue + '.00';
            }");

                        // Paid Summary
                        items.Add()
                    .Column("Paid")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("{0}")
                    .Alignment(HorizontalAlignment.Right);

                        // Balance Summary
                        items.Add()
                    .Column("Balance")
                    .SummaryType(SummaryType.Sum)
                    .CustomizeText(@"
            function(e) {
            let total = e.value || 0;
            let formattedValue = Math.abs(total).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
            });
            return total < 0 ? '(' + formattedValue + ' )' : formattedValue + '.00';
            }");
                    });
                })
                .Paging(paging => paging.PageSize(13))
                .Pager(pager => pager
                .ShowPageSizeSelector(false)
                .AllowedPageSizes(new[] { 13, 20, 50 })
                .ShowInfo(false))
                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(fixing => fixing.Enabled(true))
                .HeaderFilter(filter => filter.Visible(false))
                .Height("65vh")
                .ColumnResizingMode(ColumnResizingMode.Widget)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false))
                .GroupPanel(groupPanel => groupPanel.Visible(false))
                .ShowBorders(true)
                .Width("100%")
        .OnOptionChanged("handleGridOptionChanged")
                )
        </div>
        <div id="voucherPopup"></div>
        </div>



    <script>
        $(function () {

										$("#SalaryPayableByDate").dxTextBox({
													text:formatMessage("Salary Payable By Date"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
        
        function showRecords() {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");


            dataGrid.option("dataSource", {
                load: function () {
                    return $.ajax({
                        url: "/api/SalaryPayable/GetSalarybydate",
                        type: "GET"
                    });
                }
            });

            dataGrid.refresh();
        }

        $(function () {

            $("#voucherPopup").dxPopup({
                width: 300,
                height: 400,
                showTitle: true,
                title: "Voucher Options",
                visible: false,
                dragEnabled: true,
                closeOnOutsideClick: true,
                contentTemplate: function () {
                    return $("<div>").append(
                        $("<ul>").addClass("voucher-actions").append(
                            createMenuItem("Edit Voucher", "edit", editVoucher),
                            createMenuItem("View Voucher", "find", viewVoucher),
                            createMenuItem("Verify Voucher", "check", verifyVoucher),
                            createMenuItem("Delete Voucher", "trash", deleteVoucher),
                            createMenuItem("Verify All Selected Vouchers", "selectall", verifyAll),
                            createMenuItem("Approve All Selected Vouchers", "todo", approveAll),
                            createMenuItem("Unlock the Voucher", "unlock", unlockVoucher)
                        )
                    );
                }
            });

            function createMenuItem(text, icon, clickHandler) {
                return $("<li>")
                    .addClass("menu-item")
                    .append(
                        $("<i>").addClass("dx-icon dx-icon-" + icon),
                        $("<span>").text(" " + text)
                    )
                    .on("click", clickHandler);
            }

            function editVoucher() { console.log("Edit Voucher Clicked"); }
            function viewVoucher() { console.log("View Voucher Clicked"); }
            function verifyVoucher() { console.log("Verify Voucher Clicked"); }
            function deleteVoucher() { console.log("Delete Voucher Clicked"); }
            function verifyAll() { console.log("Verify All Selected Vouchers Clicked"); }
            function approveAll() { console.log("Approve All Selected Vouchers Clicked"); }
            function unlockVoucher() { console.log("Unlock Voucher Clicked"); }

            $(document).on("change", ".dx-checkbox", function () {

                if ($(this).prop("checked")) {
                    $("#voucherPopup").dxPopup("instance").show();
                }
            });
        });


        function handleGridOptionChanged(e) {
        if (e.name === "columns" || e.name === "visible") {
            // Columns changed, so re-inject SVG
            injectHeaderSVG(); // slight delay to wait for DOM re-render
        }
    }
    function injectHeaderSVG() {
         
           let gridElement = $('#dataGrid');
    let dataGrid = gridElement.dxDataGrid("instance");
    if (!dataGrid) return;

    // Get grouped data (with .items containing groups)
    let groupedData = dataGrid.getDataSource()?.items();
    if (!groupedData || groupedData.length === 0) return;

    // Get the first row from the first group
    let firstGroup = groupedData[0];
    let firstRowInGroup = firstGroup?.items?.[0];

    let svgIcon = firstRowInGroup?.CurrencyImage;
        if (!svgIcon) return;

        svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);

        gridElement.find(".dx-header-row td").each(function () {

            const $cell = $(this);
            const dataField = $cell.attr("data-field");  // 👈 This is key

                const $creditHeader = $(".credit-header");
                const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                $creditHeader.data("original-text", creditText); // Save original once

                $creditHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${creditText}</span>
                    </div>
                `);

                // 👉 Credit
                const $paidHeader = $(".paid-header");
                const paidText = $paidHeader.data("original-text") || $paidHeader.text().trim();
                $paidHeader.data("original-text", paidText);

                $paidHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${paidText}</span>
                    </div>
                `);


                const $balanceHeader = $(".balance-header");
                const balanceText = $balanceHeader.data("original-text") || $balanceHeader.text().trim();
                $balanceHeader.data("original-text", balanceText);

                $balanceHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${balanceText}</span>
                    </div>
                `);


        });
    }
        
    </script>
