<style>

    .dx-datagrid .text-link {
        color: lightblue;
        cursor: pointer;
        text-decoration: underline;
        position: relative;
    }

        /* Optional: change color or add underline on hover for more emphasis */
        .dx-datagrid .text-link:hover {
            color: darkblue;
            text-decoration: none;
        }

        /* Tooltip style on hover */
        .dx-datagrid .text-link::after {
            content: "Click to view details";
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background-color: #f9f9f9;
            color: #333;
            border: 1px solid #ccc;
            padding: 5px 10px;
            font-size: 12px;
            white-space: nowrap;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
            border-radius: 4px;
        }

        .dx-datagrid .text-link:hover::after {
            display: block;
        }

</style>


