@section Scripts {
    <script>


        $(document).ready(function () {
            loadWelcomeGrid();

            $("#loadGridButton").on("click", function () {
                loadGrid();
            });

             const dataGrid = $("#userDataGrid").dxDataGrid("instance");

        // Toggle Search Panel
        $("#btnToggleSearch").on("click", function () {
            const isVisible = dataGrid.option("searchPanel.visible");
            dataGrid.option("searchPanel.visible", !isVisible);
        });

        // Toggle Filter Row
        $("#btnToggleFilter").on("click", function () {
            const isVisible = dataGrid.option("filterRow.visible");
            dataGrid.option("filterRow.visible", !isVisible);
        });
        });

        function onModuleChanged(e) {
            const selectedModule = e.value;
            const prefixBox = $("#ddPrefixList").dxSelectBox("instance");

            if (!selectedModule) {
                prefixBox.option({
                    items: [],
                    value: null,
                    disabled: true
                });
                return;
            }

            $.ajax({
                url: "/api/Utility/GetDistinctAccessPrefixes",
                method: "GET",
                data: { module: selectedModule },
                success: function (data) {
                    prefixBox.option({
                        items: data.data || data,
                        value: null,
                        disabled: false
                    });
                },
                error: function () {
                    DevExpress.ui.notify("Failed to load prefixes.", "error", 3000);
                    prefixBox.option({
                        items: [],
                        value: null,
                        disabled: true
                    });
                }
            });
        }

        function onUserChanged(e) {
            const selectedUserId = e.value;

            if (!selectedUserId) {
                DevExpress.ui.notify("Please select a user.", "warning", 3000);
                return;
            }
            alert('1');
            loadModulesByUserId(selectedUserId);
            alert('10');
        }
        function loadModulesByUserId(userId) {

            $.ajax({
                url: `/api/Utility/GetDistinctModulesByUserId`,
                method: 'GET',
                data: {
                    userId: userId
                },
                success: function (data) {
                    populateGrid(data.data); // Access the data property
                },
                error: function (xhr, status, error) {
                    DevExpress.ui.notify("Failed to load modules.", "error", 3000);
                }
            });
        }

        function populateGrid(data) {
            $("#gridContainerformodule").dxDataGrid({
                dataSource: data,
                columns: [
                    { dataField: "Module", caption: "Module" }
                ],
                showBorders: true,
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                columnAutoWidth: true
            });
        }



        function loadGrid() {
            const userId = $("#ddUserList").dxSelectBox("instance").option("value");
            const module = $("#ddModuleList").dxSelectBox("instance").option("value");
            const prefix = $("#ddPrefixList").dxSelectBox("instance").option("value");

            if (!userId || !module) {
                DevExpress.ui.notify("Please select User, Module, and Prefix.", "warning", 3000);
                return;
            }




            $("#gridContainer").dxDataGrid({
                dataSource: DevExpress.data.AspNet.createStore({
                    key: "SlNo",
                    loadUrl: "/api/Utility/GetUserAccessDetails",
                    loadParams: {
                        userId: userId,
                        module: module,
                        prefix: prefix
                    },
                    updateUrl: "/api/Utility/UpdateItemVisibility"
                }),
                remoteOperations: true,
                columns: [
                    { dataField: "Prefix", caption: "Form Name" },
                    { dataField: "SlNo", caption: "Serial No" },
                    { dataField: "ItemName", caption: "Item Name" },
                    { dataField: "ActionName", caption: "Action Name" },
                    { dataField: "ItemEnabled", caption: "Enable" },
                    {
                        dataField: "ItemVisible",
                        caption: "Visible",
                        dataType: "boolean",
                        cellTemplate: function (container, options) {
                            $("<div>")
                                .dxCheckBox({
                                    value: options.value,
                                    onValueChanged: function (e) {
                                        const items = [{
                                            slNo: options.data.SlNo,
                                            ItemVisible: e.value
                                        }];
                                        updateItemVisibility(items);
                                    }
                                })
                                .appendTo(container);
                        }
                    }
                ],
                sorting: {
                    mode: "multiple"
                },
                selection: {
                    mode: "multiple"
                }
            });
        }
        function loadWelcomeGrid(userName = "aarankumar832@gmail.com") {
            $("#userInfoGrid").dxDataGrid({
                dataSource: DevExpress.data.AspNet.createStore({
                    key: "UserName",
                    loadUrl: "/api/Utility/GetUserIDdetails",
                    loadParams: { userName: userName }
                }),
                remoteOperations: true,
                columns: [
                    { dataField: "UserId", caption: "User ID" },
                    { dataField: "UserName", caption: "User Name" },
                    { dataField: "EmailAddress", caption: "Email" },
                    { dataField: "MobileNo", caption: "Mobile No" },
                    {
                        dataField: "LastLogOnTime",
                        caption: "Last Log On",
                        dataType: "datetime",
                        format: "yyyy-MM-dd HH:mm"
                    },
                    {
                        dataField: "LastLogOffTime",
                        caption: "Last Log Off",
                        dataType: "datetime",
                        format: "yyyy-MM-dd HH:mm"
                    }
                ],
                showBorders: true,
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                columnAutoWidth: true
            });
        }


        function updateItemVisibility(items) {
            $.ajax({
                url: "/api/Utility/UpdateItemVisible",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(items),
                success: function (data) {
                    if (data.success) {
                        DevExpress.ui.notify(data.message, "success", 3000);
                    } else {
                        DevExpress.ui.notify(data.message, "error", 3000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Failed to update item visibility.", "error", 3000);
                }
            });
        }

                        function onUserIdCellClick(e) {

                            debugger;

            // Ensure the click is on the UserId column
            if (e.column && e.column.dataField === "UserId") {
                 debugger;

                const userId = e.data.UserId;
                const userLevel = e.data.UserLevel;

                // Check if the user's level is 99
                if (userLevel !== 99) {
                    DevExpress.ui.notify("You do not have permission to view this user's details.", "warning", 2000);
                    return;
                }

                // Get tenant name from session storage
                const tenantName = sessionStorage.getItem('tenantName');

                if (!tenantName) {
                    DevExpress.ui.notify("Tenant name not found in session storage.", "error", 2000);
                    return;
                }

                const encodedTenant = encodeURIComponent(tenantName);
                const url = `/${encodedTenant}/Finance/UserAccountDetails?userId=${encodeURIComponent(userId)}`;

                // Redirect to the UserAccountDetails page
                window.location.href = url;
            }
        }

