@page
@model QD.ERP.Web.Areas.Finance.Pages.frm201useraccesModel
@using DevExtreme.AspNet.Data
@using DevExtreme.AspNet.Mvc

<div class="title">
    <div class="header-container">
        <h2>Access Management</h2>
    </div>
</div>

<!-- DevExtreme Tab Panel -->
<div id="tabPanelContainer">
    @(Html.DevExtreme().TabPanel()
            .ID("accessTabPanel")
            // .OnSelectionChanged("onTabSelectionChanged")
            .Items(items =>
            {
                items.Add()
            .Title("Welcome")
            .Template(@<text>
        <div id="userInfoGrid"></div>
    </text>);
                items.Add()
            .Title("Module")
            .Template(@<text>
        <div style="padding: 20px;">
            <h3>Welcome to Module Access Management</h3>
            <p>Select the 'Module Access' tab to manage user permissions for different modules and forms.</p>
            @(Html.DevExtreme().SelectBox()
            .ID("ddUserList1")
            .DataSource(ds => ds.WebApi()
            .Controller("Utility")
            .LoadAction("Getuserdetails")
            .LoadMode(DataSourceLoadMode.Raw))
            .DisplayExpr("UserName")
            .ValueExpr("UserId")
            .SearchEnabled(true)
            .ShowClearButton(true)
            .Placeholder("Select User")
            .Label("User")
            .LabelMode(EditorLabelMode.Outside)
            .Width(400)
            .OnValueChanged("onUserChanged")
            )
            <div id="gridContainerformodule" style="margin-top: 20px; width: 500px;"></div>
            @(Html.DevExtreme().SelectBox()
            .ID("ddModuleList1")
            .DataSource(ds => ds.WebApi()
            .Controller("Utility")
            .LoadAction("GetDistinctModules")
            .LoadMode(DataSourceLoadMode.Raw))
            .DisplayExpr("Module")
            .ValueExpr("Module")
            .SearchEnabled(true)
            .ShowClearButton(true)
            .Placeholder("Select Module")
            .Label("Module")
            .LabelMode(EditorLabelMode.Outside)

            .Width(400)
            )
        </div>
    </text>);

                items.Add()
            .Title("User Access")
            .Template(@<text>
        <div style="padding: 20px;">
            <div class="form-group">
                @(Html.DevExtreme().SelectBox()
                .ID("ddUserList")
                .DataSource(ds => ds.WebApi()
                .Controller("Utility")
                .LoadAction("Getuserdetails")
                .LoadMode(DataSourceLoadMode.Raw))
                .DisplayExpr("UserName")
                .ValueExpr("UserId")
                .SearchEnabled(true)
                .ShowClearButton(true)
                .Placeholder("Select User")
                .Label("User")
                .LabelMode(EditorLabelMode.Outside)
                .Width(400)
                )

                @(Html.DevExtreme().SelectBox()
                .ID("ddModuleList")
                .DataSource(ds => ds.WebApi()
                .Controller("Utility")
                .LoadAction("GetDistinctModules")
                .LoadMode(DataSourceLoadMode.Raw))
                .DisplayExpr("Module")
                .ValueExpr("Module")
                .SearchEnabled(true)
                .ShowClearButton(true)
                .Placeholder("Select Module")
                .Label("Module")
                .LabelMode(EditorLabelMode.Outside)
                .OnValueChanged("onModuleChanged")
                .Width(400)
                )

                @(Html.DevExtreme().SelectBox()
                .ID("ddPrefixList")
                .Items(Enumerable.Empty<string>())
                .DisplayExpr("Prefix")
                .ValueExpr("Prefix")
                .SearchEnabled(true)
                .ShowClearButton(true)
                .Placeholder("Select Prefix")
                .Label("Form")
                .LabelMode(EditorLabelMode.Outside)
                .Disabled(true)
                .Width(400)
                .OnValueChanged("loadGrid")
                )
            </div>

            <div id="gridContainer" style="margin-top: 20px;"></div>
        </div>
    </text>);
            })
        .Width("100%")
        )
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadWelcomeGrid();

            $("#loadGridButton").on("click", function () {
                loadGrid();
            });
        });

        function onModuleChanged(e) {
            const selectedModule = e.value;
            const prefixBox = $("#ddPrefixList").dxSelectBox("instance");

            if (!selectedModule) {
                prefixBox.option({
                    items: [],
                    value: null,
                    disabled: true
                });
                return;
            }

            $.ajax({
                url: "/api/Utility/GetDistinctAccessPrefixes",
                method: "GET",
                data: { module: selectedModule },
                success: function (data) {
                    prefixBox.option({
                        items: data.data || data,
                        value: null,
                        disabled: false
                    });
                },
                error: function () {
                    DevExpress.ui.notify("Failed to load prefixes.", "error", 3000);
                    prefixBox.option({
                        items: [],
                        value: null,
                        disabled: true
                    });
                }
            });
        }

        function onUserChanged(e) {
            const selectedUserId = e.value;

            if (!selectedUserId) {
                DevExpress.ui.notify("Please select a user.", "warning", 3000);
                return;
            }
            alert('1');
            loadModulesByUserId(selectedUserId);
            alert('10');
        }
        function loadModulesByUserId(userId) {

            $.ajax({
                url: `/api/Utility/GetDistinctModulesByUserId`,
                method: 'GET',
                data: {
                    userId: userId
                },
                success: function (data) {
                    populateGrid(data.data); // Access the data property
                },
                error: function (xhr, status, error) {
                    DevExpress.ui.notify("Failed to load modules.", "error", 3000);
                }
            });
        }

        function populateGrid(data) {
            $("#gridContainerformodule").dxDataGrid({
                dataSource: data,
                columns: [
                    { dataField: "Module", caption: "Module" }
                ],
                showBorders: true,
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                columnAutoWidth: true
            });
        }



        function loadGrid() {
            const userId = $("#ddUserList").dxSelectBox("instance").option("value");
            const module = $("#ddModuleList").dxSelectBox("instance").option("value");
            const prefix = $("#ddPrefixList").dxSelectBox("instance").option("value");

            if (!userId || !module) {
                DevExpress.ui.notify("Please select User, Module, and Prefix.", "warning", 3000);
                return;
            }




            $("#gridContainer").dxDataGrid({
                dataSource: DevExpress.data.AspNet.createStore({
                    key: "SlNo",
                    loadUrl: "/api/Utility/GetUserAccessDetails",
                    loadParams: {
                        userId: userId,
                        module: module,
                        prefix: prefix
                    },
                    updateUrl: "/api/Utility/UpdateItemVisibility"
                }),
                remoteOperations: true,
                columns: [
                    { dataField: "Prefix", caption: "Form Name" },
                    { dataField: "SlNo", caption: "Serial No" },
                    { dataField: "ItemName", caption: "Item Name" },
                    { dataField: "ActionName", caption: "Action Name" },
                    { dataField: "ItemEnabled", caption: "Enable" },
                    {
                        dataField: "ItemVisible",
                        caption: "Visible",
                        dataType: "boolean",
                        cellTemplate: function (container, options) {
                            $("<div>")
                                .dxCheckBox({
                                    value: options.value,
                                    onValueChanged: function (e) {
                                        const items = [{
                                            slNo: options.data.SlNo,
                                            ItemVisible: e.value
                                        }];
                                        updateItemVisibility(items);
                                    }
                                })
                                .appendTo(container);
                        }
                    }
                ],
                sorting: {
                    mode: "multiple"
                },
                selection: {
                    mode: "multiple"
                }
            });
        }
        function loadWelcomeGrid(userName = "aarankumar832@gmail.com") {
            $("#userInfoGrid").dxDataGrid({
                dataSource: DevExpress.data.AspNet.createStore({
                    key: "UserName",
                    loadUrl: "/api/Utility/GetUserIDdetails",
                    loadParams: { userName: userName }
                }),
                remoteOperations: true,
                columns: [
                    { dataField: "UserId", caption: "User ID" },
                    { dataField: "UserName", caption: "User Name" },
                    { dataField: "EmailAddress", caption: "Email" },
                    { dataField: "MobileNo", caption: "Mobile No" },
                    {
                        dataField: "LastLogOnTime",
                        caption: "Last Log On",
                        dataType: "datetime",
                        format: "yyyy-MM-dd HH:mm"
                    },
                    {
                        dataField: "LastLogOffTime",
                        caption: "Last Log Off",
                        dataType: "datetime",
                        format: "yyyy-MM-dd HH:mm"
                    }
                ],
                showBorders: true,
                paging: {
                    pageSize: 10
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 20, 50],
                    showInfo: true
                },
                columnAutoWidth: true
            });
        }


        function updateItemVisibility(items) {
            $.ajax({
                url: "/api/Utility/UpdateItemVisible",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(items),
                success: function (data) {
                    if (data.success) {
                        DevExpress.ui.notify(data.message, "success", 3000);
                    } else {
                        DevExpress.ui.notify(data.message, "error", 3000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Failed to update item visibility.", "error", 3000);
                }
            });
        }
    </script>
}
