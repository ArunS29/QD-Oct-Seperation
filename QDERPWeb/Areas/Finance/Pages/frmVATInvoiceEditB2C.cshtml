}

<style>
    .body {
        padding-top: 0px;
    }

    .content {
        margin: 0px;
    }

    .content-container-top {
        width: 1700px;
    }
    /* Custom CSS to adjust the height of tab headers */
    .dx-tabpanel .dx-tab {
        padding: 10px 15px; /* Adjust padding to change height */
        font-size: 16px; /* Adjust font size to change header height */
    }

    /* Ensuring the content area also adjusts in height */
    .dx-tabpanel .dx-tab-content {
        padding: 20px;
        min-height: 200px; /* Minimum height for the tab content */
    }

    .dx-fieldset {
        margin: 3px 3px !important;
        padding: 0px;
    }

    .dx-datagrid-headers th {
        text-align: center; /* Centers the text */
    }

    .columnheader {
        text-align: center;
    }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

        .tab-content h3 {
            color: #333;
        }

        .tab-content p {
            line-height: 1.6;
            color: #555;
        }

    .dx-dropdownbox .dx-dropdownbox-wrapper .dx-dropdownbox-header {
        display: none;
    }

    .button-group {
        margin-left: 1px !important;
    }

    .button-alignment-up {
        margin-top: 25px !important;
    }

    .button-alignment-down {
        margin-top: 0px !important;
    }

    /*     .dx-editor-outlined .dx-label span {
        font-weight:bold !important;
        } */

    .custom-textbox input {
        font-weight: bold !important;
        color: black !important; /* Use !important to override DevExtreme styles */
        /*   border: 3px solid #282222;
        border-radius: 8px !important; */
    }

    .custom-textbox1 input {
        border: 3px solid #282222;
        /* border-radius: 8px !important; */
    }

    .custom-textbox1 .dx-dropdowneditor-icon {
        border: 3px solid #282222 !important;
        /*  border-radius: 8px !important; */
    }


    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

        .close:hover,
        .close:focus {
            color: black;
        }

    .containerLedgerAccount {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .titleLedgerAccount {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5em;
    }

    .no-border-input {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        font-weight: bold;
        font-size: 16px;
        color: black;
        pointer-events: none; /* Prevents hover and click effects */
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

        .card-container {
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }

    .card {
        flex: 1;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        background: #fff;
    }
    .limited-footer .btn-container:not(:has(#btnSave,#btnSaveAndClose,#btnPreview1,#btnPrint1,#btnDelete,#btnBack,#btnVerify,#btnApprove,#btnAttach)) {
    display: none !important;
}

</style>
