@page
@using QD.ERP.Web.DAL.Entities
@{
    ViewData["Title"] = "Accounting Ledger Groups//";

}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<style type="text/css">
    .cards-container-title {
        text-align: left;
        font-size: 2rem;
        margin-bottom: 0px;
        color: black;
        background-color: #f5f5f5;
        padding: 5px;
    }

    .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        background-color: #f5f5f5;
        width: 100%;
        padding: 15px;
        box-sizing: border-box;
    }

    /* Override Bootstrap padding/margin if necessary */
    .container {
        max-width: 65%;
        padding: 20px;
        margin: 0 auto;
        background-color: #B4E1F5;
    }
</style>

<h2 class="cards-container-title">Ledger Documents</h2>

<div class="container my-3" style="max-width:2000px;">
    <div class="row g-3">
        <!-- Card -->
        <div class="col-12">
            <div class="card p-3 shadow-sm bg-light">

                <!-- First Row -->
                <h3>Enter a New Document & Add to the Existing List:</h3>
                <div class="row mb-3">
                    <div class="col-12 col-md-4">
                        <label>Document No:</label>
                        @(Html.DevExtreme().TextBox()
                            .ID("DocumentNo")
                            .Value(null)
                            .Width("100%")
                            .Disabled(true)

                            )
                    </div>
                    <div class="col-12 col-md-6">
                        <label>Type of the Document Attached:</label>
                        @(Html.DevExtreme().DropDownBox()
                            .DataSource(d => d.WebApi()
                            .Controller("LedgerAccountMaster")
                            .LoadAction("GetDocumentType")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("DocumentTypeId"))
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired().Message("Type of the Document Attached is required");

                            })
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("accountMasterDropDownBox")
                            .ShowClearButton(true)
                            .AcceptCustomValue(true)
                            .Width("100%")
                            .AcceptCustomValue(true)
                            .OpenOnFieldClick(false)
                            .ValueChangeEvent("input")
                            .HoverStateEnabled(true)
                            .ValueExpr("DocumentTypeId")
                            .DisplayExpr("DocumentType")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("onOpened")
                            .OnKeyDown("onKeyDown")
                            //.OnValueChanged("dropDownBoxValueChanged")
                            .ContentTemplate(new TemplateName("DocumentAttachedContentTemplate"))
                            )

                    </div>
                    <div class="col-6 col-md-1 mt-4">
                        @(Html.DevExtreme().Button()
                            .ID("btnAddAHead")
                            .Icon("plus")
                            .Width("100%")
                            )
                    </div>
                    <div class="col-6 col-md-1 mt-4">
                        @(Html.DevExtreme().Button()
                            .ID("btnEditAHead")
                            .Icon("edit")
                            .Width("100%")
                            )
                    </div>
                </div>

                <!-- Second Row -->
                <div class="row mb-3">
                    <div class="col-12 col-md-4">
                        <label>Reference No:</label>
                        @(Html.DevExtreme().TextBox()
                            .ID("ReferenceNo")
                            .Value(null)
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired().Message("Reference No is required");

                            })
                            .Width("100%")
                            .Disabled(true)
                            )
                    </div>
                    <div class="col-12 col-md-6">
                        <label>Remarks/Notes:</label>
                        @(Html.DevExtreme().TextBox()
                            .ID("Remarks")
                            .Value(null)
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired().Message("Remarks is required");

                            })
                            .Width("100%"))
                    </div>
                    <div class="col-12 col-md-2 mt-4">
                        @(Html.DevExtreme().Button()
                            .ID("btnAttachment")
                            .Icon("fa fa-paperclip")
                            .Width("100%")
                            .OnClick("onAttachClicked"))
                    </div>
                    <input type="file" id="fileInput" style="display: none;" />
                </div>

                <!-- Third Row -->
                <div class="row mb-3">
                    @* <div class="col-12 col-md-4">
                    <label>Document Expiry Date:</label>
                    @(Html.DevExtreme().DropDownBox()
                    .DataSource(d => d.WebApi()
                    .Controller("LedgerAccountMaster")
                    .LoadAction("GetAccountMaster")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("DocumentExpiry"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("accountMasterDropDownBoxExpiry")
                    .ShowClearButton(true)
                    .Width("100%"))
                    </div> *@
                    <div class="col-12 col-md-4">
                        <label>Document Expiry Date:</label>
                        @(Html.DevExtreme().DateBox()

                            .LabelMode(EditorLabelMode.Outside)
                            .Type(DateBoxType.Date)
                            .DisplayFormat("dd-MMM-yyyy")
                            .Value("") //Specifies the type as a date picker
                            .ID("accountMasterDropDownBoxExpiry")
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired().Message("Document Expiry Date is required");

                            })
                            .ShowClearButton(true)
                            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                            .Width("100%"))
                    </div>


                    <div class="col-10 col-md-3">
                        <label>Expiry Date (Hijri):</label>
                        @(Html.DevExtreme().TextBox()
                            .ID("ExpiryDate")
                            .Value(null)
                            .Width("100%"))
                    </div>
                    <div class="col-10 col-md-3">
                        <label>Notification Date:</label>
                        @(Html.DevExtreme().DateBox()

                            .LabelMode(EditorLabelMode.Outside)
                            .Type(DateBoxType.Date)
                            .DisplayFormat("dd-MMM-yyyy")
                            .Value("") //Specifies the type as a date picker
                            .ID("accountMasterDropDownBoxNotification")
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired().Message("Notification Date is required");

                            })
                            .ShowClearButton(true)
                            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                            .Width("100%"))
                    </div>
                    <div class="col-6 col-md-2">
                        @(Html.DevExtreme().Button()
                            .ID("btnVoucherEntry")
                            .Text("ADD")
                            .Height(50)
                            .Width("100%")
                            .Icon("plus")
                            .OnClick("function() { addVoucherEntry(); }"))
                    </div>
                </div>

                <!-- Third Row - Button -->
                @*   <div class="row">

                </div> *@
            </div>
        </div>
        <div class="col-12">
            <div class="dx-field ledgerResult">
                @(
                    Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl20116LedgerDocument>()
                    .ID("dataGrid")
                    .RemoteOperations(false)
                    .Columns(columns =>
                    {
                        columns.AddFor(m => m.DocumentNo).Caption("DocumentNo");
                        columns.AddFor(m => m.DocumentType).Caption("DocumetType");
                        columns.AddFor(m => m.DocumentRefNo).Caption("Document Ref No");

                        columns.AddFor(m => m.DocumentRemarks).Caption("Document Remarks");
                        columns.AddFor(m => m.DocumentExpDate).Caption("Expiry On");
                        columns.AddFor(m => m.DocumentExpDateAr).Caption("Expiry Arabic");
                        columns.AddFor(m => m.NotifiedOn).Caption("Notify On");
                    }
                    )
                    .AllowColumnReordering(true)
                    .AllowColumnResizing(true)
                    .ColumnFixing(fixing => fixing.Enabled(true))
                    .HeaderFilter(filter => filter.Visible(true))
                    .Height(250)
                    .ColumnAutoWidth(true)
                    .FilterRow(filterRow => filterRow.Visible(false))
                    .GroupPanel(groupPanel => groupPanel.Visible(false))
                    .ShowBorders(true)
                    .Width("100%")
                    )
            </div>
        </div>

        <div class="dx-fieldset horizontal-container mt-2">

            @(Html.DevExtreme().Button()
                .ID("btnUpdate")
                .Text("Update")
                .Icon("save")
                .OnClick("function() { UpdateVoucherEntry(); }")
                )
            @(Html.DevExtreme().Button()
                .ID("btnAllAttachments")
                .Text("Show All Documents")
                .Icon("save")
                )

            @(Html.DevExtreme().Button()
                .ID("btnBack")
                .Text("Back")
                .Icon("arrowleft")
                )

        </div>
        @using (Html.DevExtreme().NamedTemplate("DocumentAttachedContentTemplate"))
        {
            @(Html.DevExtreme().DataGrid()

                .ID("accountpaymentamount-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("LedgerAccountMaster")
                .LoadAction("GetDocumentType")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("DocumentTypeId")
                )
                .WordWrapEnabled(true)
                .ShowBorders(true)
                .SearchPanel(sp => sp.HighlightSearchText(true))
                .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                .OnSelectionChanged("dataGridSelectionChanged")
                .OnInitialized("dataGridInitialized")
                .HeaderFilter(p => p.Visible(true))
                .ShowBorders(true)
                .HoverStateEnabled(true)
                .Paging(p => p.PageSize(15))
                .FilterRow(f => f.Visible(true))
                .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                .Height(345)
                .Selection(s => s.Mode(SelectionMode.Single))
                .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                .Columns(columns =>
                {
                    columns.Add().DataField("DocumentTypeId");
                    columns.Add().DataField("DocumentType");

                })
                )
        }

    </div>
</div>


