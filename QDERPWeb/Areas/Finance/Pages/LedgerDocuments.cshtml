    async function translateToArabic(text) {
        // try {
        //     const response = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|ar`);
        //     const data = await response.json();
        //     return data.responseData.translatedText;
        // } catch (error) {
        //     console.error("Translation failed:", error);
        //     return "Translation Error";
        // }
        const apiUrl = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|ar&mt=1`;

        try {
            const response = await fetch(apiUrl);
            const data = await response.json();

            if (data && data.responseData) {
                return data.responseData.translatedText || "No translation found";
            } else if (data.matches && data.matches.length > 0) {
                // Fallback: Check for alternative matches if responseData is empty
                return data.matches[0].translation || "No match found";
            } else {
                return "Translation Error";
            }
        } catch (error) {
            console.error("Translation failed:", error);
            return "Translation Error";
        }
    }


    document.getElementById("convertToArabic").addEventListener("click", async () => {
        const englishText = document.getElementById("AccountGroup").value;

        // if (englishText.trim() === "") {
        //     alert("Please enter text to translate.");
        //     return;
        // }

        // Await the result of the asynchronous translation function
        const arabicTranslation = await translateToArabic(englishText);

        // Update the Arabic text field with the resolved value
        const accountGroup1Instance = $("#AccountGroup1").dxTextBox("instance");
        accountGroup1Instance.option("value", arabicTranslation);
    });

