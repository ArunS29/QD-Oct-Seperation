        if (moduleType) {

            const trimmedmoduleType = moduleType.trim();
            $("#hiddenModuleType").val(trimmedmoduleType);

        } else {
            console.warn("moduleType is missing. API call not made.");
        }
        

    });

     document.addEventListener("DOMContentLoaded", setupDragDrop);

