       // Handle the button click to trigger the file input
        function onAttachClicked(e) {

            document.getElementById("fileInput").click();
          //  var docno = $("#DocumentNo").dxTextBox("instance").option("value");
             // // Handle file selection and upload the file
        document.getElementById("fileInput").addEventListener("change", function (event) {
            const files = event.target.files; // Get the selected files

            if (files.length > 0) {
                const selectedFile = files[0]; // Get the first selected file

                // Display the file name (optional)
               // alert(`File selected: ${selectedFile.name}`);

                // Create a FormData object to prepare the file for upload
                const formData = new FormData();
                formData.append("file", selectedFile);

                // Use AJAX to upload the file to the server
                $.ajax({
                    url: "/api/LedgerAccountMaster/UploadFile", // Change to your API endpoint
                    type: "POST",
                    data: formData,
                    processData: false, // Important for FormData
                    contentType: false, // Important for FormData
                    success: function (response) {
                        // Handle successful response
                        DevExpress.ui.notify("File uploaded successfully!", "success", 2000);
                    },
                    error: function (xhr, status, error) {
                        // Handle error
                        alert(`Error uploading file: ${xhr.responseText || error}`);
                    }
                });
            }
        });
        }

    function onDocumentNoClick(e) {
            if (e.column && e.column.dataField === "DocumentNo") {
                // Get the DocumentNo value
                var documentNo = e.data.DocumentNo;

                // Send the DocumentNo to the server
                $.ajax({
                    type: "POST",
                    url: "/api/LedgerAccountMaster/OpenFileExplorer", // Adjust the URL to match your controller/action
                    data: { documentNo: documentNo },
                    success: function (response) {
                        if (response.success) {
                            alert("File explorer opened successfully.");
                        } else {
                            alert("Failed to open file explorer: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("An error occurred: " + error);
                    }
                });
            }
        }



