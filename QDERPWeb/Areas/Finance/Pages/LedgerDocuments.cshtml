    $(document).ready(function () {
        // Retrieve VoucherNo from query parameters
        const urlParams = new URLSearchParams(window.location.search);
        const voucherNo = urlParams.get('VoucherNo');
        // alert(voucherNo);

        if (voucherNo) {
            // Wait for DevExtreme TextBox to initialize
            const interval = setInterval(() => {
                const voucherRefernceNoInstance = $("#ReferenceNo").dxTextBox("instance");

                if (voucherRefernceNoInstance) {
                    // Set the value and stop the interval
                    voucherRefernceNoInstance.option("value", voucherNo);

                    clearInterval(interval);
                }
            }, 100); // Retry every 100ms
        }
    });


    $(function () {
        $.ajax({
            url: "/api/LedgerAccountMaster/GetDocumentNo",
            type: 'GET',
            success: function (data) {
                // Set the value in the VoucherNo TextBox
                $("#DocumentNo").dxTextBox("instance").option("value", data);

            },
            error: function (xhr, status, error) {
                console.error("Error loading Voucher No:", error);
            }
        });
    });

