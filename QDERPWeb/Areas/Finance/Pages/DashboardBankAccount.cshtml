    $(document).ready(function () {
        const apiEndpoints = [
            { url: "/api/Dashboard/supplieroutstanding", target: "#totalBillsOutstandingValue ", key: "balance" },
            { url: "/api/Dashboard/GetTotalClientOutstanding", target: "#totalClientOutstandingValue", key: "balance" },
            { url: "/api/Dashboard/GetCashBalance", target: "#cashBalanceValue", key: "balance" }
        ];

        const fetchData = async (endpoint) => {
            const startTime = performance.now();
            try {
                const response = await $.getJSON(endpoint.url);
                if (response.success) {
                    $(endpoint.target).text(response[endpoint.key].toLocaleString('en-US'));
                } else {
                    console.error(`Error loading data from ${endpoint.url}`);
                }
            } catch (error) {
                console.error(`Error fetching data from ${endpoint.url}:`, error);
            } finally {
                const endTime = performance.now();
                console.log(`Response time for ${endpoint.url}: ${(endTime - startTime).toFixed(2)} ms`);
            }
        };

        apiEndpoints.forEach(fetchData);
    });

    $(document).ready(function () {

         $(document).ready(function () {
            $.ajax({
            url: '/api/Dashboard/GetAccountSummaryBank',
            type: 'GET',
            dataType: 'json',
            success: function (result) {
                if (result && result.data) {
                    // Add canvas dynamically
                    $('#bankAccountsChart').html('<canvas id="bankSummaryChartCanvas"></canvas>');

                    // Wait for DOM to update
                    setTimeout(() => {
                        const canvas = document.getElementById('bankSummaryChartCanvas');

                        // Set canvas dimensions to match the container
                        canvas.width = canvas.offsetWidth;
                        canvas.height = canvas.offsetHeight;

                        const ctx = canvas.getContext('2d');

                        const labels = result.data.map(item => item.AccountHeadName);
                        const dataValues = result.data.map(item => item.TotalBalance);

                        new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: formatMessage('Total Balance'),
                                    data: dataValues,
                                    backgroundColor: '#007acc',
                                    borderColor: '#007acc',
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true, // use manual sizing
                                plugins: {
                                    title: {
                                        display: true,
                                        text: 'Bank / Cash Account Summary'
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: true,
                                            text: 'Balance'
                                        }
                                    },
                                    x: {
                                        title: {
                                            display: true,
                                            text: 'Account Head Name'
                                        }
                                    }
                                }
                            }
                        });
                    }, 0); // wait for canvas to be in DOM
                } else {
                    $('#bankAccountsChart').html('<p>No data available to display.</p>');
                }
            },
            error: function (xhr, status, error) {
                console.error('Error loading data:', error);
                $('#bankAccountsChart').html('<p>Error loading chart.</p>');
            }
        });
      });
          $.ajax({
    url: "/api/Dashboard/GetOutstandingChartData",
    type: "GET",
    dataType: "json",
    success: function (response) {
        if (response.success) {
            const data = response.data;

            const clientData = data.filter(item => item.Type === "Client");
            const supplierData = data.filter(item => item.Type === "Supplier");

            const labels = [...new Set(data.map(item => item.AccountHead))];

            const clientBalances = labels.map(label => {
                const item = clientData.find(d => d.AccountHead === label);
                return item ? item.Balance : 0;
            });

            const supplierBalances = labels.map(label => {
                const item = supplierData.find(d => d.AccountHead === label);
                return item ? item.Balance : 0;
            });

            new Chart("outstandingChart", {
                type: "bar", // Correct chart type to "bar"
                data: {
                    labels: labels, // Set labels directly for x-axis
                    datasets: [
                        {
                            label: formatMessage("Client Outstanding"),
                            backgroundColor: "rgba(0, 123, 255, 0.5)",
                            borderColor: "rgba(0, 123, 255, 1)",
                            data: clientBalances, // Use the prepared balances directly
                        },
                        {
                            label: formatMessage("Supplier Outstanding"),
                            backgroundColor: "rgba(255, 99, 132, 0.5)",
                            borderColor: "rgba(255, 99, 132, 1)",
                            data: supplierBalances, // Use the prepared balances directly
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        x: {
                            title: { display: true, text: formatMessage("Accounts") },
                            // Optionally, you can set the "category" scale if needed
                        },
                        y: {
                            title: { display: true, text: formatMessage("Outstanding Amount") }
                        }
                    }
                }
            });
        } else {
            console.error("Error fetching data");
        }
    },
    error: function (error) {
        console.error("Error fetching data: ", error);
    }
});

