                                        }
                                    ]
                                }
                            });
                        } else {
                            console.error("No data found in the response.");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching data:", error);
                    }
                });
            });
        $.getJSON("/api/Dashboard/GetCashBalance", function (response) {
