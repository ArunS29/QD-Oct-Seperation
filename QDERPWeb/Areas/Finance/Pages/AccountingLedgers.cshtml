	<!-- Result Grid -->



	<div class="dx-field ledgerResult">
		<!-- Toolbar for Column Chooser and Filter -->
		<div class="custom-toolbar">
			<div id="columnChooser"></div>
		</div>

		@(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.StProAccountLedgerResult>()
					.ID("dataGrid")
					.RemoteOperations(false)
					.DataSource(new JS("[]"))
					.Columns(columns =>
					{
						columns.AddFor(m => m.VoucherNo).Caption(new JS("formatMessage('Voucher No')")).Alignment(HorizontalAlignment.Center)
					.CellTemplate(@<text>
			<div>
				<a href="javascript:void(0);" style="color: #007bff; font-weight: bold;"
				   onclick="navigateToVoucherPage('<%- data.VoucherNo %>')">
					<%- data.VoucherNo %>
				</a>
			</div>
		</text>)
					.Visible(true);

						columns.AddFor(m => m.VoucherDate).Caption(new JS("formatMessage('VoucherDate')"))
					.Alignment(HorizontalAlignment.Center)
					.Format(format => format.Type(Format.ShortDate)
					.Formatter("function(value) { return DevExpress.localization.formatDate(new Date(value), 'dd-MMM-yyyy'); }"))
					.Visible(true);

						columns.AddFor(m => m.VoucherEffectiveDate).Caption(new JS("formatMessage('Effective On')"))
					.Alignment(HorizontalAlignment.Center)
					.Format(format => format.Type(Format.ShortDate)
					.Formatter("function(value) { return DevExpress.localization.formatDate(new Date(value), 'MMM-yyyy'); }"))
					.Visible(true);

						columns.AddFor(m => m.AccountHeadName).Caption(new JS("formatMessage('Account Ledger')"))
					.Alignment(HorizontalAlignment.Left)
					.Visible(true);

						columns.AddFor(m => m.DrAmount).Caption(new JS("formatMessage('Debit')")).Alignment(HorizontalAlignment.Right)
					.CellTemplate(@<text>
			<div style="color: red; font-weight: bold;">
				<%- data.DrAmount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
			</div>
		</text>)
					.Visible(true);

						columns.AddFor(m => m.CrAmount).Caption(new JS("formatMessage('Credit')")).Alignment(HorizontalAlignment.Right)
					.CellTemplate(@<text>
			<div style="color: green; font-weight: bold;">
				<%- data.CrAmount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
			</div>
		</text>)
				.Visible(true);

						columns.AddFor(m => m.VoucherAmountFormatted).Caption(new JS("formatMessage('VoucherAmountFormatted')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.Add()
			.Caption(new JS("formatMessage('Balance')"))
			.Alignment(HorizontalAlignment.Right)
			.DataType(GridColumnDataType.Number)
              .CalculateCellValue("function(rowData) { "+
                "let balance = 0;"+
                 "let gridInstance = $('#dataGrid').dxDataGrid('instance');"+
                  "if (!gridInstance) return '0.00 Dr'; "+
                  "let dataSource = gridInstance.option('dataSource');"+ 
                  "if (!dataSource) return '0.00 Dr';"+

                  "for (let i = 0; i <= dataSource.indexOf(rowData); i++) {"+
                     "let item = dataSource[i];"+
                     " let voucherAmount = parseFloat(item.VoucherAmountFormatted ? item.VoucherAmountFormatted.toString().replace(/,/g, '') : 0);"+
                    "  balance += voucherAmount"+
                 "}"+
			//  "let formattedBalance = balance.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });"+
         "let formattedBalance = Math.abs(balance).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });"+

                   "let balanceType = balance >= 0 ? 'Dr' : 'Cr'; "+
                 " return `${formattedBalance} ${balanceType}`;"+
			"}").Visible(true);
						columns.AddFor(m => m.ReferenceNote).Caption(new JS("formatMessage('ReferenceNote')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.AccountHeadArabic).Caption(new JS("formatMessage('AccountHeadArabic')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.BillPaidTo).Caption(new JS("formatMessage('BillPaidTo')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.BillDate).Caption(new JS("formatMessage('BillDate')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.BillNo).Caption(new JS("formatMessage('BillNo')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherModifiedOn).Caption(new JS("formatMessage('VoucherModifiedOn')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherModifiedBy).Caption(new JS("formatMessage('VoucherModifiedBy')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.SysRemarks).Caption(new JS("formatMessage('SysRemarks')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherType).Caption(new JS("formatMessage('VoucherType')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.MasterGroup).Caption(new JS("formatMessage('MasterGroup')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.AccountGroup).Caption(new JS("formatMessage('AccountGroup')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('EntryNarration')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('DrCr')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('AccountHead')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherEntryNo).Caption(new JS("formatMessage('VoucherEntryNo')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherApprovedOn).Caption(new JS("formatMessage('VoucherApprovedOn')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherVerifiedOn).Caption(new JS("formatMessage('VoucherVerifiedOn')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherVerifiedBy).Caption(new JS("formatMessage('VoucherVerifiedBy')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherNarration).Caption(new JS("formatMessage('Narration')")).Alignment(HorizontalAlignment.Left).Visible(true);
					})
				.OnCellClick("function(e) {handleCellClick(e);}")
				.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.Select))
				.AllowColumnReordering(true) // Enable column reordering
				.AllowColumnResizing(true)   // Enable column resizing
				.ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
				.HeaderFilter(filter => filter.Visible(false))
				.Height(550)
				.ColumnAutoWidth(true)
				.FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
				.GroupPanel(groupPanel => groupPanel.Visible(true)) // Display group panel
				.ShowBorders(false)
				@* 	.ColumnChooser(columnChooser => columnChooser
		.Enabled(false) // Enable the column chooser for hiding and showing columns
		.Title("Column Chooser") // Optional: Set a custom title
		.Mode (GridColumnChooserMode.Select)
		)*@
				.Width("100%")
				.Summary(summary =>
				{
					summary.TotalItems(totalItems =>
					{
						totalItems.Add()
					.Column("VoucherNo") // Count of VoucherNo
					.SummaryType(SummaryType.Count)
					.DisplayFormat(new JS("formatMessage('Count: {0}')")); // Customize the display format

						totalItems.Add()
					.Column("DrAmount") // Sum of DrAmount
					.SummaryType(SummaryType.Sum)
					.CustomizeText(
					"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

					);

						totalItems.Add()
					.Column("CrAmount") // Sum of CrAmount
					.SummaryType(SummaryType.Sum)
					.CustomizeText(
					"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

					);      // Customize the display format to currency
					});
				})
				.FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
				.GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
				.ShowBorders(true)
				.StateStoring(stateStoring =>
				{
					stateStoring
					.Enabled(true)                       // Enable state storing
					.Type(StateStoringType.LocalStorage)  // Store in localStorage (or use SessionStorage or Custom)
					.StorageKey("gridContainerState");    // Set a unique key to identify the state in storage
				})
				.OnInitialized("function(e) { loadGridState(); }")
				)



	</div>

	<div id="overlay" class="overlay">
		<div class="overlay-content">
			<span class="close-btn" onclick="closeOverlay()">×</span>
			<iframe id="overlay-frame" src="" frameborder="0"></iframe>
		</div>
	</div>

	</div>

@using (Html.DevExtreme().NamedTemplate("LedgerContentTemplate"))
{
	@(Html.DevExtreme().DataGrid()
								.ID("ledgeraccount-datagrid")
								.DataSource(d => d.WebApi()
								.Controller("AccountingLedgers")
								.LoadAction("GetLedgerAccounts")
								.LoadMode(DataSourceLoadMode.Raw)
								.Key("AccountId")
								)
							.WordWrapEnabled(false)
								.ShowBorders(true)
								.SearchPanel(sp => sp.HighlightSearchText(true))
								.Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
								.OnSelectionChanged("dataGridSelectionChanged")
								.OnInitialized("dataGridInitialized")
							.HeaderFilter(p => p.Visible(false))
								.ShowBorders(true)
								.HoverStateEnabled(true)
							//.Paging(p => p.PageSize(15))
								.FilterRow(f => f.Visible(true))
								.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
							.Height(400)
								.Selection(s => s.Mode(SelectionMode.Single))
								.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
								.Columns(columns =>
								{
										columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
										columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')")).Width(400);
										columns.Add().DataField("AccountHeadArabic").Caption(new JS("formatMessage('Account Head Arabic')"));
										columns.Add().DataField("MasterGroup").Caption(new JS("formatMessage('Master Group')"));
										columns.Add().DataField("AccountGroup").Caption(new JS("formatMessage('Account Group')"));
										columns.Add().DataField("ReferenceNo").Caption(new JS("formatMessage('ReferenceNo')"));
										columns.Add().DataField("IsLedgerObselete").Caption(new JS("formatMessage('Is Ledger Obselete')"));
								})
							)
}

<script>
	let selectedVoucherNo = null; 
		$(function () {
										$("#AccountingLedger").dxTextBox({
												text:formatMessage("Accounting Ledger"),
												readOnly: true

