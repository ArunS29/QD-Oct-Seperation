		function updateValueSlider(cardId, values) {
			const slider   = document.querySelector(`#${cardId} .value-slider`);
			if (!slider) return;

			const iconHtml = slider.querySelector('span svg')?.outerHTML || '';

			slider.innerHTML = '';
			values.forEach(v => {
				const span = document.createElement('span');
				span.innerHTML = iconHtml + v;
				slider.appendChild(span);
			});

			let idx = 0;
			clearInterval(slider._interval);
			slider._interval = setInterval(() => {
				idx = (idx + 1) % values.length;
				slider.style.transition = 'transform .45s ease';
				slider.style.transform  = `translateY(-${idx * 28}px)`;
			}, 2000);
		}
