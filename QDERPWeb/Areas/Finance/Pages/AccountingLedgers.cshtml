	<!-- Result Grid -->



	<div class="dx-field ledgerResult">
		<!-- Toolbar for Column Chooser and Filter -->
		<div class="custom-toolbar">
			<div id="columnChooser"></div>
			
		</div>

		@(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.StProAccountLedgerResult>()
					.ID("dataGrid")
					.RemoteOperations(false)
					.Columns(columns =>
					{
						columns.AddFor(m => m.VoucherNo).Caption("Voucher No").Alignment(HorizontalAlignment.Center)
					.CellTemplate(@<text>
			<div>
				<a href="javascript:void(0);" style="color: #007bff; font-weight: bold;">
					<%- data.VoucherNo %>
				</a>
			</div>
		</text>)
				.Visible(true);

						columns.AddFor(m => m.VoucherDate).Caption("Voucher Date")
			.Alignment(HorizontalAlignment.Center)
			.Format(format => format.Type(Format.ShortDate)
			.Formatter("function(value) { return DevExpress.localization.formatDate(new Date(value), 'dd-MMM-yyyy'); }"))
			.Visible(true);

						columns.AddFor(m => m.VoucherEffectiveDate).Caption("Effective On")
			.Alignment(HorizontalAlignment.Center)
			.Format(format => format.Type(Format.ShortDate)
			.Formatter("function(value) { return DevExpress.localization.formatDate(new Date(value), 'MMM-yyyy'); }"))
			.Visible(true);

						columns.AddFor(m => m.AccountHeadName).Caption("Account Ledger")
			.Alignment(HorizontalAlignment.Left)
			.Visible(true);

						columns.AddFor(m => m.DrAmount).Caption("Debit").Alignment(HorizontalAlignment.Right)
			.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }")
			.Visible(true);

						columns.AddFor(m => m.CrAmount).Caption("Credit").Alignment(HorizontalAlignment.Right)
			.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }")
			.Visible(true);

						columns.Add().Caption("Balance").Alignment(HorizontalAlignment.Right).DataType(GridColumnDataType.Number)
			.CalculateCellValue("function(rowData) { " +
			"    let balance = 0;" +
			"    const dataSource = $('#dataGrid').dxDataGrid('instance').option('dataSource');" +
			"    dataSource.forEach((item, index) => { " +
			"        if (index <= dataSource.indexOf(rowData)) { " +
			"            let debit = parseFloat(item.DrAmount ? item.DrAmount.toString().replace(/,/g, '') : 0);" +
			"            let credit = parseFloat(item.CrAmount ? item.CrAmount.toString().replace(/,/g, '') : 0);" +
			"            if (!isNaN(debit)) balance += debit;" +
			"            if (!isNaN(credit)) balance -= credit;" +
			"        }" +
			"    });" +
			"    let formattedBalance = balance.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });" +
			"    return balance >= 0 ? `<span style='color:green'>${formattedBalance} Cr</span>` : `<span style='color:red'>${formattedBalance} Dr</span>`;" +
			"}")
			.Visible(true);

						columns.AddFor(m => m.VoucherNarration).Caption("Narration").Alignment(HorizontalAlignment.Left).Visible(true);
						columns.AddFor(m => m.BillRemarks).Caption("Remarks").Alignment(HorizontalAlignment.Left).Visible(true);
					})
				.OnCellClick("function(e) { handleCellClick(e); }")
				.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
				.AllowColumnReordering(true)
				.AllowColumnResizing(true)
				.ColumnFixing(fixing => fixing.Enabled(true))
				.HeaderFilter(filter => filter.Visible(false)) /* Removed filter on headings */
				.Height(420)
				.ColumnAutoWidth(true)
				.FilterRow(filterRow => filterRow.Visible(false)) /* Initially hidden, toggled via button */
				.GroupPanel(groupPanel => groupPanel.Visible(true))
				.ShowBorders(false)
				.Width("100%")
				.Summary(summary =>
				{
					summary.TotalItems(totalItems =>
					{
						totalItems.Add().Column("VoucherNo").SummaryType(SummaryType.Count)
					.DisplayFormat("Count: {0}");

						totalItems.Add().Column("DrAmount").SummaryType(SummaryType.Sum)
					.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

						totalItems.Add().Column("CrAmount").SummaryType(SummaryType.Sum)
					.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
					});
				})
				.StateStoring(stateStoring =>
				{
					stateStoring
					.Enabled(true)
					.Type(StateStoringType.LocalStorage)
					.StorageKey("gridContainerState");
				})
				.OnInitialized("function(e) { loadGridState(); }")
				.OnOptionChanged("function(e) { if (e.fullName.startsWith('columns') && e.fullName.includes('sortOrder')) { calculateDynamicBalance(); } }")
				)
	</div>

	<div id="overlay" class="overlay">
		<div class="overlay-content">
			<span class="close-btn" onclick="closeOverlay()">×</span>
			<iframe id="overlay-frame" src="" frameborder="0"></iframe>
		</div>
	</div>

</div>
<!-- Drop Down Grid Template -->
@using (Html.DevExtreme().NamedTemplate("LedgerContentTemplate"))
{
	@(Html.DevExtreme().DataGrid()
