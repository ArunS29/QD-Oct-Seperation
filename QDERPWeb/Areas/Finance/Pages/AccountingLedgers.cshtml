<!-- Drop Down Grid Template -->
@using (Html.DevExtreme().NamedTemplate("LedgerContentTemplate"))
{
    @(Html.DevExtreme().DataGrid()
        .ID("ledgeraccount-datagrid")
        .DataSource(d => d.WebApi()
        .Controller("AccountingLedgers")
        .LoadAction("GetLedgerAccounts")
        .LoadMode(DataSourceLoadMode.Raw)
        .Key("AccountId")
        )
        .WordWrapEnabled(true)
        .ShowBorders(true)
        .SearchPanel(sp => sp.HighlightSearchText(true))
        .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
        .OnSelectionChanged("dataGridSelectionChanged")
        .OnInitialized("dataGridInitialized")
        .HeaderFilter(p=>p.Visible(true))
        .ShowBorders(true)
        .HoverStateEnabled(true)
        .Paging(p => p.PageSize(15))
        .FilterRow(f => f.Visible(true))
        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
        .Height(345)
        .Selection(s => s.Mode(SelectionMode.Single))
        .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
        .Columns(columns =>
        {
            columns.Add().DataField("AccountId");
            columns.Add().DataField("AccountHead");
            columns.Add().DataField("MasterGroup");
            columns.Add().DataField("AccountGroup");
            columns.Add().DataField("ReferenceNo");
        })
    )
}
<script>
    $(function () {

        var contextMenu = $("#contextMenu");
        var contextMenuContent = $("#contextMenuContent");
        // var dropDownBox = $("#accountDropDownBox").dxDropDownBox("instance");
        // if (dropDownBox) {
        //     dropDownBox.focus();
        // }
        // Hide context menu on click outside
        $(document).on("click", function () {
            contextMenu.hide();
        });
         // Apply the custom context menu plugin
            $("#dataGrid").customizeGridContextMenu();

        // Handle right-click event on the DataGrid rows
        $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
            e.preventDefault(); // Prevent the default context menu
            var rowIndex = $(this).index(); // Get the row index
            var rowData = $("#dataGrid").dxDataGrid("instance").getDataSource().items()[rowIndex]; // Get the data for the row
            console.log(rowData); // Log or use the row data as needed
            // Clear previous content
            contextMenuContent.empty();
            // Add column titles and values to the context menu
            contextMenuContent.append("<div style='display:none'><strong>Voucher No:</strong> " + rowData.VoucherNo + "</div>");
            // Show custom context menu
            contextMenu.css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
        });

        // Get voucher Pop Up
        $("#voucherPopup").dxPopup({
            title: "Voucher Details",
            width: 300,
            height: 200,
            visible: false, // Start hidden
            showCloseButton: true,
            closeOnOutsideClick: true,

        });
    });
    let dataGrid;

    function dropDownBoxValueChanged(e) {
        if (!e.value) {
            dataGrid.clearSelection();
            return;
        }
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();

        // Update the DataGrid search panel text with the DropDownBox text
        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dataGridSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#accountDropDownBox").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) ddbInstance.close();
        }
        
    }

    function dataGridInitialized(e) {
        dataGrid = e.component;
    }
    function calculateDynamicBalance() {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const sortedData = dataGrid.getVisibleRows().map(row => row.data); // Get data in the current displayed order
        let runningBalance = 0;

        sortedData.forEach(item => {
            const debit = parseFloat(item.DrAmount ? item.DrAmount.toString().replace(/,/g, '') : 0);
            const credit = parseFloat(item.CrAmount ? item.CrAmount.toString().replace(/,/g, '') : 0);

            if (!isNaN(debit)) runningBalance -= debit;
            if (!isNaN(credit)) runningBalance += credit;

            // Update item balance for display
            item.Balance = runningBalance.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        });

        dataGrid.refresh(); // Refresh the grid to show updated balances
    }
    // Grid cell click handle event
    function handleCellClick(e) {
        if (e.column.dataField === "VoucherNo") {
            if (e.data.VoucherNo != "") {
                $("#voucherPopup").dxPopup("instance").show();
                $("#popupVoucherNo").text(e.data.VoucherNo);
                $("#popupVoucherDate").text(formatDate(e.data.VoucherDate));
                $("#popupVoucherNarration").text(e.data.VoucherType);
            }
        } else if (e.column.dataField === "VoucherNarration") {
            var contextControl = $("#contextControl");
            var contextControlContent = $("#contextControlContent");
            contextControlContent.empty();
            // Add column titles and values to the context menu
            contextControlContent.append("<div><textarea disabled id ='narrationEditor' style = 'width:100%; height:100px;'>" + e.data.VoucherNarration
                + "</textarea></div>");
            // Show custom context menu
            contextControl.css({ top: e.event.pageY + "px", left: e.event.pageX + "px", width: "250px" }).show();
        }
        else if (e.column.dataField === "BillRemarks") {
            var contextControl = $("#contextControl");
            var contextControlContent = $("#contextControlContent");
            contextControlContent.empty();
            // Add column titles and values to the context menu
            contextControlContent.append("<div><div><textarea id ='narrationEditor' style = 'width:100%; height:100px;'>" + e.data.BillRemarks
                + "</textarea></div>");
            // Show custom context menu
            contextControl.css({ top: e.event.pageY + "px", left: e.event.pageX + "px", width: "250px" }).show();
        }
    }
    function hideEditControl() {
        var contextControl = $("#contextControl");
        contextControl.hide();
    }
    // Show voucher button click event
    function showVoucher() {
        alert("Show Voucher button clicked");
        // Implement logic for showing the voucher details page
    }
    // Edit Voucher button click event
    function editRow() {
        // Implement edit logic
        alert("Edit voucher functionality");
        $("#contextMenu").hide();
    }

    // This function us used to get slected row from grid and set value of dropdown
    function onSelectionChanged(selectionChangedArgs, component) {
        var setValue = component.option('setValue');
        var selectedRowKey = selectionChangedArgs.selectedRowKeys[0];

        component.option('value', selectedRowKey);
        //setValue(selectedRowKey);
        if (selectionChangedArgs.selectedRowKeys.length > 0) {
            component.close();
        }
    }
    // This function used to call API to get records for the selected values.
    function ddBtnShowRecords_click(duration) {
        var dropDownBox = $("#accountDropDownBox").dxDropDownBox("instance");
        if (dropDownBox.option("value") === null) {
            alert("Please select a ledger account.");
            return;
        }
        var frmDateBox = $("#frmdateBox").dxDateBox("instance");
        var toDateBox = $("#todateBox").dxDateBox("instance");
        var accountId = $("#accountDropDownBox").dxDropDownBox("instance").option("value");
        var frmDate = new Date(frmDateBox.option("value"));
        var toDate = new Date(toDateBox.option("value"));
        var currentDate = new Date();
        switch (duration) {
            case 'today':
                frmDate = toDate = currentDate;
                break;
            case 'yesterday':
                var dateObj = new Date();
                // Subtract one day from current time
                dateObj.setDate(dateObj.getDate() - 1);
                frmDate = toDate = dateObj;
                break;
            case 'week':
                var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

                // Calculate the start of the week (Saturday)
                var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

                // Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
                frmDate = new Date(currentDate.setDate(startOfWeek - 7)); // 7 days before Saturday
                toDate = new Date(currentDate.setDate(startOfWeek - 1));
                break;
            case 'tillmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
                toDate = currentDate; //Today
                break;
            case 'fullmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
                break;
            case 'tillyear':
                // Get the first and last day of the current year
                frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
                toDate = currentDate;// Today
                break;
            case 'fullyear':
                // Get the first and last day of the current year
                frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
                break;
            case 'lastyear':
                // Get the first and last day of the last year
                frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
                toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
                break;
            case 'lastmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
                break;
        }
        frmDate = frmDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        toDate = toDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        frmDateBox.option("value", frmDate);  // Set frmDateBox value
        toDateBox.option("value", toDate);    // Set toDateBox value
        $.ajax({
            url: '/api/AccountingLedgers/GetVouchers',  // API endpoint
            type: 'GET',
            data: {
                accountId: accountId,
                frmDate: frmDate,
                toDate: toDate
            },
            success: function (data) {
                // Bind the data to the DataGrid
                $("#dataGrid").dxDataGrid("instance").option("dataSource", data);
                // DevExpress.ui.notify("Data fetched successfully", "success", 2000);
            },
            error: function () {
                DevExpress.ui.notify("Error while loading data", "error", 2000);
            }
        });
    }
    // Function to format date in required format
    function formatDate(date) {
        var d = new Date(date),
            month = '' + (d.getMonth() + 1),
            day = '' + d.getDate(),
            year = d.getFullYear();

        var strmonth = d.toLocaleString('default', { month: 'short' });
        if (day.length < 2)
            day = '0' + day;

        return [day, strmonth, year].join('-');
    }
</script>
