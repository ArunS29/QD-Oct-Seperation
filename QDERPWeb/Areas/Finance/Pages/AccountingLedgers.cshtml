			 const fmt = v => v.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

			function startOf(type) {
				const now = new Date();
				if (type === 'today')   return new Date(now.getFullYear(), now.getMonth(), now.getDate());
				if (type === 'week')    return new Date(startOf('today').setDate(startOf('today').getDate() - startOf('today').getDay()));
				if (type === 'month')   return new Date(now.getFullYear(), now.getMonth(), 1);
			}

			/* ---------- crunch the numbers ---------- */
			function aggregate(rows) {
				const sToday  = startOf('today'),
					  sWeek   = startOf('week'),
					  sMonth  = startOf('month');

				const totals = {
					count: rows.length,
					debit: 0,  credit: 0,  balance: 0,
					debitToday: 0,  creditToday: 0,
					debitWeek: 0,   creditWeek: 0,
					debitMonth: 0,  creditMonth: 0
				};

				rows.forEach(r => {
					const vd = new Date(r.VoucherDate);
					const dr = +r.DrAmount || 0;
					const cr = +r.CrAmount || 0;

					totals.debit  += dr;
					totals.credit += cr;

					if (vd >= sToday) { totals.debitToday  += dr; totals.creditToday  += cr; }
					if (vd >= sWeek)  { totals.debitWeek   += dr; totals.creditWeek   += cr; }
					if (vd >= sMonth) { totals.debitMonth  += dr; totals.creditMonth  += cr; }
				});

				totals.balance = totals.debit - totals.credit;
				return totals;
			}

			/* ---------- paint the KPI cards ---------- */
				function updateKpis(t) {
			// Helper to update bar width and percentage label
			function updateTrend(cardId, percent) {
				const bar = document.querySelector(`#${cardId} .bar`);
				const fill = bar?.querySelector('span');
				const pct = Math.max(0, Math.min(100, percent)); // clamp 0–100

				if (fill) fill.style.width = `${pct}%`;
				if (bar)  bar.setAttribute('data-percentage', `${pct.toFixed(0)}%`);
			}

			// 1) Accounting‑Ledger (row count)
			$('#Static .value-slider span:last').text(t.count);

			// 2) Debit
			$('#cardDebit .value-slider span:last').text(fmt(t.debit));
			$('#cardDebit .overlay .detail').eq(0).text(`Today: ${fmt(t.debitToday)}`);
			$('#cardDebit .overlay .detail').eq(1).text(`This Week: ${fmt(t.debitWeek)}`);
			$('#cardDebit .overlay .detail').eq(2).text(`This Month: ${fmt(t.debitMonth)}`);
			updateTrend("cardDebit", (t.debit / ((t.debit + t.credit) || 1)) * 100);

			// 3) Credit
			$('#cardCredit .value-slider span:last').text(fmt(t.credit));
			$('#cardCredit .overlay .detail').eq(0).text(`Today: ${fmt(t.creditToday)}`);
			$('#cardCredit .overlay .detail').eq(1).text(`This Week: ${fmt(t.creditWeek)}`);
			$('#cardCredit .overlay .detail').eq(2).text(`This Month: ${fmt(t.creditMonth)}`);
			updateTrend("cardCredit", (t.credit / ((t.debit + t.credit) || 1)) * 100);

			// 4) Balance
			$('#cardBalance .value-slider span:last').text(fmt(Math.abs(t.balance)));
			const balTrend = $('#cardBalance .trend i');
			balTrend.toggleClass('fa-arrow-up', t.balance >= 0)
					 .toggleClass('fa-arrow-down', t.balance < 0);
			updateTrend("cardBalance", Math.abs(t.balance) === 0 ? 0 : (t.balance / (t.debit || 1)) * 100);
		}


			// /* ---------- wire it to the grid ---------- */
			function handleGridContentReady(e) {
				const data = e.component.option('dataSource') || [];
				updateKpis(aggregate(data));
			}

