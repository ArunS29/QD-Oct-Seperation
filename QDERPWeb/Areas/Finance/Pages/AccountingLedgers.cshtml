@page
@using DevExtreme.AspNet.Mvc

<style type="text/css">

	.popup-modal {
		display: none;
		position: fixed;
		z-index: 1;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.4);
	}

	.popup-content {
		position: relative;
		background-color: white;
		margin: 15% auto;
		padding: 20px;
		width: 80%;
		height: 80%;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
	}

	.popup-close {
		color: #aaa;
		float: right;
		font-size: 28px;
		font-weight: bold;
	}

		.popup-close:hover,
		.popup-close:focus {
			color: black;
			text-decoration: none;
			cursor: pointer;
		}

</style>
<div id="popupModal" style="display:none;" class="popup-modal">
	<div class="popup-content">
		<span id="closeModal" class="popup-close">&times;</span>
		<div id="modalContent" style="height: 100%; overflow: auto;"></div> <!-- This will hold the dynamically loaded content -->
	</div>
</div>
<input id="formId" value="frm201LedgerView" type="hidden" />
<div id="inputPopupContainer"></div>
<div class="content-container-top">
	<!-- Context Menu -->
	<div class="context-menu" id="contextMenu">
		<div id="contextMenuContent"></div>
		<div class="context-menu-item">
			@(Html.DevExtreme().Button()
						.ID("btnEditVoucher")
						.Text("Edit Voucher")
						.Type(ButtonType.Normal)
						.StylingMode(ButtonStylingMode.Outlined)
						.Icon("edit")
						.Width(180)
						.OnClick("function() { editRow(); }")
						)
		</div>
	</div>
	<!-- Context Control -->
	<div class="context-menu" id="contextControl">
		<div id="contextControlContent"></div>
		<div class="context-menu-item">
			<div style='text-align:right;'>
				<button id='okButton' onclick='hideEditControl()' style='margin-right:5px;'> OK</button>
			</div>
		</div>
	</div>
	<!-- Pop UP-->
	<div id="voucherPopup" style="display:none;">
		<div style="margin-bottom:10px">
			<strong>Voucher No:</strong> <span id="popupVoucherNo"></span><br />
			<strong>Voucher Date:</strong> <span id="popupVoucherDate"></span><br />
			<strong>Voucher Type:</strong> <span id="popupVoucherNarration"></span><br />
		</div>
		@(Html.DevExtreme().Button()
				.ID("btnShowVoucher")
				.Text("Show Voucher")
				.Type(ButtonType.Normal)
				.StylingMode(ButtonStylingMode.Outlined)
				.Icon("paste")
				.Width(180)
				.OnClick("function() { showVoucher(); }")
				)
	</div>


