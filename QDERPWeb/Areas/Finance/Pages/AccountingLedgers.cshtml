				// Inject into Balance
				$('#cardBalance .value-slider span').each(function () {
					$(this).html(icon + $(this).text().trim().replace(icon, ''));
				});

				// Inject into Debit
				$('#cardDebit .value-slider span').each(function () {
					$(this).html(icon + $(this).text().trim().replace(icon, ''));
				});

				// Inject into Credit
				$('#cardCredit .value-slider span').each(function () {
					$(this).html(icon + $(this).text().trim().replace(icon, ''));
				});
			},
			error: function (err) {
				console.error("Failed to load currency icon:", err);
			}
		});
	}

	// Call this on document ready or after cards are rendered
	$(document).ready(function () {
		injectCurrencyToCards();
		injectHeaderSVG();
	});


</script>