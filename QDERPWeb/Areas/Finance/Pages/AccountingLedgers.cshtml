	function handleGridContentReady(e) {

		let gridInstance = $('#dataGrid').dxDataGrid('instance');

		if (!gridInstance) return;

		let dataSource = gridInstance.option('dataSource');

		if (!dataSource || !Array.isArray(dataSource)) return;

		// Check if balance is already calculated to avoid redundant updates

		if (dataSource.length > 0 && dataSource[0].CalculatedBalance !== undefined) {

			return; // Prevent infinite loop

		}

		let balance = 0;

		dataSource.forEach((item) => {

			let voucherAmount = parseFloat(item.VoucherAmountFormatted ? item.VoucherAmountFormatted.toString().replace(/,/g, '') : 0);

			balance += voucherAmount;

			// Assign balance to a new property in the data source

			item.CalculatedBalance = Math.abs(balance).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " " + (balance >= 0 ? "Dr" : "Cr");

		});

		// Refresh grid without resetting dataSource to avoid infinite loop

		gridInstance.refresh();

		// Get the visible rows

		let visibleRows = gridInstance.getVisibleRows();

		if (visibleRows && visibleRows.length > 0) {

			let firstRow = visibleRows[0].data;

			let lastRow = visibleRows[visibleRows.length - 1].data;

			firstRowBalance = firstRow ? firstRow.CalculatedBalance : null;

			lastRowBalance = lastRow ? lastRow.CalculatedBalance : null;

			// alert(lastRowBalance)

			console.log("First Row Balance: ", firstRowBalance);

			console.log("Last Row Balance: ", lastRowBalance);

		} else {

			console.log("No visible rows available.");

		}

	}
	function navigateToVoucherPage(voucherNo) {
		console.log("Original VoucherNo:", voucherNo); // Debugging

		if (!voucherNo) {
			alert("Invalid voucher number.");
			return;
		}

		let formattedVoucher = voucherNo.trim().toUpperCase(); // Convert to uppercase for consistency

		console.log("Formatted VoucherNo:", formattedVoucher); // Debugging

		// Define base URLs (Fix: Avoid embedding formattedVoucher inside object definition)
		const voucherRoutes = {
			"BP-": "/pulse/finance/VoucherBankPayment",
			"CP-": "/pulse/finance/VoucherCashPayment",
			"BR-": "/pulse/finance/VoucherEntryReceipts",
			"CR-": "/pulse/finance/VoucherEntryCashReceipts",
			"SAL-": "/pulse/finance/SalesVoucher",
			"PUR-": "/pulse/finance/PurchaseVoucher",
			"JV-": "/pulse/Finance/Voucherjournal"
		};

		// Match by prefix
		for (let prefix in voucherRoutes) {
			if (formattedVoucher.startsWith(prefix)) {
				let baseUrl = voucherRoutes[prefix];
				let targetUrl = `${baseUrl}?argsledno=${encodeURIComponent(formattedVoucher)}`; // Proper encoding

				console.log("Navigating to:", targetUrl); // Debugging
				window.location.href = targetUrl; // Navigate
				return;
			}
		}

		
	}

	// Function to handle right-click event on the grid
	$(document).on("contextmenu", ".dx-datagrid-rowsview .dx-row", function (e) {
		e.preventDefault(); // Prevent default right-click menu

		let dataGrid = $("#dataGrid").dxDataGrid("instance"); // Replace with your grid ID
		let rowIndex = $(this).index();
		let rowData = dataGrid.getVisibleRows()[rowIndex].data;

		if (rowData && rowData.VoucherNo) {
			selectedVoucherNo = rowData.VoucherNo; // Store the selected voucher number
			console.log("Selected VoucherNo:", selectedVoucherNo);
		}

		// Show context menu at mouse position
		$("#contextMenu").css({
			display: "block",
			left: e.pageX,
			top: e.pageY
		});
	});

	// Hide context menu when clicking elsewhere
	$(document).on("click", function () {
		$("#contextMenu").hide();
	});

	// Assign onclick event to btnEditVoucher
	$("#btnEditVoucher").on("click", function () {
		if (selectedVoucherNo) {
			navigateToVoucherPage(selectedVoucherNo); // Pass the stored voucher number
		} else {
			alert("No voucher selected.");
		}
	});


</script>