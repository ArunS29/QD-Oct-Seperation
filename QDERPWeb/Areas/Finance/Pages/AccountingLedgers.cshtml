			function slideValue($slider, newText) {
			const current = $slider.find('span').first().text();
			if (current === newText) return;                    // nothing changed

			// add new span at end
			$slider.append(`<span>${newText}</span>`);

			const spanH = $slider.find('span').first().outerHeight();
			$slider.css({ transition: 'transform .45s ease', transform: `translateY(-${spanH}px)` });

			// after animation, reset to show only new span
			setTimeout(() => {
				$slider.css({ transition: 'none', transform: 'translateY(0)' });
				$slider.find('span').first().remove();
			}, 450);
