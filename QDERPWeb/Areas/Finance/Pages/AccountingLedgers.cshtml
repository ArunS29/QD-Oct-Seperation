}
<script>
		function toggleFilterRow() {
		var grid = $("#dataGrid").dxDataGrid("instance");
		var isVisible = grid.option("filterRow.visible");
		grid.option("filterRow.visible", !isVisible);
	}
	let acchedid, accheadname, refno, accgroup, IsEdit = false, accgroupid, accheadar, FromDate, ToDate, accid;

	var inputPopupInstance
	$(function () {
		// Initialize the DevExtreme Popup
		inputPopupInstance = $("#inputPopupContainer").dxPopup({
			width: 600,
			height: 400,
			showTitle: true,
			title: "Details",
			visible: false,
			dragEnabled: true,
			closeOnOutsideClick: true,
			contentTemplate: function () {
				return $("<div>").attr("id", "popupFormContent"); // Placeholder for dynamic content
			}
		}).dxPopup("instance");
		var contextMenu = $("#contextMenu");
		var contextMenuContent = $("#contextMenuContent");
		// var dropDownBox = $("#accountDropDownBox").dxDropDownBox("instance");
		// if (dropDownBox) {
		//     dropDownBox.focus();
		// }
		// Hide context menu on click outside
		$(document).on("click", function () {
			contextMenu.hide();
		});

			$("#gridContainer").dxDataGrid({
		columnChooser: {
			enabled: true,
			mode: "select",  // or 'dragAndDrop'
			allowSearch: true, // Enables search
			height: 400,
			width: 300,
			position: {
				my: "left top",
				at: "left bottom",
				of: "#gridContainer"
			}
		},
		toolbar: {
			items: [
				{
					location: "before",
					widget: "dxButton",
					options: {
						text: "Column Chooser",
						icon: "columnchooser",
						onClick: function () {
							var grid = $("#gridContainer").dxDataGrid("instance");
							grid.showColumnChooser();
						}
					}
				}
			]
		}
	});

		// Apply the custom context menu plugin
		$("#dataGrid").customizeGridContextMenu();

		// Handle right-click event on the DataGrid rows
		$("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
			e.preventDefault(); // Prevent the default context menu
			var rowIndex = $(this).index(); // Get the row index
			var rowData = $("#dataGrid").dxDataGrid("instance").getDataSource().items()[rowIndex]; // Get the data for the row
			console.log(rowData); // Log or use the row data as needed
			// Clear previous content
			contextMenuContent.empty();
			// Add column titles and values to the context menu
			contextMenuContent.append("<div style='display:none'><strong>Voucher No:</strong> " + rowData.VoucherNo + "</div>");
			// Show custom context menu
			contextMenu.css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
		});

		// Get voucher Pop Up
		$("#voucherPopup").dxPopup({
			title: "Voucher Details",
			width: 300,
			height: 200,
			visible: false, // Start hidden
			showCloseButton: true,
			closeOnOutsideClick: true,

		});
	});
	let dataGrid;

	function dropDownBoxValueChanged(e) {
		if (!e.value) {
			dataGrid.clearSelection();
			return;
		}
	}

	function dropDownBoxOnInput(e) {
		const ddbInstance = e.component;
		if (!ddbInstance.option("opened")) ddbInstance.open();

		// Update the DataGrid search panel text with the DropDownBox text
		const text = ddbInstance.option("text");
		if (dataGrid) {
			dataGrid.option("searchPanel.text", text);
		}
	}

	function onOpened(e) {
		setTimeout(() => {
			e.component.focus();
		});
	}

	function onKeyDown(e) {
		const ddbInstance = e.component;
		if (e.event.keyCode !== 40) return;
		if (!ddbInstance.option("opened")) {
			ddbInstance.open();
		} else {
			let focusedIndex = dataGrid.option("focusedRowIndex");
			let visibleRows = dataGrid.getVisibleRows().length - 1;
			if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
			dataGrid.focus(dataGrid.getRowElement(focusedIndex));
		}
	}

