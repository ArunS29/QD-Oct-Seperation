@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;
<style type="text/css">
	.dx-datagrid .dx-row {
		border-bottom: 1px solid #ccc; /* Border between rows */
	}



	.horizontal-container {
		display: flex;
		gap: 10px; /* Adds spacing between buttons */
		justify-content: start; /* Aligns buttons to the left */
		align-items: center; /* Vertically centers the buttons */
		margin: 15px;
	}

	.dx-selectbox .dx-texteditor-input {
		text-align: center; /* Centers the text inside the input */
	}


	.button-alignment-down {
		margin-bottom: 10px
	}

	.content-container-top {
		background-color: #c0dceb;
		border-top-left-radius: 10px; /* Radius for top-left corner */
		border-top-right-radius: 10px; /* Radius for top-right corner */
		padding: 5px;
	}

	label {
		color: black;
		font-weight: bold;
	}

</style>
<div id="costAllocationPopup" style="display:none;">
	<div style="margin-bottom:10px">
		@(Html.DevExtreme().Button()
				.ID("btnSaveCostAllocation")
				.Icon("save")
				.Text(new JS("formatMessage('Save')"))
				.OnClick("function() { saveCostAllocation(); }")
				)
	</div>
</div>
<div class="content-container-top">
	<div class="container">
		<div class="row g-5">
			<div class="col-md-3">
				<div class="form-group">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Voucher Entry ID:')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("VoucherNoId")
												.Value(null)
												//.OnValueChanged("onVoucherNoChanged")
												.Disabled(true)
												)
				</div>
			</div>

			<div class="col-md-4" style="padding-right:0px;padding-top:33px;">
				<div class="form-group">
					@(Html.DevExtreme().DropDownBox()
												.Label(new JS("formatMessage('Payment Account:')"))
												.LabelMode(EditorLabelMode.Outside)
												.Disabled(true)
												.DataSource(d => d.WebApi()
												//	.Controller("PurchaseVoucher")
												//.LoadAction("GetSupplierName")
												.LoadMode(DataSourceLoadMode.Raw)
												.Key("AccountId")
												)
												.ValidationRules(rules =>
												{
													rules.AddRequired()
													.Message("Supplier Name is required");
												})
												.LabelMode(EditorLabelMode.Outside)
												.ID("PaymentNameDropDown")
												.ShowClearButton(true)
												.AcceptCustomValue(true)
												.OpenOnFieldClick(false)
												.ValueChangeEvent("input")
												.HoverStateEnabled(true)
												.ValueExpr("AccountId")
												.DisplayExpr("AccountHead")
												.OnInput("dropDownBoxOnInput")
												.OnOpened("onOpened")
												.TabIndex(1)
												.OnKeyDown("onKeyDown")
												//.OnValueChanged("dropDownBoxValueChanged")
												.ContentTemplate(new TemplateName("PaymentAccountContentTemplate"))
												)

				</div>
			</div>

			<div class="col-md-1" style="padding-top:12px;padding-left:0px;padding-right:0px;width:3%">
				@(Html.DevExtreme().Button()
								.ID("btnAddPaymentAccount")
								.Icon("plus")
								.Disabled(true)
								)
			</div>
			<div class="col-md-2">
				<div class="form-group">
					@(Html.DevExtreme().NumberBox()
												.Label(new JS("formatMessage('Amount')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("AmountId")
												.Value(null)
												.ShowSpinButtons(true)
												.Min(0)
												//.Max(1000)
												.Step(1)
												.Disabled(true)
												)

				</div>
			</div>
			<div class="col-md-2">
				<div class="form-group" style="margin-top: 33px;">
					@(
												Html.DevExtreme().SelectBox()
												.Label(new JS("formatMessage('DrCr')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("DrCrId")
												.DataSource(new[] { "Dr", "Cr" })
												.Value("null")
												.Placeholder("Select Transaction Type")
												.Width(90)
												.Disabled(true)
												)
				</div>

			</div>
		</div>
	</div>
	<div class="clear"></div>





	<div class="dx-fieldset horizontal-container" style="margin-top:15px;margin-bottom:0px;background-color:white;">
		<div class="form-group" style="padding-left:20px">
			<div class="button-alignment-down">
			
			@(
						Html.DevExtreme().SelectBox()
						.Label(new JS("formatMessage('Reference')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("Reference")
						.DataSource(new[] { "New Reference", "Against Reference" })
						.Value("Dr")
						.Placeholder("Select Transaction Type")
						.Width(150)
						)
		</div>
		<div class="form-group">
			@(Html.DevExtreme().DropDownBox().Label(new JS("formatMessage('Reference No:')")).LabelMode(EditorLabelMode.Outside)
						.DataSource(new[] {
			new { AccountId = "2024-00088", AccountHead = "Account 2024-00088" },
			new { AccountId = "2024-00089", AccountHead = "Account 2024-00089" }
			})
						.ValidationRules(rules =>
						{
							rules.AddRequired().Message("Account Head is required");
						})
						.LabelMode(EditorLabelMode.Outside)
						.ID("ddAccountHead")
						.ShowClearButton(true)
						.AcceptCustomValue(true)
						.OpenOnFieldClick(false)
						.ValueChangeEvent("input")
						.HoverStateEnabled(true)
						.ValueExpr("AccountId")
						.DisplayExpr("AccountHead")
						.Value("2024-00088")
						.TabIndex(1)
						.DropDownOptions(o => o.Width(1000))
						.ContentTemplate(new TemplateName("ReferenceNoContentTemplate"))
						)

		</div>
		<div class="form-group" style="margin-top:56px;margin-left:-10px">
			@(Html.DevExtreme().Button()
						.ID("btnAddAHead")
						.Icon("plus")
						)
		</div>

		<div class="form-group">
			@(
						Html.DevExtreme().NumberBox()
						.Label(new JS("formatMessage('Amount')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("txtAmount2")
						.Value(null)
						.Width(150)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message("Voucher Amount is required");
						})
						.Placeholder("0.000")
						.Format("#,##0.000")  // Specify the format for two decimal places
						.InputAttr(new { type = "number", step = "1.000" }) // HTML attribute to allow decimal input
						)

		</div>
		<div class="form-group" style="margin-top:40px;">
			@(Html.DevExtreme().Button()
						.ID("btnVoucherEntry")
						.Text(new JS("formatMessage('ADD')"))
						.Height(50)
						.Width(150)
						.Icon("plus")
						.OnClick("function() { addVoucherEntry(); }")
						)
		</div>
	</div>
	<div class="dx-fieldset horizontal-container" style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px;background-color:white;">

		<div class="form-group" style="padding-left:145px">
			<divstyle ="display:flex;>
			@(Html.DevExtreme().CheckBox()
							.Text(new JS("formatMessage('IsVerified')"))
							.ID("IsVerified1")
							)


				<label id="Show Retained Value" for="Amount"></label>
		</div>

	</div>

	<div class="dx-field ledgerResult">
			@(
					Html.DevExtreme().DataGrid<Tbl201SubLedgerMaster>()
					.ID("dataGrid")
					.KeyExpr("ReferenceNo")
					.RemoteOperations(false)
					//.OnRowRemoved("onRowRemoved")
					.Columns(columns =>
					{
						columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('DrCr')")).Alignment(HorizontalAlignment.Center).Width(100);
						columns.AddFor(m => m.ReferenceType).Caption(new JS("formatMessage('Reference Type')")).Alignment(HorizontalAlignment.Center).Width(100);
						columns.AddFor(m => m.ReferenceNo).Caption(new JS("formatMessage('Reference No')")).Alignment(HorizontalAlignment.Center).Width(100);
						columns.AddFor(m => m.Amount).Caption(new JS("formatMessage('Amount')")).Alignment(HorizontalAlignment.Center).Width(100);
						columns.AddFor(m => m.RetentionAmount).Caption(new JS("formatMessage('Retention Amount')")).Alignment(HorizontalAlignment.Center).Width(100);


					})
					//.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
					.AllowColumnReordering(true) // Enable column reordering
					.AllowColumnResizing(true)   // Enable column resizing
					.ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
					.HeaderFilter(filter => filter.Visible(true))
					.Height(250)
					.ColumnAutoWidth(true)
					.FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
					.GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
					.ShowBorders(true)
					.Width("100%")
					)
	</div>




	<br />

	<div>
			@await Html.PartialAsync("_BPRFooter")
	</div>
	<!-- Drop Down Grid Template -->
			@using (Html.DevExtreme().NamedTemplate("PaymentAccountContentTemplate"))
			{
				@(Html.DevExtreme().DataGrid()
						.ID("Payment-datagrid")
						.DataSource(d => d.WebApi()
						//	.Controller("PurchaseVoucher")
						//	.LoadAction("GetSupplierName")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.WordWrapEnabled(true)
						.ShowBorders(true)
						.SearchPanel(sp => sp.HighlightSearchText(true))
						.Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
						.OnSelectionChanged("dataGridSelectionChanged")
						.OnInitialized("dataGridInitialized")
						.HeaderFilter(p => p.Visible(true))
						.ShowBorders(true)
						.HoverStateEnabled(true)
						.Paging(p => p.PageSize(15))
						.FilterRow(f => f.Visible(true))
						.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
						.Height(345)
						.Selection(s => s.Mode(SelectionMode.Single))
						.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
						.Columns(columns =>
						{
							columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
							columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"));
							columns.Add().DataField("AccountHeadArabic").Caption(new JS("formatMessage('Account Head Arabic')"));
							columns.Add().DataField("IsLedgerObselete").Caption(new JS("formatMessage('Is Ledger Obselete')")).Alignment(HorizontalAlignment.Center)
						.CellTemplate(@<text>
		<div class="dx-icon">
			<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
		</div>
	</text>);

						})
					)
			}
	<!-- Drop Down Account Head Grid Template -->
			@using (Html.DevExtreme().NamedTemplate("ReferenceNoContentTemplate"))
			{
				@(Html.DevExtreme().DataGrid()
						.ID("accounthead-datagrid")
						.DataSource(d => d.WebApi()
						//.Controller("PurchaseVoucher")
						//.LoadAction("GetAccountHead")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.WordWrapEnabled(true)
						.ShowBorders(true)
						.SearchPanel(sp => sp.HighlightSearchText(true))
						.Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
						.OnSelectionChanged("dataGridAccountHeadSelectionChanged")
						.OnInitialized("dataGridAccountHeadInitialized")
						.HeaderFilter(p => p.Visible(true))
						.ShowBorders(true)
						.HoverStateEnabled(true)
						.Paging(p => p.PageSize(15))
						.FilterRow(f => f.Visible(true))
						.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
						.Height(345)
						.Width(300)
						.Selection(s => s.Mode(SelectionMode.Single))
						.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
						.Columns(columns =>
						{
							columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
							columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"));
							columns.Add().DataField("AccountHeadArabic").Caption(new JS("formatMessage('Account Head Arabic')"));
							columns.Add().DataField("IsLedgerObselete").Caption(new JS("formatMessage('Is Ledger Obselete')")).Alignment(HorizontalAlignment.Center)
						.CellTemplate(@<text>
		<div class="dx-icon">
			<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
		</div>
	</text>);

						})
					)
			}


</div>
<script>
	$(function () {

										$("#Show Retained Value").dxTextBox({
													text:formatMessage("Show Retained Value"),
                                                        readOnly: true
                                    });
									});
	$(document).ready(function () {
		// Retrieve query parameters
		const urlParams = new URLSearchParams(window.location.search);
		const voucherNo = urlParams.get('VoucherNo');
		const voucherAmount = urlParams.get('VoucherAmount');
		const drcr = urlParams.get('DrCr');
		const accountHead = urlParams.get('AccountHead'); // New parameter for AccountHead

		if (voucherNo || accountHead) {
			// Wait for DevExtreme components to initialize
			const interval = setInterval(() => {
				const voucherEntryIDInstance = $("#VoucherNoId").dxTextBox("instance");
				const voucherAmountIDInstance = $("#AmountId").dxNumberBox("instance");
				const voucherDrCrIDInstance = $("#DrCrId").dxSelectBox("instance");
				const PaymentNameDropDownInstance = $("#PaymentNameDropDown").dxDropDownBox("instance"); // Access DropDownBox instance

				if (voucherEntryIDInstance && voucherAmountIDInstance && voucherDrCrIDInstance && PaymentNameDropDownInstance) {
					// Set the values and stop the interval
					voucherEntryIDInstance.option("value", voucherNo);
					voucherAmountIDInstance.option("value", voucherAmount);
					voucherDrCrIDInstance.option("value", drcr);

					if (accountHead) {
						PaymentNameDropDownInstance.option("value", accountHead); // Bind the AccountHead value
					}

					clearInterval(interval);
				}
			}, 100); // Retry every 100ms
		}
	});






	function dropDownBoxOnInput(e) {
		const ddbInstance = e.component;
		if (!ddbInstance.option("opened")) ddbInstance.open();


		const text = ddbInstance.option("text");
		if (dataGrid) {
			dataGrid.option("searchPanel.text", text);
		}
	}

	function onOpened(e) {
		setTimeout(() => {
			e.component.focus();
		});
	}

	function onKeyDown(e) {
		const ddbInstance = e.component;
		if (e.event.keyCode !== 40) return;
		if (!ddbInstance.option("opened")) {
			ddbInstance.open();
		} else {
			let focusedIndex = dataGrid.option("focusedRowIndex");
			let visibleRows = dataGrid.getVisibleRows().length - 1;
			if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
			dataGrid.focus(dataGrid.getRowElement(focusedIndex));
		}
	}

	function dataGridSelectionChanged(e) {
		const selectedKey = e.selectedRowKeys[0];
		const ddbInstance = $("#PaymentNameDropDown").dxDropDownBox("instance");

		if (selectedKey) {
			ddbInstance.option("value", selectedKey);
			if (ddbInstance.option("opened")) {
				ddbInstance.close();
			}
		}

	}
	function dataGridAccountHeadSelectionChanged(e) {
		const selectedKey = e.selectedRowKeys[0];
		const ddbInstance = $("#ddAccountHead").dxDropDownBox("instance");

		if (selectedKey) {
			ddbInstance.option("value", selectedKey);
			if (ddbInstance.option("opened")) {
				ddbInstance.close();
			}
		}

	}
	function dataGridInitialized(e) {
		dataGrid = e.component;
	}
	function dataGridAccountHeadInitialized(e) {
		dataGrid = e.component;
	}


	function addVoucherEntry() {

		var DrCr = $("#DrCrId").dxSelectBox("instance").option("value");
		var ReferenceType = $("#Reference").dxSelectBox("instance").option("value");
		var ReferenceNo = $("#ddAccountHead").dxDropDownBox("instance").option("value");
		var Amount = $("#txtAmount2").dxNumberBox("instance").option("value");

		if (!DrCr || !ReferenceType || !ReferenceNo || !Amount) {
			alert("Please fill in all required fields before submitting.");
			return;
		}


		var VE = {
			"DrCr": DrCr,
			"ReferenceType": ReferenceType,
			"ReferenceNo": ReferenceNo,
			"Amount": Amount,
		};


		$.ajax({
			type: "POST",
			url: `/${tenantName}/Finance/api/BillsPayableReceivable/AddBillsPayableReceivable`,
			contentType: "application/json",
			data: JSON.stringify(VE),
			dataType: "json",
			success: function (response) {
				DevExpress.ui.notify("BillsPayable/Receivable details saved succfully!", "success", 2000);

				console.log(response.data);
				$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);


			},
			error: function (xhr, status, error) {
				alert("Error occurred while updating data: " + error);
			}
		});
	}



	$("#btnUpdateAndClose").on("click", function (e) {
		e.preventDefault();


		var VM = {
			"VoucherNo": $("#VoucherNoId").dxTextBox("instance").option("value"),
			"DrCr": $("#DrCrId").dxSelectBox("instance").option("value"),
			"ReferenceType": $("#Reference").dxSelectBox("instance").option("value"),
			"ReferenceNo": $("#ddAccountHead").dxDropDownBox("instance").option("value"),
			"Amount": $("#txtAmount2").dxNumberBox("instance").option("value")
		};

		$.ajax({
			type: "POST",
			url: `/${tenantName}/Finance/api/BillsPayableReceivable/UpdateBillsPayableReceivable`,
			contentType: "application/json",
			data: JSON.stringify(VM),
			dataType: "json",
			success: function (response) {
				if (response.success) {
					alert("Data Updated successfully..");

				} else {
					alert("Update failed: " + response.message);
				}
			},
			error: function (xhr, status, error) {
				alert("Error occurred while updating data: " + error);
			}
		});

	});


</script>