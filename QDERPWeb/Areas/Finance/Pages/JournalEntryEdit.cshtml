<script>
    let selectedVoucherNo = null;
    $(function () {
        $("#JournalVoucherEdit").dxTextBox({
            text: formatMessage("Journal Voucher Edit"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    let argsledno = null;
    $(document).ready(function () {
        // const urlParams = new URLSearchParams(window.location.search);
        // argsledno = urlParams.get("argsledno"); // Get the argsledno query parameter



        // // Change the button text if updating
        // var button = $("#btnSave").dxButton("instance");
        // if (argsledno) {
        //     button.option("text", "Update");
        // }

    });

    function addRow() {
        var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

        if (!voucherNo) {
            DevExpress.ui.notify("Voucher No is missing!", "error", 2000);
            return;
        }

        // 🔁 Step 1: Get existing LineOrder count
        $.get("/api/JournalEntryEdit/GetNextLineOrderNo?voucherNo=" + voucherNo)
            .done(function (nextLineOrderNo) {
                var newRow = {
                    DrAmount: 0.00,
                    CrAmount: 0.00,
                    DrCr: 'Dr',
                    JournalRefNo: voucherNo,
                    LineOrderNo: nextLineOrderNo
                };

                // Save the new row to the database
                $.ajax({
                    url: '/api/JournalEntryEdit/SaveJournalRegisterChild', // 🔁 update this path
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(newRow),
                    success: function () {
                        var button = $("#btnSave").dxButton("instance");
                        button.option("text", "Update");
                        // Reload the grid after saving
                        loadLedgerGridData(voucherNo);
                    },
                    error: function (err) {
                        DevExpress.ui.notify("Error saving data", "error", 2000);
                        console.error(err);
                    }
                });
            })
            .fail(function () {
                DevExpress.ui.notify("Failed to get next LineOrderNo", "error", 2000);
            });
    }

    function loadLedgerGridData(voucherNo) {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");

        $.ajax({
            url: '/api/JournalEntryEdit/GetJournalRegisterChildren?voucherNo=' + voucherNo,
            method: 'GET',
            success: function (data) {
                dataGrid.option("dataSource", data);
            },
            error: function () {
                DevExpress.ui.notify("Failed to load ledger data", "error", 2000);
            }
        });
    }

    $(function () {
        var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
        if (voucherNo) {
            loadLedgerGridData(voucherNo);
        }
        $("#btnAddLine").dxButton({
            text: "Add Line",
            icon: "add",
            onClick: function () {
                addRow();
            }
        });


        $("#dataGrid").dxDataGrid({

            onCellPrepared: function (e) {
                
                if (e.column.dataField === "DrAmount") {
                    e.cellElement.css({ "color": "red", "font-weight": "bold" });
                }
                if (e.column.dataField === "CrAmount") {
                    e.cellElement.css({ "color": "green", "font-weight": "bold" });
                }
            },
           

        });
    });



    $(document).ready(function () {
        $("#ClaimNameDropdown").closest(".dx-dropdownbox").show();
    });
    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function getUrlParameter(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        let regex = new RegExp("[\\?&]" + name + "=([^&#]*)");
        let results = regex.exec(location.search);
        return results === null ? null : decodeURIComponent(results[1].replace(/\+/g, " "));
    }

    $(document).ready(function () {
        const voucherNoField = $("#VoucherNo").dxTextBox("instance");
        const voucherNoFromUrl = getUrlParameter('journalRefNo');

        if (voucherNoFromUrl) {
            // ✅ Bind voucher number from URL
            voucherNoField.option("value", voucherNoFromUrl);
        } else {
            // ❌ If not available, generate new one
            $.ajax({
                url: '@Url.Action("GetNewVoucherNo", "JournalEntryEdit")',
                type: 'GET',
                success: function (data) {
                    voucherNoField.option("value", data);
                },
                error: function () {
                    alert("Error generating voucher number.");
                }
            });
        }

        // Helper to extract URL parameter
        function getUrlParameter(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            const regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            const results = regex.exec(window.location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }
    });


    $("#btnSave").on("click", function (e) {
        e.preventDefault();

        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;

        if (rowCount !== 0) {
            var gridData = dataGrid.getDataSource().items(); // Gets all current grid data

            var VM = {
                JournalRefNo: $("#VoucherNo").dxTextBox("instance").option("value"),
                JournalEntryDate: $("#VoucherDate").dxDateBox("instance").option("value"),
                JournalEffectiveDate: $("#EffectiveDate").dxDateBox("instance").option("value"),
                JournalVoucherNarration: $("#VoucherNarration").dxTextArea("instance").option("value"),
                JournalDetails: gridData // 🔁 Add the grid rows here
            };

            $.ajax({
                type: "POST",
                url: "/api/JournalEntryEdit/UpdateVoucher",
                contentType: "application/json",
                data: JSON.stringify(VM),
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        DevExpress.ui.dialog.alert(
                            "Journal Register Details updated Successfully.",
                            "Update Successful"
                        );
                       
                    } else {
                        alert("Update failed: " + response.message);
                    }
                },
                error: function () {
                    DevExpress.ui.dialog.alert(
                        "Voucher has no line items to be saved, please enter transaction to save.!",
                        "No Line Items"
                    );
                }
            });
        } else {
            if (IsNotification === true) {
                DevExpress.ui.dialog.alert(
                    "Cannot continue saving with errors, please clear the errors and continue.",
                    "Clear Errors"
                );
            } else {
                DevExpress.ui.dialog.alert(
                    "Voucher has no line items to be saved, please enter transaction to save.!",
                    "No Line Items"
                );
            }
        }
    });

    //Save and close
    $("#btnSaveAndClose").on("click", function (e) {



        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;

        if (rowCount !== 0) {
            var gridData = dataGrid.getDataSource().items(); // Gets all current grid data

            var VM = {
                JournalRefNo: $("#VoucherNo").dxTextBox("instance").option("value"),
                JournalEntryDate: $("#VoucherDate").dxDateBox("instance").option("value"),
                JournalEffectiveDate: $("#EffectiveDate").dxDateBox("instance").option("value"),
                JournalVoucherNarration: $("#VoucherNarration").dxTextArea("instance").option("value"),
                JournalDetails: gridData // 🔁 Add the grid rows here
            };

            $.ajax({
                type: "POST",
                url: "/api/JournalEntryEdit/UpdateVoucher",
                contentType: "application/json",
                data: JSON.stringify(VM),
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        DevExpress.ui.dialog.alert(
                            "Journal Register Details updated Successfully.",
                            "Update Successful"
                        );
                        history.back();
                    } else {
                        alert("Update failed: " + response.message);
                    }
                },
                error: function () {
                    DevExpress.ui.dialog.alert(
                        "Voucher has no line items to be saved, please enter transaction to save.!",
                        "No Line Items"
                    );
                }
            });
        } else {
            if (IsNotification === true) {
                DevExpress.ui.dialog.alert(
                    "Cannot continue saving with errors, please clear the errors and continue.",
                    "Clear Errors"
                );
            } else {
                DevExpress.ui.dialog.alert(
                    "Voucher has no line items to be saved, please enter transaction to save.!",
                    "No Line Items"
                );
            }
        }
    });
    //Submit

    $("#btnSubmit").on("click", function (e) {
        e.preventDefault();
        saveJournalEntrys();
    });
    function saveJournalEntrys() {
        debugger;
        var button = $("#btnSubmit").dxButton("instance");

        var gridInstance = $("#dataGrid").dxDataGrid("instance");
        var gridData = gridInstance.getDataSource().items();

        if (!gridData || gridData.length === 0) {
            DevExpress.ui.notify("There are no line items to save. Please add transaction details.", "error", 2000);
            return;
        }
        gridData = gridData.map(entry => {
            return {
                ...entry,
                DrAmount: entry.DrAmount !== "" ? parseFloat(entry.DrAmount) : null,
                CrAmount: entry.CrAmount !== "" ? parseFloat(entry.CrAmount) : null,
                TotalEmpAllocated: entry.TotalEmpAllocated !== "" ? parseFloat(entry.TotalEmpAllocated) : null,
                TotalCostAllocated: entry.TotalCostAllocated !== "" ? parseFloat(entry.TotalCostAllocated) : null,
                JournalChildNo: (entry.JournalChildNo !== "" && entry.JournalChildNo != null)
                    ? parseInt(entry.JournalChildNo)
                    : 0 // <-- this ensures you're never sending "" or null
            };
        });
        var totalDrAmount = 0;
        var totalCrAmount = 0;

        gridData.forEach(function (row) {
            if (row.DrCr === "Dr" && row.VoucherAmount && row.VoucherAmount > 0) {
                totalDrAmount += row.VoucherAmount;
            }
            if (row.DrCr === "Cr" && row.VoucherAmount && row.VoucherAmount > 0) {
                totalCrAmount += row.VoucherAmount;
            }
        });

        if (totalDrAmount !== totalCrAmount) {
            DevExpress.ui.notify("Voucher Entry is not tallying, please check the Debit / Credit Totals.", "error", 2000);
            return;
        }

        // Determine action and voucher number
        var action = "SaveVoucher";
        var finalVoucherNo = $("#VoucherNo").dxTextBox("instance").option("value") || "";

        var VM = {
            JournalVoucherMaster: {
                JournalRefNo: finalVoucherNo,
                JournalEntryDate: $("#VoucherDate").dxDateBox("instance").option("value"),
                JournalEffectiveDate: $("#EffectiveDate").dxDateBox("instance").option("value"),
                JournalVoucherNarration: ($("#VoucherNarration").dxTextArea("instance").option("value") || "").trim(),
                //BillRemarks: ($("#Remarks").dxTextBox("instance").option("value") || "").trim(),

                // IsSubmittedToFinance: $("#SubmittedBy").dxCheckBox("instance").option("value"),
                // SubmittedBy: ($("#SubmittedBytext").dxTextBox("instance").option("value") || "").trim(),
                // SubmittedOn: ($("#SubmittedOnDate").dxTextBox("instance").option("value") || null),

                // IsVerified: $("#VerifiedBy").dxCheckBox("instance").option("value"),
                // VerifiedBy: ($("#VerifiedBytext").dxTextBox("instance").option("value") || "").trim(),
                // VerifiedOn: ($("#VerifiedOnDate").dxTextBox("instance").option("value") || null),

                // IsApproved: $("#ApprovedBy").dxCheckBox("instance").option("value"),
                // ApprovedBy: ($("#ApprovedBytext").dxTextBox("instance").option("value") || "").trim(),
                // ApprovedOn: ($("#ApprovedOntext").dxTextBox("instance").option("value") || null),

                // PostedVoucherNo: ($("#PostedVoucherNo").dxTextBox("instance").option("value") || "").trim(),
                // PostedBy: ($("#PostedBy").dxTextBox("instance").option("value") || "").trim(),
                // PostedOn: ($("#PostedOnDate").dxTextBox("instance").option("value") || null),

                // JournalType: ($("#VoucherType").dxSelectBox("instance").option("value") || "").trim()
            },
            JournalVoucherEntries: gridData
        };

        button.option("disabled", true);

        $.ajax({
            type: "POST",
            url: `/api/JournalEntryEdit/${action}`,
            contentType: "application/json",
            data: JSON.stringify(VM),
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    let msg = action === "SaveVoucher"
                        ? "Journal entry saved successfully!"
                        : "Journal entry updated successfully!";
                    DevExpress.ui.notify(msg, "success", 2000);

                    setTimeout(function () {
                        window.history.back(); // Navigate to the previous page
                    }, 2000);
                } else {
                    DevExpress.ui.notify("Update failed: " + response.message, "error", 2000);
                }
            },
            error: function (xhr, status, error) {
                let errMsg = xhr.responseText || "An error occurred while saving the journal entry.";
                DevExpress.ui.notify(errMsg, "error", 3000);
            },
            complete: function () {
                button.option("disabled", false);
            }
        });
    }


    $(document).ready(function () {
        let dataGrid = $("#dataGrid").dxDataGrid("instance");

        dataGrid.option("onContextMenuPreparing", function (e) {
            if (e.row && e.row.rowType === "data") {
                e.event.preventDefault();

                // Get selected row data
                let rowData = e.row.data;
                let selectedAccountHead = rowData.AccountHead;
                let selectedAccountId = rowData.AccountId;
                let selectedDrCr = rowData.DrCr;
                let selectedAmount = selectedDrCr === "Dr" ? rowData.DrAmount : rowData.CrAmount;
                selectedAmount = parseFloat(selectedAmount).toFixed(2); // Ensuring numeric format
                var effectiveDate = $("#EffectiveDate").dxDateBox("instance").option("value");
                if (effectiveDate) {
                    var formattedDate = new Date(effectiveDate).toLocaleDateString("en-GB", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    }).replace(",", ""); // Remove comma if present


                } // Fetch from input field
                let voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
                // Define context menu options
                let menuItems = [
                    {
                        text: "Cost Allocation",
                        onItemClick: function () {
                            openModalPopup(`/${tenantName}/Finance/JournalEntryCostAllocation?DrCr=${selectedDrCr}&Amount=${selectedAmount}&AccountId=${selectedAccountId}&AccountHead=${selectedAccountHead}&EffectiveDate=${effectiveDate}&VoucherNo=${voucherNo}`);
                        }
                    },
                    {
                        text: "Property Allocation",
                        onItemClick: function () {
                            openModalPopup(`/${tenantName}/Finance/JournalEntryPropertyAllocation?DrCr=${selectedDrCr}&Amount=${selectedAmount}&AccountId=${selectedAccountId}&AccountHead=${selectedAccountHead}&EffectiveDate=${effectiveDate}&VoucherNo=${voucherNo}`);
                        }
                    },
                    {
                        text: "Employee Allocation",
                        onItemClick: function () {
                            openModalPopup(`/${tenantName}/Finance/JournalEntryEmployeeAllocation?DrCr=${selectedDrCr}&Amount=${selectedAmount}&AccountId=${selectedAccountId}&AccountHead=${selectedAccountHead}&EffectiveDate=${effectiveDate}&VoucherNo=${voucherNo}`);
                        }
                    }
                ];
                debugger;
                // Create context menu and attach it to the clicked cell
                let contextMenu = $("<div>").appendTo("body").dxContextMenu({
                    dataSource: menuItems,
                    target: e.cellElement,
                    showEvent: "dxcontextmenu",
                    onItemClick: function (itemData) {
                        itemData.itemData.onItemClick();
                    },
                    onHidden: function () {
                        if (contextMenu) {
                            contextMenu.dispose();  // Properly dispose of the instance
                            // contextMenuElement.remove();  // Remove the element from the DOM
                        }
                    }
                }).dxContextMenu("instance");

                contextMenu.show();
            }
        });
    });

    // Function to open modal and load the URL with passed data
    function openModalPopup(url) {
        let modalHtml = `
                         <div class="modal fade custom-modal" id="contextModal" tabindex="-1" aria-labelledby="contextModalLabel" aria-hidden="true">
                             <div class="modal-dialog modal-fullscreen">
                                 <div class="modal-content">
                                     <div class="modal-header">
                                         <h5 class="modal-title" id="contextModalLabel">Allocation Details</h5>
                                         <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                     </div>
                                     <div class="modal-body">
                                         <iframe src="${url}" width="100%" height="100%" frameborder="0"></iframe>
                                     </div>
                                 </div>
                             </div>
                         </div>
                     `;

        // Remove existing modal if it exists
        $("#contextModal").remove();

        // Append modal to body and show it
        $("body").append(modalHtml);
        $("#contextModal").modal("show");
    }

    function getUrlParameter(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        let regex = new RegExp("[\\?&]" + name + "=([^&#]*)");
        let results = regex.exec(location.search);
        return results === null ? null : decodeURIComponent(results[1].replace(/\+/g, " "));
    }
    let journalRefNo = null;
    $(document).ready(function () {
        journalRefNo = getUrlParameter('journalRefNo');
        var button = $("#btnSave").dxButton("instance");
        if (journalRefNo) {
            button.option("text", "Update");
        }

        if (journalRefNo) {
            $.ajax({
                url: '/api/JournalRegister/GetJournalChild',
                type: 'GET',
                data: { journalRefNo: journalRefNo },
                success: function (data) {
                    const entry = data.find(d => d.JournalRefNo === journalRefNo); // optional check

                    if (entry) {
                        $("#VoucherNo").dxTextBox("instance").option("value", entry.JournalRefNo);
                        $("#VoucherDate").dxDateBox("instance").option("value", entry.VoucherDate);
                        $("#EffectiveDate").dxDateBox("instance").option("value", entry.EffectiveDate);
                        $("#VoucherNarration").dxTextArea("instance").option("value", entry.VoucherNarration);
                        $("#ClaimNameDropdown").dxDropDownBox("instance").option("value", entry.ClaimName);

                        const gridInstance = $("#dataGrid").dxDataGrid("instance");
                        gridInstance.option("dataSource", data);
                    } else {
                        DevExpress.ui.notify("No entry found with the given reference number.", "warning", 3000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Failed to load journal entry from URL.", "error", 3000);
                }
            });
        } else {
            // DevExpress.ui.notify("Journal Reference Number is missing in the URL.", "error", 3000);
        }
    });

    function onApproveButtonClick() {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowCount = dataGrid.getVisibleRows().length;

        if (rowCount == 0) {
            Swal.fire({
                title: "Voucher is not Approved",
                text: "Voucher has not been Approved, Click Yes if you want to Verify and Approve this Voucher.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes",
                cancelButtonText: "No"
            })
        } else {
            proceedWithApproval();
        }
    }

    function proceedWithApproval() {
        $("#ApprovedBy").dxCheckBox("instance").option("value", true);
        var vno = $("#VoucherNo").dxTextBox("instance").option("value");

        const currentDate = new Date();
        const formattedDate = currentDate.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }).replace(/ /g, '-');

        $.ajax({
            success: function () {
                Swal.fire({
                    title: "Success!",
                    text: "Voucher has been Approved.",
                    icon: "success",
                    confirmButtonText: "OK"
                }).then(() => {
                    disableEditing();
                    $("#ApprovedBytext").dxTextBox("instance").option("value", "Admin");
                    $("#ApprovedOntext").dxTextBox("instance").option("value", formattedDate);
                });
            },
            error: function () {
                Swal.fire({
                    title: "Error",
                    text: "Please save the transactions after proceeding!",
                    icon: "error",
                    confirmButtonText: "OK"
                });
            }
        });
    }



    $("#btnDelete").on("click", function (e) {
        e.preventDefault();
        onDeleteButtonClick();
    });
    function onDeleteButtonClick(e) {
        var journalRefNo = $("#VoucherNo").dxTextBox("instance").option("value");

        if (!journalRefNo) {
            DevExpress.ui.notify("Please enter or select a Journal Entry to delete.", "warning", 3000);
            return;
        }

        $.ajax({
            url: "/api/JournalEntryEdit/DeleteJournalEntry",
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(journalRefNo), // 👈 plain string
            success: function (response) {
                DevExpress.ui.notify(response.message, 'success', 3000);
                setTimeout(function () {
                    location.reload();
                }, 1000);
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                DevExpress.ui.notify(msg, 'error', 3000);
            }
        });
    }


    function onAccountHeadRowPrepared(e) {
        if (e.rowType === "data" && e.data.IsLedgerObselete) {
            e.rowElement.css("background-color", "rgb(255, 192, 192)"); // Light Red Color
        }
    }


    function gridLedger_valueChanged(e) {
        var $dataGrid = $("#dataGrid");

        if ($dataGrid.length) {
            var dataGrid = $dataGrid.dxDataGrid("instance");
            dataGrid.selectRows(e.value, false);
        }

        if (e.value) {
            let grid = $("#dataGrid").dxDataGrid("instance");
            let rowIndex = e.element.closest("tr").index();
            let rowData = grid.getVisibleRows()[rowIndex].data;

            let costAllocationDropdownGrid = $("#accountDropDownBoxeditGrid").dxDataGrid("instance");
            let selectedRowData = costAllocationDropdownGrid.getSelectedRowsData()[0];

            if (selectedRowData) {
                rowData.AccountId = selectedRowData.AccountId;
                rowData.AccountHead = selectedRowData.AccountHead; // Update AccountHead
                grid.cellValue(rowIndex, "AccountId", selectedRowData.AccountId);
                grid.cellValue(rowIndex, "AccountHead", selectedRowData.AccountHead); // Reflect change
            }
        }

        e.component.option("opened", false);
    }

    function onLedgerRowUpdating(e) {
        const drCr = e.newData.DrCr || e.oldData.DrCr;
        if (drCr === "Dr") {
            if ("CrAmount" in e.newData) {
                
                DevExpress.ui.dialog.alert(
                    "Selected Entry has to be Dedit Amount,Please Check the Dr/Cr and try again.!",
                    "Debit/Credit Entry not Matching"
                );
                delete e.newData.CrAmount; // prevent CrAmount from updating
            }
        }

        // If DrCr is "Cr", allow only CrAmount to update
        if (drCr === "Cr") {
            if ("DrAmount" in e.newData) {
                
                DevExpress.ui.dialog.alert(
                    "Selected Entry has to be Credit Amount,Please Check the Dr/Cr and try again.!",
                    "Debit/Credit Entry not Matching"
                );
                delete e.newData.DrAmount; // prevent DrAmount from updating
            }
        }
        // Clear the opposite field when DrCr is changed
        if (e.newData.DrCr === "Dr") {
            e.newData.CrAmount = 0.00;
            e.newData.DrAmount = e.oldData.CrAmount;
        } else if (e.newData.DrCr === "Cr") {
            e.newData.DrAmount = 0.00;
            e.newData.CrAmount = e.oldData.DrAmount;
        }
    }

</script>
