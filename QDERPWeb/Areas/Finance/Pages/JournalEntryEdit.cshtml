    $("#btnDelete").on("click", function (e) {
        e.preventDefault();
        let journalRefNo = $("#VoucherNo").dxTextBox("instance").option("value");

        if (journalRefNo && journalRefNo.toString().trim() !== "") {
            // Now call backend to get IsSubmitted, IsApproved, IsPosted
            $.ajax({
                type: "GET",
                url: "/api/JournalRegister/GetJournalStatus", // Adjust the URL to your controller and action
                contentType: "application/json",

                data: { journalRefNo: journalRefNo },
                success: function (response) {
                    if (response) {
                        let { isSubmitted, isApproved, isPosted } = response;

                        if (isSubmitted) {
                            DevExpress.ui.dialog.alert("Journal Entry is already Submitted,You cannot delete the Submitted JV.", "JV is submitted already");
                        }
                        else if (!isSubmitted && isApproved || isPosted) {
                            DevExpress.ui.dialog.alert("Journal Entry is already Approved,You cannot delete the Approved JV.", "JV is Approved already");
                        }
                        else if (isSubmitted && isApproved && isPosted) {
                            DevExpress.ui.dialog.alert("Journal Entry is already Paid,<br/>You cannot delete the Posted JV.", "Warning");
                        }
                        else if (!isSubmitted && !isApproved && !isPosted) {
                            let result = DevExpress.ui.dialog.confirm(
                                "You are about to delete the Journal Entry from the Register,<br/>Click Yes if you would like to continue.",
                                "Confirm Deletion"
                            );
                            result.done(function (dialogResult) {
                                if (dialogResult) {

                                    // User clicked Yes, so proceed to delete
                                    $.ajax({
                                        type: "POST",
                                        url: `/api/JournalRegister/DeleteJournalEntry?journalRefNo=${encodeURIComponent(journalRefNo)}`,
                                        contentType: "application/json",


                                        success: function (deleteResponse) {
                                            if (deleteResponse.success) {
                                                DevExpress.ui.dialog.alert("Journal Entry sucesfully removed from the database", "Success")
                                                    .done(function () {
                                                        sessionStorage.setItem("refreshPage", "true");
                                                        history.back();
                                                    });


                                            } else {
                                                DevExpress.ui.notify("Failed to delete Journal Entry.", "error", 2000);
                                            }
                                        },
                                        error: function () {
                                            DevExpress.ui.notify("Error occurred during deletion.", "error", 2000);
                                        }
                                    });
                                }
                            });
                        }
                    } else {
                        DevExpress.ui.notify("Failed to fetch journal status.", "error", 2000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Error fetching journal status.", "error", 2000);
                }
            });

        } else {
            DevExpress.ui.dialog.alert("Journal Reference Number is missing.", "Error");
        }
    });



