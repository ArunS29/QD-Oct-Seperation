    async function onPostJournalClick() {
        const approve = await $("#ApprovedBytext").dxTextBox("instance").option("value");
        if (!approve) {
            DevExpress.ui.dialog.alert(
                "This Journal Entry is not yet Approved,Please get it approved<br>and continue for Payment",
                "Journal Entry Not Approved"
            );
            return;
        }
    const result = await DevExpress.ui.dialog.confirm(
        "You are about to Create Voucher,<br>Click yes if you would like to continue.",
        "Confirmation"
    );

    if (!result) return;

    const username = '@HttpContext.Session.GetString("UserName")';
    const now = new Date();
    // Format to dd-MMM-yyyy
                            const formattedDate = now.toLocaleDateString('en-GB', {
                                day: '2-digit',
                                month: 'short',
                                year: 'numeric'
                            }).replace(/ /g, '-');
    const voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

    // Step 1: Get new voucher number
    const voucherResponse = await $.get('/api/JournalEntryEdit/GetGeneratedVoucherNo');

    if (!voucherResponse || (!voucherResponse.success && voucherResponse.error)) {
        DevExpress.ui.notify("Error fetching new voucher number: " + (voucherResponse.error || ""), "error", 3000);
        return;
    }

    const newVoucherNo = typeof voucherResponse === "string" ? voucherResponse : voucherResponse.result;
    $("#journalvoucher").dxTextBox("instance").option("value", newVoucherNo);

    // Step 2: Mark journal as posted with newVoucherNo
    const postResponse = await $.ajax({
        url: `/api/JournalEntryEdit/PostJournal`,
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            voucherNo: voucherNo,
            newVoucherNo: newVoucherNo
        })
    });

    if (!postResponse.success) {
        DevExpress.ui.notify("Failed to post journal: " + postResponse.message, "error", 3000);
        return;
    }

    // Update UI
    $("#PostedBy").dxCheckBox("instance").option("value", true);
    $("#PostedBytext").dxTextBox("instance").option("value", username);
    $("#PostedOnDate").dxTextBox("instance").option("value", formattedDate);

    // Step 3: Call stored procedure to insert voucher
    const spResponse = await $.ajax({
        url: '/api/JournalEntryEdit/InsertVoucherFromJournal',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            journalRefNo: voucherNo,
            postingVoucherNo: newVoucherNo,
            addedBy: username,
            addedOn: now
        })
    });

    if (spResponse.success) {
        DevExpress.ui.dialog.alert("Journal Entry added to the database.", "Successful");
    } else {
        DevExpress.ui.notify("Failed to create voucher: " + spResponse.message, "error", 3000);
    }
}

