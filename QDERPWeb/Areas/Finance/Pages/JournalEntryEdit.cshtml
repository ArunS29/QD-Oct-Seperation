    function openModalPopup(url) {
        let modalHtml = `
                             <div class="modal fade custom-modal" id="contextModal" tabindex="-1" aria-labelledby="contextModalLabel" aria-hidden="true">
                                 <div class="modal-dialog modal-fullscreen">
                                     <div class="modal-content">
