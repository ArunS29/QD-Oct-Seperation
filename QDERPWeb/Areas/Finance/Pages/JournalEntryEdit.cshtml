    const popupInstances = {}; // Global object to store popups by voucherEntryNo

    function openAllocationPopup(allocationType, params) {
        const queryString = Object.keys(params)
            .map(key => `${key}=${encodeURIComponent(params[key])}`)
            .join('&');

        const voucherEntryNo = params.VoucherEntryNo; // ensure this is passed in params
        const popupContentId = `popupContent_${voucherEntryNo}`; // Use stable ID

        let title = "";
        let url = "";

        switch (allocationType) {
            case "Cost":
                title = "Cost Allocation";
                url = `/api/JournalEntryEdit/CostAllocation?${queryString}`;
                break;
            case "Property":
                title = "Property Allocation";
                url = `/api/JournalEntryEdit/PropertyAllocation?${queryString}`;
                break;
            case "Employee":
                title = "Employee Allocation";
                url = `/api/JournalEntryEdit/EmployeeAllocation?${queryString}`;
                break;
            default:
                console.error("Unknown allocation type");
                return;
        }

        const $popupDiv = $("<div>")
            .appendTo("body")
            .attr("id", popupContentId);

        const popup = $popupDiv.dxPopup({
            title: title,
            width: "80%",
            height: "80%",
            contentTemplate: function (contentElement) {
                $.ajax({
                    url: url,
                    type: "GET",
                    dataType: "html",
                    success: function (data) {
                        contentElement.append(data);
                    },
                    error: function (xhr, status, error) {
                        contentElement.append(`<div style="color:red;">Error loading popup: ${error}</div>`);
                    }
                });
            },
            showCloseButton: true,
            showTitle: true,
            visible: true,
            dragEnabled: true,
            closeOnOutsideClick: true,
            onHidden: function () {
                $popupDiv.remove();
                delete popupInstances[voucherEntryNo]; // Clean up
            }
        }).dxPopup("instance");

        // Store the popup instance globally
        popupInstances[voucherEntryNo] = popup;
    }
