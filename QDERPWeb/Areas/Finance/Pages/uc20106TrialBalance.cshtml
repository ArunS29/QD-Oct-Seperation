    }
        $(document).ready(function () {
        // Load all records on page load (ignore default date values)
            initializePivotGrid([]);
        });

    function loadAllRecords() {
        console.log("Loading records for the current month...");

        // Get the first and last day of the current month
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        let lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        $.ajax({
            url: '/api/TrialBalance/GetTrialBalances',
            type: 'GET',
            data: {
                startDate: firstDay.toISOString().split('T')[0],
                endDate: lastDay.toISOString().split('T')[0]
            },
            success: function (data) {
                initializePivotGrid(data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching records for the current month: ", error);
            }
        });
    }
    function ddBtnShowRecords_click(option) {
        var startDate, endDate;

        // Get today's date
        let today = new Date();
        let firstDay, lastDay;

        switch (option) {
            case 'today':
                startDate = today;
                endDate = today;
                break;
            case 'yesterday':
                startDate = new Date();
                startDate.setDate(today.getDate() - 1);
                endDate = startDate;
                break;
            case 'week':
                startDate = new Date();
                startDate.setDate(today.getDate() - today.getDay()); // Start of the week (Sunday)
                endDate = today;
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1); // Start of the month
                endDate = today;
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1); // Start of the month
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0); // End of the month
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1); // Start of the year
                endDate = today;
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1); // Start of the year
                endDate = new Date(today.getFullYear(), 11, 31); // End of the year
                break;
            case 'lastmonth':
                firstDay = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                lastDay = new Date(today.getFullYear(), today.getMonth(), 0);
                startDate = firstDay;
                endDate = lastDay;
                break;
            case 'lastyear':
                firstDay = new Date(today.getFullYear() - 1, 0, 1);
                lastDay = new Date(today.getFullYear() - 1, 11, 31);
                startDate = firstDay;
                endDate = lastDay;
                break;
            default:
                // Use date from DateBoxes for 'range' option
                startDate = $("#frmdateBox").dxDateBox("instance").option("value");
                endDate = $("#todateBox").dxDateBox("instance").option("value");
                break;
        }

        // Update the DateBox values dynamically
        $("#frmdateBox").dxDateBox("instance").option("value", startDate);
        $("#todateBox").dxDateBox("instance").option("value", endDate);

        // Get the selected AccountGroup
        var getaccountGroup = $("#requestedBy").dxSelectBox("instance").option("value");
        var accountGroup = getaccountGroup ? getaccountGroup.AccountGroup : null;

        console.log("Fetching records with:", {
            startDate: startDate ? startDate.toISOString().split('T')[0] : "All Dates",
            endDate: endDate ? endDate.toISOString().split('T')[0] : "All Dates",
            accountGroup: accountGroup || "All Account Groups"
        });
        var loadPanel = $("#loadPanel").dxLoadPanel("instance");
        loadPanel.show();
        $.ajax({
            url: '/api/TrialBalance/GetTrialBalances',
            type: 'GET',
            data: {
                startDate: startDate ? startDate.toISOString().split('T')[0] : null,
                endDate: endDate ? endDate.toISOString().split('T')[0] : null,
                accountGroup: accountGroup  // If null, fetch all account groups
            },
            success: function (data) {
                initializePivotGrid(data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching filtered records: ", error);
            },
            complete: function () {
                $("#loadPanel").dxLoadPanel("instance").hide(); // ✅ Always hide the loader
            }
        });
    }
     function initializePivotGrid(data) {
        var pivotGrid = $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                store: {
                    type: "array",
                    data: data
                },
                fields: [
                    { dataField: "MasterGroup", area: "row", caption: "Master Group" },
                    { dataField: "LedgerNo", area: "row", caption: "Ledger No" },
                    { dataField: "DrCr", area: "column", caption: "Dr Cr" },
                    { dataField: "VoucherType", area: "column", caption: "Voucher Type" },
                    { dataField: "DrAmount", area: "data", caption: "Debit Amount", summaryType: "sum" },
                    { dataField: "CrAmount", area: "data", caption: "Credit Amount", summaryType: "sum" },
                    { dataField: "VoucherAmountFormatted", area: "data", caption: "Voucher Amount", summaryType: "sum" },
                    { dataField: "OpeningBalance", area: "data", caption: "Opening Balance", summaryType: "sum" }
                ]
            },
            width: "100%",
            height: "100%",
            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            rowHeaderLayout: "standard",
            wordWrapEnabled: true,

            fieldChooser: {
                enabled: true,
                allowSearch: true
            },
            scrolling: {
                mode: "virtual"
            },
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showRowFields: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true
            },
            showColumnTotals: true,
            showColumnGrandTotals: true,
            showDataHeaders: true,
            showRowTotals: false,
            showRowGrandTotals: true
        }).dxPivotGrid("instance");

        // ✅ Chart Setup (non-intrusive)
        var chart = $("#pivotChartContainer").dxChart({
            commonSeriesSettings: {
                type: "bar"
            },
            tooltip: {
                enabled: true
            },
            legend: {
                visible: true
            },
            export: {
                enabled: true
            }
        }).dxChart("instance");

        // ✅ Bind Chart to PivotGrid
        pivotGrid.bindChart(chart, {
            dataFieldsDisplayMode: "splitPanes", // also try: "singleAxis"
            alternateDataFields: false
        });

        // ✅ Expand rows (your logic preserved)
        setTimeout(function () {
            var dataSource = pivotGrid.getDataSource();
            var accountGroups = dataSource.getData().rows;
            accountGroups.forEach(function (group) {
                if (group.text) {
                    dataSource.expandHeaderItem("row", [group.text]);
                }
            });
        }, 100);

        // ✅ Adjust height on resize
        $(window).resize(function () {
            var height = $(window).height() - 50;
            pivotGrid.option("height", height);
            chart.option("height", height);
        });

        // ✅ Custom styles
        $(".dx-pivotgrid-container").css({
            "font-size": "14px",
            "border-radius": "8px"
        });

        $(".dx-pivotgrid-row, .dx-pivotgrid-column").css({
            "padding": "10px",
            "border-bottom": "1px solid #ddd"
        });

        $(".dx-pivotgrid-cell").hover(function () {
            $(this).css("background-color", "#f5f5f5");
        }, function () {
            $(this).css("background-color", "");
        });
    }



    $("#btnShowRowTotals").on("click", function (e) {
        e.preventDefault();

        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");

        if (pivotGrid) {
            const currentSetting = pivotGrid.option("showRowTotals");
            pivotGrid.option("showRowTotals", !currentSetting);
        }
    });

    $("#btnShowFields").on("click", function (e) {
        e.preventDefault();

        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");

        if (!pivotGrid) return;

        const dataSource = pivotGrid.getDataSource();
        const currentFields = dataSource.fields();

        const allFields = [

            { dataField: "AccountGroup", caption: "Account Group" },

            { dataField: "Category",  caption: "Category" },
            { dataField: "VoucherNo",  caption: "Voucher No" },
            { dataField: "VoucherDate",  caption: "Voucher Date", dataType: "date", format: "shortDate" },
            { dataField: "VoucherEntryNo",  caption: "Voucher Entry No" },

            { dataField: "VoucherNarration",  caption: "Voucher Narration" },
            { dataField: "EntryNarration", caption: "Entry Narration" },
            { dataField: "SysRemarks", caption: "System Remarks" },
            { dataField: "VoucherRefNo",  caption: "Voucher Ref No" },
            { dataField: "Transactions",  caption: "Transactions" },

            { dataField: "MonthYear",  caption: "Month Year" },
            { dataField: "MonthNumber", caption: "Month Number" }
        ];

        // Check if all fields are already in the "filter" area
        const allInFilter = allFields.every(f =>
            currentFields.find(c => c.dataField === f.dataField && c.area === "filter")
        );

        const updatedFields = currentFields.map(field => {
            const isTargetField = allFields.find(f => f.dataField === field.dataField);
            if (isTargetField) {
                return {
                    ...field,
                    area: allInFilter ? null : "filter"
                };
            }
            return field;
        });

        dataSource.fields(updatedFields);
        dataSource.load();


    });
     

    $("#toggleChartBtn").on("click", function () {
    const chartContainer = $("#pivotChartContainer");
    if (chartContainer.is(":visible")) {
        chartContainer.hide();
        $(this).text("Show Chart");
    } else {
        chartContainer.show();
        $(this).text("Hide Chart");
    }

    // Resize grid
    const newHeight = chartContainer.is(":visible") ? "calc(100vh - 460px)" : "calc(100vh - 160px)";
    $("#pivotGridContainer").css("height", newHeight);
});

</script>

