@page
@using DevExtreme.AspNet.Mvc
@{
    ViewData["Title"] = "Trial Balance";
}
<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-3d@1.0.0/dist/chartjs-plugin-3d.min.js"></script>


<style>
    .limited-footer .btn-container {
        display: none !important;
    }


    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .container {
        display: flex;
        /* flex-direction: column; */
        height: 100vh; /* Fill full screen height */
        /* width: 100%; */
        overflow: hidden;
    }

    .horizontal-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        padding: 10px 15px;
    }

    #pivotGridContainer {
        flex: 1; /* Let PivotGrid grow to fill remaining space */
        overflow: auto;
    }

    .dx-field {
        min-width: 200px;
        flex: 1;
    }

    /* Optional tweak for small screens */
    @@media (max-width: 768px) {
        .horizontal-container

    {
        flex-direction: column;
    }

    .dx-field {
        width: 100%;
    }

    }

   
</style>



<div class="container-fluid d-flex flex-column vh-100 px-3 py-2">

    <!-- Optional: Load Panel -->
    <div id="loadPanel"></div>

    <!-- Filter Row: Fullscreen Top Section -->
    <div class="row g-3 align-items-end mb-2">

        <!-- SelectBox -->
        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
            @(
                Html.DevExtreme().SelectBox()
                    .ID("requestedBy")
                    .DataSource(d => d.Mvc().Controller("TrialBalance").LoadAction("GetUser").LoadMode(DataSourceLoadMode.Raw))
                    .Width("100%")
                    .ElementAttr("class", "w-100")
                    .Label("Select Cost Allocation Group")
                    .LabelMode(EditorLabelMode.Floating)
                    .SearchEnabled(true)
                    .DisplayExpr("AccountGroup")
                    .Value(null)
                    .ShowClearButton(true)
                    .OnValueChanged("onRequestedByChanged")
            )
        </div>

        <!-- Start Date -->
        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6">
            @(Html.DevExtreme().DateBox()
                .ID("frmdateBox")
                .Label("Start Date")
                .LabelMode(EditorLabelMode.Floating)
                .Type(DateBoxType.Date)
                .Value(DateTime.Now.Date.AddDays(1 - DateTime.Now.Day))
                .DisplayFormat("dd-MMM-yyyy"))
        </div>

        <!-- End Date -->
        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6">
            @(Html.DevExtreme().DateBox()
                .ID("todateBox")
                .Label("End Date")
                .LabelMode(EditorLabelMode.Floating)
                .Type(DateBoxType.Date)
                .Value(DateTime.Now.Date)
                .DisplayFormat("dd-MMM-yyyy"))
        </div>

        <!-- Dropdown Button -->
        <div class="col-xl-4 col-lg-4 col-md-8 col-sm-12">
            @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnShowRecords")
                .Text("Show Records")
                .Icon("smalliconslayout")
                @* .SplitButton(true) *@
                .OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }")
                .DropDownOptions(options => options.Width(230))
                .Items(items => {
                    items.Add().Text("Show Records").Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                    items.Add().Text("This Year Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                    items.Add().Text("This Month Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                    items.Add().Text("Last Year").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                    items.Add().Text("Last Month").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                    items.Add().Text("This Week").Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                }))
        </div>

        <!-- Effective Date & Toggle Chart (Grouped) -->
        <div class="col-xl-2 col-lg-3 col-md-6 col-sm-12 d-flex gap-2 align-items-center">
            @(
                Html.DevExtreme().CheckBox()
                    .ID("useEffectiveDate")
                    .Text("Use Effective Date")
                    .Value(true)
            )
            <button id="toggleChartBtn" class="btn btn-primary">Hide Chart</button>
        </div>
    </div>

    <!-- Scrollable Chart + Grid Area -->
    <div class="flex-grow-1 overflow-auto">
        <!-- Chart Container -->
        <div id="pivotChartContainer" style="height: 300px;"></div>

        <!-- Pivot Grid Container -->
        <div id="pivotGridContainer" style="height: calc(100vh - 420px);"></div>
    </div>

    <!-- Optional Fullscreen Chart Modal -->
    <div class="modal fade" id="chartModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pivot Chart</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="modalChartContainer" style="height: 600px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
    <!-- Header -->
    <div class="footer-fixed">
        @await Html.PartialAsync("UCTRIALBALANCEFOOTER")
    </div>





<script type="text/javascript">
