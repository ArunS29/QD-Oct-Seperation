#deep-hole-overlay {
  position: fixed;
  inset: 0;
  background: radial-gradient(circle, #000 0%, #111 50%, #000 100%);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: tunnelZoom 2.5s forwards;
}

.deep-hole-overlay .spiral {
  width: 200px;
  height: 200px;
  border: 8px solid #0ff;
  border-radius: 50%;
  border-top: 8px solid transparent;
  border-bottom: 8px solid transparent;
  animation: spinSpiral 1s linear infinite;
}

@@keyframes spinSpiral {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@@keyframes tunnelZoom {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(15);
    opacity: 0;
  }
}



