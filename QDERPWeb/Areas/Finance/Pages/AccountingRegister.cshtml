		function navigateToVoucherPage(voucherNo, voucherType) {
		console.log("Original VoucherNo:", voucherNo, "VoucherType:", voucherType); // Debugging

		if (!voucherNo || !voucherType) {
			alert("Invalid voucher details.");
			return;
		}

		let formattedVoucher = voucherNo.trim().toUpperCase(); // Convert to uppercase for consistency
		let formattedVoucherType = voucherType.trim(); // Trim to avoid leading/trailing spaces

		console.log("Formatted VoucherNo:", formattedVoucher, "Formatted VoucherType:", formattedVoucherType); // Debugging

		// Define voucher type-based URLs
		const voucherRoutes = {
			"Bank Payment": `/${tenantName}/finance/VoucherBankPayment`,
			"Cash Payment": `/${tenantName}/finance/VoucherCashPayment`,
			"Bank Receipts": `/${tenantName}/finance/VoucherEntryReceipts`,
			"Cash Receipts": `/${tenantName}/finance/VoucherEntryCashReceipts`,
			"Sales": `/${tenantName}/finance/SalesVoucher`,
			"Purchases": `/${tenantName}/finance/PurchaseVoucher`,
			"Journal": `/${tenantName}/finance/Voucherjournal`
		};

		let baseUrl = voucherRoutes[formattedVoucherType];

		if (baseUrl) {
			// Append both VoucherNo and VoucherType as query parameters
			let targetUrl = `${baseUrl}?argsledno=${encodeURIComponent(formattedVoucher)}&vouchertype=${encodeURIComponent(formattedVoucherType)}`;
			console.log("Navigating to:", targetUrl); // Debugging
			window.location.href = targetUrl; // Navigate
		} else {
			alert("Unknown voucher type: " + voucherType);
		}
	}


