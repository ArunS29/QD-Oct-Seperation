						columns.AddFor(m => m.VoucherAmountFormatted).Caption(new JS("formatMessage('VoucherAmountFormatted')")).Alignment(HorizontalAlignment.Right).Visible(false);
						columns.AddFor(m => m.VoucherApprovedBy).Caption(new JS("formatMessage('VoucherApprovedBy')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherApprovedOn).Caption(new JS("formatMessage('VoucherApprovedOn')")).Alignment(HorizontalAlignment.Left).Visible(false);
						columns.AddFor(m => m.VoucherEnteredBy).Caption(new JS("formatMessage('VoucherEnteredBy')")).Alignment(HorizontalAlignment.Left).Visible(false);
