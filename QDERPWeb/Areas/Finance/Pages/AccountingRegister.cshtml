			 // This function used to call API to get records for the selected values.
			 function ddBtnShowRecords_click(duration) {
			 var selectBox = $("#voucherTypeSelect").dxSelectBox("instance");
			 var selectedValue = selectBox.option("value");
			 var VoucherType = selectedValue ? selectedValue : null;
			 // if (VoucherId === null) {
			 //     alert("Please select a register.");
			 //     return;
			 // }
				 var frmDateBox = $("#frmdateBox").dxDateBox("instance");
				 var toDateBox = $("#todateBox").dxDateBox("instance");
				 var frmDate = new Date(frmDateBox.option("value"));
				 var toDate = new Date(toDateBox.option("value"));
				 var currentDate = new Date();
				 switch (duration) {
					 case 'today':
						 frmDate = toDate = currentDate;
						 break;
					 case 'yesterday':
						 var dateObj = new Date();
						 // Subtract one day from current time
						 dateObj.setDate(dateObj.getDate() - 1);
						 frmDate = toDate = dateObj;
						 break;
					 case 'week':
						 var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

						 // Calculate the start of the week (Saturday)
						 var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

						 // Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
					 frmDate = new Date(currentDate.setDate(startOfWeek)); // 7 days before Saturday
						 toDate = new Date(currentDate.setDate(startOfWeek + 6));
						 break;
					 case 'tillmonth':
						 // Get the first and last day of the current month
						 frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
						 toDate = currentDate; //Today
						 break;
					 case 'fullmonth':
						 // Get the first and last day of the current month
						 frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
						 toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
						 break;
					 case 'tillyear':
						 // Get the first and last day of the current year
						 frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
						 toDate = currentDate;// Today
						 break;
					 case 'fullyear':
						 // Get the first and last day of the current year
						 frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
						 toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
						 break;
					 case 'lastyear':
						 // Get the first and last day of the last year
						 frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
						 toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
						 break;
					 case 'lastmonth':
						 // Get the first and last day of the current month
						 frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
						 toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
						 break;
				 }
				 frmDate = frmDate.toLocaleDateString('en-US', {
					 year: 'numeric',
					 month: '2-digit',
					 day: '2-digit'
				 });
				 toDate = toDate.toLocaleDateString('en-US', {
					 year: 'numeric',
					 month: '2-digit',
					 day: '2-digit'
				 });
				 frmDateBox.option("value", frmDate);  // Set frmDateBox value
				 toDateBox.option("value", toDate);    // Set toDateBox value
				 $.ajax({
				 url: '/api/AccountingRegister/GetVouchers',  // API endpoint
					 type: 'GET',
					 data: {
					 voucherType: VoucherType,
						 frmDate: frmDate,
						 toDate: toDate
					 },
					 success: function (data) {
						 // Bind the data to the DataGrid
						 $("#dataGrid").dxDataGrid("instance").option("dataSource", data);
						 // DevExpress.ui.notify("Data fetched successfully", "success", 2000);
					 },
					 error: function () {
						 DevExpress.ui.notify("Error while loading data", "error", 2000);
					 }
				 });
			 }
			 // Function to format date in required format
			 function formatDate(date) {
				 var d = new Date(date),
					 month = '' + (d.getMonth() + 1),
					 day = '' + d.getDate(),
					 year = d.getFullYear();

				 var strmonth = d.toLocaleString('default', { month: 'short' });
				 if (day.length < 2)
					 day = '0' + day;

				 return [day, strmonth, year].join('-');
			 }
		 function loadAllVouchers() {
			 $.ajax({
				 url: "/api/AccountingRegister/GetVouchers",
				 type: "GET",
				 data: { voucherType: "", frmDate: "", toDate: "" }, // Empty values to fetch all records
				 dataType: "json",
				 success: function (data) {
					 console.log("API Response:", data); // Check the response in console

					 if (!data || data.length === 0) {
						 DevExpress.ui.notify("No records found", "warning", 2000);
					 return;
				 }

					 var dataGrid = $("#dataGrid").dxDataGrid("instance");

					 if (dataGrid) {
						 dataGrid.option("dataSource", data);
						 DevExpress.ui.notify("Data loaded successfully", "success", 2000);
					 } else {
						 console.error("DataGrid instance not found!");
					 }
				 },
				 error: function (xhr, status, error) {
					 console.error("Error fetching data:", xhr.responseText);
					 DevExpress.ui.notify("Error while loading data", "error", 2000);
					 }
				 });
			 }
		function navigateToVoucherPage(voucherNo) {
		console.log("Original VoucherNo:", voucherNo); // Debugging

		if (!voucherNo) {
			alert("Invalid voucher number.");
			return;
		}

		let formattedVoucher = voucherNo.trim().toUpperCase(); // Convert to uppercase for consistency

		console.log("Formatted VoucherNo:", formattedVoucher); // Debugging

		// Define base URLs (Fix: Avoid embedding formattedVoucher inside object definition)
		const voucherRoutes = {
			"BP-": `/${tenantName}/finance/VoucherBankPayment`,
			"CP-": `/${tenantName}/finance/VoucherCashPayment`,
			"BR-": `/${tenantName}/finance/VoucherEntryReceipts`,
			"CR-": `/${tenantName}/finance/VoucherEntryCashReceipts`,
			"SAL-": `/${tenantName}/finance/SalesVoucher`,
			"PUR-": `/${tenantName}/finance/PurchaseVoucher`,
			"JV-": `/${tenantName}/Finance/Voucherjournal`
		};

		// Match by prefix
		for (let prefix in voucherRoutes) {
			if (formattedVoucher.startsWith(prefix)) {
				let baseUrl = voucherRoutes[prefix];
				let targetUrl = `${baseUrl}?argsledno=${encodeURIComponent(formattedVoucher)}`; // Proper encoding

				console.log("Navigating to:", targetUrl); // Debugging
				window.location.href = targetUrl; // Navigate
				return;
			}
		}

		
	}

	</script>