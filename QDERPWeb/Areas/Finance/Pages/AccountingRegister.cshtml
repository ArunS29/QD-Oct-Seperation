						columns.AddFor(m => m.VoucherType).Caption(new JS("formatMessage('Voucher Type')")).Visible(false);
					})
			.OnCellClick("function(e) {handleCellClick(e);}")
				.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.Select))
				.AllowColumnReordering(true) // Enable column reordering
