<style>


        .dx-datagrid .dx-row {
            border-bottom: 1px solid #ccc; /* Border between rows */
        }

        .dx-tabpanel .dx-tab {
            color: black !important; /* Set the tab text color to black */
            font-weight: bold; /* Optionally make the text bold */
            font-size: 14px; /* Adjust font size for better visibility */
            padding: 10px 15px; /* Increase padding for better appearance */
        }

           
            .dx-tabpanel .dx-tab.dx-selection {
              /*  background-color: lightblue; */ /* Highlight selected tab with a background */
              /*   color: white !important; */ /* Set selected tab text color */
            }

        .form-container {
            margin: 25px;
         background-color: #cfddee; 
            border: 1px solid black; /* Add a black border */
            padding: 5px; /* Optional: Add some padding inside the border */
            border-radius: 1px; /* Optional: Rounded corners */
        }

        ul {
            list-style: none;
            padding: 15px;
        }

        li {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

        label {
            margin-left: 8px;
        }

        #errorMessage {
            color: red;
            margin-top: 20px;
        }

        /* Styling for the Save PDF button */
        #savePdfBtn {
            margin-top: 15px;
            padding: 10px 15px;
            background-color: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
        }

            #savePdfBtn:hover {
                background-color: #45a049;
            }

    .card {
        height: 500px;
    }
</style>

<div class="card">
    @*  <div class="content-container-top">  *@
    <div class="card-header" style="background-color: #c0dceb; color: black; font-weight: bold;">
        Bills Payable Reports
    </div>

    <!-- Tab Menu -->
    @(
        Html.DevExtreme().TabPanel()
        .ID("AssetTabs")
        .Items(item =>
        {
            item.Add().Title("BillsPayableBySupplier").Text("Bills Payable By Supplier").Template(@<text>
        <div class="form-group">

            <label for="Branch">AccountHead:</label>
            <br />

            @(Html.DevExtreme().DropDownBox()
            .ID("GetAccountHeadDropDown")
            .DataSource(d => d.WebApi()
            .Controller("ReportsBySupplier")
            .LoadAction("GetAccountHead")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("AccountId")
            )
            .LabelMode(EditorLabelMode.Outside)
            .ShowClearButton(true)
            .AcceptCustomValue(true)
            .OpenOnFieldClick(true) // Allow opening on click
            .ValueExpr("AccountId") // Ensure correct mapping
            .DisplayExpr("AccountHead")
            .ContentTemplate(new TemplateName("GetAccountHeadContentTemplate"))
            .OnValueChanged("onDropDownValueChanged")
            )




        </div>

    </text>);
            item.Add().Title("BillsPayableBySalesPerson").Text("Bills Payable By SalesPerson").Template(@<text>
        <div class="form-group">

            <label for="Branch">Sales Person:</label>
            <br />
            @(Html.DevExtreme().DropDownBox()
            .ID("GetSalesPersonDropDown")
            .DataSource(d => d.WebApi()
            .Controller("ReportsBySupplier")
            .LoadAction("GetSalesPerson")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("SalesPersonCode")
            )
            .LabelMode(EditorLabelMode.Outside)
            .ShowClearButton(true)
            .AcceptCustomValue(true)
            .OpenOnFieldClick(true) // Allow opening on click
            .ValueExpr("SalesPersonCode") // Ensure correct mapping
            .DisplayExpr("SalesPersonName")
            .ContentTemplate(new TemplateName("GetSalesPersonContentTemplate"))
            )


        </div>

    </text>);
            item.Add().Title("BillsPayableByBranch").Text("Bills Payable By Branch/Division").Template(@<text>

        <div class="form-group">

            <label for="Branch">Division/Branch:</label>
            <br />
            @(Html.DevExtreme().DropDownBox()
            .ID("GetCompanyBranchDropDown")
            .DataSource(d => d.WebApi()
            .Controller("ReportsBySupplier")
            .LoadAction("GetCompanyBranch")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("BranchCode")
            )
            .LabelMode(EditorLabelMode.Outside)
            .ShowClearButton(true)
            .AcceptCustomValue(true)
            .OpenOnFieldClick(true) // Allow opening on click
            .ValueExpr("BranchCode") // Ensure correct mapping
            .DisplayExpr("BranchName")
            .ContentTemplate(new TemplateName("GetCompanyBranchContentTemplate"))
            )


        </div>


    </text>
        );
        })
        )


    @*  <div class="card-footer">
    @await Html.PartialAsync("_ReportFooter") <!-- Existing Footer -->
