</div>
@using (Html.DevExtreme().NamedTemplate("GetAccountHeadContentTemplate"))
{
    <div class="toolbar-container">
        <div id="gridToolbar">
            @(Html.DevExtreme().Button()
                .Text("Save as PDF")
                .Icon("exportpdf")
                .OnClick("saveGridAsPDF")
                )
            @(Html.DevExtreme().Button()
                .Text("Print")
                .Icon("print")
               // .OnClick("printGrid")
                )
        </div>
    </div>
    @(Html.DevExtreme().DataGrid()
            .ID("GetAccountHead-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("ReportsBySupplier")
            .LoadAction("GetAccountHead")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("AccountId")
            )
            .ShowBorders(true)
            .SearchPanel(sp => sp
            .Visible(true)  // Enables search bar
            .HighlightSearchText(true)
            )
            .Selection(sl => sl
            .Mode(SelectionMode.Multiple)  // Allows multiple selection
            .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always) // Always show checkboxes
            )
            .OnSelectionChanged("dataGridSelectionChanged1") // Handle selection
            .Paging(p => p.PageSize(15))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual)) // Enable virtual scrolling
            .Height(345)
            .Columns(columns =>
            {
                // columns.Add().DataField("AccountId").Caption("ID");
                columns.Add().DataField("AccountHead").Caption("Account Name");
            })
            )
}
