    async function saveGridAsPDF() {
        const dataGrid = $("#GetAccountHead-datagrid").dxDataGrid("instance");

        // Load jsPDF from the global `window.jspdf`
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        // Get selected rows
        const selectedRows = dataGrid.getSelectedRowsData();
        console.log("Selected Row:", selectedRows);

        if (selectedRows.length > 0) {
            DevExpress.pdfExporter.exportDataGrid({
                component: dataGrid,
                jsPDFDocument: doc,
                autoTableOptions: {

                    headStyles: { fontStyle: 'bold' }, // Bold headers
                    bodyStyles: { fontStyle: 'normal' },
                },
                selectedRowsOnly: true // Ensure only selected rows are exported
            }).then(() => {
                doc.save("SelectedGridData.pdf");
            });
        } else {
            alert("Please select rows to export.");
        }
    }

    // Print Grid with Selected Records
    function printGrid() {
        if (selectedValues.length === 0) {
            alert("Please select at least one record to print.");
            return;
        }

        // Send selected values using POST request
        fetch("/api/ReportsBySupplier/GenerateReport", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedValues)  // Send array as JSON
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url; // Redirect to report page
                } else {
                    return response.text();
                }
            })
            .then(data => {
                if (data) console.error("Error:", data);
            })
            .catch(error => console.error("Error:", error));
    }



