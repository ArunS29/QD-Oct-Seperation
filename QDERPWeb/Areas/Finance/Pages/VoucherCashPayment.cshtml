    function addSalaryPaidEntry() {
        var AccountEmployeeValidator = $("#accountEmployeeDropDownBox").dxValidator("instance");
        var AccountDropDownPayableValidator = $("#againstDropDownBoxPayable").dxValidator("instance");
        var voucherAmtValidator = $("#txtVoucherAmount1").dxValidator("instance");

        var accountemployeeValidation = AccountEmployeeValidator.validate();
        var accountpayableValidation = AccountDropDownPayableValidator.validate();
        var voucheramountValidation = voucherAmtValidator.validate();

        if (accountemployeeValidation.isValid && accountpayableValidation.isValid && voucheramountValidation.isValid) {

            var VE = {
                SalaryPayableLedgerNo: accheadid,
                ReferenceType: $("#SalaryPaid").dxSelectBox("instance").option("value"),
                // EmployeeName: null,
                ReferenceNo: null,
                DrCr: $("#sbDrCr").dxSelectBox("instance").option("value"),
                EmployeeNo: null, // Update dynamically if needed
                Amount: $("#txtVoucherAmount1").dxNumberBox("instance").option("value"),
            };

            // Get ReferenceNo from selected row
            var selectedRowData = $("#accountpayable-datagrid").dxDataGrid("instance").getSelectedRowsData();
            if (selectedRowData.length > 0) {
                VE.ReferenceNo = selectedRowData[0].ReferenceNo;
                VE.EmployeeNo = selectedRowData[0].EmployeeNo;
                //VE.EmployeeName = selectedRowData[0].EmployeeName;
            } else {
                DevExpress.ui.notify("Please select a row from the grid!", "error", 2000);
                return;
            }

            $.ajax({
                type: "POST",
                url: `/api/LedgerAccountMaster/AddEmployeeEntry?EmployeeName=${encodeURIComponent(selectedRowData[0].EmployeeName)}`, // Pass value as a query parameter
                // url: "/api/LedgerAccountMaster/AddEmployeeEntry?MasterGroup=${encodeURIComponent(selectedValue)}`",
                contentType: "application/json",
                data: JSON.stringify(VE),
                dataType: "json",
                success: function (response) {
                    $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
                    DevExpress.ui.notify("Data saved successfully!", "success", 2000);
                },
                error: function (xhr) {
                    DevExpress.ui.notify(xhr.responseJSON?.message || "An error occurred.", "error", 2000);
                },
            });
        } else {
            DevExpress.ui.notify("Please fill required details!", "error", 2000);
        }
    }

