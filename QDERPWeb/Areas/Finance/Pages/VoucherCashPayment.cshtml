         function addVoucherEntry() {
        var btn = $("#btnVoucherEntry").dxButton("instance");

        // Disable button + show loading
        btn.option({
            disabled: true,
            icon: "spinner", // built-in spinner icon
            text: "Loading..."
        });

        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;
        var griddatacount = rowCount;

        // Get VoucherNo TextBox value
        var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

        const urlParams = new URLSearchParams(window.location.search);
        const argsledno = urlParams.get("argsledno");

        // ✅ Case 1: If VoucherNo is already set → directly continue
        if (voucherNo && voucherNo.trim() !== "") {
            continueVoucherEntryWithVoucherNo(voucherNo);
            return;
        }

        // ✅ Case 2: If VoucherNo not set, and grid empty, and no argsledno → fetch new one
        if (!voucherNo && griddatacount === 0 && !argsledno) {
            $.ajax({
                type: "GET",
                url: "/api/VoucherMaster/GetNewCPVoucherNo",
                success: function (response) {
                    if (!response || response.success === false) {
                        DevExpress.ui.notify("Failed to fetch Voucher Number: " + (response.message || "Unknown error"), "Error");
                        return;
                    }

                    // response is the voucher number
                    voucherNo = response;
                    $("#VoucherNo").dxTextBox("instance").option("value", voucherNo);

                    continueVoucherEntryWithVoucherNo(voucherNo);
                    isVoucherSaved = true;
                    updateWorkflowVisual(getWorkflowStatusFromFields());
                },
                error: function (xhr, status, error) {
                    DevExpress.ui.notify("Error retrieving voucher number: " + error, "Error");
                }
            });
        } else {
            // ✅ Case 3: If VoucherNo is null but grid has rows or argsledno is present → reuse textbox (might still be empty)
            continueVoucherEntryWithVoucherNo(voucherNo);
            getDocumentCount();
        }
    }


