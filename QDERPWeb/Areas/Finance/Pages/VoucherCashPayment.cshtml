@page
@using QD.ERP.Web.DAL.Entities
@{
    ViewData["Title"] = "Payment Voucher Details";
    var popvno = "";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<style type="text/css">
    .dx-datagrid .dx-row {
    border-bottom: 1px solid #ccc; /* Border between rows */
    }



    .horizontal-container {
    display: flex;
    gap: 10px; /* Adds spacing between buttons */
    justify-content: start; /* Aligns buttons to the left */
    align-items: center; /* Vertically centers the buttons */
    margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
    text-align: center; /* Centers the text inside the input */
    }



    .button-alignment-down {
    margin-bottom: 10px
    }

    .card {
    border: 1px solid #ddd;
    border-radius: 8px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    padding: 5px;
    margin: 20px auto;
    max-width: 1300px;
    max-height:1550px;
    background-color: #f5f5f5;
    position:relative;
    top:18px;

    }

    .custom-popup-background {
    background-color: #f0f0f0; /* Change the background color as needed */
    }

</style>
<div id="costAllocationPopup" style="display:none;">
    <div style="margin-bottom:10px">
        @(Html.DevExtreme().Button()
                    .ID("btnSaveCostAllocation")
                    .Icon("save")
                    .Text("Save")
                    .OnClick("function() { saveCostAllocation(); }")
                    )
    </div>
</div>
