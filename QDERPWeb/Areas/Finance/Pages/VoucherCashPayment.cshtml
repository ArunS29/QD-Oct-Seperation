        <div class="container">
            <div class="row g-3">
                <!-- First Row for Cheque No/Reference No and Voucher Narration with Button -->
                <div class="container-fluid backgroundcolor py-3">
                    <div class="row align-items-start">
                        <!-- Cheque No/Reference No with Popup Button -->

                        <div class="col-12 col-md-6 col-lg-4 mb-3">
                            <div class="form-group">
                                <label for="ChequeNo">Cheque No/Reference No</label>
                                <div class="input-group">
                                    @(
                                        Html.DevExtreme().TextBox()
                                        .ID("ChequeNoReferenceNo")
                                        .Value(null)

                                        .Width(257)
                                        )
                                    <span class="input-group-append">
                                        @(
                                            Html.DevExtreme().Button()
                                            .ID("btnChequePopup")
                                            .Text("...")
                                            .Width(40)
                                            .Height(35)
                                            .ElementAttr(new { @class = "input-button" })
                                            .OnClick("showChequePopup")
                                            )
                                    </span>
                                </div>
                                @* Cheque Edit *@
                                @*  <div class="popup"> *@
                                @(
                                    Html.DevExtreme().Popup()
                                    .ID("chequePopup")
                                    .Title("Bank Cheque Printing")
                                    .Visible(false)
                                    .HideOnOutsideClick(false)
                                    .ShowCloseButton(true) // Display close button
                                    .Width(1000)
                                    .Height(450)

                                    .ContentTemplate(@<div style="background-color: #c0dceb; padding: 10px;">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="ChequeNo" class="button-alignment-down">Cheque No</label>
                                                @(Html.DevExtreme().TextBox()
                                                .ID("ChequeNo")
                                                .Value(null)
                                                .ValidationRules(rules =>
                                                {
                                                rules.AddRequired()
                                                .Message("ChequeNo is required");
                                                })
                                                .ElementAttr(new { style = "background-color: lightGrey; color: darkgrey;" })
                                                )


                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="VoucherNo1" class="button-alignment-down">Voucher No</label>
                                                @(Html.DevExtreme().TextBox()
                                                .ID("PopVoucherNo")
                                                .Value(popvno)
                                                .Disabled(true)
                                                .ElementAttr(new { style = "background-color: lightGrey; color: darkgrey;" }) // Set color styles

                                                )
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="ChequeDate" class="button-alignment-down">Cheque Date</label>
                                                @(Html.DevExtreme().DateBox()
