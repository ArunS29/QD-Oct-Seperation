function confirmDelete(onConfirm) {
    DevExpress.ui.dialog.confirm(
        "You are about to delete the entry from the database. You cannot revert the changes. Are you sure you want to delete?",
        "Confirm Deletion"
    ).done(function (dialogResult) {
        if (dialogResult) {
            onConfirm(); // Proceed only if the user clicks "Yes"
            DevExpress.ui.dialog.alert(
                "Line entry has been successfully removed from the database.",
                "Deletion Successful"
            );
        }
    });
}


function confirmDeleteAll(onConfirm) {
    DevExpress.ui.dialog.confirm(
        "You are about to delete the Voucher Entries from the database. You cannot revert the changes. Are you sure you want to delete?",
