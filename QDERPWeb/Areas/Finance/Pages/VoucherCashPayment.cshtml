@page
@using QD.ERP.Web.DAL.Entities
@{
    ViewData["Title"] = "Payment Voucher Details";
    var popvno = "";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .button-alignment-down {
        margin-bottom: 10px
    }

    .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        padding: 5px;
        margin: 20px auto;
        max-width: 1300px;
        max-height: 1550px;
        background-color: #f5f5f5;
        position: relative;
        top: 18px;
    }

    .custom-popup-background {
        background-color: #f0f0f0; /* Change the background color as needed */
    }

    .bold-header {
        font-weight: bold;
    }

    .bold-value {
        font-weight: bold;
    }

    .bold-button .dx-button-text {
        font-weight: bold;
    }

</style>

<div class="card">
    @* <div class="card-header" style="background-color: #4a4a9c; color: white; font-weight: bold;">
    Payment Voucher Details
    </div> *@

    <h2>@ViewData["Title"]</h2>

    <div class="content-container">
        <div class="dx-fieldset horizontal-container" style="margin-bottom:0px">
            <div class="form-group">
                <label for="PurchaseVoucherNo" class="button-alignment-down"><strong>Voucher No</strong></label>
                @(
                    Html.DevExtreme().TextBox()
                    .ID("VoucherNo")
                    .Value(null)
                    .Disabled(true)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("VoucherNo is required");
                    })
                    )
            </div>
            <div class="form-group">
                <label for="VoucherDate" class="button-alignment-down"><strong>Voucher Date</strong></label>
                @(Html.DevExtreme().DateBox()
                    .ID("VoucherDate")
                    .InputAttr("aria-label", "Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(DateTime.Now)
                    )
            </div>
            <div class="form-group">
                <label for="EffectiveDate" class="button-alignment-down"><strong>Effective Date</strong></label>
                @(Html.DevExtreme().DateBox()
                    .ID("VoucherEffectiveDate")
                    .InputAttr("aria-label", "Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(DateTime.Now)
                    )
            </div>
            <div class="form-group">
                <label for="" class="button-alignment-down"><strong>Payment Account:</strong></label>
                @(Html.DevExtreme().DropDownBox()
                    .DataSource(d => d.WebApi()
                    .Controller("VoucherMaster")
                    .LoadAction("GetCPPaymentAccounts")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("AccountHead")
                    )
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("accountDropDownBox")

                    .ShowClearButton(true)
                    .AcceptCustomValue(true)
                    .OpenOnFieldClick(false)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .Value("Petty Cash - Shabbir")
                    .ValueExpr("AccountId")
                    .DisplayExpr("AccountHead")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(720)
                    .TabIndex(1)
                    .DropDownOptions(o => o
                    .Width(1000)
                    )
                    .OnKeyDown("onKeyDown")
                    //.OnValueChanged("dropDownBoxValueChanged")
                    .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                    )

            </div>
        </div>

        <div class="dx-fieldset horizontal-container " style="margin-bottom:0px;">

            <div class="form-group">
                <div class="button-alignment-down">
                    <label for="DrCr"><strong>Dr/Cr</strong></label>
                </div>
                @(
                    Html.DevExtreme().SelectBox()
                    .ID("sbDrCr")
                    .DataSource(new[] { "Dr", "Cr" })
                    .Value("Dr")
                    .Placeholder("Select Transaction Type")
                    .Width(112)
                    )
            </div>
            <div class="form-group">
                <label for="AccountHead" class="button-alignment-down"><strong>Account Head:</strong></label>
                @(Html.DevExtreme().DropDownBox()
                    .DataSource(d => d.WebApi()
                    .Controller("VoucherMaster")
                    .LoadAction("GetAccountHead")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("AccountHead")
                    )
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Ledger Account should be entered ");
                    })
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("ddAccountHead")
                    .ShowClearButton(true)
                    .AcceptCustomValue(true)
                    .OpenOnFieldClick(false)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .ValueExpr("AccountId")
                    .DisplayExpr("AccountHead")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(650)
                    .TabIndex(1)
                    .DropDownOptions(o => o
                    .Width(1000)
                    )
                    .OnKeyDown("onKeyDown")
                    //.OnValueChanged("dropDownBoxValueChanged")
                    .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                    )
            </div>
            <div class="form-group" style="margin-top:56px;margin-left:-10px">
                @(Html.DevExtreme().Button()
                    .ID("btnAddAHead")
                    .Icon("plus")
                    )
            </div>
            <div class="form-group" style="margin-top:56px;margin-left:-10px">
                @(Html.DevExtreme().Button()
                    .ID("btnEditAHead")
                    .Icon("edit")
                    )
            </div>

            <div class="form-group">
                <label for="Amount" class="button-alignment-down"><strong>Amount</strong></label>
                @(
                    Html.DevExtreme().NumberBox()
                    .ID("txtVoucherAmount")
                    .Value(null)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message("Voucher Amount Cannot be Zero Or Negative");
                        rules.AddRange().Min(0).Message("Voucher Amount Cannot be Zero Or Negative");
                    })
                    .Placeholder("0.000")
                    .Format("###,###,###,##0.00")  // Numeric format with thousands separator and two decimal places
                    .InputAttr(new { type = "number", step = "0.01", style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;", maxLength = 16, autocomplete = "off" })
                    .Width(180)// HTML attribute to allow decimal input
                    )

            </div>


        </div>

        <div class="dx-fieldset horizontal-container " style="margin-top:0px;margin-bottom:0px;padding-top:10px;">
            <div class="form-group" style="padding-left:20px">
                <label for="Amount" class="button-alignment-down" style="margin-right:25px"><strong>Narration</strong></label>
            </div>
            <div class="form-group">
                @(
                    Html.DevExtreme().TextArea()
                    .ID("txtEntryNarration")
                    .Value("")
                    .Height(70)
                    .Width(720)
                    .Placeholder("Enter your comments here...")
                    .MaxLength(111500)

                    )
            </div>
            <div class="form-group" style="">
                @(Html.DevExtreme().Button()
                    .ID("btnVoucherEntry")
                    .Text("ADD")
                    .Height(70)
                    .Width(178)
                    .Icon("plus")
                    .OnClick("function() { addVoucherEntry(); }")
                    )
            </div>

        </div>


        <div class="dx-field ledgerResult">

            @(
                    Html.DevExtreme().DataGrid < QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay > ()
                    .ID("dataGrid")
                    .RemoteOperations(false)
                    .Columns(columns =>
                    {
                        columns.AddFor(m => m.VoucherEntryNo)
                    .Caption("VoucherEntryNo")
                    .Visible(false);

                        columns.AddFor(m => m.DrCr)
                    .Caption("Dr/Cr")
                    .AllowEditing(false)
                    .HeaderCellTemplate(@<div style="font-weight: bold;">Dr/Cr</div>);



                        columns.AddFor(m => m.AccountHead)
                    .EditCellTemplate(@<div>
                <div style="width:100%;">
                    <div id="accountHeadContainer" style="width:100%;"></div>
                </div>
                <script type="text/javascript">
                    $(function () {
                        var gridInstance = $("#dataGrid").dxDataGrid("instance");

                        $("#accountHeadContainer").dxSelectBox({
                            dataSource: DevExpress.data.AspNet.createStore({
                                key: "AccountId",
                                loadUrl: "/api/VoucherMaster/GetAccountHead" // API endpoint
                            }),
                            valueExpr: "AccountId", // Field for value
                            displayExpr: "AccountHead", // Field for display
                            searchEnabled: true, // Enable search
                            showClearButton: true, // Show clear button
                            // value: options.value, // Bind the current value to the editor
                            onValueChanged: function (e) {

                                var rowIndex = $("#accountHeadContainer").closest(".dx-row").data("rowIndex");
                                gridInstance.cellValue(rowIndex, "AccountHead", e.value);

                                // Trigger save only if editing mode is enabled
                                gridInstance.saveEditData().done(function () {
                                    console.log("Edit data saved successfully.");
                                }).fail(function (error) {
                                    console.error("Failed to save data:", error);
                                });
                            }
                        });
                    });
                </script>
            </div>)
                .HeaderCellTemplate(@<div style="font-weight: bold;">Account Head</div>);



                        columns.AddFor(m => m.DrAmount).Caption("Debit").Alignment(HorizontalAlignment.Right).CustomizeText(
                    "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                    ).AllowEditing(false).HeaderCellTemplate(@<div style="font-weight: bold;">Debit</div>);


                        columns.AddFor(m => m.CrAmount)
                    .Caption("Credit")
                    .AllowEditing(false)
                    .Alignment(HorizontalAlignment.Right)
                    .HeaderCellTemplate(@<div style="font-weight: bold;">Credit</div>)
                @* .EditCellTemplate(@<input dx-number-box data-bind="value: $data.CrAmount" />) *@
                .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");


                        columns.AddFor(m => m.EntryNarration)
                    .Caption("Entry Narration")
                    .AllowEditing(true) // Allow editing for this column
                @* .EditCellTemplate(@<div>
            <div id="entryNarrationLookupContainer" style="width:100%;"></div>
            <script type="text/javascript">
            $(function () {
            $("#entryNarrationLookupContainer").dxDropDownBox({
            value: "", // Initialize with an empty value
            placeholder: "Write or select a value...",
            showClearButton: true, // Allow clearing the value
            contentTemplate: function (dropDownBox) {
            const $content = $("<div>").css({ display: "flex", flexDirection: "column", gap: "10px" });

            // Create a TextBox for direct text entry
            $("<div>").dxTextBox({
            placeholder: "Enter text...",
            onValueChanged: function (args) {
            if (args.value) {
            dropDownBox.component.option("value", args.value);
            }
            }
            }).appendTo($content);

            return $content;
            }

            });
            });
            </script>
            </div>) *@
                .HeaderCellTemplate(@<div style="font-weight: bold;">Entry Narration</div>);


                        columns.AddFor(m => m.SysRemarks)
                    .Caption("Remarks")
                    .AllowEditing(false)
                    .HeaderCellTemplate(@<div style="font-weight: bold;">Remarks</div>);


                    })

                .AllowColumnReordering(true) // Enable column reordering
                .AllowColumnResizing(true)   // Enable column resizing
                .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                .HeaderFilter(filter => filter.Visible(true))
                .Height(250)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                .ShowBorders(true)
                .Width("100%")
                .Editing(editing => editing
                .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                .AllowUpdating(true)   // Enable editing of existing rows
                .AllowDeleting(true)   // Enable deleting rows
                .UseIcons(true) // Enables icons for editing buttons
                )
                .OnEditorPreparing("onEditorPreparing")
                .OnRowRemoving("onRowRemoving")
                )


        </div>


        <!-- Footer with TextBoxes Aligned Directly Under Debit and Credit -->
        <div id="footerTotals" style="display: flex; justify-content: space-between; background-color: #f5f5f5; color: white; padding:10px; margin-top: -11px; font-size: 14px; max-width:1245px;position:relative;left:15px;">
            <div style="flex: 1;">&nbsp;</div> <!-- Aligns with Dr/Cr column -->
            <div style="flex: 1;">&nbsp;</div> <!-- Aligns with Account Head column -->
            <!-- TextBox for Debit -->
            <div style="flex: none; text-align: right;">

                @(Html.DevExtreme().TextBox()

                    .ID("totalDebitTextbox")

                    .Value("0.00")

                    .ReadOnly(true)

                    .Width("60%")

                    )
            </div>

            <!-- TextBox for Credit -->
            <div style="flex: none; text-align: right;">

                @(Html.DevExtreme().TextBox()

                    .ID("totalCreditTextbox")

                    .Value("0.00")

                    .ReadOnly(true)

                    .Width("60%")

                    )
            </div>

            <div style="flex: 2;">&nbsp;</div> <!-- Aligns with Entry Narration and Remarks columns -->
        </div>




        <div class="container">
            <div class="row g-3">
                <!-- First Row for Cheque No/Reference No and Voucher Narration with Button -->
                <div class="container-fluid backgroundcolor py-3">
                    <div class="row align-items-start">
                        <!-- Cheque No/Reference No with Popup Button -->

                        <div class="col-12 col-md-6 col-lg-4 mb-3">
                            <div class="form-group">
                                <label for="ChequeNo"><strong>Cheque No/Reference No</strong></label>
                                <div class="input-group">
                                    @(
                                        Html.DevExtreme().TextBox()
                                        .ID("ChequeNoReferenceNo")
                                        .Value(null)

                                        .Width(257)
                                        )
                                    <span class="input-group-append">
                                        @(
                                            Html.DevExtreme().Button()
                                            .ID("btnChequePopup")
                                            .Text("...")
                                            .Width(40)
                                            .Height(35)
                                            .ElementAttr(new { @class = "input-button" })
                                            .OnClick("showChequePopup")
                                            )
                                    </span>
                                </div>
                                @* Cheque Edit *@
                                @*  <div class="popup"> *@
                                @(
                                    Html.DevExtreme().Popup()
                                    .ID("chequePopup")
                                    .Title("Bank Cheque Printing")
                                    .Visible(false)
                                    .HideOnOutsideClick(false)
                                    .ShowCloseButton(true) // Display close button
                                    .Width(1000)
                                    .Height(450)

                                    .ContentTemplate(@<div style="background-color: #c0dceb; padding: 10px;">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="ChequeNo" class="button-alignment-down"><strong>Cheque No</strong></label>
                                                @(Html.DevExtreme().TextBox()
                                                .ID("ChequeNo")
                                                .Value(null)
                                                .ValidationRules(rules =>
                                                {
                                                rules.AddRequired()
                                                .Message("ChequeNo is required");
                                                })
                                                .ElementAttr(new { style = "background-color: lightGrey; color: darkgrey;" })
                                                )


                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="VoucherNo1" class="button-alignment-down"><strong>Voucher No</strong></label>
                                                @(Html.DevExtreme().TextBox()
                                                .ID("PopVoucherNo")
                                                .Value(popvno)
                                                .Disabled(true)
                                                .ElementAttr(new { style = "background-color: lightGrey; color: darkgrey;" }) // Set color styles

                                                )
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="ChequeDate" class="button-alignment-down"><strong>Cheque Date</strong></label>
                                                @(Html.DevExtreme().DateBox()
                                                .ID("ChequeDate")
                                                .InputAttr("aria-label", "Date")
                                                .LabelMode(EditorLabelMode.Outside)
                                                .Type(DateBoxType.Date)
                                                .DisplayFormat("dd-MMM-yyyy")
                                                .Value(DateTime.Now)
                                                )
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label for="PlaceofIssue" class="button-alignment-down"><strong>Place of Issue</strong></label>
                                                @(Html.DevExtreme().TextBox()
                                                .ID("PlaceofIssue")
                                                .ValidationRules(rules =>
                                                {
                                                rules.AddRequired()
                                                .Message("PlaceofIssue is required");
                                                })
                                                .Value(null)
                                                )
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">

                                        <div class="col-md-12">

                                            <div class="form-group">
                                                <label for="ChequeIssuedinfavourof" class="button-alignment-down"><strong>Cheque Issued in favour of</strong></label>
                                                <div class="btn" style="position:relative;left:650px;">
                                                    @(Html.DevExtreme().Button()
                                                    .ID("popupbtnAddAHead")
                                                    .Icon("plus")
                                                    .OnClick("function() { onPopupAddButtonClick(); }")
                                                    )
                                                </div>
                                                <label for="Addcaption" style="position:relative;left:395px;color: #0066CC;"><strong>Use Ledger Account Name</strong></label>

                                                @(Html.DevExtreme().TextBox()
                                                .ID("ChequeIssuedinfavourof")
                                                .ValidationRules(rules =>
                                                {
                                                rules.AddRequired()
                                                .Message("Cheque Issued in favour of is required");
                                                })
                                                .Value(null) )
                                            </div>
                                        </div>

                                    </div>



                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="AmountinWords" class="button-alignment-down"><strong>AmountinWords</strong></label>
                                                @(Html.DevExtreme().TextBox()
                                                .ID("AmountinWords")
                                                .Value("No Riyals Only.")
                                                .ValidationRules(rules =>
                                                {
                                                rules.AddRequired()
                                                .Message("Amount in Words is required");
                                                })
                                                )
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="AmountinSAR" class="button-alignment-down"><strong>AmountinSAR</strong></label>
                                                @(Html.DevExtreme().NumberBox()
                                                .ID("AmountinSAR")
                                                .Width(100)
                                                .Value(0)
                                                .ShowSpinButtons(true)
                                                .Min(0)
                                                .Max(1000)
                                                .Step(1))
                                            </div>
                                        </div>


                                    </div>

                                    @*  <div>
                                    @await Html.PartialAsync("_ChequeFooter")
                                    </div> *@

                                    <div class="dx-fieldset horizontal-container mt-2">

                                        @(Html.DevExtreme().Button()
                                        .ID("PopSave")
                                        .Text("Save")
                                        .Type(ButtonType.Normal)
                                        .StylingMode(ButtonStylingMode.Outlined)
                                        .Icon("save")
                                        .OnClick("function() { SavePopVoucherEntry(); }")
                                        .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                                        )
                                        @(Html.DevExtreme().Button()
                                        .ID("btnSaveAndClose")
                                        .Text("Save and Close")
                                        .Type(ButtonType.Normal)
                                        .StylingMode(ButtonStylingMode.Outlined)
                                        .Icon("save")
                                        .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                                        )
                                        @(Html.DevExtreme().Button()
                                        .ID("btnPreview")
                                        .Text("Preview")
                                        .Icon("fullscreen")
                                        .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class

                                        )
                                        @(Html.DevExtreme().Button()
                                        .ID("btnPrint")
                                        .Text("Print")
                                        .Icon("print")
                                        .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                                        )
                                        @(Html.DevExtreme().Button()
                                        .ID("btnDelete")
                                        .Text("Delete")
                                        .Icon("close")
                                        .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                                        )
                                        @(Html.DevExtreme().Button()
                                        .ID("btnBack")
                                        .Text("Back")
                                        .Icon("arrowleft")
                                        .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                                        )

                                    </div>
                                </div>)
                                    )

                            </div>
                        </div>


                        <!-- Voucher Narration -->
                        <div class="col-md-8" style="position:relative;right:102px;">
                            <div class="form-group">
                                <label for="VoucherNarration"><strong>Voucher Narration</strong></label>
                                @(
                                    Html.DevExtreme().TextBox()
                                    .ID("VoucherNarration")
                                    .Value(null)

                                    )
                            </div>
                        </div>

                        <!-- Button to the right -->

                        <div class="d-flex justify-content-end" style="position:relative;top:25px;">
                            <div class="form-group">
                                @(Html.DevExtreme().Button()
                                    .ID("btnAttachment")
                                    .Icon("fa fa-paperclip")
                                    .Height(50)
                                    .Width(70)
                                    )
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Second Row for Bill No, Bill Date, Bill Paid To, and Remarks -->
                <div class="col-md-12 backgroundcolor" style="padding-top:0px; padding-bottom:0px; position:relative;bottom:35px;">
                    <div class="row">
                        <!-- Bill No -->
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="BillNo"><strong>Bill No</strong></label>
                                @(
                                    Html.DevExtreme().TextBox()
                                    .ID("BillNo")
                                    .Value(null)

                                    )
                            </div>
                        </div>

                        <!-- Bill Date -->
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="BillDate"><strong>Bill Date</strong></label>
                                @(
                                    Html.DevExtreme().DateBox()
                                    .ID("BillDate")
                                    .InputAttr("aria-label", "Date")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .Type(DateBoxType.Date)
                                    .DisplayFormat("dd-MMM-yyyy")
                                    .Value("")


                                    )
                            </div>
                        </div>

                        <!-- Bill Paid To -->
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="BillPaidTo"><strong>Bill Paid To</strong></label>
                                @(
                                    Html.DevExtreme().TextBox()
                                    .ID("BillPaidTo")
                                    .Value(null)

                                    )
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="Remarks"><strong>Remarks</strong></label>
                                @(
                                    Html.DevExtreme().TextBox()
                                    .ID("Remarks")
                                    .Value(null)

                                    )
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Third Row for Payment Account, Verified By, Verified On, Approved By, Approved On -->
                <div class="col-md-12 backgroundcolor" style="padding-top:1px; padding-bottom:1px;position:relative;bottom:50px;">
                    <div class="row mt-3 align-items-center">
                        <!-- Payment Account -->

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="VoucherType"></label>
                                @(
                                    Html.DevExtreme().SelectBox()
                                    .ID("VoucherType")
                                    .DataSource(new[] { "Cash Payment" })
                                    .Value("Cash Payment")
                                    .Width(520)
                                    .Disabled(true)
                                    .ItemTemplate(@<div style="font-weight: bold;">Cash Payment</div>)
                                    )
                            </div>
                        </div>

                        <!-- Verified By and Approved By Section -->
