        <!-- Footer with TextBoxes Aligned Directly Under Debit and Credit -->
        <div id="footerTotals" style="display: flex; justify-content: space-between; background-color: aliceblue; color: white; padding:10px; margin-top: -11px; font-size: 14px; max-width:1245px;position:relative;left:17px;">
            <div style="flex: 1;">&nbsp;</div> <!-- Aligns with Dr/Cr column -->
            <div style="flex: 1;">&nbsp;</div> <!-- Aligns with Account Head column -->
            <!-- TextBox for Debit -->
            <div style="flex: none; text-align: right;position:relative;right:25px;">

                @(Html.DevExtreme().TextBox()

                    .ID("totalDebitTextbox")

                    .Value("0.00")

                    .ReadOnly(true)

                    .Width("60%")
                    .RtlEnabled(true)


                    )
            </div>

            <!-- TextBox for Credit -->
            <div style="flex: none; text-align: right;position:relative;right:80px;">

                @(Html.DevExtreme().TextBox()

                    .ID("totalCreditTextbox")

                    .Value("0.00")

                    .ReadOnly(true)

                    .Width("60%")
                    .RtlEnabled(true)


                    )
            </div>

            <div style="flex: 2;">&nbsp;</div> <!-- Aligns with Entry Narration and Remarks columns -->
        </div>
