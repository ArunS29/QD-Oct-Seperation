                return;
            }

            let visibleRows = dataGrid.getVisibleRows(); // Get all visible rows
            let rowData = visibleRows[rowIndex]?.data; // Fetch the correct row's data

            if (!rowData || !rowData.VoucherEntryNo) {
                console.error("No valid row selected for Cost Allocation.");
                return;
            }

            let drCr = rowData.DrCr;
            let accountHead = rowData.AccountHead;
            let amount = drCr === "Cr" ? rowData.CrAmount : rowData.DrAmount;
            let voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

