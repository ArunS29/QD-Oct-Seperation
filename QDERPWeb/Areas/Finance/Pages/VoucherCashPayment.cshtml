const menuItems = [
    { id: "editCostAllocation", text: "Edit Cost Allocation", icon: "edit", color: "#4CAF50" },
    { id: "editBillsReceivable", text: "Edit Bills Receivable", icon: "file", color: "#2196F3" },
    { id: "editSalaryPayable", text: "Edit Salary Payable", icon: "money", color: "#FF9800" },
    { id: "editEmployeeAllocation", text: "Edit Employee Allocation", icon: "user", color: "#9C27B0" },
    { id: "editPropertyAllocation", text: "Edit Property Allocation", icon: "preferences", color: "#795548" },
    { id: "onAllRowRemoving", text: "Delete All Line Entries", icon: "trash", color: "#F44336" }
];
 // ---- state ----
 let currentIndex = 0;

 // ---- helpers ----
 function isMenuOpen() {
     const m = document.getElementById("contextMenu");
     return m && m.classList.contains("open") && m.style.display === "block";
 }

 function highlightItem(item) {
     document.querySelectorAll("#contextMenu li").forEach(li => li.classList.remove("active"));
     if (item) item.classList.add("active");
 }

 function hideContextMenu() {
     const menu = document.getElementById("contextMenu");
     if (!menu) return;
     menu.classList.remove("open");
     menu.style.display = "none";
 }

 // Build menu once (or call again if items change)
 function renderContextMenu() {
     const contextMenu = document.getElementById("contextMenu");
     contextMenu.innerHTML = "";

     menuItems.forEach((item, index) => {
         const li = document.createElement("li");
         li.dataset.id = item.id;
         li.tabIndex = -1;
         li.innerHTML = `
             <div class="custom-dropdown-item">
                 <div class="side-bar" style="background-color:${item.color};"></div>
                 <div class="item-content">
                     <div class="item-icon dx-icon dx-icon-${item.icon}" style="color:${item.color};"></div>
                     <div class="item-title">${formatMessage(item.text)}</div>
                 </div>
             </div>
         `;

         li.addEventListener("click", () => {
             if (typeof window[item.id] === "function") window[item.id]();
             hideContextMenu();
         });

         // keep mouse & keyboard highlight in sync
         li.addEventListener("mouseenter", () => {
             currentIndex = index;
             highlightItem(li);
         });

         contextMenu.appendChild(li);
     });
 }

 // Show menu at x,y with edge-flip and focus
 function showContextMenu(x, y) {
     const menu = document.getElementById("contextMenu");
     if (!menu.children.length) renderContextMenu();

     // prepare to measure
     menu.style.visibility = "hidden";
     menu.style.display = "block";

     const menuWidth = menu.offsetWidth;
     const menuHeight = menu.offsetHeight;
     const vw = window.innerWidth;
     const vh = window.innerHeight;

     // flip to keep inside viewport
     let left = (x + menuWidth > vw) ? vw - menuWidth - 10 : x;
     let top  = (y + menuHeight > vh) ? vh - menuHeight - 10 : y;

     // apply final position and show
     menu.style.left = `${Math.max(0, left)}px`;
     menu.style.top  = `${Math.max(0, top)}px`;
     menu.style.visibility = "visible";
     menu.classList.add("open");

     // highlight first item & focus menu
     currentIndex = 0;
     const items = menu.querySelectorAll("li");
     if (items.length) highlightItem(items[currentIndex]);

     // ensure menu can receive focus
     menu.setAttribute("tabindex", "-1");
     setTimeout(() => menu.focus(), 0);
 }

 // ---- global listeners ----

 // 1) Right-click on grid
 document.getElementById("dataGrid").addEventListener("contextmenu", function (e) {
     e.preventDefault();
     e.stopPropagation(); // stop grid from handling keys afterwards

     const rowElement = e.target.closest(".dx-data-row");
     if (rowElement) {
         const menu = document.getElementById("contextMenu");
         const rowIndex = parseInt(rowElement.getAttribute("aria-rowindex"), 10) - 1;
         menu.dataset.rowIndex = rowIndex;

         showContextMenu(e.clientX, e.clientY);
     }
 });

 // 2) Click outside closes
 document.addEventListener("mousedown", function (e) {
     const menu = document.getElementById("contextMenu");
     if (!menu) return;
     if (isMenuOpen() && !menu.contains(e.target)) hideContextMenu();
 });

 // 3) One global keydown (capture) that only acts if menu is open
 document.addEventListener("keydown", function (e) {
     if (!isMenuOpen()) return;

     const menu = document.getElementById("contextMenu");
     const items = menu.querySelectorAll("li");
     if (!items.length) return;

     // prevent grid from swallowing keys
     e.preventDefault();
     e.stopPropagation();

     if (e.key === "ArrowDown") {
         currentIndex = (currentIndex + 1) % items.length;
         highlightItem(items[currentIndex]);
     } else if (e.key === "ArrowUp") {
         currentIndex = (currentIndex - 1 + items.length) % items.length;
         highlightItem(items[currentIndex]);
     } else if (e.key === "Enter" || e.key === " ") {
         items[currentIndex].click();
     } else if (e.key === "Escape") {
         hideContextMenu();
     }
 }, true); // <- capture mode so we intercept before DataGrid




 renderContextMenu();


</script>