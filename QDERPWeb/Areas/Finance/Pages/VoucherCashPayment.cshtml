<div class="footer-fixed">
    @await Html.PartialAsync("_Formfooter")
</div>
<div class="content-container-top" style="background-color:#909ead00;">
    <div class="dx-card-container">
        <div class="dx-card-header minimal-header">
            <div class="card-title-icon">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <h3 class="card-title-text">Cash Payment Voucher</h3>
        </div>
          <div class="dx-card-body">
            <div class="form-container" style="display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; position: relative; padding: 0 15px; overflow-x: hidden;">
                <!-- Top Row -->
                <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: nowrap; width: 100%;">
                    <div class="form-group" style="flex: 1 1 25px;">
                        @(Html.DevExtreme().TextBox()
                                                .Label(new JS("formatMessage('Voucher No')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("VoucherNo")
                                                .Value("")
                                                .Disabled(true)
                                                .OnValueChanged("onVoucherNoChanged")
                                                .ValidationRules(rules => rules.AddRequired().Message("VoucherNo is required"))
                                                .ElementAttr(new { @class = "custom-disabled-textbox" })
                                                )
                    </div>

                    <div class="form-group" style="flex: 1 1 35px;">
                        @(Html.DevExtreme().DateBox()
                                                .Label(new JS("formatMessage('Voucher Date')"))
                                                .ID("VoucherDate")
                                                .InputAttr("aria-label", "Date")
                                                .LabelMode(EditorLabelMode.Floating)
                                                .Type(DateBoxType.Date)
                                                .DisplayFormat("dd-MMM-yyyy")
                                                .Value(DateTime.Now)
                                                .OnValueChanged("onVoucherDateChanged")
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                )
                    </div>

                    <div class="form-group" style="flex: 1 1 35px;">
                        @(Html.DevExtreme().DateBox()
                                                .Label(new JS("formatMessage('Effective Date')"))
                                                .ID("VoucherEffectiveDate")
                                                .InputAttr("aria-label", "Date")
                                                .LabelMode(EditorLabelMode.Floating)
                                                .Type(DateBoxType.Date)
                                                .DisplayFormat("dd-MMM-yyyy")
                                                .Value(DateTime.Now)
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                )
                    </div>

                    <div class="form-group" style="flex: 1 1 170px;">
                        @(Html.DevExtreme().DropDownBox()
                                                .Label(new JS("formatMessage('Payment Account')"))
                                                .DataSource(d => d.WebApi()
                                                .Controller("VoucherMaster")
                                                .LoadAction("GetCPPaymentAccounts")
                                                .LoadMode(DataSourceLoadMode.Raw)
                                                .Key("AccountHead")
                                                )
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("accountDropDownBox")

                                                .ShowClearButton(true)
                                                .AcceptCustomValue(true)
                                                .OpenOnFieldClick(false)
                                                .ValueChangeEvent("input")
                                                .HoverStateEnabled(true)
                                                .ValueExpr("AccountId")
                                                .DisplayExpr("AccountHead")
                                                .OnInput("dropDownBoxOnInput")
                                                .OnOpened("onOpened")
                                                .TabIndex(1)
                                                .DropDownOptions(o => o.Width(1000))
                                                .ElementAttr(new { @class = "white-dropdownbox" })
                                                .OnKeyDown("onKeyDown")
                                                .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))

                                                )
                    </div>

                    <div class="form-group" style="flex: 1 1 400px;">
                        @(Html.DevExtreme().TextArea()
                                                .Label(new JS("formatMessage('Narration')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("txtEntryNarration")
                                                .Value("")
                                                .Height(40)

                                                .MaxLength(111500)
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                )
                    </div>
                </div>

                <!-- Second Row -->
                <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-top: 10px;">
                    <div class="form-group" >
                        @(
                                                Html.DevExtreme().SelectBox()
                                                .Label(new JS("formatMessage('Dr/Cr')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("sbDrCr")
                                                .DataSource(new[] { "Dr", "Cr" })
                                                .Value("Dr")
                                                .OnValueChanged("onVoucherDrCrValueChanged") // JS function name
                                                .Placeholder("Select Transaction Type")
                                                .ElementAttr(new { @class = "custom-disabled-selectbox" })
                                                .Width("60px")
                                                .ReadOnly(true)
                                                )
                    </div>

                    <!-- Container for Account Head & Buttons -->
                    <div style="display: flex; align-items: flex-end; gap: 5px; min-width: 100px;">

                        <!-- DropDownBox: Flex-grow to fill available space -->
                        <div class="form-group" style="flex-grow: 1;">
                            @(Html.DevExtreme().DropDownBox()
                                                        .Label(new JS("formatMessage('Account Head')"))
                                                        .DataSource(d => d.WebApi()
                                                        .Controller("VoucherMaster")
                                                        .LoadAction("GetAccountHead")
                                                        .LoadMode(DataSourceLoadMode.Raw)
                                                        .Key("AccountHead")
                                                        )
                                                        .ValidationRules(rules =>
                                                        {
                                                            rules.AddRequired()
                                                            .Message(new JS("formatMessage('Ledger Account should be entered')"));
                                                        })
                                                        .LabelMode(EditorLabelMode.Floating)
                                                        .ID("ddAccountHead")
                                                        .ShowClearButton(true)
                                                        .AcceptCustomValue(true)
                                                        .ElementAttr(new { @class = "white-dropdownbox" })

                                                        .OpenOnFieldClick(false)
                                                        .ValueChangeEvent("input")
                                                        .HoverStateEnabled(true)
                                                        .ValueExpr("AccountId")
                                                        .DisplayExpr("AccountHead")
                                                        .OnInput("dropDownBoxOnInput")
                                                        .OnClosed("onDropDownBoxClosed")
                                                        .OnOpened("onOpened")
                                                        .Width(400)
                                                        .TabIndex(1)
                                                        .DropDownOptions(o => o
                                                        .Width(1000)
                                                        )
                                                        .OnKeyDown("onKeyDown")
                                                                                //.OnValueChanged("dropDownBoxValueChanged")
                                                        .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                                                         .Buttons(buttons => {
        // Built-in clear button
        buttons.Add()
            .Name("clear");

     buttons.Add()
    .Name("addLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("plus")
        .ElementAttr(new { @class = "custom-hover-button add-hover" })
        .OnClick("showLedgerAccountPopup"));

buttons.Add()
    .Name("editLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("edit")
        .ElementAttr(new { @class = "custom-hover-button edit-hover" })
        .OnClick("showLedgerAccountEditPopup"));



        buttons.Add()
        .Name("dropDown");
    })
                                                        )
                        </div>

                        <!-- Add Button -->
                        <div class="form-group" style="flex-shrink: 0;">
                          
                            <!-- DevExtreme Popup -->
                            @(Html.DevExtreme().Popup()
                                                        .ID("ledgerAccountPopup")
                                                        .Width("93%")
                                                        .Height("85%")
                                                        .Title("Add Ledger Account")
                                                        .ShowTitle(true)

                                                        .Visible(false)
                                                        .ResizeEnabled(true)
                                                        .ContentTemplate(@<text>
                                <div id="popupContent" class="background" style="width:100%; height:100%;">
                                    <iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
                                </div>
                            </text>)
                                                        )
                        </div>

                        <!-- Edit Button -->
                        <div class="form-group" style="flex-shrink: 0;">
                          
                            @(Html.DevExtreme().Popup()
                                                        .ID("ledgerEditAccountPopup")
                                                        .Width("93%")
                                                        .Height("85%")
                                                        .Title("Edit Ledger Account")
                                                        .ShowTitle(true)

                                                        .Visible(false)  // Hidden by default
                                                        .ResizeEnabled(true)
                                                        .ContentTemplate(@<text>
                                <div id="popupContent" style="width:100%; height:100%;">
                                    <iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
                                </div>
                            </text>)
                                                        )
                        </div>

                    </div>


                    <div class="form-group" style="flex: 1 1 90px;">
                        @(
                                                Html.DevExtreme().NumberBox()
                                                .Label(new JS("formatMessage('Amount')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("txtVoucherAmount")
                                                .Value(null)
                                                .ValidationRules(rules =>
                                                {
                                                    rules.AddRequired()
                                                    .Message("Voucher Amount Cannot be Zero Or Negative");
                                                    rules.AddRange().Min(0).Message("Voucher Amount Cannot be Zero Or Negative");
                                                })
                                                .Placeholder("0.000")
                                                .Format("###,###,###,##0.00")  // Numeric format with thousands separator and two decimal places
                                                .InputAttr(new { type = "number", step = "0.01", style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;", maxLength = 16, autocomplete = "off" })
                                                
                                                .ElementAttr(new { @class = "white-box" })

                                                )
                    </div>

                    <div class="form-group" >
                        @(Html.DevExtreme().DropDownBox()
                                                .Label(new JS("formatMessage('Base Currency')"))
                                                .DataSource(d => d.WebApi()
                                                .Controller("Utility") // Use same controller or change if needed
                                                .LoadAction("GetCurrencyList")
                                                .LoadMode(DataSourceLoadMode.Raw)
                                                .Key("CurrencyExchangeId")
                                                )
                                                .ValidationRules(rules =>
                                                {
                                                    rules.AddRequired()
                                                    .Message("Please select a base currency.");
                                                })
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("ddlBaseCurrency")
                                                .ShowClearButton(true)
                                                .AcceptCustomValue(false)
                                                .OpenOnFieldClick(true)
                                                .Value(1)
                                                .ValueExpr("CurrencyExchangeId")
                                                .DisplayExpr("CurrencyName")
                                                .OnInput("dropDownBoxOnInput")
                                                .OnOpened("onOpened")
                                                .TabIndex(2)
                                                .DropDownOptions(o => o.Width(700))
                                                .ReadOnly(true)
                                                .ElementAttr(new { @class = "custom-disabled-selectbox" })
                                                .Width(150)
                                                .ContentTemplate(new TemplateName("BaseCurrencyContentTemplate"))
                                                )
                        @using (Html.DevExtreme().NamedTemplate("BaseCurrencyContentTemplate"))
                        {
                            @(Html.DevExtreme().DataGrid()
                                                    .ID("basecurrency-datagrid")
                                                    .DataSource(d => d.WebApi()
                                                    .Controller("Utility")
                                                    .LoadAction("GetCurrencyList")
                                                    .LoadMode(DataSourceLoadMode.Raw)
                                                    .Key("CurrencyExchangeId")
                                                    )
                                                    .WordWrapEnabled(true)
                                                    .ShowBorders(true)
                                                    .Selection(sl => sl.Mode(SelectionMode.Single))
                                                    .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                                                    .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
                                                    .OnSelectionChanged("onBaseCurrencySelectionChanged") // Define this JS function
                                                    .Paging(p => p.PageSize(10))
                                                    .Height(300)
                                                    .Columns(columns =>
                                                    {
                                                        columns.Add().DataField("CurrencyExchangeId").Caption(new JS("formatMessage('ID')")).Visible(true);
                                                        columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')"));
                                                        columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Symbol')"));
                                                        columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')"));
                                                        columns.Add().DataField("CurrencyMasterCode").Caption(new JS("formatMessage('code')")).DataType(GridColumnDataType.Boolean);
                                                        columns.Add().DataField("CurrencyPoints").Caption(new JS("formatMessage('point')")).DataType(GridColumnDataType.Boolean);

                                                    })
                                                    )
                        }


                    </div>

                    <div class="form-group" style="flex: 1 1 50px;">
                        @(Html.DevExtreme().DropDownBox()
                                                .Label(new JS("formatMessage('Convertion Currency')"))
                                                .DataSource(d => d.WebApi()
                                                .Controller("Utility") // Adjust if needed
                                                .LoadAction("GetCurrencyList")
                                                .LoadMode(DataSourceLoadMode.Raw)
                                                .Key("CurrencyExchangeId")
                                                )
                                                .ValidationRules(rules =>
                                                {
                                                    rules.AddRequired()
                                                    .Message("Please select a currency.");
                                                })
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("ddCurrency")
                                                .ShowClearButton(false)
                                                .AcceptCustomValue(false)
                                                .OpenOnFieldClick(true)
                                                .Value(1)
                                                .ValueExpr("CurrencyExchangeId")
                                                .DisplayExpr("CurrencyName")
                                                .OnInput("dropDownBoxOnInput")
                                                .OnOpened("onOpened")
                                                .TabIndex(1)
                                                .DropDownOptions(o => o.Width(700))
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                .ContentTemplate(new TemplateName("CurrencyContentTemplate"))
                                                )
                        @using (Html.DevExtreme().NamedTemplate("CurrencyContentTemplate"))
                        {
                            @(Html.DevExtreme().DataGrid()
                                                    .ID("currency-datagrid")
                                                    .DataSource(d => d.WebApi()
                                                    .Controller("Utility")
                                                    .LoadAction("GetCurrencyList")
                                                    .LoadMode(DataSourceLoadMode.Raw)
                                                    .Key("CurrencyExchangeId")
                                                    )
                                                    .WordWrapEnabled(true)
                                                    .ShowBorders(true)
                                                    .Selection(sl => sl.Mode(SelectionMode.Single))
                                                    .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                                                    .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
                                                    .OnSelectionChanged("onCurrencySelectionChanged")
                                                    .Paging(p => p.PageSize(10))
                                                    .Height(300)
                                                    .Columns(columns =>
                                                    {
                                                        columns.Add().DataField("CurrencyExchangeId").Caption(new JS("formatMessage('ID')")).Visible(true);
                                                        columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')"));
                                                        columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Symbol')"));
                                                        columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')"));
                                                        columns.Add().DataField("CurrencyMasterCode").Caption(new JS("formatMessage('code')")).DataType(GridColumnDataType.Boolean);
                                                        columns.Add().DataField("CurrencyPoints").Caption(new JS("formatMessage('point')")).DataType(GridColumnDataType.Boolean);

                                                    })
                                                    )
                                                }

                    </div>

                    <div class="form-group" style="flex: 1 1 70px;">
                        @(Html.DevExtreme().NumberBox()
                                                .Label("CVR")
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("txtCurrencyRate")
                                                .Value(1)
                                                .Min(0)
                                                .Format("#,##0.00")
                                                .InputAttr(new
                                                {
                                                    style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                                                    type = "number",
                                                    step = "0.01"
                                                })
                                                .ElementAttr(new { @class = "white-box" })
                                                )
                    </div>

                    <div class="form-group plusBtn" style="flex: 1 1 30px;">
                        @(Html.DevExtreme().Button()
                                                .ID("btnVoucherEntry")
                                                .Text(new JS("formatMessage('ADD')"))
                                                .Height(40)
                                                .Width(178)
                                                .Icon("plus")
                                                .ElementAttr(new { @class = "custom-ui-button" })
                                                .OnClick("function() { addVoucherEntry(); }")
                                                )
                    </div>
                </div>
            </div>


          </div>
        <div class="dx-card-body">
            <div class="dx-field ledgerResult">

                @(
                                Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                                .ID("dataGrid")
                                .RemoteOperations(false)
                                .Columns(columns =>
                                {
                                    columns.AddFor(m => m.VoucherEntryNo)
                                    .Caption(new JS("formatMessage('Voucher Entry No')"))
                                    .Visible(false);

                                    columns.AddFor(m => m.DrCr)
                                    .Caption(new JS("formatMessage('Dr/Cr')"))
                                    .DataType(GridColumnDataType.String).AllowEditing(false);



                                    columns.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('Account Head')"))
                                    .CellTemplate(@<text>
                                                       <div style="display: flex; justify-content: space-between; align-items: center;">
                                                           <span>
                                                               <%- data.AccountHead ? data.AccountHead : "No Selection" %>
                                                           </span>
                                                       </div>
                                                   </text>)
                                    .EditCellTemplate(@<text>


                        @(Html.DevExtreme().DropDownBox()
                                            .DataSource(d => d.WebApi()
                                            .Controller("VoucherMaster")
                                            .LoadAction("GetEditAccountHead")
