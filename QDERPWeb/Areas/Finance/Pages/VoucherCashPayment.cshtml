    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function dropDownBoxInput(e) {
        const dropDownBoxInstance = e.component;
        const typedText = dropDownBoxInstance.option("text");

        if (!dropDownBoxInstance.option("opened")) {
            dropDownBoxInstance.open();
        }
        const grid = $(e.component.content()).find("#accounthead-datagrid").first().dxDataGrid("instance");
        if (grid) {
            grid.option("searchPanel.text", typedText);
        }
    }

    function onDropDownBoxClosed(e) {
        const typedText = e.component.option("text");
        const grid = $(e.component.content()).find("#accounthead-datagrid").first().dxDataGrid("instance");

        if (!grid || !typedText) return;

        const visibleRows = grid.getVisibleRows();
        const match = visibleRows.find(r => r.data.AccountHead === typedText);
        
        if (match) {
            const selectedKey = match.data.AccountId;
            grid.selectRows([selectedKey], false); // select the row in the grid
            e.component.option("value", selectedKey); // bind the selected key to DropDownBox
            grid.option("focusedRowIndex", match.rowIndex); // optional: focus the matched row
        } else {
            e.component.option("value", null); // clear if no match found
        }
    }



            function onOpened(e) {
                setTimeout(() => {
                    e.component.focus();
                });
