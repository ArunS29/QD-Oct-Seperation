function showLedgerAccountEditPopup() {
    var dropDownBox = $("#AccountHeadDropDown").dxDropDownBox("instance");

    IsEdit = true;

    // Initialize variables to avoid reference errors
    refno = refno || "";
    accheadar = accheadar || "";
    accheadname = accheadname || "";
    accgroup = accgroup || "";
    accgroupid = accgroupid || "";

    // Validate AccountHead selection
    if (accheadid == null || accheadid == undefined || accheadid=="") { // Checks for both null and undefined
        DevExpress.ui.notify("Please select the AccountHead to edit.", "error", 2000);
        return;
    }

    const url = `/Finance/LedgerAccount?AccountHeadID=${encodeURIComponent(accheadid)}&ReferenceNo=${encodeURIComponent(refno)}&AccountHeadName=${encodeURIComponent(accheadname)}&AccountGroup=${encodeURIComponent(accgroup)}&IsEdit=${IsEdit}&AccountGroupID=${encodeURIComponent(accgroupid)}&AccountHeadAr=${encodeURIComponent(accheadar)}`;

    // Show the popup
    var popupInstance = $("#ledgerEditAccountPopup").dxPopup("instance");
    popupInstance.show();

    // Use DevExtreme popup's `onShown` event to wait for rendering before setting iframe src
    popupInstance.option("onShown", function () {
        var iframe = document.getElementById("ledgerEditAccountFrame");

        if (!iframe) {
            console.error("Error: ledgerEditAccountFrame not found!");
            return;
        }

        // Set iframe src when popup is shown
        iframe.onload = function () {
            console.log("Iframe loaded successfully.");
        };

        iframe.src = url;
    });
}



function onRowRemoving() {
    var dataGrid = $("#dataGrid").dxDataGrid("instance");

    // Get the selected row's data
    var selectedRows = dataGrid.getSelectedRowsData();
    var selectedRowData = selectedRows.length > 0 ? selectedRows[0] : null;

    if (!selectedRowData) {
        DevExpress.ui.notify("No row selected. Please select a row first.", "error", 2000);
        return;
    }

    // Retrieve the unique identifier for the row
    var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
    var voucherEntryNo = selectedRowData.VoucherEntryNo;

    // Validate VoucherEntryNo
    if (!voucherEntryNo) {
        DevExpress.ui.notify("Invalid entry number. Cannot delete.", "error", 2000);
        return;
    }

    // **Ask for confirmation before proceeding**
    confirmDelete(function () {
        // User clicked "Yes", proceed with deletion
        $.ajax({
            url: `/api/VoucherMaster/DeleteVoucherEntry?voucherEntryNo=${encodeURIComponent(voucherEntryNo)}&VoucherNo=${encodeURIComponent(voucherNo)}&PaymentAccoutHeadName=${encodeURIComponent(paymentaccheadname)}`,
            type: "POST",
            success: function (response) {
                if (response.data) {
                    $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
                   // DevExpress.ui.notify("Record deleted successfully!", "success", 2000);
                } else {
                    DevExpress.ui.notify("No updated data returned from the server.", "error", 2000);
                }
            },
            error: function (xhr, status, error) {
                DevExpress.ui.notify("Error deleting record: " + error, "error", 2000);
            }
        });
    });
}


