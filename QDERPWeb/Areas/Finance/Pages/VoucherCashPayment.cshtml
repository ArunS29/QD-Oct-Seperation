    $("#btnAttach").on("click", function (e) {
        e.preventDefault();
        var aVoucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

        $("#attachOptionsPopup").dxPopup({
            visible: false,
            width: 300,
            height: 200,
            showTitle: true,
            title: "Attach Options",
            dragEnabled: true,
            closeOnOutsideClick: true,
            contentTemplate: function (contentElement) {
                // Store `aVoucherNo` in a closure for use inside event handlers
                contentElement.append(
                    `<div>
                        <button id="singleFileBtn" class="dx-button">Attach Single File</button>
                        <button id="multipleFileBtn" class="dx-button">Attach Multiple Files</button>
                     </div>`
                );

                // Single file button click
                $("#singleFileBtn").dxButton({
                    text: "Attach Single File",
                    onClick: function () {
                        attachSingleFile();
                        $("#attachOptionsPopup").dxPopup("instance").hide();
                    }
                });

                // Multiple files button click
                $("#multipleFileBtn").dxButton({
                    text: "Attach Multiple Files",
                    onClick: function () {
                        attachMultipleFiles(aVoucherNo); // Pass `aVoucherNo` here
                        $("#attachOptionsPopup").dxPopup("instance").hide();
                    }
                });
            }
        });
    });

    function onAttachButtonClick() {
        $("#attachOptionsPopup").dxPopup("instance").show();
    }

    function attachSingleFile() {
        // Logic for attaching a single file
        DevExpress.ui.notify("Single file attach initiated.", "info", 2000);
    }

    function attachMultipleFiles(aVoucherNo) {
        // Logic for attaching multiple files
        DevExpress.ui.notify(`Multiple file attach initiated for Voucher No: ${aVoucherNo}`, "info", 2000);
        window.location.href = `/Finance/LedgerDocuments?VoucherNo=${encodeURIComponent(aVoucherNo)}`;
    }



    $(function () {
        $.ajax({
            url: "/api/VoucherMaster/GetNewCPVoucherNo",
            type: 'GET',
            success: function (data) {
                // Set the value in the VoucherNo TextBox
                $("#VoucherNo").dxTextBox("instance").option("value", data);

                // Retrieve the value from the TextBox
                var popvno = $("#VoucherNo").dxTextBox("instance").option("value");

                // Set the value in the PopVoucherNo TextBox
                // $("#PopVoucherNo").dxTextBox("instance").option("value", popvno);

                // // Show the alert with the value
                // alert(popvno);
                // console.log.println(popvno);
            },
            error: function (xhr, status, error) {
                console.error("Error loading Voucher No:", error);
            }
        });
    });

    function showChequePopup() {

        $("#chequePopup").dxPopup("instance").show();

        $.ajax({
            url: "/api/VoucherMaster/GetNewCPVoucherNo",
            type: 'GET',
