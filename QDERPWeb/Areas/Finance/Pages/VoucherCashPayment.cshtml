    function fetchVoucherEntries(voucherNo) {
        $.ajax({
            type: "GET",
            url: "/api/VoucherMaster/LoadVoucherEntries",
            contentType: "application/json",
            data: { voucherNo: voucherNo },
            success: function (response) {
                if (!response || !response.data || response.data.length === 0) {
                    // DevExpress.ui.notify("No voucher entries found.", "warning", 2000);
                    return;
                }
                
                var lastRow = response.data[response.data.length - 1]; // Get the last row
                var dropDownBox = $("#accountDropDownBox").dxDropDownBox("instance");

                if (dropDownBox) {
                    // Set selected value based on what the DropDownBox expects
                    // Assuming ValueExpr is "AccountId", and AccountId is present in `lastRow`
                    dropDownBox.option("value", lastRow.AccountHead); // or lastRow.AccountId if available
                }
                var dataGrid = $("#dataGrid").dxDataGrid("instance");
                if (dataGrid) {
                    dataGrid.option("dataSource", response.data);
                    var button = $("#btnSave").dxButton("instance");
                    button.option("text", "Update");
                } else {
                    $("#dataGrid").dxDataGrid({
                        dataSource: response.data,
                        keyExpr: "VoucherEntryNo",
                        repaintChangesOnly: true,
                        editing: {
                            mode: "cell",
                            allowUpdating: true, // Enable editing
                        },
                        onRowUpdated: function (e) {
                            saveUpdatedVoucherEntry(e.data);
                        },
                        columns: [
                            { dataField: "VoucherEntryNo", caption: "Entry No", allowEditing: false },
                            { dataField: "DrCr", caption: "Dr/Cr", allowEditing: false },
                            {
                                dataField: "AccountHead",
                                caption: "Account Head",
                                allowEditing: true, // Make this column editable
                                lookup: {
                                    dataSource: new DevExpress.data.CustomStore({
                                        loadMode: "raw",
                                        key: "AccountId",
                                        load: function () {
                                            return $.getJSON("/api/VoucherMaster/GetEditAccountHead");
                                        }
                                    }),
                                    valueExpr: "AccountId",
                                    displayExpr: "AccountHead"
                                }
                            },
                            { dataField: "DrAmount", caption: "Debit Amount", dataType: "number", allowEditing: false },
                            { dataField: "CrAmount", caption: "Credit Amount", dataType: "number", allowEditing: false },
                            { dataField: "EntryNarration", caption: "Narration", allowEditing: false },
                            { dataField: "SysRemarks", caption: "Remarks", allowEditing: false }
                        ]
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching voucher entries:", error);
                // DevExpress.ui.notify("Error fetching voucher entries.", "error", 2000);
            }
        });
    }


    function onVoucherDateChanged(e) {
        console.log("Selected Date:", e.value);
        var voucherDate = $("#VoucherDate").dxDateBox("instance");
        var effectiveDate = $("#VoucherEffectiveDate").dxDateBox("instance");

        voucherDate.option("onValueChanged", function (e) {
            let voucherDateval = e.value; // Get Date from DevExtreme DateBox

            // Check if voucherDateval is valid
            if (!voucherDateval) return;

            // Set effectiveDate to the same value as voucherDate
            effectiveDate.option("value", voucherDateval);

            // Convert to 'yyyy-MM-dd' format
            let formattedDate = new Date(voucherDateval).toISOString().split("T")[0];

            // Define the cutoff date (2021-12-31)
            let cutoffDate = new Date("2021-12-31");

            // Get the current date to set if the voucher date is blocked
            let currentdate = new Date();
            let formattedCurrentDate = currentdate.toISOString().split("T")[0]; // Format it as 'yyyy-MM-dd'

            // Check if the formatted voucher date is before the cutoff date
            if (new Date(formattedDate) < cutoffDate) {
                // Show alert for blocked entry
                DevExpress.ui.dialog.alert("This Voucher Entry date has been blocked. Please review your entry date.", "Blocked Entry");

                // Set both voucherDate and effectiveDate to the current date
                voucherDate.option("value", formattedCurrentDate);
                effectiveDate.option("value", formattedCurrentDate);
            }
        });
    }

    function onRowUpdating(e) {
        const updatedData = e.newData;
        const key = e.key; // Get primary key value if needed

        let dataGrid = $("#dataGrid").dxDataGrid("instance");
        let allData = dataGrid.option("dataSource");

        // Find the row being updated
        let rowIndex = allData.findIndex(row => row.VoucherEntryNo === key.VoucherEntryNo);
        let oldRowData = allData[rowIndex];

        if (!oldRowData) return; // Exit if row not found

        let oldAccountHead = oldRowData.AccountHead;
        let newAccountHead = updatedData.AccountHead !== undefined
            ? (Array.isArray(updatedData.AccountHead) ? updatedData.AccountHead[0] : updatedData.AccountHead)
            : oldRowData.AccountHead;

        let requestData = {
            VoucherEntryNo: oldRowData.VoucherEntryNo,
            DrCr: updatedData.DrCr || oldRowData.DrCr,
            AccountHead: newAccountHead,
            DrAmount: updatedData.DrAmount || e.oldData.DrAmount,
            CrAmount: updatedData.CrAmount || e.oldData.CrAmount,
            EntryNarration: updatedData.EntryNarration || oldRowData.EntryNarration,
            SysRemarks: updatedData.SysRemarks || oldRowData.SysRemarks
        };



        if (oldRowData.DrCr === "Dr") {
            
            // Find all corresponding "Cr" rows
            let drRows = allData.filter(row => row.DrCr === "Cr" && row.SysRemarks.includes(oldAccountHead));

            if (drRows.length > 0) {
                drRows.forEach(drRow => {
                    // Replace "Received by : oldAccountHead" with newAccountHead
                    drRow.SysRemarks = drRow.SysRemarks.replace(oldAccountHead, newAccountHead);

                    // Send update to backend for each "Cr" row
                    $.ajax({
                        url: "/api/VoucherMaster/UpdateVoucherEntry",
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(drRow),
                success: function(response) {
                            console.log("Cr row updated successfully");

                            // Update allData directly
                            allData.forEach(row => {
                                if (row.VoucherEntryNo === drRow.VoucherEntryNo) {
                                    row.SysRemarks = drRow.SysRemarks;
                                }
                            });
                            dataGrid.option("dataSource", allData);
                            // Refresh the specific row instead of reloading the entire data source
                            dataGrid.refresh();
                        },
                error: function(xhr) {
                            DevExpress.ui.notify("Error updating Cr row", "error", 2000);
                            console.error("Error Response:", xhr.responseText);
                        }
                    });
                });
            }
        }




        if (oldRowData.DrCr === "Cr") {
            
            // Find all corresponding "Cr" rows
            let crRows = allData.filter(row => row.DrCr === "Dr" && row.SysRemarks.includes(`Paid thru: ${oldAccountHead}`));

            if (crRows.length > 0) {
                crRows.forEach(crRow => {
                    // Replace "Received by : oldAccountHead" with newAccountHead
                    crRow.SysRemarks = crRow.SysRemarks.replace(`Paid thru: ${oldAccountHead}`, `Paid thru: ${newAccountHead}`);

                    // Send update to backend for each "Cr" row
                    $.ajax({
                        url: "/api/VoucherMaster/UpdateVoucherEntry",
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(crRow),
                success: function(response) {
                            console.log("Cr row updated successfully");

                            // Update allData directly
                            allData.forEach(row => {
                                if (row.VoucherEntryNo === crRow.VoucherEntryNo) {
                                    row.SysRemarks = crRow.SysRemarks;
                                }
                            });
                            dataGrid.option("dataSource", allData);
                            // Refresh the specific row instead of reloading the entire data source
                            dataGrid.refresh();
                        },
                error: function(xhr) {
                            DevExpress.ui.notify("Error updating Cr row", "error", 2000);
                            console.error("Error Response:", xhr.responseText);
                        }
                    });
                });
            }
        }


        console.log("Request Payload:", requestData);

        // Update the "Cr" row in backend
        $.ajax({
            url: "/api/VoucherMaster/UpdateVoucherEntry",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(requestData),
        success: function(response) {
                fetchUpdatedData(requestData.VoucherEntryNo);
            },
        error: function(xhr) {
                DevExpress.ui.notify("Error updating Voucher Entry", "error", 2000);
                console.error("Error Response:", xhr.responseText);
            }
        });
    }

    // Function to fetch updated data from Qry201VoucherEntryScreenDisplay
    function fetchUpdatedData(voucherEntryNo) {
        $.ajax({
            url: "/api/VoucherMaster/GetVoucherEntry?VoucherEntryNo=" + voucherEntryNo, // Adjust API endpoint as needed
            type: "GET",
        success: function(data) {
                console.log("Updated Data:", data); // Debug response
                let dataGrid = $("#dataGrid").dxDataGrid("instance");

                // Find the row index of the updated VoucherEntryNo and update that row
                let allData = dataGrid.option("dataSource");
                let rowIndex = allData.findIndex(row => row.VoucherEntryNo === voucherEntryNo);

                if (rowIndex !== -1) {
                    allData[rowIndex] = data; // Update the specific row with new data
                    dataGrid.option("dataSource", allData); // Set updated data
                    dataGrid.refresh(); // Refresh the DataGrid
                    DevExpress.ui.notify("Voucher Entry updated successfully", "success", 2000);
                } else {
                    // If row not found, reload the entire grid
                    dataGrid.refresh();
                }
            },
        error: function(xhr) {
                DevExpress.ui.notify("Error fetching updated data", "error", 2000);
                console.error("Fetch Error:", xhr.responseText); // Log error response
            }
        });
    }
