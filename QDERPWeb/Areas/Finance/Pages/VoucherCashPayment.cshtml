@page
@using QD.ERP.Web.DAL.Entities
@using QD.ERP.Web.Service

@{
  
    ViewData["Title"] = "Payment Voucher Details";
    var popvno = "";
    // pull your session value (“2”) into baseCurrencyIdnew
    var sessionID = HttpContext.Session.GetString("currencyID");
    int baseCurrencyIdnew = 0;
    if (!string.IsNullOrEmpty(sessionID))
        int.TryParse(sessionID, out baseCurrencyIdnew);
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<link rel="stylesheet" href="~/css/Style.css" />
<style>
 #contextMenu {
        position: absolute;
        display: none;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        /* 👇 Control size */
        width: 200px; /* adjust as needed */
        max-height: 300px; /* set a limit */
        overflow-y: auto; /* scroll if items overflow */
        /* 👇 Control appearance */
        font-size: 10px;
        padding: 6px 0;
        z-index: 9999;
    }

        #contextMenu:focus {
            outline: none; /* removes black border */
        }

        #contextMenu ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        #contextMenu li {
            padding: 4px 10px;
            cursor: pointer;
            white-space: nowrap;
        }

            #contextMenu li.active .custom-dropdown-item {
                background-color: var(--title-background-color) !important;
            }

            #contextMenu li:hover {
                background: #f0f0f0;
            }

    /* Make focused row look like hover row */
    #accounthead-datagrid .dx-datagrid-rowsview .dx-row.dx-row-focused {
        background-color: var(--title-background-color) !important; /* same as hover */
        color: inherit; /* keep text readable */
    }

    .titleCard-toggle1{
        display:none;
    }
   .footer-fixed{
       bottom:37px!important;
   }
    #dataGrid .dx-command-edit .dx-link-delete,
    #dataGrid .dx-command-edit .dx-link-delete .dx-icon,
    #dataGrid .dx-command-edit .dx-link-delete.dx-icon,
    #dataGrid .dx-command-edit .dx-link-delete .dx-icon-trash,
    #dataGrid .dx-command-edit .dx-link-delete.dx-icon-trash {
        color: red !important; /* font-based icons */
        
    }
</style>


    
<div class="content-container-top">

    <div class="dx-card-container">
        <div class="dx-card-header minimal-header">
            <div class="card-title-icon">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
             <div id="CashPaymentVoucher" class="titleText no-border-title"></div>
            <h3 class="card-title-text"></h3>
        </div>

        <div class="dx-card-body">
            <div class="form-container" style="display: flex; flex-wrap: wrap; align-items: flex-end; position: relative; padding: 0 15px; overflow-x: hidden;">

                <!-- Top Row -->
                <div class="row w-100 align-items-center" style="margin-top: 8px;">
                  <div class="form-group col-md-1 col-sm-6">
                        @(Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessage('Voucher No')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("VoucherNo")
                            .Value("")
                            .Disabled(true)
                            .TabIndex(0)
                            .OnValueChanged("onVoucherNoChanged")
                                                .ValidationRules(rules =>
                                                {
                                                    rules.AddRequired()
                                                    .Message("Voucher No is required"); // Add spacing in the error message
                                                })
                                                .ElementAttr(new { @class = "custom-disabled-textbox" }) // Use CSS for better disabled styling
                            )
                    </div>

                  <div class="form-group col-md-2 col-sm-6">
                        @(Html.DevExtreme().DateBox()
                            .Label(new JS("formatMessage('Voucher Date')"))
                            .ID("VoucherDate")
                            .InputAttr("aria-label", "Date")
                            .LabelMode(EditorLabelMode.Floating)
                            .Type(DateBoxType.Date)
                            .DisplayFormat("dd-MMM-yyyy")
                            .Value(DateTime.Now)
                            .OnValueChanged("onVoucherDateChanged")
                            .ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })
                            .TabIndex(1)
                            .ApplyValueMode(EditorApplyValueMode.UseButtons) // shows Today/OK/Cancel
			                .ShowClearButton(true) // shows clear (X) button
 
                            )
                    </div>

                  <div class="form-group col-md-2 col-sm-6">
                        @(Html.DevExtreme().DateBox()
                            .Label(new JS("formatMessage('Effective Date')"))
                            .ID("VoucherEffectiveDate")
                            .InputAttr("aria-label", "Date")
                            .LabelMode(EditorLabelMode.Floating)
                            .Type(DateBoxType.Date)
                            .DisplayFormat("dd-MMM-yyyy")
                            .Value(DateTime.Now)
                            .OnValueChanged("onVoucherDateChanged")
                            .ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })
                            .TabIndex(2)
                            .ApplyValueMode(EditorApplyValueMode.UseButtons) // shows Today/OK/Cancel
			                .ShowClearButton(true) // shows clear (X) button
 
                            )
                    </div>

                  <div class="form-group col-md-7 col-sm-12">
                        @(Html.DevExtreme().DropDownBox()
                            .Label(new JS("formatMessage('Payment Account')"))
                            .DataSource(d => d.WebApi().Controller("VoucherMaster").LoadAction("GetCPPaymentAccounts").LoadMode(DataSourceLoadMode.Raw).Key("AccountHead"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("accountDropDownBox")
                            .ShowClearButton(true)
                            .AcceptCustomValue(true)
                            .OpenOnFieldClick(false)
                            .ValueChangeEvent("input")
                            .HoverStateEnabled(true)
                            .ValueExpr("AccountId")
                            .DisplayExpr("AccountHead")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("onOpened")
                            .TabIndex(3)
                            .DropDownOptions(o => o.Width(1000))
                            .ElementAttr(new { @class = "white-dropdownbox" })
                            .OnKeyDown("onKeyDown")
                            .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                            )
                    </div>
                </div>

                <!-- Second Row -->
             <div class="row w-100 align-items-center" style="margin-top: 8px;">
                     <div class="form-group col-md-1 col-sm-6">
                        @(Html.DevExtreme().SelectBox()
                            .Label(new JS("formatMessage('Dr/Cr')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("sbDrCr")
                            .DataSource(new[] { "Dr", "Cr" })
                            .Value("Dr")
                            .OnValueChanged("onVoucherDrCrValueChanged")
                            .Placeholder("Select Transaction Type")
                            .ReadOnly(false)
                            .ElementAttr(new { @class = "custom-disabled-selectbox" })
                             .TabIndex(0)
                            )
                    </div>

                    <!-- Container for Account Head & Buttons -->
                    

                        <!-- DropDownBox: Flex-grow to fill available space -->
                        <div class="form-group col-md-4 col-sm-12">

                            @( Html.DevExtreme().DropDownBox()
                                .ID("ddAccountHead")
                                .DataSource(d => d.WebApi()
                                .Controller("VoucherMaster")
                                .LoadAction("GetAccountHead")
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("AccountHead"))
                                .ValueExpr("AccountId")
                                .DisplayExpr("AccountHead")
                                .Label(new JS("formatMessage('Account Head')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ValidationRules(rules => rules
                                .AddRequired()
                                .Message(new JS("formatMessage('Ledger Account should be entered')")))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("ddAccountHead")
                                .ShowClearButton(true)
                                .AcceptCustomValue(true)
                                .OpenOnFieldClick(false)
                                .ValueChangeEvent("input")
                                .HoverStateEnabled(true)
                                .DropDownOptions(o => o.Width(1000))
                                .ElementAttr(new { @class = "white-dropdownbox" })
                                .OnKeyDown("onKeyDown")
                                .OnInput("dropDownBoxOnInput")
                                .OnOpened("onOpened")
                                .OnClosed("onDropDownBoxClosed")
                                 .TabIndex(4)
                                .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
    .Buttons(buttons => {
        // Built-in clear button
        buttons.Add()
            .Name("clear");

     buttons.Add()
    .Name("addLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("plus")
        .ElementAttr(new { @class = "custom-hover-button add-hover" })
        .OnClick("showLedgerAccountPopup"));

buttons.Add()
    .Name("editLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("edit")
        .ElementAttr(new { @class = "custom-hover-button edit-hover" })
        .OnClick("showLedgerAccountEditPopup"));



        buttons.Add()
        .Name("dropDown");
    })
                                            )
                        </div>

          
                           
                            <!-- DevExtreme Popup -->
                            @(Html.DevExtreme().Popup()
                                                        .ID("ledgerAccountPopup")
                                                        .Width("93%")
                                                        .Height("85%")
                                                        .ShowTitle(true)
                                                        .Title(new JS("formatMessage('Add Ledger Account')"))
                                                        .Visible(false)
                                                        .ResizeEnabled(true)
                                                        .ContentTemplate(@<text>
                                <div id="popupContent" class="background" style="width:100%; height:100%;">
                                    <iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
                                </div>
                            </text>)
                                                        )
                    

                
                           
                            @(Html.DevExtreme().Popup()
                                                        .ID("ledgerEditAccountPopup")
                                                        .Width("93%")
                                                        .Height("85%")
                                                        .ShowTitle(true)
                                                        .Title(new JS("formatMessage('Edit Ledger Account')"))
                                                        .Visible(false)  // Hidden by default
                                                        .ResizeEnabled(true)
                                                        .ContentTemplate(@<text>
                                <div id="popupContent" style="width:100%; height:100%;">
                                    <iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
                                </div>
                            </text>)
                                                        )
                       

                   


                  <div class="form-group col-md-2 col-sm-6">
                        @(Html.DevExtreme().NumberBox()
                            .Label(new JS("formatMessage('Amount')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("txtVoucherAmount")
                            .Value(0)
                            .TabIndex(5)
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired().Message("Voucher Amount Cannot be Zero Or Negative");
                                rules.AddRange().Min(0).Message("Voucher Amount Cannot be Zero Or Negative");
                            })
                            
                            .Format("###,###,###,##0.00")
                            .InputAttr(new
                            {
                                type = "number",
                                step = "0.01",
                                style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                                maxLength = 16,
                                autocomplete = "off"
                            })
                            .ElementAttr(new { @class = "white-box" })
                            .Max(99999999)
                            )
                    </div>

                  <div class="form-group col-md-2 col-sm-6">
    @(Html.DevExtreme().DropDownBox()
        .ID("ddlBaseCurrency")
        .DataSource(d => d.WebApi()
            .Controller("Utility")
            .LoadAction("GetCurrencyList")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("CurrencyExchangeId")
        )
        .ValueExpr("CurrencyExchangeId")
        .DisplayExpr("CurrencyName")
        // now use your renamed variable
        .Value(baseCurrencyIdnew)
        .Label(new JS("formatMessage('Base Currency')"))
        .LabelMode(EditorLabelMode.Floating)
        .ValidationRules(rules => rules.AddRequired().Message("Please select a base currency."))
        .ShowClearButton(true)
        .AcceptCustomValue(false)
        .DropDownOptions(o => o.Width(300))
        .ReadOnly(true)
        .ElementAttr(new { @class = "custom-disabled-selectbox" })
    )
</div>

                  <div class="form-group col-md-2 col-sm-6">
                        @(Html.DevExtreme().DropDownBox()
                            .Label(new JS("formatMessage('Convertion Currency')"))
                            .DataSource(d => d.WebApi().Controller("Utility").LoadAction("GetCurrencyList").LoadMode(DataSourceLoadMode.Raw).Key("CurrencyExchangeId"))
                            .ValidationRules(rules => rules.AddRequired().Message("Please select a currency."))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("ddCurrency")
                            .ShowClearButton(false)
                            .AcceptCustomValue(false)
                            .OpenOnFieldClick(true)
                             .TabIndex(6)
                            .ValueExpr("CurrencyExchangeId")
                            .DisplayExpr("CurrencyName")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("loadCurrencyGridOnOpen")
                            .Value(baseCurrencyIdnew)
                            .DropDownOptions(o => o.Width(700))
                            .ElementAttr(new { @class = "light-theme-input" })
                            .ContentTemplate(new TemplateName("CurrencyContentTemplate"))
                         // .OnInitialized("onBaseCurrencyInit")
                            )
                        @using (Html.DevExtreme().NamedTemplate("CurrencyContentTemplate"))
                        {
                            @(Html.DevExtreme().DataGrid()
                                                    .ID("currency-datagrid")
                                                    .DataSource(d => d.WebApi()
                                                    .Controller("Utility")
                                                    .LoadAction("GetCurrencyList")
                                                    .LoadMode(DataSourceLoadMode.Raw)
                                                    .Key("CurrencyExchangeId")
                                                    )
                                                    .WordWrapEnabled(true)
                                                    .ShowBorders(true)
                                                    .Selection(sl => sl.Mode(SelectionMode.Single))
                                                    .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                                                    .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
                                                    .OnSelectionChanged("onCurrencySelectionChanged")
                                                    .Paging(p => p.PageSize(10))
                                                    .Height(300)
                                                    .Columns(columns =>
                                                    {
                                                        columns.Add().DataField("CurrencyExchangeId").Caption(new JS("formatMessage('ID')")).Visible(true);
                                                        columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')"));
                                                        columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Symbol')"));
                                                        columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')")).Format(format => format.Type(Format.FixedPoint).Precision(2)).CustomizeText("function(cellInfo) { if (cellInfo.value < 0) { return '(' + Math.abs(cellInfo.value).toFixed(2) + ')'; } return cellInfo.value.toFixed(2); }");
                                                        columns.Add().DataField("CurrencyMasterCode").Caption(new JS("formatMessage('code')")).DataType(GridColumnDataType.Boolean);
                                                        columns.Add().DataField("CurrencyPoints").Caption(new JS("formatMessage('point')")).DataType(GridColumnDataType.Boolean);

                                                    })
                                                    )
                         }


                    </div>

                  <div class="form-group col-md-1 col-sm-6">
                        @(Html.DevExtreme().NumberBox()
                            .Label("CVR")
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("txtCurrencyRate")
                            .Value(1)
                            .Min(0)
                            .Max(99999)
                             .TabIndex(7)
                            .Format("#,##0.00")
                            .InputAttr(new
                            {
                                style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                                type = "number",
                                step = "0.01"
                            })
                            .ElementAttr(new { @class = "white-box" })
                            )
                    </div>
                </div>

                <!-- Third Row -->
                <div class="row w-100 align-items-center" style="margin-top: 8px;">
                    <div class="form-group col-11">
                        @(Html.DevExtreme().TextArea()
                            .Label(new JS("formatMessage('Narration')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("txtEntryNarration")
                            .Placeholder("")
                            .Value("")
                            .TabIndex(8)
                            .ElementAttr(new { @class = "light-theme-input" })
                            )
                    </div>
                    <div class="form-group plusBtn col-1 mt-0 h-100">
                        @(Html.DevExtreme().Button()
                            .ID("btnVoucherEntry")
                            .Text(new JS("formatMessage('ADD')"))
                            .Height(40)
                            .TabIndex(9)
                            .StylingMode(ButtonStylingMode.Contained)
                            .ElementAttr(new { @class = "custom-ui-button" })
                            .Icon("plus")
                            .OnClick("function() { addVoucherEntry(); }")
                            )
                    </div>
                </div>
            </div>
        </div>
   

      <div class="dx-card-body">
        <div class="dx-field ledgerResult">

            @(
                        Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                        .ID("dataGrid")
                        .RemoteOperations(false)
                        .Columns(columns =>
                        {
                            columns.AddFor(m => m.VoucherEntryNo)
                        .Caption(new JS("formatMessage('Voucher Entry No')"))
                        .Visible(false);

                            columns.AddFor(m => m.DrCr)
                        .Caption(new JS("formatMessage('Dr/Cr')"))
                        .DataType(GridColumnDataType.String).AllowEditing(false);



                        columns.AddFor(m => m.AccountHead).DataField("AccountId").Caption(new JS("formatMessage('Account Head')"))
                        .CellTemplate(@<text>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span>
                        <%- data.AccountHead ? data.AccountHead : "No Selection" %>
                    </span>
                </div>
            </text>)
                    .EditCellTemplate(@<text>


                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("VoucherMaster")
                .LoadAction("GetEditAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )
                .LabelMode(EditorLabelMode.Floating)
                .ID("accountDropDownBoxEdit")
                .ShowClearButton(true)
                .AcceptCustomValue(false)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change")
                .HoverStateEnabled(true)
                .Value(new JS("data.AccountHead"))
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .OnValueChanged("gridData_valueChanged")
                .OnOpened("onOpened")
                @* .Width(250) *@
                .TabIndex(12)
                .DropDownOptions(o => o.Width(500))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("AccountHeadEditDropdownContentTemplate"))
                )


            </text>);

                            columns.AddFor(m => m.DrAmount).Caption(new JS("formatMessage('Debit')")).Alignment(HorizontalAlignment.Right).CustomizeText(
                        "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                        ).AllowEditing(false) .CalculateCellValue("function(data) { " +
                                    "    if (data.DrAmount != null) { " +
                                    "        var currencyRate = $('#txtCurrencyRate').dxNumberBox('instance').option('value'); " +
                                     "        currencyRate = Math.round(currencyRate * 100) / 100; " +
                                    "        var val = data.DrAmount / currencyRate; " +
                                    "        return Math.round(val * 100) / 100; " + // keep 2 decimals as number
                                    "    } " +
                                    "    return null; " +
                                    "}")
                                    .CustomizeText("function(e) { " +
                                    "return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
                                    "}");



                            columns.AddFor(m => m.CrAmount)
                        .Caption(new JS("formatMessage('Credit')"))
                        .AllowEditing(false)
                        .Alignment(HorizontalAlignment.Right)
                        .AllowEditing(false)
                    @* .EditCellTemplate(@<input dx-number-box data-bind="value: $data.CrAmount" />) *@
                   .CalculateCellValue("function(data) { " +
                                    "    debugger; " +
                                    "    if (data.CrAmount != null) { " +
                                    "        var currencyRate = $('#txtCurrencyRate').dxNumberBox('instance').option('value'); " +
                                     "        currencyRate = Math.round(currencyRate * 100) / 100; " +
                                    "        var val = data.CrAmount / currencyRate; " +
                                    "        return Math.round(val * 100) / 100; " + // keep 2 decimals as number
                                    "    } " +
                                    "    return null; " +
                                    "}")
                                    .CustomizeText("function(e) { " +
                                    "return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
                                    "}");


                            columns.AddFor(m => m.EntryNarration)
                        .Caption(new JS("formatMessage('Entry Narration')"))
                        .AllowEditing(true) // Allow editing for this column

                        ;


                            columns.AddFor(m => m.SysRemarks)
                        .Caption(new JS("formatMessage('Remarks')"))
                        .AllowEditing(false)
                        ;
                            columns.Add()
                            .Type(GridCommandColumnType.Buttons)
                            .Buttons(buttons =>
                            {
                                
                                buttons.Add().Name(GridColumnButtonName.Delete);
                            })
                        .HeaderCellTemplate(@<text>
                    <div style="display: flex; justify-content: center; gap: 6px;">
                       
                        <i class="dx-icon dx-icon-trash" title="Delete" style="color: red !important;"></i>
                    </div>
                </text>)
                            .Width(50); // Adjust width as needed


                        })
                    .Selection(selection => selection.Mode(SelectionMode.Single))
                    .AllowColumnReordering(true)
				.ColumnResizingMode(ColumnResizingMode.Widget)
                    .AllowColumnResizing(true)   // Enable column resizing
                    .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                                                                  //.HeaderFilter(filter => filter.Visible(true))
                    .Height(250)
                    .ColumnAutoWidth(true)
                    .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                    .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                    .ShowBorders(true)
                    .Width("100%")
                  
                    .Editing(editing => editing
                    .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                    .AllowUpdating(true)   // Enable editing of existing rows
                     .AllowDeleting(true)   // Enable deleting rows
                     .UseIcons(true) // Enables icons for editing buttons
                    )
                    .OnEditorPreparing("onEditorPreparing")
                    .OnRowUpdating("onRowUpdating")
                    .OnRowRemoving("onRowRemoving") // Ensure correct capitalization
                         .OnRowPrepared(@"
            function(e) {
                               
                                if (e.rowType === 'data' && e.data.DrCr === 'Cr') {
                                $(e.rowElement).css('background-color', 'var(--header-color) !important');
                                
                                }
                                if (e.rowType === 'data' && e.data.DrCr === 'Dr') {
                                $(e.rowElement).css('background-color', 'var(--title-background-color) !important');
                                $(e.rowElement).find('td').css('color', 'white');
                                
                                }
            }
            ")
                    .Summary(summary =>

                    {

                        summary.TotalItems(totalItems =>

                        {

                            totalItems.Add().Column("DrAmount").SummaryType(SummaryType.Sum)

                         .CustomizeText("function(e) { " +
                                    "return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
                                    "}");
                            totalItems.Add().Column("CrAmount").SummaryType(SummaryType.Sum)

                          .CustomizeText("function(e) { " +
                                    "return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
                                    "}");
                        });

                    })
                    )


        </div>
      </div>


        <div id="chequePopupContainer"></div>


      <ul id="contextMenu" class="context-menu" style="display:none; position:absolute;"></ul>


        <div id="popupContainer">
            @(Html.DevExtreme().Popup()
                    .ID("CostAllocationPopup")
                    .Title(new JS("formatMessage('Cost Allocation')"))
                    .Width("100%")
                    .Height(500)
                    
                    .Visible(false)
                    .ShowCloseButton(true)
                    .ResizeEnabled(true)
                    .DragEnabled(true)
                    .ShowTitle(true)
                   .OnShowing("hideMainFooter")
                        .OnHiding("showMainFooter")
                    )
        </div>
        <div id="popupContainer">
            @(Html.DevExtreme().Popup()
                    .ID("PropertyAllocationPopup")
