        <div class="dx-card-body">
            <div class="form-container" style="display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; position: relative; padding: 0 15px;">

                <!-- Top Row -->
                <!-- Single Row for Cheque No, Popup, Voucher Narration, Attachment -->
                <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: nowrap; width: 100%;">

                    <!-- Cheque No: Smaller width -->
                    <div style="display: flex; align-items: flex-end; gap: 5px; flex: 0 0 320px; min-width: 300px;">
                        <div style="flex-grow: 1;">
                            @(
                                                        Html.DevExtreme().TextBox()
                                                        .Label(new JS("formatMessage('Cheque No/Reference No')"))
                                                        .ID("ChequeNoReferenceNo")
                                                        .Value(null)
                                                        .LabelMode(EditorLabelMode.Floating)
                                                        .Width("100%")
                                                        .ElementAttr(new { @class = "light-theme-input" })
                                                        )
                        </div>

                        <div style="flex-shrink: 0;">
                            @(Html.DevExtreme().Button()
                                                        .ID("btnChequePopup")
                                                        .Icon("money")
                                                        .Height(40)
                                                        .Width(60)
                                                        .ElementAttr(new { @class = "custom-ui-button" })
                                                        .OnClick("showChequePopup")
                                                        )
                        </div>
                    </div>

                    <!-- Voucher Narration: Wider -->
                    <div style="flex: 1 1 auto; min-width: 280px;">
                        @(Html.DevExtreme().TextBox()
                                                .Label(new JS("formatMessage('Voucher Narration')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("VoucherNarration")
                                                .Value(null)
                                                .Height(60)
                                                .Width("100%")
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                )
                    </div>

                    <!-- Attachment Button: Fixed width -->
                    <div style="flex-shrink: 0;">
                        @(Html.DevExtreme().Button()
                                                .ID("btnAttachment")
                                                .Icon("fa fa-paperclip")
                                                .ElementAttr("class", "custom-popup-button")
                                                .OnClick("onAttachButtonClick")
                                                .ElementAttr("class", "custom-icon-color"))
                    </div>

                </div>



                <!-- MIDDLE ROW GROUPING -->
                <div style="display: flex; width: 100%; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 10px;">
                    <div class="form-group" style="flex: 1 1 100px;">
                        @(Html.DevExtreme().TextBox()
                                                .Label(new JS("formatMessage('Bill No')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("BillNo")
                                                .Value(null)
                                                
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                )
                    </div>

                    <div class="form-group" style="flex: 1 1 80px;">
                        @(Html.DevExtreme().DateBox()
                                                .Label(new JS("formatMessage('Bill Date')"))
                                                .ID("BillDate")
                                                .InputAttr("aria-label", "Date")
                                                .LabelMode(EditorLabelMode.Floating)
                                                .Type(DateBoxType.Date)
                                                .DisplayFormat("dd-MMM-yyyy")
                                                .Value("")
                                                .ElementAttr(new { @class = "light-theme-input" })

                                                )
                    </div>

                    <div class="form-group" style="flex: 1 1 80px;">
                        @(Html.DevExtreme().TextBox()
                                                .Label(new JS("formatMessage('Bill Paid To')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("BillPaidTo")
                                                .Value(null)
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                )
                    </div>

                    <div class="form-group" style="flex: 1 1 370px;">
                        @(Html.DevExtreme().TextBox()
                                                .Label(new JS("formatMessage('Remarks')"))
                                                .LabelMode(EditorLabelMode.Floating)
                                                .ID("Remarks")
                                                .Value(null)
                                                .Width("650px")
                                                .ElementAttr(new { @class = "light-theme-input" })
                                                )
                    </div>
                </div>

                <!-- Remaining Fields -->
                <div class="form-group" style="flex: 1 1 120px;">
                    @(
                                        Html.DevExtreme().SelectBox()
                                        .Label(new JS("formatMessage('Cash Payment')"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        .ID("VoucherType")
                                        .DataSource(new[] { "Cash Payment" })
                                        .Value(new JS("formatMessage('Cash Payment')"))
                                        .Width(520)
                                        .Disabled(true)

                                        )
                </div>

                <div class="form-group" style="flex: 1 1 95px;">
                    @(Html.DevExtreme().CheckBox()
                                        .Text(new JS("formatMessage('Verified By')"))
                                        .ID("VerifiedBy")
                                        .ReadOnly(true)
                                        )
                    @(Html.DevExtreme().TextBox()
                                        .ID("VerifiedBytext")
                                        .Value(null)
                                        .Disabled(true)
                                        .ElementAttr(new { @class = "custom-disabled-textbox" })
                                        )
                </div>

                <div class="form-group" style="flex: 1 1 95px;">
                    @(Html.DevExtreme().CheckBox()
                                        .Text(new JS("formatMessage('Approved By')"))
                                        .ID("ApprovedBy")
                                        .ReadOnly(true)
                                        )
                    @(Html.DevExtreme().TextBox()
                                        .ID("ApprovedBytext")
                                        .Value(null)
                                        .Disabled(true)
                                        .ElementAttr(new { @class = "custom-disabled-textbox" })
                                        )
                </div>

                <div class="form-group" style="flex: 1 1 95px;">
                    @(Html.DevExtreme().TextBox()
                                        .Label(new JS("formatMessage('Verified On')"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        .ID("VerifiedOnDate")
                                        .Value(null)
                                        .Disabled(true)
                                        .ElementAttr(new { @class = "custom-disabled-textbox" })
                                        )
                </div>

                <div class="form-group" style="flex: 1 1 95px;">
                    @(Html.DevExtreme().TextBox()
                                        .Label(new JS("formatMessage('Approved On')"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        .ID("ApprovedOntext")
                                        .Value(null)
                                        .Disabled(true)
                                        .ElementAttr(new { @class = "custom-disabled-textbox" })
                                        )
                </div>

            </div>
        </div>

