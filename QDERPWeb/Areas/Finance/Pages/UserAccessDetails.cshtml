              ],
              target: "#btnReplicateUserAccessDropdown", // or your dropdown button ID
              width: 250,
              showSubmenuMode: { name: "onHover", delay: { show: 0, hide: 0 } },
              submenuDirection: "right",
              closeOnOutsideClick: false,
              onItemClick: function (e) {
                  e.event.stopPropagation();
              }
          }).dxContextMenu("instance");
      });


      function onDropdownIconClick(e) {
          e.event.preventDefault();
          e.event.stopPropagation();
          const contextMenu = $("#addOrRemoveContextMenu").dxContextMenu("instance");
          contextMenu.show();
      }

      function ReplicateAccess() {
          const url = `/${tenantName}/Finance/ReplicateUserAccount`;
