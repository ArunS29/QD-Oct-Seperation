    <div class="dx-fieldset horizontal-container">
        @(
                Html.DevExtreme().Tabs()
                .Items(items =>
                {
                  // tab-content-1
                    items.Add()
                    .Icon("preferences") // Master Module
                    .Text("Master Module");

                    // tab-content-2
                    items.Add()
                    .Icon("chart") // Finance
                    .Text("Finance");

                    // tab-content-3
                    items.Add()
                    .Icon("image") // VAT
                    .Text("VAT");

                    // tab-content-4
                    items.Add()
                    .Icon("money") // Human Resources
                    .Text("Human Resources");

                    // tab-content-5
                    items.Add()
                    .Icon("repeat") // Equipment Rental
                    .Text("Equipment Rental");

                    // tab-content-6
                    items.Add()
