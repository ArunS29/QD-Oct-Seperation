        </div>

        <!-- Tab 8: Project Control -->
        <div id="tab-content-8" class="tab-content" style="display: none;">
            <div class="background">
                @await Html.PartialAsync("~/Pages/Shared/Finance/ProjectControls.cshtml")
            </div>
        </div>

        <!-- Tab 9: Scaffolding Rental Solution -->
        <div id="tab-content-9" class="tab-content" style="display: none;">
            <div class="background">
                @await Html.PartialAsync("~/Pages/Shared/Finance/ScaffoldingRentalSolutions.cshtml")
            </div>
        </div>

        <!-- Tab 10: Alert Notification -->
        <div id="tab-content-10" class="tab-content" style="display: none;">
            <div class="background">
                @await Html.PartialAsync("~/Pages/Shared/Finance/AlertNotification.cshtml")
            </div>
        </div>

        <!-- Tab 11: Finance Ledger Access -->
        <div id="tab-content-11" class="tab-content" style="display: none;">
            <div class="background">
                @await Html.PartialAsync("~/Pages/Shared/Finance/FinanceLedgerAccess.cshtml")
            </div>
        </div>
    </div>




</div>


