       var contextMenuInstance;

      $(function () {
          $("<div style='margin-top: 60px;' id='addOrRemoveContextMenu'></div>").appendTo("body");

          contextMenuInstance = $("#addOrRemoveContextMenu").dxContextMenu({
              items: [
                  {
                      text: "Add or Remove Buttons",
                      items: [
                          {
                              text: "User Access",
                              template: function () {
                                  return `
                                      <div style="padding:5px;min-width:200px;">
                                          <div>
                                              <input type="checkbox" id="chkGenerate" />
                                              <label for="chkGenerate"> Generate Access List</label>
                                          </div>
                                          <div style="margin-top:5px;">
                                              <input type="checkbox" id="chkReplicate" />
                                              <label for="chkReplicate"> Replicate User Access</label>
                                          </div>
                                          <div style="margin-top:5px;">
