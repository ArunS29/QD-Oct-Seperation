@page

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using QD.ERP.Web.Areas.Finance.Pages
@using QD.ERP.Web.Pages.Shared.Finance
@{
}

<style>
    .modal-content {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 90%;
        max-width: 750px;
        height: 90%;
        max-height: 400px;
        border-radius: 8px;
        padding: 0;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        background: var(--background-color);
    }


    .form-tablee {
        width: 50%;
        border-collapse: separate;
        border-spacing: 6px;
    }

    .inline-icon {
        vertical-align: bottom;
        align-items: center;
        justify-content: center;
    }

    .body {
        padding-top: 0px;
    }

    .content {
        margin: 0px;
    }

    .content-container-top {
        width: 100%;
    }
    /* Custom CSS to adjust the height of tab headers */
    .dx-tabpanel .dx-tab {
        padding: 10px 15px; /* Adjust padding to change height */
        font-size: 16px; /* Adjust font size to change header height */
    }

    /* Ensuring the content area also adjusts in height */
    .dx-tabpanel .dx-tab-content {
        padding: 20px;
        min-height: 200px; /* Minimum height for the tab content */
    }

    .dx-fieldset {
        margin: 3px 3px !important;
        padding: 0px;
    }

    .dx-datagrid-headers th {
        text-align: center; /* Centers the text */
    }

    .columnheader {
        text-align: center;
    }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

        .tab-content h3 {
            color: #333;
        }

        .tab-content p {
            line-height: 1.6;
            color: #555;
        }

    .dx-dropdownbox .dx-dropdownbox-wrapper .dx-dropdownbox-header {
        display: none;
    }

    .button-group {
        margin-left: 1px !important;
    }

    .button-alignment-up {
        margin-top: 25px !important;
    }

    .button-alignment-down {
        margin-top: 0px !important;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 300px;
        width: 40%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }


    .containerInventoryStock {
        align-items: center;
        justify-content: center;
    }

    .no-border-input {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        font-weight: bold;
        font-size: 16px;
        color: black;
        pointer-events: none; /* Prevents hover and click effects */
    }

    .access-btn {
        font-weight: bold;
        font-size: 14px;
        text-align: left;
        padding-left: 10px;
        margin-right: 10px;
    }

    .generate-btn .dx-button-content::before {
        content: "\f234"; /* FontAwesome user icon or replace with image */
    }

    .replicate-btn .dx-button-content::before {
        content: "\f0c0"; /* FontAwesome group icon or replace with image */
    }
</style>
<link rel="stylesheet" href="~/css/Site.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
