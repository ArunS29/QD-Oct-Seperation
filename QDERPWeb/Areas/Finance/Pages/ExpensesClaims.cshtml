        function onClaimRefNoClick(claimRefNo) {
            
            if (!claimRefNo) return;

       
        let targetUrl = '';

        if (claimRefNo.startsWith('EXP')) {
            targetUrl = `/${tenantName}/finance/ExpensesClaimRequest?claimRefNo=${encodeURIComponent(claimRefNo)}`;
            } else if (claimRefNo.startsWith('PCQ')) {
            targetUrl = `/${tenantName}/finance/PettyCashRequest?claimRefNo=${encodeURIComponent(claimRefNo)}`;
            } else if (claimRefNo.startsWith('SRQ')) {
            targetUrl = `/${tenantName}/finance/SupplierPaymentRequest?claimRefNo=${encodeURIComponent(claimRefNo)}`;
            }

        if (targetUrl) {
            window.location.href = targetUrl;
            }
        }

