         function handleDeleteJournalEntry(claimRefNo) {


                    if (claimRefNo && claimRefNo.trim() !== "") {
                        $.ajax({
                            type: "GET",
                            url: "/api/ExpenseClaim/GetJournalStatus",
                            contentType: "application/json",
                            data: { claimRefNo: claimRefNo },
                            success: function (response) {
                                if (response) {
                                    const { isSubmitted, isApproved, isPaid } = response;

                                    if (isSubmitted) {
                                        DevExpress.ui.dialog.alert("Claim is already Submitted, You cannot delete the Submitted Claim.", "Claim is submitted already");
                                    } else if (!isSubmitted && isApproved || isPaid) {
                                        DevExpress.ui.dialog.alert("Claim is already Approved, You cannot delete the Approved Claim.", "Claim is Approved already");
                                    } else if (isSubmitted && isApproved && isPaid) {
                                        DevExpress.ui.dialog.alert("Claim is already Paid, You cannot delete the Posted JV.", "Claim is Paid");
                                    } else if (!isSubmitted && !isApproved && !isPaid) {
                                        let result = DevExpress.ui.dialog.confirm(
                                            "You are about to delete the Claim for the Expense,<br/>Click Yes if you would like to continue.",
                                            "Confirm Deletion"
                                        );
                                        result.done(function (dialogResult) {
                                            if (dialogResult) {
                                                $.ajax({
                                                    type: "POST",
                                                    url: `/api/ExpenseClaim/DeleteJournalEntry?claimRefNo=${encodeURIComponent(claimRefNo)}`,
                                                    contentType: "application/json",
                                                    success: function (deleteResponse) {
                                                        if (deleteResponse.success) {
                                                            // getAllSubmissionJournal();
                                                            DevExpress.ui.notify("Claim deleted successfully.", "success", 2000);
                                                        } else {
                                                            DevExpress.ui.notify("Failed to delete Journal Entry.", "error", 2000);
                                                        }
                                                    },
                                                    error: function () {
                                                        DevExpress.ui.notify("Error occurred during deletion.", "error", 2000);
                                                    }
                                                });
                                            }
                                        });
                                    }
                                } else {
                                    DevExpress.ui.notify("Failed to fetch journal status.", "error", 2000);
                                }
                            },
                            error: function () {
                                DevExpress.ui.notify("Error fetching journal status.", "error", 2000);
                            }
                        });
                    } else {
                        DevExpress.ui.dialog.alert("Journal Reference Number is missing.", "Error");
                    }

            }


               function handleUnlockJournalEntry(claimRefNo, isPaid) {
        if (!claimRefNo) {
            DevExpress.ui.notify("Invalid Journal Reference Number.", "error", 2000);
            return;
        }

        if (isPaid) {
            DevExpress.ui.dialog.alert("Claim is already Paid, You can't unlock the Paid Claim.", "Claim is Paid already");
            return;
        }

        DevExpress.ui.dialog.confirm(
            "You are about to unlock the Claim.</br>Click Yes if you would like to continue.",
            "Unlock Confirmation"
        ).done(function (dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: `/api/ExpenseClaim/UnlockJournalEntry?claimRefNo=${encodeURIComponent(claimRefNo)}`,
                    type: 'POST',
                    contentType: "application/json",
                    success: function (response) {
                        if (response.success) {
                            // getAllSubmissionJournal();
                            DevExpress.ui.notify("Claim unlocked successfully.", "success", 2000);
                        } else {
                            DevExpress.ui.notify("Failed to unlock Journal Entry: " + response.message, "error", 3000);
                        }
                    },
                    error: function () {
                        DevExpress.ui.notify("An error occurred while unlocking the Journal Entry.", "error", 3000);
                    }
                });
            }
        });
    }


           



