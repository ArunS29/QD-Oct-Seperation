           function injectHeaderSVG() {
            $.ajax({
                url: '/api/AccountingLedgers/GetCurrencyIcon',
                type: 'GET',
                success: function (response) {
                    
                    let svgIcon = response.Icon;
                    if (!svgIcon) return;

                    // Set default width/height for SVG if needed
                    if (svgIcon.startsWith("<svg")) {
                        svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);
                    } else {
                        // If symbol is text (e.g., "$" or "SAR"), wrap in styled span
                        svgIcon = `<span style="font-weight: bold;">${svgIcon}</span>`;
                    }

                    let $grid = $('#dataGrid');
                    let gridInstance = $grid.dxDataGrid("instance");
                    if (!gridInstance) return;

                    $grid.find(".dx-header-row td").each(function () {
                        const $cell = $(this);

                        const $debitHeader = $(".debit-header");
                        const debitText = $debitHeader.data("original-text") || $debitHeader.text().trim();
                        $debitHeader.data("original-text", debitText);
                        $debitHeader.html(`
                            <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                ${svgIcon}
                                <span style="font-weight: bold;">${debitText}</span>
                            </div>
                        `);

                        const $creditHeader = $(".credit-header");
                        const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                        $creditHeader.data("original-text", creditText);
                        $creditHeader.html(`
                            <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                ${svgIcon}
                                <span style="font-weight: bold;">${creditText}</span>
                            </div>
                        `);


                    });
                },
                error: function (xhr) {
                    console.error("Failed to load currency icon:", xhr.responseText);
                }
            });
        }

        function injectCurrencyToCards() {
            $.ajax({
                url: "/api/AccountingLedgers/GetCurrencyIcon",
                method: "GET",
                success: function (response) {
                    
                    if (!response || !response.Icon) return;

                    const icon = response.Icon.trim();



                    // Inject into Debit
                    $('#cardDebit .value-slider span').each(function () {
                        $(this).html(icon + $(this).text().trim().replace(icon, ''));
                    });

                    // Inject into Credit
                    $('#cardCredit .value-slider span').each(function () {
                        $(this).html(icon + $(this).text().trim().replace(icon, ''));
                    });
                },
                error: function (err) {
                    console.error("Failed to load currency icon:", err);
                }
            });
        }
       function updateCards(data) {
        const now = new Date();

        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const thisWeekStart = new Date(today);
        thisWeekStart.setDate(today.getDate() - today.getDay());
        const thisMonthStart = new Date(today.getFullYear(), now.getMonth(), 1);
        const thisYearStart = new Date(today.getFullYear(), 0, 1);

        let totalDr = 0, totalCr = 0;
        let todayDr = 0, weekDr = 0, monthDr = 0, yearDr = 0;
        let todayCr = 0, weekCr = 0, monthCr = 0, yearCr = 0;

        const uniqueVoucherToday = new Set();
        const uniqueVoucherWeek = new Set();
        const uniqueVoucherMonth = new Set();
        const uniqueVoucherYear = new Set();

        data.forEach(item => {
            if (!item.ClaimDate) return;

            const voucherDate = new Date(item.ClaimDate);
            const dateOnly = new Date(voucherDate.getFullYear(), voucherDate.getMonth(), voucherDate.getDate());

            const dr = parseFloat(item.ClaimedAmountTotal || 0);
            const cr = parseFloat(item.ApprovedAmountTotal || 0);

            totalDr += dr;
            totalCr += cr;

            const voucherNo = item.ClaimRefNo;

            if (+dateOnly === +today) {
                todayDr += dr;
                todayCr += cr;
                if (voucherNo) uniqueVoucherToday.add(voucherNo);
            }

            if (dateOnly >= thisWeekStart && dateOnly <= today) {
                weekDr += dr;
                weekCr += cr;
                if (voucherNo) uniqueVoucherWeek.add(voucherNo);
            }

            if (dateOnly >= thisMonthStart && dateOnly <= today) {
                monthDr += dr;
                monthCr += cr;
                if (voucherNo) uniqueVoucherMonth.add(voucherNo);
            }

            if (dateOnly >= thisYearStart && dateOnly <= today) {
                yearDr += dr;
                yearCr += cr;
                if (voucherNo) uniqueVoucherYear.add(voucherNo);
            }
        });

        const format = num => num.toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        // ========== Update Total Debit Card ==========
        $("#cardDebit .value-slider span").eq(0).html(format(totalDr));
        $("#cardDebit .value-slider span").eq(1).html(format(monthDr));
        $("#cardDebit .value-slider span").eq(2).html(format(yearDr));
        $("#cardDebit .overlay .detail").eq(0).html(`${formatMessage("Total")}: ${format(totalDr)}`);
        $("#cardDebit .overlay .detail").eq(1).html(`${formatMessage("This Month")}: ${format(monthDr)}`);
        $("#cardDebit .overlay .detail").eq(2).html(`${formatMessage("This Year")}: ${format(yearDr)}`);

        // ========== Update Total Credit Card ==========
        $("#cardCredit .value-slider span").eq(0).html(format(totalCr));
        $("#cardCredit .value-slider span").eq(1).html(format(monthCr));
        $("#cardCredit .value-slider span").eq(2).html(format(yearCr));
        $("#cardCredit .overlay .detail").eq(0).html(`${formatMessage("Total")}: ${format(totalCr)}`);
        $("#cardCredit .overlay .detail").eq(1).html(`${formatMessage("This Month")}: ${format(monthCr)}`);
        $("#cardCredit .overlay .detail").eq(2).html(`${formatMessage("This Year")}: ${format(yearCr)}`);

        // ======== Voucher Summary ========
        function getVoucherStatus(voucherSet, startDate, endDate) {
            let approved = 0, posted = 0;

            voucherSet.forEach(voucherNo => {
                const filtered = data.filter(item =>
                    item.ClaimRefNo === voucherNo &&
                    item.ClaimDate &&
                    new Date(item.ClaimDate) >= startDate &&
                    new Date(item.ClaimDate) <= endDate
                );

                if (filtered.some(x => x.IsApproved)) approved++;
                if (filtered.some(x => x.IsPaid)) posted++;
            });

            return {
                total: voucherSet.size,
                approved,
                posted
            };
        }

        let totalCount = 0, approvedCount = 0, postedCount = 0;
        const countedVouchers = new Set();

        data.forEach(item => {
            if (!item.ClaimRefNo) return;
            totalCount++;
            if (!countedVouchers.has(item.ClaimRefNo)) {
                const matching = data.filter(x => x.ClaimRefNo === item.ClaimRefNo);
                if (matching.some(x => x.IsApproved)) approvedCount++;
                if (matching.some(x => x.IsPaid)) postedCount++;
                countedVouchers.add(item.ClaimRefNo);
            }
        });

        const monthStatus = getVoucherStatus(uniqueVoucherMonth, thisMonthStart, today);
        const yearStatus = getVoucherStatus(uniqueVoucherYear, thisYearStart, today);

        $("#cardVoucher .value-slider span").eq(0).html(`<i class="fa-solid fa-book"></i> ${formatMessage("Total")}: ${totalCount}`);
        $("#cardVoucher .value-slider span").eq(1).html(`<i class="fa-solid fa-book"></i> ${formatMessage("This Month")}: ${monthStatus.total}`);
        $("#cardVoucher .value-slider span").eq(2).html(`<i class="fa-solid fa-book"></i> ${formatMessage("This Year")}: ${yearStatus.total}`);

        $("#cardVoucher .overlay .detail").eq(0).html(`<i class="fa-solid fa-book"></i> ${formatMessage("Approved")}: ${approvedCount}`);
        $("#cardVoucher .overlay .detail").eq(1).html(`<i class="fa-solid fa-book"></i> ${formatMessage("Paid")}: ${postedCount}`);
    }


