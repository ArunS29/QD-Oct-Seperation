@page
@model QD.ERP.Web.Areas.Finance.Pages.AssetsDocTypeMasterModel
@{
    ViewData["Title"] = "Assets Document Types";
}

@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Add SweetAlert CSS and JS CDN -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.js"></script>

<style type="text/css">
    .card-container {
        background-color: #cfddee;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .dx-button-add {
        background-color: #f5f8fb !important;
        color: red !important;
        border: 1px solid #b0c4de;
    }
    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }
    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 0em;
        width: 100%;
    }
</style>

<div class="content-container-top">
    <div class="container4">
        <h2 id="AssetsDocumentTypes"></h2>

        <div class="card-container">
            <div class="row g-6">
                <div class="col-md-8">
                    <div class="form-group">
                        @(Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessage('Document Type')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("txtDocumentType")
                            . Value(null)
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired()
                                .Message(new JS("formatMessage('Branch Name is required')"));
                            })
                            )
                        
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @(Html.DevExtreme().NumberBox()
                            .Label(new JS("formatMessage('Reminder Days')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("txtReminderDays")
                            .Value(null)
                            .Min(0)
                            .ShowSpinButtons(true)
                        )
                    </div>
                </div>
            </div>

            <div class="row g-6">
                <div class="col-md-4">
                    <div class="form-group">
                        @(Html.DevExtreme().Button()
                            .ID("btnAdd")
                            .Text(new JS("formatMessage('ADD')"))
                            .Height(70)
                            .Width(178)
                            .Icon("plus")
                            .OnClick("function() { addAssetType(); }")
                            .ElementAttr(new { @class = "dx-button-add" })
                        )
                    </div>
                </div>
            </div>

            <div id="gridContainer"></div>
        </div>
    </div>
</div>

<script type="text/javascript">

    //     $("#AssetsDocumentTypes").dxTextBox({
    //         text: formatMessage("Assets Document Types"),
    //         readOnly: true,
    //         onContentReady: function(e) {
				// 		$(e.element).addClass("dx-textbox-heading");
				// }	

    //     });

      $(document).ready(function () {
         // Extract assetLedgerNo from the URL
         debugger;
         const urlParams = new URLSearchParams(window.location.search);
          const DocumentType = urlParams.get("DocumentType");  // Get assetLedgerNo from the URL query string
           $("#txtDocumentType").dxTextBox("instance").option("value",DocumentType);
     });
    $(function () {
        var updatedRows = [];

        // Initialize DataGrid with custom store
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "DocumentTypeId",
                load: function () {
                    return $.getJSON('/api/Master/GetAssetTypes'); // Fetch data from the API
                },
                update: function (key, values) {
                    var updatedAssetType = {
                        DocumentTypeId: key,
                        DocumentType: values.DocumentType,
                        ReminderDays: values.ReminderDays
                    };

                    updatedRows.push(updatedAssetType);

                    return $.ajax({
                        type: "POST",
                        url: "/api/Master/UpdateAssetType",
                        data: JSON.stringify(updatedAssetType),
                        contentType: "application/json",
                        success: function (response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Asset Type Updated',
                                text: 'The asset type has been successfully updated.',
                                confirmButtonText: 'OK'
                            });
                        },
                        error: function (xhr) {
                              if (xhr.status === 409) { // If duplicate asset location is found
                                Swal.fire({
                                    icon: 'warning', // Show a warning instead of an error
                                    title: 'Duplicate Asset Doctype',
                                    text: 'This Asset Doctype already exists. Please choose a different name.',
                                    confirmButtonText: 'OK'
                                
                                   }).then(() => {
                                    // Trigger the cancel action on the DataGrid after alert is closed
                                    var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                    dataGrid.cancelEditData();  // Cancel the current edit
                                });
                            }
                            else if (xhr.status === 500) {
                                // Show error alert using SweetAlert
                                var errorMessage = xhr.status === 500
                                    ? "Server error: Please try again later."
                                    : "Validation error: " + xhr.responseText;
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: errorMessage,
                                    confirmButtonText: 'OK'
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'There was an error updating the asset Doctype.',
                                    confirmButtonText: 'OK'
                                });
                            }

                        }
                    });
                }
            }),
            editing: {
                mode: "batch",
                allowUpdating: true,
                allowAdding: false,
                allowDeleting: false,
                useIcons: true,
                texts: {
                    saveAll: "Update",
                    cancelAll: "Cancel All Changes"
                }
            },
            columns: [
                { dataField: "DocumentTypeId", caption: "Document Type ID", width: 100, editorOptions: { readOnly: true } },
                { dataField: "DocumentType", caption: "Document Type" },
                { dataField: "ReminderDays", caption: "Reminder Days" }
            ],
            showBorders: true,
            paging: { pageSize: 10 },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: { visible: false, applyFilter: "auto" },
            toolbar: {
                items: [
                    {
                        widget: "dxButton",
                        options: {
                            icon: "save",
                            text: "Update",
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").saveEditData();
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",
                        options: {
                            icon: "close",
                            text: "Cancel",
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").cancelEditData();
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",
                        options: {
                            icon: "arrowleft",
                            text: "Back",
                            onClick: function () {
                                window.close();
                            }
                        },
                        location: "after"
                    }
                ]
            },
            onRowUpdated: function (e) {
                Swal.fire({
                    icon: 'success',
                    title: 'Row Updated',
                    text: 'The row data was successfully updated.',
                    confirmButtonText: 'OK'
                });
            }
        });
    });

    // Function to add a new Asset Type
    function addAssetType() {
        var documentType = $("#txtDocumentType").dxTextBox("instance").option("value");
        var reminderDays = $("#txtReminderDays").dxNumberBox("instance").option("value");
   // Get the branch name validator instance
        var doctypevalidator = $("#txtDocumentType").dxValidator("instance");

        // Validate the branch name input
        var existingdocumentTypevalidation = doctypevalidator.validate();

        // If the branch name is valid, proceed with the AJAX request
        if (existingdocumentTypevalidation.isValid) {

            // Get the data array from the grid's data source
            var existingdocumentType = $("#gridContainer").dxDataGrid("instance").getDataSource().items();

            // Check if the branch name already exists in the grid data
            var duplicate = existingdocumentType.some(function (item) {
                return item.DocumentType.toLowerCase() === documentType.toLowerCase();
            });

            if (duplicate) {
                Swal.fire({
                    icon: 'error',
                    title: 'Duplicate Document Type',
                    text: 'This Document Type already exists!',
                    confirmButtonText: 'OK'
                });
                return;
            }

            var assetTypeData = {
                DocumentType: documentType,
                ReminderDays: reminderDays
            };

            $.ajax({
                type: "POST",
                url: "/api/Master/AddAssetType",
                data: JSON.stringify(assetTypeData),
                contentType: "application/json",
                success: function (response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Asset Type Added',
                        text: 'A new asset type has been successfully added.',
                        confirmButtonText: 'OK'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                },
                error: function (xhr) {
                    var errorMessage = xhr.status === 500
                        ? "Server error: Please try again later."
                        : "Validation error: " + xhr.responseText;
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: errorMessage,
                        confirmButtonText: 'OK'
                    });
                }
            });
        } else {
            DevExpress.ui.notify("Please fill required details!", "error", 2000);
        }
    }
</script>

