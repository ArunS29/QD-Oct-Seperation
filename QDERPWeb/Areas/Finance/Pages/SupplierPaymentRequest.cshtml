@page
@model QD.ERP.Web.Pages.Shared.SupplierPaymentfooterModel

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }

    #SupplierName .dx-placeholder {
        color: white;
    }

    .button-alignment-down {
        margin-bottom: 10px;
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    #totalPayable {
        font-weight: bold;
        margin-top: 10px;
        color: white;
    }
</style>
<div class="container mt-4">
    <div class="card shadow">
        <div id="SupplierPaymentRequests" class="card-header bg-dark text-white font-weight-bold">
            
        </div>
        <div class="card-body bg-secondary">
            <!-- Supplier Selection Dropdown -->
            <div class="mb-4">
                @(Html.DevExtreme().SelectBox()
                    .Label(new JS("formatMessage('Select Supplier')"))
                    .ID("SupplierName")
                    .Width("300px")
                    .LabelMode(EditorLabelMode.Floating))
            </div>
            <!-- Data Grid to Display Payment Data -->
            <div class="mb-4">
                @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201SubLedgerPayablesMaster>()
                        .ID("dataGrid")
                        .KeyExpr("AccountHeadNo")
                        .RemoteOperations(true)
                        .Columns(columns =>
                        {
                            columns.Add().DataField("select").Visible(true).Caption(new JS("formatMessage('Select')"))
                        .CellTemplate(@<text>
                    <input type="checkbox" class="dx-checkbox" />
                </text>);
                            columns.Add().DataField("ReferenceNo").Visible(true).Caption(new JS("formatMessage('Reference No')"));
                            columns.Add().DataField("PurchaseOrderNo").Visible(true).Caption(new JS("formatMessage('Supplier Bill No')"));
                            columns.Add().DataField("VoucherDate").Visible(true).Caption(new JS("formatMessage('Voucher Date')"));
                            columns.Add().DataField("PayableAmount").Visible(true).Caption(new JS("formatMessage('Payable Amount')"))
                            .Alignment(HorizontalAlignment.Right)
                            .CustomizeText(@"
                function(e) {
                let value = e.value || 0;
                let formattedValue = Math.abs(value).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
                });
                return value < 0 ? '(' + formattedValue + ')' : formattedValue;
                }");
                            columns.Add().DataField("Balance").Caption(new JS("formatMessage('Balance')"))
                            .Alignment(HorizontalAlignment.Right)
                            .CustomizeText(@"
                function(e) {
                let value = e.value || 0;
                let formattedValue = Math.abs(value).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
                });
                return value < 0 ? '(' + formattedValue + ')' : formattedValue;
                }");
                            columns.Add().DataField("Paid").Caption(new JS("formatMessage('Paid')"))
                            .Alignment(HorizontalAlignment.Right)
                            .CustomizeText(@"
                function(e) {
                let value = e.value || 0;
                let formattedValue = Math.abs(value).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
                });
                return value < 0 ? '(' + formattedValue + ')' : formattedValue;
                }");

                            columns.Add().DataField("OverdueDays").Caption(new JS("formatMessage('Overdue Days')"));
                        })
                    .Height(500)
                    .ColumnAutoWidth(true)
                    .FilterRow(filterRow => filterRow.Visible(false))
                    .Grouping(grouping => grouping.AutoExpandAll(true))
                    .GroupPanel(groupPanel => groupPanel.Visible(false))
                    .ShowBorders(true)
                    .Width("100%"))
            </div>

            <!-- Footer Totals -->
            <div id="footerTotals" style="display: flex; background-color: #666; color: white; padding: 5px 10px; font-size: 14px;">
                <div style="flex: 6;">&nbsp;</div>
                <div style="flex: 2; text-align: right;">
                    <!-- Total Payable -->
                    @(Html.DevExtreme().TextBox()
                        .ID("totalPayableTextbox")
                        .Value("0.00")
                        .ReadOnly(true)
                        .Width("100%"))
                </div>
                <div style="flex: 2; text-align: right;">
                    <!-- Total Balance -->
                    @(Html.DevExtreme().TextBox()
                        .ID("totalBalanceTextbox")
                        .Value("0.00")
                        .ReadOnly(true)
                        .Width("100%"))
                </div>
                <div style="flex: 2; text-align: right;">
                    <!-- Total Paid (new column) -->
                    @(Html.DevExtreme().TextBox()
                        .ID("totalPaidTextbox")
                        .Value("0.00")
                        .ReadOnly(true)
                        .Width("100%"))
                </div>
                <div style="flex: 0;">&nbsp;</div>
            </div>





            <!-- Footer Partial -->
            <div>
                @await Html.PartialAsync("SupplierPaymentFooter")
            </div>
        </div>
    </div>


    <script>
        $(function () {

										$("#SupplierPaymentRequests").dxTextBox({
													text:formatMessage("Supplier Payment Requests"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
        $(function () {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");

            // Initialize Supplier SelectBox
            $("#SupplierName").dxSelectBox({
                dataSource: DevExpress.data.AspNet.createStore({
                    key: "AccountHeadNo",
                    loadUrl: "/api/SupplierPaymentRequest/GetSuppliers"
                }),
                displayExpr: "AccountHead",
                valueExpr: "AccountHeadNo",
                placeholder: "Select a Supplier",
                onValueChanged: function (e) {
                    const supplierId = e.value;

                    if (dataGrid) {
                        if (supplierId) {
                            // Update data source for the selected supplier
                            dataGrid.option("dataSource", DevExpress.data.AspNet.createStore({
                                key: "AccountHeadNo",
                                loadUrl: `/api/SupplierPaymentRequest/GetSupplierPaymentRequest?supplierId=${supplierId}`
                            }));
                            dataGrid.refresh();
                        } else {
                            // Clear grid data if no supplier is selected
                            dataGrid.option("dataSource", []);
                        }
                    }
                }
            });


        });
        $(function () {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");

            const totalPayableTextbox = $("#totalPayableTextbox").dxTextBox("instance");
            const totalBalanceTextbox = $("#totalBalanceTextbox").dxTextBox("instance");

            function calculateTotals() {
                const data = dataGrid.getVisibleRows().map(row => row.data);

                // Calculate totals for PayableAmount and Balance
                const totalPayable = data.reduce((sum, row) => sum + (row.PayableAmount || 0), 0);
                const totalBalance = data.reduce((sum, row) => sum + (row.Balance || 0), 0);

                // Format totals and update the textboxes
                totalPayableTextbox.option(
                    "value",
                    totalPayable < 0
                        ? `(${Math.abs(totalPayable).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })})`
                        : totalPayable.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                );

                totalBalanceTextbox.option(
                    "value",
                    totalBalance < 0
                        ? `(${Math.abs(totalBalance).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })})`
                        : totalBalance.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                );
            }

            // Recalculate totals when grid content changes
            dataGrid.on("contentReady", calculateTotals);
            dataGrid.on("dataSourceChanged", calculateTotals);
        });



    </script>
