@page
@model QD.ERP.Web.Pages.Shared.SupplierPaymentfooterModel

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }

    #SupplierName .dx-placeholder {
        color: white;
    }

    .button-alignment-down {
        margin-bottom: 10px;
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }
</style>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white font-weight-bold">
            Supplier Payment Requests
        </div>
        <div class="card-body bg-secondary">
            <div class="mb-4">
                <label for="SupplierName" style="color: white;">Select Supplier</label>
                @(Html.DevExtreme().SelectBox()
                    .ID("SupplierName")
                    .Width("300px")
                    .LabelMode(EditorLabelMode.Outside))
            </div>

            <div class="mb-4">
                @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201SubLedgerPayablesMaster>()
                        .ID("dataGrid")
                        .KeyExpr("AccountHeadNo")
                        .RemoteOperations(true)
                        .Columns(columns =>
                        {
                            columns.Add().DataField("select").Caption("Select")
                        .CellTemplate(@<text>
                    <input type="checkbox" class="dx-checkbox" />
                </text>);
                            columns.Add().DataField("ReferenceNo").Caption("Reference No");
                            columns.Add().DataField("PurchaseOrderNo").Caption("Supplier Bill No");
                            columns.Add().DataField("VoucherDate").Caption("Voucher Date");
                            columns.Add().DataField("PayableAmount").Caption("Payable Amount").Alignment(HorizontalAlignment.Right).CustomizeText(@"
                function(e) {
                let value = e.value || 0;
                let formattedValue = Math.abs(value).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
                });
                return value < 0 ? formattedValue + 'Cr' : formattedValue;
                }");
                            columns.Add().DataField("Balance").Caption("Balance")
                            .Alignment(HorizontalAlignment.Right).CustomizeText(@"
                function(e) {
                let value = e.value || 0;
                let formattedValue = Math.abs(value).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
                });
                return value < 0 ? formattedValue + 'Cr' : formattedValue;
                }");
                            columns.Add().DataField("OverdueDays").Caption("Overdue Days");
                        })
                    .Height(500)
                    .ColumnAutoWidth(true)
                    .FilterRow(filterRow => filterRow.Visible(false))
                    .Grouping(grouping => grouping.AutoExpandAll(true))
                    .GroupPanel(groupPanel => groupPanel.Visible(false))
                    .ShowBorders(true)
                    .Width("100%"))
            </div>

            <div>
                @await Html.PartialAsync("SupplierPaymentFooter")
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        // Initialize the SelectBox
        $("#SupplierName").dxSelectBox({
            dataSource: DevExpress.data.AspNet.createStore({
                key: "AccountHeadNo",
                loadUrl: "/api/SupplierPaymentRequest/GetSuppliers"
            }),
            displayExpr: "AccountHead",
            valueExpr: "AccountHeadNo",
            placeholder: "Select a Supplier",
            onValueChanged: function (e) {
                const supplierId = e.value;
                const dataGrid = $("#dataGrid").dxDataGrid("instance");

                if (dataGrid) {
                    if (supplierId) {
                        // Update data source for the selected supplier
                        dataGrid.option("dataSource", {
                            load: function () {
                                return $.ajax({
                                    url: `/api/SupplierPaymentRequest/GetSupplierPaymentRequest?supplierId=${supplierId}`,
                                    type: "GET"
                                });
                            }
                        });
                        dataGrid.refresh();
                    } else {
                        // Clear grid data if no supplier is selected
                        dataGrid.clearFilter();
                        dataGrid.option("dataSource", null);
                    }
                }
            }
        });

        $("#dataGrid").dxDataGrid({
            dataSource: DevExpress.data.AspNet.createStore({
                key: "AccountHeadNo",
                loadUrl: "/api/SupplierPaymentRequest/GetSupplierPaymentRequest"
            }),
            remoteOperations: true,
            columns: [
                {
                    dataField: "select",
                    caption: "Select",
                    cellTemplate: function (container, options) {
                        $("<input>")
                            .addClass("dx-checkbox")
                            .attr("type", "checkbox")
                            .appendTo(container);
                    }
                },
                { dataField: "ReferenceNo", caption: "Reference No" },
                { dataField: "PurchaseBillNo", caption: "Supplier Bill No" },
                { dataField: "PurchaseOrderNo", caption: "Purchase Order No" },
                { dataField: "VoucherDate", caption: "Voucher Date" },
                { dataField: "VoucherEffectiveDate", caption: "Effective Date" },
                { dataField: "InvoiceDueDate", caption: "Invoice Date" },

                { dataField: "OverdueDays", caption: "Due Date" },
                { dataField: "VoucherNarration", caption: "Voucher Narration" },
                {
                    dataField: "PayableAmount",
                    caption: "Payable Amount",
                    alignment: "right",
                    customizeText: function (cellInfo) {
                        let value = cellInfo.value || 0;
                        let formattedValue = Math.abs(value).toLocaleString(undefined, {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                        return value < 0 ? `(${formattedValue})` : formattedValue;
                    }
                },
                {
                    dataField: "PaidAmount",
                    caption: "Paid Amount",
                    alignment: "right",
                    customizeText: function (cellInfo) {
                        let value = cellInfo.value || 0;
                        let formattedValue = Math.abs(value).toLocaleString(undefined, {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                        return value < 0 ? `(${formattedValue})` : formattedValue;
                    }
                },
                {
                    dataField: "Balance",
                    caption: "Balance to Pay",
                    alignment: "right",
                    customizeText: function (cellInfo) {
                        let value = cellInfo.value || 0;
                        let formattedValue = Math.abs(value).toLocaleString(undefined, {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                        return value < 0 ? `(${formattedValue})` : formattedValue;
                    }
                },
                {
                    dataField: "OverdueDays",
                    caption: "Overdue Days",
                    alignment: "center"
                },

            ],
            columnAutoWidth: true,
            showBorders: true,
            height: 500
        });

    });
</script>
