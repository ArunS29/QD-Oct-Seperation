@page

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; 
    }



    .horizontal-container {
        display: flex;
        gap: 10px; 
        justify-content: start; 
        align-items: center; 
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }




    .button-alignment-down {
        margin-bottom: 10px
    }

    #Narration {
        overflow-y: auto; 
        resize: none; 
    }
</style>
<div class="card" style="margin: 20px; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);">
    <div class="card-header" style="background-color: #4a4a9c; color: white; font-weight: bold;">
     ExpenseClaimWithDetails
    </div>
    <div class="card-body" style="padding: 20px; background-color:  #c0dceb; border-radius: 5px;">
     <div class="dx-fieldset horizontal-container" style="margin-bottom: 0px">
           
   
               
                @(Html.DevExtreme().DateBox()
                    .ID("VoucherDate")
                    .InputAttr("aria-label", "Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                    )
     
              
                @(Html.DevExtreme().DateBox()
                    .ID("EffectiveDate")
                    .InputAttr("aria-label", "Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                    )
            
            @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnShowRecords")
                .Text("Show Records")
                .Icon("smalliconslayout")
                .Width(180)
            
                .TabIndex(4)
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                    items.Add().Text("Show Records").Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                    items.Add().Text("Today").Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                    items.Add().Text("Yesterday").Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                    items.Add().Text("This Week").Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                    items.Add().Text("This Month Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                    items.Add().Text("This Month (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                    items.Add().Text("This Year Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                    items.Add().Text("This Year (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                    items.Add().Text("Last Month").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                    items.Add().Text("Last Year").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                })
                )
        </div>
        <div class="dx-field ledgerResult">
            @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry20121ExpenseClaimForm>()
                .ID("dataGrid")
                .KeyExpr("ClaimRefNo")
                .RemoteOperations(false)
                .DataSource(ds => ds.Mvc()
                .Controller("ExpensesClaim")
                .LoadAction("GetExpenseClaims"))
                .Columns(columns =>
                {
                   
                    columns.Add().DataField("ClaimRefNo").Caption("Claim Ref No").GroupIndex(0);
                    columns.Add().DataField("ClaimRefNo").Caption("Claim Ref No"); 
                    columns.Add().DataField("ClaimDate").Caption("Claim Date");
                    columns.Add().DataField("ClaimerName").Caption("Claimer Name");
                    columns.Add().DataField("PaymentVoucherNo").Caption("Payment Voucher No");
                    columns.Add().DataField("BillDate").Caption("Bill Date");
                    columns.Add().DataField("BillRefNo").Caption("Bill Ref No");
                    columns.Add().DataField("ExpenseDescription").Caption("Expense Description");
                    columns.Add().DataField("ClaimedAmount").Caption("Claimed Amount");
                    columns.Add().DataField("ApprovedAmount").Caption("Approved Amount");
                    columns.Add().DataField("TaxAmount").Caption("Tax Amount");
                    columns.Add().DataField("RoundOff").Caption("Round Off");
                    columns.Add().DataField("CostCenterCode").Caption("Cost Center Code");
                    columns.Add().DataField("AccountHead").Caption("Account Head");
                    columns.Add().DataField("IsTaxIncluded").Caption("Is Tax Included");
                    columns.Add().DataField("Discount").Caption("Discount");
                    columns.Add().DataField("SupplierName").Caption("Supplier Name");
                    columns.Add().DataField("EmployeeNo").Caption("Employee No");
                    columns.Add().DataField("EmployeeName").Caption("Employee Name");
                })
                .Summary(summary =>
                {
                    // Group-level summaries
                    summary.GroupItems(items =>
                    {
                        items.Add()
                    .Column("PaymentVoucherNo")
                    .SummaryType(SummaryType.Count)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("No of items: {0}");

                        items.Add()
                    .Column("ClaimedAmount")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Total Claimed: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("ApprovedAmount")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Total Approved: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TaxAmount")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Total Tax: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("RoundOff")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Round Off: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                    });

                    // Total-level summaries
                    summary.TotalItems(items =>
                    {
                        items.Add()
                    .Column("PaymentVoucherNo")
                    .SummaryType(SummaryType.Count)
                    .DisplayFormat("Total: {0}");

                        items.Add()
                    .Column("ClaimedAmount")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Claimed Amount: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("ApprovedAmount")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Approved Amount: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TaxAmount")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Tax Amount: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("RoundOff")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Round Off: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                    });
                })

                .Paging(paging => paging.Enabled(false))
                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(fixing => fixing.Enabled(true))
                .HeaderFilter(filter => filter.Visible(true))
                .Height(300)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false))
                .ShowBorders(true)
                .Width("100%"))
        </div>



        <div>
            @await Html.PartialAsync("GridFooterExpenses")
        </div>
</div>

    <script>
        function ddBtnShowRecords_click(filterType) {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");
            const today = new Date(); 
            let startDate = null, endDate = null;

            switch (filterType) {
                case 'today':
                    startDate = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 0, 0, 0);
                    endDate = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 23, 59, 59, 999);
                    break;

                case 'yesterday':
                    startDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 1, 0, 0, 0);
                    endDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 1, 23, 59, 59, 999);
                    break;

                case 'week':
                    const dayOfWeek = today.getDay(); // Sunday = 0, Monday = 1, ...
                    startDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - dayOfWeek, 0, 0, 0);
                    endDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - dayOfWeek + 6, 23, 59, 59, 999);
                    break;

                case 'tillmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(); // Till now
                    break;

                case 'fullmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0, 23, 59, 59, 999); // Last day of the month
                    break;

                case 'tillyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(); // Till now
                    break;

                case 'fullyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today.getFullYear(), 11, 31, 23, 59, 59, 999); // Last day of the year
                    break;

                case 'lastmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    endDate = new Date(today.getFullYear(), today.getMonth(), 0, 23, 59, 59, 999); // Last day of last month
                    break;

                case 'lastyear':
                    startDate = new Date(today.getFullYear() - 1, 0, 1);
                    endDate = new Date(today.getFullYear() - 1, 11, 31, 23, 59, 59, 999);
                    break;

                default:
                    dataGrid.clearFilter();
                    return;
            }

            dataGrid.option("dataSource", {
                load: function () {
                    return $.ajax({
                        url: "/api/ExpensesClaim/GetExpenseClaim",
                        data: {
                            startDate: startDate.toISOString(),
                            endDate: endDate.toISOString()
                        },
                        type: "GET"
                    }).then(function (data) {
                        // Format dates before returning the data
                        return data.map(function (item) {
                            item.dateField = new Date(item.dateField).toLocaleDateString("en-GB", {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                            });
                            return item;
                        });
                    });
                }
            });

        }

    </script>
