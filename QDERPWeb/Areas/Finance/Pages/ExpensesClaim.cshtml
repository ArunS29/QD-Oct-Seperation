<div class="card" style="margin: 20px; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);">

    <div class="card-body" style="padding: 20px;  border-radius: 5px;">
        <div class="dx-fieldset horizontal-container" style="margin-bottom: 0px">



            @(Html.DevExtreme().DateBox()
                .Label(new JS("formatMessage('Start Date')"))
                .ID("VoucherDate")
                .InputAttr("aria-label", "Date")
                .LabelMode(EditorLabelMode.Outside)
                .Type(DateBoxType.Date)
                .DisplayFormat("dd-MMM-yyyy")
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                )


            @(Html.DevExtreme().DateBox()
                .Label(new JS("formatMessage('End Date')"))
                .ID("EffectiveDate")
                .InputAttr("aria-label", "Effective Date")
                .LabelMode(EditorLabelMode.Outside)
                .Type(DateBoxType.Date)
                .DisplayFormat("dd-MMM-yyyy")
                .Value(DateTime.Now))


            @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnShowRecords")
                .Text(new JS("formatMessage('Show Records')"))
                .Icon("smalliconslayout")
                .Width(180)

                .TabIndex(4)
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                    items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                    items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                    items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                    items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                    items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                    items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                    items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                    items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                    items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                    items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                })
                )
        </div>
        <div class="dx-field ledgerResult">
            @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry20121ExpenseClaimForm>()
                .ID("dataGrid")
                .KeyExpr("ClaimRefNo")
                .RemoteOperations(false)
                .DataSource(ds => ds.Mvc()
                .Controller("ExpensesClaim")
                .LoadAction("GetExpenseClaims"))
                .Columns(columns =>
                {

                    columns.Add().Caption(new JS("formatMessage('Expenses Claims Details')")).Columns(band =>
                    {
                        band.Add().DataField("ClaimRefNo").Caption(new JS("formatMessage('Claim Ref No')")).GroupIndex(0);
                        band.Add().DataField("ClaimDate").Caption(new JS("formatMessage('Claim Date')"));
                        band.Add().DataField("ClaimerName").Caption(new JS("formatMessage('Claimer Name')"));
                        band.Add().DataField("PaymentVoucherNo").Caption(new JS("formatMessage('Payment Voucher No')"));
                        band.Add().DataField("BillDate").Caption(new JS("formatMessage('Bill Date')"));
                        band.Add().DataField("BillRefNo").Caption(new JS("formatMessage('Bill Ref No')"));
                        band.Add().DataField("ExpenseDescription").Caption(new JS("formatMessage('Expense Description')"));
                        band.Add().DataField("ClaimedAmount").Caption(new JS("formatMessage('Claimed Amount')"));
                        band.Add().DataField("ApprovedAmount").Caption(new JS("formatMessage('Approved Amount')"));
                        band.Add().DataField("TaxAmount").Caption(new JS("formatMessage('Tax Amount')"));
                        band.Add().DataField("RoundOff").Caption(new JS("formatMessage('Round Off')"));
                        band.Add().DataField("CostCenterCode").Caption(new JS("formatMessage('Cost Center Code')"));
                        band.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"));
                        band.Add().DataField("IsTaxIncluded").Caption(new JS("formatMessage('Is Tax Included')"));
                        band.Add().DataField("Discount").Caption(new JS("formatMessage('Discount')"));
                        band.Add().DataField("SupplierName").Caption(new JS("formatMessage('Supplier Name')"));
                        band.Add().DataField("EmployeeNo").Caption(new JS("formatMessage('Employee No')"));
                        band.Add().DataField("EmployeeName").Caption(new JS("formatMessage('Employee Name')"));
                    });
                })


                .Summary(summary =>
                {

                    summary.GroupItems(items =>
                    {
                        items.Add()
                    .Column("PaymentVoucherNo")
                    .SummaryType(SummaryType.Count)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("No of items: {0}");

                        items.Add()
                    .Column("ClaimedAmount")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Total Claimed: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("ApprovedAmount")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Total Approved: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TaxAmount")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Total Tax: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("RoundOff")
                    .SummaryType(SummaryType.Sum)
                    .ShowInGroupFooter(true)
                    .DisplayFormat("Round Off: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                    });


                    summary.TotalItems(items =>
                    {
                        items.Add()
                    .Column("PaymentVoucherNo")
                    .SummaryType(SummaryType.Count)
                    .DisplayFormat("Total: {0}");

                        items.Add()
                    .Column("ClaimedAmount")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Claimed Amount: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("ApprovedAmount")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Approved Amount: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("TaxAmount")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Tax Amount: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                        items.Add()
                    .Column("RoundOff")
                    .SummaryType(SummaryType.Sum)
                    .DisplayFormat("Total Round Off: {0}")
                    .CustomizeText(@"function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                    });
                })

                .Paging(p => p.Enabled(true).PageSize(15))    // enable paging with 15 rows per page
                .Pager(pager => pager
                .Visible(true)                            // show pager UI (page numbers etc)
                .ShowPageSizeSelector(true)              // allow user to change page size
                .AllowedPageSizes(new[] { 10, 15, 20 })  // optional page size options
                .ShowInfo(true)                          // show info like "Page 1 of 10"
                )
                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(fixing => fixing.Enabled(true))
                .HeaderFilter(filter => filter.Visible(true))
                .Height(300)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false))
                .ShowBorders(true)
                .Width("100%"))
        </div>



        <div>
            @await Html.PartialAsync("GridFooterExpenses")
        </div>
    </div>

    <script>
        function ddBtnShowRecords_click(filterType) {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");

            const today = new Date();
            let startDate = null, endDate = null;


            switch (filterType) {
                case 'today':
                    startDate = new Date(today.setHours(0, 0, 0, 0));
                    endDate = new Date(today.setHours(23, 59, 59, 999));
                    break;

                case 'yesterday':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - 1);
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'week':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - today.getDay());
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setDate(startDate.getDate() + 6);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'tillmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'tillyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today.getFullYear(), 11, 31);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'lastmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'lastyear':
                    startDate = new Date(today.getFullYear() - 1, 0, 1);
                    endDate = new Date(today.getFullYear() - 1, 11, 31);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                default:

                    dataGrid.option("dataSource", {
                        load: function () {
                            return $.ajax({
                                url: "/api/ExpensesClaim/GetExpensesClaims",
                                type: "GET"
                            });
                        }
                    });
                    dataGrid.refresh();
                    return;
            }

            if (startDate && endDate) {

                $("#VoucherDate").dxDateBox("instance").option("value", startDate);
                $("#EffectiveDate").dxDateBox("instance").option("value", endDate);


                dataGrid.option("dataSource", {
                    load: function () {
                        return $.ajax({
                            url: "/api/ExpensesClaim/GetExpensesClaims",
                            data: {
                                startDate: startDate.toISOString(),
                                endDate: endDate.toISOString()
                            },
                            type: "GET"
                        });
                    }
                });


                dataGrid.refresh();
            }
        }
        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }

