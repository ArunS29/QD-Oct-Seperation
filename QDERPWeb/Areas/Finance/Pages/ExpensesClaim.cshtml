@page

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }



    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }




    .button-alignment-down {
        margin-bottom: 10px
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        
        color: black;
    }

    .titleCard-carousel {
        display: flex;
        overflow-x: auto;
        gap: 20px;
        padding: 16px 24px 0 calc(var(--nav-w,0) + 24px);
        scroll-snap-type: x mandatory;
        padding-top: 15px;
        padding-bottom: 15px;
        padding-left: 10px;
    }

    .titleCard-cards {
        display: flex;
        gap: 20px;
        min-width: max-content
    }

    /* --------------  KPI CARD (core) -------------- */
    .titleCard-card {
        flex: 0 0 240px; /* exact width */
        position: relative;
        padding: 18px 20px;
        border-radius: 16px;
        box-shadow: 0 4px 10px rgba(0,0,0,.12);
        color: #fff;
        font-weight: 600;
        overflow: hidden;
        scroll-snap-align: start;
        padding-top: 10px;
        transition: transform .3s ease,box-shadow .3s ease
    }

        .titleCard-card:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 20px rgba(0,0,0,.25)
        }

    /* gradients */
    .vibrant-pink {
        background: linear-gradient(135deg,#ff0066,#ff66cc)
    }

    .cool-blue {
        background: linear-gradient(135deg,#0066ff,#33ccff)
    }

    .deep-purple {
        background: linear-gradient(135deg,#6a11cb,#2575fc)
    }

    .mint-green {
        background: linear-gradient(135deg,#00c9a7,#92fe9d)
    }

    /* headline + subhead (static card only) */
    #Static .value-block {
        height: auto
    }
    /* let it grow */
    #Static .value-slider {
        position: static
    }
    /* stop slide animation */
    #Static h2 {
        font-size: 20px;
        margin: 0;
        font-weight: 700
    }

    #Static h6 {
        font-size: 12px;
        margin: 2px 0 0;
        font-weight: 500;
        opacity: .85
    }

    /* --------------  KPI inner elements -------------- */
    .titleCard-card .title {
        font-size: 14px;
        opacity: .9
    }

    .value-block {
        height: 28px;
        overflow: hidden;
        position: relative;
        margin: 6px 0
    }

    .value-slider {
        position: absolute;
        top: 0;
        display: flex;
        flex-direction: column;
        animation: slideValues 6s linear infinite
    }

        .value-slider span {
            font-size: 24px;
            line-height: 28px;
            height: 28px
        }

    /* SVG icon inside value */
    .titleCard-card svg {
        width: 18px;
        height: 18px;
        margin-right: 5px;
        vertical-align: middle;
        fill: #fff
    }

    /* trend + bar */
    .titleCard-card .trend {
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 4px
    }

    .titleCard-card .bar {
        height: 6px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.25);
        margin-top: 10px;
        overflow: hidden;
        position: relative;
    }

        .titleCard-card .bar span {
            display: block;
            height: 100%;
            border-radius: 4px;
            background: #fff;
            width: 0%;
            transition: width 0.6s ease;
        }

        /* Percentage label inside the bar */
        .titleCard-card .bar::after {
            content: attr(data-percentage);
            position: absolute;
            right: 6px;
            top: -22px;
            font-size: 12px;
            font-weight: 500;
            color: #fff;
            opacity: 0.85;
        }


    /* overlay on hover */
    .overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.55);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 12px;
        text-align: center;
        opacity: 0;
        transition: opacity .3s
    }

    .titleCard-card:hover .overlay {
        opacity: 1
    }

    .overlay .detail {
        font-size: 13px;
        margin: 4px 0
    }

    .titleCard-toggle {
        cursor: pointer;
        font-size: 1.2rem;
        height: 35px !important;
        width: 35px;
        background: var(--hover-bg-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .titleCard-toggle:hover {
            color: #000;
        }

    .titleCard-card .header {
        font-size: 15px !important;
        font-weight: 600;
        color: #fff !important;
        opacity: 1 !important;
        margin-bottom: 4px;
        position: relative;
    }


    /* Ensure SVGs are visible and consistent */
    .titleCard-card svg {
        width: 18px !important;
        height: 18px !important;
        margin-right: 5px;
        vertical-align: middle;
        fill: white !important;
    }
    /* simple slide animation (balance, debit, credit) */
    @@keyframes slideValues {
        0%, 33% {
            transform: translateY(0)
        }

        34%, 66% {
            transform: translateY(-28px)
        }

        67%, 100% {
            transform: translateY(-56px)
        }
    }

    /* ----------- KPI CARDS: quick fixes ----------- */
    .titleCard-carousel.collapsed {
        max-height: 0;
        padding: 0;
        overflow: hidden;
        transition: max-height .35s ease, padding .35s ease;
    }

    .titleCard-card .header {
        position: relative;
    }

    .value-slider span {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .ellipsis-cell {
        max-width: 100%; /* let the column decide exact width */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer; /* lets the user know it’s hoverable */
    }

    .header {
        display: flex !important;
        background-color: transparent !important;
    }

    .title {
        background: transparent !important;
    }
</style>
