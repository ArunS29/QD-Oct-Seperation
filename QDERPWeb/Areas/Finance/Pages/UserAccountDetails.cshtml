@section Scripts {
    <script>
            $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const userId = urlParams.get("userId");
            const tenantName = urlParams.get("tenantName");

            if (userId) {
                loadUserDetails(userId);
            } else {
                DevExpress.ui.notify("User ID not found in URL", "error", 3000);
            }
        });

        function loadUserDetails(userId) {
            $.ajax({
                url: "/api/Utility/GetUserID", 
                method: "GET",
                data: { userId: userId },
                success: function (response) {
                    if (!response.success || !response.data) {
                        $("#userProfileContainer").html("<div>User not found.</div>");
                        return;
                    }

                    const user = response.data;

                    $("#UserId").dxTextBox("instance").option("value", user.UserId);
                    $("#UserName").dxTextBox("instance").option("value", user.UserName);
                    $("#Password").dxTextBox("instance").option("value", user.Password);
                    $("#UserEmailAddress").dxTextBox("instance").option("value", user.EmailAddress);
                    $("#UserMobileNo").dxTextBox("instance").option("value", user.MobileNo);
                    $("#UserLastLoggedInTime").dxDateBox("instance").option("value", user.LastLogOnTime);
                    $("#UserLastLoggedOffTime").dxDateBox("instance").option("value", user.LastLogOffTime);

                    // DropDown values
                    $("#ddDepartment").dxDropDownBox("instance").option("value", user.DeptCode);
                    $("#ddCompany").dxDropDownBox("instance").option("value", user.CompanyId);
                    $("#ddBranch").dxDropDownBox("instance").option("value", user.BranchCode);
                    $("#ddUserLevel").dxDropDownBox("instance").option("value", user.UserLevel);
                    $("#ddEmployeeGroup").dxDropDownBox("instance").option("value", user.HrlevelCode);
                    $("#ddInventoryMasterGroup").dxDropDownBox("instance").option("value", user.InventoryAccess);
                    $("#ddFilteredAccountHead").dxDropDownBox("instance").option("value", user.PettyCashAccount);
                    $("#ddHRUserLevel").dxDropDownBox("instance").option("value", user.EqptQuotationAccess);
                    $("#ddSalesPerson").dxDropDownBox("instance").option("value", user.InventoryMpraccess);
                    $("#ddProjectGroup").dxDropDownBox("instance").option("value", user.HrtimeSheetProjectGroup);
                },
                error: function () {
                    DevExpress.ui.notify("Failed to load user info", "error", 3000);
                }
            });
        }

             function onDepartmentSelectionChanged(e) {
            const selectedKey = e.selectedRowKeys[0];
            const ddbInstance = $("#ddDepartment").dxDropDownBox("instance");

            if (selectedKey) {
                ddbInstance.option("value", selectedKey);
                if (ddbInstance.option("opened")) {
                    ddbInstance.close();
                }

                const selectedRowData = e.selectedRowsData[0];
                if (selectedRowData) {
                    console.log("Selected:", selectedRowData.Department);
                }
            }
        }

              function onCompanySelectionChanged(e) {
            const selectedKey = e.selectedRowKeys[0];
            const ddbInstance = $("#ddCompany").dxDropDownBox("instance");

            if (selectedKey) {
                ddbInstance.option("value", selectedKey);
                if (ddbInstance.option("opened")) {
                    ddbInstance.close();
                }

                const selectedRowData = e.selectedRowsData[0];
                if (selectedRowData) {
                    console.log("Selected company:", selectedRowData.CompanyName);
                   
                }
            }
        }

         function onDepartmentsChanged(e) {
            $.ajax({
