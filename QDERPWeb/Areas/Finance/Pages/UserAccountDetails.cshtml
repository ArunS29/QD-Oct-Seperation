    // Handle setting alert for Company Documents
    function onSetAlertNotificationClick() {
            debugger;
        const button = $("#btnNotificationsOnCompanyDocs").dxButton("instance");

        if (button.option("text") === "Set Alert Notification for Company Documents") {
            showNotificationConfirm(function () {
                const userId = getUserId();
                if (userId) {
                    $.post("/api/Utility/SetCompanyDocAlert", { userId: userId }, function (response) {
                        if (response.success) {
                            button.option("text", "Remove Alert Notification for Company Documents");
                            $("#lblAlertforCompanyDoc")
                                .text("This User Account is set to Receive Popup Notification on Expiry of Company Documents.")
                                .css("color", "blue");
                        } else {
                            DevExpress.ui.dialog.alert(response.message, "Error");
                        }
