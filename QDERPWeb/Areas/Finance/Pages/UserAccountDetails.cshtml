        function loadFinanceData(selectedText) {
            const urlParams = new URLSearchParams(window.location.search);
            const userId = urlParams.get("userId");

            $("#gridContainer").dxDataGrid({
                dataSource: new DevExpress.data.CustomStore({
                    key: "SlNo",
                    load: function () {
                        return $.getJSON(`/api/Utility/GetUserAccessWebs?userId=${userId}&selectedText=${selectedText}`)
                            .then(function (result) {
                                return {
                                    data: result.data,
                                    totalCount: result.totalCount
                                };
                            });
                    }
                }),
                remoteOperations: false,
                height: 500,
                columnAutoWidth: true,
                scrolling: {
                    mode: "virtual",
                    showScrollbar: "always"
                },
                columns: [
                    { dataField: "SlNo", caption: "Serial No", visible: false },
                    { dataField: "ItemForm", caption: "Item Name" },
                    { dataField: "ItemDescription", caption: "Action Name" },
                    {
                        dataField: "ItemVisible",
                        caption: "Visible",
                        dataType: "boolean",
                        cellTemplate: function (container, options) {
                            $("<div>")
                                .dxCheckBox({
                                    value: options.value,
                                    onValueChanged: function (e) {
                                        const items = [{
