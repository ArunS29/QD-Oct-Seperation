@page
@using DevExtreme.AspNet.Mvc

@{
    ViewData["Title"] = "User Account Details";
}

<form id="userForm">
    <div class="title">
        <div class="header-container">
            <h2>User Account Details</h2>
        </div>
    </div>

    <div id="tabPanelContainer">
        @(Html.DevExtreme().TabPanel()
                .ID("accessTabPanel")
                .Items(items =>
                {
                    items.Add()
                .Title("User Account Details")
                .Template(@<text>
            <div class="dx-form" style="padding: 20px; max-width: 1200px;">
                <div class="form-grid">

                    <div class="form-group">
                        <label>User ID:</label>
                        @(Html.DevExtreme().TextBox().ID("UserId").Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>User Name:</label>
                        @(Html.DevExtreme().TextBox().ID("UserName").Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>Password:</label>
                        @(Html.DevExtreme().TextBox().ID("Password").Mode(TextBoxMode.Password).Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>Department :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .ID("ddDepartment")
                        .DataSource(d => d.WebApi()
                        .Controller("utility")
                        .LoadAction("GetDepartments")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("DepartmentCode"))
                        .DisplayExpr("Department")
                        .ValueExpr("DepartmentCode")
                        .ShowClearButton(true)
                        .Placeholder("Select Department")
                        //.AcceptCustomValue(false)
                        //.Label("Department")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        .DropDownOptions(d => d.Width("100%"))
                        .ContentTemplate(new TemplateName("DepartmentContentTemplate"))
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired().Message("Please select a department.");
                        })
                        )
                    </div>

                    <div class="form-group">
                        <label>Company Branch :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi().Controller("utility").LoadAction("GetCompanies").LoadMode(DataSourceLoadMode.Raw).Key("CompanyID"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddCompany")
                        .ValidationRules(rules => {
                        rules.AddRequired().Message("Please select a company.");
                        })
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .Value(null)
                        .ValueExpr("CompanyID")
                        .DisplayExpr("CompanyName")
                        .Width("100%")
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        //.Width("100%") // Set the desired width for the dropdown content*@
                        .Width(1000)
                        )
                        // .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("CompanyContentTemplate")))

                    </div>




                    <div class="form-group">
                        <label>Company Division :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi().Controller("utility").LoadAction("GetBranches").LoadMode(DataSourceLoadMode.Raw).Key("BranchCode"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddBranch")
                        .ValidationRules(rules => {
                        rules.AddRequired().Message("Please select a Division.");
                        })
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .Value(null)
                        .ValueExpr("BranchCode")
                        .DisplayExpr("BranchName")
                        .Width("100%")
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        //.Width("100%") // Set the desired width for the dropdown content*@
                        .Width(1000)
                        )
                        // .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("BranchContentTemplate")))

                    </div>

                    <div class="form-group">
                        <label>User Level :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi().Controller("utility").LoadAction("GetUserLevels").LoadMode(DataSourceLoadMode.Raw).Key("UserLevelID"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddUserLevel")
                        .ValidationRules(rules => {
                        rules.AddRequired().Message("Please select a user level.");
                        })
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .Value(null)
                        .ValueExpr("UserLevelID")
                        .DisplayExpr("UserLevelDesc")
                        .Width("100%")
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        //.Width("100%") // Set the desired width for the dropdown content*@
                        .Width(1000)
                        )
                        // .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("UserLevelContentTemplate")))

                    </div>

                    <div class="form-group">
                        <label>Employee File Access Group :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi().Controller("utility").LoadAction("GetEmployeeGroups").LoadMode(DataSourceLoadMode.Raw).Key("EmpGroupID"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddEmployeeGroup")
                        .ValidationRules(rules => {
                        rules.AddRequired().Message("Please select an employee group.");
                        })
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .Value(null)
                        .DisplayExpr("EmployeeGroup")
                        .ValueExpr("EmpGroupID")
                        .Width("100%")
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        //.Width("100%") // Set the desired width for the dropdown content*@
                        .Width(1000)
                        )
                        // .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("EmployeeGroupContentTemplate")))

                    </div>


                    <div class="form-group">
                        <label>Inventory Master Access:</label>
                        @(Html.DevExtreme().DropDownBox()
                        .ID("ddInventoryMasterGroup")
                        .DataSource(d => d.WebApi()
                        .Controller("utility")
                        .LoadAction("GetInventoryGroups")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("InventoryMasterGroupID")
                        )
                        .DisplayExpr("InventoryMasterGroup")
                        .ValueExpr("InventoryMasterGroupID")
                        .ShowClearButton(true)
                        .Placeholder("Select Inventory Group")
                        .AcceptCustomValue(false)
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        .DropDownOptions(d => d.Width("100%"))
                        .ContentTemplate(new TemplateName("InventoryGroupContentTemplate"))
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired().Message("Please select an inventory group.");
                        })
                        )
                    </div>

                    <div class="form-group">
                        <label>Petty Cash Account(Finance Module) :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi().Controller("utility").LoadAction("GetFilteredAccountHead").LoadMode(DataSourceLoadMode.Raw).Key("AccountId"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddFilteredAccountHead")
                        .ValidationRules(rules => {
                        rules.AddRequired().Message("Ledger Account should be entered.");
                        })
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .Value(null)
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .Width("100%")
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        //.Width("100%") // Set the desired width for the dropdown content*@
                        .Width(1000)
                        )
                        // .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("FilteredAccountHeadContentTemplate")))

                    </div>


                    <div class="form-group">
                        <label>Equipment Sales Person Access :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('User Level')"))
                        .ID("ddHRUserLevel")
                        .DataSource(d => d.WebApi()
                        .Controller("Utility")
                        .LoadAction("GetHRUserLevels")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("HruserLevelId")
                        )
                        .ValidationRules(rules => {
                        rules.AddRequired().Message(new JS("formatMessage('User Level should be selected')"));
                        })
                        .LabelMode(EditorLabelMode.Outside)
                        .ShowClearButton(true)
                        .AcceptCustomValue(false)
                        .ValueExpr("HruserLevelId")
                        .DisplayExpr("HruserLevelDesc")
                        .Placeholder("Select Equipment Sales Person Access")
                        .Width("100%")
                        .DropDownOptions(o => o.Width("100%"))
                        .ContentTemplate(new TemplateName("HRUserLevelContentTemplate"))
                        )
                    </div>

                    <div class="form-group">
                        <label>Inventory Sales Person Access :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi().Controller("utility").LoadAction("GetSalesPersonAccessLevels").LoadMode(DataSourceLoadMode.Raw).Key("SalesPersonID"))
