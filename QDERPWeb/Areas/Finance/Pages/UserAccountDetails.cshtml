        function onTabSelectionChanged(e) {
            var selectedIndex = e.component.option('selectedIndex');
            var selectedText = e.component.option('items')[selectedIndex].text;

            // Hide all containers
            $('.tab-container').hide();

            // Show the correct container
            $('.tab-container').eq(selectedIndex).show();

            if (selectedText === "Finance") {
                loadFinanceData(selectedText);
            }

            if (selectedText === "Master Module") {
                loadMasterModuleData(selectedText);
            }
