        function saveUserDetails() {
            const user = {
                UserId: $("#UserId").dxTextBox("instance").option("value"),
                UserName:$("#UserName").dxTextBox("instance").option("value"),
                Password:  $("#Password").dxTextBox("instance").option("value"),
                 DeptCode: $("#ddCompany").dxDropDownBox("instance").option("value"),
                 // BranchCode: $("#ddBranch").dxSelectBox("instance").option("value"),
                 // Division: $("#Division").dxSelectBox("instance").option("value"),
                 // UserLevel: $("#UserLevel").dxSelectBox("instance").option("value"),
                 // AccessGroup: $("#AccessGroup").dxSelectBox("instance").option("value"),
                 // InventoryAccess: $("#InventoryAccess").dxSelectBox("instance").option("value"),
                 // PettyCashAccount: $("#PettyCashAccount").dxSelectBox("instance").option("value"),
                 // EquipmentSalesPerson: $("#EquipmentSalesPerson").dxSelectBox("instance").option("value"),
                 // InventorySalesPerson: $("#InventorySalesPerson").dxSelectBox("instance").option("value"),
                 // HRTimesheetGroup: $("#HRTimesheetGroup").dxSelectBox("instance").option("value"),
                 MobileNo: $("#UserMobileNo").dxTextBox("instance").option("value"),
                 EmailAddress: $("#UserEmailAddress").dxTextBox("instance").option("value"),
                 LastLogOnTime: $("#UserLastLoggedInTime").dxDateBox("instance").option("value"),
                 LastLogOffTime: $("#UserLastLoggedOffTime").dxDateBox("instance").option("value")
            };

            $.ajax({
                url: "/api/Utility/SaveUserDetails", 
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(user),
                success: function (response) {
                    DevExpress.ui.notify("User details saved successfully!", "success", 3000);
                },
                error: function () {
                    DevExpress.ui.notify("Failed to save user details", "error", 3000);
                }
            });
        }





