@page
@using DevExtreme.AspNet.Mvc

@{
    ViewData["Title"] = "User Account Details";
}

<form id="userForm">
    <div class="title">
        <div class="header-container">
            <h2>User Account Details</h2>
        </div>
    </div>

    <div id="tabPanelContainer">
        @(Html.DevExtreme().TabPanel()
                .ID("accessTabPanel")
                .Items(items =>
                {
                    items.Add()
                .Title("User Account Details")
                .Template(@<text>
            <div class="dx-form" style="padding: 20px; max-width: 1200px;">
                <div class="form-grid">

                    <div class="form-group">
                        <label>User ID:</label>
                        @(Html.DevExtreme().TextBox().ID("UserId").Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>User Name:</label>
                        @(Html.DevExtreme().TextBox().ID("UserName").Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>Password:</label>
                        @(Html.DevExtreme().TextBox().ID("Password").Mode(TextBoxMode.Password).Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>Department :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .ID("ddDepartment")
                        .DataSource(d => d.WebApi()
                        .Controller("utility")
                        .LoadAction("GetDepartments")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("DepartmentCode"))
                        .DisplayExpr("Department")
                        .ValueExpr("DepartmentCode")
                        .ShowClearButton(true)
                        .Placeholder("Select Department")
                        .AcceptCustomValue(false)
                        //.Label("Department")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        .DropDownOptions(d => d.Width("100%"))
                        .ContentTemplate(new TemplateName("DepartmentContentTemplate"))
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired().Message("Please select a department.");
                        })
                        )
                    </div>

                    <div class="form-group">
                        <label>Company Branch :</label>
                            @(Html.DevExtreme().DropDownBox()
                            .ID("ddCompany")
                            .DataSource(d => d.WebApi()
                            .Controller("utility") 
                            .LoadAction("GetCompanies")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("CompanyID")
                            )
                            .DisplayExpr("Company Name")
                            .ValueExpr("CompanyID")
                            .ShowClearButton(true)
                            .Placeholder("Select Company")
                            .AcceptCustomValue(false)
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            .DropDownOptions(d => d.Width("100%"))
                            .ContentTemplate(new TemplateName("CompanyContentTemplate"))
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired().Message("Please select a company.");
                            })
                            )
                    </div>

                    <div class="form-group">
                        <label>Company Division :</label>
                            @(Html.DevExtreme().DropDownBox()
                            .ID("ddBranch")
                            .DataSource(d => d.WebApi()
                            .Controller("utility")
                            .LoadAction("GetBranches") 
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("BranchCode")
                            )
                            .DisplayExpr("BranchName")
                            .ValueExpr("BranchCode")
                            .ShowClearButton(true)
                            .Placeholder("Select Branch")
                            .AcceptCustomValue(false)
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            .DropDownOptions(d => d.Width("100%"))
                            .ContentTemplate(new TemplateName("BranchContentTemplate"))
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired().Message("Please select a Division.");
                            })
                            )
                    </div>

                    <div class="form-group">
                        <label>User Level :</label>
                                @(Html.DevExtreme().DropDownBox()
                                .ID("ddUserLevel")
                                .DataSource(d => d.WebApi()
                                .Controller("utility")
                                .LoadAction("GetUserLevels")
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("UserLevelID")
                                )
                                .DisplayExpr("UserLevelDesc")
                                .ValueExpr("UserLevelID")
                                .ShowClearButton(true)
                                .Placeholder("Select User Level")
                                .AcceptCustomValue(false)
                                .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            .DropDownOptions(d => d.Width("100%"))
                                .ContentTemplate(new TemplateName("UserLevelContentTemplate"))
                                .ValidationRules(rules =>
                                {
                                rules.AddRequired().Message("Please select a user level.");
                                })
                                )
                    </div>

                    <div class="form-group">
                        <label>Employee File Access Group :</label>
                                @(Html.DevExtreme().DropDownBox()
                                .ID("ddEmployeeGroup")
                                .DataSource(d => d.WebApi()
                                .Controller("utility")
                                .LoadAction("GetEmployeeGroups") 
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("EmpGroupID")
                                )
                                .DisplayExpr("EmployeeGroup")
                                .ValueExpr("EmpGroupID")
                                .ShowClearButton(true)
                                .Placeholder("Select Employee Group")
                                .AcceptCustomValue(false)
                                .LabelMode(EditorLabelMode.Outside)
                                .Width("100%")
                                .DropDownOptions(d => d.Width("100%"))
                                .ContentTemplate(new TemplateName("EmployeeGroupContentTemplate"))
                                .ValidationRules(rules =>
                                {
                                rules.AddRequired().Message("Please select an employee group.");
                                })
                                )
                    </div>

                    <div class="form-group">
                        <label>Inventory Master Access:</label>
                            @(Html.DevExtreme().DropDownBox()
                            .ID("ddInventoryMasterGroup")
                            .DataSource(d => d.WebApi()
                            .Controller("utility")
                            .LoadAction("GetInventoryGroups") 
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("InventoryMasterGroupID")
                            )
                            .DisplayExpr("InventoryMasterGroup")
                            .ValueExpr("InventoryMasterGroupID")
                            .ShowClearButton(true)
                            .Placeholder("Select Inventory Group")
                            .AcceptCustomValue(false)
                            .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        .DropDownOptions(d => d.Width("100%"))
                            .ContentTemplate(new TemplateName("InventoryGroupContentTemplate"))
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired().Message("Please select an inventory group.");
                            })
                            )
                    </div>

                    <div class="form-group">
                        <label>Petty Cash Account(Finance Module) :</label>
                            @(Html.DevExtreme().DropDownBox()
                            .ID("ddFilteredAccountHead")
                            .DataSource(d => d.WebApi()
                            .Controller("utility")
                            .LoadAction("GetFilteredAccountHead") 
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("AccountId")
                            )
                            .ValueExpr("AccountId")
                            .DisplayExpr("AccountHead")
                            .ShowClearButton(true)
                            .Placeholder("Select FilteredAccount Head")
                            .AcceptCustomValue(false)
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            .DropDownOptions(o => o.Width("100%"))
                            .ContentTemplate(new TemplateName("FilteredAccountHeadContentTemplate"))
                            .ValidationRules(rules => {
                            rules.AddRequired().Message("Ledger Account should be entered");
                            })
                            
                            )
                        </div>

                    <div class="form-group">
                        <label>Equipment Sales Person Access :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('User Level')"))
                        .ID("ddHRUserLevel")
                        .DataSource(d => d.WebApi()
                        .Controller("Utility") 
                        .LoadAction("GetHRUserLevels") 
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("HruserLevelId")
                        )
                        .ValidationRules(rules => {
                        rules.AddRequired().Message(new JS("formatMessage('User Level should be selected')"));
                        })
                        .LabelMode(EditorLabelMode.Outside)
                        .ShowClearButton(true)
                        .AcceptCustomValue(false)
                        .ValueExpr("HruserLevelId")
                        .DisplayExpr("HruserLevelDesc")
                        .Placeholder("Select Equipment Sales Person Access")
                        .Width("100%")
                        .DropDownOptions(o => o.Width("100%"))
                        .ContentTemplate(new TemplateName("HRUserLevelContentTemplate"))
                        )
                    </div>

                    <div class="form-group">
                        <label>Inventory Sales Person Access :</label>
                        @(Html.DevExtreme().DropDownBox()
                        .ID("ddSalesPerson")
                        .ValueExpr("SalesPersonID")
                        .DisplayExpr("SalesPersonAccessLevelId")
                        .Placeholder("Select Sales Person")
                        .ShowClearButton(true)
                        .AcceptCustomValue(false)
                        .Width("100%")
                        .DataSource(d => d.WebApi()
                        .Controller("Utility")
                        .LoadAction("GetSalesPersonAccessLevels")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("SalesPersonAccessLevelId")
                        )
                        .ContentTemplate(new TemplateName("SalesPersonDropDownTemplate"))
                        .OnValueChanged("onSalesPersonValueChanged")
                        )
                    </div>

                    <div class="form-group">
                        <label>HR Employee Timesheet Group :</label><div class="form-group">
                            @(Html.DevExtreme().DropDownBox()
                            .DataSource(d => d.WebApi()
                            .Controller("Utility")
                            .LoadAction("GetProjectGroups")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("ProjectGroupID")
                            )
                            .ValidationRules(rules => {
                            rules.AddRequired().Message("Project Group is required");
                            })
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("ddProjectGroup")
                            .ShowClearButton(true)
                            .AcceptCustomValue(false)
                            //.OpenOnFieldClick(false)
                            //.ValueChangeEvent("input")
                            //.HoverStateEnabled(true)
                            .Placeholder("Select HR Employee Timesheet Group")
                            .ValueExpr("ProjectGroupID")
                            .DisplayExpr("ProjectGroupName")
                            .Width("100%")
                            .DropDownOptions(o => o.Width("100%"))
                            .ContentTemplate(new TemplateName("ProjectGroupContentTemplate"))
                            )
                        </div>
                    </div>


                    <div class="form-group">
                        <label>User Mobile No:</label>
                        @(Html.DevExtreme().TextBox().ID("UserMobileNo").Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>User Email Address:</label>
                        @(Html.DevExtreme().TextBox().ID("UserEmailAddress").Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>User Last Logged In Time:</label>
                        @(Html.DevExtreme().DateBox().ID("UserLastLoggedInTime").Width("100%"))
                    </div>

                    <div class="form-group">
                        <label>User Last Logged Off Time:</label>
                        @(Html.DevExtreme().DateBox().ID("UserLastLoggedOffTime").Width("100%"))
                    </div>

                </div>
                <div id="userProfileContainer" style="margin-top: 30px;"></div>

                <div class="form-actions">
                   
                    <button type="button" id="btnSave" class="btn btn-success" onclick="saveUserDetails()">Save</button>
                    @* <button type="button" id="btnResetPassword" class="btn btn-warning" onclick="resetPassword()">Reset Password</button> *@
                </div>
            </div>

        </text>);

                    items.Add()
                .Title("User Access Details")
                .Template(@<text>
            <div style="padding: 20px;">
                <p>Not Yet Initialized...</p>
            </div>
        </text>);
                })
            )
    </div>
</form>

@using (Html.DevExtreme().NamedTemplate("DepartmentContentTemplate"))
{
    @(Html.DevExtreme().DataGrid()
            .ID("department-datagrid")
            .DataSource(d => d.WebApi()
                .Controller("utility")
                .LoadAction("GetDepartments")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("DepartmentCode"))
            .Selection(s => s.Mode(SelectionMode.Single))
            .ShowBorders(true)
            .SearchPanel(s => s.Visible(true).HighlightSearchText(true))
            .Paging(p => p.PageSize(10))
            .FilterRow(f => f.Visible(true))
            .Height(300)
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .OnSelectionChanged("onDepartmentSelectionChanged")
            .Columns(columns =>
            {
                columns.Add().DataField("DepartmentCode").Caption("Code").Width(100);
                columns.Add().DataField("Department").Caption("Department Name");
            }))
}
