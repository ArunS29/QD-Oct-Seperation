@page
@model QD.ERP.Web.Areas.Finance.Pages.Index1Model
@using Newtonsoft.Json

@{
    ViewData["Title"] = "ERP Dashboard";
}

<!-- Styles & Libraries -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn3.devexpress.com/jslib/latest/css/dx.light.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn3.devexpress.com/jslib/latest/js/dx.all.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container-fluid py-4 dashboard-wrapper">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold text-gradient-primary">Finance Dashboard</h1>
        <p class="text-muted mb-0">Live insights into your ERP data</p>
    </div>

    <!-- KPI Cards -->
    <div class="row g-4 justify-content-center">
        <div class="col-md-4">
            <div class="card kpi-card shadow-sm h-100 border-top border-primary-subtle" id="clientcard">
                <div class="card-body text-center">
                    <h5 class="card-title text-uppercase small fw-semibold">Total Client Outstanding</h5>
                    <p id="totalClientOutstandingValue" class="display-6 kpi-value">0.00</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card kpi-card shadow-sm h-100 border-top border-primary-subtle" id="DashboardBankAccount">
                <div class="card-body text-center">
                    <h5 class="card-title text-uppercase small fw-semibold">Total Cash Balance</h5>
                    <p id="cashBalanceValue" class="display-6 kpi-value">0.00</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card kpi-card shadow-sm h-100 border-top border-primary-subtle" id="SupplierCard">
                <div class="card-body text-center">
                    <h5 class="card-title text-uppercase small fw-semibold">Total Supplier Outstanding</h5>
                    <p id="totalBillsOutstandingValue" class="display-6 kpi-value">0.00</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row mt-5 g-4">
        <div class="col-lg-6">
            <div class="card chart-card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">Outstanding (Bar Chart)</h5>
                    <canvas id="outstandingChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card chart-card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">Top Accounts (Pie Chart)</h5>
                    <canvas id="outstandingPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row mt-4 g-4">
        <div class="col-12">
            <div class="card chart-card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">Outstanding Trend (Trading‑Style Chart)</h5>
                    <canvas id="outstandingLineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Grids -->
    <div class="row mt-5 g-4">
        <div class="col-md-4">
            <div class="card shadow-sm data-card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Client Outstanding</h5>
                    <div id="clientOutstandingGrid"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm data-card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Supplier Outstanding</h5>
                    <div id="billsPayableGrid"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm data-card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Bank Account Summary</h5>
                    <div id="accountSummaryGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom styles -->
<style>
    :root {
        /* Brand palette */
        --clr-primary: #2563eb;
        --clr-primary-light: #3b82f6;
        --clr-primary-dark: #1e40af;
        --clr-secondary: #14b8a6;
        --clr-bg-start: #f7fbff;
        --clr-bg-end: #e3f0ff;
    }

    .dashboard-wrapper {
        background: linear-gradient(135deg, var(--clr-bg-start), var(--clr-bg-end));
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .text-gradient-primary {
        background: linear-gradient(90deg, var(--clr-primary), var(--clr-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .card {
        border: none;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(14px) saturate(180%);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12);
        }

    .kpi-card {
        border-top: 4px solid var(--clr-primary);
    }

    .kpi-value {
        color: var(--clr-primary-dark);
    }

    .chart-card canvas {
        width: 100% !important;
        height: 360px !important;
    }

    .data-card {
        background: rgba(255, 255, 255, 0.95);
    }

    /* Dark‑mode tweaks */
    @@media (prefers-color-scheme: dark) {
        : root {
            --clr-bg-start: #1e1e2e;
            --clr-bg-end: #11111b;
            --clr-primary: #60a5fa;
            --clr-primary-light: #93c5fd;
            --clr-primary-dark: #3b82f6;
            --clr-secondary: #2dd4bf;
        }

        .card {
            background: white;
            color: black;
            box-shadow: 0 18px 32px rgba(0, 0, 0, 0.5);
        }

        .kpi-value {
            color: var(--clr-primary-light);
        }

        .chart-card canvas {
            width: 100% !important;
            height: 540px !important; /* Increased from 360px to 480px */
        }
    }
</style>

<script>
    /* --- Navigation helpers --- */
    const tenantName = window.tenantName || '';   // safe fallback
    const dashboardRoutes = {
        clientcard:           "DashboardClient",
        SupplierCard:         "DashboardSupplier",
        DashboardBankAccount: "DashboardBankAccount"
    };
    Object.keys(dashboardRoutes).forEach(cardId => {
        document.getElementById(cardId)
                .addEventListener('click', () =>
                    window.location.href = `/${tenantName}/Finance/${dashboardRoutes[cardId]}`);
    });

    /* --- KPI fetchers --- */
    const apiEndpoints = [
        { url: "/api/Dashboard/supplieroutstanding",          target: "#totalBillsOutstandingValue",   key: "balance" },
        { url: "/api/Dashboard/GetTotalClientOutstanding",    target: "#totalClientOutstandingValue",  key: "balance" },
        { url: "/api/Dashboard/GetCashBalance",               target: "#cashBalanceValue",             key: "balance" }
    ];
    apiEndpoints.forEach(ep =>
        $.getJSON(ep.url, res => res.success &&
            $(ep.target).text(parseFloat(res[ep.key]).toLocaleString('en-IN'))));

    /* --- Grid helper --- */
    function initGrid(selector, url, cols, summary) {
        $.getJSON(url, res => {
            if (!res.data) return;
            $(selector).dxDataGrid({
                dataSource: res.data,
                columns: cols,
                columnAutoWidth: true,
                showBorders: true,
                filterRow: { visible: true },
                summary: { totalItems: summary },
                paging: { enabled: false },
                height: 400
            });
        });
    }

    /* --- DOM ready --- */
    $(function () {
        initGrid('#clientOutstandingGrid', '/api/Dashboard/GetClientOutstanding', [
            { dataField: 'AccountHead', caption: 'Account Head' },
            { dataField: 'Balance',     caption: 'Balance',      format: { type: 'fixedPoint', precision: 2 } }
        ], [{ column: 'Balance', summaryType: 'sum', valueFormat: { type: 'fixedPoint', precision: 2 } }]);

        initGrid('#billsPayableGrid', '/api/Dashboard/GetBillsPayableOutstanding', [
            { dataField: 'AccountHead', caption: 'Account Head' },
            { dataField: 'Balance',     caption: 'Balance',      format: { type: 'fixedPoint', precision: 2 } }
        ], [{ column: 'Balance', summaryType: 'sum', valueFormat: { type: 'fixedPoint', precision: 2 } }]);

        initGrid('#accountSummaryGrid', '/api/Dashboard/GetBankAccountSummary', [
            { dataField: 'AccountHeadName', caption: 'Account Head' },
            { dataField: 'Balance',         caption: 'Balance',     format: { type: 'fixedPoint', precision: 2 } }
        ], [{ column: 'Balance', summaryType: 'sum', valueFormat: { type: 'fixedPoint', precision: 2 } }]);
    });

    /* --- Charts --- */
    $.get('/api/Dashboard/GetOutstandingChartData', res => {
        if (!res.success) return;

        const labels = res.data.map(i => i.AccountHead);
        const values = res.data.map(i => i.Balance);
        const brightColors = labels.map((_, i) => `hsl(${i * 37 % 360},85%,55%)`);

        /* Bar */
        new Chart('outstandingChart', {
            type: 'bar',
            data: { labels, datasets: [{
                label: 'Outstanding',
                data: values,
                backgroundColor: brightColors,
                borderRadius: 6,
                borderSkipped: false
            }]},
            options: {
                responsive: true,
                animation: { duration: 800 },
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: v => v.toLocaleString('en-IN') }
                    }
                }
            }
        });

        /* Pie */
        new Chart('outstandingPieChart', {
            type: 'pie',
            data: { labels, datasets: [{ data: values, backgroundColor: brightColors }] },
            options: {
                responsive: true,
                animation: { duration: 900, animateRotate: true, animateScale: true },
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.parsed.toLocaleString('en-IN')}` } }
                }
            }
        });

        /* Line */
        const ctx = document.getElementById('outstandingLineChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 320);
        gradient.addColorStop(0, 'rgba(78,115,223,0.40)');
        gradient.addColorStop(1, 'rgba(78,115,223,0)');

        new Chart(ctx, {
            type: 'line',
            data: { labels, datasets: [{
                label: 'Outstanding',
                data: values,
                borderColor: '#4e73df',
                backgroundColor: gradient,
                pointRadius: 4,
                pointHoverRadius: 6,
                tension: 0.35,
                fill: true
            }]},
            options: {
                responsive: true,
                animation: { duration: 900, easing: 'easeOutCirc' },
                interaction: { mode: 'nearest', axis: 'x', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ctx.parsed.y.toLocaleString('en-IN') } }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'Inter', size: 10 }, color: '#6c757d' }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [4, 4] },
                        ticks: {
                            font: { family: 'Inter', size: 10 },
                            color: '#6c757d',
                            callback: v => v.toLocaleString('en-IN')
                        }
                    }
                }
            }
        });
    });
</script>
