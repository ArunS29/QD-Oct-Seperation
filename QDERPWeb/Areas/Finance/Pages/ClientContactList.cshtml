@page
@model QD.ERP.Web.Areas.Finance.Pages.ClientContactListModel
@{
    ViewData["Title"] = "Client Contact List";
}

<style>
    .form-container {
        width: 1000px;
        height: 800px;
        border: 5px solid lightblue;
        margin: 10%;
        padding: 10px;
        border: 1px solid lightblue;
        border-radius: 6px;
    }


    .form-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 10px;
    }

    .form-field {
        flex: 1;

        justify-content: flex-start;
        gap: 10px;
        margin-top: 20px;
        margin-left: 10px;
    }

    .form-header {
        padding: 10px;
        border: 1px solid lightblue;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 15px;

    }

    .white-bg .dx-icon {
        font-size: 20px; /* Adjust the icon size */
        color: #007bff; /* Change the icon color */
    }

    .white-bg .dx-texteditor-input {
        background-color: white !important;
    }
</style>

<div class="form-container">
    <div class="form-header">Client Contact List</div>

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("clientCode")
                .Label("Client Code")
                .Width("400px")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))

        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("clientHidden")
                .Width("400px")
                .Value("-1")
                .ReadOnly(true)
                .Label(" ")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="flex: 1 1 100%;">
            @(Html.DevExtreme().TextBox()
                .ID("clientName")
                .Width("900px")
                .Label("Client Name")
                .LabelMode(EditorLabelMode.Outside)

                .ElementAttr("class", "white-bg")
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("contactPerson")
                .Label("Contact Person")
                .LabelMode(EditorLabelMode.Outside)
                .Width("400px")
                .ElementAttr("class", "white-bg")

                )
        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("title")
                .Width("400px")
                .Label("Title")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
    </div>

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("division")
                .Width("400px")
                .Label("Division / Branch")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("location")
                .Width("400px")
                .Label("Location")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg")
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("mobile1")
                .Width("400px")
                .Label("Mobile Number (1)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("phone1")
                .Width("400px")
                .Label("Phone No. (1)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
    </div>

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("mobile2")
                .Width("400px")
                .Label("Mobile Number (2)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("phone2")
                .Width("400px")
                .Label("Phone No. (2)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
    </div>

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("fax")
                .Label("Fax No")
                .Width("400px")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("email")
                .Width("400px")
                .Label("Email")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
    </div>

    <div class="toolbar-buttons">
        @(Html.DevExtreme().Button().ID("btnSave").Text("Save").Icon("save").OnClick("onSaveClient"))
        @(Html.DevExtreme().Button().ID("btnSaveClose").Text("Save & Close").Icon("save").OnClick("onSaveAndClose"))
        @(Html.DevExtreme().Button().ID("btnDelete").Text("Delete").Icon("trash").OnClick("onDeleteClient"))
        @(Html.DevExtreme().Button().ID("btnBack").Text("Back").Icon("back").OnClick("onBackToList"))
    </div>
</div>

<script>
    function onSaveClient() {
        DevExpress.ui.notify("Client Saved", "success", 1000);
    }

    function onSaveAndClose() {
        DevExpress.ui.notify("Saved & Closed", "success", 1000);
    }

    function onDeleteClient() {
        DevExpress.ui.notify("Client Deleted", "error", 1000);
    }

    function onBackToList() {
        DevExpress.ui.notify("Returning to list", "info", 1000);
    }
</script>