        $(document).ready(function () {
            $.ajax({
                url: "/api/Dashboard/GetBillsOutstandingAgingForChartSupplier",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                            const labels = response.data.map(item => `${item.AccountHead?? formatMessage("Unknown")}`);
                        const balances = response.data.map(item => item.Balance);

                        const ctx = document.getElementById("billsOutstandingChart").getContext("2d");

                       

                   


                        new Chart(ctx, {
                            type: "bar",
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: formatMessage("Balance Amount"),
                                    data: balances,
                                    backgroundColor: "#007acc",
                                    borderColor: "#007acc",
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: false,
                                plugins: {
                                    legend: {
                                        display: true,
                                        labels: {
                                            font: {
                                                size: 12
                                            }
                                        }
                                    },
                                    tooltip: {
                                        enabled: true,
                                        callbacks: {
                                            label: function (context) {
                                                return `Balance: ${context.raw.toLocaleString(undefined, { minimumFractionDigits: 2 })}`;
                                            }
                                        }
                                    },
                                    title: {
                                        display: true,
                                        text: "Top 5 Bills Outstanding by Overdue Group",
                                        font: {
                                            size: 16,
                                            weight: "bold"
                                        }
                                    }
                                },
                                scales: {
                                    x: {
                                        title: {
                                            display: true,
                                            text: "Overdue Groups",
                                            font: {
                                                size: 14,
                                                weight: "bold"
                                            }
                                        },
                                        ticks: {
                                            autoSkip: false,
                                            maxRotation: 45,
                                            minRotation: 0
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: true,
                                            text: "Balance Amount",
                                            font: {
                                                size: 14,
                                                weight: "bold"
                                            }
                                        },
                                        ticks: {
                                            callback: function (value) {
                                                return value.toLocaleString();
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    } else {
                        console.error("Error loading data: ", response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching data: ", error);
                }
            });
        });

        $.getJSON("/api/Dashboard/GetCashBalance", function (response) {
            if (response.success) {
                    $("#cashBalanceValue").text(response.cashBalance.toLocaleString('en-US'));
