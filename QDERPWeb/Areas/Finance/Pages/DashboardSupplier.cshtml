    $(document).ready(function () {
       
          $.ajax({
    url: "/api/Dashboard/GetOutstandingChartData",
    type: "GET",
    dataType: "json",
    success: function (response) {
        if (response.success) {
            const data = response.data;

            const clientData = data.filter(item => item.Type === "Client");
            const supplierData = data.filter(item => item.Type === "Supplier");

            const labels = [...new Set(data.map(item => item.AccountHead))];

            const clientBalances = labels.map(label => {
                const item = clientData.find(d => d.AccountHead === label);
                return item ? item.Balance : 0;
            });

            const supplierBalances = labels.map(label => {
                const item = supplierData.find(d => d.AccountHead === label);
                return item ? item.Balance : 0;
            });

            new Chart("outstandingChart", {
                type: "bar", // Correct chart type to "bar"
                data: {
                    labels: labels, // Set labels directly for x-axis
                    datasets: [
                        {
                            label: formatMessage("Client Outstanding"),
                            backgroundColor: "rgba(0, 123, 255, 0.5)",
                            borderColor: "rgba(0, 123, 255, 1)",
                            data: clientBalances, // Use the prepared balances directly
                        },
                        {
                            label: formatMessage("Supplier Outstanding"),
                            backgroundColor: "rgba(255, 99, 132, 0.5)",
                            borderColor: "rgba(255, 99, 132, 1)",
                            data: supplierBalances, // Use the prepared balances directly
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        x: {
                            title: { display: true, text: formatMessage("Accounts") },
                            // Optionally, you can set the "category" scale if needed
                        },
                        y: {
                            title: { display: true, text: formatMessage("Outstanding Amount") }
                        }
                    }
                }
            });
        } else {
            console.error("Error fetching data");
        }
    },
    error: function (error) {
        console.error("Error fetching data: ", error);
    }
});

