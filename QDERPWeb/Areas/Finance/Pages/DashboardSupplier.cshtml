    $(document).ready(function () {
        const apiEndpoints = [
            { url: "/api/Dashboard/supplieroutstanding", target: "#totalBillsOutstandingValue ", key: "balance" },
            { url: "/api/Dashboard/GetTotalClientOutstanding", target: "#totalClientOutstandingValue", key: "balance" },
            { url: "/api/Dashboard/GetCashBalance", target: "#cashBalanceValue", key: "balance" }
        ];

        const fetchData = async (endpoint) => {
            const startTime = performance.now();
            try {
                const response = await $.getJSON(endpoint.url);
                if (response.success) {
                    $(endpoint.target).text(response[endpoint.key].toLocaleString('en-US'));
                } else {
                    console.error(`Error loading data from ${endpoint.url}`);
                }
            } catch (error) {
                console.error(`Error fetching data from ${endpoint.url}:`, error);
            } finally {
                const endTime = performance.now();
                console.log(`Response time for ${endpoint.url}: ${(endTime - startTime).toFixed(2)} ms`);
            }
        };

        apiEndpoints.forEach(fetchData);
    });

