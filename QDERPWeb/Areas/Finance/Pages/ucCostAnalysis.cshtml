        let extraFieldsVisible = false; // Flag to track toggle state

    function onShowFieldsClick(e) {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        const dataSource = pivotGrid.getDataSource();

        // Base fields (always visible)
        const baseFields = [
            { dataField: "CostAllocationMasterGroup", area: "row", caption: "Cost Master", expanded: true },
            { dataField: "CostAllocationGroup", area: "row", caption: "Cost Center Group", expanded: true },
            { dataField: "CostAllocationUnit", area: "row", caption: "Cost Unit", expanded: true },
            { dataField: "PL", area: "column", caption: "Income / Expense" },
            { dataField: "Income", area: "data", summaryType: "sum", caption: "Income", format: { type: "fixedPoint", precision: 3 }, customizeText: customFormatter },
            // Expenses
            { dataField: "Expenses", area: "data", summaryType: "sum", caption: "Expenses", format: { type: "fixedPoint", precision: 3 }, customizeText: customFormatter },
            // Grand Total
            { dataField: "CostAmount", area: "data", summaryType: "sum", caption: "Grand Total", format: { type: "fixedPoint", precision: 3 }, customizeText: customFormatter }
        ];

        // Extra filter fields
        const extraFields = [
            { dataField: "MasterGroup", area: "filter", caption: "Account Master" },
            { dataField: "AccountGroup", area: "filter", caption: "Account Group" },
            { dataField: "AccountHead", area: "filter", caption: "Ledger Account Name" },
            { dataField: "CostCenterIncharge", area: "filter", caption: "Cost Center Incharge" },
            { dataField: "CostAllocationUnit", area: "filter", caption: "Cost Unit ID" },
            { dataField: "VoucherType", area: "filter", caption: "Voucher Type" },
            { dataField: "VoucherTypeAndNo", area: "filter", caption: "Voucher No" },
            {
                dataField: "EffectiveDate",
                area: "filter",
                caption: "Effective Date",
                format: "dd-MMM-yyyy"
            },
