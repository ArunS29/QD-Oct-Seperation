    $('#btnShowRowTotals').click(function () {
        showrowtotal(pivotData); // Correctly passing the data array
    });


    function showrowtotal(pivotData) {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        console.log("pivotData", pivotData);

        // Group by CostAllocationUnit (Cost Group)
        const grouped = {};
        pivotData.forEach(item => {
            const groupKey = item.CostAllocationUnit;
            if (!groupKey) return; // Skip if no group key
            if (!grouped[groupKey]) grouped[groupKey] = [];
            grouped[groupKey].push(item);
        });

        console.log("Grouped:", pivotData);

        // Create total rows for each Cost Group
        const totalRows = Object.entries(grouped).map(([groupName, rows]) => {
            const totalIncome = rows.reduce((sum, r) => sum + (r.Income || 0), 0);
            const totalExpenses = rows.reduce((sum, r) => sum + (r.Expenses || 0), 0);
            const totalCostAmount = rows.reduce((sum, r) => sum + (r.CostAmount || 0), 0);

            return {
                CostAllocationUnit: groupName + " Total",
                CostAllocationGroup: "", // Optional
                PL: "", // Leave blank
                Income: totalIncome,
                Expenses: totalExpenses,
                CostAmount: totalCostAmount
            };
        });

        // Debug: Check totals
        console.log("Total Rows:", totalRows);

        const updatedData = [...pivotData, ...totalRows];

        // Refresh PivotGrid with updated data
        pivotGrid.option("dataSource", {
            fields: [
                { dataField: "CostAllocationUnit", area: "row", caption: "Cost Group" },
                { dataField: "CostAllocationGroup", area: "row", caption: "Cost Center" },
                { dataField: "PL", area: "column", caption: "Income / Expense" },
                { dataField: "Income", area: "data", summaryType: "sum", caption: "Total Income" },
                { dataField: "Expenses", area: "data", summaryType: "sum", caption: "Total Expenses" },
                { dataField: "CostAmount", area: "data", summaryType: "sum", caption: "Grand Total" }
            ],
            store: updatedData
        });
    }
    function customFormatter(cellInfo) {
        const value = cellInfo.value;
        if (value < 0) {
            return "-" + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        } else {
            return value.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        }
    }
    
            

    function handleGridOptionChanged(e) {
        if (e.name === "columns" || e.name === "visible") {
            // Columns changed, so re-inject SVG
            injectHeaderSVG(); // slight delay to wait for DOM re-render
        }
    }
    function injectHeaderSVG() {
         debugger;
           let gridElement = $('#pivotGridContainer');
    let dataGrid = gridElement.dxDataGrid("instance");
    if (!dataGrid) return;

    // Get grouped data (with .items containing groups)
    let groupedData = dataGrid.getDataSource()?.items();
    if (!groupedData || groupedData.length === 0) return;

    // Get the first row from the first group
    let firstGroup = groupedData[0];
    let firstRowInGroup = firstGroup?.items?.[0];

    let svgIcon = firstRowInGroup?.CurrencyImage;
        if (!svgIcon) return;

        svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);

        gridElement.find(".dx-header-row td").each(function () {

            const $cell = $(this);
            const dataField = $cell.attr("data-field");  // 👈 This is key

                const $debitHeader = $(".credit-header");
                const debitText = $debitHeader.data("original-text") || $debitHeader.text().trim();
                $debitHeader.data("original-text", debitText); // Save original once

                $debitHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${debitText}</span>
                    </div>
                `);

                // 👉 Credit
                const $creditHeader = $(".received-header");
                const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                $creditHeader.data("original-text", creditText);

                $creditHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${creditText}</span>
                    </div>
                `);


                const $balanceHeader = $(".debit-header");
                const balanceText = $balanceHeader.data("original-text") || $balanceHeader.text().trim();
                $balanceHeader.data("original-text", balanceText);

                $balanceHeader.html(`
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                        ${svgIcon}
                        <span style="font-weight: bold;">${balanceText}</span>
                    </div>
                `);


        });
    }


