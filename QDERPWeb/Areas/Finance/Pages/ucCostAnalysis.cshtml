@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;
<style>
    #pivotGridContainer {
        flex-grow: 1; /* Allow the pivot grid to grow and fill available space */
        width: 100%; /* Ensure the grid stretches to full width */
        min-height: 400px; /* Set a minimum height to avoid small grid sizes */
        max-height: 600px; /* Optional, set a max height to control grid overflow */
        overflow: auto; /* Add scrollbars if the content overflows */
    }

    .container {
        border: 2px solid #ccc;
        border-radius: 8px;
        padding: 20px;
        margin: 20px;
        background-color: #f9f9f9;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        height: auto; /* Ensure the container height adjusts based on content */
    }

    .horizontal-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr); /* Four equal columns */
        gap: 10px; /* Spacing between fields */
        align-items: center; /* Align items properly */
        width: 100%;
    }

    .dx-field {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    #check{
        margin:50px;
    }
    /* Ensure the fourth column contains both "Use Effective Date" & "Show Records" */
    .dx-field-4 {
        display: flex;
        flex-direction: column; /* Stack the checkbox and button */
        gap: 10px; /* Add space between elements */
    }
</style>


<div class="container">
    <!-- Input Controls --> <div class="card-header" style=" color:black; font-weight: bold;">
        UcCostAnalysis
    </div>
    <div class="dx-fieldset horizontal-container">
        <div class="dx-field">
            <!-- SelectBox for Account Group -->
            @(Html.DevExtreme().SelectBox()
                .ID("requestedBy")
                .DataSource(d => d.Mvc().Controller("UCCostAnalysis").LoadAction("GetUser").LoadMode(DataSourceLoadMode.Raw))
                .Width(300)
                .ElementAttr("class", "button-alignment-down")
                .Label("Select Cost Allocation Group")
                .LabelMode(EditorLabelMode.Outside)
                .SearchEnabled(true)
                .DisplayExpr("CostAllocationUnit")
                .Value(null)
                .ShowClearButton(true)
                .OnValueChanged("onRequestedByChanged")
                )
        </div>

        <div class="dx-field">
            <!-- Start Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("frmdateBox")
                .Label("Start Date")
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(2)
                )
        </div>

        <div class="dx-field">
            <!-- End Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("todateBox")
                .Label("End Date")
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(3)
                )
        </div>

        <div class="dx-field dx-field-4"id="check">
            <!-- Use Effective Date Checkbox -->
            @(Html.DevExtreme().CheckBox()
                .ID("useEffectiveDate")
                .Text("Use Effective Date")
                .Value(false)
                )

            <!-- Dropdown Button to Show Records -->
            @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnShowRecords")
                .Text("Show Records")
                .Icon("smalliconslayout")
                .Width(180)
                .ElementAttr("class", "button-alignment-down")
                .TabIndex(4)
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                    items.Add().Text("Show Records").Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                    items.Add().Text("Today").Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                    items.Add().Text("Yesterday").Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                    items.Add().Text("This Week").Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                    items.Add().Text("This Month Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                    items.Add().Text("This Month (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                    items.Add().Text("This Year Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                    items.Add().Text("This Year (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                    items.Add().Text("Last Month").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                    items.Add().Text("Last Year").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                })
                )
        </div>
    </div>


    <!-- Pivot Grid Container --><script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>



    <div id="pivotGridContainer"></div>
    </br>
    <!-- Grid Footer Partial -->
    @await Html.PartialAsync("_GridFooterUCCA")
</div>

<script type="text/javascript">
    // Function to handle changes in the Account Group selection
    function onRequestedByChanged(e) {
        var selectedValue = e.value; // Get the selected value from the SelectBox

        var selectBox = $("#requestedBy").dxSelectBox("instance");
        var dataSource = selectBox.option("dataSource");

        if (dataSource && dataSource.store) {
            var store = dataSource.store;

            if (store instanceof DevExpress.data.DataSource) {
                // Apply a filter to the DataSource store
                if (selectedValue) {
                    store.filter(["CostAllocationUnit", "=", selectedValue]);
                } else {
                    store.filter(null); // Remove the filter if no value is selected
                }

                // Reload the data to reflect the filter change
                store.load();
            } else if (Array.isArray(store)) {
                // Apply filtering manually for array-based store
                var filteredData = store.filter(item => item.CostAllocationUnit === selectedValue);
                selectBox.option("dataSource", filteredData);
            } else {
                console.error("The store is neither a DevExpress.data.DataSource nor an array:", store);
            }
        } else {
            console.error("The dataSource does not have a store or is not structured as expected:", dataSource);
        }
                }$(document).ready(function () {
        // Load all records on page load (ignore default date values)
        loadAllRecords();
    });

    function loadAllRecords() {
        console.log("Loading all records (ignoring default dates)...");

        $.ajax({
            url: '/api/UCCostAnalysis/GetTrialBalance',
            type: 'GET',
            data: {},  // No filters applied
            success: function (data) {
                initializePivotGrid(data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching all records: ", error);
            }
        });
    }

    function ddBtnShowRecords_click(e) {
        // Get the start and end dates
        var startDate = $("#frmdateBox").dxDateBox("instance").option("value");
        var endDate = $("#todateBox").dxDateBox("instance").option("value");

        // Get the selected AccountGroup object from the select box
        var getaccountGroup = $("#requestedBy").dxSelectBox("instance").option("value");
        var accountGroup = getaccountGroup ? getaccountGroup.CostAllocationUnit : null;

        console.log("Fetching records with:", {
            startDate: startDate ? startDate.toISOString().split('T')[0] : "All Dates",
            endDate: endDate ? endDate.toISOString().split('T')[0] : "All Dates",
            accountGroup: accountGroup || "All Account Groups"
        });

        $.ajax({
            url: '/api/UCCostAnalysis/GetTrialBalance',
            type: 'GET',
            data: {
                startDate: startDate ? startDate.toISOString().split('T')[0] : null,
                endDate: endDate ? endDate.toISOString().split('T')[0] : null,
                accountGroup: accountGroup  // If null, fetch all account groups
            },
            success: function (data) {
                initializePivotGrid(data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching filtered records: ", error);
            }
        });
    }

    function initializePivotGrid(data) {
        $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                store: {
                    type: "array",
                    data: data
                },
                fields: [
                    { dataField: "CostAllocationMasterGroup", area: "row", caption: "CostAllocationMasterGroup" },
                    { dataField: "CostAllocationGroup", area: "row", caption: "CostAllocationGroup" },
                    { dataField: "CostAllocationUnit", area: "row", caption: "CostAllocationUnit" },
                    { dataField: "Income", area: "row", caption: "Income", expanded: true },
                    { dataField: "Expenses", area: "row", caption: "Expenses", expanded: true },
                    { dataField: "VoucherNo", area: "column", caption: "Voucher No", width: 50 },
                    { dataField: "CostAmount", area: "data", caption: "CostAmount", summaryType: "sum", width: 50 },
                    { dataField: "CostAllocationID", area: "column", caption: "Cost Allocation ID" },
                    { dataField: "VoucherEntryID", area: "column", caption: "Voucher Entry ID" },
                    { dataField: "CostAllocationUnitID", area: "column", caption: "Cost Allocation Unit ID" },
                    { dataField: "CostAllocDrCr", area: "column", caption: "Cost Alloc Dr/Cr" },
                    { dataField: "AmountAllocated", area: "column", caption: "Amount Allocated", summaryType: "sum" },
                    { dataField: "EffectiveDate", area: "column", caption: "Effective Date", dataType: "date" },
                    { dataField: "CostAllocRemarks", area: "column", caption: "Cost Alloc Remarks" },
                    { dataField: "AccountHead", area: "column", caption: "Account Head" },
                    { dataField: "AccountGroup", area: "column", caption: "Account Group" },
                    { dataField: "MasterGroup", area: "column", caption: "Master Group" },
                    { dataField: "AccountID", area: "column", caption: "Account ID" },
                    { dataField: "VoucherType", area: "column", caption: "Voucher Type" },
                    { dataField: "VoucherTypeAndNo", area: "column", caption: "Voucher Type & No" },
                    { dataField: "CostCenterIncharge", area: "column", caption: "Cost Center Incharge" },
                    { dataField: "EntryNarration", area: "column", caption: "Entry Narration" },
                    { dataField: "SysRemarks", area: "column", caption: "System Remarks" },
                    { dataField: "VoucherDate", area: "column", caption: "Voucher Date", dataType: "date" },
                    { dataField: "VoucherMonth", area: "column", caption: "Voucher Month" },
                    { dataField: "VoucherYear", area: "column", caption: "Voucher Year" },
                    { dataField: "EffectiveMonth", area: "column", caption: "Effective Month" },
                    { dataField: "EffectiveYear", area: "column", caption: "Effective Year" },
                    { dataField: "AllocationEffectiveDate", area: "column", caption: "Allocation Effective Date", dataType: "date" },
                    { dataField: "AllocationEffectiveMonth", area: "column", caption: "Allocation Effective Month" },
                    { dataField: "AllocationEffectiveYear", area: "column", caption: "Allocation Effective Year" },
                    { dataField: "ProjectMasterCode", area: "column", caption: "Project Master Code" },
                    { dataField: "BranchCode", area: "column", caption: "Branch Code" },
                    { dataField: "BranchName", area: "column", caption: "Branch Name" },
                    { dataField: "VoucherNarration", area: "column", caption: "Voucher Narration" },
                    { dataField: "VoucherRefNo", area: "column", caption: "Voucher Ref No" }
                ]
            },
            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            showBorders: true,
            height: 500,
            allowExpandAll: true,
            showColumnHeaders: true,
            fieldChooser: {
                enabled: true,
                allowSearch: true
            },
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showRowFields: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true
            },
            showColumnTotals: true,
            showColumnGrandTotals: true,
            showDataHeaders: true,
            showRowTotals: true,
            showRowGrandTotals: true
        }).dxPivotGrid('instance');
    }

</script>
