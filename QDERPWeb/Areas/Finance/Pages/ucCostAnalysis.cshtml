<div class="Head">
  
        @await Html.PartialAsync("_GridFooterUCCA")
    
</div>
<div id="loadPanel"></div>
<div class="dx-fieldset horizontal-container">
    <div class="dx-field">
        @(Html.DevExtreme().DropDownBox()
            .ID("requestedBy")
            .DataSource(d => d.Mvc()
            .Controller("UCCostAnalysis")
            .LoadAction("GetUser")
            .LoadMode(DataSourceLoadMode.Raw))
            .Width(500)
            .Label("Select a Cost Center")
            .LabelMode(EditorLabelMode.Outside)
            .ValueExpr("CostAllocationUnit")
            .DisplayExpr("CostAllocationUnit")
            .ShowClearButton(true)
            .ContentTemplate(new TemplateName("CostCenterTemplate"))
            )
    </div>


    <div class="dx-field">
        <!-- Start Date Picker -->
        @(Html.DevExtreme().DateBox()
            .ID("frmdateBox")
            .Label("Start Date")
            .LabelMode(EditorLabelMode.Outside)
            .InputAttr("aria-label", "Date")
            .Type(DateBoxType.Date)
            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
            .DisplayFormat("dd-MMM-yyyy")
            .TabIndex(2)
            )
    </div>

    <div class="dx-field">
        <!-- End Date Picker -->
        @(Html.DevExtreme().DateBox()
            .ID("todateBox")
            .Label("End Date")
            .LabelMode(EditorLabelMode.Outside)
            .InputAttr("aria-label", "Date")
            .Type(DateBoxType.Date)
            .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)))
            .DisplayFormat("dd-MMM-yyyy")
            .TabIndex(3)
            )
    </div>

    <div class="dx-field dx-field-4" id="check">
        <!-- Use Effective Date Checkbox -->
        @(Html.DevExtreme().CheckBox()
            .ID("useEffectiveDate")
            .Text("Use Effective Date")
            .Value(true)
            )

        <!-- Dropdown Button to Show Records -->
        @(Html.DevExtreme().DropDownButton()
            .ID("ddBtnShowRecords")
            .Text("Show Records")
            .Icon("smalliconslayout")
            .Width(180)
            .ElementAttr("class", "button-alignment-down")
            .TabIndex(4)
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text("Show Records").Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                items.Add().Text("Today").Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                items.Add().Text("Yesterday").Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                items.Add().Text("This Week").Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                items.Add().Text("This Month Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                items.Add().Text("This Month (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                items.Add().Text("This Year Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                items.Add().Text("This Year (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                items.Add().Text("Last Month").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                items.Add().Text("Last Year").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
            })
            )
    </div>
</div>

@using (Html.DevExtreme().NamedTemplate("CostCenterTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                .ID("costcenter-datagrid")
                .DataSource(d => d.Mvc()
                    .Controller("UCCostAnalysis")
                    .LoadAction("GetUser")
                    .LoadMode(DataSourceLoadMode.Raw))
                .ShowBorders(true)
                .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
                .FilterRow(f => f.Visible(true))
                .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                .Selection(s => s.Mode(SelectionMode.Single))
                .HoverStateEnabled(true)
                .Height(300)
                .SelectedRowKeys(new JS(@"component.option('value') ? [component.option('value')] : []"))
                .OnSelectionChanged("onCostCenterSelected")
                .Columns(columns =>
                {
                    columns.Add().DataField("CostAllocationUnit").Caption("Cost Center").Width(250);
                    columns.Add().DataField("CostAllocationGroup").Caption("Group").Width(250);
                })
            )
}

<!-- Pivot Grid Container --><script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>



<div class="ledgerResult" id="pivotGridContainer"></div>

<script type="text/javascript">
    let pivotData = [];
    let slectedaccount;

    function onCostCenterSelected(e) {
        const selectedData = e.selectedRowsData[0];
        const dropDownBox = $("#requestedBy").dxDropDownBox("instance");

        if (selectedData) {
            slectedaccount = selectedData.CostAllocationUnit;
            dropDownBox.option("value", selectedData.CostAllocationUnit);
            dropDownBox.close();
        }
    }
    $(function () {
        $("#loadPanel").dxLoadPanel({
            shadingColor: "rgba(0,0,0,0.4)",
            position: { of: "body" }, // or change to "#mainContent" if you want to limit area
            visible: false,
            showIndicator: true,
            showPane: true,
            message: "Loading..."
        });
    });
    $(function () {
        $("#costAnalysis").dxTextBox({
            text: formatMessage("Cost Analysis"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });

    // Function to handle changes in the Cost Center DropDownBox selection
    function onRequestedByChanged(e) {
        var selectedValue = e.value;

        // ✅ Updated: Use DropDownBox instead of SelectBox
        var dropDownBox = $("#requestedBy").dxDropDownBox("instance");
        var requestedBy = dropDownBox.option("value");

        var dataSource = dropDownBox.option("dataSource");

        if (dataSource && dataSource.store) {
            var store = dataSource.store;

            if (store instanceof DevExpress.data.DataSource) {
                if (selectedValue) {
                    store.filter(["CostAllocationUnit", "=", selectedValue]);
                } else {
                    store.filter(null);
                }
                store.load();
            } else if (Array.isArray(store)) {
                var filteredData = store.filter(item => item.CostAllocationUnit === selectedValue);
                dropDownBox.option("dataSource", filteredData);
            } else {
                console.error("The store is neither a DevExpress.data.DataSource nor an array:", store);
            }
        } else {
            console.error("The dataSource does not have a store or is not structured as expected:", dataSource);
        }
    }

    $(document).ready(function () {
        // Load all records on page load (ignore default date values)
        // initializePivotGrid([]);
        loadAllRecords();
    });

    function loadAllRecords() {
        console.log("Loading trial balance records...");

        const today = new Date();

        // Define date range: Jan 1st of last year to end of current month
        const firstDay = new Date(today.getFullYear() - 1, 0, 1); // Jan 1 last year
        const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0); // End of current month
        var loadPanel = $("#loadPanel").dxLoadPanel("instance");
        loadPanel.show();
        $.ajax({
            url: '/api/TransactionDetails/GetTrialBalance',
            type: 'GET',
            data: {
                startDate: firstDay.toISOString().split('T')[0],
                endDate: lastDay.toISOString().split('T')[0],
                accountGroup: "" // include this if your API expects it
            },
            success: function (data) {
                if (Array.isArray(data)) {
                    pivotData = data; // Set global
                    initializePivotGrid(data);
                } else {
                    console.error("Unexpected response format", data);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching trial balance records:", xhr.responseText || error);
            },
            complete: function () {
                $("#loadPanel").dxLoadPanel("instance").hide(); // ✅ Always hide the loader
            }
        });
    }


    function ddBtnShowRecords_click(option) {
        var startDate, endDate;

        let today = new Date();
        let firstDay, lastDay;

        switch (option) {
            case 'today':
                startDate = today;
                endDate = today;
                break;
            case 'yesterday':
                startDate = new Date();
                startDate.setDate(today.getDate() - 1);
                endDate = startDate;
                break;
            case 'week':
                startDate = new Date();
                startDate.setDate(today.getDate() - today.getDay());
                endDate = today;
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = today;
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = today;
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                break;
            case 'lastmonth':
                firstDay = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                lastDay = new Date(today.getFullYear(), today.getMonth(), 0);
                startDate = firstDay;
                endDate = lastDay;
                break;
            case 'lastyear':
                firstDay = new Date(today.getFullYear() - 1, 0, 1);
                lastDay = new Date(today.getFullYear() - 1, 11, 31);
                startDate = firstDay;
                endDate = lastDay;
                break;
            default:
                startDate = $("#frmdateBox").dxDateBox("instance").option("value");
                endDate = $("#todateBox").dxDateBox("instance").option("value");
                break;
        }

        $("#frmdateBox").dxDateBox("instance").option("value", startDate);
        $("#todateBox").dxDateBox("instance").option("value", endDate);



        console.log("Fetching records with:", {
            startDate: startDate ? startDate.toISOString().split('T')[0] : "All Dates",
            endDate: endDate ? endDate.toISOString().split('T')[0] : "All Dates",
            accountGroup: slectedaccount
        });

        $.ajax({
            url: '/api/TransactionDetails/GetTrialBalance',
            type: 'GET',
            data: {
                startDate: startDate ? startDate.toISOString().split('T')[0] : null,
                endDate: endDate ? endDate.toISOString().split('T')[0] : null,
                accountGroup: slectedaccount
            },
            success: function (data) {
                initializePivotGrid(data);
                console.log("response", data)
            },
            error: function (xhr, status, error) {
                console.error("Error fetching filtered records: ", error);
            }
        });
    }

    function initializePivotGrid(data) {
        $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                fields: [
                    { dataField: "CostAllocationMasterGroup", area: "row", caption: "Cost Master", expanded: true },
                    { dataField: "CostAllocationGroup", area: "row", caption: "Cost Center Group", expanded: true },
                    { dataField: "CostAllocationUnit", area: "row", caption: "Cost Unit", expanded: true },
                    { dataField: "PL", area: "column", caption: "Income / Expense" },
                    { dataField: "VoucherTypeAndNo", area: "filter", caption: "Voucher No", visible: true },
                    { dataField: "Income", area: "data", summaryType: "sum", caption: "Income", format: { type: "fixedPoint", precision: 3 }, customizeText: customFormatter },
                    // Expenses
                    { dataField: "Expenses", area: "data", summaryType: "sum", caption: "Expenses", format: { type: "fixedPoint", precision: 3 }, customizeText: customFormatter },
                    // Grand Total
                    { dataField: "CostAmount", area: "data", summaryType: "sum", caption: "Grand Total", format: { type: "fixedPoint", precision: 3 }, customizeText: customFormatter }

                ],
                store: data
            },

            width: "98%",
            height: $(window).height() - 50,
            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            rowHeaderLayout: "tree",
            wordWrapEnabled: true,

            fieldChooser: {
                enabled: true,
                allowSearch: true
            },
            scrolling: {
                mode: "virtual"
            },
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showRowFields: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true
            },
            showColumnTotals: false,
            showColumnGrandTotals: false,
            showDataHeaders: true,
            showRowTotals: false,
            showRowGrandTotals: false
        });


        $(window).resize(function () {
            $("#pivotGridContainer").dxPivotGrid("instance").option("height", $(window).height() - 50);
        });

        $(".dx-pivotgrid-container").css({
            "font-size": "14px",
            "border-radius": "8px"
        });

        $(".dx-pivotgrid-row, .dx-pivotgrid-column").css({
            "padding": "10px",
            "border-bottom": "1px solid #ddd"
        });

        $(".dx-pivotgrid-cell").hover(function () {
            $(this).css("background-color", "#f5f5f5");
        }, function () {
            $(this).css("background-color", "");
        });


    }

    function onDifferencesItemClick(e) {
        const selectedText = e.itemData.text;

        if (selectedText === "Clear All wrong Allocation of Cost") {
            DevExpress.ui.dialog.custom({
                title: "Confirm Action",
                message: "You are about to clear all wrong cost posting in the system. Click yes if you would like to continue.",
                buttons: [
                    { text: "Yes", onClick: () => true },
                    { text: "No", onClick: () => false }
                ],
                showTitle: true
            }).show().done(function (dialogResult) {

                if (dialogResult) {
                    // Proceed with AJAX call
                    $.ajax({
                        url: '/api/ucCostAnalysis/DeleteWronglyAllocatedEntries',
                        type: 'POST',
                        success: function (response) {
                            DevExpress.ui.dialog.custom({
                                title: "Deleted Successfully",
                                message: "All cost entries have been successfully cleared from the database.",
                                buttons: [
                                    { text: "Ok", onClick: () => true }
                                ],
                                showTitle: true
                            }).show();

                            // Refresh the pivot grid
                            const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
                            if (pivotGrid) {
                                pivotGrid.refresh();
                                window.location.reload(); // Correct method to reload the page
                            }

                        },
                        error: function (xhr) {
                            const msg = xhr.responseText || "An error occurred";
                            DevExpress.ui.notify(msg, "error", 3000);
                        }
                    });
                }
            });
        }
    }

