        function initializePivotGrid(data) {
        $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                fields: [
                    { dataField: "CostAllocationMasterGroup", area: "row", caption: "Cost Master", expanded: true },
                    { dataField: "CostAllocationGroup", area: "row", caption: "Cost Center Group", expanded: true },
                    { dataField: "CostAllocationUnit", area: "row", caption: "Cost Unit", expanded: true },
                    { dataField: "PL", area: "column", caption: "Income / Expense" },
                    { dataField: "VoucherTypeAndNo", area: "filter", caption: "Voucher No", visible: true },

                    // Hidden fields
                    { dataField: "Income", area: "data", summaryType: "sum", caption: "Test Income", format: { type: "fixedPoint", precision: 2 }, customizeText: customFormatter, visible: false },
                    { dataField: "ConvertedExpenses", area: "data", summaryType: "sum", caption: "Trans Expenses", format: { type: "fixedPoint", precision: 2 }, customizeText: customFormatter, visible: false },
                    { dataField: "CostAmount", area: "data", summaryType: "sum", caption: "Trans Grand Total", format: { type: "fixedPoint", precision: 2 }, customizeText: customFormatter, visible: false },

                    // Main fields to show
                    {
                        dataField: "ConvertdIncome",
                        area: "data",
                        caption: "Income",
                        summaryType: "sum",
                        format: { type: "fixedPoint", precision: 2 }
                    },
                    {
                        dataField: "ConvertedExpenses",
                        area: "data",
                        caption: "Expenses",
                        summaryType: "sum",
                        format: { type: "fixedPoint", precision: 2 }
                    },
                    {
                        dataField: "ConvertedCostAmount",
                        area: "data",
                        caption: "Grand Total",
                        summaryType: "sum",
                        format: { type: "fixedPoint", precision: 2 }
                    }
                ],
                store: data
            },

            width: "98%",
            height: "60vh",
            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            rowHeaderLayout: "tree",
            wordWrapEnabled: true,

            fieldChooser: {
                enabled: true,
                allowSearch: true
            },
            scrolling: {
                mode: "virtual"
            },
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showRowFields: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true
            },
            showColumnTotals: false,
            showColumnGrandTotals: false,
            showDataHeaders: true,
            showRowTotals: false,
            showRowGrandTotals: false,
            onOptionChanged: handleGridOptionChanged,

            // ✅ Cell rendering here
              onCellPrepared: function (e) {
        if (e.area === "data" && typeof e.cell.value === "number") {
            debugger;
            const val = Math.abs(e.cell.value);
            const formatted = val.toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            // fallback if columnPath is undefined
            let columnName = e.cell.columnPath?.[0]?.toLowerCase() || "";

            let cssClass = "";
            if (columnName.includes("Income")) {
                cssClass = "credit-pill";
            } else if (columnName.includes("Expense")) {
                cssClass = "debit-pill";
            } else if (columnName.includes("Grand") || columnName.includes("total") || columnName.includes("cost")) {
                cssClass = "received-pill";
            }

            $(e.cellElement).empty();
            $("<span>")
                .addClass(cssClass)
                .text(formatted)
                .appendTo(e.cellElement);
        }
    }

        });

