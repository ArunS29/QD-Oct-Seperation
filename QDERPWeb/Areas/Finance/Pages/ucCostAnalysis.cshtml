@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;
<style>
    #pivotGridContainer {
        flex-grow: 1; /* Allow the pivot grid to grow and fill available space */
        width: 100%; /* Ensure the grid stretches to full width */
        min-height: 400px; /* Set a minimum height to avoid small grid sizes */
        max-height: 600px; /* Optional, set a max height to control grid overflow */
        overflow: auto; /* Add scrollbars if the content overflows */
    }

    .dx-field {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    #check{
        margin:50px;
    }
    /* Ensure the fourth column contains both "Use Effective Date" & "Show Records" */
    .dx-field-4 {
        display: flex;
        flex-direction: column; /* Stack the checkbox and button */
        gap: 10px; /* Add space between elements */
    }
</style>


<div class="title">
    <div class="header-container">
        <div id="costAnalysis" class="no-border-input"></div>
    </div>
</div>
<div class="Head">
    <div class="header-container">
        <div class="footer">@await Html.PartialAsync("_GridFooterUCCA")</div>
    </div>
</div>
    <div class="dx-fieldset horizontal-container">
        <div class="dx-field">
            <!-- SelectBox for Account Group -->
            @(Html.DevExtreme().SelectBox()
                .ID("requestedBy")
                .DataSource(d => d.Mvc().Controller("UCCostAnalysis").LoadAction("GetUser").LoadMode(DataSourceLoadMode.Raw))
                .Width(300)
                .ElementAttr("class", "button-alignment-down")
                .Label("Select Cost Allocation Group")
                .LabelMode(EditorLabelMode.Outside)
                .SearchEnabled(true)
                .DisplayExpr("CostAllocationUnit")
                .Value(null)
                .ShowClearButton(true)
                .OnValueChanged("onRequestedByChanged")
                )
        </div>

        <div class="dx-field">
            <!-- Start Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("frmdateBox")
                .Label("Start Date")
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(2)
                )
        </div>

        <div class="dx-field">
            <!-- End Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("todateBox")
                .Label("End Date")
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(3)
                )
        </div>

        <div class="dx-field dx-field-4"id="check">
            <!-- Use Effective Date Checkbox -->
            @(Html.DevExtreme().CheckBox()
                .ID("useEffectiveDate")
                .Text("Use Effective Date")
                .Value(true)
                )

            <!-- Dropdown Button to Show Records -->
            @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnShowRecords")
                .Text("Show Records")
                .Icon("smalliconslayout")
                .Width(180)
                .ElementAttr("class", "button-alignment-down")
                .TabIndex(4)
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                    items.Add().Text("Show Records").Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                    items.Add().Text("Today").Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                    items.Add().Text("Yesterday").Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                    items.Add().Text("This Week").Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                    items.Add().Text("This Month Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                    items.Add().Text("This Month (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                    items.Add().Text("This Year Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                    items.Add().Text("This Year (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                    items.Add().Text("Last Month").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                    items.Add().Text("Last Year").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                })
                )
        </div>
    </div>


    <!-- Pivot Grid Container --><script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>



<div class="ledgerResult" id="pivotGridContainer"></div>

<script type="text/javascript">
    $(function () {
        $("#costAnalysis").dxTextBox({
            text: formatMessage("Cost Analysis"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    // Function to handle changes in the Account Group selection
    function onRequestedByChanged(e) {
        var selectedValue = e.value; // Get the selected value from the SelectBox

        var selectBox = $("#requestedBy").dxSelectBox("instance");
        var requestedBy = selectBox.option("value");
        alert(requestedBy)
        //console.log("value", requestedBy);
        var dataSource = selectBox.option("dataSource");

        if (dataSource && dataSource.store) {
            var store = dataSource.store;

            if (store instanceof DevExpress.data.DataSource) {
                // Apply a filter to the DataSource store
                if (selectedValue) {
                    store.filter(["CostAllocationUnit", "=", selectedValue]);
                } else {
                    store.filter(null); // Remove the filter if no value is selected
                }

                // Reload the data to reflect the filter change
                store.load();
            } else if (Array.isArray(store)) {
                // Apply filtering manually for array-based store
                var filteredData = store.filter(item => item.CostAllocationUnit === selectedValue);
                selectBox.option("dataSource", filteredData);
            } else {
                console.error("The store is neither a DevExpress.data.DataSource nor an array:", store);
            }
        } else {
            console.error("The dataSource does not have a store or is not structured as expected:", dataSource);
        }
                }$(document).ready(function () {
        // Load all records on page load (ignore default date values)
        loadAllRecords();
    });

    function loadAllRecords() {
        console.log("Loading records for the current month...");

        // Get the first and last day of the current month
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        let lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        $.ajax({
            url: '/api/UCCostAnalysis/GetTrialBalance',
            type: 'GET',
            data: {
                startDate: firstDay.toISOString().split('T')[0],
                endDate: lastDay.toISOString().split('T')[0]
            },
            success: function (data) {
                initializePivotGrid(data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching records for the current month: ", error);
            }
        });
    }
    function ddBtnShowRecords_click(option) {
        var startDate, endDate;

        // Get today's date
        let today = new Date();
        let firstDay, lastDay;

        switch (option) {
            case 'today':
                startDate = today;
                endDate = today;
                break;
            case 'yesterday':
                startDate = new Date();
                startDate.setDate(today.getDate() - 1);
                endDate = startDate;
                break;
            case 'week':
                startDate = new Date();
                startDate.setDate(today.getDate() - today.getDay()); // Start of the week (Sunday)
                endDate = today;
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1); // Start of the month
                endDate = today;
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1); // Start of the month
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0); // End of the month
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1); // Start of the year
                endDate = today;
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1); // Start of the year
                endDate = new Date(today.getFullYear(), 11, 31); // End of the year
                break;
            case 'lastmonth':
                firstDay = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                lastDay = new Date(today.getFullYear(), today.getMonth(), 0);
                startDate = firstDay;
                endDate = lastDay;
                break;
            case 'lastyear':
                firstDay = new Date(today.getFullYear() - 1, 0, 1);
                lastDay = new Date(today.getFullYear() - 1, 11, 31);
                startDate = firstDay;
                endDate = lastDay;
                break;
            default:
                // Use date from DateBoxes for 'range' option
                startDate = $("#frmdateBox").dxDateBox("instance").option("value");
                endDate = $("#todateBox").dxDateBox("instance").option("value");
                break;
        }

        // Update the DateBox values dynamically
        $("#frmdateBox").dxDateBox("instance").option("value", startDate);
        $("#todateBox").dxDateBox("instance").option("value", endDate);

        // Get the selected AccountGroup
        var getaccountGroup = $("#requestedBy").dxSelectBox("instance").option("value");
        var accountGroup = getaccountGroup ? getaccountGroup.CostAllocationUnit : null;
     
        console.log("Fetching records with:", {
            startDate: startDate ? startDate.toISOString().split('T')[0] : "All Dates",
            endDate: endDate ? endDate.toISOString().split('T')[0] : "All Dates",
            accountGroup: accountGroup || "All Account Groups"
        });

        $.ajax({
            url: '/api/UCCostAnalysis/GetTrialBalance',
            type: 'GET',
            data: {
                startDate: startDate ? startDate.toISOString().split('T')[0] : null,
                endDate: endDate ? endDate.toISOString().split('T')[0] : null,
                accountGroup: accountGroup  // If null, fetch all account groups
            },
            success: function (data) {
                initializePivotGrid(data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching filtered records: ", error);
            }
        });
    }

    function initializePivotGrid(data) {
        $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                fields: [
                    // Row Fields (Hierarchy: Cost Group → Cost Center)
                    { dataField: "CostGroup", area: "row", caption: "Cost Group" },
                    { dataField: "CostCenter", area: "row", caption: "Cost Center" },

                    // Column Fields (Display Income, Expenses, Grand Total)
                    { dataField: "IncomeExpense", area: "column", caption: "Income / Expense" },

                    // Data Fields
                    { dataField: "Income", area: "data", summaryType: "sum", caption: "Income" },
                    { dataField: "Expenses", area: "data", summaryType: "sum", caption: "Expenses" },
                    { dataField: "GrandTotal", area: "data", summaryType: "sum", caption: "Grand Total" }
                ],
                store: data
            },

            width: "100%",
            height: $(window).height() - 50, // Adjust height dynamically
            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            columnAutoWidth: true, // Dynamically adjust column width
            allowColumnResizing: true, // Allow user to resize columns
            rowHeaderLayout: "tree", // Show hierarchy in tree structure
            wordWrapEnabled: true, // Wrap text to avoid scrolling

            fieldChooser: {
                enabled: true,
                allowSearch: true
            },
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showRowFields: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true
            },
            showColumnTotals: false, // Hide column totals to match the layout
            showColumnGrandTotals: false,
            showDataHeaders: true,
            showRowTotals: false, // Hide row totals to match the layout
            showRowGrandTotals: false
        });

        // Adjust grid height on window resize
        $(window).resize(function () {
            $("#pivotGridContainer").dxPivotGrid("instance").option("height", $(window).height() - 50);
        });

        // Custom styles
        $(".dx-pivotgrid-container").css({
            "font-size": "14px",
            "border-radius": "8px"
        });

        $(".dx-pivotgrid-row, .dx-pivotgrid-column").css({
            "padding": "10px",
            "border-bottom": "1px solid #ddd"
        });

        $(".dx-pivotgrid-cell").hover(function () {
            $(this).css("background-color", "#f5f5f5");
        }, function () {
            $(this).css("background-color", "");
        });
    }


</script>
