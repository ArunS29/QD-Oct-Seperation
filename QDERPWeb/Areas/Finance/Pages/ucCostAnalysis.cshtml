<script type="text/javascript">
    let pivotData = [];
    let slectedaccount;

    function onCostCenterSelected(e) {
        const selectedData = e.selectedRowsData[0];
        const dropDownBox = $("#requestedBy").dxDropDownBox("instance");

        if (selectedData) {
            slectedaccount = selectedData.CostAllocationUnit;
            dropDownBox.option("value", selectedData.CostAllocationUnit);
            dropDownBox.close();
        }
    }
    $(function () {
        $("#loadPanel").dxLoadPanel({
            shadingColor: "rgba(0,0,0,0.4)",
            position: { of: "body" }, // or change to "#mainContent" if you want to limit area
            visible: false,
            showIndicator: true,
            showPane: true,
            message: "Loading..."
        });
    });
    $(function () {
        $("#costAnalysis").dxTextBox({
            text: formatMessage("Cost Analysis"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });

    // Function to handle changes in the Cost Center DropDownBox selection
    function onRequestedByChanged(e) {
        var selectedValue = e.value;

        // ✅ Updated: Use DropDownBox instead of SelectBox
        var dropDownBox = $("#requestedBy").dxDropDownBox("instance");
        var requestedBy = dropDownBox.option("value");

        var dataSource = dropDownBox.option("dataSource");

        if (dataSource && dataSource.store) {
            var store = dataSource.store;

            if (store instanceof DevExpress.data.DataSource) {
                if (selectedValue) {
                    store.filter(["CostAllocationUnit", "=", selectedValue]);
                } else {
                    store.filter(null);
                }
                store.load();
            } else if (Array.isArray(store)) {
                var filteredData = store.filter(item => item.CostAllocationUnit === selectedValue);
                dropDownBox.option("dataSource", filteredData);
            } else {
                console.error("The store is neither a DevExpress.data.DataSource nor an array:", store);
            }
        } else {
            console.error("The dataSource does not have a store or is not structured as expected:", dataSource);
        }
    }

    $(document).ready(function () {
        // Load all records on page load (ignore default date values)
        // initializePivotGrid([]);
        loadAllRecords();
    });

    function loadAllRecords() {
        console.log("Loading trial balance records...");

        const today = new Date();

        // Define date range: Jan 1st of last year to end of current month
        const firstDay = new Date(today.getFullYear() - 1, 0, 1); // Jan 1 last year
        const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0); // End of current month
        var loadPanel = $("#loadPanel").dxLoadPanel("instance");
        loadPanel.show();
        $.ajax({
            url: '/api/TransactionDetails/GetTrialBalance',
            type: 'GET',
            data: {
                startDate: firstDay.toISOString().split('T')[0],
                endDate: lastDay.toISOString().split('T')[0],
                accountGroup: "" // include this if your API expects it
            },
            success: function (data) {
                debugger;
                if (Array.isArray(data)) {
                    pivotData = data; // Set global
                    initializePivotGrid(data);
                   console.log("pivotdata",data)
                } else {
                    console.error("Unexpected response format", data);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching trial balance records:", xhr.responseText || error);
            },
            complete: function () {
                $("#loadPanel").dxLoadPanel("instance").hide(); // ✅ Always hide the loader
            }
        });
    }


    function ddBtnShowRecords_click(option) {
        var startDate, endDate;

        let today = new Date();
        let firstDay, lastDay;

        switch (option) {
            case 'today':
                startDate = today;
                endDate = today;
                break;
            case 'yesterday':
                startDate = new Date();
                startDate.setDate(today.getDate() - 1);
                endDate = startDate;
                break;
            case 'week':
                startDate = new Date();
                startDate.setDate(today.getDate() - today.getDay());
                endDate = today;
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = today;
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = today;
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                break;
            case 'lastmonth':
                firstDay = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                lastDay = new Date(today.getFullYear(), today.getMonth(), 0);
                startDate = firstDay;
                endDate = lastDay;
                break;
            case 'lastyear':
                firstDay = new Date(today.getFullYear() - 1, 0, 1);
                lastDay = new Date(today.getFullYear() - 1, 11, 31);
                startDate = firstDay;
                endDate = lastDay;
                break;
            default:
                startDate = $("#frmdateBox").dxDateBox("instance").option("value");
                endDate = $("#todateBox").dxDateBox("instance").option("value");
                break;
        }

        $("#frmdateBox").dxDateBox("instance").option("value", startDate);
        $("#todateBox").dxDateBox("instance").option("value", endDate);



        console.log("Fetching records with:", {
            startDate: startDate ? startDate.toISOString().split('T')[0] : "All Dates",
            endDate: endDate ? endDate.toISOString().split('T')[0] : "All Dates",
            accountGroup: slectedaccount
        });

        $.ajax({
            url: '/api/TransactionDetails/GetTrialBalance',
            type: 'GET',
            data: {
                startDate: startDate ? startDate.toISOString().split('T')[0] : null,
                endDate: endDate ? endDate.toISOString().split('T')[0] : null,
                accountGroup: slectedaccount
            },
            success: function (data) {
              
                initializePivotGrid(data);
                console.log("response", data)
            },
            error: function (xhr, status, error) {
                console.error("Error fetching filtered records: ", error);
            }
        });
    }

