    }

        function onDifferencesItemClick(e) {
        const selectedText = e.itemData.text;

        if (selectedText === "Clear All wrong Allocation of Cost") {
            DevExpress.ui.dialog.custom({
                title: "Confirm Action",
                message: "You are about to clear all wrong cost posting in the system. Click yes if you would like to continue.",
                buttons: [
                    { text: "Yes", onClick: () => true },
                    { text: "No", onClick: () => false }
                ],
                showTitle: true
            }).show().done(function (dialogResult) {

                if (dialogResult) {
                    // Proceed with AJAX call
                    $.ajax({
                        url: '/api/ucCostAnalysis/DeleteWronglyAllocatedEntries',
                        type: 'POST',
                        success: function (response) {
                            DevExpress.ui.dialog.custom({
                                title: "Deleted Successfully",
                                message: "All cost entries have been successfully cleared from the database.",
                                buttons: [
                                    { text: "Ok", onClick: () => true }
                                ],
                                showTitle: true
                            }).show();

                            // Refresh the pivot grid
                               const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
    if (pivotGrid) {
        pivotGrid.refresh();
        window.location.reload(); // Correct method to reload the page
    }

                        },
                        error: function (xhr) {
                            const msg = xhr.responseText || "An error occurred";
                            DevExpress.ui.notify(msg, "error", 3000);
                        }
                    });
                }
            });
        }
    }

