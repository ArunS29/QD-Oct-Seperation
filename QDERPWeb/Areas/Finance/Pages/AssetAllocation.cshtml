@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities
@{
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    

    .content-container-top, .content-container-Middle, .content-container-bottom {
        padding: 20px;
        margin: 10px; 
    }

    .card-header {
    
        color: black;
        padding: 20px;
        font-weight: bold;
        display: flex;
        align-items: center;
        border-bottom: 2px solid #ccc; 
    }

   
    .header-icon {
        font-size: 40px;
        margin-right: 15px;
        color: goldenrod;
        text-shadow: 2px 2px 4px black;
    }

    .header-text {
        font-size: 25px;
    }

    .header-text, .header-icon {
        font-size: 25px;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="ExpensesReimbursementAllocationforAssets" class="no-border-title"></div>
    </div>
</div>
<div class="content-container-top p-3">
    <div class="row align-items-center">
        <div class="col-md-1">
            @(Html.DevExtreme().SelectBox()
                .Label(new JS("formatMessage('Dr/Cr')"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("DrCr")
                .Width(90)
                .DataSource(new[] { "Dr", "Cr" })  
                )
        </div>
        <div class="col-md-3">
            @(Html.DevExtreme().SelectBox()
                .ID("PropertyExpenses")
                .Label(new JS("formatMessage('Expenses Ledger Account')"))
                .LabelMode(EditorLabelMode.Outside))
        </div>
        <div class="col-md-2">
             @(Html.DevExtreme().NumberBox()
            .ID("propertyAmount")
            .Label(new JS("formatMessage('Amount')"))
            .LabelMode(EditorLabelMode.Outside)
            .ShowSpinButtons(true)
            .Format("#,##0.00")
            .Min(0))
        </div>
        <div class="col-md-2">
            
            @(Html.DevExtreme().CheckBox()
                .Text(new JS("formatMessage('Approved On')"))
            .ID("IsApproved"))
        </div>
        <div class="col-md-3">
            <div class="mb-2">
                @(Html.DevExtreme().TextBox().Label(new JS("formatMessage('Approved On')")).LabelMode(EditorLabelMode.Outside).ID("propertyVoucherNo").Disabled(false))
            </div>
            <div>
                @(Html.DevExtreme().TextBox().Label(new JS("formatMessage('Approved By')")).LabelMode(EditorLabelMode.Outside).ID("propertyId").Disabled(false))
            </div>
        </div>

    </div>
    <br />
    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid<Tbl20117AssetCostAllocationMaster>()
            .ID("propertydataGrid")
            .Height(250)
            .Width("100%")
            .ShowBorders(true)
            .Columns(columns =>
            {
                columns.AddFor(m => m.AssetCostAllocDrCr).Caption(new JS("formatMessage('Dr/Cr')"));
                columns.AddFor(m => m.AssetNo).Caption(new JS("formatMessage('Asset Description')"));
                columns.AddFor(m => m.EffectiveDate).Caption(new JS("formatMessage('Effective Date')")).DataType(GridColumnDataType.Date);
                columns.AddFor(m => m.AmountAllocated).Caption(new JS("formatMessage('Amount')")).Format("#,##0.00");
                columns.AddFor(m => m.AssetCostAllocRemarks).Caption(new JS("formatMessage('Remarks')"));

            })
            )
    </div>
    <br />
    <div class="container">
        <div class="card-footer">
            <div class="d-flex gap-2 mt-2">
                @(Html.DevExtreme().Button().ID("btnpropertySave").Text(new JS("formatMessage('Save & Close')")).Icon("save"))
                @(Html.DevExtreme().Button().ID("btnpropertyDelete").Text(new JS("formatMessage('Delete')")).Icon("close"))
                @(Html.DevExtreme().Button().ID("btnPropertyBack").Text(new JS("formatMessage('Back')")).Icon("arrowleft"))
                @(Html.DevExtreme().Button().ID("btnAddCostCentre").Text(new JS("formatMessage('Add New Cost Centre')")).Icon("plus"))
                @(Html.DevExtreme().Button().ID("btnApproveAdd").Text(new JS("formatMessage('Approve [Add]')")).Icon("check"))
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        $("#ExpensesReimbursementAllocationforAssets").dxTextBox({
            text: formatMessage("Expenses Reimbursement Allocation for Assets"),
            readOnly: true,
            width:"600",
            onContentReady: function(e) {
						$(e.element).addClass("dx-textbox-heading");
				}
        });
        
    });
        $(document).ready(function () {
        console.log("Page loaded. Testing API call...");

        $.ajax({
            url: "/api/AssetAllocation/GetAssetCostAllocations",
            method: "GET",
            success: function (response) {
                console.log("API Response:", response);
            },
            error: function (xhr, status, error) {
                console.error("Error loading data:", xhr.responseText);
            }
        });
    });
</script>