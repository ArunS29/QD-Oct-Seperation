<style type="text/css">

    #dataGrid .dx-datagrid-headers .dx-cell-focus-disabled {
        background-color: var(--header-color);
    }

    #dataGrid .debit-pill, #dataGrid .credit-pill, #dataGrid .received-pill {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    #dataGrid .debit-pill {
        background: rgba(255, 77, 79, .15);
        color: #ff4d4f;
    }

    #dataGrid .credit-pill {
        background: rgba(82, 196, 26, .15);
        color: #52c41a;
    }

    #dataGrid .received-pill {
        background: rgba(255, 193, 7, 0.15); /* Light yellow background */
        color: #ffc107; /* Bootstrap yellow */
    }

</style>
