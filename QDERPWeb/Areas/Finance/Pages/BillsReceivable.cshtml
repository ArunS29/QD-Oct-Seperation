         function injectHeaderSVG() {
               $.ajax({
                   url: '/api/AccountingLedgers/GetCurrencyIcon',
                   type: 'GET',
                   success: function (response) {
                       
                       let svgIcon = response.Icon;
                       if (!svgIcon) return;

                       // Set default width/height for SVG if needed
                       if (svgIcon.startsWith("<svg")) {
                           svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);
                       } else {
                           // If symbol is text (e.g., "$" or "SAR"), wrap in styled span
                           svgIcon = `<span style="font-weight: bold;">${svgIcon}</span>`;
                       }

                       let $grid = $('#dataGrid');
                       let gridInstance = $grid.dxDataGrid("instance");
                       if (!gridInstance) return;

                       $grid.find(".dx-header-row td").each(function () {
                                                       const $cell = $(this);
                            const dataField = $cell.attr("data-field");  // 👈 This is key

                                const $debitHeader = $(".invoice-header");
                                const debitText = $debitHeader.data("original-text") || $debitHeader.text().trim();
                                $debitHeader.data("original-text", debitText); // Save original once

                                $debitHeader.html(`
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                        ${svgIcon}
                                        <span style="font-weight: bold;">${debitText}</span>
                                    </div>
                                `);

                                // 👉 Credit
                                const $creditHeader = $(".received-header");
                                const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                                $creditHeader.data("original-text", creditText);

                                $creditHeader.html(`
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                        ${svgIcon}
                                        <span style="font-weight: bold;">${creditText}</span>
                                    </div>
                                `);


                                const $balanceHeader = $(".balance-header");
                                const balanceText = $balanceHeader.data("original-text") || $balanceHeader.text().trim();
                                $balanceHeader.data("original-text", balanceText);

                                $balanceHeader.html(`
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                        ${svgIcon}
                                        <span style="font-weight: bold;">${balanceText}</span>
                                    </div>
                                `);


                       });
                   },
                   error: function (xhr) {
                       console.error("Failed to load currency icon:", xhr.responseText);
                   }
               });
           }
    function refreshKpiCards() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        if (!grid) return;

        const dataSource = grid.getDataSource();
        const data = dataSource.items();

        // Check if grid data is actually loaded
        if (!data || !Array.isArray(data) || data.length === 0) {
            console.warn("Grid data not ready for KPI calculation.");
            return;
        }

        let totalBalance = 0;
        let totalInvoiced = 0;
        let totalReceived = 0;

        data.forEach(item => {
            totalBalance += item?.ConvertedBalance || 0;
            totalInvoiced += item?.ConvertedReceivableAmount || 0;
            totalReceived += item?.ConvertedReceived || 0;
        });

        const format = (val) => val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        // Balance Card
        const balanceSpans = document.querySelectorAll("#cardBalance .value-slider span");
        if (balanceSpans.length >= 3) {
            balanceSpans[0].innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39"><path d="..."/></svg> ${format(totalBalance)}`;
            balanceSpans[1].textContent = format(totalBalance);
            balanceSpans[2].textContent = format(totalBalance);
        }

        // Debit Card
        const debitSpans = document.querySelectorAll("#cardDebit .value-slider span");
        if (debitSpans.length >= 3) {
            debitSpans[0].innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39"><path d="..."/></svg> ${format(totalInvoiced)}`;
            debitSpans[1].textContent = format(totalInvoiced);
            debitSpans[2].textContent = format(totalInvoiced);
        }

        // Credit Card
        const creditSpans = document.querySelectorAll("#cardCredit .value-slider span");
        if (creditSpans.length >= 3) {
            creditSpans[0].innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39"><path d="..."/></svg> ${format(totalReceived)}`;
            creditSpans[1].textContent = format(totalReceived);
            creditSpans[2].textContent = format(totalReceived);
        }
    }

        function handleGridContentReady(e){

          injectHeaderSVG();
           injectCurrencyToCards();
           const grid = e.component;

        // Get all summary values
        let summaryItems = grid.getTotalSummaryValue();

        // If using named columns, fetch like this:
        let totalReceivable = grid.getTotalSummaryValue("ReceivableAmount");
        let totalReceived   = grid.getTotalSummaryValue("Received");
        let totalBalance    = grid.getTotalSummaryValue("Balance");

        // Format numbers
        function format(val) {
            if (val === null || val === undefined) return "0.00";
            return Math.abs(val).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        // Update Balance Card
        $("#cardBalance .value-slider span").each(function(i) {
            $(this).text(format(totalBalance));
        });
        
        $("#cardBalance .overlay .detail").eq(0).text(" ");
        $("#cardBalance .overlay .detail").eq(1).text(`${formatMessage("Total Balance")}: ${format(totalBalance)}`);
        $("#cardBalance .overlay .detail").eq(2).text(" ");

        // Update Debit Card (Total Invoiced)
        $("#cardDebit .value-slider span").each(function(i) {
            $(this).text(format(totalReceivable));
        });
        $("#cardDebit .overlay .detail").eq(0).text(" ");
       $("#cardDebit .overlay .detail").eq(1).text(`${formatMessage("Total Invoiced")}: ${format(totalReceivable)}`);
        $("#cardDebit .overlay .detail").eq(2).text(" ");

        // Update Credit Card (Total Received)
        $("#cardCredit .value-slider span").each(function(i) {
            $(this).text(format(totalReceived));
        });
        $("#cardCredit .overlay .detail").eq(0).text(" ");
       $("#cardCredit .overlay .detail").eq(1).text(`${formatMessage("Total Received")}: ${format(totalReceived)}`);
        $("#cardCredit .overlay .detail").eq(2).text(" ");

    }

    function injectCurrencyToCards() {
        $.ajax({
            url: "/api/AccountingLedgers/GetCurrencyIcon",
            method: "GET",
            success: function (response) {
                
                if (!response || !response.Icon) return;

                const icon = response.Icon.trim();

                // Inject into Balance
                $('#cardBalance .value-slider span').each(function () {
                    $(this).html(icon + $(this).text().trim().replace(icon, ''));
                });

                // Inject into Debit
                $('#cardDebit .value-slider span').each(function () {
                    $(this).html(icon + $(this).text().trim().replace(icon, ''));
                });

                // Inject into Credit
                $('#cardCredit .value-slider span').each(function () {
                    $(this).html(icon + $(this).text().trim().replace(icon, ''));
                });
            },
            error: function (err) {
                console.error("Failed to load currency icon:", err);
            }
        });
    }
