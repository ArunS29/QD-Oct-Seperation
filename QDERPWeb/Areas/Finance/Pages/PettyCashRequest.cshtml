            var dataSource = dataGrid.option("dataSource") || [];

            if (!Array.isArray(dataSource)) {
                dataSource = [];
            }

            // Add an empty row with default values if the last row is not empty
            if (dataSource.length === 0 || Object.keys(dataSource[dataSource.length - 1]).length !== 0) {
                dataSource.push({
                    ClaimedAmount: 0.00,   // Default to 0.00
                    ApprovedAmount: 0.00   // Default to 0.00
                });
                dataGrid.option("dataSource", dataSource);
