@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    S

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .card {
        background-color: white;
    }

    .dx-datagrid-pager .dx-page.dx-selection,
    .pagination .active a {
        color: black !important; /* Set the active page number to yellow */
      
    }

    .button-alignment-down {
        margin-bottom: 10px
    }

    .dx-field {
        background-color: whitesmoke;
    }



    .card-header {
        color: black; /* Changes the text color to white for contrast */
        text-align: right; /* Aligns the text to the right */
        padding: 20px; /* Adds some padding around the text */
        font-weight: bold;
        padding-right: 20px;
    }


    .col-md-6 {
        margin-top: 20px; 
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
       
        color: black;
        font-family: "Inter", Helvetica, Arial, sans-serif;
    }
</style>


    <div class="content-container-top">
        <div class="container-fluid"></div>


        <div id="FinanceManagementDashboard" class="card-header no-border-input"></div>
    
    </div>
<div class="card-footer background" style="display: flex;justify-content: space-between;">
    @await Html.PartialAsync("_GridFooter2")
    <div class="form-group col-md-6" id="Btnchange" style=" padding-bottom: 10px;  text-align: right;padding-right: 30px;">
        <div>
            @(Html.DevExtreme().Button()
                .ID("btnBillsWithBalance")
                .Text(new JS("formatMessage('Show All Bills(Only with Balance)')"))
                .Height(30)
                .Width(400)
                .Icon("checklist")
                .OnClick("function() { switchButtons('btnBillsWithBalance'); }")
                )
        </div>
        <div>
            @(Html.DevExtreme().Button()
                .ID("btnBillsFullyPaid")
                .Text(new JS("formatMessage('Show Bills Receivable(Including fully Paid)')"))
                .Height(30)
                .Width(400)
                .Icon("checklist")
                .Visible(false)//Initially hidden
                .OnClick("function() { switchButtons('btnBillsFullyPaid'); }")
                )
        </div>
    </div>

    <div id="reportsByClientPopup">
        <div id="popupContent"></div>
    </div>
</div>
    <div class="dx-field ledgerResult" style="overflow: hidden; font-family: Inter, Helvetica, Arial, sans-serif">
    @(
            Html.DevExtreme().DataGrid<Qry201SubLedgerPayablesMaster>()
            .ID("dataGrid")
            .DataSource(ds => ds.Mvc()
            .Controller("BillsPayable")
            .LoadAction("Get"))
            .RemoteOperations(false)
            .Columns(columns =>
            {
                // Grid Band: Bills Payable
                columns.Add().Caption(new JS("formatMessage('Bills Payable')")).Columns(band =>
            {
                band.AddFor(m => m.AccountHeadNo).Caption(new JS("formatMessage('Account No')")).Alignment(HorizontalAlignment.Center).Width(150);
                band.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('Ledger Name')")).Alignment(HorizontalAlignment.Left).Width(250);
                band.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('Ledger Name')")).Alignment(HorizontalAlignment.Left).Width(250).GroupIndex(0); // Group by this column

                band.AddFor(m => m.ReferenceNo).Caption(new JS("formatMessage('Voucher No')")).Alignment(HorizontalAlignment.Center)
            .CellTemplate(@<text>
        <a href="/<%= tenantName %>/Finance/PurchaseVoucher?argsledno=<%= data.ReferenceNo %>" target="_blank" style="color: #0398fc; text-decoration: underline;">
            <%= data.ReferenceNo %>
        </a>
    </text>);
                 band.AddFor(m => m.InvoiceAmountBeforeRetention).Caption(new JS("formatMessage('Voucher Amount')"))
    .Alignment(HorizontalAlignment.Right)
    .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let positiveValue = Math.abs(e.value);
    let formattedValue = positiveValue.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ')';
    }
    ");



                // Adjusted/Mapped (Paid)
                band.AddFor(m => m.Paid).Caption(new JS("formatMessage('Adjusted/Mapped')")).Alignment(HorizontalAlignment.Right)
    .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let formattedValue = e.value.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ' Dr)';
    }
    ");

               band.AddFor(m => m.Balance).Caption(new JS("formatMessage('Balance Amount')")).Alignment(HorizontalAlignment.Right)
    .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let positiveValue = Math.abs(e.value);
    let formattedValue = positiveValue.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ')';
    }
    ");


       band.Add().Caption(new JS("formatMessage('Mapping Status')"))
.CustomizeText(@"
function(e) {
    if (!e || !e.data) {
        return '';
    }

    let paid = parseFloat(e.data.Paid) || 0;
    return (paid === 0) ? 'Not Mapped' : 'Bills Payable';
}
");






            });
            })
        .Paging(p => p.PageSize(10))
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnChooser(c => c.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))

        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(true))
        .Height(660)
        .ColumnAutoWidth(true)
        .WordWrapEnabled(true)
        .FilterRow(filterRow => filterRow.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .Width("100%")
        .Summary(summary =>
        {
            summary.GroupItems(items =>
            {
                items.Add().Column("VoucherRefNo")
            .SummaryType(SummaryType.Count)
            .ShowInGroupFooter(true)
            .DisplayFormat(new JS("formatMessage('No of Invoices: {0}')"));
                items.Add().Column("InvoiceAmountBeforeRetention")
            .SummaryType(SummaryType.Sum)
            .ShowInGroupFooter(true)
            .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let positiveValue = Math.abs(e.value);
    let formattedValue = positiveValue.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ')';
    }
    ");
                items.Add().Column("Paid")
            .SummaryType(SummaryType.Sum)
            .ShowInGroupFooter(true)
            .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    return e.value.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    }
    ");
                items.Add().Column("Balance")
            .SummaryType(SummaryType.Sum)
            .ShowInGroupFooter(true)
            .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let positiveValue = Math.abs(e.value);
    let formattedValue = positiveValue.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ')';
    }
    ");
            });
            summary.TotalItems(items =>
            {
                items.Add().Column("VoucherRefNo")
            .SummaryType(SummaryType.Count)
            .DisplayFormat("No of Invoices: {0}");
                items.Add().Column("InvoiceAmountBeforeRetention")
            .SummaryType(SummaryType.Sum)
            .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let positiveValue = Math.abs(e.value);
    let formattedValue = positiveValue.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ')';
    }
    ");
                items.Add().Column("Paid")
            .SummaryType(SummaryType.Sum)
            .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    return e.value.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    }
    ");
                items.Add().Column("Balance")
            .SummaryType(SummaryType.Sum)
            .CustomizeText(@"
    function(e) {
    if (e.value === null || e.value === undefined) {
    return '';
    }
    let positiveValue = Math.abs(e.value);
    let formattedValue = positiveValue.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
    });
    return '(' + formattedValue + ')';
    }
    ");
            });
        })
        .OnInitialized("dataGridInitialized")
        .OnContextMenuPreparing("onContextMenuPreparing")
        )

    </div>


    


<script>
    $(function () {

										$("#FinanceManagementDashboard").dxTextBox({
													text:formatMessage("Finance Management : Dashboard"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
    $(function () {

										$("#BillsPayable").dxTextBox({
													text:formatMessage("Bills Payable"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
    let dataGrid; // Global reference to the DataGrid instance

    // Initialize the DataGrid and store its instance
    function dataGridInitialized(e) {
        dataGrid = e.component;
    }

    function switchButtons(buttonId) {
        let hideBtn, showBtn, filterType;

        // Determine which buttons to toggle and set the filter type
        if (buttonId === "btnBillsWithBalance") {
            showBtn = "btnBillsFullyPaid";
            hideBtn = "btnBillsWithBalance";
            filterType = "WithBalance"; // Filter: Balance > 0
        } else if (buttonId === "btnBillsFullyPaid") {
            showBtn = "btnBillsWithBalance";
            hideBtn = "btnBillsFullyPaid";
            filterType = "FullyPaid"; // Filter: Balance = 0
        }

        // Use DevExtreme APIs to toggle button visibility
        const hideButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(hideBtn));
        const showButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(showBtn));

        hideButtonInstance.option("visible", false);
        showButtonInstance.option("visible", true);

        // Reload the DataGrid with the appropriate filter based on the button clicked
        if (dataGrid) {
            dataGrid.option("dataSource", {
                load: function () {
                    return $.getJSON(`/${tenantName}/Finance/api/BillsPayable/Get`, { filterType: filterType });
                }
            });
            dataGrid.refresh();
        }
    }


    function onContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") { // Only for data rows
            e.items = [
                {
                    text: "View Ledger Transactions",
                    onItemClick: function () {
                        // Navigate to frm201LedgerView with the selected client details
                        const AccountHeadNo = e.row.data.AccountHeadNo; // Example: Assuming AccountHeadNo is the client identifier
                        const url = `/${tenantName}/Finance/AccountingLedgers?AccountId=${AccountHeadNo}`;
                        window.open(url, '_blank'); // Opens in a new tab
                    }
                }
            ];
        }
    }
</script>
