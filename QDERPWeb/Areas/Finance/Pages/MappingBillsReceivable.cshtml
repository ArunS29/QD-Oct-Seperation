@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="~/js/global/print.js"></script>

<style type="text/css">

    #dataGrid .dx-datagrid-headers .dx-cell-focus-disabled {
        background-color: var(--header-color);
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }
</style>

<div class="container-fluid"></div>


    
<div class="card-footer" style="display: flex;justify-content: space-between;">
    @await Html.PartialAsync("_GridFooter3")
    <div class="row">
        <div class="form-group col-md-6" id="Btnchange" style=" padding-bottom: 10px;  text-align: right;">
            <div>
                @(Html.DevExtreme().Button()
                    .ID("btnBillsWithBalance")
                    .Text(new JS("formatMessage('Show All Bills(Only with Balance)')"))
                    .Height(30)
                    .Width(650)
                    .Icon("checklist")
                    .OnClick("function() { switchButtons('btnBillsWithBalance'); }")
                    )
            </div>

            <div>
                @(Html.DevExtreme().Button()
                    .ID("btnBillsFullyReceived")
                    .Text(new JS("formatMessage('Show Bills Receivable(Including fully Received)')"))
                    .Height(30)
                    .Width(750)
                    .Icon("checklist")
                    .Visible(false)//Initially hidden
                    .OnClick("function() { switchButtons('btnBillsFullyReceived'); }")
                    )
            </div>
           
        </div>
    </div>
</div>
<div id="reportsByClientPopup">
    <div id="popupContent"></div>
</div>
<div id="printSection" style="width:1550px">
    <div class="dx-field ledgerResult" style="width: 108%; overflow: hidden;">

        @(Html.DevExtreme().DataGrid<Qry20105BillsReceivableAgeingView>()
                .ID("dataGrid")
                .DataSource(ds => ds.Mvc()
                .Controller("BillsReceivable")
                .LoadAction("Get"))
                .RemoteOperations(false)
                .Columns(columns =>
                {
                    // Grid Band: Bills Receivable
                    columns.Add().Caption(new JS("formatMessage('')")).Columns(band =>
                {
                    band.AddFor(m => m.AccountHead)
                .Caption(new JS("formatMessage('Ledger Name')"))
                .Alignment(HorizontalAlignment.Left)
                .Width(200)
                .GroupIndex(0);
                    band.AddFor(m => m.AccountHeadNo)
                .Caption(new JS("formatMessage('Account No')"))
                .Alignment(HorizontalAlignment.Center)
                .Width(150);

                    band.AddFor(m => m.AccountHead)
                .Caption(new JS("formatMessage('Ledger Name')"))
                .Alignment(HorizontalAlignment.Center)
                .Width(150);

                    band.AddFor(m => m.ReferenceNo)
                .Caption(new JS("formatMessage('Voucher No')"))
                .CellTemplate(@<text>
            <a href="/<%- tenantName %>/Finance/SalesVoucher?argsledno=<%- data.ReferenceNo %>"
               target="_blank" style="color: #0398fc; text-decoration: underline;">
                <%- data.ReferenceNo %>
            </a>
        </text>)
            .Width(150);




                    band.AddFor(m => m.ReceivableAmount)
            .Caption(new JS("formatMessage('Voucher Amount')"))
            .Alignment(HorizontalAlignment.Right)
            .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return '';
        }
        return Math.abs(e.value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }")
            .Width(140);

                    band.AddFor(m => m.Received)
            .Caption(new JS("formatMessage('Adjusted/Mapped')"))
            .Alignment(HorizontalAlignment.Right)
            .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return '';
        }
        return '(' + Math.abs(e.value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        }) + ')';
        }")
            .Width(140);

                    band.AddFor(m => m.Balance)
            .Caption(new JS("formatMessage('Balance Amount')"))
            .Alignment(HorizontalAlignment.Right)
            .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return '';
        }
        return Math.abs(e.value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }")
            .Width(140);

                });
                })
            .Paging(p => p.PageSize(10))
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnFixing(fixing => fixing.Enabled(true))
            .HeaderFilter(filter => filter.Visible(true))
            .Height(660)
            .ColumnAutoWidth(true)
            .WordWrapEnabled(false)
            .FilterRow(filterRow => filterRow.Visible(false))
            .Grouping(grouping => grouping.AutoExpandAll(true))
            .GroupPanel(groupPanel => groupPanel.Visible(false))
            .ShowBorders(true)
            .Width("100%")
            .Summary(summary =>
            {
                summary.TotalItems(items =>
                {
                    items.Add().Column("VoucherRefNo")
                .SummaryType(SummaryType.Count)
                .DisplayFormat("No of Invoices: {0}");

                    items.Add().Column("ReceivableAmount")
                .SummaryType(SummaryType.Sum)
                .CustomizeText(@"
        function(e) {
        if(e.value === null || e.value === undefined) {
        return '';
        }
        return e.value.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }");

                    items.Add().Column("Adjusted/Mapped")
                .SummaryType(SummaryType.Sum)
                .CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return '';
        }
        return '(' + Math.abs(e.value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        }) + ')';
        }");

                    items.Add().Column("Balance Amount")
                .SummaryType(SummaryType.Sum)
                .CustomizeText(@"
        function(e) {
        if(e.value === null || e.value === undefined) {
        return '';
        }
        return e.value.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }");
                });
            })
            .OnInitialized("dataGridInitialized")
            .OnContextMenuPreparing("onContextMenuPreparing")
            )
    </div>
</div>


<script>
    $(function () {

                                        $("#BillsReceivable").dxTextBox({
                                                    text:formatMessage("Bills Receivable"),
                                                        readOnly: true,
                                                    onContentReady: function(e) {
                $(e.element).addClass("dx-textbox-heading");
        }

                                    });
                                    });
    let dataGrid; // Global reference to the DataGrid instance

    // Initialize the DataGrid and store its instance
    function dataGridInitialized(e) {
        dataGrid = e.component;
    }

    function switchButtons(buttonId) {
        
        let hideBtn, showBtn, filterType;

        // Determine which buttons to toggle and set the filter type
        if (buttonId === "btnBillsWithBalance") {
            showBtn = "btnBillsFullyReceived";
            hideBtn = "btnBillsWithBalance";
            filterType = "WithBalance"; // Filter: Balance > 0
        } else if (buttonId === "btnBillsFullyReceived") {
            showBtn = "btnBillsWithBalance";
            hideBtn = "btnBillsFullyReceived";
            filterType = "FullyReceived"; // Filter: Balance = 0
        }

        // Use DevExtreme APIs to toggle button visibility
        const hideButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(hideBtn));
        const showButtonInstance = DevExpress.ui.dxButton.getInstance(document.getElementById(showBtn));

        hideButtonInstance.option("visible", false);
        showButtonInstance.option("visible", true);

        // Reload the DataGrid with the appropriate filter based on the button clicked
        if (dataGrid) {
            dataGrid.option("dataSource", {
                load: function () {
                    return $.getJSON(`/${tenantName}/Finance/api/BillsReceivable/Get`, { filterType: filterType });

                }
            });
            dataGrid.refresh();
        }
    }


    function onContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") { // Only for data rows
            e.items = [
                {
                    text: "View Ledger Transactions",
                    onItemClick: function () {
                        // Navigate to frm201LedgerView with the selected client details
                        const AccountHeadNo = e.row.data.AccountHeadNo; // Example: Assuming AccountHeadNo is the client identifier
                        const url = `/${tenantName}/Finance/AccountingLedgers?AccountId=${AccountHeadNo}`;
                        window.open(url, '_blank'); // Opens in a new tab
                    }
                }
            ];
        }
    }
 
    // Print button functionality (Export as PDF)
    document.getElementById("RptReceivableAgeing").addEventListener("click", showReport);
    document.getElementById("RptReceivableAgeingSummary").addEventListener("click", showReport1);
    // Print button functionality (Export as PDF)
    function showReport() {
        // Open the report in a new tab
        window.open(`/${tenantName}/Finance/api/BillsReceivable/GenerateReport`, '_blank');
    }
    function showReport1() {
        // Open the report in a new tab
        window.open(`/${tenantName}/Finance/api/BillsReceivable/GenerateAgeingreportsummaryReport`, '_blank');
    }
   


</script>

