@page
@model QD.ERP.Web.Areas.Finance.Pages.LedgerSubGroupMasterModel
@{
}
@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Add SweetAlert CSS and JS CDN -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.js"></script>

<style type="text/css">
    .card-container {
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .card-container label {
            color: blue;
        }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .dx-datagrid-headers .dx-header-row .dx-datagrid-text-content {
        color: #2d5799;
    }

    .dx-datagrid-headers .dx-header-row {
        background-color: #e7f2fe;
    }

    .dx-button-add {
        background-color: #f5f8fb !important;
        color: red !important;
        border: 1px solid #b0c4de;
    }

        .dx-button-add .dx-icon {
            color: green !important;
        }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .backgroundcolor {
        background-color: white
    }

    .button-alignment-down {
        margin-bottom: 10px;
    }

    .action-buttons-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

        .action-buttons-container .dx-button {
            margin-right: 10px;
        }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }
</style>
<link rel="stylesheet" href="~/css/Site.css" />
<div class="title">
    <div class="header-container">
        <div id="LedgerSubGroupMaster" class="no-border-title"></div>
    </div>
</div>
<div class="content-container-top">
    <div class="form-group">
        @(
            Html.DevExtreme().TextBox()
            .Label(new JS("formatMessage('Enter New Sub Group & Add to the Existing List')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("txtSubGroupName")
            .Value(null)
            )
    </div>
</div>

<div class="col-md-8">
    <div class="form-group">
        @(
            Html.DevExtreme().TextBox()
            .Label(new JS("formatMessage('Sub Group Name (Arabic)')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("txtSubGroupNameAr")
            .Value(null)
            )
    </div>
</div>
<div class="col-md-4">
    <div class="form-group">
        @(Html.DevExtreme().Button()
            .ID("btnAdd")
            .Text(new JS("formatMessage('ADD')"))
            .Height(70)
            .Width(178)
            .Icon("plus")
            .OnClick("function() { addLedgerSubGroup(); }")
            .ElementAttr(new { @class = "dx-button-add" })
            )
    </div>
</div>
<div class="clear"></div>
<br />
<div id="gridContainer"></div>
<script type="text/javascript">
    $(function () {
        $("#LedgerSubGroupMaster").dxTextBox({
            text: formatMessage("Ledger Sub Group Master"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }

        });
    });
    $(function () {
        var updatedRows = []; // To store the updated rows
        var searchPanelVisible = false; // Track the visibility of the search panel


        // Initialize DevExtreme DataGrid with CustomStore
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "LedgerSubGroupCode",
                load: function () {
                    return $.getJSON('/api/Master/GetLedgerSubGroups'); // Fetch data from the API
                },
                update: function (key, values) {
                    var updatedSubGroup = {
                        LedgerSubGroupCode: key,
                        SubGroupName: values.SubGroupName,
                        SubGroupNameAr: values.SubGroupNameAr
                    };

                    // Add the updated sub-group to the updatedRows array
                    updatedRows.push(updatedSubGroup);

                    // Send the updated data to the backend via AJAX
                    return $.ajax({
                        type: "POST",
                        url: "/api/Master/UpdateLedgerSubGroup",
                        data: JSON.stringify(updatedSubGroup),
                        contentType: "application/json",
                        success: function (response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Sub Group Updated',
                                text: 'The sub-group has been successfully updated.',
                                confirmButtonText: 'OK'
                            });
                        },
                        error: function (xhr) {
                            var errorMessage = xhr.status === 500
                                ? "Server error: Please try again later."
                                : "Validation error: " + xhr.responseText;
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: errorMessage,
                                confirmButtonText: 'OK'
                            });
                        }
                    });
                }
            }),
            editing: {
                mode: "batch",
                allowUpdating: true,
                allowAdding: false,
                allowDeleting: false,
                useIcons: true,
                texts: {
                    saveAll: "Update",
                    cancelAll: "Cancel All Changes"
                }
            },
            columns: [
                { dataField: "LedgerSubGroupCode", caption: formatMessage("Sub Group Code"), width: 100, editorOptions: { readOnly: true } },
                { dataField: "SubGroupName", caption: formatMessage("Sub Group Name") },
                { dataField: "SubGroupNameAr", caption: formatMessage("Sub Group Name (Arabic)") }
            ],
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: {
                visible: searchPanelVisible, // Set initial visibility of the filter row
                applyFilter: "auto"
            },
            toolbar: {
                items: [
                    {
                        widget: "dxButton",
                        options: {
                            icon: "save",  // Icon for the Save button
                            text: formatMessage("Update"),  // Text alongside the icon
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").saveEditData();  // Save all changes
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",  // Adding Cancel button
                        options: {
                            icon: "close",  // Icon for Cancel button
                            text: formatMessage("Cancel"),  // Text for Cancel button
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").cancelEditData();  // Cancel all edits
                            },
                            visible: false // Initially hide the cancel button
                        },
                        location: "after",
                        name: "cancelButton"
                    },
                    {
                        widget: "dxButton",  // Adding Search Toggle button
                        options: {
                            icon: "search",  // Icon for Search button
                            text: formatMessage("Toggle Search"),  // Text for Search button
                            onClick: function () {
                                searchPanelVisible = !searchPanelVisible; // Toggle the visibility
                                $("#gridContainer").dxDataGrid("instance").option("filterRow.visible", searchPanelVisible); // Update the grid
                            }
                        },
                        location: "after"
                    }
                ]
            },
            onEditingStart: function (e) {
                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                var toolbarItems = dataGrid.option("toolbar.items");
                var cancelButton = toolbarItems.find(item => item.name === "cancelButton");
                cancelButton.options.visible = true; // Show the cancel button when editing starts
                dataGrid.option("toolbar.items", toolbarItems);
            },
            onSaved: function (e) {
                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                var toolbarItems = dataGrid.option("toolbar.items");
                var cancelButton = toolbarItems.find(item => item.name === "cancelButton");
                cancelButton.options.visible = false; // Hide the cancel button when editing ends
                dataGrid.option("toolbar.items", toolbarItems);
            },
            onEditCanceling: function (e) {
                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                var toolbarItems = dataGrid.option("toolbar.items");
                var cancelButton = toolbarItems.find(item => item.name === "cancelButton");
                cancelButton.options.visible = false; // Hide the cancel button when editing is canceled
                dataGrid.option("toolbar.items", toolbarItems);
            },
            onRowUpdated: function (e) {
                Swal.fire({
                    icon: 'success',
                    title: formatMessage('Row Updated'),
                    text: formatMessage('The row data was successfully updated.'),
                    confirmButtonText: 'OK'
                });
            },
            onRowInserted: function (e) {
                Swal.fire({
                    icon: 'success',
                    title: formatMessage('Row Inserted'),
                    text: formatMessage('A new row was added successfully.'),
                    confirmButtonText: 'OK'
                });
            },
            onRowRemoved: function (e) {
                Swal.fire({
                    icon: 'info',
                    title: formatMessage('Row Removed'),
                    text: formatMessage('The row has been removed from the grid.'),
                    confirmButtonText: 'OK'
                });
            },
            scrolling: {
                mode: "virtual",
                rowRenderingMode: "virtual",
                useNative: true
            },
            height: 400,
            width: "100%"
        });
    });

    function addLedgerSubGroup() {
        var subGroupName = $("#txtSubGroupName").dxTextBox("instance").option("value");
        var subGroupNameAr = $("#txtSubGroupNameAr").dxTextBox("instance").option("value");

        if (subGroupName && subGroupNameAr) {
            var newSubGroup = {
                SubGroupName: subGroupName,
                SubGroupNameAr: subGroupNameAr
            };

            // Add via AJAX to save in DB
            $.ajax({
                type: "POST",
                url: "/api/Master/AddLedgerSubGroup",
                data: JSON.stringify(newSubGroup),
                contentType: "application/json",
                success: function () {
                    Swal.fire({
                        icon: 'success',
                        title: formatMessage('Added!'),
                        text: formatMessage('The Sub Group has been added.'),
                        confirmButtonText: 'OK'
                    }).then(function () {
                        location.reload(); // Refresh grid
                    });
                },
                error: function (xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: formatMessage('Error'),
                        text: formatMessage('An error occurred while adding the subgroup.'),
                        confirmButtonText: 'OK'
                    });
                }
            });
        }
    }
</script>
