@page
@model QD.ERP.Web.Areas.Finance.Pages.LedgerSubGroupMasterModel
@{
}
@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Add SweetAlert CSS and JS CDN -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.js"></script>

<style type="text/css">
    .card-container {
        background-color: #cfddee;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .card-container label {
            color: blue;
        }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .dx-datagrid-headers .dx-header-row .dx-datagrid-text-content {
        color: #2d5799;
    }

    .dx-datagrid-headers .dx-header-row {
        background-color: #e7f2fe;
    }

    .dx-button-add {
        background-color: #f5f8fb !important;
        color: red !important;
        border: 1px solid #b0c4de;
    }

        .dx-button-add .dx-icon {
            color: green !important;
        }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .backgroundcolor {
        background-color: #89f0b5;
    }

    .button-alignment-down {
        margin-bottom: 10px;
    }

    .action-buttons-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

        .action-buttons-container .dx-button {
            margin-right: 10px;
        }
</style>

<div class="content-container-top">
    <div class="container">
        <h2>Ledger Sub Group Master</h2>

        <div class="card-container">
            <div class="row g-6">
                <div class="col-md-8">
                    <div class="form-group">
                        <label for="SubGroupName" class="button-alignment-down">Enter New Sub Group & Add to the Existing List</label>
                        @(
                            Html.DevExtreme().TextBox()
                            .ID("txtSubGroupName")
                            .Value(null)
                            )
                    </div>
                </div>
            </div>

            <div class="row g-6">
                <div class="col-md-8">
                    <div class="form-group">
                        <label for="SubGroupNameAr" class="button-alignment-down">Sub Group Name (Arabic)</label>
                        @(
                            Html.DevExtreme().TextBox()
                            .ID("txtSubGroupNameAr")
                            .Value(null)
                            )
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @(Html.DevExtreme().Button()
                            .ID("btnAdd")
                            .Text("ADD")
                            .Height(70)
                            .Width(178)
                            .Icon("plus")
                            .OnClick("function() { addLedgerSubGroup(); }")
                            .ElementAttr(new { @class = "dx-button-add" })
                            )
                    </div>
                </div>
            </div>
            <div class="clear"></div>
            <br />
            <div id="gridContainer"></div>
        </div> <!-- End of card-container -->
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var updatedRows = []; // To store the updated rows

        // Initialize DevExtreme DataGrid with CustomStore
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "LedgerSubGroupCode",
                load: function () {
                    return $.getJSON('/api/Master/GetLedgerSubGroups'); // Fetch data from the API
                },
                update: function (key, values) {
                    var updatedSubGroup = {
                        LedgerSubGroupCode: key,
                        SubGroupName: values.SubGroupName,
                        SubGroupNameAr: values.SubGroupNameAr
                    };

                    // Add the updated sub-group to the updatedRows array
                    updatedRows.push(updatedSubGroup);

                    // Send the updated data to the backend via AJAX
                    return $.ajax({
                        type: "POST",
                        url: "/api/Master/UpdateLedgerSubGroup",
                        data: JSON.stringify(updatedSubGroup),
                        contentType: "application/json",
                        success: function (response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Sub Group Updated',
                                text: 'The sub-group has been successfully updated.',
                                confirmButtonText: 'OK'
                            });
                        },
                        error: function (xhr) {
                            var errorMessage = xhr.status === 500
                                ? "Server error: Please try again later."
                                : "Validation error: " + xhr.responseText;
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: errorMessage,
                                confirmButtonText: 'OK'
                            });
                        }
                    });
                }
            }),
            editing: {
                mode: "batch",
                allowUpdating: true,
                allowAdding: false,
                allowDeleting: false,
                useIcons: true,
                texts: {
                    saveAll: "Update",
                    cancelAll: "Cancel All Changes"
                }
            },
            columns: [
                { dataField: "LedgerSubGroupCode", caption: "Sub Group Code", width: 100, editorOptions: { readOnly: true } },
                { dataField: "SubGroupName", caption: "Sub Group Name" },
                { dataField: "SubGroupNameAr", caption: "Sub Group Name (Arabic)" }
            ],
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: {
                visible: true,
                applyFilter: "auto"
            },
            toolbar: {
                items: [
                    {
                        widget: "dxButton",
                        options: {
                            icon: "save",
                            text: "Update",
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").saveEditData();
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",
                        options: {
                            icon: "close",
                            text: "Cancel",
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").cancelEditData();
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",
                        options: {
                            icon: "arrowleft",
                            text: "Back",
                            onClick: function () {
                                window.close();
                            }
                        },
                        location: "after"
                    }
                ]
            },

            onRowUpdated: function (e) {
                Swal.fire({
                    icon: 'success',
                    title: 'Row Updated',
                    text: 'The row data was successfully updated.',
                    confirmButtonText: 'OK'
                });
            },
            onRowInserted: function (e) {
                Swal.fire({
                    icon: 'success',
                    title: 'Row Inserted',
                    text: 'A new row was added successfully.',
                    confirmButtonText: 'OK'
                });
            },
            onRowRemoved: function (e) {
                Swal.fire({
                    icon: 'info',
                    title: 'Row Removed',
                    text: 'The row has been removed from the grid.',
                    confirmButtonText: 'OK'
                });
            },
            scrolling: {
                mode: "virtual",
                rowRenderingMode: "virtual",
                useNative: true
            },
            height: 400,
            width: "100%"
        });
    });

    function addLedgerSubGroup() {
        var subGroupName = $("#txtSubGroupName").dxTextBox("instance").option("value");
        var subGroupNameAr = $("#txtSubGroupNameAr").dxTextBox("instance").option("value");

        if (subGroupName && subGroupNameAr) {
            var newSubGroup = {
                SubGroupName: subGroupName,
                SubGroupNameAr: subGroupNameAr
            };

            // Add via AJAX to save in DB
            $.ajax({
                type: "POST",
                url: "/api/Master/AddLedgerSubGroup",
                data: JSON.stringify(newSubGroup),
                contentType: "application/json",
                success: function () {
                    Swal.fire({
                        icon: 'success',
                        title: 'Added!',
                        text: 'The Sub Group has been added.',
                        confirmButtonText: 'OK'
                    }).then(function () {
                        location.reload(); // Refresh grid
                    });
                },
                error: function (xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while adding the subgroup.',
                        confirmButtonText: 'OK'
                    });
                }
            });
        }
    }
</script>
