    function ddBtnShowRecords_click(filterType) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");

        const today = new Date();
        let startDateComponent = $("#VoucherDate").dxDateBox("instance");
        let endDateComponent = $("#EffectiveDate").dxDateBox("instance");
        let startDate = startDateComponent.option("value");
        let endDate = endDateComponent.option("value");

        let useFormattedDate = false; // ✅ Default: use ISO

        switch (filterType) {
            case 'today':
                startDate = new Date(today.setHours(0, 0, 0, 0));
                endDate = new Date(today.setHours(23, 59, 59, 999));
                break;

            case 'yesterday':
                startDate = new Date(today);
                startDate.setDate(today.getDate() - 1);
                startDate.setHours(0, 0, 0, 0);
                endDate = new Date(startDate);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'week':
                startDate = new Date(today);
                startDate.setDate(today.getDate() - today.getDay());
                startDate.setHours(0, 0, 0, 0);
                endDate = new Date(startDate);
                endDate.setDate(startDate.getDate() + 6);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'lastmonth':
                startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'lastyear':
                startDate = new Date(today.getFullYear() - 1, 0, 1);
                endDate = new Date(today.getFullYear() - 1, 11, 31);
                endDate.setHours(23, 59, 59, 999);
                break;

            case 'range':
                // ✅ Use date box values directly and format them as strings
                startDate = startDateComponent.option("value");
                endDate = endDateComponent.option("value");

                if (!(startDate instanceof Date)) startDate = new Date(startDate);
                if (!(endDate instanceof Date)) endDate = new Date(endDate);

                useFormattedDate = true;
                break;

            default:
                return; // Invalid filter, exit
        }

        if (startDate && endDate) {
            // Update the UI DateBoxes with actual values (optional)
            startDateComponent.option("value", startDate);
            endDateComponent.option("value", endDate);

            const voucherType = [
                "Bank Payment", "Cash Payment",
                "Bank Receipts", "Cash Receipts",
                "Sales", "Purchases", "Journal"
            ];

            const formattedStart = useFormattedDate
                ? startDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })
                : startDate.toISOString();

            const formattedEnd = useFormattedDate
                ? endDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })
                : endDate.toISOString();

            // 🚀 Final AJAX call
            $.ajax({
                url: '/api/VoucherApproval/GetVoucherApprovals',
                type: 'GET',
                data: {
                    startDate: formattedStart,
                    endDate: formattedEnd,
                    voucherTypes: voucherType.join(",")
                },
                success: function (data) {
                    const targetGrid = $("#dataGrid").dxDataGrid("instance");
                    targetGrid.option("dataSource", data);
                    targetGrid.refresh();
                },
                error: function (err) {
                    DevExpress.ui.notify("Failed to load data", "error", 2000);
                    console.error(err);
                }
            });
        }
    }

    $(function () {
        loadVoucherApprovals();
        var selectedVoucherNos = [];
        var selectedVoucherTypes = [];

        $("#dataGrid").dxDataGrid({
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always"
            },
            onSelectionChanged: function (e) {
                selectedVoucherNos = e.selectedRowsData.map(row => row.VoucherNo);
                selectedVoucherTypes = e.selectedRowsData.map(row => row.VoucherType);
                console.log("Selected Vouchers:", selectedVoucherNos);
            }
        });

        $("#voucherContextMenu").dxContextMenu({
            dataSource: [
                { text: "Edit Voucher", icon: "edit", action: editVoucher },
                { text: "View Voucher", icon: "find", action: viewVoucher },
                { text: "Verify Vouchers", icon: "check", action: verifyVouchers },
                { text: "Delete Vouchers", icon: "close", action: deleteVouchers },
                { text: "Verify All Selected Vouchers", icon: "card", action: verifyVouchers },
                { text: "Approve All Selected Vouchers", icon: "user", action: approveVouchers },
                { text: "Unlock Vouchers", icon: "unlock", action: unlockVouchers }
            ],
            target: "#dataGrid .dx-data-row",
            showEvent: "dxcontextmenu",
            width: 250,
            onItemClick: function (e) {
                if (e.itemData.action) {
                    e.itemData.action();
                }
            }
        });

        // ✅ Show context menu only when right-clicking on data rows
        $(document).on("contextmenu", ".dx-data-row", function (e) {
            e.preventDefault();
            if (selectedVoucherNos.length > 0) {
                $("#voucherContextMenu").dxContextMenu("instance").show();
            }
        });

        // Hide context menu when clicking outside
        document.addEventListener("click", function (event) {
            const contextMenu = $("#voucherContextMenu").dxContextMenu("instance");
            if (!$(event.target).closest("#voucherContextMenu, .dx-row").length) {
                contextMenu.hide();
            }
        });

        function editVoucher() {
            if (selectedVoucherNos.length === 0) {
                DevExpress.ui.notify("Please select exactly one voucher to edit.", 2000);
                return;
            }
            navigateToVoucherPage(selectedVoucherNos[0], selectedVoucherTypes[0]);
        }


        function viewVoucher() {
            console.log("View Voucher Clicked");
        }

        function verifyVouchers() {
            if (selectedVoucherNos.length === 0) {
                DevExpress.ui.notify("Please select Vouchers to Verify!", "error", 2000);
                return;
            }
            updateVoucherStatus(selectedVoucherNos, "verify");
        }

        function approveVouchers() {
            if (selectedVoucherNos.length === 0) {
                DevExpress.ui.notify("Please select Vouchers to Approve!", "error", 2000);
                return;
            }
            updateVoucherStatus(selectedVoucherNos, "approve");
        }

        function unlockVouchers() {
            if (selectedVoucherNos.length === 0) {
                DevExpress.ui.notify("Please select Vouchers to Unlock!", "error", 2000);
                return;
            }
            updateVoucherStatus(selectedVoucherNos, "unlock");
        }

        function deleteVouchers() {
            if (selectedVoucherNos.length === 0) {
                DevExpress.ui.notify("Please select Vouchers to Delete!", "error", 2000);
                return;
            }

            DevExpress.ui.dialog.confirm("Are you sure you want to delete the selected vouchers?", "Confirm Deletion")
                .done(function (dialogResult) {
                    if (dialogResult) {
                        $.ajax({
                            url: '/api/VoucherApproval/DeleteVouchers',
                            type: 'POST',
                            data: JSON.stringify({ voucherNos: selectedVoucherNos }),
                            contentType: 'application/json; charset=utf-8',
                            success: function (response) {
                                if (response.success) {
                                    DevExpress.ui.notify("Vouchers deleted successfully!", "success", 2000);
                                    // Call your own custom reload function
                                    loadVoucherApprovals();
                                } else {
                                    DevExpress.ui.notify(response.message || "Failed to delete vouchers!", "error", 2000);
                                }
                            },
                            error: function () {
                                DevExpress.ui.notify("Error occurred while deleting vouchers!", "error", 2000);
                            }
                        });
                    }
                });
        }


        function updateVoucherStatus(voucherNos, actionType) {
            $.ajax({
                url: '/api/VoucherApproval/UpdateVoucherStatus',
                type: 'POST',
                contentType: "application/json",
                data: JSON.stringify({
                    VoucherNos: voucherNos,
                    ActionType: actionType,
                    
                }),
                success: function (response) {
                    if (response.success) {
                        DevExpress.ui.notify(response.message, "success", 2000);
                        // Call your own custom reload function
                        loadVoucherApprovals();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("Error updating voucher status.");
                }
            });
        }

        function navigateToVoucherPage(voucherNo, voucherType) {
            if (!voucherNo || !voucherType) {
                alert("Invalid voucher details.");
                return;
            }

            let formattedVoucher = voucherNo.trim().toUpperCase();
            let formattedVoucherType = voucherType.trim();

            const voucherRoutes = {
                "Bank Payment": `/${tenantName}/finance/VoucherBankPayment`,
                "Cash Payment": `/${tenantName}/finance/VoucherCashPayment`,
                "Bank Receipts": `/${tenantName}/finance/VoucherEntryReceipts`,
                "Cash Receipts": `/${tenantName}/finance/VoucherEntryCashReceipts`,
                "Sales": `/${tenantName}/finance/SalesVoucher`,
                "purchases": `/${tenantName}/finance/PurchaseVoucher`,
                "Journal": `/${tenantName}/finance/VoucherJournal`
            };

            let baseUrl = voucherRoutes[formattedVoucherType];

            if (baseUrl) {
                let targetUrl = `${baseUrl}?argsledno=${encodeURIComponent(formattedVoucher)}&vouchertype=${encodeURIComponent(formattedVoucherType)}`;
                console.log("Navigating to:", targetUrl);
                window.location.href = targetUrl;
            } else {
                alert("Unknown voucher type: " + voucherType);
            }
        }
        
    });
    

