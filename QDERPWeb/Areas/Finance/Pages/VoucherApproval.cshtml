@page 

<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; 
    }



    .horizontal-container {
        display: flex;
        gap: 10px; 
        justify-content: start; 
        align-items: center; 
        margin: 15px;
    }

    
    #voucherPopup {
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

   
    .voucher-actions {
        list-style-type: none;
        padding: 0;
        margin: 0;
        background-color: #fff;
        border-radius: 5px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .voucher-actions .menu-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 14px;
            color: #333;
            border-bottom: 1px solid #f0f0f0;
        }

            .voucher-actions .menu-item:hover {
                background-color: #f0f0f0;
            }

            .voucher-actions .menu-item:last-child {
                border-bottom: none; 
            }

   
    .dx-icon {
        font-size: 16px;
        margin-right: 10px;
    }

  
    .dx-checkbox {
        margin: 10px;
    }

    .menu-item i {
        color: #555; 
        font-size: 20px; 
        margin-right: 10px; 
    }

   
    .menu-item .dx-icon-edit {
        color: #007bff; 
    }

    .menu-item .dx-icon-find {
        color: #28a745; 
    }

    .menu-item .dx-icon-check {
        color: #ffc107; 
    }

    .menu-item .dx-icon-trash {
        color: #dc3545; 
    }

    .menu-item .dx-icon-selectall {
        color: #17a2b8; 
    }

    .menu-item .dx-icon-todo {
        color: #6c757d; 
    }

    .menu-item .dx-icon-unlock {
        color: #6610f2; 
    }

   
    .menu-item:hover i {
        opacity: 0.8;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

</style>
<div class="card" style="margin: 20px; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);">
    <div class="card-header" style="background-color: #4a4a9c; color: white; font-weight: bold;">
        VoucherApproval
    </div>
    <div class="card-body" style="padding: 20px; background-color: #c0dceb; border-radius: 5px;">
        <div class="dx-fieldset horizontal-container" style="margin-bottom: 0px">
            <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
                <div style="flex: 1; margin: 10px; padding: 50px; background-color: #629e63; color: white; text-align: center; font-weight: bold; font-size: 12px;">
                    QuickDiceERPSolutions<br>
                    AssetsRegister
                </div>
                <div style="flex: 1; margin: 10px; padding: 50px; background-color: #5a85b0; color: white; text-align: center; font-weight: bold; font-size: 12px;">
                    No of voucher verified
                </div>
                <div style="flex: 1; margin: 10px; padding: 25px; background-color: #c94d44; color: white; text-align: center; font-weight: bold; font-size: 12px; display: flex; justify-content: center; align-items: center;">
                    No of Assets: <span id="noOfAssets">0</span>
                </div>
                <div style="flex: 1; margin: 10px; padding: 50px; background-color: #0b6e25; color: white; text-align: center; font-weight: bold; font-size: 12px;">
                    Current Assets Value: ₹<span id="currentAssetValue">0.00</span>
                </div>
            </div>
        </div>
    


        
        <div class="dx-fieldset" style="display: flex; gap: 20px; margin-bottom: 20px; align-items: center;">
            <div>
                @(Html.DevExtreme().DateBox()
                    .ID("VoucherDate")
                    .InputAttr("aria-label", "Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)))
            </div>
            <div>
                @(Html.DevExtreme().DateBox()
                    .ID("EffectiveDate")
                    .InputAttr("aria-label", "Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)))
            </div>
            <div>
                @(Html.DevExtreme().DropDownButton()
                    .ID("ddBtnShowRecords")
                    .Text("Show Records")
                    .Icon("smalliconslayout")
                    .Width(180)
                    .DropDownOptions(options => options.Width(230))
                    .Items(items =>
                    {
                        items.Add().Text("Show Records").Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                        items.Add().Text("Today").Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                        items.Add().Text("Yesterday").Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                        items.Add().Text("This Week").Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                        items.Add().Text("This Month Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                        items.Add().Text("This Month (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                        items.Add().Text("This Year Till Date").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                        items.Add().Text("This Year (Full)").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                        items.Add().Text("Last Month").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                        items.Add().Text("Last Year").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                    }))
            </div>

        </div>

       
        <div class="dx-field ledgerResult">
            @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                    .ID("dataGrid")
                    .KeyExpr("VoucherNo")
                    .RemoteOperations(false)
                    .DataSource(ds => ds.Mvc()
                    .Controller("VoucherApproval")
                    .LoadAction("GetVoucherApproval"))
                    .Columns(columns =>
                    {
                        columns.Add()
                    .DataField("select")
                    .Caption("Select")
                    .CellTemplate(@<text>
                <input type="checkbox" class="dx-checkbox" />
            </text>);
                        columns.Add().DataField("VoucherNo").Caption("Voucher No").Width(80);
                        columns.Add().DataField("VoucherDate").Caption("Voucher Date").Width(100);
                        columns.Add().DataField("VoucherEffectiveDate").Caption("Effective On").Width(100);
                        columns.Add().DataField("VoucherNarration").Caption("Voucher Narration").Width(150);
                        columns.Add().DataField("DebitAmount").Caption("Debit").Width(100);
                        columns.Add().DataField("CreditAmount").Caption("Credit").Width(100);
                        columns.Add().DataField("VoucherEnteredBy").Caption("Entered By").Width(120);
                        columns.Add().DataField("VoucherVerifiedBy").Caption("Verified By").Width(120);
                        columns.Add().DataField("VoucherApprovedBy").Caption("Approved").Width(120);
                        columns.Add().DataField("VoucherType").Caption("Voucher").Width(100);
                        columns.Add().DataField("AuditVerifiedBy").Caption("Audit").Width(120);
                    })
                .Summary(summary =>
                {
                    summary.TotalItems(items =>
                    {
                        items.Add().Column("VoucherNo").SummaryType(SummaryType.Count).DisplayFormat("{0}");
                        items.Add().Column("DebitAmount").SummaryType(SummaryType.Sum).CustomizeText(
                @"function(e) {
            return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }");
                        items.Add().Column("CreditAmount").SummaryType(SummaryType.Sum).CustomizeText(
                @"function(e) {
            return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }");
                    });
                })

                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(fixing => fixing.Enabled(true))
                .HeaderFilter(filter => filter.Visible(true))
                .Height(300)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false))
                .GroupPanel(groupPanel => groupPanel.Visible(false))
                .ShowBorders(true)
                .Width("100%")
                .Paging(paging => paging.Enabled(false))
                )
        </div>

        <div>
            @await Html.PartialAsync("GridFooterApproval")
        </div>
        <div id="voucherPopup"></div>
    </div>



    <script>
        function ddBtnShowRecords_click(filterType) {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");

            let today = new Date();
            let startDate = null, endDate = null;

            switch (filterType) {
                case 'today':
                    startDate = new Date(today.setHours(0, 0, 0, 0));
                    endDate = new Date(today.setHours(23, 59, 59, 999));
                    break;

                case 'yesterday':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - 1);
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'week':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - today.getDay());
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setDate(startDate.getDate() + 6);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'tillmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0, 23, 59, 59, 999);
                    break;

                case 'tillyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today.getFullYear(), 11, 31, 23, 59, 59, 999);
                    break;

                case 'lastmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    endDate = new Date(today.getFullYear(), today.getMonth(), 0, 23, 59, 59, 999);
                    break;

                case 'lastyear':
                    startDate = new Date(today.getFullYear() - 1, 0, 1);
                    endDate = new Date(today.getFullYear() - 1, 11, 31, 23, 59, 59, 999);
                    break;

                default:
                    dataGrid.option("dataSource", {
                        load: function () {
                            return $.ajax({
                                url: "/api/VoucherApproval/GetVoucherApprovals",
                                type: "GET"
                            });
                        }
                    });

                    dataGrid.refresh();
                    return;
            }

            // Ensure both startDate and endDate are set before making the AJAX request
            if (startDate && endDate) {
                dataGrid.option("dataSource", {
                    load: function () {
                        return $.ajax({
                            url: "/api/VoucherApproval/GetVoucherApprovals",
                            data: {
                                startDate: startDate.toISOString(),
                                endDate: endDate.toISOString()
                            },
                            type: "GET"
                        });
                    }
                });

                dataGrid.refresh();
            }
        }
        $(function () {
           
            $("#voucherPopup").dxPopup({
                width: 300,
                height: 400,
                showTitle: true,
                title: "Voucher Options",
                visible: false,
                dragEnabled: true,
                closeOnOutsideClick: true,
                contentTemplate: function () {
                    return $("<div>").append(
                        $("<ul>").addClass("voucher-actions").append(
                            createMenuItem("Edit Voucher", "edit", editVoucher),
                            createMenuItem("View Voucher", "find", viewVoucher),
                            createMenuItem("Verify Voucher", "check", verifyVoucher),
                            createMenuItem("Delete Voucher", "trash", deleteVoucher),
                            createMenuItem("Verify All Selected Vouchers", "selectall", verifyAll),
                            createMenuItem("Approve All Selected Vouchers", "todo", approveAll),
                            createMenuItem("Unlock the Voucher", "unlock", unlockVoucher)
                        )
                    );
                }
            });

            function createMenuItem(text, icon, clickHandler) {
                return $("<li>")
                    .addClass("menu-item")
                    .append(
                        $("<i>").addClass("dx-icon dx-icon-" + icon),
                        $("<span>").text(" " + text)
                    )
                    .on("click", clickHandler);
            }

          
            function editVoucher() { console.log("Edit Voucher Clicked"); }
            function viewVoucher() { console.log("View Voucher Clicked"); }
            function verifyVoucher() { console.log("Verify Voucher Clicked"); }
            function deleteVoucher() { console.log("Delete Voucher Clicked"); }
            function verifyAll() { console.log("Verify All Selected Vouchers Clicked"); }
            function approveAll() { console.log("Approve All Selected Vouchers Clicked"); }
            function unlockVoucher() { console.log("Unlock Voucher Clicked"); }

        
            $(document).on("click", ".dx-row", function () {
            
                $("#voucherPopup").dxPopup("instance").show();
            });

          
            $(document).on("change", ".dx-checkbox", function () {
            
                if (!$(this).prop("checked")) {
                    $("#voucherPopup").dxPopup("instance").hide();
                }
            });

           
            $(document).on("click", function (e) {
                if (!$(e.target).closest("#voucherPopup").length && !$(e.target).closest(".dx-row").length) {
                    $("#voucherPopup").dxPopup("instance").hide();
                }
            });
        });





    </script>
