                columns.Add().DataField("select").Caption(new JS("formatMessage('Select')"))
            .CellTemplate(@<text>
        <input type="checkbox" class="dx-checkbox" />
    </text>).Width(50)
        .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Select</div>
    </text>);

                columns.Add().DataField("VoucherNo").Caption(new JS("formatMessage('Voucher No')")).Width(80)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Voucher No</div>
    </text>);

                columns.Add().DataField("VoucherDate").Caption(new JS("formatMessage('Voucher Date')")).Width(100)
            .DataType(GridColumnDataType.Date).Format("dd/MM/yyyy").Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Voucher Date</div>
    </text>);

                columns.Add().DataField("VoucherNarration").Caption(new JS("formatMessage('Voucher Narration')")).Width(150).Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Voucher Narration</div>
    </text>);

                columns.Add().DataField("DebitAmount").Caption(new JS("formatMessage('Debit')")).Width(100).Alignment(HorizontalAlignment.Right)
            .CustomizeText("function(e) { return e.value ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2 }) : ''; }").Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Debit</div>
    </text>);

                columns.Add().DataField("CreditAmount").Caption(new JS("formatMessage('Credit')")).Width(100).Alignment(HorizontalAlignment.Right)
            .CustomizeText("function(e) { return e.value ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2 }) : ''; }").Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Credit</div>
    </text>);

                columns.Add().DataField("VoucherEnteredBy").Caption(new JS("formatMessage('Entered By')")).Width(120).Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Entered By</div>
    </text>);

                columns.Add().DataField("VoucherVerifiedBy").Caption(new JS("formatMessage('Verified By')")).Width(120).Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Verified By</div>
    </text>);

                columns.Add().DataField("VoucherApprovedBy").Caption(new JS("formatMessage('Approved')")).Width(120).Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Approved</div>
    </text>);

                columns.Add().DataField("AuditVerifiedBy").Caption(new JS("formatMessage('Audit')")).Width(120).Visible(true)
            .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Audit</div>
    </text>);

                // Checkbox Columns for Approved, Verified, and Audit
                columns.Add().DataField("IsApproved").Caption(new JS("formatMessage('Approved')")).Width(120)
            .DataType(GridColumnDataType.Boolean)
            .CellTemplate(@<text>
        <input type="checkbox" class="dx-checkbox" onclick="updateApprovalStatus(this, 'IsApproved', data)"
               data-bind="checked: data.IsApproved" />
    </text>)
        .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Approved</div>
    </text>);

                columns.Add().DataField("IsVerified").Caption(new JS("formatMessage('Verified')")).Width(120)
            .DataType(GridColumnDataType.Boolean)
            .CellTemplate(@<text>
        <input type="checkbox" class="dx-checkbox" onclick="updateApprovalStatus(this, 'IsVerified', data)"
               data-bind="checked: data.IsVerified" />
    </text>)
        .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Verified</div>
    </text>);

                columns.Add().DataField("IsAuditVerified").Caption(new JS("formatMessage('Audit')")).Width(120)
            .DataType(GridColumnDataType.Boolean)
            .CellTemplate(@<text>
        <input type="checkbox" class="dx-checkbox" onclick="updateApprovalStatus(this, 'IsAuditVerified', data)"
               data-bind="checked: data.IsAuditVerified" />
    </text>)
        .HeaderCellTemplate(@<text>
        <div style="white-space: normal; text-align: center;">Audit</div>
    </text>);

            })
        .Summary(summary =>
        {
            summary.TotalItems(items =>
            {
                items.Add().Column("VoucherNo").SummaryType(SummaryType.Count).DisplayFormat("{0}");
                items.Add().Column("DebitAmount").SummaryType(SummaryType.Sum).CustomizeText(
        @"function(e) {
    return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }");
                items.Add().Column("CreditAmount").SummaryType(SummaryType.Sum).CustomizeText(
        @"function(e) {
    return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }");
            });
        })
        .ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.Select))
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(true))
        .Height(300)
        .Width("100%")
        .Paging(paging => paging.Enabled(false))
        .Scrolling(scrolling => scrolling.Mode(GridScrollingMode.Virtual))
        .FilterRow(filterRow => filterRow.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .OnRowPrepared("onRowPrepared")
        )
</div>



