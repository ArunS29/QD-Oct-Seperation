@page
@model QDWEB.Pages.Shared.GridforAssetViewModel
<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .selected-row {
        background-color: #d1e7dd !important; /* Light green background */
    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    /* Context Menu Styling */
    .dx-context-menu {
        border-radius: 8px !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2) !important;
        background: #fff !important;
        padding: 5px;
    }

    /* Menu Item Styling */
    .dx-menu-item {
        font-size: 14px !important;
        font-weight: 500 !important;
        color: #333 !important;
        padding: 8px 15px !important;
        border-radius: 5px !important;
        transition: background 0.3s ease-in-out;
    }

        /* Hover Effect */
        .dx-menu-item:hover {
          /*   background: #007bff !important; */
            color: white !important;
        }

        /* Icons */
        .dx-menu-item .dx-icon {
            font-size: 18px !important;
            margin-right: 8px;
            vertical-align: middle;
        }

    /* Add smooth animations */
    .dx-overlay-content {
        animation: fadeIn 0.2s ease-in-out;
    }

    .voucher-actions {
        list-style-type: none;
        padding: 0;
        margin: 0;
        background-color: #fff;
        border-radius: 5px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .voucher-actions .menu-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 14px;
            color: #333;
            border-bottom: 1px solid #f0f0f0;
        }

            .voucher-actions .menu-item:hover {
                background-color: #f0f0f0;
            }

            .voucher-actions .menu-item:last-child {
                border-bottom: none;
            }


    .dx-icon {
        font-size: 16px;
        margin-right: 10px;
    }


    .dx-checkbox {
        margin: 10px;
    }
    
    .menu-item .dx-icon-edit {
        color: #007bff;
    }

    .menu-item .dx-icon-find {
        color: #28a745;
    }

    .menu-item .dx-icon-check {
        color: #ffc107;
    }

    .menu-item .dx-icon-trash {
        color: #dc3545;
    }

    .menu-item .dx-icon-selectall {
        color: #17a2b8;
    }

    .menu-item .dx-icon-todo {
        color: #6c757d;
    }

    .menu-item .dx-icon-unlock {
        color: #6610f2;
    }


    .menu-item:hover i {
        opacity: 0.8;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

</style>
<div class="title">
    <div class="header-container">
        <div id="VoucherApproval" class="no-border-input"></div>
    </div>
</div>
    <div>
        @await Html.PartialAsync("GridFooterApproval")
    </div>



        <div class="dx-fieldset" style="display: flex; gap: 20px; margin-bottom: 20px; align-items: center;">
            <div>
                @(Html.DevExtreme().DateBox()
                    .Label(new JS("formatMessage('Voucher Date')"))
                    .ID("VoucherDate")
                    .InputAttr("aria-label", "Voucher Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)))
            </div>
            <div>
                @(Html.DevExtreme().DateBox()
                    .Label(new JS("formatMessage('Effective Date')"))
                    .ID("EffectiveDate")
                    .InputAttr("aria-label", "Effective Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(DateTime.Now))
            </div>


            <div style="margin-top:25px;">

                @(Html.DevExtreme().DropDownButton()
                    .ID("ddBtnShowRecords")
                    .Text(new JS("formatMessage('Show Records')"))
                    .Icon("smalliconslayout")
                    .Width(180)

                    .TabIndex(4)
                    .DropDownOptions(options => options.Width(230))
                    .Items(items =>
                    {
                        items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                        items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                        items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                        items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                        items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                        items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                        items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                        items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                        items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                        items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                    })
                    )
            </div>

        </div>


<div class="dx-field ledgerResult">
    @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry20136VoucherMasterList>()
