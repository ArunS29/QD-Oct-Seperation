        function ddBtnShowRecords_click(filterType) {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");

            const today = new Date();
            let startDate = null, endDate = null;

            // Define date ranges based on filterType
            switch (filterType) {
                case 'today':
                    startDate = new Date(today.setHours(0, 0, 0, 0));
                    endDate = new Date(today.setHours(23, 59, 59, 999));
                    break;

                case 'yesterday':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - 1);
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'week':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - today.getDay());
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setDate(startDate.getDate() + 6);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'tillmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'tillyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today.getFullYear(), 11, 31);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'lastmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'lastyear':
                    startDate = new Date(today.getFullYear() - 1, 0, 1);
                    endDate = new Date(today.getFullYear() - 1, 11, 31);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                default:
                    // Reset DataGrid data source
                    dataGrid.option("dataSource", {
                        load: function () {
                            return $.ajax({
                                url: "/api/VoucherApproval/GetVoucherApprovals",
                                type: "GET"
                            });
                        }
                    });
                    dataGrid.refresh();
                    return;
            }

            if (startDate && endDate) {
                // Update DateBox controls
                $("#VoucherDate").dxDateBox("instance").option("value", startDate);
                $("#EffectiveDate").dxDateBox("instance").option("value", endDate);

                // Update the DataGrid with the filtered data
                dataGrid.option("dataSource", {
                    load: function () {
                        return $.ajax({
                            url: "/api/VoucherApproval/GetVoucherApprovals",
                            data: {
                                startDate: startDate.toISOString(),
                                endDate: endDate.toISOString()
                            },
                            type: "GET"
                        });
                    }
                });

                // Refresh the grid
                dataGrid.refresh();
            }
        }
    $(function () {
        var selectedVoucherNo = null;
        var selectedVoucherType = null;

        $("#voucherContextMenu").dxContextMenu({
            dataSource: [
                { text: formatMessage("Edit Voucher"), icon: "edit", action: editVoucher },
                { text: formatMessage("View Voucher"), icon: "find", action: viewVoucher },
                { text: formatMessage("Verify Voucher"), icon: "check", action: verifyVoucher },
                { text: formatMessage("Delete Voucher"), icon: "trash", action: deleteVoucher },
                { text: formatMessage("Verify All Selected Vouchers"), icon: "selectall", action: verifyAll },
                { text: formatMessage("Approve All Selected Vouchers"), icon: "todo", action: approveAll },
                { text: formatMessage("Unlock the Voucher"), icon: "unlock", action: unlockVoucher }
            ],
            target: "#dataGrid",
            showEvent: "dxcontextmenu",
            width: 250,
            onItemClick: function (e) {
                if (e.itemData.action) {
                    e.itemData.action();
                }
            }
        });

        // Capture row right-click event
        $(document).on("contextmenu", ".dx-row", function (e) {
            e.preventDefault();
            let dataGrid = $("#dataGrid").dxDataGrid("instance");
            let rowIndex = $(this).index();
            let rowData = dataGrid.getVisibleRows()[rowIndex]?.data;

            if (rowData && rowData.VoucherNo && rowData.VoucherType) {
                selectedVoucherNo = rowData.VoucherNo;
                selectedVoucherType = rowData.VoucherType;
                console.log("Selected VoucherNo:", selectedVoucherNo, "Selected VoucherType:", selectedVoucherType);

                $("#voucherContextMenu").dxContextMenu("instance").show();
            } else {
                console.log("Voucher data is missing.");
            }
        });

        // Hide context menu when clicking outside
        document.addEventListener("click", function (event) {
            const contextMenu = $("#voucherContextMenu").dxContextMenu("instance");
            if (!$(event.target).closest("#voucherContextMenu, .dx-row").length) {
                contextMenu.hide();
            }
        });

        function editVoucher() {
            console.log("Edit Voucher Clicked");
            if (selectedVoucherNo && selectedVoucherType) {
                navigateToVoucherPage(selectedVoucherNo, selectedVoucherType);
            } else {
                alert("No voucher selected.");
            }
        }

        function viewVoucher() { console.log("View Voucher Clicked"); }
        function verifyVoucher() { console.log("Verify Voucher Clicked"); }
        function deleteVoucher() { console.log("Delete Voucher Clicked"); }
        function verifyAll() { console.log("Verify All Selected Vouchers Clicked"); }
        function approveAll() { console.log("Approve All Selected Vouchers Clicked"); }
        function unlockVoucher() { console.log("Unlock Voucher Clicked"); }

        function navigateToVoucherPage(voucherNo, voucherType) {
            console.log("Original VoucherNo:", voucherNo, "VoucherType:", voucherType);
            if (!voucherNo || !voucherType) {
                alert("Invalid voucher details.");
                return;
            }

            let formattedVoucher = voucherNo.trim().toUpperCase();
            let formattedVoucherType = voucherType.trim();

            const voucherRoutes = {
                "Bank Payment": `/${tenantName}/finance/VoucherBankPayment`,
                "Cash Payment": `/${tenantName}/finance/VoucherCashPayment`,
                "Bank Receipts": `/${tenantName}/finance/VoucherEntryReceipts`,
                "Cash Receipts": `/${tenantName}/finance/VoucherEntryCashReceipts`,
                "Sales": `/${tenantName}/finance/SalesVoucher`,
                "Purchases": `/${tenantName}/finance/PurchaseVoucher`,
                "Journal": `/${tenantName}/finance/Voucherjournal`
            };

            let baseUrl = voucherRoutes[formattedVoucherType];

            if (baseUrl) {
                let targetUrl = `${baseUrl}?argsledno=${encodeURIComponent(formattedVoucher)}&vouchertype=${encodeURIComponent(formattedVoucherType)}`;
                console.log("Navigating to:", targetUrl);
                window.location.href = targetUrl;
            } else {
                alert("Unknown voucher type: " + voucherType);
            }
        }
    });
       function toggleRowSelection(checkbox) {
        var $row = $(checkbox).closest(".dx-row");
        if (checkbox.checked) {
            $row.addClass("selected-row");
        } else {
            $row.removeClass("selected-row");
        }
    }

    function onRowPrepared(e) {
        if (e.rowType === "data" && e.isSelected) {
            $(e.rowElement).addClass("selected-row");
        }
    }






    </script>
