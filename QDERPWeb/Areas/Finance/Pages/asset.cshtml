<script>

    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    $(document).ready(function () {

    });

    // Function for redirecting to Asset Category View
    function redirectToAssetCategoryView() {
        window.open('/Finance/AssetCategoryView', 'popupWindow', 'width=800,height=600,scrollbars=yes,resizable=yes');
    }

    // Function for redirecting to Asset Location
    function redirectToAssetLocationMaster() {
        window.open('/Finance/AssetLocation', 'popupWindow', 'width=800,height=600,scrollbars=yes,resizable=yes');
    }

</script>

