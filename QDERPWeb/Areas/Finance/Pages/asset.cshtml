                            dataSource: DevExpress.data.AspNet.createStore({
                                key: "AssetMaintenanceTypeId",
                                loadUrl: "/api/AssetView/GetEditMaintenance"
                            }),
                            selectionMode: "single",
                            selectedItemKeys: [e.component.option("value")],
                            onItemClick: function (args) {
                                e.component.option("value", args.itemData.AssetMaintenanceTypeId);
                                e.component.close();
                            },
                            keyExpr: "AssetMaintenanceTypeId",
                            displayExpr: "AssetMaintenanceType"
                        }).appendTo(container);
                }
            };
        }
    }

    function onRowUpdated(e) {
        debugger;
        const merged = Object.assign({}, e.oldData, e.newData);
        e.cancel = true;

        $.ajax({
            url: "/api/AssetView/UpdateMaintenanceType",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(merged)
        }).done(() => {
            DevExpress.ui.notify("Updated", "success", 2000);
            $("#maintenanceGrid").dxDataGrid("instance").refresh();
        });
    }

        function onCurrencySelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const dropDown = $("#ddCurrency").dxDropDownBox("instance");

        if (selectedKey) {
             dropDown.option("value", selectedKey); // Set DropDownBox value

        const selectedRow = e.selectedRowsData[0];

        // ✅ Set ExchangeRate in NumberBox
        if (selectedRow && selectedRow.ExchangeRate !== undefined) {
            $("#txtCurrencyRate").dxNumberBox("instance").option("value", selectedRow.ExchangeRate);
        }
            if (dropDown.option("opened")) {
                dropDown.close();
            }

            
                console.log("Selected Currency:", selectedRow.CurrencyExchangeId);
        } else {
            DevExpress.ui.notify("Please select a currency", "warning", 2000);
        }
    }

     function onBaseCurrencyInit(e) {
            const dropDown = e.component;

            // Delay to ensure dataSource is ready
            setTimeout(() => {
                const ds = dropDown.getDataSource();
                if (!ds) return;

                // Skip if already has value
                if (dropDown.option("value")) return;

                ds.load().done(items => {
                    if (items && items.length > 0) {
                        dropDown.option("value", items[0].CurrencyExchangeId);
                    }
                });
            }, 200); // 100ms is usually enough
        }


           function onBaseCurrencySelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const dropDown = $("#ddlBaseCurrency").dxDropDownBox("instance");

        if (selectedKey) {
            dropDown.option("value", selectedKey); // This should bind the selected CurrencyID to the DropDownBox
            if (dropDown.option("opened")) {
                dropDown.close();
            }

            const selectedRow = e.selectedRowsData[0];
            console.log("Selected Currency:", selectedRow.CurrencyName);
        } else {
            DevExpress.ui.notify("Please select a currency", "warning", 2000);
        }
    }
</script>
