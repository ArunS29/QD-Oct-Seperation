                    item.Add().Title("Depreciation").Text("Depreciation").Template(@<text>


            <div class="form-container">
                @*    <h2>@ViewData["Title"]</h2> *@

                <!-- Card 1: General Account Group Information -->
                <div class="form-row" style="display: flex; align-items: flex-end; gap: 10px; width: 100%;">


                    <div class="form-group">
                        <label for="VoucherType">Depreciation Method:</label>
                        @(
                        Html.DevExtreme().SelectBox()
                        .ID("txtDepreciationMethod")
                        .DataSource(new[] { "Straight Line Method" })
                        .Value("Straight Line Method")
                        .Width(520)
                        .Disabled(false)

                        )
                    </div>

                    <!-- Scarp Value -->
                    <div class="form-group">
                        <label for="AmountinSAR" class="button-alignment-down">Scarp Value</label>
                        @(Html.DevExtreme().NumberBox()
                        .ID("txtScarpValue")
                        .Width(150)
                        .Value(0)
                        .ShowSpinButtons(true)
                        @*  // .Min(0).Max(1000) *@
                        .Step(1))
                    </div>

                    <!-- Life in years -->
                    <div class="form-group">
                        <label for="AmountinSAR" class="button-alignment-down">Life in years</label>
                        @(Html.DevExtreme().NumberBox()
                        .ID("txtLifeinyears")
                        .Width(100)
                        .Value(0)
                        .ShowSpinButtons(true)
                        .Min(0)
                        .Max(1000)
                        .Step(1))
                    </div>

                    <!-- Dep.Percentage -->
                    <div class="form-group">
                        <label for="AmountinSAR" class="button-alignment-down">Dep.Percentage(%)</label>
                        @(Html.DevExtreme().NumberBox()
                        .ID("txtDepPercentage")
                        .Width(100)
                        .Value(0.0)
                        .ShowSpinButtons(true)
                        .Min(0.0)
                        // .Max(100)
                        .Step(0.1)

                        )
                    </div>


                    <!-- Schedule Button -->
                    <div class="form-group" style="margin-left: auto;">
                        @(Html.DevExtreme().Button()
                        .ID("btnAttach")
                        .Text("Schedule")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Outlined)
                        .Icon("save")
                        .OnClick("function() { exportDataGridToPDF('dataGrid'); }")
                        )
                    </div>
                </div>



                    <div class="dx-field ledgerResult" style="padding:10px;">

                        @(
                        Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201206depreciationChild>()
                        .ID("dataGrid")
                        .RemoteOperations(false)
                        .Columns(columns =>
                        {
                    columns.AddFor(m => m.DepreciationDocNo).Caption("Depreciation Doc No").Visible(true);
                    columns.AddFor(m => m.DeprStartDate).Caption("Depr Start Date").Visible(true);
                        columns.AddFor(m => m.DeprEndDate).Caption("Depr End Date").Visible(true);
                    columns.AddFor(m => m.OpeningBalance).Caption("Opening Balance").Visible(true);
                        columns.AddFor(m => m.DebitTransaction).Caption("Debit Transaction").Visible(true);
                        columns.AddFor(m => m.CreditTransaction).Caption("Credit Transaction").Visible(true);
                        columns.AddFor(m => m.ClosingBalance).Caption("Closing Balance").Visible(true);
                        columns.AddFor(m => m.DepreciatedPercentage).Caption("Depreciated Percentage").Visible(true);
                    columns.AddFor(m => m.DepreciationAmount).Caption("Depreciation Amount").Visible(true);
                        columns.AddFor(m => m.AccumulatedAdjusted).Caption("Accumulated Adjusted").Visible(true);
                    columns.AddFor(m => m.BookValueAsOnDate).Caption("Book Value As On Date").Visible(true);
                        })
                        .AllowColumnReordering(true) // Enable column reordering
                        .AllowColumnResizing(true)   // Enable column resizing
                        .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                        .HeaderFilter(filter => filter.Visible(true))
                        .Height(250)
                        .ColumnAutoWidth(true)
                        .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                        .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                        .ShowBorders(true)
                        .Width("100%")
                        .Summary(summary => summary
                        .TotalItems(items =>
                        {
                        items.Add()  // Summary for Opening Balance
                        .Column("OpeningBalance")
                        .SummaryType(SummaryType.Sum)
                        .DisplayFormat("Total: {0}");

                        items.Add()  // Summary for Debit Transaction
                        .Column("DebitTransaction")
                        .SummaryType(SummaryType.Sum)
                        .DisplayFormat("Total: {0}");

                        items.Add()  // Summary for Credit Transaction
                        .Column("CreditTransaction")
                        .SummaryType(SummaryType.Sum)
                        .DisplayFormat("Total: {0}");

                        items.Add()  // Summary for Closing Balance
                        .Column("ClosingBalance")
                        .SummaryType(SummaryType.Sum)
                        .DisplayFormat("Total: {0}");

                        items.Add()  // Summary for Depreciation Amount
                        .Column("DepreciationAmount")
                        .SummaryType(SummaryType.Sum)
                        .DisplayFormat("Total: {0}");
                        })
                        )
                        )
                    </div>
                </div>





        </text>);


