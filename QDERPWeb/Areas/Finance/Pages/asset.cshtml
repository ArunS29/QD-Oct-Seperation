@page
@model QD.ERP.Web.Areas.Finance.Pages.assetModel
@using DevExtreme.AspNet.Mvc
@{
    ViewData["Title"] = "Asset View";
    ViewContext.RouteData.Values["area"] = "Finance";
}



<style>
    .dx-button{
        background-color:none!important;
    }
    /* Ensure tab text is styled properly */
    .dx-tabpanel .dx-tab {
        color: black !important; /* Set the tab text color to black */
        font-size: 14px; /* Adjust font size for better visibility */
        padding: 10px 15px; /* Increase padding for better appearance */
    }

        /* Optional: Adjust the selected tab styling */
        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue; /* Highlight selected tab with a background */
            color: white !important; /* Set selected tab text color */
        }

   
    .dx-tabpanel {
        /*  border: 2px solid gray;  Set the border color to gray */
        /* border-radius: 5px;  Optionally, add rounded corners to the border */
    }
                   
    .dx-textarea{
             padding-top: 0px !important;
    }


    .form-container1 {
        width:100%;

        padding: 5px; /* Optional: Add some padding inside the border */
        border-radius: 1px; /* Optional: Rounded corners */
    }

    .form-container {
        width: 100%;
        border-radius: 1px; /* Optional: Rounded corners */
    }
    .form-row {
        display: flex;
        gap: 10px;
        padding: 0px 10px;
        width:100%;
    }

    
    .form-label {
        color: var(--title-background-color);
        padding: 5px;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
    }   
    label{
        font-weight:700;
    }
    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
        /*  background-color: white; */
    }

    .dx-selectbox {
        width: 100%;
    }

    .dx-texteditor-input{
        border:1px solid #ddd;
    }
    .footer-buttons .row {
        margin-top: 20px; /* Add some space between the form and footer */
    }

    .footer-buttons .col-md-1 {
        /*  padding-left: 10px;
                                padding-right: 10px; */
    }

    /* Adds border to form control elements */
    .form-control-with-border {
        /* border: 1px solid gray; */
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }

    .form-inline-row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-start;
    }

    .form-inline-group {
        display: flex;
        flex-direction: column;
        min-width: 200px;
    }

        .form-inline-group label {
            font-weight: 600;
            margin-bottom: 5px;
        }

    .form-inline-location {
        display: flex;
        gap: 5px;
        align-items: center;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 5px;
    }
    .button-group{
        align-items: center;
        justify-content: center;
        padding: 8px;
    }
    /* Optional: Adds a border to the form-row as a whole */
    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }
    
    .mainContainer{
        width:100%;
        overflow-x: hidden;
    }
    .titleCard-toggle1 {
        display: none;
    }

    .outline-container{
        color: var(--title-background-color);
        padding: 10px;
    }
    .dx-texteditor-input {
    border: 0px !important; 
}
.footer-fixed {
bottom: -13px !important;
}

</style>

<div class="dx-card-header minimal-header">
    <div class="card-title-icon">
        <i class="fas fa-file-invoice-dollar"></i>
    </div>
    <h3 class="card-title-text">Asset Register</h3>
</div>
<div class="form-container1">

    <div class="outline-container">

        <!-- 🔹 First Row -->
        <div class="form-inline-row">

            <!-- Asset Ledger No -->
            <div class="form-inline-group">
                @(Html.DevExtreme().TextBox()
                    .ID("txtacctledno")
                    .Value("")
                    .Label(new JS("formatMessage('Asset Ledger No')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ReadOnly(true)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired().Message("Asset Ledger No is required");
                    })
                    )
            </div>

            <!-- Asset Category + Button -->
            <div class="form-inline-group" style="min-width: 200px;">
                <div class="form-inline-location">
                    @(Html.DevExtreme().SelectBox()
                        .ID("ddassetCategory")
                        .ValueExpr("AssetCategoryCode")
                        .DisplayExpr("AssetCategory")
                         .Label(new JS("formatMessage('Asset Category')"))
                         .LabelMode(EditorLabelMode.Floating)
                        .Placeholder("🔍 Select Asset Category")
                        .InputAttr("aria-label", "Owner")
                        .DataSource(d => d.WebApi()
                        .Controller("assetview")
                        .LoadAction("GetAssetCategoriesByCode")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AssetCategory"))
                        .SearchEnabled(true)
                        .ShowClearButton(true)
                        .TabIndex(1)
                        .Width(200)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired().Message("Asset Category is required");
                        })
                         .Buttons(buttons =>
                        {
                        buttons.Add()
                        .Name("btnAddAccount")
                        .Location(TextEditorButtonLocation.After)
                        .Widget(w => w.Button()
                        .Type(ButtonType.Default)
                        .Icon("plus")
                        .ElementAttr(new { @class = "custom-hover-button add-hover" })
                        .OnClick("redirectToAssetCategoryView"));
                        buttons.Add()
                        .Name("dropDown");
                            }))
                </div>
            </div>

            <!-- Purchased Asset Value -->
            <div class="form-inline-group" style="min-width: 300px;">
                @(Html.DevExtreme().NumberBox()
                    .ID("PurchasedAssetValue")
                         .Label(new JS("formatMessage('Purchased Asset Value')"))
                         .LabelMode(EditorLabelMode.Floating)
                    .Value(0)
                    .Min(0)
                    .Max(1000000)
                    .ShowSpinButtons(true)
                    .Format("#,##0")
                    .Step(1)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired().Message("Purchased Value is required");
                    })
                    )
            </div>

            <!-- Plate No -->
            <div class="form-inline-group" style="min-width: 300px;">
                @(Html.DevExtreme().TextBox()
                     .Label(new JS("formatMessage('Plate No')"))
                         .LabelMode(EditorLabelMode.Floating)
                    .ID("txtplatno")
                    .Value("")
                    )
            </div>

            <!-- Property No (Modules) -->
            <div class="form-inline-group" style="min-width: 300px;">
                @(Html.DevExtreme().DropDownBox()
                    .DataSource(d => d.WebApi()
                    .Controller("assetview")
                    .LoadAction("GetPropertDetails")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("PropertyNo"))
                    .Label(new JS("formatMessage('Property No (Modules)')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ID("ddlpropertyno")
                    .ShowClearButton(true)
                    .AcceptCustomValue(true)
                    .OpenOnFieldClick(false)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .ValueExpr("PropertyNo")
                    .DisplayExpr("AccountHead")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .Width(300)
                    .TabIndex(1)
                    .DropDownOptions(o => o.Width(1000))
                    .ContentTemplate(new TemplateName("LedgerContentTemplate"))
                    )
            </div>
        </div>

        <!-- 🔹 Second Row -->
        <div class="form-inline-row" style="align-items:end;">

            <!-- Asset Description -->
            <div class="form-inline-group">
                @(Html.DevExtreme().TextBox()
                     .Label(new JS("formatMessage('Asset Description')"))
                         .LabelMode(EditorLabelMode.Floating)
                    .ID("txtAssetDescription")
                    .Width(200)
                    )
            </div>

            <!-- Asset Location -->
            <div class="form-inline-group">
                <label for="Assetlocation"></label>
                <div class="form-inline-location">
                    @(Html.DevExtreme().SelectBox()
                        .ID("ddlassetlocation")
                        .Label(new JS("formatMessage('Asset Location')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Placeholder("🔍 Select Asset Location")
                        .ValueExpr("AssetLocationCode")
                        .InputAttr("aria-label", "Owner")
                        .DisplayExpr("AssetLocation")
                        .DataSource(d => d.WebApi()
                        .Controller("Assetview")
                        .LoadAction("GetddlAssetlocation")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AssetLocation"))
                        .SearchEnabled(true)
                        .ShowClearButton(true)
                        .Width(200)
                        .TabIndex(1)
                        .Buttons(buttons =>
                        {
                        buttons.Add()
                        .Name("btnAddAccount1")
                        .Location(TextEditorButtonLocation.After)
                        .Widget(w => w.Button()
                        .Type(ButtonType.Default)
                        .Icon("plus")
                        .ElementAttr(new { @class = "custom-hover-button add-hover" })
                        .OnClick("redirectToAssetLocationMaster"));
                        buttons.Add()
                        .Name("dropDown");
                            }))
                        
                </div>
            </div>

            <!-- Asset Specification -->
            <div class="form-inline-group">
                @(Html.DevExtreme().TextArea()
                    .ID("txtspecifications")
                    .Label(new JS("formatMessage('Asset Specification')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .Width(300)
                    )

            </div>

            
                 @*  <div class="form-group col-md-2 col-sm-6"> *@
