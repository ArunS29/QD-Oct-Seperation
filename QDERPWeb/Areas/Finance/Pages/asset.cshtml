    function onContextMenuPreparing(e) {
    if (e.row && e.row.rowType === "data") {
        e.items = [{
            text: "Delete",
            icon: "trash",
            onItemClick: function () {
                DevExpress.ui.dialog.confirm(
                    "You are about to delete the Maintenance Schedule from the database.\nYou cannot revert the changes.\nAre you sure you want to Delete?",
                    "Confirm Delete"
                ).done(function (dialogResult) {
                    if (dialogResult) {
                        const MaintenanceRefNo = e.row.data.MaintenanceRefNo;
                        console.log("IDDD222:", e.row.data);
                        console.log("IDDD:",MaintenanceRefNo);
                        onDeleteMaintenanceSchedule(MaintenanceRefNo);
                    }
                });
            }
        }];
    }
}
function onDeleteMaintenanceSchedule(MaintenanceRefNo) {
    
       $.ajax({
            url: `/api/AssetView/DeleteMaintenanceSchedule?MaintenanceRefNo=${MaintenanceRefNo}`,
        type: "POST",
        success: function (res) {
            if (res.success) {
                DevExpress.ui.notify(res.message, "success", 3000);
                setTimeout(function () {
                    $("#maintenanceGrid").dxDataGrid("instance").refresh();
                }, 3000);
            } else {
                DevExpress.ui.notify(res.message || "Delete failed.", "error", 4000);
            }
        },
        error: function () {
            DevExpress.ui.notify("Unexpected error while deleting.", "error", 4000);
        }
    });
}

    function gridmaintenance_valueChanged(e) {
        var $dataGrid = $("#maintenanceGrid");

        if ($dataGrid.length) {
            var dataGrid = $dataGrid.dxDataGrid("instance");
            dataGrid.selectRows(e.value, false);
        }

        if (e.value) {
            let grid = $("#maintenanceGrid").dxDataGrid("instance");
            let rowIndex = e.element.closest("tr").index();
            let rowData = grid.getVisibleRows()[rowIndex].data;

            let costAllocationDropdownGrid = $("#accountDropDownBoxeditGrid").dxDataGrid("instance");
            let selectedRowData = costAllocationDropdownGrid.getSelectedRowsData()[0];

            if (selectedRowData) {
                rowData.MaintenanceTypeId = selectedRowData.AssetMaintenanceTypeId;
                rowData.MaintenanceType = selectedRowData.AssetMaintenanceType; // Update AccountHead
                grid.cellValue(rowIndex, "MaintenanceTypeId", selectedRowData.AssetMaintenanceTypeId);
                grid.cellValue(rowIndex, "MaintenanceType", selectedRowData.AssetMaintenanceType); // Reflect change
            }
        }

        e.component.option("opened", false);
    }

    function onEditorPreparing(e) {
        debugger;
        if (e.parentType === "dataRow" && e.dataField === "MaintenanceType") {
            e.editorType = "dxDropDownBox";
            e.editorOptions = {
                value: e.value,
                valueExpr: "AssetMaintenanceTypeId",
                displayExpr: "AssetMaintenanceType",
                dataSource: DevExpress.data.AspNet.createStore({
                    key: "AssetMaintenanceTypeId",
                    loadUrl: "/api/AssetView/GetEditMaintenance"
                }),
                contentTemplate: function (e, container) {
                    $("<div>")
                        .dxList({
                            dataSource: DevExpress.data.AspNet.createStore({
                                key: "AssetMaintenanceTypeId",
                                loadUrl: "/api/AssetView/GetEditMaintenance"
                            }),
                            selectionMode: "single",
                            selectedItemKeys: [e.component.option("value")],
                            onItemClick: function (args) {
                                e.component.option("value", args.itemData.AssetMaintenanceTypeId);
                                e.component.close();
                            },
                            keyExpr: "AssetMaintenanceTypeId",
                            displayExpr: "AssetMaintenanceType"
                        }).appendTo(container);
                }
            };
        }
    }

    function onRowUpdated(e) {
        debugger;
        const merged = Object.assign({}, e.oldData, e.newData);
        e.cancel = true;

        $.ajax({
            url: "/api/AssetView/UpdateMaintenanceType",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(merged)
        }).done(() => {
            DevExpress.ui.notify("Updated", "success", 2000);
            $("#maintenanceGrid").dxDataGrid("instance").refresh();
        });
    }
