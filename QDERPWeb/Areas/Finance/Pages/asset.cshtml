@page
@model QD.ERP.Web.Areas.Finance.Pages.assetModel
@using DevExtreme.AspNet.Mvc
@{
    ViewData["Title"] = "Asset View";
}



<style>

    /* Ensure tab text is styled properly */
    .dx-tabpanel .dx-tab {
        color: black !important; /* Set the tab text color to black */
        font-weight: bold; /* Optionally make the text bold */
        font-size: 14px; /* Adjust font size for better visibility */
        padding: 10px 15px; /* Increase padding for better appearance */
    }

        /* Optional: Adjust the selected tab styling */
        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue; /* Highlight selected tab with a background */
            color: white !important; /* Set selected tab text color */
        }

    /* Add a gray border around the tab panel */
    .dx-tabpanel {
        /*  border: 2px solid gray;  Set the border color to gray */
        /* border-radius: 5px;  Optionally, add rounded corners to the border */
    }




    .form-container {
        margin: 15px;
        background-color: white;
        border: 1px solid black; /* Add a black border */
        padding: 5px; /* Optional: Add some padding inside the border */
        border-radius: 1px; /* Optional: Rounded corners */
    }

    .form-row {
        display: flex;
        gap: 1px;
        margin-bottom: 15px;
    }

    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
    }

    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
        /*  background-color: white; */
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px; /* Add some space between the form and footer */
    }

    .footer-buttons .col-md-1 {
        /*  padding-left: 10px;
                                padding-right: 10px; */
    }

    /* Adds border to form control elements */
    .form-control-with-border {
        border: 1px solid gray;
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }

    /* Optional: Adds a border to the form-row as a whole */
    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

</style>

<div class="form-container">
    <h2>Asset Register </h2>

    <div class="col-md-12">
        <div class="outline-container p-3" style="outline: 2px solid gray; border-radius: 8px;">

            <div class="row">

                <!-- Asset Ledger No Field -->
                <div class="col-md-2">
                    <div class="form-label">
                        <label for="AssetLedgerNo">Asset Ledger No</label>
                    </div>
                    @(Html.DevExtreme().TextBox().ID("txtacctledno").Value("").ReadOnly(true))
                </div>



                <!-- Asset Category Dropdown -->
                <div class="col-md-2 ">
                    <div class="form-label">
                        <label for="AssetCategory">Asset Category</label>
                    </div>
                    <div class="form-group-row">
                        @(Html.DevExtreme().SelectBox().ID("ddassetCategory")
                            .LabelMode(EditorLabelMode.Outside).ValueExpr("AssetCategoryCode")
                            .InputAttr("aria-label", "Owner")
                            .DisplayExpr("AssetCategory")
                            .DataSource(d => d.WebApi().Controller("assetview")
                            .LoadAction("GetAssetCategoriesByCode")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("AssetCategory")).SearchEnabled(true).ShowClearButton(true).TabIndex(1)

                            )
                        @(Html.DevExtreme().Button().ID("btnAddAccount").Icon("plus").ElementAttr("class", "button-alignment-down button-group").OnClick("redirectToAssetCategoryView"))
                    </div>
                </div>

                <!-- Add this CSS to ensure the button and dropdown are on the same row -->
                <style>
                    .form-group-row {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                    }

                        .form-group-row .dx-selectbox, .form-group-row .dx-button {
                            margin-right: 10px; /* Space between dropdown and button */
                        }
                </style>


                <!-- Purchased Asset Value Field -->
                <div class="col-md-2">
                    <div class="form-label">
                        <label for="PurchasedAssetValue" style="width: 100%; display: block;">Purchased Asset Value</label>
                    </div>
                    @(
                        Html.DevExtreme().NumberBox()
                        .ID("PurchasedAssetValue")
                        .Value(0)
                        .Min(0)
                        .Max(1000000)
                        .ShowSpinButtons(true)
                        .Format("#,##0")
                        .Step(1)
                        .Width("100%")

                        )
                </div>



                <!-- Plate No Field -->
                <div class="col-md-2">
                    <div class="form-label">
                        <label for="PlateNo">Plate No</label>
                    </div>
                    @(
                        Html.DevExtreme().TextBox()
                        .ID("txtplatno")
                        .Value("")
                        )
                </div>

                <!-- Property No (Property Modules) Dropdown -->
                <div class="col-md-4">
                    <div class="form-label">
                        <label for="PropertyNo">Property No(Modules)</label>
                    </div>
                    @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi()
                        .Controller("assetview")
                        .LoadAction("GetPropertDetails")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("PropertyNo")
                        )
                        .LabelMode(EditorLabelMode.Outside)
                        // .Label("Select a Ledger Account")
                        .ID("ddlpropertyno")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("PropertyNo")
                        .DisplayExpr("AccountHead")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .Width(300)
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        .Width(1000) // Set the desired width for the dropdown content
                        )
                        .OnKeyDown("onKeyDown")
                        // .OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("LedgerContentTemplate"))
                        )

                </div>

            </div>


            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <!-- Asset Description Field -->
                            <div class="col-md-12">
                                <div class="form-label">
                                    <label for="AssetDescription">Asset Description</label>
                                </div>
                                @(
                                    Html.DevExtreme().TextBox()
                                    .ID("txtAssetDescription")
                                    // .Value("")
                                    )
                            </div>


                            <div class="col-md-12">
                                <div class="form-label">
                                    <label for="Assetlocation">Asset Location</label>
                                </div>
                                <div class="row align-items-center">
                                    <div class="col-md-11" style="padding-right:0px">
                                        @(Html.DevExtreme().SelectBox()
                                            .ID("ddlassetlocation")
                                            .LabelMode(EditorLabelMode.Outside)
                                            .ValueExpr("AssetLocationCode")
                                            .InputAttr("aria-label", "Owner")
                                            .DisplayExpr("AssetLocation")
                                            .DataSource(d => d.WebApi()
                                            .Controller("Assetview")
                                            .LoadAction("GetddlAssetlocation")
                                            .LoadMode(DataSourceLoadMode.Raw)
                                            .Key("AssetLocation")
                                            )
                                            .SearchEnabled(true)
                                            .ShowClearButton(true)
                                            .TabIndex(1)
                                            )
                                    </div>
                                    <div class="col-md-1">
                                        @(Html.DevExtreme().Button()
                                            .ID("btnAddAccount1")
                                            .Icon("plus")
                                            .ElementAttr("class", "button-alignment-down button-group")
                                            .OnClick("redirectToAssetLocationMaster") // Corrected JavaScript function for Asset Location
                                            )
                                    </div>
                                </div>
                            </div>


                        </div>


                    </div>

                    <div class="col-md-6">
                        <!-- Asset Specification Field -->
                        <div class="col-md-12">
                            <div class="form-label">
                                <label for="AssetSpecification">Asset Specification</label>
                            </div>
                            @(
                                Html.DevExtreme().TextArea().Height(120)
                                .ID("txtspecifications")
                                //.Value("")
                                .InputAttr("style", "overflow-y: auto; resize: none;")
                                )
                        </div>


                    </div>

                </div>
            </div>




            <div class="row">
            </div>
        </div>
    </div>


    <div class="form-container">

        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("AssetTabs")
                .Items(item =>
                {
                    item.Add()
                .Title("Asset Details")
                .Text("Asset Details")
                .Template(@<text>


            <div class="form-container">
