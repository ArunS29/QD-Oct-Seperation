                    item.Add().Text("Maintenance").Title("Maintenance").Template(@<text>

            <div class="cards-container">

                <div class="form-row" style="display: flex; align-items: flex-end; gap: 10px; width: 100%;">
                    <!-- Depreciation Method -->
                    <div class="form-group">

                        <label for="" class="button-alignment-down">Latest Meter Reading:</label>
                        @(Html.DevExtreme().NumberBox()
                        .ID("txtMaintenanceScarpValue")
                        .Width(350)
                        .Value(0)
                        .ShowSpinButtons(true)
                        .Min(0)//                        .Max(1000)
                        .Step(1))
                    </div>
                    <div class="form-group">
                        <label for="maintenanceTypes" class="button-alignment-down">Select Maintenance Type:</label>
                        @(Html.DevExtreme().SelectBox()
                        .ID("ddlMaintenanceTypes")
                        .LabelMode(EditorLabelMode.Outside)
                        .ValueExpr("AssetMaintenanceTypeId")
                        .DisplayExpr("AssetMaintenanceType")
                        .DataSource(d => d.WebApi()
                        .Controller("assetview")
                        .LoadAction("GetddlAssetMaintanence")
                        .LoadMode(DataSourceLoadMode.Raw)

                        )
                        .SearchEnabled(true)
                        .ShowClearButton(true)
                        .Placeholder("Select Maintenance Type")
                        .Width(400)
                        )
                    </div>


                    <div class="form-group" style="display: flex; justify-content: flex-end; width: 350%;">
                        @(Html.DevExtreme().Button()
                        .ID("btnMaintenance")
                        .Text("Add Maintenance Types")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Outlined)
                        .Icon("save")
                        .OnClick("redirectassetmaintanence")
                        )
                    </div>

                    <!-- Add Scheduled Types Button -->
                    <div class="form-group">
