<script type="text/html" id="deleteTemplate">
    <a href="javascript:void(0);" onclick="deleteRow(this)">Delete</a>
</script>
<script>
    $(document).ready(function () {
        // Extract assetLedgerNo from the URL
        const urlParams = new URLSearchParams(window.location.search);
        const assetLedgerNo = urlParams.get("assetLedgerNo");  // Get assetLedgerNo from the URL query string

        if (assetLedgerNo) {
            fetchAssetData(assetLedgerNo);  // Call the function to fetch data
        }
    });

    function deleteRow(element) {
        var grid = $("#MaintenanceGrid").dxDataGrid("instance");
        var rowIndex = $(element).closest("tr").index();
        var dataSource = grid.option("dataSource");
        dataSource.splice(rowIndex, 1);
        grid.option("dataSource", dataSource);
        grid.refresh();
    }

    function addScheduledTypeRow() {
        // Get the dxNumberBox and dxSelectBox instances
        var readingBox = $("#txtMaintenanceReading").dxNumberBox("instance");
        var typeBox = $("#ddlMaintenanceTypes").dxSelectBox("instance");

        // Validate instances
        if (!readingBox || !typeBox) {
            console.error("dxNumberBox or dxSelectBox not initialized properly.");
            return;
        }

        // Get values
        var maintenanceReading = readingBox.option("value");
        var maintenanceType = typeBox.option("text");

        // Validate inputs
        if (!maintenanceType || maintenanceReading === null) {
            alert("Please select a maintenance type and enter a valid reading.");
            return;
        }

        // Prepare data
        var today = new Date();
        var formattedDate = today.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric",
        });

        // Add row to grid
        var grid = $("#MaintenanceGrid").dxDataGrid("instance");
        var dataSource = grid.option("dataSource") || [];
        dataSource.push({
            MaintenanceType: maintenanceType,
            MaintenanceReading: maintenanceReading,
            ScheduledOn: formattedDate,
            ReminderDate: formattedDate,
            MaintenanceDone: false,
            Remarks: "",
        });

        // Update grid
        grid.option("dataSource", dataSource);
        grid.refresh();
    }



    function fetchAssetData(assetLedgerNo) {

        $.ajax({
            url: "/api/assetview/GetAssetViewedit",
            type: "GET",
            data: { assetLedgerNo: assetLedgerNo },
            success: function (data) {
                console.log("Data received from API:", data);
                if (data && data.length > 0) {
                    populateFields(data[0]);
                } else {
                    console.warn("No data found for the given AssetLedgerNo.");
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching asset data:", error);
            }
        });
    }
    function DeleteAsset(e) {
        const assetLedgerNo = $("#txtacctledno").dxTextBox("instance").option("value");
      //  alert(assetLedgerNo);
        if (!assetLedgerNo) {
            DevExpress.ui.notify("Please provide an Asset Ledger No.", "error", 2000);
            return;
        }

        DevExpress.ui.dialog.confirm("Are you sure you want to delete this asset?", "Confirm Deletion").done(function (dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: "/api/assetview/DeleteAsset", // Replace with your controller's route
                    type: "POST",
                    data: { assetLedgerNo: assetLedgerNo },
                    success: function (response) {
                        DevExpress.ui.notify(response, "success", 2000);
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify(xhr.responseText || "An error occurred.", "error", 2000);
                    }
                });
            }
        });
    }



