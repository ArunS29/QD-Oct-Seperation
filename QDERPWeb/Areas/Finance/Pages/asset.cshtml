                dropDownBoxInstance.option("value", selectedRow.PropertyNo); // Set selected value
            }

            var brandTextBox = $("#txtBrand").dxTextBox("instance");
            if (brandTextBox) {
                brandTextBox.option("value", selectedRow.Brand || ""); // Set the value or empty if null
            }
            var ModelBox = $("#txtModel").dxTextBox("instance");
