                    <div class="col-md-3">
                        <div class="form-label">
                            <label for="PurchasedDate">Purchased Date</label>
                        </div>
                        @(Html.DevExtreme().DateBox().ID("txtPurchasedDate").DisplayFormat("dd-MMM-yyyy").Value("") )
                    </div>

                    <div class="col-md-3">
                        <div class="form-label">
                            <label for="PurchasedFrom">Purchased From</label>
