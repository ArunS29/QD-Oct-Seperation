        const newRow = {
            AssetLedgerNo: ledgerNo,
            MaintenanceTypeId: 1,
            MaintenanceReading: maintenanceReading,
            MaintenanceDate: new Date().toISOString(),
            ReminderDate: new Date().toISOString(),
            IsMaintenanceDone: false,
            ActualMaintenanceDoneOn: null
        };

        $.ajax({
            url: "/api/AssetView/AddMaintenanceType",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(newRow),
            success: function () {
                DevExpress.ui.notify("Scheduled Maintenance Added", "success", 2000);
                $("#maintenanceGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to add Scheduled Maintenance", "error", 3000);
            }
        });
    }


