                    },

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": paymentaccheadId,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr === "Cr" ? "Dr" : "Cr",

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

                        "SysRemarks": sysRemarks2

                    }

                ];

            }

            else {

                // Add only the first entry if "Petty Cash - Shabbir" exists

                VE = [

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": accountHead,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr,

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

                        "SysRemarks": sysRemarks1

                    }

                ];

            }

            // Perform the AJAX request

            $.ajax({

                type: "POST",

                url: `/api/VoucherEntryReceipts/AddVoucherEntry?AccountHead=${encodeURIComponent(sysRemarks2)}&PaymentAccoutHeadName=${encodeURIComponent(paymentaccheadname)}&Gridcount=${encodeURIComponent(griddatacount)}`,

                contentType: "application/json",

                data: JSON.stringify(VE),

                dataType: "json",

                success: function (response) {

                    $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

                    $("#Narration").dxTextArea("instance").option("value", "");
                    var accountHeadValidator = $("#AccountHeadDropDown").dxValidator("instance");
                    accountHeadValidator.reset();
                    var voucherAmtValidator = $("#Amount").dxValidator("instance");
                    voucherAmtValidator.reset();



                    if (accheadname && accheadname.startsWith("Cost")) {
                        // alert("VoucherNo: " + voucherNo);
                        // alert("AccountHead: " + accheadname);
                        // alert("VoucherAmount: " + amount);
                        // alert("DrCr: " + sbDrCr);
                        // alert("EffectiveDate: " + effectiveDate);

                        const params = {
                            VoucherNo: encodeURIComponent(voucherNo),
                            AccountHead: encodeURIComponent(accheadname),
                            VoucherAmount: encodeURIComponent(amount),
                            DrCr: encodeURIComponent(sbDrCr),
                            EffectiveDate: encodeURIComponent(effectiveDate),
                            VoucherEntryID: encodeURIComponent(vouentryid)
                        };

                        const queryString = Object.keys(params)
