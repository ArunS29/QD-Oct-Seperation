                        "VoucherNo": voucherNo,

                        "AccountHead": paymentaccheadId,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr === "Cr" ? "Dr" : "Cr",

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

                        "SysRemarks": sysRemarks2

                    }

                ];

            }

            else if (paymentaccheadname != "Riyadh Bank") {

                // Add only the first entry if "Petty Cash - Shabbir" exists

                VE = [

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": accountHead,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr,

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

