@page
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Data
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Routing
@model QD.ERP.Web.Areas.Finance.Pages.VoucherEntryCashReceiptsModel
@{
    ViewData["Title"] = "Receipt Voucher Details";

}




<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }
    /* Target the header row to set the background color */
    .aliceblue-header .dx-datagrid-headers {
        background-color: aliceblue !important;
    }

    /* Optional: Ensure header text doesn't conflict with the background */
    .aliceblue-header .dx-header-row .dx-datagrid-text-content {
        color: #333; /* Make sure text is readable */
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .button-alignment-down {
        margin-bottom: 10px
    }

    .content-container {
        border-radius: 10px;
        padding: 5px;
        background-color: white;
    }
    /* Style for edit button */
    .dx-command-edit .dx-icon-edit {
        color: green; /* Green color for edit */
    }

    /* Style for delete button */
    .dx-command-edit .dx-icon-trash {
        color: red; /* Red color for delete */
    }


    #CostAllocationModal .modal-dialog.fullscreen {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1050; /* Ensures it stays on top */
        width: 100%;
        height: 100%;
        margin: 0;
        max-width: none;
        overflow: hidden;
    }

    #CostAllocationModal .modal-content {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    #CostAllocationModal .modal-body {
        flex: 1; /* Takes up remaining space */
        overflow-y: auto; /* Enables vertical scrolling */
        overflow-x: hidden; /* Disables horizontal scrolling */
        padding: 15px; /* Optional: Adjust padding to make it visually better */
    }

    #CostAllocationModal .card {
        background-color: #ffffff !important;
        color: #fff;
        border: none;
        border-radius: 5px;
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        list-style: none;
        padding: 8px 0;
        z-index: 1000;
    }

        .context-menu li {
            padding: 8px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

            .context-menu li:hover {
                background-color: #f0f0f0;
            }

</style>


<div class="title">
    <div class="header-container">
        <div class="title">Receipts Voucher Details</div>
    </div>
</div>
<div class="content-container-top" style="background-color:#909ead00;">


    <div class="dx-fieldset horizontal-container" style="margin-bottom:0px">
        <div class="form-group">
            <label for="VoucherNo" class="button-alignment-down">Voucher No:</label>

            @(
                        Html.DevExtreme().TextBox()
                        .ID("VoucherNo")
                .OnValueChanged("onVoucherNoChanged")
                        .Value(null)
                        .ReadOnly(true)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Voucher No is required");
                        })
                        )
        </div>

        <div class="form-group">
            <label for="VoucherDate" class="button-alignment-down">Voucher Date:</label>

            @(Html.DevExtreme().DateBox()

                        .ID("VoucherDate")
                        .OnValueChanged("onVoucherDateChanged")

                        .InputAttr("aria-label", "Date")

                        .LabelMode(EditorLabelMode.Outside)

                        .Type(DateBoxType.Date)

                        .DisplayFormat("dd-MMM-yyyy")

                        .Value(DateTime.Now)

                        )
        </div>
        <div class="form-group">
            <label for="EffectiveDate" class="button-alignment-down">Effective Date:</label>

            @(Html.DevExtreme().DateBox()

                        .ID("EffectiveDate")

                        .InputAttr("aria-label", "Date")

                        .LabelMode(EditorLabelMode.Outside)

                        .Type(DateBoxType.Date)

                        .DisplayFormat("dd-MMM-yyyy")

                        .Value(DateTime.Now)

                        )
        </div>
        <div class="form-group">
            <label for="" class="button-alignment-down">Receiving Account:</label>
            @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi()
                        .Controller("VoucherEntryCashReceipts")
                        .LoadAction("GetReceivingAccount")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AccountId")
                        )
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Receiving Account is required");
                        })
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("accountDropDownBox")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("change") // Detects changes in the dropdown
                        .HoverStateEnabled(true)
                        .Value("Petty Cash - Shabbir")
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnValueChanged("onReceivingAccountChange") // Call the change handler
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .Width(720)
                        .TabIndex(1)
                        .DropDownOptions(o => o.Width(1000))
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                        )
        </div>



    </div>



    <div class="dx-fieldset horizontal-container " style="margin-top:15px;margin-bottom:0px;">

        <div class="form-group">
            <div class="button-alignment-down">
                <label for="DrCr">Dr/Cr:</label>
            </div>
            @(
                        Html.DevExtreme().SelectBox()
                        .ID("TransactionTypeComboBox")
                        .DataSource(new[] { "Dr", "Cr" })
                        .Value("Cr")
                        .Placeholder("Select Transaction Type")
                        .Width(90)
                        )
        </div>


        <div class="form-group">
            <label for="" class="button-alignment-down" style="color: black;">Account Head:</label>
            @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi()
                        .Controller("VoucherEntryCashReceipts")
                        .LoadAction("GetAccountHead")
                        .LoadParams(new { SelectedPaymentAccount = new JS("$('#accountDropDownBox').dxDropDownBox('instance').option('value')") }) // Pass the selected Receiving Account value
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AccountId")
                        )
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Account Head is required");
                        })
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("AccountHeadDropDown")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        @* .OnOpened("onDropDownBoxOpened") *@
                        .Width(720)
                        .TabIndex(1)
                        .DropDownOptions(o => o.Width(1000))
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                        )
        </div>


        <div class="form-group" style="margin-top:56px;margin-left:-10px">
            @(Html.DevExtreme().Button()
                        .ID("btnAddAHead")
                        .Icon("plus")
                            .OnClick("showLedgerAccountPopup") // Attach the onClick event handler
                        )

            <!-- DevExtreme Popup -->
            @(Html.DevExtreme().Popup()
                        .ID("ledgerAccountPopup")
                        .Width("93%")
                        .Height("85%")
                        .Title("Add Ledger Account")
                        .ShowTitle(true)
                        .CloseOnOutsideClick(true)
                        .Visible(false)
                        .ResizeEnabled(true)
                        .ContentTemplate(@<text>
                <div id="popupContent" style="width:100%; height:100%;background-color: aliceblue;">
                    <iframe id="ledgerAccountFrame" style="width:100%; height:100%; border:none;background-color: aliceblue;"></iframe>
                </div>
            </text>)
                        )
        </div>
        <div id="popupContainer"></div>
        <div class="form-group" style="margin-top:56px;margin-left:-10px">
            @(Html.DevExtreme().Button()
                        .ID("btnEditAHead")
                        .Icon("edit")
                            .OnClick("showLedgerAccountEditPopup")
                        )

            @(Html.DevExtreme().Popup()
                        .ID("ledgerEditAccountPopup")
                        .Width("93%")
                        .Height("85%")
                        .Title("Edit Ledger Account")
                        .ShowTitle(true)
                        .CloseOnOutsideClick(true)
                        .Visible(false)  // Hidden by default
                        .ResizeEnabled(true)
                        .ContentTemplate(@<text>
                <div id="popupContent" style="width:100%; height:100%;">
                    <iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
                </div>
            </text>)
                        )
        </div>
        <div class="form-group">
            <label for="Amount" class="button-alignment-down">Amount:</label>
            @(
                        Html.DevExtreme().NumberBox()
                        .ID("Amount")
                        .Value(null)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Amount value doesnot allow to add Zero or negative");
                        })
                        .Min(0)
                        .Placeholder("0.00")
                        .Format("#,##0.00")
                        .InputAttr(new
                        {
                            style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                            type = "number",
                            step = "0.01"
                        })

                        )
        </div>
    </div>

    <div class="dx-fieldset horizontal-container " style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px;">
        <div class="form-group">
            <label for="Amount" class="button-alignment-down" style="margin-right:25px;height:40px;">Narration:</label>
        </div>
        <div class="form-group">
            @(
                        Html.DevExtreme().TextArea()
                        .ID("Narration")
                        .Value("")
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Narration is required");
                        })
                        .Height(40)
                        .Width(720)
                        .Placeholder("Enter your comments here...")
                        .MaxLength(500)
                        )
        </div>
        <div class="form-group" style="">
            @(Html.DevExtreme().Button()
                        .ID("btnaddCostAllocation")
                        .Text("ADD")
                        .Height(40)
                        .Width(178)
                        .Icon("plus")
                        .OnClick("function() { addVoucherEntry(); }")
                        )
        </div>

    </div>
    <div class="dx-field ledgerResult">
        <div class="dx-row dx-column-lines dx-header-row ">
            @(
                            Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                            .ID("dataGrid")
                            .RemoteOperations(false)
                            .Columns(columns =>
                            {
                                columns.AddFor(m => m.VoucherEntryNo)
                            .Caption("VoucherEntryNo")
                            .Visible(false);

                                columns.AddFor(m => m.DrCr).Caption("Dr/Cr").DataType(GridColumnDataType.String).Lookup(lookup => lookup
                            .DataSource(new[] { "Dr", "Cr" })
                            .ValueExpr("this")
                            .DisplayExpr("this")
                            );

                                columns.AddFor(m => m.AccountHead).DataField("AccountHead").Width("350")
                            .CellTemplate(@<text>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="account-head-span">
                        <%- data.AccountHead ? data.AccountHead : "No Selection" %>
                    </span>
                </div>
            </text>)
                        .EditCellTemplate(@<text>


                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryCashReceipts")
                .LoadAction("GetEditAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )

                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBoxEdit")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change")
                .HoverStateEnabled(true)
                .Value(new JS("data.AccountHead"))
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .OnValueChanged("gridData_valueChanged")
                .OnOpened("onOpened")
                .Width(350)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(500))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("ReceivingAccountDropdownContentTemplate"))
                )


            </text>);



                                columns.AddFor(m => m.DrAmount).Caption("Debit").Alignment(HorizontalAlignment.Right).CustomizeText(
                            "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                            );
                                columns.AddFor(m => m.CrAmount).Caption("Credit").Alignment(HorizontalAlignment.Right).CustomizeText(
                            "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                            );
                                columns.AddFor(m => m.EntryNarration).Caption("Entry Narration");
                                columns.AddFor(m => m.SysRemarks).Caption("Remarks");
                            })
                        .Selection(selection => selection.Mode(SelectionMode.Single))
                        //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
                        .AllowColumnReordering(true) // Enable column reordering
                        .AllowColumnResizing(true)   // Enable column resizing
                        .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                        .HeaderFilter(filter => filter.Visible(true))
                        .Height(250)
                        .ColumnAutoWidth(true)
                        .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                        .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                        .ShowBorders(true)
                        .Width("100%")
                        .Editing(editing => editing
                        .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                        .AllowUpdating(true)   // Enable editing of existing rows
                        @* .AllowDeleting(true)   // Enable deleting rows
            .UseIcons(true) *@                       // Enables icons for editing buttons
                        )
                        .OnEditorPreparing("onEditorPreparing")
                        .OnRowUpdating("onRowUpdating")
                        .Summary(summary =>
                        {
                            summary.TotalItems(totalItems =>
                            {

                                totalItems.Add().Column("DrAmount").SummaryType(SummaryType.Sum)
                            .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                                totalItems.Add().Column("CrAmount").SummaryType(SummaryType.Sum)
                            .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                            });
                        })
                        )
        </div>
    </div>



    <!-- Context Menu for Actions -->
    <ul id="contextMenu" class="context-menu" style="display: none;">
        <li onclick="editCostAllocation()">
            <i class="fas fa-edit" style="margin-right: 8px;"></i> Edit Cost Allocation
        </li>
        <li onclick="editBillsReceivable()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i> Edit Bill Receivable
        </li>

        <li onclick="editEmployeeAllocation()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i> Edit Employee Allocation
        </li>
        <li onclick="editPropertyAllocation()">
            <i class="fas fa-cogs" style="margin-right: 8px;"></i> Edit Property Allocation
        </li>
        <li onclick="onRowRemoving()">
            <i class="fas fa-trash-alt" style="margin-right: 8px;"></i> Delete Line Entry
        </li>
        <li onclick="onAllRowRemoving()">
            <i class="fas fa-trash-alt" style="margin-right: 8px;"></i> Delete All Line Entries
        </li>
    </ul>


