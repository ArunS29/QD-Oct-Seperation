    // Define the validation function globally
    function validateInputsAndAddCostAllocation() {
        // Retrieve values from the DevExtreme components
        let voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
        let voucherDate = $("#VoucherDate").dxDateBox("instance").option("value");
        let effectiveDate = $("#EffectiveDate").dxDateBox("instance").option("value");
        let receivingAccount = $("#accountDropDownBox").dxDropDownBox("instance").option("value");
        let transactionType = $("#TransactionTypeComboBox").dxSelectBox("instance").option("value");
        let accountHead = $("#AccountHeadDropDown").dxDropDownBox("instance").option("value");
        let amount = $("#Amount").dxTextBox("instance").option("value");
        let narration = $("#Narration").dxTextArea("instance").option("value");

        // Check if all fields have values
        if (!voucherNo || !voucherDate || !effectiveDate || !receivingAccount || !transactionType || !accountHead || !amount || !narration) {
            alert("Please fill in all the fields before proceeding.");
            return false;
        }

        // If all fields are valid, execute the add cost allocation function
        addCostAllocation();
    }

