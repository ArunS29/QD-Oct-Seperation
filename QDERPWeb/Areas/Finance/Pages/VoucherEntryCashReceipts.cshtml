                            $("#btncostBack").on("click", function () {
                                $("#CostAllocationModal").modal('hide');
                            });
                            DevExpress.ui.repaintFloatingActionButton();
                        });
                    }
                },

                error: function (xhr, status, error) {

                    alert("Error occurred while updating data: " + error);

                }

            });

        } else {

            DevExpress.ui.dialog.alert(
                "Cannot continue saving with errors,please clear the errors and continue.",
                formatMessage("Clear Errors")
            );
            //  DevExpress.ui.notify("Please fill required details!", "error", 2000);

        }

        if (accheadname != null) {

            const ddbInstance = $("#AccountHeadDropDown").dxDropDownBox("instance");

            ddbInstance.option("value", "-");

            $("#Narration").dxTextArea("instance").option("value", "");

