        }

        var dataGrid = $("#dataGrid").dxDataGrid("instance"); // Get the DataGrid instance

        var rowCount = dataGrid.getVisibleRows().length; // Get the number of rows in the grid

        griddatacount = rowCount;

        if (accountHeadValidation.isValid && voucherAmtValidation.isValid && amount != "0.00") {

            var sysRemarks1 = paymentaccheadname ? `Received by : ${paymentaccheadname}` : "";

            var sysRemarks2 = accheadname || "";

            var VE = [];

            var gridData = $("#dataGrid").dxDataGrid("instance").option("dataSource") || [];

            // Check if "Petty Cash - Shabbir" already exists in the grid

            var exists = gridData.some(function (row) {

                return row.AccountHead === "Riyadh Bank";

            });

            if (!exists) {

                // Add both entries if "Petty Cash - Shabbir" does not exist

                VE = [

                    {

                        "VoucherNo": voucherNo,

                        "AccountHead": accountHead,

                        "VoucherAmount": amount,

                        "DrCr": sbDrCr,

                        "AddedBy": "102",

                        "AddedOn": new Date(),

                        "EntryNarration": $("#Narration").dxTextArea("instance").option("value"),

                        "SysRemarks": sysRemarks1

