    function proceedWithVerification() {
        // Set VerifiedBy checkbox to true
        $("#VerifiedBy").dxCheckBox("instance").option("value", true);
        const vno = $("#VoucherNo").dxTextBox("instance").option("value");

        // Prepare data for verification
        const currentDate = new Date();
        const formattedDate = currentDate.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }).replace(/ /g, '-');

        const data = {
            voucherNo: vno,
            verifiedBy: "Admin",
            verifiedOn: new Date().toISOString()
        };

        $.ajax({
            data: JSON.stringify(data),
            success: function (response) {
                Swal.fire({
                    title: formatMessage("Success!"),
                    text: formatMessage("Voucher has been Verified."),
                    icon: "success",
                    confirmButtonText: "OK"
                }).then(() => {
                    $("#VerifiedBytext").dxTextBox("instance").option("value", "Admin");
                    $("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate);
                });
            },
            error: function () {
                Swal.fire({
                    title: formatMessage("Error"),
                    text: formatMessage("Please save the transactions after proceeding!!"),
                    icon: "error",
                    confirmButtonText: "OK"
                });
            }
        });
    }


