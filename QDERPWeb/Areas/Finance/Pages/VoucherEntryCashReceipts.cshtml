    <div class="container1" style="padding:15px">
        <div class="row g-3">
            <div class="col-md-3 backgroundcolor" style="padding-top:10px;padding-bottom:10px">

                <div class="form-group">
                    <label for="Cheque No/Reference No">Cheque No/Reference No:</label>
                    @(
                                Html.DevExtreme().TextBox()
                                .ID("ChequeNoReferenceNo")
                                .ValidationRules(rules =>
                                {
                                    rules.AddRequired()
                                    .Message("Cheque No is required");
                                })
                                .Value(null)
                                )
                </div>
                <div class="form-group mt-3">
                    <label for="VoucherType">Voucher Type:</label>
                    @(
                                Html.DevExtreme().SelectBox()
                                .ID("VoucherType")
                                .DataSource(new[] { "Cash Receipts" }) // DataSource
                                .Value("Cash Receipts") // Default value
                                .Disabled(true) // Disable the dropdown
                                )
                </div>
            </div>

            <div class="col-md-8 backgroundcolor" style="padding-top:10px;padding-bottom:10px">
                <div class="form-group">
                    <label for="VoucherNarration">Voucher Narration:</label>
                    @(
                                Html.DevExtreme().TextBox()
                                .ID("VoucherNarration")
                                .ValidationRules(rules =>
                                {
                                    rules.AddRequired()
                                    .Message("Voucher Narration is required");
                                })
                                .Value(null)

                                )
                </div>
                <div class="form-group mt-3">
                    <label for="Remarks">Remarks:</label>
                    @(
                                Html.DevExtreme().TextBox()
                                .ID("Remarks")
                                .Value(null)
                                .ValidationRules(rules =>
                                {
                                    rules.AddRequired()
                                    .Message("Remarks is required");
                                })

                                )

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <!-- Verified By -->
                        <div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
                            @(Html.DevExtreme().CheckBox().ID("VerifiedBy"))
                            <span style="margin-left:5px">Verified By:</span>
                            @(Html.DevExtreme().TextBox()
                                        .ID("VerifiedBytext")
                                        .Value(null)
                                        .Disabled(true)
                                        .Width("200px")
                                        )
                        </div>
                        <!-- Verified On -->
                        <div class="form-group d-flex align-items-center mt-2">
                            <span>Verified On:</span>
                            @(Html.DevExtreme().TextBox()
                                        .ID("VerifiedOnDate")
                                        .Value(null)
                                        .Disabled(true)
                                        .Width("200px")
                                        .ElementAttr(new { style = "margin-left: 10px;" })
                                        )
                        </div>
                    </div>
                    <div class="col-md-6">
                        <!-- Approved By -->
                        <div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
                            @(Html.DevExtreme().CheckBox().ID("ApprovedBy"))
                            <span style="margin-left:5px">Approved By:</span>
                            @(Html.DevExtreme().TextBox()
                                        .ID("ApprovedBytext")
                                        .Value(null)
                                        .Disabled(true)
                                        .Width("200px")
                                        )
                        </div>
                        <!-- Approved On -->
                        <div class="form-group d-flex align-items-center mt-2">
                            <span>Approved On:</span>
                            @(Html.DevExtreme().TextBox()
                                        .ID("ApprovedOntext")
                                        .Value(null)
                                        .Disabled(true)
                                        .Width("200px")
                                        .ElementAttr(new { style = "margin-left: 10px;" })
                                        )
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-1 backgroundcolor">
                <div class="form-group" style="padding-top:50px;padding-left:7px;">
                    <!-- Attach Button -->
                    @(Html.DevExtreme().Button()
                                .ID("btnAttachment")
                                .Icon("attach")
                                .Height(150)
                                .Width(100)
                                .OnClick("onAttachButtonClick")
                                )
                </div>
                <input type="file" id="fileInput" style="display:none;" />
            </div>
        </div>
    </div>
    <div>
        @await Html.PartialAsync("_Formfooter")
    </div>

    <!-- Drop Down Grid Template -->
    @using (Html.DevExtreme().NamedTemplate("ReceivingAccountDropdownContentTemplate"))
    {
        @(
                    Html.DevExtreme().DataGrid()
                    .ID("accountDropDownBoxeditGrid")
                    .DataSource(d => d.WebApi()
                    .Controller("VoucherEntryCashReceipts")
                    .LoadAction("GetEditAccountHead")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("AccountHead")
                    )
                    .WordWrapEnabled(true)
                    .ShowBorders(true)
                    .SearchPanel(sp => sp.HighlightSearchText(true))
                    .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode

                    .SelectedRowKeys(new JS(@"component.option(""value"")"))
                    .OnSelectionChanged(@<text>
        function(selectedItems) {
        var keys = selectedItems.selectedRowKeys;
        component.option("value", keys);
        console.log(keys);
        }
    </text>)


                    .HeaderFilter(p => p.Visible(true))
                    .ShowBorders(true)
                    .HoverStateEnabled(true)
                    .Paging(p => p.PageSize(15))
                    .FilterRow(f => f.Visible(true))
                    .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
