@page
@model Form.Areas.Finance.Pages.VoucherEntryReceiptsModel
@{
    ViewData["Title"] = "Receipt Voucher Details";

}




<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style type="text/css">
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }
    /* Target the header row to set the background color */
    .aliceblue-header .dx-datagrid-headers {
        background-color: aliceblue !important;
    }

    /* Optional: Ensure header text doesn't conflict with the background */
    .aliceblue-header .dx-header-row .dx-datagrid-text-content {
        color: #333; /* Make sure text is readable */
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }



    .button-alignment-down {
        margin-bottom: 10px
    }

    .content-container {
        border-radius: 10px;
        padding: 5px;
        background-color: white;
    }
    /* Style for edit button */
    .dx-command-edit .dx-icon-edit {
        color: green; /* Green color for edit */
    }

    /* Style for delete button */
    .dx-command-edit .dx-icon-trash {
        color: red; /* Red color for delete */
    }


    #CostAllocationModal .modal-dialog.fullscreen {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1050; /* Ensures it stays on top */
        width: 100%;
        height: 100%;
        margin: 0;
        max-width: none;
        overflow: hidden;
    }

    #CostAllocationModal .modal-content {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    #CostAllocationModal .modal-body {
        flex: 1; /* Takes up remaining space */
        overflow-y: auto; /* Enables vertical scrolling */
        overflow-x: hidden; /* Disables horizontal scrolling */
        padding: 15px; /* Optional: Adjust padding to make it visually better */
    }

    #CostAllocationModal .card {
        background-color: #ffffff !important;
        color: #fff;
        border: none;
        border-radius: 5px;
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        list-style: none;
        padding: 8px 0;
        z-index: 1000;
    }

        .context-menu li {
            padding: 8px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

            .context-menu li:hover {
                background-color: #f0f0f0;
            }

</style>


<div class="title">
    <div class="header-container">
        <div id="ReceiptsVoucherDetails" class="title no-border-title"></div>
    </div>
</div>
<div class="content-container-top" style="background-color:#909ead00;">


    <div class="dx-fieldset horizontal-container" style="margin-bottom:0px">
        <div class="form-group">
            @(
                Html.DevExtreme().TextBox()
                .Label(new JS("formatMessage('Voucher No')"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("VoucherNo")
                .Value("")
                .ReadOnly(true)
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message(new JS("formatMessage('Voucher No is required')"));
                })
                )
        </div>

        <div class="form-group">

            @(Html.DevExtreme().DateBox()

                .ID("VoucherDate")
                .Label(new JS("formatMessage('Voucher Date')"))
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Date")

                .LabelMode(EditorLabelMode.Outside)

                .Type(DateBoxType.Date)

                .DisplayFormat("dd-MMM-yyyy")

                .Value(DateTime.Now)

                )
        </div>
        <div class="form-group">

            @(Html.DevExtreme().DateBox()

                .ID("EffectiveDate")
                .Label(new JS("formatMessage('Effective Date')"))
                .LabelMode(EditorLabelMode.Outside)
                .InputAttr("aria-label", "Date")

                .LabelMode(EditorLabelMode.Outside)

                .Type(DateBoxType.Date)

                .DisplayFormat("dd-MMM-yyyy")

                .Value(DateTime.Now)

                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryReceipts")
                .LoadAction("GetReceivingAccount")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message("Receiving Account is required");
                })
                .Label(new JS("formatMessage('Receiving Account')"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBox")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change") // Detects changes in the dropdown
                .HoverStateEnabled(true)
                .Value("Riyadh Bank")
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .OnValueChanged("onReceivingAccountChange") // Call the change handler
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .Width(720)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(1000))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                )
        </div>



    </div>



    <div class="dx-fieldset horizontal-container" style="margin-bottom:0px;">

        <div class="form-group" style="padding-left:20px">
            <div class="button-alignment-down">
            
            </div>
            @(
                Html.DevExtreme().SelectBox()
                .Label(new JS("formatMessage('Dr/Cr')"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("TransactionTypeComboBox")
                .DataSource(new[] { "Dr", "Cr" })
                .Value("Cr")
                .Placeholder("Select Transaction Type")
                .Width(90)
                )
        </div>


        <div class="form-group">
            @(Html.DevExtreme().DropDownBox()
                .Label(new JS("formatMessage('Account Head')"))
                .LabelMode(EditorLabelMode.Outside)
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryReceipts")
                .LoadAction("GetAccountHead")
                .LoadParams(new { SelectedPaymentAccount = new JS("$('#accountDropDownBox').dxDropDownBox('instance').option('value')") }) // Pass the selected Receiving Account value
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message(new JS("formatMessage('Account Head is required')"));
                })
                .ID("AccountHeadDropDown")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                @* .OnOpened("onDropDownBoxOpened") *@
                .Width(720)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(1000))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                )
        </div>


        <div class="form-group" style="margin-top:25px;margin-left:0px">
            @(Html.DevExtreme().Button()
                .ID("btnAddAHead")
                .Icon("plus")
                .OnClick("showPopup") // Attach the onClick event handler
                )

            <!-- DevExtreme Popup -->
            @(Html.DevExtreme().Popup()
                .ID("ledgerAccountPopup")
                .Width("93%")
                .Height("85%")
                .Title(new JS("formatMessage('Add Ledger Account')"))
                .ShowTitle(true)
                .CloseOnOutsideClick(true)
                .Visible(false)
                .ResizeEnabled(true)
                .ContentTemplate(@<text>
                <div id="popupContent" style="width:100%; height:100%;background-color: aliceblue;">
                    <iframe id="ledgerAccountFrame" style="width:100%; height:100%; border:none;background-color: aliceblue;"></iframe>
                </div>
            </text>)
                )
        </div>
        <div id="popupContainer"></div>
        <div class="form-group" style="margin-top:25px;margin-left:10px">
            @(Html.DevExtreme().Button()
                .ID("btnEditAHead")
                .Icon("edit")
                .OnClick("showLedgerAccountEditPopup")
                )

            @(Html.DevExtreme().Popup()
                .ID("ledgerEditAccountPopup")
                .Width("93%")
                .Height("85%")
                .Title(new JS("formatMessage('Edit Ledger Account')"))
                .ShowTitle(true)
                .CloseOnOutsideClick(true)
                .Visible(false)  // Hidden by default
                .ResizeEnabled(true)
                .ContentTemplate(@<text>
                <div id="popupContent" style="width:100%; height:100%;">
                    <iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
                </div>
            </text>)
                )
        </div>
        <div class="form-group">
            @(
                Html.DevExtreme().NumberBox()
                .Label(new JS("formatMessage('Amount')"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("Amount")
                .Value(null)
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message("Amount value doesnot allow to add Zero or negative");
                })
                .Min(0)
                .Placeholder("0.00")
                .Format("#,##0.00")
                .InputAttr(new
                {
                    style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                    type = "number",
                    step = "0.01"
                })

                )
        </div>
    </div>

    <div class="dx-fieldset horizontal-container " style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px;">
        <div class="form-group" style="padding-left:20px">
        </div>
        <div class="form-group">
            @(
                Html.DevExtreme().TextArea()
                .Label(new JS("formatMessage('Narration')"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("Narration")
                .Value("")
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message("Narration is required");
                })
                .Height(40)
                .Width(720)
                .Placeholder(new JS("formatMessage('Enter your comments here...')"))
                .MaxLength(500)
                )
        </div>
        <div class="form-group" style="margin-top:25px">
            @(Html.DevExtreme().Button()
                .ID("btnaddCostAllocation")
                .Text(new JS("formatMessage('ADD')"))
                .Height(40)
                .Width(178)
                .Icon("plus")
                .OnClick("function() { addVoucherEntry(); }")
                )
        </div>

    </div>
    <div class="dx-field ledgerResult">
        <div class="dx-row dx-column-lines dx-header-row" style="background-color: aliceblue;">
            @(
                Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
                .ID("dataGrid")
                .RemoteOperations(false)
                .Columns(columns =>
                {
                    columns.AddFor(m => m.VoucherEntryNo)
                    .Caption("VoucherEntryNo")
                    .Visible(false);

                    columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('Dr/Cr')")).DataType(GridColumnDataType.String).Lookup(lookup => lookup
                    .DataSource(new[] { "Dr", "Cr" })
                    .ValueExpr("this")
                    .DisplayExpr("this")
                    );

                    columns.AddFor(m => m.AccountHead)
                    .Caption(new JS("formatMessage('Account Head')")).CellTemplate(@<text>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span>
                        <%- data.AccountHead ? data.AccountHead : "No Selection" %>
                    </span>
                </div>
            </text>)
                .EditCellTemplate(@<text>


                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryReceipts")
                .LoadAction("GetEditAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )

                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBoxEdit")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change")
                .HoverStateEnabled(true)
                .Value(new JS("data.AccountHead"))
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .OnValueChanged("gridBox_valueChanged")
                .OnOpened("onOpened")
                .Width(250)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(500))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("AccountHeadEditDropdownContentTemplate"))
                )


            </text>);
                                columns.AddFor(m => m.DrAmount).Caption(new JS("formatMessage('Debit')")).Alignment(HorizontalAlignment.Right).CustomizeText(
                    "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                    ).AllowEditing(false);
                    columns.AddFor(m => m.CrAmount).Caption(new JS("formatMessage('Credit')")).Alignment(HorizontalAlignment.Right).CustomizeText(
                    "function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"

                    ).AllowEditing(false);
                    columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('Entry Narration')"));
                    columns.AddFor(m => m.SysRemarks).Caption(new JS("formatMessage('Remarks')"));
                })
                .Selection(selection => selection.Mode(SelectionMode.Single))
                //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
                .AllowColumnReordering(true) // Enable column reordering
                .AllowColumnResizing(true)   // Enable column resizing
                .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
                .HeaderFilter(filter => filter.Visible(true))
                .Height(250)
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
                .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
                .ShowBorders(true)
                .Width("100%")
                .Editing(editing => editing
                .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                .AllowUpdating(true)   // Enable editing of existing rows
                .AllowDeleting(true)   // Enable deleting rows
                .UseIcons(true) // Enables icons for editing buttons
                )
                .OnEditorPreparing("onEditorPreparing")
                //.OnRowRemoving("onRowRemoving")
                .OnRowPrepared(@"
            function(e) {
            if (e.rowType === 'data' && e.data.DrCr === 'Cr') {
            $(e.rowElement).css('background-color', 'lightgray');
            }
            }
            ")
                )
        </div>
    </div>
    <div id="footerTotals" style="display: flex;color: black;margin-left:15px; padding: 5px 10px; font-size: 14px;">
        <div style="flex: 3.4;">&nbsp;</div> <!-- Aligns with Dr/Cr and Account Head columns -->
        <!-- TextBox for Debit -->
        <div style="flex: 1; text-align: center;">
            @(Html.DevExtreme().TextBox()
                .ID("totalDebitTextbox")
                .Value("0.00")
                .ReadOnly(true)
                .Width("100%")
                .InputAttr(new { style = "text-align: right;" })
                )
        </div>
        <!-- TextBox for Credit -->
        <div style="flex: 1; text-align: center;">
            @(Html.DevExtreme().TextBox()
                .ID("totalCreditTextbox")
                .Value("0.00")
                .ReadOnly(true)
                .Width("100%")
                .InputAttr(new { style = "text-align: right;" })
                )
        </div>
        <div style="flex: 4;">&nbsp;</div> <!-- Aligns with Entry Narration and Remarks columns -->
    </div>


    <!-- Context Menu for Actions -->
    <ul id="contextMenu" class="context-menu" style="display: none;">
        <li onclick="editCostAllocation()">
            <i class="fas fa-edit" style="margin-right: 8px;"></i><div id="EditCostAllocation" class="no-border-input"></div>
        </li>
        <li onclick="editBillReceivable()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditBillReceivable" class="no-border-input"></div>
        </li>
        <li onclick="editBillReceivable1()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditSalaryPayable" class="no-border-input"></div>
        </li>
        <li onclick="editBillReceivable2()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditEmployeeAllocation" class="no-border-input"></div>
        </li>
        <li onclick="editPropertyAllocation()">
            <i class="fas fa-cogs" style="margin-right: 8px;"></i><div id="EditPropertyAllocation" class="no-border-input"></div>
        </li>
        <li onclick="onRowRemoving()">
            <i class="fas fa-trash-alt" style="margin-right: 8px;"></i><div id="DeleteLineEntry" class="no-border-input"></div>
        </li>
        <li onclick="onAllRowRemoving()">
            <i class="fas fa-trash-alt" style="margin-right: 8px;"></i><div id="DeleteAllLineEntries" class="no-border-input"></div>
        </li>
    </ul>


    <div id="CostAllocationContent"></div>

    <div class="container" style="padding:15px">
        <div class="row g-3">
            <div class="col-md-3 backgroundcolor" style="padding-top:10px;padding-bottom:10px">

                <div class="form-group">
                    @(
                        Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Cheque No/Reference No')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ChequeNoReferenceNo")
                        .Value(null)
                        )
                </div>
                <div class="form-group mt-3">
                    @(
                        Html.DevExtreme().SelectBox()
                        .Label(new JS("formatMessage('Voucher Type')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("VoucherType")
                        .DataSource(new[] { "Cash Receipts" }) // DataSource
                        .Value("Cash Receipts") // Default value
                        .Disabled(true) // Disable the dropdown
                        )
                </div>
            </div>

            <div class="col-md-8 backgroundcolor" style="padding-top:10px;padding-bottom:10px">
                <div class="form-group">
                    @(
                        Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Voucher Narration')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("VoucherNarration")
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Voucher Narration is required");
                        })
                        .Value(null)

                        )
                </div>
                <div class="form-group mt-3">
                    @(
                        Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Remarks')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("Remarks")
                        .Value(null)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Remarks is required");
                        })

                        )

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <!-- Verified By -->
                        <div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
                            @(Html.DevExtreme().CheckBox().ID("VerifiedBy").Text(new JS("formatMessage('Verified By:')")))

                            @(Html.DevExtreme().TextBox()
                                .ID("VerifiedBytext")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                )
                        </div>
                        <!-- Verified On -->
                        <div class="form-group d-flex align-items-center mt-2">
                            <span id="VerifiedOn" class="no-border-input"></span>
                            @(Html.DevExtreme().TextBox()
                                .ID("VerifiedOnDate")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                .ElementAttr(new { style = "margin-left: 10px;" })
                                )
                        </div>
                    </div>
                    <div class="col-md-6">
                        <!-- Approved By -->
                        <div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
                            @(Html.DevExtreme().CheckBox().ID("ApprovedBy").Text(new JS("formatMessage('Approved By:')")))
                            @(Html.DevExtreme().TextBox()
                                .ID("ApprovedBytext")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                )
                        </div>
                        <!-- Approved On -->
                        <div class="form-group d-flex align-items-center mt-2">
                            <span id="ApprovedOn" class="no-border-input"></span>
                            @(Html.DevExtreme().TextBox()
                                .ID("ApprovedOntext")
                                .Value(null)
                                .Disabled(true)
                                .Width("200px")
                                .ElementAttr(new { style = "margin-left: 10px;" })
                                )
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-1 backgroundcolor">
                <div class="form-group" style="padding-top:32px;padding-left:7px;">
                    <!-- Attach Button -->
                    @(Html.DevExtreme().Button()
                        .ID("btnAttachment")
                        .Icon("attach")
                        .Height(150)
                        .Width(100)
                        .OnClick("openAttachmentOptions")
                        )
                </div>
                <input type="file" id="fileInput" style="display:none;" />
            </div>
        </div>
    </div>
    <div>
        @await Html.PartialAsync("_Formfooter")
    </div>
    <!-- Drop Down Grid Template -->
    @using (Html.DevExtreme().NamedTemplate("PaymentAmountContentTemplate"))
    {
        @(
                Html.DevExtreme().DataGrid()
                .ID("suppliername-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryReceipts")
                .LoadAction("GetReceivingAccount")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )
                .WordWrapEnabled(true)
                .ShowBorders(true)
                .SearchPanel(sp => sp.HighlightSearchText(true))
                .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                .OnSelectionChanged("dataGridSelectionChanged")

                .OnInitialized("dataGridInitialized")
                .HeaderFilter(p => p.Visible(true))
                .ShowBorders(true)
                .HoverStateEnabled(true)
                .Paging(p => p.PageSize(15))
                .FilterRow(f => f.Visible(true))
                .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                .Height(345)
                .Selection(s => s.Mode(SelectionMode.Single))
                .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                .Columns(columns =>
                {
                    columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
                    columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"));
                    columns.Add().DataField("AccountHeadArabic").Caption(new JS("formatMessage('Account Head Arabic')"));
                    columns.Add().DataField("IsLedgerObselete").Caption(new JS("formatMessage('Is Ledger Obselete')"))


                .Alignment(HorizontalAlignment.Center)
                .CellTemplate(@<text>
        <div class="dx-icon">
            <%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
        </div>
    </text>);

                })
            )
    }

    @using (Html.DevExtreme().NamedTemplate("AccountHeadContentTemplate"))
    {
        @(
                Html.DevExtreme().DataGrid()
                .ID("accounthead-datagrid")
                .DataSource(d => d.WebApi()
                .Controller("VoucherEntryReceipts")

                .LoadAction("GetAccountHead")
                .LoadParams(new { SelectedPaymentAccount = new JS("$('#accountDropDownBox').dxDropDownBox('instance').option('value')") }) // Exclude Receiving Account
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId")
                )
                .WordWrapEnabled(true)
                .ShowBorders(true)
                .SearchPanel(sp => sp.HighlightSearchText(true))
                .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                .OnSelectionChanged("dataGridAccountHeadSelectionChanged")
                .OnInitialized("dataGridAccountHeadInitialized")
                .HeaderFilter(p => p.Visible(true))
                .ShowBorders(true)
                .HoverStateEnabled(true)
                .Paging(p => p.PageSize(15))
                .FilterRow(f => f.Visible(true))
                .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                .Height(345)
                .Selection(s => s.Mode(SelectionMode.Single))
                .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                .Columns(columns =>
