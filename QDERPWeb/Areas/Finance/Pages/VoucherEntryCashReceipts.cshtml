    $(document).ready(function () {
        // Attach an event listener to the 'TransactionTypeComboBox' SelectBox
        $("#TransactionTypeComboBox").dxSelectBox({
            onValueChanged: function (e) {
                // Get the selected value from the 'TransactionTypeComboBox'
                var selectedValue = e.value;

                // Update the 'DrCr' SelectBox based on the selected value
                var drCrSelectBox = $("#DrCr").dxSelectBox("instance");

                // Update the 'DrCr' SelectBox items based on the selection
                drCrSelectBox.option("items", [selectedValue]);

                // Optionally, reset the value of 'DrCr' to match the selected value
                drCrSelectBox.option("value", selectedValue);
            }
        });
    });
    $(document).ready(function () {
        // Attach an event listener to the 'AccountHeadDropDown' to listen for value changes
        $("#accountHeadDropDown").dxDropDownBox({
            onValueChanged: function (e) {
                // Get the selected value from 'AccountHeadDropDown'
                var selectedValue = e.value;

                // Now, let's update the 'CostAllocationExpense' SelectBox with the selected Account Head
                var costAllocationExpenseSelectBox = $("#CostAllocationExpense").dxSelectBox("instance");

                // Update the 'items' of the 'CostAllocationExpense' SelectBox to include the selected value
                costAllocationExpenseSelectBox.option("items", [selectedValue]);

                // Optionally, set the value of 'CostAllocationExpense' SelectBox to match the selected value
                costAllocationExpenseSelectBox.option("value", selectedValue);
            }
        });
    });
