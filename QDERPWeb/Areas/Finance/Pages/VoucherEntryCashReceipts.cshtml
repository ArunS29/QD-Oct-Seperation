    function onEditorPreparing(e) {
        if (e.dataField === 'EntryNarration' || e.dataField === 'SysRemarks') {
            if (isUpdatingCell) {
                return; // Prevent recursive triggering
            }

            e.cancel = true; // Prevent the default editor behavior

            const dataGridInstance = e.component; // Get the DataGrid instance
            const rowIndex = e.row.rowIndex; // Get the row index of the clicked cell
            const fieldName = e.dataField; // Dynamic field name (EntryNarration or SysRemarks)
            const initialValue = e.row.data[fieldName] || ""; // Get the current value of the cell

            // Show Swal modal
            Swal.fire({
                title: `<i class="fas fa-edit" style="color:#007bff"></i> Edit ${fieldName.replace(/([A-Z])/g, ' $1')}`, // Format field name for title
                html: `
                                <textarea id="swal-field-editor"
                                          style="width:100%; height:100px; font-size:16px; padding:10px; border-radius:8px; border:1px solid #ddd;"
                                          placeholder="Enter ${fieldName.replace(/([A-Z])/g, ' $1')}...">${initialValue}</textarea>
                            `,
                showCancelButton: true,
                confirmButtonText: 'OK',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                didOpen: () => {
                    // Focus the textarea and move the cursor to the end
                    const textarea = document.getElementById('swal-field-editor');
                    textarea.focus();
                    textarea.setSelectionRange(initialValue.length, initialValue.length);
                },
                preConfirm: () => {
                    const newValue = document.getElementById('swal-field-editor').value.trim();
                    return newValue; // Return the new value from the modal
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const newValue = result.value;

                    if (newValue !== initialValue) {
                        isUpdatingCell = true; // Set the flag before updating the cell
                        dataGridInstance.cellValue(rowIndex, fieldName, newValue); // Update the specific cell dynamically
                        dataGridInstance.saveEditData(); // Save the edit data
                        dataGridInstance.refresh(); // Refresh the grid to reflect changes
                        isUpdatingCell = false; // Reset the flag after updating
                    }
                } else if (result.isDismissed) {
                    console.log('Edit cancelled');
                }
            });
        }
    }
    function onReceivingAccountChange(e) {
        const receivingAccountValue = e.value; // Get the new value of Receiving Account

        // Access the Account Head DropDownBox instance
        const accountHeadDropdown = $("#AccountHeadDropDown").dxDropDownBox("instance");

        if (!accountHeadDropdown) {
            console.warn("Account Head DropDownBox instance not found.");
            return;
        }

        // Access the data source of the Account Head dropdown
        const dataSource = accountHeadDropdown.getDataSource();

        // Update the filter based on the Receiving Account value
        if (receivingAccountValue === null || receivingAccountValue === undefined) {
            // Clear the filter if Receiving Account is null
            dataSource.filter(null);
        } else {
            // Exclude the selected Receiving Account value
            dataSource.filter(["AccountId", "<>", receivingAccountValue]);
        }

        // Reload the data source
        dataSource.load()
            .then(() => {
                // Reset the dropdown selection
                accountHeadDropdown.reset();

                // Wait for the dropdown content to render
                setTimeout(() => {
                    const dropdownContent = accountHeadDropdown.content();
                    if (dropdownContent) {
                        const gridContent = dropdownContent.find("#accounthead-datagrid").dxDataGrid("instance");
                        if (gridContent) {
                            // Apply the same filter to the DataGrid
                            if (receivingAccountValue === null || receivingAccountValue === undefined) {
                                gridContent.clearFilter(); // Clear filter when Receiving Account is null
                            } else {
                                gridContent.filter(["AccountId", "<>", receivingAccountValue]);
                            }
                            gridContent.refresh(); // Refresh the grid to reflect changes
                        } else {
                            console.warn("AccountHead DataGrid instance is not initialized yet.");
                        }
                    } else {
                        console.warn("AccountHead DropDown content is not initialized yet.");
                    }
                }, 100); // Adjust delay if necessary
            })
            .catch((error) => {
                console.error("Error refreshing data source for AccountHead:", error);
            });
    }
