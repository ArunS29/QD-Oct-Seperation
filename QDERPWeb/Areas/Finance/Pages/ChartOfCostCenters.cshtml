@* <div id="popupContainer"></div> *@

<div class="dx-field ledgerResult">

    @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry20108ChartOfCostCenter>()
        .ID("dataGrid")
        .KeyExpr("CostAllocationUnit")
        .RemoteOperations(false)
        .DataSource(ds => ds.Mvc()
        .Controller("ChartOfCostCenters")
        .LoadAction("GetChartOfCostCenters"))
        .Columns(columns =>
        {
            columns.Add().DataField("CostAllocationUnitId").Caption(new JS("formatMessage('Cost Center Code')")).Alignment(HorizontalAlignment.Center).CellTemplate(@<text>
        <div onclick="redirectToCostCenterMaster('/pulse/Finance/CostCenterMaster?CostAllocationUnitId=<%-data.CostAllocationUnitId%>')" style="color: #0398fc; text-decoration: underline;"><%-data.CostAllocationUnitId%></div>
        @* <a href="/pulse/Finance/CostCenterMaster?CostAllocationUnitId=<%-data.CostAllocationUnitId%>" target="_blank" style="color: #0398fc; text-decoration: underline;"> *@
        @*     <%-data.CostAllocationUnitId%> *@
        @* </a> *@
    </text>);
            columns.Add().DataField("CostAllocationUnit").Caption(new JS("formatMessage('Cost Center Unit')")).Alignment(HorizontalAlignment.Left);
            columns.Add().DataField("CostAllocationMasterGroup").Caption(new JS("formatMessage('Cost Center Master')")).Alignment(HorizontalAlignment.Center).GroupIndex(0);
            columns.Add().DataField("CostAllocationGroup").Caption(new JS("formatMessage('Cost Center Group')")).Alignment(HorizontalAlignment.Center).GroupIndex(1);
            columns.Add().DataField("IsDisabled").Caption(new JS("formatMessage('Is Disabled')")).CellTemplate(@<text>
        <input type="checkbox" class="dx-checkbox" />
    </text>
        );
            columns.AddFor(m => m.CreatedBy)
            .Caption(new JS("formatMessage('Created By')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.CreatedOn)
            .Caption(new JS("formatMessage('Created On')"))
            .Alignment(HorizontalAlignment.Center)
            .Visible(false);

            columns.AddFor(m => m.ModifiedBy)
            .Caption(new JS("formatMessage('Modified By')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.ModifiedOn)
            .Caption(new JS("formatMessage('Modified On')"))
            .Alignment(HorizontalAlignment.Center)
            .Visible(false);


            columns.AddFor(m => m.CostUnitRemarks)
            .Caption(new JS("formatMessage('Cost Unit Remarks')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.CostCenterIncharge)
            .Caption(new JS("formatMessage('Cost Center Incharge')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.ProjectDescription)
            .Caption(new JS("formatMessage('Project Description')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.ProjectDuration)
            .Caption(new JS("formatMessage('Project Duration')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.ProjectLocation)
            .Caption(new JS("formatMessage('Project Location')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.ProjectMasterCode)
            .Caption(new JS("formatMessage('Project Master Code')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.BranchCode)
            .Caption(new JS("formatMessage('Branch Code')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.BranchName)
            .Caption(new JS("formatMessage('Branch Name')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

            columns.AddFor(m => m.BranchNameAr)
            .Caption(new JS("formatMessage('Branch Name (Arabic)')"))
            .Alignment(HorizontalAlignment.Left)
            .Visible(false);

        })
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(true))
        .Height(500)
        .ColumnAutoWidth(true)
        .FilterRow(filterRow => filterRow.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .Width("100%")
        .OnInitialized("dataGridInitialized") // Store the DataGrid instance
        .OnContextMenuPreparing("onContextMenuPreparing") // Handle right-click event
        .OnRowPrepared("onRowPrepared")       // Handle row appearance dynamically
        .ColumnChooser(c => c.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.Select))
        .Paging(paging => paging.Enabled(true))
        .Scrolling(scrolling => scrolling
        .Mode(GridScrollingMode.Virtual) // or "infinite" for endless scroll
        .RowRenderingMode(GridRowRenderingMode.Virtual) // This ensures virtual row rendering for performance
        .PreloadEnabled(true) // Preloads data in the background for smoother scrolling
        .ScrollByContent(true) // Enables scrolling by content (no need to have pagination)
        )
        )
</div>
<div id="masterModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <iframe id="modalIframe" src="" width="100%" height="500px" frameborder="0"></iframe>
    </div>
</div>








<script>
    $(function () {

										$("#ChartOfCostCenters").dxTextBox({
													text:formatMessage("Chart Of Cost Centers"),
                                                        readOnly: true,
													onContentReady: function(e) {
				$(e.element).addClass("dx-textbox-heading");
		}

                                    });
									});
    function redirectToCostCenterMaster(url) {

        const modal = document.getElementById("masterModal");
        const iframe = document.getElementById("modalIframe");

        iframe.src = url;

        modal.style.display = "block";

        const closeBtn = modal.querySelector(".close");
        closeBtn.onclick = () => {
            modal.style.display = "none";
            refreshChartOfCostCenters();
        };

        window.onclick = (event) => {
            if (event.target === modal) {
                modal.style.display = "none";
                refreshChartOfCostCenters();
            }
        };
    }
