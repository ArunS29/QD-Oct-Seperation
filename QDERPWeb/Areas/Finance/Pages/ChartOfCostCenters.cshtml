                e.cellElement.css("font-weight", "bold");
            }
        }
             function handleGridContentReady(e){

             
                e.component.getDataSource().store().load().then(function (fullData) {
                    updateCards(fullData);
                });

        }
                function updateCards(data) {
            const now = new Date();
            const currentYear = now.getFullYear();
            const currentMonth = now.getMonth();

            const masterGroupCount = {};
            const creditGroupCount = {};

            let totalCount = 0;
            let monthCount = 0;
            let yearCount = 0;

            data.forEach(item => {
                // === Count CostAllocationMasterGroup ===
                const masterGroup = item.CostAllocationMasterGroup || "Unknown";
                masterGroupCount[masterGroup] = (masterGroupCount[masterGroup] || 0) + 1;

                // === Count CostAllocationGroup ===
                const creditGroup = item.CostAllocationGroup || "Unknown";
                creditGroupCount[creditGroup] = (creditGroupCount[creditGroup] || 0) + 1;

                // === Count CostAllocationUnitId based on CreatedOn ===
                if (item.CostAllocationUnitId) {
                    const createdOn = new Date(item.CreatedOn);
                    if (!isNaN(createdOn)) {
                        totalCount++;

                        if (createdOn.getFullYear() === currentYear) {
                            yearCount++;

                            if (createdOn.getMonth() === currentMonth) {
                                monthCount++;
                            }
                        }
                    }
                }
            });

            const format = num => num.toLocaleString(undefined, {
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            });

            // === CardDebit: Top 3 CostAllocationMasterGroup ===
            const topMasterGroups = Object.entries(masterGroupCount)
                .sort((a, b) => b[1] - a[1])
                .slice(0, 3);

            const debitSlider = $("#cardDebit .value-slider span");
            const debitOverlay = $("#cardDebit .overlay .detail");

            topMasterGroups.forEach(([group, count], i) => {
                debitSlider.eq(i).html(`<strong>${group}: ${format(count)}</strong>`);
                debitOverlay.eq(i).html(`${group}: ${format(count)}`);
            });

            // === CardCredit: Top 3 CostAllocationGroup ===
            const topCreditGroups = Object.entries(creditGroupCount)
                .sort((a, b) => b[1] - a[1])
                .slice(0, 3);

            const creditSlider = $("#cardCredit .value-slider span");
            const creditOverlay = $("#cardCredit .overlay .detail");

            topCreditGroups.forEach(([group, count], i) => {
                creditSlider.eq(i).html(`<strong>${group}: ${format(count)}</strong>`);
                creditOverlay.eq(i).html(`${group}: ${format(count)}`);
            });

            // === CardVoucher: Total / Month / Year based on CreatedOn ===
            const voucherSlider = $("#cardVoucher .value-slider span");
            const voucherOverlay = $("#cardVoucher .overlay .detail");

            voucherSlider.eq(0).html(`<i class="fa-solid fa-briefcase"></i> Total: ${format(totalCount)}`);
            voucherSlider.eq(1).html(`<i class="fa-solid fa-briefcase"></i> This Month: ${format(monthCount)}`);
            voucherSlider.eq(2).html(`<i class="fa-solid fa-briefcase"></i> This Year: ${format(yearCount)}`);

            voucherOverlay.eq(0).html(`<i class="fa-solid fa-briefcase"></i> Total: ${format(totalCount)}`);
            voucherOverlay.eq(1).html(`<i class="fa-solid fa-briefcase"></i> This Month: ${format(monthCount)}`);
            voucherOverlay.eq(2).html(`<i class="fa-solid fa-briefcase"></i> This Year: ${format(yearCount)}`);

            
        }

</script>








