@page
@model QD.ERP.Web.Areas.Finance.Pages.Index1Model
@{
}
<style>

.signatory-form-container {
    background-color: #f7fafd;
    border: 1px solid #dce3ed;
    border-radius: 10px;
    padding: 20px;
    margin: 20px auto;
    max-width: 1200px;
    box-shadow: 0 0 10px rgba(0,0,0,0.08);
    font-family: 'Segoe UI', sans-serif;
}

.signatory-form-container h2 {
    font-weight: 600;
    margin-bottom: 20px;
    color: #333;
    border-bottom: 1px solid #ccc;
    padding-bottom: 5px;
}

.form-section .row {
    display: flex;
    gap: 20px;
    margin-bottom: 15px;
}

.form-section .col {
    flex: 1;
    min-width: 250px;
}

.image-uploader {
    padding-top: 6px;
}

.grid-section {
    margin-top: 30px;
}

.signature-img {
    width: 100px;
    height: auto;
    border: 1px solid #ccc;
    padding: 2px;
    border-radius: 4px;
    background-color: #fff;
}

.button-footer {
    margin-top: 20px;
    display: flex;
    gap: 10px;
}

.add-btn {
    margin-top: 8px;
}

    .dropdown-container {
        flex: 1; /* Makes it flexible within the row */
        min-width: 250px;
    }

    .custom-dropdown {
        width: 100% !important;
        min-width: 250px;
        max-width: 100%;
    }
</style>
@* @model YourNamespace.ViewModels.SignatoryViewModel
@using DevExtreme.AspNet.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers *@

<link href="~/css/signatory.css" rel="stylesheet" />

<div class="signatory-form-container">
    <h2>Database Master: Signatories</h2>
    
    <div class="form-section">
        <div class="row">
            <div class="col">
                @(Html.DevExtreme().TextBox()
                    .ID("signatoryName")
                    .Placeholder("Signatory Name")
                )
            </div>
            <div class="col">
                @(Html.DevExtreme().TextBox()
                    .ID("signatoryNameArabic")
                    .Placeholder("Signatory Name (Arabic)")
                    .InputAttr("dir", "rtl")
                )
            </div>
            <div class="col image-uploader">
                @(Html.DevExtreme().FileUploader()
                    .ID("signatureImageUploader")
                    .SelectButtonText("Add Signature Image")
                    .LabelText("")
                    .Accept("image/*")
                    .UploadMode(FileUploadMode.Instantly)
                    .UploadUrl(Url.Action("UploadSignatureImage"))
                )
            </div>
        </div>

        <div class="row">
            <div class="col">
                @(Html.DevExtreme().TextBox()
                    .ID("signatoryPosition")
                    .Placeholder("Signatory Position")
                )
            </div>
            <div class="col">
                @(Html.DevExtreme().TextBox()
                    .ID("signatoryPositionArabic")
                    .Placeholder("Signatory Position (Arabic)")
                    .InputAttr("dir", "rtl")
                )
            </div>
        </div>

        <div class="row">
            <div class="col">
                @(Html.DevExtreme().TextBox()
                    .ID("signatoryContact")
                    .Placeholder("Signatory Contact No.")
                )
            </div>
            <div class="col">
                @(Html.DevExtreme().TextBox()
                    .ID("signatoryEmail")
                    .Placeholder("Signatory Email")
                )
            </div>
            
            <div class="col d-flex align-items-end">
                <button class="btn btn-success add-btn">
                    <i class="dx-icon dx-icon-plus"></i> Add
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col dropdown-container">
                @(Html.DevExtreme().DropDownBox()
                    .ID("signatoryUserId")
                    .Placeholder("Signatory User ID")
                    @*  .DataSource(Model.UserList) *@
                    .DisplayExpr("UserName")
                    .ValueExpr("UserId")
                    .Width("100%")
                    )
            </div>
            </div>
    </div>

    <div class="grid-section">
        @(Html.DevExtreme().DataGrid()
            .ID("signatoryGrid")
            .DataSource(new JS("[]"))
            .ShowBorders(true)
            .Columns(columns => {
                columns.Add().DataField("ID").Caption("ID").Width(60);
                columns.Add().DataField("SignatoryName").Caption("Name");
                columns.Add().DataField("SignatoryPosition").Caption("Position");
                columns.Add().DataField("SignatoryContact").Caption("Contact");
                columns.Add().DataField("SignatoryEmail").Caption("Email");
                columns.Add().Caption("Signature").CellTemplate(@<text>
                    <img src="<%- data.SignatureImageUrl %>" alt="No image" class="signature-img" />
                </text>);
            })
        )
    </div>

    <div class="button-footer">
        <button class="btn btn-primary">Update</button>
        <button class="btn btn-secondary">Back</button>
    </div>
</div>
