@page
@model QD.ERP.Web.Areas.Finance.Pages.SalesPersonMasterModel
@{
}
@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Add SweetAlert CSS and JS CDN -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.js"></script>

<style type="text/css">
    /* Card container styling */
    .card-container {
        background-color: white; /* Set background color for the card */
        padding: 20px; /* Add some padding inside the card */
        border-radius: 8px; /* Rounded corners */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Soft shadow for the card */
    }

        /* Label text color blue */
        .card-container label {
            color: blue; /* Set label text color to blue */
        }

    .dx-selectbox .dx-texteditor-input {
        text-align: center; /* Centers the text inside the input */
    }

    .button-alignment-down {
        margin-bottom: 10px;
    }

    /* Centering the Action Buttons (Save and Refresh) */
    .action-buttons-container {
        display: flex;
        justify-content: center;
        align-items: center; /* Ensures button is vertically centered */
        margin-top: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    /* Center the Add Button in its container */
    .add-button-container {
        display: flex;
        justify-content: center; /* Center the button horizontally */
        align-items: center; /* Center the button vertically */
        margin-top: 20px;
    }

    .no-border-input {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        font-weight: bold;
        font-size: 16px;
        color: black;
        pointer-events: none; /* Prevents hover and click effects */
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
        background-color: aliceblue;
    }

    .mainContainer {
        margin-top: 1em;
    }
</style>

    <div id="SalesPersonMaster" class="no-border-input"></div>
<div class="content-container-top">
    <div class="container">
        <div class="col-md-8">
                    <div class="form-group">
                        @(
                            Html.DevExtreme().TextBox()
                            .ID("txtSalesPersonName")
                            .Label(new JS("formatMessage('Type a new SalesPerson/ Project Manager & Add to the Existing List')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .Value(null)
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired()
                                .Message(new JS("formatMessage('Sales Person Name is required')"));
                            })
                            )
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @(
                            Html.DevExtreme().DropDownBox()
                            .Label(new JS("formatMessage('User Code')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("DDlUserId") // Set the ID for the SelectBox
                            .DataSource(d => d.WebApi()
                            .Controller("Master")
                            .LoadAction("GetUserddl")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("UserId")  // Ensure this matches the key field returned by the API
                            )
                            .ValidationRules(rules =>
                            {
                                rules.AddRequired()
                                .Message(new JS("formatMessage('User Code is required')"));
                            })
                            .Placeholder(new JS("formatMessage('Please Select UserCode')"))
                            .ShowClearButton(true)
                            .AcceptCustomValue(true)
                            .OpenOnFieldClick(true)
                            .ValueChangeEvent("input")
                            .HoverStateEnabled(true)
                            .ValueExpr("UserId")
                            .DisplayExpr("UserId")
                            .OnInput("dropDownBoxOnInput")
                            .OnOpened("onOpened")
                            .TabIndex(1)
                            .OnKeyDown("onKeyDown")
                            .ContentTemplate(new TemplateName("ClientNameContentTemplate"))
                            )
                    </div>

                    @using (Html.DevExtreme().NamedTemplate("ClientNameContentTemplate"))
                    {
                        @(Html.DevExtreme().DataGrid()
                            .ID("clientname-datagrid")
                            .DataSource(d => d.WebApi()
                            .Controller("Master")
                            .LoadAction("GetUserddl")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("UserId")  // Ensure this matches the key field returned by the API
                            )
                            .WordWrapEnabled(true)
                            .ShowBorders(true)
                            .SearchPanel(sp => sp.HighlightSearchText(true))
                            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                            .OnSelectionChanged("dataGridSelectionChanged")
                            .OnInitialized("dataGridInitialized")
                            .HeaderFilter(p => p.Visible(true))
                            .ShowBorders(true)
                            .HoverStateEnabled(true)
                            .Paging(p => p.PageSize(15))
                            .FilterRow(f => f.Visible(true))
                            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                            .Height(345)
                            .Selection(s => s.Mode(SelectionMode.Single))
                            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                            .Columns(columns =>
                            {
                                columns.Add().DataField("UserId");  // Ensure this matches the data field returned by the API
                                columns.Add().DataField("UserName").Alignment(HorizontalAlignment.Center);
                            })
                            )
                    }

                </div>
            </div>

            <div class="row g-6">
                <div class="col-md-4">
                    <div class="form-group">
                        @(
                            Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessage('Email Address')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("txtEmailAddress")
                            .OnChange("validateEmail")
                            .Value(null)
                           @*  .ValidationRules(rules =>
                            {
                                rules.AddRequired()
                                .Message("Email is required");
                            }) *@
                            )
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @(
                            Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessage('Contact Number')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("txtSalesPersonContactNo")
                            //.OnChange("validateContactNumber")
                            .Value(null)
                        
                            )
                    </div>
                </div>
                <!-- Add SalesPerson Code input field -->
                <div class="col-md-4">
                    <div class="form-group">
                        @(
                            Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessage('SalesPerson/ Project Manager Code')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .ID("txtSalesPersonCode")
                            .Value(null)
                            )
                    </div>
                </div>
            </div>

            <!-- Add Button Container -->
            <div class="add-button-container">
                <div class="form-group">
                    @(Html.DevExtreme().Button()
                        .ID("btnAddSalesPerson")
                        .Text("ADD")
                        .Height(70)
                        .Width(178)
                        .Icon("plus")
                        .OnClick("function() { addSalesPerson(); }")
                        .ElementAttr(new { @class = "dx-button-add" })
                        )
                </div>
            </div>
           <div class="clear"></div>
            <br />
            <div id="gridContainer"></div>
        </div> <!-- End of card-container -->

<script type="text/javascript">
        $(function () {
                                        $("#SalesPersonMaster").dxTextBox({
                                                    text:formatMessage("Sales Person Master"),
                                                readOnly: true

                                });
                        });
 
    $(function () {
        var updatedRows = []; // To store the updated rows

        // Initialize DevExtreme DataGrid with CustomStore
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "SalesPersonCode",
                load: function () {
                    return $.getJSON('/api/Master/GetSalesPersons'); // Fetch data from the API
                },
                update: function (key, values) {
                    // Initialize an object to store only changed fields
                    var updatedSalesPerson = { SalesPersonCode: key };

                    // Only add changed fields to the update object
                    if (values.SalesPersonName) updatedSalesPerson.SalesPersonName = values.SalesPersonName;
                    if (values.UserCode !== undefined) updatedSalesPerson.UserCode = values.UserCode;  // Check for undefined to avoid sending unchanged data
                    if (values.EmailAddress) updatedSalesPerson.EmailAddress = values.EmailAddress;
                    if (values.SalesPersonContactNo) updatedSalesPerson.SalesPersonContactNo = values.SalesPersonContactNo;

                    // Send the updated data to the backend via AJAX
                    return $.ajax({
                        type: "POST",
                        url: "/api/Master/UpdateSalesPerson",
                        data: JSON.stringify(updatedSalesPerson),
                        contentType: "application/json",
                        success: function (response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Sales Person Updated',
                                text: 'The sales person has been successfully updated.',
                                confirmButtonText: 'OK'
                            });
                        },
                        error: function (xhr) {
                            var errorMessage = xhr.status === 500
                                ? "Server error: Please try again later."
                                : "Validation error: " + "Invalid User Code";//xhr.responseText;
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: errorMessage,
                                confirmButtonText: 'OK'
                            });
                        }
                    });
                }
            }),
            editing: {
                mode: "batch", // Enable batch edit mode for multiple row editing
                allowUpdating: true, // Allow cell updates
                allowAdding: false,  // No new rows
                allowDeleting: false, // Prevent row deletion
                useIcons: true, // Use icons for save/cancel
                texts: {
                    saveAll: "Update", // Custom text for save button
                    cancelAll: "Cancel All Changes" // Custom text for cancel button
                }
            },
            columns: [

                // {
                //     dataField: "UserCode",
                //     caption: "User Code",
                //     allowFiltering: false,
                //     lookup: {
                //         dataSource: function () {
                //             return $.getJSON("/api/Master/GetUserddl");  // Fetching values dynamically from the API
                //         },
                //         valueExpr: "UserId",  // The value to be stored in the column
                //         displayExpr: "UserId",  // The value to be displayed in the dropdown
                //         allowClearing: true  // Allow clearing the selected value
                //     }
                // },
                { dataField: "UserCode", caption: "User Code", allowFiltering: false },
                { dataField: "SalesPersonName", caption: "Sales Person Name", allowFiltering: false },
                { dataField: "EmailAddress", caption: "Email Address", allowFiltering: false },
                { dataField: "SalesPersonContactNo", caption: "Sales Person Contact Number", allowFiltering: false }
            ],
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: {
                visible: false,
                applyFilter: "auto"
            },
            toolbar: {
                items: [
                    {
                        widget: "dxButton",
                        options: {
                            icon: "save",  // Icon for the Save button
                            text: "Update",  // Text alongside the icon
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").saveEditData();  // Save all changes
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",  // Adding Cancel button
                        options: {
                            icon: "close",  // Icon for Cancel button
                            text: "Cancel",  // Text for Cancel button
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").cancelEditData();  // Cancel all edits
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton", // Add the Back button
                        options: {
                            icon: "arrowleft", // You can choose another icon if you'd like
                            text: "Back",
                            onClick: function () {
                                window.close(); // This closes the current window/tab
                            }
                        },
                        location: "after"
                    }
                ]
            },
            onRowUpdated: function (e) {
                Swal.fire({
                    icon: 'success',
                    title: 'Row Updated',
                    text: 'The row data was successfully updated.',
                    confirmButtonText: 'OK'
                });
            },
            onRowRemoved: function (e) {
                Swal.fire({
                    icon: 'info',
                    title: 'Row Removed',
                    text: 'The row has been removed from the grid.',
                    confirmButtonText: 'OK'
                });
            },
            height: 400,
            width: "100%"
        });
    });


// Function to handle adding a new salesperson
function addSalesPerson() {
   
   
    var salesPersonName = $("#txtSalesPersonName").dxTextBox("instance").option("value");

        var ddbInstance = $("#DDlUserId").dxDropDownBox("instance");

        var userCode = ddbInstance.option("value");
       
    var emailAddress = $("#txtEmailAddress").dxTextBox("instance").option("value");
    var salesPersonContactNo = $("#txtSalesPersonContactNo").dxTextBox("instance").option("value");
    var SalesPersonCode = $("#txtSalesPersonCode").dxTextBox("instance").option("value");

    var ddbInstancevalidator = $("#DDlUserId").dxValidator("instance");
    var ddluservalidation = ddbInstancevalidator.validate();

        var SalesPersonvalidator = $("#txtSalesPersonName").dxValidator("instance");
        var Salespersonuservalidation = SalesPersonvalidator.validate();

        if (ddluservalidation.isValid && Salespersonuservalidation.isValid ) {

            // If all fields are valid, proceed with sending the data
            var salesPersonData = {
                SalesPersonName: salesPersonName,
                UserCode: userCode,
                EmailAddress: emailAddress,
                SalesPersonContactNo: salesPersonContactNo,
                SalesPersonCode: SalesPersonCode
            };
            console.log(salesPersonData);
 
            $.ajax({
                type: "POST",
                url: "/api/Master/AddSalesPerson",
                data: JSON.stringify(salesPersonData),
                contentType: "application/json",
                success: function (response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Sales Person Added Successfully',
                        text: 'The new sales person has been added to the list.',
                        confirmButtonText: 'OK'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                },
                error: function (xhr) {
                    var errorMessage = xhr.status === 500
                     
                       

                     Swal.fire({
                                    icon: 'error',
                        title: 'Duplicate SalesPerson/ Project Manager Code',
                        text: 'This SalesPerson/ Project Manager Code already exists! Please choose a different name.',
                                    confirmButtonText: 'OK'
                                
                                });
                }
            });
        } else {
            DevExpress.ui.notify("Please fill required details!", "error", 2000);
        }

  

   

  
}

// Function to handle updating an existing salesperson
function updateSalesPerson() {
    var salesPersonName = $("#txtSalesPersonName").dxTextBox("instance").option("value");
    var userCode = $("#txtUserCode").dxTextBox("instance").option("value");
      var emailAddress = $("#txtEmailAddress").dxTextBox("instance").option("value");
    var salesPersonContactNo = $("#txtSalesPersonContactNo").dxTextBox("instance").option("value");
    var SalesPersonCode = $("#txtSalesPersonCode").dxTextBox("instance").option("value");

    // Validate if all required fields are filled
    if (!salesPersonName || !userCode || !emailAddress || !salesPersonContactNo || !SalesPersonCode) {
        Swal.fire({
            icon: 'warning',
            title: 'Incomplete Form',
            text: 'Please fill in all fields before submitting.',
            confirmButtonText: 'OK'
        });
        return; // Stop further processing if fields are not filled
    }


    // If all fields are valid, proceed with sending the data
    var salesPersonData = {
        SalesPersonName: salesPersonName,
        UserCode: userCode,
        EmailAddress: emailAddress,
        SalesPersonContactNo: salesPersonContactNo,
        SalesPersonCode: SalesPersonCode
    };

    $.ajax({
        type: "POST",
        url: "/api/Master/UpdateSalesPerson", // Update endpoint
        data: JSON.stringify(salesPersonData),
        contentType: "application/json",
        success: function (response) {
            Swal.fire({
                icon: 'success',
                title: 'Sales Person Updated',
                text: 'The salesperson data has been successfully updated.',
                confirmButtonText: 'OK'
            }).then((result) => {
                if (result.isConfirmed) {
                    location.reload();
                }
            });
        },
        error: function (xhr) {
            var errorMessage = xhr.status === 500
                ? "Server error: Please try again later."
                : "Validation error: " + xhr.responseText;

            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMessage,
                confirmButtonText: 'OK'
            });
        }
    });
}
 

    function dataGridSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#ClientNameDropDown").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }

    }
    function dataGridSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#DDlUserId").dxDropDownBox("instance"); // Use the correct ID here

        if (selectedKey) {
            ddbInstance.option("value", selectedKey); // Set the value to selected key
            if (ddbInstance.option("opened")) {
                ddbInstance.close(); // Close the dropdown if open
            }
        }
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }
    function dataGridInitialized(e) {
        dataGrid = e.component;
    }
    function dataGridAccountHeadInitialized(e) {
        dataGrid = e.component;
    }


    // Function to validate email format
    function validateEmail() {
        // Get the email value from the DevExtreme TextBox
        const email = $("#txtEmailAddress").dxTextBox("instance").option("value");

        // Create a temporary input element to validate the email
        const tempInput = document.createElement("input");
        tempInput.type = "email";
        tempInput.value = email;

        // Check if the email is valid
        if (!tempInput.checkValidity()) {
            DevExpress.ui.notify({
                message: "Your Email ID is Invalid",
                type: "error",
                displayTime: 3000
                
            });

            // Clear the email input field
            $("#txtEmailAddress").dxTextBox("instance").option("value", "");
        } else {
            DevExpress.ui.notify({
                message: "Your Email ID is valid",
                type: "success",
                displayTime: 3000,
                position: { my: "top right", at: "top right", of: window, offset: "0 30" }
            });
        }
    }

    // Function to validate the contact number (basic validation)
    function validateContactNumber() {
        // Get the contact number from the DevExtreme TextBox
        const contactNumber = $("#txtSalesPersonContactNo").dxTextBox("instance").option("value");

        // Regular expression for validating a 10-digit contact number
        const regex = /^[0-9]{10}$/;

        // Check if the contact number is valid
        if (!regex.test(contactNumber)) {
            DevExpress.ui.notify({
                message: "Please enter a valid 10-digit contact number.",
                type: "error",
                displayTime: 3000,
                position: { my: "top right", at: "top right", of: window, offset: "0 50" }
            });

            // Clear the contact number input field
            $("#txtSalesPersonContactNo").dxTextBox("instance").option("value", "");
        } else {
            DevExpress.ui.notify({
                message: "Contact Number is valid.",
                type: "success",
                displayTime: 3000,
                position: { my: "top right", at: "top right", of: window, offset: "0 50" }
            });

           
        }
    }

</script>

