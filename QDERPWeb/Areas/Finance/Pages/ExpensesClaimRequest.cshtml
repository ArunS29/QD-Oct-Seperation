function generateVoucherNo() {
        const radioGroupInstance = $("#radioGroup").dxRadioGroup("instance");
        const selectedPaymentType = radioGroupInstance.option("value");
    const grid = $("#dataGrid").dxDataGrid("instance");
    const data = grid.getDataSource().items();
    const claimRefNo = $("#VoucherNo").dxTextBox("instance").option("value");
        const accountHeadInstance = $("#ddAccountHead").dxDropDownBox("instance");
        const selectedAccountHead = accountHeadInstance.option("value");


    const hasValidAmounts = data.some(row => {
        return (row.ClaimedAmount && row.ClaimedAmount > 0) || (row.ApprovedAmount && row.ApprovedAmount > 0);
    });
    const hasValidAccount = data.some(row => {
        return (row.AccountId);
    }); 
    const hasValidCost = data.some(row => {
        return (row.CostCenterCode);
    });
    if (!hasValidAmounts) {
        DevExpress.ui.dialog.alert("Please check your Claim Request, no amount to submit the claim", "Claim Amount Invalid");
        return;
    }
    
    if (!claimRefNo) {
        DevExpress.ui.dialog.alert("Claim Reference No. is missing.", "Missing Reference");
        return;
    }
      
       


    // Step 1: Check if IsApproved = true using API
    $.ajax({
        url: `/api/ExpenseClaim/IsClaimApproved?claimRefNo=${encodeURIComponent(claimRefNo)}`,
        method: "GET",
        success: function (isApproved) {
            if (!isApproved) {
                DevExpress.ui.dialog.alert("Claim is not yet Approved , Please get it approved and continue for Payment.", "Approval Required");
                return;
            }
            if (!hasValidAccount) {
        DevExpress.ui.dialog.alert("Please review the Claim, Some Ledger Account is not chosen", "Choose Ledger Accounts");
        return;
    }
    if (!hasValidCost) {
        DevExpress.ui.dialog.alert("Please review the Claim, Some Cost Center Code is not chosen", "Choose Cost Center");
        return;
    }
            // Step 2: Proceed with voucher number generation
            let apiUrl = "";
            if (selectedPaymentType === "Cash Payment") {
                apiUrl = "/api/ExpenseClaim/GetNewCPVoucherNo";
            } else if (selectedPaymentType === "Bank Payment") {
                apiUrl = "/api/ExpenseClaim/GetNewBPVoucherNo";
            } else {
                    DevExpress.ui.dialog.alert("Please select a payment type.", "Validation Error");

                    // Show visual validation error
                    radioGroupInstance.option("isValid", false);
                    radioGroupInstance.option("validationError", { message: "Payment type is required." });

                    return;
            }
                if (!selectedAccountHead) {
                    DevExpress.ui.dialog.alert("Cannot continue with saving the errors.<br/>Please clear the errors and continue.", "Validation Error");

                    // Show visual validation error by setting a custom invalid state
                    accountHeadInstance.option("isValid", false);
                    accountHeadInstance.option("validationError", { message: "Please select a Payment Account." });

                    return;
                } else {
                    // Reset validation if previously set
                    accountHeadInstance.option("isValid", true);
                }

            $.ajax({
                url: apiUrl,
                method: "GET",
                success: function (data) {
                    $("#GenerateVoucher").dxTextBox("instance").option("value", data);

                },
                error: function () {
                    DevExpress.ui.notify("Failed to generate voucher number.", "error", 2000);
                }
            });
        },
        error: function () {
            DevExpress.ui.dialog.alert("Failed to check claim approval status.", "Error");
        }
    });
}

    function disableclaim() {
        // 🔒 Disable DateBoxes and TextArea
        $("#claimerdate").dxDateBox("instance").option("disabled", true);
        $("#claimerEffectiveDate").dxDateBox("instance").option("disabled", true);
        $("#txtEntryNarration").dxTextArea("instance").option("disabled", true);

        // 🔒 Disable DataGrid editing
        $("#dataGrid").dxDataGrid("instance").option("editing", {
            allowUpdating: false,
            allowDeleting: false,
            mode: "cell",
            useIcons: true
        });

        // 🔒 Disable all buttons except #btnjournalBack
        $("button").not("#btnExpenceBack").prop("disabled", true);

        // If your DevExtreme buttons are not native <button> elements, use this instead:
        $(".dx-button").each(function () {
            const $btn = $(this);
            if (!$btn.closest("#btnExpenceBack").length) {
                $btn.dxButton("instance").option("disabled", true);
            }
        });
        // 🔒 Wait for grid content to be rendered and disable cell buttons
        setTimeout(function () {
            $("#dataGrid").find(".dx-button").each(function () {
                const instance = $(this).dxButton("instance");
                if (instance) {
                    instance.option("disabled", true);
                }
            });
        }, 100);

    }
    
