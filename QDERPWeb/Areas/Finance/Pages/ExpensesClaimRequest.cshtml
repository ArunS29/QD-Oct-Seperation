                <div style="margin-left:25px">Approved On:<span id="ApprovedOn"></span></div>

            </div>
            <div class="col-md-3">
                <div class="row">
                    <div>
                        @(Html.DevExtreme().CheckBox()
                            .ID("IsVerified")
                            )<span style="margin-left:5px">Verified By:</span>
                    </div>
                    <div style="margin-left:25px">Verified On:<span id="VerifiedOn"></span></div>
                </div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            @(
                Html.DevExtreme().SelectBox()
                .Label("Type of Claim:")
                .ID("ClaimType")
                .LabelMode(EditorLabelMode.Outside)
                .DataSource(new[] { "Expenses Claim Request" })
                .Value("Expenses Claim Request")
                 .Disabled(true)
                 .Width(200)
                 
                )  
                                              
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group" style="margin-left:30px;margin-top:25px">
                            @* <label for="ClaimRefNo">Claim Reference No</label> *@

                            @(
                                Html.DevExtreme().TextBox()
                                .ID("ClaimRefNo11")
                                .Value(null)
                                //.OnValueChanged("onVoucherNoChanged")
                                .ReadOnly(true)
                                .Width(100)
                                )

                        </div>
                    </div>


                </div>

            </div>
            <div class="col-md-2">
                <div class="form-group" style="padding-top: 30px;">
                    <!-- Radio Group --> @(Html.DevExtreme().RadioGroup()
                    .ID("radioGroup")
                    .Items(new[] { "Cash Payment", "Bank Payment" }) // Static items
                    .Value("null") // Default selected value
                    .Layout(Orientation.Horizontal)
                    .OnValueChanged("onRadioGroupValueChanged") // Attach JavaScript function
                    )

                    <div id="paymentOptions" style="margin-bottom: 20px;"></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row g-2">

                    <div class="col-md-8">
                        <div class="form-group">
                            <label for="SalesInvoiceNo">Purchase Voucher No</label>
                            @(
                                Html.DevExtreme().TextBox()
                                .ID("VoucherNo1")
                                .Value(null)
                                @* .OnValueChanged("onVoucherNoChanged") *@
                                .Disabled(true)
                                )
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div style="margin-top:25px;">
                            @(Html.DevExtreme().CheckBox()
                                .ID("IsPaid")
                                )<span style="margin-left:5px">Paid By:</span>
                        </div>
                        <div style="margin-left:25px">Paid On:<span id="PaidOn"></span></div>

                    </div>
                </div>
                <div class="form-group">
                    <label for="AccountHead">PaymentAccounts :</label>
                    @(Html.DevExtreme().DropDownBox()
                        
                        
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddAccountHead")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .Width(200)
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        .Width(1000)
                        )
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                        )
                </div>


            </div>
            <div class="col-md-2">
                <div class="form-group" style="padding-top:40px;">
                    @*  @(Html.DevExtreme().Button()
                    .ID("btnAttachment")
                    .Icon("fa fa-book")
                    .Text("Pay the Claim")
                    .Height(100)
                    .Width(130)
                    ) *@
                    @(Html.DevExtreme().Button()
                        .ID("btnPaytheClaim")
                        .Text("Pay the Claim")
                        .Icon("money")
                        .ElementAttr(new { @class = "bold-button" })
                        .OnClick("addRow")
                        )
                </div>
            </div>

        </div>

    </div>

    <div>
        @await Html.PartialAsync("_ExpenseFooter")
    </div>
</div>
