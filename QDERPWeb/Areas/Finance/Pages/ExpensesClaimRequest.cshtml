    function onexpenserowremoving(e) {
        const claimChildNo = e.data.ClaimChildNo;

        if (claimChildNo) {
            e.cancel = true; // Prevent default DevExtreme behavior

            $.ajax({
                url: '/api/ExpenseClaim/DeleteExpenseChild', // adjust path based on your area/controller
                type: 'POST',
                data: JSON.stringify(claimChildNo),
                contentType: 'application/json',
                success: function (response) {
