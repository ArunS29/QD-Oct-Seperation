function proceedWithSubmit() {

    const voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

    $.ajax({
        url: '/api/ExpenseClaim/SubmitClaim',
        method: 'POST',
         data: JSON.stringify({ ClaimRefNo: voucherNo }),
