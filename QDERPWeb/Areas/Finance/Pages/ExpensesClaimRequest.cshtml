@page
@model QD.ERP.Web.Areas.Finance.Pages.ExpensesClaimRequestModel
@{
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .dx-button-mode-contained.dx-button-default .dx-icon{
        color: var(--title-background-color);
    }
    .form-container {
        padding: 5px;
        border-radius: 8px;
        background-color: white;
        max-width: 900px;
        margin: auto;
        color:black;
    }

    table {
        width: 100%;
        border-spacing: 5px;
    }

        table td, th {
            vertical-align: top;
            padding: 3px;
        }

    input[type="text"], textarea {
        width: 100%;
        padding: 2px;
        box-sizing: border-box;
        border-radius: 2px;
        border: 1px solid #ccc;
        color: black;
    }

    textarea {
        resize: none;
    }

    .btn {
        background-color: #d4e6fb;
        color: #000;
        padding: 8px 16px;
        margin-right: 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
        width:100%;
    }

    .add-btn {
        background-color: #d4e6fb;
        color: #000;
        padding: 5px 12px;
        border: none;
        margin-left: 10px;
        cursor: pointer;
        font-size: 20px;
        vertical-align: top;
    }

    .narration-cell {
        position: relative;
    }

    /* .narration-cell a { */
    /*     a {
                    position: absolute;
                    right: 70px;
                    top: 8px;
                    color: white;
                    text-decoration: underline;
                    font-size: 14px;
                    cursor: pointer;
                } */

    .highlight {
        background-color: #ffffb3;
    }

    /* New styles for labels above inputs */
    .input-group {
        display: flex;
        flex-direction: column;
    }

        .input-group label {
            margin-bottom: 5px;
            font-weight: bold;
            color: black;
        }

    flex-row {
        display: flex;
        align-items: end;
    }
    .dropdown-box {
        position: absolute;
        background-color: #ffffff;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 16px;
        width: 50%;
        z-index: 9999;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .col {
        flex: 1;
        padding: 0 8px;
        min-width: 180px;
    }

    label {
        display: block;
        margin-bottom: 4px;
        font-weight: 600;
        color: #333;
    }

    .actions {
        justify-content: flex-end;
    }

        .actions .col {
            text-align: right;
        }

    .overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    /* ✅ Force borders for all cells in the grid */
    #dataGrid .dx-row > td {
        border: 1px solid #ddd !important;
    }

    /* ✅ Highlight empty row */
    #dataGrid .dx-row.dx-data-row:last-child {
        background-color: #f9f9f9; /* Light background to highlight empty row */
    }
    .displayFlex{
        display:flex;
    }

    .card-button .dx-icon {
        color: white; /* Bootstrap primary blue */
        background-color: #007BFF;
        border: 1px solid #007BFF; /* optional: add a border for visibility */
    }

    #calculateVATButton .dx-button-text {
        color: black !important;
    }

    #saveEntryButton .dx-button-text {
        color: black !important;
    }

    .dx-overlay-wrapper {
        z-index: 1050 !important; /* Or higher if necessary */
    }
</style>

<div class="title">
    <div class="header-container">
        <div id="ExpensesClaimRequest" class="no-border-title"></div>
    </div>
</div>

<div class="content-container">
    <div class="dx-fieldset horizontal-container">
        <div class="form-group">
            @(Html.DevExtreme().TextBox()
                .Label("Claim Reference No:")
                .LabelMode(EditorLabelMode.Outside)
                .ID("VoucherNo")
                .Value("")
                .ReadOnly(true)
                .ValidationRules(rules => { rules.AddRequired().Message("VoucherNo is required"); })
                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().DateBox()
                .Label("Claim Date:")
                .ID("claimerdate")
                .LabelMode(EditorLabelMode.Outside)
                .Type(DateBoxType.Date)
                .DisplayFormat("dd-MMM-yyyy")
                .Value(DateTime.Now)
                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().DateBox()
                .Label("Effective Date:")
                .ID("claimerEffectiveDate")
                .LabelMode(EditorLabelMode.Outside)
                .Type(DateBoxType.Date)
                .DisplayFormat("dd-MMM-yyyy")
                .Value(DateTime.Now)
                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().TextArea()
                .Label("Claim Remarks:")
                .LabelMode(EditorLabelMode.Outside)
                .ID("txtEntryNarration")
                .Value("")
                .Height(100)
                .Width(720)
                .Placeholder("Enter your comments here...")
                .MaxLength(500)
                )
        </div>
    </div>

    <div class="dx-fieldset horizontal-container">
        <div class="form-group">
            @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("CostAllocation")
                .LoadAction("GetCostAllocationUnits")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CostAllocationUnitId")
                )
                .Label("Claimed for Project/Jobs:")
                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBox")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change") // Detects changes in the dropdown
                .HoverStateEnabled(true)

                .ValueExpr("CostAllocationUnitId")
                .DisplayExpr("CostAllocationUnit")
                
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onclaimOpened")
                .Width(440)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(1000))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                )
        </div>
        <div class="form-group">
            @(
                Html.DevExtreme().SelectBox()
                .Label("Priority:")
                .ID("Priorityclaim")
                .LabelMode(EditorLabelMode.Outside)
                .DataSource(new[] { "Critical", "High", "Medium","Low" })
                .Value(null)
                )
        </div>
    </div>

    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl20103ExpenseClaimChild>()
            .ID("dataGrid")
            .Columns(columns =>
            {
                columns.AddFor(m => m.ClaimChildNo).Caption("Child No").Visible(false).AllowEditing(false);
                columns.AddFor(m => m.ExpenseDescription).Caption("Expense Description").Visible(true);
                columns.AddFor(m => m.BillRefNo).Caption("Bill Ref No");
                columns.AddFor(m => m.BillDate).Caption("Bill Date").AllowEditing(true).CellTemplate(@<text>
            <span>
                <%- data.BillDate ? DevExpress.localization.formatDate(new Date(data.BillDate), "dd-MMM-yyyy") : '' %>
            </span>
        </text>)
            // Edit Mode
            .EditCellTemplate(@<text>
            @(Html.DevExtreme().DateBox()
            .Type(DateBoxType.Date)
            .Value(new JS("data.BillDate")) // Default to today
            .OnValueChanged("setEffectiveDate") // Pass full data object
            .DisplayFormat("dd-MMM-yyyy")
            )
        </text>);
                columns.AddFor(m => m.ClaimedAmount)
                .Caption("Claimed Amount")
                .Alignment(HorizontalAlignment.Right)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }") // ✅ Fix: Prevent undefined error
                .AllowEditing(true) .EditCellTemplate(@<text>
        @(Html.DevExtreme().NumberBox()
            .ID("claimedAmountEditor")
            .Value(new JS("data.ClaimedAmount"))
            .Min(0)
            .ShowSpinButtons(false)
            .OnValueChanged("onClaimedAmountChanged")
            .Format("#,##0.00")
        )
    </text>);
                columns.AddFor(m => m.ApprovedAmount)
                .Caption("Approved Amount")
                .AllowEditing(true)
                .Alignment(HorizontalAlignment.Right)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }") .EditCellTemplate(@<text>
        @(Html.DevExtreme().NumberBox()
            .ID("approvedAmountEditor")
            .Value(new JS("data.ApprovedAmount"))
            .Min(0)
            .ShowSpinButtons(false)
            .OnValueChanged("onApprovedAmountChanged")
            .Format("#,##0.00")
        )
        </text>); 
                columns.Add().Caption("Action").Width(120)
    .CellTemplate(@<text>
            <div class="dropdown-wrapper">
                @(Html.DevExtreme().Button()
                .Icon("card")
                .Type(ButtonType.Default)
                .OnClick("onCardClick"))
            </div>
        </text>).Alignment(HorizontalAlignment.Center);

                columns.AddFor(m => m.AccountId).DataField("AccountHead").Caption("Account Ledger").Width(300)
            .CellTemplate(@<text>
            <span>
                <% if (data.AccountHead) { %>
                <%= data.AccountHead %>
                <% } else { %>
                <span style="color: black;">&lt;select Account Ledger&gt;</span>
                <% } %>
            </span>
        </text>)
        // Edit Mode
        .EditCellTemplate(@<text>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi().Controller("VoucherEntryCashReceipts")
                .LoadAction("GetEditAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBoxEdit")
                .ShowClearButton(false)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .HoverStateEnabled(true)
                .OnValueChanged("gridLedger_valueChanged")
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .Placeholder("Select AccountHead")
                .Width(350)
                .DropDownOptions(o => o.Width(800))
                .Value(new JS("data.AccountId"))
                .ContentTemplate(new TemplateName("ReceivingAccountDropdownContentTemplate"))
                )


            </div>

        </text>);



                columns.AddFor(m => m.CostCenterCode).DataField("CostAllocationUnit").Caption("Cost Center Code").Width(300)
            .CellTemplate(@<text>
            <span>
                <% if (data.CostAllocationUnit) { %>
                <%= data.CostAllocationUnit %>
                <% } else { %>
                <span style="color: black;">&lt;select Cost Center&gt;</span>
                <% } %>
            </span>
        </text>)
        // Edit Mode
        .EditCellTemplate(@<text>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi().Controller("ExpenseClaim")
                .LoadAction("GetEditCostCenter")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CostAllocationUnitId"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("CostDropDownBoxEdit")
                .ShowClearButton(false)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .HoverStateEnabled(true)
                .OnValueChanged("gridCost_valueChanged")
                .ValueExpr("CostAllocationUnitId")
                .DisplayExpr("CostAllocationUnit")
                .Placeholder("Select Cost Center")
                .Width(350)
                .DropDownOptions(o => o.Width(800))
                .Value(new JS("data.CostCenterCode"))
                .ContentTemplate(new TemplateName("CostDropdownContentTemplate"))
                )


            </div>

        </text>);
            })
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnFixing(fixing => fixing.Enabled(true))
            .Height(250)
            .Width("100%")
            .ColumnAutoWidth(true)
            .ShowBorders(true)
            .RowAlternationEnabled(true)
            .Editing(editing => editing
            .Mode(GridEditMode.Cell)
            .AllowUpdating(true)
            .AllowDeleting(true)
            .UseIcons(true)
            
            )
            .Summary(summary =>
            {
                summary.TotalItems(totalItems =>
                {
                    totalItems.Add().Column("ClaimedAmount").SummaryType(SummaryType.Sum)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
                    totalItems.Add().Column("ApprovedAmount").SummaryType(SummaryType.Sum)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
                });
            })
            .OnRowRemoving("onexpenserowremoving")
            )
    </div>
    <div class="container">
        <div class="row g-2">

            <div class="col-md-2">
                <div class="row">
                    <div class="displayFlex">
                        @(Html.DevExtreme().CheckBox()
                            .ID("IsSubmitted").Disabled(true)
                            )<span style="margin-left:5px">Submitted By:</span>
                        @(Html.DevExtreme().TextBox()
                            .ID("SubmittedBytext")
                            .Value(null)
                            .Disabled(true)
                            .Width(120))
                    </div>
                    <div style="margin-left:25px" class="displayFlex">
                        Submitted On:<span id="SubmittedOn"></span>
                        @(Html.DevExtreme().TextBox()
                            .ID("SubmittedOnDate")
                            .Value(null)
                            .Disabled(true)
                            .Width(120))
                    </div>
                </div>

                <div class="displayFlex">
                    @(Html.DevExtreme().CheckBox()
                        .ID("IsApproved").Disabled(true)
                        )<span style="margin-left:5px">Approved By:</span>
                    @(Html.DevExtreme().TextBox()
                        .ID("ApprovedBytext")
                        .Value(null)
                        .Disabled(true)
                        .Width(120))
                </div>
                <div style="margin-left:25px" class="displayFlex">Approved On:<span id="ApprovedOn"></span>
                    @(Html.DevExtreme().TextBox()
                        .ID("ApprovedOntext")
                        .Value(null)
                        .Disabled(true)
                        .Width(120))
                </div>

            </div>
            <div class="col-md-2">
                <div class="row">
                    <div class="displayFlex">
                        @(Html.DevExtreme().CheckBox().Disabled(true)
                            .ID("IsVerified")
                            )<span style="margin-left:5px">Verified By:</span>
                        @(Html.DevExtreme().TextBox()
                            .ID("VerifiedBytext")
                            .Value(null)
                            .Disabled(true)
                            .Width(120))
                    </div>
                    <div style="margin-left:25px" class="displayFlex">
                        Verified On:<span id="VerifiedOn"></span>
                        @(Html.DevExtreme().TextBox()
                            .ID("VerifiedOntext")
                            .Value(null)
                            .Disabled(true)
                            .Width(120))
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            @(
                                Html.DevExtreme().SelectBox()
                                .Label("Type of Claim:")
                                .ID("ClaimType")
                                .LabelMode(EditorLabelMode.Outside)
                                .DataSource(new[] { "Expenses Claim Request" })
                                .Value("Expenses Claim Request")
                                .Disabled(true)
                                .Width(200)

                                )

                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group" style="margin-left:65px;margin-top:24px">
                            @* <label for="ClaimRefNo">Claim Reference No</label> *@

                            @(
                                Html.DevExtreme().TextBox()
                                .ID("Voucher")
                                .Value(null)
                                //.OnValueChanged("onVoucherNoChanged")
                                .ReadOnly(true)
                                .Width(120)
                                )

                        </div>
                    </div>


                </div>

            </div>
            <div class="col-md-1">
                <div class="form-group" style="padding-top: 30px;">
                    <!-- Radio Group --> @(Html.DevExtreme().RadioGroup()
                    .ID("radioGroup")
                    .Items(new[] { "Cash Payment", "Bank Payment" }) // Static items
                    .Value(null) // Default selected value
                    .Layout(Orientation.Horizontal)
                    .OnValueChanged("onRadioGroupValueChanged") // Attach JavaScript function
                    )

                    <div id="paymentOptions" style="margin-bottom: 20px;"></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row">

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="SalesInvoiceNo"></label>
                            @(
                                Html.DevExtreme().TextBox()
                                .ID("GenerateVoucher")
                                .Value(null)
                               
                                .ReadOnly(true)
                                )
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="displayFlex">
                            @(Html.DevExtreme().CheckBox().Disabled(true)
                                .ID("IsPaid")
                                )<span style="margin-left:5px">Paid By:</span>
                            @(Html.DevExtreme().TextBox()
                                .ID("paidBytext")
                                .Value(null)
                                .Disabled(true)
                                .Width(120))
                        </div>
                        <div style="margin-left:25px" class="displayFlex">
                            Paid On:<span id="PaidOn"></span>
                            @(Html.DevExtreme().TextBox()
                                .ID("paidOntext")
                                .Value(null)
                                .Disabled(true)
                                .Width(120))
                        </div>

                    </div>
                </div>
                <div class="form-group">
                    <label for="AccountHead">PaymentAccounts :</label>
                    @(Html.DevExtreme().DropDownBox()


                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddAccountHead")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("AccountId")
                        .DisplayExpr("AccountHead")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onPaymentOpened")
                        .Width(200)
                        .TabIndex(1)
                        .DropDownOptions(o => o
                        .Width(1000)
                        )
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
                        )
                </div>


            </div>
            <div class="col-md-3">
                <div class="form-group" style="padding-top:40px;">
                    
                    @(Html.DevExtreme().Button()
                        .ID("btnPaytheClaim")
                        .Text("Pay the Claim")
                        .Icon("money")
                        .ElementAttr(new { @class = "bold-button" })
                        .Height(100)
                        .Width(100)
                        .OnClick("generateVoucherNo")
                        )
                </div>
            </div>

        </div>

    </div>
    <input id="formId" value="ExpenseClaimEdit" type="hidden" />
    <div>
        @await Html.PartialAsync("_ExpenseFooter")
    </div>
</div>
