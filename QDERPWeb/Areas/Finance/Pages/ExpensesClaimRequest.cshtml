@page
@model QD.ERP.Web.Areas.Finance.Pages.ExpensesClaimRequestModel
@{
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    /* ✅ Force borders for all cells in the grid */
    #dataGrid .dx-row > td {
        border: 1px solid #ddd !important;
    }

    /* ✅ Highlight empty row */
    #dataGrid .dx-row.dx-data-row:last-child {
        background-color: #f9f9f9; /* Light background to highlight empty row */
    }
</style>

<div class="title">
    <div class="header-container">
        <div id="ExpensesClaimRequest" class="no-border-title"></div>
    </div>
</div>

<div class="content-container">
    <div class="dx-fieldset horizontal-container">
        <div class="form-group">
            @(Html.DevExtreme().TextBox()
                .Label("Claim Reference No:")
                .LabelMode(EditorLabelMode.Outside)
                .ID("VoucherNo")
                .Value("")
                .ReadOnly(true)
                .ValidationRules(rules => { rules.AddRequired().Message("VoucherNo is required"); })
                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().DateBox()
                .Label("Claim Date:")
                .ID("claimerdate")
                .LabelMode(EditorLabelMode.Outside)
                .Type(DateBoxType.Date)
                .DisplayFormat("dd-MMM-yyyy")
                .Value(DateTime.Now)
                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().DateBox()
                .Label("Effective Date:")
                .ID("claimerEffectiveDate")
                .LabelMode(EditorLabelMode.Outside)
                .Type(DateBoxType.Date)
                .DisplayFormat("dd-MMM-yyyy")
                .Value(DateTime.Now)
                )
        </div>
        <div class="form-group">
            @(Html.DevExtreme().TextArea()
                .Label("Claim Remarks:")
                .LabelMode(EditorLabelMode.Outside)
                .ID("txtEntryNarration")
                .Value("")
                .Height(150)
                .Width(720)
                .Placeholder("Enter your comments here...")
                .MaxLength(500)
                )
        </div>
    </div>

    <div class="dx-fieldset horizontal-container">
        <div class="form-group">
            @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("CostAllocation")
                .LoadAction("GetCostAllocationUnits")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CostAllocationUnitId")
                )
                .Label("Claimed for Project/Jobs:")
                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBox")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("change") // Detects changes in the dropdown
                .HoverStateEnabled(true)

                .ValueExpr("CostAllocationUnitId")
                .DisplayExpr("CostAllocationUnit")
                
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .Width(440)
                .TabIndex(1)
                .DropDownOptions(o => o.Width(1000))
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                )
        </div>
        <div class="form-group">
            @(
                Html.DevExtreme().SelectBox()
                .Label("Priority:")
                .ID("Priorityclaim")
                .LabelMode(EditorLabelMode.Outside)
                .DataSource(new[] { "Critical", "High", "Medium","Low" })
                .Value(null)
                )
        </div>
    </div>

    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl20103ExpenseClaimChild>()
            .ID("dataGrid")
            .DataSource(d => d.WebApi()
            .Controller("ExpenseClaim") // Replace with your actual controller name
            .LoadAction("GetExpenseClaims")   // Controller action method name
            .LoadMode(DataSourceLoadMode.Raw)
            ) // Add an empty row
            .Columns(columns =>
            {
                columns.AddFor(m => m.ExpenseDescription).Caption("Expense Description").Visible(true);
                columns.AddFor(m => m.BillRefNo).Caption("Bill Ref No");
                columns.AddFor(m => m.BillDate).Caption("Bill Date").AllowEditing(true).CellTemplate(@<text>
            <span>
                <%- data.BillDate ? DevExpress.localization.formatDate(new Date(data.BillDate), "dd-MMM-yyyy") : '' %>
            </span>
        </text>)
            // Edit Mode
            .EditCellTemplate(@<text>
            @(Html.DevExtreme().DateBox()
            .Type(DateBoxType.Date)
            .Value(new JS("data.BillDate")) // Default to today
            .OnValueChanged("setEffectiveDate") // Pass full data object
            .DisplayFormat("dd-MMM-yyyy")
            )
        </text>);
                columns.AddFor(m => m.ClaimedAmount)
                .Caption("Claimed Amount")
                .Alignment(HorizontalAlignment.Right)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }") // ✅ Fix: Prevent undefined error
                .AllowEditing(true);
                columns.AddFor(m => m.ApprovedAmount)
                .Caption("Approved Amount")
                .AllowEditing(true)
                .Alignment(HorizontalAlignment.Right)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }"); // ✅ Fix applied
                columns.AddFor(m => m.AccountId).DataField("AccountHead").Caption("Account Ledger").Width(300)
            .CellTemplate(@<text>
            <span>
                <% if (data.AccountHead) { %>
                <%= data.AccountHead %>
                <% } else { %>
                <span style="color: black;">&lt;select Account Ledger&gt;</span>
                <% } %>
            </span>
        </text>)
        // Edit Mode
        .EditCellTemplate(@<text>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi().Controller("VoucherEntryCashReceipts")
                .LoadAction("GetEditAccountHead")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("accountDropDownBoxEdit")
                .ShowClearButton(false)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .HoverStateEnabled(true)
                .OnValueChanged("gridLedger_valueChanged")
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .Placeholder("Select AccountHead")
                .Width(350)
                .DropDownOptions(o => o.Width(800))
                .Value(new JS("data.AccountId"))
                .ContentTemplate(new TemplateName("ReceivingAccountDropdownContentTemplate"))
                )


            </div>

        </text>);



                columns.AddFor(m => m.CostCenterCode).DataField("CostAllocationUnit").Caption("Cost Center Code").Width(300)
            .CellTemplate(@<text>
            <span>
                <% if (data.CostAllocationUnit) { %>
                <%= data.CostAllocationUnit %>
                <% } else { %>
                <span style="color: black;">&lt;select Cost Center&gt;</span>
                <% } %>
            </span>
        </text>)
        // Edit Mode
        .EditCellTemplate(@<text>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi().Controller("ExpenseClaim")
                .LoadAction("GetEditCostCenter")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CostAllocationUnitId"))
                .LabelMode(EditorLabelMode.Outside)
                .ID("CostDropDownBoxEdit")
                .ShowClearButton(false)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .HoverStateEnabled(true)
                .OnValueChanged("gridCost_valueChanged")
                .ValueExpr("CostAllocationUnitId")
                .DisplayExpr("CostAllocationUnit")
                .Placeholder("Select Cost Center")
                .Width(350)
                .DropDownOptions(o => o.Width(800))
                .Value(new JS("data.CostCenterCode"))
                .ContentTemplate(new TemplateName("CostDropdownContentTemplate"))
                )


            </div>

        </text>);
            })
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnFixing(fixing => fixing.Enabled(true))
            .Height(250)
            .ColumnAutoWidth(true)
            .ShowBorders(true)
            .RowAlternationEnabled(true)
            .Editing(editing => editing
            .Mode(GridEditMode.Cell)
            .AllowUpdating(true)
            .AllowDeleting(true)
            .UseIcons(true)
            )
            .Summary(summary =>
            {
                summary.TotalItems(totalItems =>
                {
                    totalItems.Add().Column("ClaimedAmount").SummaryType(SummaryType.Sum)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
                    totalItems.Add().Column("ApprovedAmount").SummaryType(SummaryType.Sum)
                .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
                });
            })
            
            )
    </div>
    <div class="container">
        <div class="row g-4">

            <div class="col-md-2">
                <div class="row">
                    <div>
                        @(Html.DevExtreme().CheckBox()
                            .ID("IsSubmitted")
                            )<span style="margin-left:5px">Submitted By:</span>
                    </div>
                    <div style="margin-left:25px">Submitted On:<span id="SubmittedOn"></span></div>
                </div>

                <div>
                    @(Html.DevExtreme().CheckBox()
                        .ID("IsApproved")
                        )<span style="margin-left:5px">Approved By:</span>
