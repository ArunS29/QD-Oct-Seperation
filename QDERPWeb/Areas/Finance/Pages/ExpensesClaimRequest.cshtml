    function getUrlParameter(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        let regex = new RegExp("[\\?&]" + name + "=([^&#]*)");
        let results = regex.exec(location.search);
        return results === null ? null : decodeURIComponent(results[1].replace(/\+/g, " "));
    }

    $(document).ready(function () {
        const voucherNoField = $("#VoucherNo").dxTextBox("instance");
        const dataGrid = $("#dataGrid").dxDataGrid("instance");

        function getVoucherNo() {
            return voucherNoField.option("value");
        }

        function addEmptyRowIfNeeded() {
            debugger;
            const dataSource = dataGrid.option("dataSource") || [];

            if (!Array.isArray(dataSource)) {
                return;
            }

            if (dataSource.length === 0 || Object.keys(dataSource[dataSource.length - 1]).length !== 0) {
                dataSource.push({
                    ClaimedAmount: 0.00,
                    ApprovedAmount: 0.00,
                    VoucherNo: getVoucherNo()
                });
                dataGrid.option("dataSource", dataSource);
            }
        }

        function initializeDataGrid(voucherNo) {
            $.ajax({
                url: "/api/ExpenseClaim/GetChildClaimsByVoucherNo",
                type: "GET",
                data: { voucherNo: voucherNo },
                success: function (data) {
                    dataGrid.option("dataSource", data);
                    addEmptyRowIfNeeded();
                }
            });

            dataGrid.option("onRowInserted", function (e) {
                e.data.ClaimRefNo = getVoucherNo();

                $.ajax({
                    url: "/api/ExpenseClaim/AddOrUpdateChildClaim",
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(e.data),
                    success: function () {
                        DevExpress.ui.notify("Row inserted successfully", "success", 1500);
                        // ✅ Reload updated data (with new ClaimChildNo, etc.)
                        $.ajax({
                            url: "/api/ExpenseClaim/GetChildClaimsByVoucherNo",
                            type: "GET",
                            data: { voucherNo: voucherNo },
                            success: function (data) {
                                dataGrid.option("dataSource", data);
                                addEmptyRowIfNeeded(); // Optional: keep extra row
                            },
                            error: function () {
                                DevExpress.ui.notify("Failed to reload data", "error", 1500);
                            }
                        });
                    },
                    error: function () {
                        DevExpress.ui.notify("Insert failed", "error", 1500);
                    }
                });

                addEmptyRowIfNeeded();
            });

            dataGrid.option("onRowUpdated", function (e) {
               
                e.data.ClaimRefNo = getVoucherNo();

                $.ajax({
                    url: "/api/ExpenseClaim/AddOrUpdateChildClaim",
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(e.data),
                    success: function () {
                        DevExpress.ui.notify("Row updated successfully", "success", 1500);
                        // ✅ Reload updated data (with new ClaimChildNo, etc.)
                        $.ajax({
                            url: "/api/ExpenseClaim/GetChildClaimsByVoucherNo",
                            type: "GET",
                            data: { voucherNo: voucherNo },
                            success: function (data) {
                                dataGrid.option("dataSource", data);
                                addEmptyRowIfNeeded();
                               
                            },
                            error: function () {
                                DevExpress.ui.notify("Failed to reload data", "error", 1500);
                            }
                        });
                    },
                    error: function () {
                        DevExpress.ui.notify("Update failed", "error", 1500);
                    }
                });
           
                    addEmptyRowIfNeeded();
                
            });

            dataGrid.option("onCellPrepared", function (e) {
                if (e.rowType === "data") {
                    if (e.column.dataField === "ClaimedAmount") {
                        e.cellElement.css({ "color": "red", "font-weight": "bold" });
                    }
                    if (e.column.dataField === "ApprovedAmount") {
                        e.cellElement.css({ "color": "green", "font-weight": "bold" });
                    }
                }
            });
        }
        const voucherNoFromUrl = getUrlParameter('claimRefNo');

        if (voucherNoFromUrl) {
            // ✅ Bind voucher number from URL
            voucherNoField.option("value", voucherNoFromUrl);
        } else {
            // ❌ If not available, generate new one
            $.ajax({
                url: '@Url.Action("GetNewClaimNo", "ExpenseClaim")',
                type: 'GET',
                success: function (data) {
                    voucherNoField.option("value", data);
                    initializeDataGrid(data);
                },
                error: function () {
                    alert("Error generating voucher number.");
                }
            });
        }

        // Helper to extract URL parameter
        function getUrlParameter(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            const regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            const results = regex.exec(window.location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }
    });
    let claimRefNo = null;
    let claimproject = null;
    let Accountname = null;

    $(document).ready(function () {
        claimRefNo = getUrlParameter('claimRefNo');
        var button = $("#btnSave").dxButton("instance");
        if (claimRefNo) {
            button.option("text", "Update");
        }

        if (claimRefNo) {
            $.ajax({
                url: '/api/ExpenseClaim/GetClaimmaster',
                type: 'GET',
                data: { claimRefNo: claimRefNo },
                success: function (data) {
                    const entry = data.find(d => d.ClaimRefNo === claimRefNo); // optional check
                    
                    if (entry) {
                        Accountname = entry.PaymentAccountname || null;
                        claimproject = entry.Claimedproject || null;
                        $("#VoucherNo").dxTextBox("instance").option("value", entry.ClaimRefNo);
                        $("#claimerdate").dxDateBox("instance").option("value", entry.ClaimDate);
                        $("#claimerEffectiveDate").dxDateBox("instance").option("value", entry.ClaimEffectiveDate ? new Date(entry.ClaimEffectiveDate) : new Date());
                        $("#txtEntryNarration").dxTextArea("instance").option("value", entry.ClaimRemarks);
                        $("#accountDropDownBox").dxDropDownBox("instance").option("value", entry.ProjectClaimedFor);
                        $("#ddAccountHead").dxDropDownBox("instance").option("value", entry.PaymentAccountname);
                        let radioGroup = $("#radioGroup").dxRadioGroup("instance");
                        radioGroup.option("value", entry.PaymentType);

                        if (entry.PaymentType) {
                            onRadioGroupValueChanged({ value: entry.PaymentType });
                        }

                        $("#IsSubmitted").dxCheckBox("instance").option("value", entry.IsSubmittedToFinance || false);
                        $("#SubmittedBytext").dxTextBox("instance").option("value", entry.SubmittedBy || "");
                        $("#IsVerified").dxCheckBox("instance").option("value", entry.IsVerified || false);
                        $("#VerifiedBytext").dxTextBox("instance").option("value", entry.VerifiedBy || "");
                        $("#IsApproved").dxCheckBox("instance").option("value", entry.IsApproved || false);
                        $("#ApprovedBytext").dxTextBox("instance").option("value", entry.ApprovedBy || "");
                        $("#IsPaid").dxCheckBox("instance").option("value", entry.IsPosted || false);
                        $("#paidBytext").dxTextBox("instance").option("value", entry.PostedBy || "");
                        var submittedDate = entry.SubmittedOn ? new Date(entry.SubmittedOn) : null;
                        var formattedsubmittedDate = submittedDate
                            ? submittedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
                            : "";

                        $("#SubmittedOnDate").dxTextBox("instance").option("value", formattedsubmittedDate);
                        var verifiedDate = entry.VerifiedOn ? new Date(entry.VerifiedOn) : null;
                        var formattedDate = verifiedDate
                            ? verifiedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
                            : "";

                        $("#VerifiedOntext").dxTextBox("instance").option("value", formattedDate);
                        var approvedDate = entry.ApprovedOn ? new Date(entry.ApprovedOn) : null;
                        var formattedApprovedDate = approvedDate
                            ? approvedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
                            : "";

                        $("#ApprovedOntext").dxTextBox("instance").option("value", formattedApprovedDate);
                        var postedDate = entry.PostedOn ? new Date(entry.PostedOn) : null;
                        var formattedPostedDate = postedDate
                            ? approvedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
                            : "";

                        $("#paidOntext").dxTextBox("instance").option("value", formattedPostedDate);
                        // $("#GeneratedVoucher").dxTextBox("instance").option("value", entry.PaymentVoucherNo);
                        // Disable DevExtreme buttons based on submission and verification date
                        const btnSubmit = $("#btnSubmit").dxButton("instance");
                        const btnVerify = $("#btnExpenseVerify").dxButton("instance");
                        const btnPostJournal = $("#btnPaytheClaim").dxButton("instance");

                        if (formattedsubmittedDate) {
                            btnSubmit.option("disabled", true);
                            btnPostJournal.option("disabled", true);
                        }

                        if (formattedDate) {
                            btnSubmit.option("disabled", true);
                            btnVerify.option("disabled", true);
                            btnPostJournal.option("disabled", true);
                        }
                        if (formattedApprovedDate) {
                            disableclaim();
                            btnPostJournal.option("disabled", false);
                        }
                        if (formattedPostedDate) {
                            disableclaim();

                        }


                        getchilddatas();
                    } else {
                        DevExpress.ui.notify("No entry found with the given reference number.", "warning", 3000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Failed to load journal entry from URL.", "error", 3000);
                }
            });
        } else {
            // DevExpress.ui.notify("Journal Reference Number is missing in the URL.", "error", 3000);
        }
    });

    function getchilddatas() {
