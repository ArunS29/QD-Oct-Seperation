        if (dataGridElement.length > 0) {
            let dataGrid = dataGridElement.dxDataGrid("instance");
            if (dataGrid) {
                dataGrid.option("dataSource", DevExpress.data.AspNet.createStore({
                    key: "AccountId",
                    loadUrl: "/api/ExpenseClaim/" + loadAction
                }));
            }
        }
    }

    
