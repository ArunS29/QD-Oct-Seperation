@page
@model QD.ERP.Web.Areas.Finance.Pages.DatabaseMasterModuleModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Goods and Services</title>
    <style>
        .dx-fieldset {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            padding: 15px;
            background-color: #e6eef7;
            width: 1200px;

        }

        .dx-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .field-label {
            font-weight: bold;
        }

        .aligned-input {
            width: 100%;
        }

        .dx-card {
            padding: 20px;
            background-color: #e6eef7;
            width: 90%;
            margin: auto;
            border-radius: 8px;
        }

        .input-group {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dx-textarea {
            width: 100%;
            height: 60px;
        }
        .dx-card{
            width : 1460px;
        }
         
        .limited-footer .btn-container:not(:has(#btnSave,#btnSaveAndClose,#btnPrint1,#btnDelete,#btnBack)) {
            display: none !important;
        }
    </style>
   
</head>
<body>
    <div class="dx-card">

        <div id="goodsServicesForm">
            <!-- Your entire form HTML here -->
     
        <h3>Goods and Services</h3>
        <!-- Row 1: Goods Code | Goods Group | Item Part No -->
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td>
                            <label class="field-label">Goods & Services Code:</label>
                            @(Html.DevExtreme().TextBox().ID("txtGoodsCode7").Width("100%"))
                        </td>
                        <td>
                            <label class="field-label">Goods & Services Group:</label>
                            @(Html.DevExtreme().DropDownBox()
                                .DataSource(d => d.WebApi()
                                .Controller("VATModule")
                                .LoadAction("GetGoodsAndServicesGroups") // This returns list of groups
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("GsgroupId") // ✅ Use correct primary key
                                )
                                .LabelMode(EditorLabelMode.Outside)
                                .ID("ddlGoodsGroup1")
                                .ShowClearButton(true)
                                .AcceptCustomValue(true)
                                .OpenOnFieldClick(false)
                                .ValueChangeEvent("input")
                                .OnValueChanged("onGoodsGroupChanged")
                                .HoverStateEnabled(true)
                                .ValueExpr("GsgroupId") // ✅ Set Value to Group ID
                                .DisplayExpr("GsgroupName") // ✅ Display actual group name
                                .OnInput("dropDownBoxOnInput")
                                .OnOpened("onOpened")
                                .DropDownOptions(o => o.Width(1000))
                                .ContentTemplate(new TemplateName("GoodsandServicesContentTemplate"))
                                .Width("85%")
                                )
                        </td>

                        <td style="padding-top:15px;">
                            @(Html.DevExtreme().Button().ID("btnAddGroup3").Icon("plus"))
                            
                        </td>
                        <td>
                            <label class="field-label">Item Part No:</label>
                            @(Html.DevExtreme().TextBox().ID("txtItemPartNo4").Width("100%"))
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <!-- Row 2: Description | Description (Arabic) -->
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td>
                            <label class="field-label">Goods & Services Description:</label>
                            @(Html.DevExtreme().TextArea().ID("txtDescription8").Width("100%").Height(60))
                        </td>
                        <td>
                            <label class="field-label">Goods & Services Description (in Arabic):</label>
                            @(Html.DevExtreme().TextBox().ID("txtDescriptionArabic").Width("100%").Height(60))
                            @(Html.DevExtreme().Button()
                                .ID("convertToArabic2")
                                .Width(40)
                                .Height(40)
                                .Icon("fas fa-language") // Ensure FontAwesome is properly loaded
                                .ElementAttr(new { @class = "input-button" })
                                .OnClick("function() { convertToArabic(); }")
                                )
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td>
                            <label class="field-label">Unit of Measure:</label>
                            @(Html.DevExtreme().DropDownBox()
                                .ID("ddlUnitMeasure9")
                                .Width("100%")
                                .DataSource(d => d.WebApi()
                                .Controller("VATModule")
                                .LoadAction("GetUnitofMeasure")
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("UnitCode") // ✅ Set correctly
                                )
                                .LabelMode(EditorLabelMode.Outside)
                                .ShowClearButton(true)
                                .AcceptCustomValue(true)
                                .OpenOnFieldClick(false)
                                .ValueChangeEvent("input")
                                .HoverStateEnabled(true)
                                .ValueExpr("UnitCode")      // ✅ Value bound to UnitCode
                                .DisplayExpr("UnitType")    // ✅ Display shows UnitType
                                .OnInput("dropDownBoxOnInput")
                                .OnOpened("onOpened")
                                .OnValueChanged("onUnitMeasureValueChanged") // Optional for tracking value
                                .DropDownOptions(o => o.Width(400))
                                .ContentTemplate(new TemplateName("UnitofMeasureContentTemplate"))
                                .Width("85%")
                                )
                        </td>

                        <td>
                            <label class="field-label">Packing Unit:</label>
                            @(Html.DevExtreme().NumberBox()
                                .ID("packingUnit")
                                .Value(1) // default
                                .Min(1)
                                .Step(1)
                                .ShowSpinButtons(true)
                                .Format("#") // no decimals
                                .Width(100)
                                )
                        </td>

                        <td>
                            <label class="field-label">Selling Rate:</label>
                            @(Html.DevExtreme().NumberBox()
                                .ID("sellingRate")
                                .Value(1)
                                .Min(1)
                                .Step(1)
                                .ShowSpinButtons(true)
                                .Format("#") // no decimals
                                .Width(100)
                                )
                        </td>

                        <td>
                            <label class="field-label">Cost Price:</label>
                            @(Html.DevExtreme().NumberBox()
                                .ID("txtCostPrice3")
                                .Value(1)
                                .Min(1)
                                .Step(1)
                                .ShowSpinButtons(true)
                                .Format("#") // no decimals
                                .Width("100%")
                                )
                        </td>

                    </tr>
                </table>
            </div>
        </div>
        <!-- Row 4: Detailed Description | Detailed Description (Arabic) -->
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td>
                            <label class="field-label">Detailed Description:</label>
                            @(Html.DevExtreme().TextArea().ID("txtDetailedDescription").Width("100%").Height(80))
                        </td>
                        <td>
                            <label class="field-label">Detailed Description (in Arabic):</label>
                            @(Html.DevExtreme().TextBox().ID("txtDetailedDescriptionArabic").Width("100%").Height(80))
                            @(Html.DevExtreme().Button()
                                .ID("convertToArabic1")
                                .Width(40)
                                .Height(40)
                                .Icon("fas fa-language") // Ensure FontAwesome is properly loaded
                                .ElementAttr(new { @class = "input-button" })
                                .OnClick("function() { convertToArabic(); }")
                                )
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="Head">
            <div class="limited-footer">
                @await Html.PartialAsync("VATModuleFooter")
            </div>
        </div>
    </div>

    @using (Html.DevExtreme().NamedTemplate("GoodsandServicesContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("accounthead-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("VATModule")
            .LoadAction("GetGoodsAndServicesGroups")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("GsgroupId")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            .SearchPanel(sp => sp.HighlightSearchText(true))
            .Selection(sl => sl.Mode(SelectionMode.Single))
            .OnSelectionChanged("dataGridAccountHeadSelectionChanged")
            .OnInitialized("dataGridAccountHeadInitialized")
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .FilterRow(f => f.Visible(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Columns(columns =>
            {
               

                columns.Add().DataField("GsgroupId")
                .Caption(new JS("formatMessage('Group')"))
                .Lookup(lookup => lookup
                .DataSource(ds => ds.WebApi()
                .Controller("VATModule")
                .LoadAction("GetGoodsAndServicesGroups") // You must implement this
                .Key("GsgroupId")
                )
                .ValueExpr("GsgroupId")
                .DisplayExpr("GsgroupName")
                );

               
            })
            )
    }

    @using (Html.DevExtreme().NamedTemplate("UnitofMeasureContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("unitofmeasure-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("VATModule")
            .LoadAction("GetUnitofMeasure")

            .LoadMode(DataSourceLoadMode.Raw)
            .Key("UnitCode")
            )
            .Selection(s => s.Mode(SelectionMode.Single))
            .HoverStateEnabled(true)
       
            .FilterRow(f => f.Visible(false))
            .Height(345)
            .Width("100%")
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .OnSelectionChanged("onUnitMeasureSelectionChanged")
            .Columns(columns =>
            {
             
                columns.Add().DataField("UnitType").Caption("Type");
             
            })
            .WordWrapEnabled(true)
            .ShowBorders(true)
            )
    }



    </div>
    
</body>
</html>
<script>

    function onUnitMeasureSelectionChanged(e) {
        const selected = e.selectedRowsData[0];
        if (selected) {
            const dropDownBox = $("#ddlUnitMeasure9").dxDropDownBox("instance");
            dropDownBox.option("value", selected.UnitCode); // Bind value
        }
    }
    function onUnitMeasureValueChanged(e) {
        const value = e.value;
        const component = e.component;

        // Try to get selectedItem first
        const selected = component.option("selectedItem");

        if (selected && selected.UnitName) {
            $("#txtUnitName").dxTextBox("instance").option("value", selected.UnitName);
        } else {
            // If selectedItem is not resolved, manually load the item from the data source
            const dataSource = component.getDataSource();
            dataSource.load().done(function (items) {
                const match = items.find(x => x.UnitCode === value);
                if (match) {
                    console.log("Manually matched item:", match);
                    $("#txtUnitName").dxTextBox("instance").option("value", match.UnitName);
                } else {
                    console.warn("Could not find matching item for value:", value);
                }
            });
        }
    }

      

     function dropDownBoxOnInput(e) {
                const ddbInstance = e.component;
                if (!ddbInstance.option("opened")) ddbInstance.open();


                const text = ddbInstance.option("text");
                if (dataGrid) {
                    dataGrid.option("searchPanel.text", text);
                }
            }

             function onOpened(e) {
                setTimeout(() => {
                    e.component.focus();
                });
            }

               function dataGridAccountHeadSelectionChanged(e) {
                const selectedKey = e.selectedRowKeys[0];
                const ddbInstance = $("#ddlGoodsGroup1").dxDropDownBox("instance");
                acchead = selectedKey;
                if (selectedKey) {
                    ddbInstance.option("value", selectedKey);
                    if (ddbInstance.option("opened")) {
                        ddbInstance.close();
                    }
                    var selectedRowData = $("#accounthead-datagrid").dxDataGrid("instance").getSelectedRowsData();
                    // Get ReferenceNo from selected row
                    if (selectedRowData.length > 0) {
                        

                    } else {
                        DevExpress.ui.notify("Please select a row from the grid!", "error", 2000);
                        return;
                    }
                }
            }


            function dataGridAccountHeadInitialized(e) {
                dataGrid = e.component;
            }
            async function convertToArabic() {
        // Get the instances of both text boxes
        const textBox1Instance = $("#txtDetailedDescription").dxTextBox("instance");
        const textBox2Instance = $("#txtDetailedDescriptionArabic").dxTextBox("instance");
        const textBox3Instance = $("#txtDescription").dxTextBox("instance");
        const textBox4Instance = $("#txtDescriptionArabic").dxTextBox("instance");

        // Ensure all instances are initialized
        if (!textBox1Instance || !textBox2Instance || !textBox3Instance || !textBox4Instance) {
            console.error("TextBox instances are not properly initialized.");
            return;
        }

        // Get values from English text boxes
        const englishText1 = textBox1Instance.option("value");
        const englishText2 = textBox3Instance.option("value");

        // Validate input
        if ((!englishText1 || englishText1.trim() === "") && (!englishText2 || englishText2.trim() === "")) {
            alert("Please enter text to translate.");
            return;
        }

        try {
            // Perform translations asynchronously
            const [arabicTranslation1, arabicTranslation2] = await Promise.all([
                translateToArabic(englishText1),
                translateToArabic(englishText2)
            ]);

            // Update Arabic text boxes with the translated text
            textBox2Instance.option("value", arabicTranslation1);
            textBox4Instance.option("value", arabicTranslation2);

        } catch (error) {
            console.error("Translation error:", error);
            alert("Translation failed. Please try again.");
        }
    }
    function onGoodsGroupChanged(e) {
        const selectedValue = e.value; // This is GsgroupId
        const dropDownBoxInstance = e.component;

        // Access the full data source
        const dataSource = dropDownBoxInstance.getDataSource();

        dataSource.load().done(function (items) {
            const selectedItem = items.find(item => item.GsgroupId === selectedValue);

            if (selectedItem && selectedItem.GsgroupCode) {
                $("#txtGoodsCode7").dxTextBox("instance").option("value", selectedItem.GsgroupCode);
            } else {
                $("#txtGoodsCode7").dxTextBox("instance").option("value", "");
            }
        });
    }

    $(document).ready(function () {
        const $form = $("#goodsServicesForm");

        // Only affect buttons inside this specific form
        $form.find(".limited-footer .btn-containerIvoiceEdit").each(function () {
            if (!$(this).find("#btnSave,#btnSaveAndClose,#btnPrint1,#btnDelete,#btnBack").length) {
                $(this).remove();
            }
        });

        // Save button click - scoped to this form
        $form.find("#btnSave").on("click", function () {
            onSaveClicked($form);
        });
    });
    debugger
    function onSaveClicked($form) {
        const gsCodeInput = $form.find("#txtGoodsCode7").dxTextBox("instance").option("value");
        const description = $form.find("#txtDescription8").dxTextArea("instance").option("value");

        if (!description) {
            DevExpress.ui.notify("Description cannot be empty.", "warning", 2000);
            return;
        }

        const formData = {
            GSCode: gsCodeInput, // only the prefix like "MECH", "TRM", etc.
            GSGroupID: parseInt($form.find("#ddlGoodsGroup1").dxDropDownBox("instance").option("value")),
            ItemPartNo: $form.find("#txtItemPartNo4").dxTextBox("instance").option("value"),
            GSDescrpition: description,
            GSDescriptionAr: $form.find("#txtDescriptionArabic").dxTextBox("instance").option("value"),
            GSUoM: parseInt($form.find("#ddlUnitMeasure9").dxDropDownBox("instance").option("value")),
            GSPackingUnit: parseInt($form.find("#packingUnit").dxNumberBox("instance").option("value")),
            GSSellingRate: parseFloat($form.find("#sellingRate").dxNumberBox("instance").option("value")),
            CostPrice: parseFloat($form.find("#txtCostPrice3").dxNumberBox("instance").option("value")),
            GSDetailedDesc: $form.find("#txtDetailedDescription").dxTextArea("instance").option("value"),
            GSDetailedDescAr: $form.find("#txtDetailedDescriptionArabic").dxTextBox("instance").option("value")
        };

        $.ajax({
            type: "POST",
            url: `/api/VATModule/SaveGoodsAndServices`,
            data: JSON.stringify(formData),
            contentType: "application/json",
            success: function (response) {
                DevExpress.ui.notify(response.message, "success", 2000);
                if (!gsCodeInput && response.gscode) {
                    $form.find("#txtGoodsCode7").dxTextBox("instance").option("value", response.gscode);
                }
            },
            error: function (xhr) {
                const errMsg = xhr.responseJSON?.message || "Save failed.";
                DevExpress.ui.notify(errMsg, "error", 2000);
            }
        });
    }




</script>
