<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Goods and Services</title>
    <style>
        .dx-fieldset {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            padding: 15px;
            background-color: #e6eef7;
            width: 1200px;

        }

        .dx-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .field-label {
            font-weight: bold;
        }

        .aligned-input {
            width: 100%;
        }

        .dx-card {
            padding: 20px;
            background-color: #e6eef7;
            width: 90%;
            margin: auto;
            border-radius: 8px;
        }

        .input-group {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dx-textarea {
            width: 100%;
            height: 60px;
        }
        .dx-card{
            width : 1460px;
        }
         
        .limited-footer .btn-container:not(:has(#btnSave,#btnSaveAndClose,#btnPrint1,#btnDelete,#btnBack)) {
            display: none !important;
        }
    </style>
   
</head>
<body>
    <div class="dx-card">
        <h3>Goods and Services</h3>
        <!-- Row 1: Goods Code | Goods Group | Item Part No -->
