            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td>
                            <label class="field-label">Goods & Services Code:</label>
                            @(Html.DevExtreme().TextBox().ID("txtGoodsCode7").Width("100%"))
                        </td>
