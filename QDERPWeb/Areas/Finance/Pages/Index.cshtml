                    caption: formatMessage("Balance Amount"),
                    format: { type: "fixedPoint", precision: 2 },
                    headerCellTemplate: function (header, info) {
                        $("<div>")
                            .text(info.column.caption)
                            .css({ "text-align": "center", "font-weight": "bold" })
                            .appendTo(header);
