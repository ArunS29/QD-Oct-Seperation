          $(document).ready(function () {
            $.ajax({
                url: "/api/Dashboard/GetBillsOutstandingAgingForChart",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    console.log("API Response:", response);

                    if (response.success && Array.isArray(response.agingData) && response.agingData.length > 0) {
                        // Ensure Balance is a number
                        response.agingData.forEach(item => {
                            item.Balance = Number(item.Balance) || 0;
                        });

                        var pieChartInstance = $("#billsOutstandingPieChart").dxPieChart("instance");

                        if (pieChartInstance) {
                            // Update the existing chart
                            pieChartInstance.option("dataSource", response.agingData);
                        } else {
                            // Initialize the pie chart
                            $("#billsOutstandingPieChart").dxPieChart({
                                dataSource: response.agingData,
                                series: [{
                                    argumentField: "OverDueGroup",
                                    valueField: "Balance",
                                    label: {
                                        visible: true,
                                        format: "currency"
                                    }
                                }],
                                title: formatMessage("Supplier Outstanding Distribution"),
                            });
                        }
                    } else {
                        console.error("Invalid or empty data received from API.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                }
            });
        });
            $(document).ready(function () {
            $.ajax({
                url: "/api/Dashboard/GetOutstandingChartData",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        const data = response.data;

                        const clientData = data.filter(item => item.Type === "Client");
                        const supplierData = data.filter(item => item.Type === "Supplier");

                        const labels = [...new Set(data.map(item => item.AccountHead))];

                        const clientBalances = labels.map(label => {
                            const item = clientData.find(d => d.AccountHead === label);
                            return item ? item.Balance : 0;
                        });

                        const supplierBalances = labels.map(label => {
                            const item = supplierData.find(d => d.AccountHead === label);
                            return item ? item.Balance : 0;
                        });
                        new Chart("outstandingChart", {
                            type: "bubble",
                            data: {
                                datasets: [
                                    {
                                        label: formatMessage("Client Outstanding"),
                                        backgroundColor: "rgba(0, 123, 255, 0.5)",
                                        borderColor: "rgba(0, 123, 255, 1)",
                                        data: clientData.map(item => ({
                                            x: labels.indexOf(item.AccountHead),
                                            y: item.Balance,
                                            r: item.Balance / 1000000 // Bubble size based on balance
                                        }))
                                    },
                                    {
                                        label: formatMessage("Supplier Outstanding"),
                                        backgroundColor: "rgba(255, 99, 132, 0.5)",
                                        borderColor: "rgba(255, 99, 132, 1)",
                                        data: supplierData.map(item => ({
                                            x: labels.indexOf(item.AccountHead),
                                            y: item.Balance,
                                            r: item.Balance / 1000000
                                         }))
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                scales: {
                                    x: { title: { display: true, text: formatMessage("Accounts") } },
                                    y: { title: { display: true, text: formatMessage("Outstanding Amount") } }
                                }
                            }
                        });
                    } else {
                        console.error("Error fetching data");
                    }
                },
                error: function (error) {
                    console.error("Error fetching data: ", error);
                }
            });
        });
            google.charts.load('current', { 'packages': ['corechart'] });
        google.charts.setOnLoadCallback(loadChartData);

        function loadChartData() {
            $.ajax({
                url: "/api/Dashboard/GetOutstandingChartData",
                type: "GET",
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                        const data = response.data;

                        // Aggregate data for ranking
                        const accountBalances = [...new Set(data.map(item => item.AccountHead))].map(label => {
                            const totalBalance = data
                                .filter(item => item.AccountHead === label)
                                .reduce((sum, item) => sum + item.Balance, 0);

                            return { label: label, balance: totalBalance };
                        });

                        // Sort by balance and take top 5
                        const topAccounts = accountBalances
                            .sort((a, b) => b.balance - a.balance) // Descending order
                            .slice(0, 5); // Top 5

                        // Prepare data for Google Charts
                        const chartData = [['Account Head', 'Outstanding Balance']];
                        topAccounts.forEach(item => {
                            chartData.push([item.label, item.balance]);
                        });

                        drawChart(chartData);
                    } else {
                        console.error("Error fetching data");
                    }
                },
                error: function (error) {
                    console.error("Error fetching data: ", error);
                }
            });
        }

        function drawChart(chartData) {
            // Convert to Google Charts format
            const data = google.visualization.arrayToDataTable(chartData);

            // Set Options
            const options = {
                title: formatMessage('Top 5 Outstanding Accounts'),
                is3D: true,
                pieSliceText: 'value',
                height: 400
            };

            // Draw Chart
            const chart = new google.visualization.PieChart(document.getElementById('myChart2'));
            chart.draw(data, options);
        }


        $(document).ready(function () {
                $.ajax({
                    url: "/api/Dashboard/GetOutstandingChartData",
                    type: "GET",
                    dataType: "json",
                    success: function (response) {
                        if (response.success) {
                            const data = response.data;

                            // Separate client and supplier data
                            const clientData = data.filter(item => item.Type === "Client");
                            const supplierData = data.filter(item => item.Type === "Supplier");

                            // Aggregate data for ranking
                            const accountBalances = [...new Set(data.map(item => item.AccountHead))].map(label => {
                                const clientBalance = clientData.find(d => d.AccountHead === label)?.Balance || 0;
                                const supplierBalance = supplierData.find(d => d.AccountHead === label)?.Balance || 0;
                                return {
                                    label: label,
                                    clientBalance: clientBalance,
                                    supplierBalance: supplierBalance,
                                    totalBalance: clientBalance + supplierBalance
                                };
                            });

                            // Sort by total balance and take top 10
                            const topAccounts = accountBalances
                                .sort((a, b) => b.totalBalance - a.totalBalance) // Descending order
                                .slice(0, 10); // Top 10

                            // Extract labels and data for the chart
                            const labels = topAccounts.map(item => item.label);
                            const clientBalances = topAccounts.map(item => item.clientBalance);
                            const supplierBalances = topAccounts.map(item => item.supplierBalance);

                            // Example third dataset (optional)
                            const otherData = labels.map((_, index) => index * 500);

                            // Create the chart
                            new Chart("myChart1", {
                                type: "line",
                                data: {
                                    labels: labels, // Account Names
                                    datasets: [
                                        {
                                            label: formatMessage("Client Outstanding"),
                                            data: clientBalances,
                                            borderColor: "red",
                                            fill: false
                                        },
                                        {
                                            label: formatMessage("Supplier Outstanding"),
                                            data: supplierBalances,
                                            borderColor: "green",
                                            fill: false
                                        },
                                        {
                                            label: formatMessage("Other Data"),
                                            data: otherData,
                                            borderColor: "blue",
                                            fill: false
                                        }
                                    ]
                                },
                                options: {
                                    plugins: {
                                        legend: { display: true }
                                    },
                                    scales: {
                                        y: { beginAtZero: true }
                                    }
                                }
                            });
                        } else {
                            console.error("Error fetching data");
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching data: ", error);
                    }
                });
            });
