                { dataField: "OverdueDays", caption: formatMessage("Overdue Days"), visible: false, allowHiding: true },
                { dataField: "AccountHeadNo", caption: formatMessage("Account Head No"), visible: false, allowHiding: true }
            ],
            [
                {
                    column: "Balance",
                    summaryType: "sum",
                    valueFormat: { type: "fixedPoint", precision: 2 },
                    displayFormat: formatMessage("Total : {0}")
                },
                {
                    column: "AccountHead",
                    summaryType: "count",
                    displayFormat: formatMessage("Count : {0}")
                }
            ]
        );

        // Account Summary DataGrid
        fetchDataAndInitializeGrid(
            "/api/Dashboard/GetAccountSummary",
            "#accountSummaryGrid",
            [
                { dataField: "AccountHeadName", caption: formatMessage("Account Head"), width: 200, allowReordering: true },
                { dataField: "TotalBalance", caption: formatMessage("Balance Amount"), format: { type: "fixedPoint", precision: 2 }, allowReordering: true },
                { dataField: "AccountGroup", caption: formatMessage("Account Group"), visible: false, allowHiding: true }
            ],
            [
                {
                    column: "TotalBalance",
                    summaryType: "sum",
                    valueFormat: { type: "fixedPoint", precision: 2 },
                    displayFormat: formatMessage("Total : {0}")
                },
                {
                    column: "AccountHeadName",
                    summaryType: "count",
                    displayFormat: formatMessage("Count : {0}")
                }
            ]
        );
    });

