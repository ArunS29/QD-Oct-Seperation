@page
@model QD.ERP.Web.Areas.Finance.Pages.IndexModel
@{
    ViewData["Title"] = "Finance Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finance Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
        }

        .dashboard-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        .cards-container {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .card {
            width: 200px;
            padding: 20px;
            border-radius: 8px;
            background: #f8f9fa;
            text-align: center;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        }

        .charts-container {
            display: flex;
            justify-content: space-around;
            width: 100%;
        }

        canvas {
            width: 400px;
            height: 300px;
            max-width: 400px;
            max-height: 400px;
        }

        .mainContainer {
            width: 100%;
        }
    </style>
</head>
<body>

    <div class="dashboard-container">
        <!-- Cards -->
        <div class="cards-container">
            <div class="card">
                <h3>Cash Balances</h3>
                <h2>$23.12M</h2>
            </div>
            <div class="card">
                <h3>Client Outstanding</h3>
                <h2>$27.64M</h2>
            </div>
            <div class="card">
                <h3>Supplier Outstanding</h3>
                <h2>$6.85M</h2>
            </div>
        </div>

        <!-- Charts -->
        <div class="charts-container">
            <!-- Pie Chart -->
            <div>
                <h3>Client vs Supplier Outstanding</h3>
                <canvas id="pieChart"></canvas>
            </div>

            <!-- Bar Chart -->
            <div>
                <h3>Cash & Bank Balances</h3>
                <canvas id="barChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Pie Chart
            var pieCtx = document.getElementById("pieChart").getContext("2d");
            new Chart(pieCtx, {
                type: "pie",
                data: {
                    labels: ["Client Outstanding", "Supplier Outstanding"],
                    datasets: [{
                        data: [27640000, 6850000],
                        backgroundColor: ["#007bff", "#dc3545"],
                    }]
                }
            });

            // Bar Chart
            var barCtx = document.getElementById("barChart").getContext("2d");
            new Chart(barCtx, {
                type: "bar",
                data: {
                    labels: ["Bank A", "Bank B", "Bank C"],
                    datasets: [{
                        label: "Balance ($M)",
                        data: [50, 30, 20],
                        backgroundColor: ["#28a745", "#17a2b8", "#ffc107"],
                    }]
                }
            });
        });
    </script>

</body>
</html>
