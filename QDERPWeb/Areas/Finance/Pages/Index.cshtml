@page
@model QD.ERP.Web.Areas.Finance.Pages.IndexModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Outstanding Details";
}

<h2>Outstanding Details</h2>

<!-- DevExtreme Scripts & Styles -->
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/latest/css/dx.light.css">
<script src="https://cdn3.devexpress.com/jslib/latest/js/dx.all.js"></script>

<!-- Include Excel Export Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<!-- Total Outstanding Cards -->
<div class="dx-card-container">
    <!-- Total Client Outstanding Card -->
    <div class="dx-card">
        <div class="dx-card-header">
            <h3>Total Client Outstanding</h3>
        </div>
        <div class="dx-card-content">
            <div id="totalClientOutstandingValue" class="total-value"></div>
        </div>
    </div>
    <!-- New Cash Balance Card -->
    <div class="dx-card">
        <div class="dx-card-header">
            <h3>Total Cash Balance</h3>
        </div>
        <div class="dx-card-content">
            <div id="cashBalanceValue" class="total-value"></div>
        </div>
    </div>

    <!-- Total Bills Outstanding Card -->
    <div class="dx-card">
        <div class="dx-card-header">
            <h3>Total Supplier Outstanding</h3>
        </div>
        <div class="dx-card-content">
            <div id="totalBillsOutstandingValue" class="total-value"></div>
        </div>
    </div>
</div>
<!-- Pie Chart Containers -->
<div class="chart-row">
    <div class="chart-container">
        <h3>Client Outstanding Distribution</h3>
        <div id="clientOutstandingPieChart"></div>
    </div>
    <div class="chart-container">
        <h3>Supplier Outstanding Distribution</h3>
        <div id="billsOutstandingPieChart"></div>
    </div>
    <div class="chart-container">
        <h3>Bank Account Distribution</h3>
        <div id="bankAccountsPieChart"></div>
    </div>
</div>
<!-- Grid Container -->
<div class="grid-container">
    <!-- Client Outstanding Section -->
    <div class="grid-section">
        <h3>Client Outstanding</h3>
        <div id="clientOutstandingGrid"></div>
    </div>

    <!-- Bills Payable Outstanding Section -->
    <div class="grid-section">
        <h3>Supplier Outstanding</h3>
        <div id="billsPayableGrid"></div>
    </div>

    <!-- Bank Account Details Section -->
    <div class="grid-section">
        <h3>Bank Account Details</h3>
        <div id="bankAccountGrid"></div>
    </div>
</div>

<!-- Charts Row Container -->
<div class="chart-row">
    <!-- Client Outstanding Aging Chart -->
    <div class="chart-container">
        <h3>Client Outstanding Aging Chart</h3>
        <div id="clientOutstandingChart"></div>
    </div>

    <!-- Supplier Outstanding Aging Chart -->
    <div class="chart-container">
        <h3>Supplier Outstanding Aging Chart</h3>
        <div id="billsOutstandingChart"></div>
    </div>

    <!-- Bank Accounts Chart -->
    <div class="chart-container">
        <h3>Bank Accounts Chart</h3>
        <div id="bankAccountsChart"></div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $.ajax({
            url: "/api/Dashboard/GetClientOutstandingAgingForChart",
            type: "GET",
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    $("#clientOutstandingChart").dxChart({
                        dataSource: response.agingData,
                        series: [{
                            argumentField: "OverDueGroup",
                            valueField: "Balance",
                            name: "Balance Amount",
                            type: "bar",
                            color: "#007acc"
                        }],
                        argumentAxis: {
                            label: { rotationAngle: -45 },
                            title: "Overdue Groups"
                        },
                        valueAxis: {
                            title: "Balance Amount",
                            label: { format: { type: "fixedPoint", precision: 2 } }
                        },
                        legend: { visible: true },
                        tooltip: {
                            enabled: true,
                            format: { type: "fixedPoint", precision: 2 }
                        }
                    });
                } else {
                    console.error("Error loading data: ", response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching data: ", error);
            }
        });

        $.ajax({
            url: "/api/Dashboard/GetBankAccounts",
            type: "GET",
            dataType: "json",
            success: function (response) {
                $("#bankAccountsChart").dxChart({
                    dataSource: response.data,
                    series: [{
                        argumentField: "AccountHeadName",
                        valueField: "Amount",
                        name: "Amount",
                        type: "bar",
                        color: "#007acc"
                    }],
                    argumentAxis: {
                        label: { rotationAngle: -45 },
                        title: "Account Head Name"
                    },
                    valueAxis: {
                        title: "Amount",
                        label: { format: { type: "fixedPoint", precision: 2 } }
                    },
                    legend: { visible: true },
                    tooltip: {
                        enabled: true,
                        format: { type: "fixedPoint", precision: 2 }
                    }
                });
            },
            error: function (xhr, status, error) {
                console.error("Error fetching data: ", error);
            }
        });
    });

    $(function () {
        // Handle click on "Total Client Outstanding" card
        $("#totalClientOutstandingCard").click(function () {
            $(".dx-card-container, .grid-container, .chart-container").hide(); // Hide other sections
            $("#clientOutstandingSection").show(); // Show Client Outstanding
        });

        // Back button functionality
        $("#backToDashboard").click(function () {
            $("#clientOutstandingSection").hide(); // Hide Client Outstanding
            $(".dx-card-container, .grid-container, .chart-container").show(); // Show main dashboard
        });
    });

    $(function () {
        // Fetch Total Client Outstanding
        $.getJSON("/api/Dashboard/GetTotalClientOutstanding", function (response) {
            if (response.success) {
                $("#totalClientOutstandingValue").text(response.totalOutstanding.toLocaleString('en-US'));
            } else {
                alert("Error loading total client outstanding data.");
            }
        });

        // Fetch Total Bills Outstanding
        $.getJSON("/api/Dashboard/GetTotalBillsOutstanding", function (response) {
            if (response.success) {
                $("#totalBillsOutstandingValue").text(response.totalBillsOutstanding.toLocaleString('en-US'));
            } else {
                alert("Error loading total bills outstanding data.");
            }
        });

        // Client Outstanding DataGrid
        $("#clientOutstandingGrid").dxDataGrid({
            dataSource: DevExpress.data.AspNet.createStore({
                key: "AccountHeadNo",
                loadUrl: "/api/Dashboard/GetClientOutstanding"
            }),
            remoteOperations: true,
            columns: [
                { dataField: "AccountHead", caption: "Account Head", width: 200, allowReordering: true },
                {
                    dataField: "Balance",
                    caption: "Balance Amount",
                    format: { type: "fixedPoint", precision: 2 },
                    allowReordering: true
                },
            ],
            columnAutoWidth: true,
            showBorders: true,
            filterRow: { visible: true },
            paging: { enabled: false }, // Show all data

            // Enable vertical scrolling
            height: 400, // Adjust grid height as needed
            scrolling: {
                mode: "virtual" // Enables virtual scrolling for large data
            },

            searchPanel: { visible: false }, // Hide search panel by default

            // Enable column reordering
            allowColumnReordering: true,
            allowColumnResizing: true,

            columnChooser: {
                enabled: true, // Enable column chooser to select & reorder columns
                mode: "dragAndDrop"
            },

            // Removed toolbar (no search & export button)
            toolbar: {
                items: []
            }
        });

        // Bills Payable Outstanding DataGrid
           $("#billsPayableGrid").dxDataGrid({
        dataSource: DevExpress.data.AspNet.createStore({
            key: "AccountHeadNo",
            loadUrl: "/api/Dashboard/GetBillsPayableOutstanding"
        }),
        remoteOperations: true,
        columns: [
            {
                dataField: "AccountHead",
                caption: "Account Head",
                width: 200,
                headerCellTemplate: function (header, info) {
                    $("<div>")
                        .text(info.column.caption)
                        .css({
                            "text-align": "center",
                            "font-weight": "bold"
                        })
                        .appendTo(header);
                }
            },
            {
                dataField: "Balance",
                caption: "Balance Amount",
                format: { type: "fixedPoint", precision: 2 },
                headerCellTemplate: function (header, info) {
                    $("<div>")
                        .text(info.column.caption)
                        .css({
                            "text-align": "center",
                            "font-weight": "bold"
                        })
                        .appendTo(header);
                }
            }
        ],
        columnAutoWidth: true,
        showBorders: true,
        filterRow: { visible: true },
        paging: { enabled: false }, // Show all data

        // Enable vertical scrolling
        height: 400, // Adjust grid height as needed
        scrolling: {
            mode: "virtual" // Enables virtual scrolling for large data
        },

        // Hide the search panel
        searchPanel: { visible: false },
        // Enable column reordering
        allowColumnReordering: true,
        allowColumnResizing: true,

        columnChooser: {
            enabled: true, // Enable column chooser to select & reorder columns
            mode: "dragAndDrop"
        },

        // Remove the export button from the toolbar if present
        toolbar: {
            items: [
                // Add any items you want to keep in the toolbar, but don't include the export button.
            ]
        },

        // Disable header filters (if any)
        headerFilter: {
            visible: false
        }
    });


        // Bank Account Details DataGrid
        $("#bankAccountGrid").dxDataGrid({
            dataSource: DevExpress.data.AspNet.createStore({
                key: "AccountHead",
                loadUrl: "/api/Dashboard/GetBankAccounts"
            }),
            remoteOperations: true,
            columns: [
                { dataField: "AccountHeadName", caption: "Account Head", width: 200, allowReordering: true },
                { dataField: "Amount", caption: "Balance Amount", format: { type: "fixedPoint", precision: 2 }, allowReordering: true }
            ],
            columnAutoWidth: true,
            showBorders: true,
            filterRow: { visible: true },
            paging: { enabled: false }, // Show all data

            // Enable vertical scrolling
            height: 400, // Adjust grid height as needed
            scrolling: {
                mode: "virtual" // Enables virtual scrolling for large data
            },

            searchPanel: { visible: false }, // Hide search panel by default

            // Enable column reordering
            allowColumnReordering: true,
            allowColumnResizing: true,

            columnChooser: {
                enabled: true, // Enable column chooser to select & reorder columns
                mode: "dragAndDrop"
            },

            // Removed toolbar (no search & export button)
            toolbar: {
                items: []
            }
        });

        // Bills Outstanding Aging Chart
        $("#billsOutstandingChart").dxChart({
            dataSource: DevExpress.data.AspNet.createStore({
                loadUrl: "/api/Dashboard/GetBillsOutstandingAgingForChart"
            }),
            series: [{
                argumentField: "OverDueGroup",
                valueField: "Balance",
                name: "Balance Amount",
                type: "bar",
                color: "#007acc"
            }],
            argumentAxis: {
                label: {
                    rotationAngle: -45
                },
                title: "Overdue Groups"
            },
            valueAxis: {
                title: "Balance Amount",
                label: {
                    format: { type: "fixedPoint", precision: 2 }
                }
            },
            legend: {
                visible: true
            },
            tooltip: {
                enabled: true,
                format: { type: "fixedPoint", precision: 2 }
            }
        });

        $.getJSON("/api/Dashboard/GetCashBalance", function (response) {
            if (response.success) {
                $("#cashBalanceValue").text(response.cashBalance);
            } else {
                alert("Error loading cash balance data.");
            }
        });
    });
    $(document).ready(function () {
        // Fetch Client Outstanding Aging Data
        $.ajax({
            url: "/api/Dashboard/GetClientOutstandingAgingForChart",
            type: "GET",
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    // Client Outstanding Pie Chart
                    $("#clientOutstandingPieChart").dxPieChart({
                        dataSource: response.agingData,
                        series: [{
                            argumentField: "OverDueGroup",
                            valueField: "Balance",
                            label: {
                                visible: true,
                                format: "currency"
                            }
                        }],
                        title: "Client Outstanding Distribution"
                    });
                }
            }
        });

        // Fetch Supplier Outstanding Aging Data
      $(document).ready(function () {
        $.ajax({
            url: "/api/Dashboard/GetBillsOutstandingAgingForChart",
            type: "GET",
            dataType: "json",
            success: function (response) {
                console.log("API Response:", response);

                if (response.success && Array.isArray(response.agingData) && response.agingData.length > 0) {
                    // Ensure Balance is a number
                    response.agingData.forEach(item => {
                        item.Balance = Number(item.Balance) || 0;
                    });

                    var pieChartInstance = $("#billsOutstandingPieChart").dxPieChart("instance");

                    if (pieChartInstance) {
                        // Update the existing chart
                        pieChartInstance.option("dataSource", response.agingData);
                    } else {
                        // Initialize the pie chart
                        $("#billsOutstandingPieChart").dxPieChart({
                            dataSource: response.agingData,
                            series: [{
                                argumentField: "OverDueGroup",
                                valueField: "Balance",
                                label: {
                                    visible: true,
                                    format: "currency"
                                }
                            }],
                            title: "Supplier Outstanding Distribution",
                        });
                    }
                } else {
                    console.error("Invalid or empty data received from API.");
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX Error:", status, error);
            }
        });
    });

        // Fetch Bank Accounts Data
        $.ajax({
            url: "/api/Dashboard/GetBankAccounts",
            type: "GET",
            dataType: "json",
            success: function (response) {
                // Bank Accounts Pie Chart
                $("#bankAccountsPieChart").dxPieChart({
                    dataSource: response.data,
                    series: [{
                        argumentField: "AccountHeadName",
                        valueField: "Amount",
                        label: {
                            visible: true,
                            format: "currency"
                        }
                    }],
                    title: "Bank Account Distribution"
                });
            }
        });
    });

</script>

<style>
    .dx-card-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .dx-card {
        display: inline-block;
        padding: 20px;
        background: #f5f5f5;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .dx-card-header {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .dx-card-content .total-value {
        font-size: 24px;
        font-weight: bold;
        color: #007acc;
    }

    .grid-container {
        display: flex;
        padding: 15px;
        justify-content: space-between;
    }

    .grid-section {
        width: 32%;
        text-align: center;
    }

    .chart-row {
        display: flex;
        justify-content: space-between;
        padding: 15px;
        align-items: center;
    }

    .chart-container {
        width: 32%;
        text-align: center;
    }

    #clientOutstandingChart,
    #billsOutstandingChart,
    #bankAccountsChart {
        width: 100%;
        height: 400px;
        margin: 0 auto;
    }

    .dx-card-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .dx-card {
        padding: 20px;
        background: #f5f5f5;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        text-align: center;
        width: 250px;
    }

    .dx-card-header {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .dx-card-content .total-value {
        font-size: 24px;
        font-weight: bold;
        color: #007acc;
    }
</style>

