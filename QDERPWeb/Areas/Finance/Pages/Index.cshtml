@page "{handler?}"
@model QD.ERP.Web.Areas.Finance.Pages.IndexModel

@{
    ViewData["Title"] = "File Upload";
}

<h1>File Upload</h1>

<form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
    <div>
        <label for="UploadedFile">Choose file:</label>
        <input type="file" id="UploadedFile" asp-for="UploadedFile" required />
    </div>
    <div>
        <button type="submit">Upload</button>
    </div>
</form>

<h2>Download File</h2>

<form method="get" asp-page-handler="DownloadFile">
    <div>
        <label for="fileName">Enter file name:</label>
        <input type="text" id="fileName" name="fileName" required />
    </div>
    <div>
        <button type="submit">Download</button>
    </div>
</form>

@if (TempData["Message"] != null)
{
    <p style="color: green;">@TempData["Message"]</p>
}

@if (TempData["Error"] != null)
{
    <p style="color: red;">@TempData["Error"]</p>
}
