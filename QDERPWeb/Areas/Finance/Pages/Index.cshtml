@page
@model QD.ERP.Web.Areas.Finance.Pages.IndexModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Outstanding Details";
}

<link rel="stylesheet" href="/css/dashboard.css?v=1" />

<div class="dashboard-scroll-container">
    <!-- Modern Dashboard Header -->
    <div class="dashboard-header">
        <span class="user-name">Hey @Model.UserName</span> - <span class="subtext">here’s what’s happening till this date</span>
        <label class="live-data-checkbox">
            <input type="checkbox" id="getLiveData"> Get live data
        </label>
    </div>

    <!-- Summary Cards Row -->
    <div class="summary-cards-row">
        <div class="summary-card">
            <div class="summary-card-header">
                <span class="summary-label">TOTAL CLIENT OUTSTANDING</span>
                <span id="clientOutstandingTrend" class="summary-trend-pill"></span>
            </div>
            <div class="summary-value" id="totalClientOutstandingValue">0</div>
            <span id="loaderClientOutstanding" style="display:none;">Loading...</span>
        </div>
        <div class="summary-card">
            <div class="summary-card-header">
                <span class="summary-label">TOTAL SUPPLIER OUTSTANDING</span>
                <span id="supplierOutstandingTrend" class="summary-trend-pill"></span>
            </div>
            <div class="summary-value" id="totalSupplierOutstandingValue">0</div>
            <span id="loaderBillsOutstanding" style="display:none;">Loading...</span>
        </div>
        <div class="summary-card">
            <div class="summary-card-header">
                <span class="summary-label">TOTAL BANK BALANCE</span>
                <span id="bankBalanceTrend" class="summary-trend-pill"></span>
            </div>
            <div class="summary-value" id="totalBankBalanceValue">0</div>
            <span id="loaderBankBalance" style="display:none;">Loading...</span>
        </div>
        <div class="summary-card">
            <div class="summary-card-header">
                <span class="summary-label">CASH BALANCE</span>
                <span id="cashBalanceTrend" class="summary-trend-pill"></span>
            </div>
            <div class="summary-value" id="cashBalanceValue">0</div>
            <span id="loaderCashBalance" style="display:none;">Loading...</span>
        </div>
    </div>

    <!-- Outstanding Summary Section -->
    <div class="outstanding-summary-section">
        <div class="outstanding-summary-left">
            <div class="section-header">
                <span class="section-title">Top 5 Outstanding Summary</span>
            </div>
            <div class="tabs">
                <div class="tab dashboard-tab active" id="tabClientOutstanding">Client Outstanding</div>
                <div class="tab dashboard-tab" id="tabSupplierOutstanding">Supplier Outstanding</div>
                <div class="tab dashboard-tab" id="tabCashBalance">Net Amount Summary</div>
            </div>
            <div class="tab-content active" id="tab-client">
                <table class="summary-table">
                    <thead>
                        <tr>
                            <th>Account Head</th>
                            <th>Balance Amount</th>
                            <th>Over Due Days</th>
                            <th>Account Group</th>
                            <th>Account Head No</th>
                        </tr>
                    </thead>
                    <tbody id="topOutstandingTableBody">
                        <!-- Data will be loaded here by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <div class="outstanding-summary-right">
            <div class="section-header">
                <span class="section-title">Outstanding Summary</span>
            </div>
            <canvas id="outstandingDonutChart" width="320" height="150"></canvas>
            <div class="donut-legend">
                <span class="legend-item cash">Cash IN Hand</span>
                <span class="legend-item bank">Bank Balance</span>
            </div>
        </div>
    </div>
</div>

<!-- Global Loader Overlay -->
<div id="globalLoader" aria-hidden="true" aria-busy="true">
    <div class="gl-backdrop"></div>
    <div class="gl-container">
        <div class="gl-spinner"></div>
        <div class="gl-text">Loading…</div>
    </div>
</div>

<script>
/* ===== Global Loader ===== */
(function () {
    const loader = document.getElementById('globalLoader');
    let hideTimer = null, locks = 0;

    function showLoader(forceImmediate = false) {
        locks++;
        if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
        loader.classList.add('show');
        document.body.classList.add('gl-lock');
        if (forceImmediate) loader.offsetHeight;
    }

    function hideLoader() {
        hideTimer = setTimeout(() => {
            locks = Math.max(0, locks - 1);
            if (locks === 0) {
                loader.classList.remove('show');
                document.body.classList.remove('gl-lock');
            }
        }, 150);
    }

    window.__globalLoader = { show: showLoader, hide: hideLoader };
})();

/* ===== Animate number changes ===== */
function animateValue(id, start, end, duration) {
    const obj = document.querySelector(id);
    if (!obj) return;
    let startTimestamp = null;
    const step = (timestamp) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        obj.textContent = Math.floor(progress * (end - start) + start).toLocaleString('en-US');
        if (progress < 1) window.requestAnimationFrame(step);
    };
    window.requestAnimationFrame(step);
}

/* ===== Live Data Refresh ===== */
document.getElementById("getLiveData").addEventListener("change", function () {
    if (this.checked) {
        window.__globalLoader.show(true);
        fetch("/api/dashboard/RunAllOutstandingProcedures", { method: "POST" })
        .then(r => {
            if (!r.ok) throw new Error("API failed");
            return r.json();
        })
        .then(() => { alert("Live data refresh started!"); location.reload(); })
        .catch(() => { alert("Failed to run live data process."); })
        .finally(() => window.__globalLoader.hide());
    }
});

/* ===== Dashboard Data Load ===== */
$(document).ready(function () {
    const apiEndpoints = [
        { url: "/api/Dashboard/GetTotalClientOutstanding", target: "#totalClientOutstandingValue", loader: "#loaderClientOutstanding", key: "balance" },
        { url: "/api/Dashboard/supplieroutstanding",       target: "#totalSupplierOutstandingValue", loader: "#loaderBillsOutstanding",  key: "balance" },
        { url: "/api/Dashboard/GetBankAccounts",           target: "#totalBankBalanceValue",        loader: "#loaderBankBalance",       key: "balance" },
        { url: "/api/Dashboard/GetCashBalance",            target: "#cashBalanceValue",             loader: "#loaderCashBalance",       key: "balance" },
        { url: "/api/Dashboard/GetCashBalance1",           target: null,                            loader: null,                       key: "balance" } // only for chart
    ];

    let cashVal = 0, bankVal = 0;

    const requests = apiEndpoints.map(ep => {
        if (ep.loader) $(ep.loader).show();
        return $.getJSON(ep.url)
            .done(response => {
                const raw = (response && (response.success === undefined || response.success) && response[ep.key] != null)
                    ? Number(response[ep.key]) : 0;
                if (ep.target) animateValue(ep.target, 0, raw, 900);

                const urlLower = ep.url.toLowerCase();
                if (urlLower.includes("getcashbalance1")) cashVal = raw;
                if (urlLower.includes("getbankaccounts")) bankVal = raw;
            })
            .fail(() => { if (ep.target) $(ep.target).text('0'); })
            .always(() => { if (ep.loader) $(ep.loader).hide(); });
    });

    Promise.allSettled(requests).then(() => {
        const ctx = document.getElementById('outstandingDonutChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Cash IN Hand', 'Bank Balance'],
                datasets: [{ data: [cashVal, bankVal], backgroundColor: ['#A48CFA', '#7BC0FE'], borderWidth: 2 }]
            },
            options: { cutout: '70%', plugins: { legend: { display: false } } }
        });
    });

    /* ===== Outstanding Table Loader ===== */
    function loadOutstandingTable(apiUrl) {
        const $body = $("#topOutstandingTableBody");
        $body.html('<tr><td colspan="5" style="text-align:center;color:#b9b9b9;">Loading...</td></tr>');
        $.getJSON(apiUrl, data => {
            if (data && Array.isArray(data.data) && data.data.length > 0) {
                $body.html(data.data.map(row => `
                    <tr>
                        <td>${row.AccountHead || row.accountHead || ''}</td>
                        <td>${(row.Balance ?? row.balance ?? 0).toLocaleString('en-US')}</td>
                        <td>${row.OverdueDays ?? row.overdueDays ?? ''}</td>
                        <td>${row.AccountGroup || row.accountGroup || ''}</td>
                        <td>${row.AccountHeadNo || row.accountHeadNo || ''}</td>
                    </tr>
                `).join(''));
            } else {
                $body.html('<tr><td colspan="5" style="text-align:center;color:#e66a6a;">No data found</td></tr>');
            }
        }).fail(() => {
            $body.html('<tr><td colspan="5" style="text-align:center;color:#e66a6a;">Failed to load data</td></tr>');
        });
    }

    /* Default tab load */
    loadOutstandingTable("/api/Dashboard/GetClientOutstanding");

    /* Tab click handler */
    $(".dashboard-tab").click(function () {
        $(".dashboard-tab").removeClass("active");
        $(this).addClass("active");

        if (this.id === "tabClientOutstanding") {
            loadOutstandingTable("/api/Dashboard/GetClientOutstanding");
        } else if (this.id === "tabSupplierOutstanding") {
            loadOutstandingTable("/api/Dashboard/GetBillsPayableOutstanding");
        } else if (this.id === "tabCashBalance") {
            loadOutstandingTable("/api/Dashboard/GetBankCashSummary");
        }
    });
});
</script>
