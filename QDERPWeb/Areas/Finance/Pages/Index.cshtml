@page
@model QD.ERP.Web.Areas.Finance.Pages.IndexModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Outstanding Details";
}

<!-- Page Loader (full overlay) -->
<div id="dashboardPageLoader" style="position:fixed;top:0;left:0;z-index:9999;background:rgba(255,255,255,0.8);width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;">
    <img src="/images/dicerol.gif" alt="Loading..." style="height:150px;">
</div>

<!-- JS/CSS Dependencies -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
<script src="https://www.gstatic.com/charts/loader.js"></script>
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/latest/css/dx.light.css">
<script src="https://cdn3.devexpress.com/jslib/latest/js/dx.all.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<div class="dashboard-card-header">
    Outstanding Dashboard Summary
</div>
<div class="dx-card-container">
    <div class="Popupcard" id="clientcard">
        <div class="dx-card-header">
            <div id="TotalClientOutstanding" class="no-border-input"></div>
        </div>
        <div class="dx-card-content">
            <span id="loaderClientOutstanding" style="display:none;">
                <img src="/images/dicerol.gif" alt="Loading..." style="height:16px;">
            </span>
            <div id="totalClientOutstandingValue" class="total-value"></div>
        </div>
    </div>
    <div class="Popupcard" id="DashboardBankAccount">
        <div class="dx-card-header">
            <div id="TotalCashBalance" class="no-border-input"></div>
        </div>
        <div class="dx-card-content">
            <span id="loaderCashBalance" style="display:none;">
                <img src="/images/dicerol.gif" alt="Loading..." style="height:16px;">
            </span>
            <div id="cashBalanceValue" class="total-value"></div>
        </div>
    </div>
    <div class="Popupcard" id="SupplierCard">
        <div class="dx-card-header">
            <div id="TotalSupplierOutstanding" class="no-border-input"></div>
        </div>
        <div class="dx-card-content">
            <span id="loaderBillsOutstanding" style="display:none;">
                <img src="/images/dicerol.gif" alt="Loading..." style="height:16px;">
            </span>
            <div id="totalBillsOutstandingValue" class="total-value"></div>
        </div>
    </div>
</div>
<div class="dashboard-card-header">
   Top 5 Outstanding Summary
</div>
<div class="grid-container">
    <div class="grid-section">
        <div id="ClientOutstanding" class="no-border-title"></div>
        <div id="clientOutstandingGrid"></div>
    </div>
    <div class="grid-section">
        <div id="SupplierOutstanding" class="no-border-title"></div>
        <div id="billsPayableGrid"></div>
    </div>
    <div class="grid-section">
        <div id="BankAccountDetails" class="no-border-title"></div>
        <div id="accountSummaryGrid"></div>
    </div>
</div>

<div class="chart-row1">
    <canvas id="outstandingChart" style="width:100%;max-width:700px"></canvas>
    <div id="myChart2" style="width: 70%; height: 350px;"></div>
</div>

<script>
const dashboardRoutes = {
    clientcard: "DashboardClient",
    SupplierCard: "DashboardSupplier",
    DashboardBankAccount: "DashboardBankAccount"
};
Object.keys(dashboardRoutes).forEach(cardId => {
    $(`#${cardId}`).on("click", function () {
        window.location.href = `/${tenantName}/Finance/${dashboardRoutes[cardId]}`;
    });
});

$(document).ready(function () {
    // Show page loader immediately
    $("#dashboardPageLoader").show();
    let loadTasks = [];

    // Top card AJAX
    const apiEndpoints = [
        { url: "/api/Dashboard/supplieroutstanding", target: "#totalBillsOutstandingValue", loader: "#loaderBillsOutstanding", key: "balance" },
        { url: "/api/Dashboard/GetTotalClientOutstanding", target: "#totalClientOutstandingValue", loader: "#loaderClientOutstanding", key: "balance" },
        { url: "/api/Dashboard/GetCashBalance", target: "#cashBalanceValue", loader: "#loaderCashBalance", key: "balance" }
    ];
    apiEndpoints.forEach(endpoint => {
        $(endpoint.loader).show();
        let promise = $.getJSON(endpoint.url)
            .done(response => {
                if (response.success) {
                    $(endpoint.target).text(response[endpoint.key].toLocaleString('en-US'));
                }
            })
            .always(() => {
                $(endpoint.loader).hide();
            });
        loadTasks.push(promise);
    });

    // Helper for grids (returns a promise)
    function fetchDataAndInitializeGrid(url, gridSelector, columns, summaryItems) {
        return $.ajax({
            url: url,
            type: "GET",
            dataType: "json"
        }).done(function (response) {
            if (response && response.data) {
                $(gridSelector).dxDataGrid({
                    dataSource: response.data,
                    columns: columns,
                    columnAutoWidth: true,
                    showBorders: true,
                    wordWrapEnabled: true,
                    filterRow: { visible: false },
                    paging: { enabled: false },
                    height: 400,
                    scrolling: { mode: "standard" },
                    searchPanel: { visible: false },
                    allowColumnReordering: true,
                    allowColumnResizing: true,
                    columnChooser: { enabled: true, mode: "select" },
                    loadPanel: { enabled: true },
                    summary: { totalItems: summaryItems }
                });
            }
        });
    }

    loadTasks.push(
        fetchDataAndInitializeGrid(
            "/api/Dashboard/GetClientOutstanding",
            "#clientOutstandingGrid",
            [
                { dataField: "AccountHead", caption: formatMessage("Account Head"), width: 200, allowReordering: true,
                    headerCellTemplate: function (header, info) { $("<div>").text(info.column.caption).css({ "text-align": "center", "font-weight": "bold" }).appendTo(header); }
                },
                { dataField: "Balance", caption: formatMessage("Balance Amount"), format: { type: "fixedPoint", precision: 2 }, allowReordering: true,
                    headerCellTemplate: function (header, info) { $("<div>").text(info.column.caption).css({ "text-align": "center", "font-weight": "bold" }).appendTo(header); }
                },
                { dataField: "OverdueDays", caption: formatMessage("Overdue Days"), visible: false, allowHiding: true },
                { dataField: "AccountGroupId", caption: formatMessage("Account Group"), visible: false, allowHiding: true },
                { dataField: "AccountHeadNo", caption: formatMessage("Account Head No"), visible: false, allowHiding: true }
            ],
            [
                { column: "Balance", summaryType: "sum", valueFormat: { type: "fixedPoint", precision: 2 }, displayFormat: formatMessage("Total : {0}") },
                { column: "AccountHead", summaryType: "count", displayFormat: formatMessage("Count : {0}") }
            ]
        )
    );
    loadTasks.push(
        fetchDataAndInitializeGrid(
            "/api/Dashboard/GetBillsPayableOutstanding",
            "#billsPayableGrid",
            [
                { dataField: "AccountHead", caption: formatMessage("Account Head"), width: 200,
                    headerCellTemplate: function (header, info) { $("<div>").text(info.column.caption).css({ "text-align": "center", "font-weight": "bold" }).appendTo(header); }
                },
                { dataField: "Balance", caption: formatMessage("Balance Amount"), format: { type: "fixedPoint", precision: 2 },
                    headerCellTemplate: function (header, info) { $("<div>").text(info.column.caption).css({ "text-align": "center", "font-weight": "bold" }).appendTo(header); }
                },
                { dataField: "OverdueDays", caption: formatMessage("Overdue Days"), visible: false, allowHiding: true },
                { dataField: "AccountHeadNo", caption: formatMessage("Account Head No"), visible: false, allowHiding: true }
            ],
            [
                { column: "Balance", summaryType: "sum", valueFormat: { type: "fixedPoint", precision: 2 }, displayFormat: formatMessage("Total : {0}") },
                { column: "AccountHead", summaryType: "count", displayFormat: formatMessage("Count : {0}") }
            ]
        )
    );
    loadTasks.push(
        fetchDataAndInitializeGrid(
            "/api/Dashboard/GetBankCashSummary",
            "#accountSummaryGrid",
            [
                { dataField: "AccountGroup", caption: formatMessage("Account Group"), width: 200, allowReordering: true },
                { dataField: "Balance", caption: formatMessage("Balance Amount"), format: { type: "fixedPoint", precision: 2 }, allowReordering: true },
                { dataField: "AccountGroup", caption: formatMessage("Account Group"), visible: false, allowHiding: true }
            ],
            [
                { column: "Balance", summaryType: "sum", valueFormat: { type: "fixedPoint", precision: 2 }, displayFormat: formatMessage("Total : {0}") },
                { column: "AccountGroup", summaryType: "count", displayFormat: formatMessage("Count : {0}") }
            ]
        )
    );

    // Hide page loader after ALL loads
    $.when.apply($, loadTasks).always(function () {
        setTimeout(function () {
            $("#dashboardPageLoader").fadeOut(200);
        }, 150);
    });
});

// Textbox section titles
$(function () {
    const textBoxConfigs = [
        { id: "OutstandingDetails", text: "Outstanding Details", class: "dx-textbox-heading" },
        { id: "TotalClientOutstanding", text: "Total Client Outstanding", class: "dx-textbox-heading10" },
        { id: "TotalCashBalance", text: "Total Cash Balance", class: "dx-textbox-heading10" },
        { id: "TotalSupplierOutstanding", text: "Total Supplier Outstanding", class: "dx-textbox-heading10" },
        { id: "ClientOutstanding", text: "Client Outstanding", class: "dx-textbox-heading10" },
        { id: "SupplierOutstanding", text: "Supplier Outstanding", class: "dx-textbox-heading10" },
        { id: "BankAccountDetails", text: "Bank Account Details", class: "dx-textbox-heading10" },
        { id: "ClientOutstandingAgingChart", text: "Client Outstanding Aging Chart", class: "dx-textbox-heading10" },
        { id: "SupplierOutstandingAgingChart", text: "Supplier Outstanding Aging Chart", class: "dx-textbox-heading10" },
        { id: "BankAccountsChart", text: "Bank Accounts Chart", class: "dx-textbox-heading10" }
    ];
    textBoxConfigs.forEach(config => {
        $(`#${config.id}`).dxTextBox({
            text: formatMessage(config.text),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass(config.class);
            }
        });
    });
});
</script>

<style>
.chart-row1 { display: flex; justify-content: center; align-items: center; }
.chart-row1 rect { fill: transparent; }
.grid-section div { text-align: center; }
.dx-card-container { display: flex; justify-content: center; gap: 20px; padding: 1em; }
.Popupcard:hover { box-shadow: 0px 0px 10px 2px var(--title-background-color); transform: translateY(-5px); cursor: pointer; background-color: #f9fbff; }
.Popupcard { display: inline-block; padding: 20px; background: var(--background-color); border-radius: 10px; box-shadow: 5px 5px 5px 5px var(--title-background-color); text-align: center; transition: transform 0.2s ease, box-shadow 0.3s ease; cursor: pointer; }
.dx-card-header { font-size: 24px; font-weight: bold; margin-bottom: 10px; text-align: center; }
.dx-card-content .total-value { font-size: 24px; font-weight: bold; color: #007acc; }
.grid-container { display: flex; padding: 15px; justify-content: space-between; }
.grid-section { width: 32%; text-align: center; }

.dashboard-card-header {
    text-align: center;    font-size: 1.6rem;    font-weight: bold;    color: #004080;    letter-spacing: 0.5px;    padding: 14px 0 8px 0;    margin-top: 10px;    margin-bottom: 0;    background: #f7fbff;    border-radius: 10px 10px 0 0;
}

</style>
