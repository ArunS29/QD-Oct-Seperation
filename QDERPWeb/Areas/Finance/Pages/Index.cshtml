<style>

    .chart-row1 {
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .chart-row1 rect {
            fill: transparent;
        }

    .grid-section div {
        text-align: center; /* Center the title */
    }

    .dx-card-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        padding: 1em;
    }

    .Popupcard:hover {
        box-shadow: 0px 0px 10px 2px var(--title-background-color);
        transform: translateY(-5px);
        cursor: pointer;
        background-color: #f9fbff;
    }

    .Popupcard {
        display: inline-block;
        padding: 20px;
        background: var(--background-color);
        border-radius: 10px;
        box-shadow: 5px 5px 5px 5px var(--title-background-color);
        text-align: center;
        transition: transform 0.2s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    .dx-card-header {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 10px;
        text-align: center;
    }

    .dx-card-content .total-value {
        font-size: 24px;
        font-weight: bold;
        color: #007acc;
    }

    .grid-container {
        display: flex;
        padding: 15px;
        justify-content: space-between;
    }

    .grid-section {
        width: 32%;
        text-align: center;
    }

    .chart-row {
        display: flex;
        justify-content: space-around;
        padding: 15px;
        align-items: center;
    }

    .chart-container {
        width: 32%;
        text-align: center;
    }

    #clientOutstandingChart,
    #billsOutstandingChart,
    #bankAccountsChart {
        width: 100%;
        height: 400px;
        margin: 0 auto;
    }

    .dx-card {
        padding: 20px;
        background: #f5f5f5;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
