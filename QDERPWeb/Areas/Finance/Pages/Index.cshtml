<script>
    const dashboardRoutes = {
        clientcard: "DashboardClient",
        SupplierCard: "DashboardSupplier",
        DashboardBankAccount: "DashboardBankAccount"
    };

    Object.keys(dashboardRoutes).forEach(cardId => {
        $(`#${cardId}`).on("click", function () {
            window.location.href = `/${tenantName}/Finance/${dashboardRoutes[cardId]}`;
        });
    });


    $(document).ready(function () {
        const apiEndpoints = [
            { url: "/api/Dashboard/supplieroutstanding", target: "#totalBillsOutstandingValue ", key: "balance" },
            { url: "/api/Dashboard/GetTotalClientOutstanding", target: "#totalClientOutstandingValue", key: "balance" },
            { url: "/api/Dashboard/GetCashBalance", target: "#cashBalanceValue", key: "balance" }
        ];

        const fetchData = async (endpoint) => {
            const startTime = performance.now();
            try {
                const response = await $.getJSON(endpoint.url);
                if (response.success) {
                    $(endpoint.target).text(response[endpoint.key].toLocaleString('en-US'));
                } else {
                    console.error(`Error loading data from ${endpoint.url}`);
                }
            } catch (error) {
                console.error(`Error fetching data from ${endpoint.url}:`, error);
            } finally {
                const endTime = performance.now();
                console.log(`Response time for ${endpoint.url}: ${(endTime - startTime).toFixed(2)} ms`);
            }
        };

        apiEndpoints.forEach(fetchData);
    });

    $(document).ready(function () {
        const fetchDataAndInitializeGrid = (url, gridSelector, columns, summaryItems) => {
            const startTime = performance.now(); // Start timing

            $.ajax({
                url: url,
                type: "GET",
                dataType: "json",
                success: function (response) {
                    const fetchEndTime = performance.now(); // End timing for data fetch
                    console.log(`Data fetch time for ${url}: ${(fetchEndTime - startTime).toFixed(2)} ms`);

                    if (response && response.data) {
                        const gridStartTime = performance.now(); // Start timing for grid initialization

                        $(gridSelector).dxDataGrid({
                            dataSource: response.data,
                            columns: columns,
                            columnAutoWidth: true,
                            showBorders: true,
                            wordWrapEnabled: true,
                            filterRow: { visible: false },
                            paging: { enabled: false },
                            height: 400,
                            scrolling: { mode: "standard" },
                            searchPanel: { visible: false },
                            allowColumnReordering: true,
                            allowColumnResizing: true,
                            columnChooser: {
                                enabled: true,
                                mode: "select"
                            },
                            toolbar: {
                                items: [
                                    {
                                        location: "after",
                                        widget: "dxButton",
                                        options: {
                                            icon: "columnchooser",
                                            text: formatMessage("Column Chooser"),
                                            onClick: function () {
                                                $(gridSelector).dxDataGrid("instance").showColumnChooser();
                                            }
                                        }
                                    }
                                ]
                            },
                            summary: {
                                totalItems: summaryItems
                            }
                        });

                        const gridEndTime = performance.now(); // End timing for grid initialization
                        console.log(`Grid initialization time for ${gridSelector}: ${(gridEndTime - gridStartTime).toFixed(2)} ms`);
                    } else {
                        console.error("No data found in the response.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching data:", error);
                }
            });
        };

        // Client Outstanding DataGrid
        fetchDataAndInitializeGrid(
            "/api/Dashboard/GetClientOutstanding",
            "#clientOutstandingGrid",
            [
                {
                    dataField: "AccountHead",
                    caption: formatMessage("Account Head"),
                    width: 200,
                    allowReordering: true,
                    headerCellTemplate: function (header, info) {
                        $("<div>")
                            .text(info.column.caption)
                            .css({ "text-align": "center", "font-weight": "bold" })
                            .appendTo(header);
                    }
                },
                {
                    dataField: "Balance",
                    caption: formatMessage("Balance Amount"),
                    format: { type: "fixedPoint", precision: 2 },
                    allowReordering: true,
                    headerCellTemplate: function (header, info) {
                        $("<div>")
                            .text(info.column.caption)
                            .css({ "text-align": "center", "font-weight": "bold" })
                            .appendTo(header);
                    }
                },
                { dataField: "OverdueDays", caption: formatMessage("Overdue Days"), visible: false, allowHiding: true },
                { dataField: "AccountGroupId", caption: formatMessage("Account Group"), visible: false, allowHiding: true },
                { dataField: "AccountHeadNo", caption: formatMessage("Account Head No"), visible: false, allowHiding: true }
            ],
            [
                {
                    column: "Balance",
                    summaryType: "sum",
                    valueFormat: { type: "fixedPoint", precision: 2 },
                    displayFormat: formatMessage("Total : {0}")
                },
                {
                    column: "AccountHead",
                    summaryType: "count",
                    displayFormat: formatMessage("Count : {0}")
                }
            ]
        );

        // Bills Payable Outstanding DataGrid
        fetchDataAndInitializeGrid(
            "/api/Dashboard/GetBillsPayableOutstanding",
