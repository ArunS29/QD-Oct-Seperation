 @page
@using DevExtreme.AspNet.Mvc;
@using DevExtreme.AspNet.Data;
<style type="text/css">



    /* Global styles for the card */
    .card {
        margin: 20px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    /* Card header styles */
    .card-header {
        background-color: #F0F8FF;
        color: black;
        font-weight: bold;
    }

    /* Card body styles */
    .card-body {
        padding: 15px;
        background-color: #ffffff;
        border-radius: 5px;
    }

    /* Styles for dx-fieldset with horizontal-container class */
    .dx-fieldset.horizontal-container {
        margin-bottom: 0px;
    }


    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }



    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }




    .button-alignment-down {
        margin-bottom: 10px
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    #AccountHeadName {
        width: 250px; /* Adjust the width as needed */
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="LedgerToSubLedgerMapping" class="no-border-title"></div>
    </div>
</div>
<div>
    @await Html.PartialAsync("SalaryPayableMappingFooter")
</div>
        <div class="dx-fieldset horizontal-container" style="margin-bottom: 0px">

            <div>
                @(Html.DevExtreme().TextBox()
                    .ID("AccountLedgerNo")
                    .ReadOnly(true)
                    .Placeholder(new JS("formatMessage('Enter Account Ledger No')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .Label(new JS("formatMessage('Account Ledger No:')"))
                    )
            </div>

            <div>
                @(Html.DevExtreme().TextBox()
                    .ID("AccountHeadName")
                    .ReadOnly(true)
                    .Placeholder(new JS("formatMessage('Enter Account Head Name')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .Label(new JS("formatMessage('Account Head Name:')"))
                    )
            </div>



    <div style="margin-top:20px">
        @(Html.DevExtreme().Button()
            .ID("btnShowRecords")
            .Text("Show Mapping Details") // <-- You want to toggle this
            .Icon("smalliconslayout")
            .Width(300)
            .TabIndex(4)
            .OnClick("onBtnShowRecordsClick") // <-- attach click handler here
            )
    </div>

        </div>
        <div class="dx-field ledgerResult">
            @(
                Html.DevExtreme().DataGrid()
                .ID("dataGrid")
                // .KeyExpr("AccountHeadNo")
                .RemoteOperations(false)
        .KeyExpr("VoucherNoInVoucher")
        .RemoteOperations(true)
        .Height(550)
        .ShowBorders(true)
        .ColumnAutoWidth(true)
        .DataSource(ds => ds.WebApi()
        .RouteName("DefaultApi") // Or your route name
        .Controller("SalaryPayableMapping")
        .LoadAction("GetLedgerMapping") // Initial API
        .LoadParams(new { accid = "" }) // Will be updated dynamically
        )
                .Columns(columns =>
                {
                    columns.Add().DataField("AccountNoInVoucher").Caption(new JS("formatMessage('Account No')"));
                    columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('LegerName')"));

                    columns.Add().DataField("VoucherNoInVoucher").Caption(new JS("formatMessage('Voucher No')"));

                    columns.Add().DataField("AmountInVoucherFormatted").Caption(new JS("formatMessage('Voucher Amount')"));
                    columns.Add().DataField("AmountInSubLedgerFormatted").Caption(new JS("formatMessage('Adjusted/Mapped')"));
                    columns.Add().DataField("BalanceInVoucher").Caption(new JS("formatMessage('Balance Amount')"));
                    columns.Add().DataField("Mapping").Caption(new JS("formatMessage('Mapping Status')"));

                })
                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(fixing => fixing.Enabled(true))
                .HeaderFilter(filter => filter.Visible(true))
                .Height(550)
                .ElementAttr("style", "min-height: 500px;")
                .ColumnAutoWidth(true)
                .FilterRow(filterRow => filterRow.Visible(false))
                .GroupPanel(groupPanel => groupPanel.Visible(false))
                .ShowBorders(true)
                .Width("100%")
                )
        </div>

<script>
    $(function () {
        // Header TextBox Initialization
        $("#LedgerToSubLedgerMapping").dxTextBox({
            text: formatMessage("Ledger To SubLedger Mapping"),
            readOnly: true,
            width: "510px",
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });

        // Set button initial text
        $("#btnShowRecords").dxButton("instance").option("text", "Show Mapping Details");

        // Set query string parameters if present
        const urlParams = new URLSearchParams(window.location.search);
        const acchedid = urlParams.get("acchedid");
        const accheadname = urlParams.get("accheadname");

        if (acchedid) {
            $("#AccountLedgerNo").dxTextBox("instance").option("value", acchedid);
        }
        if (accheadname) {
            $("#AccountHeadName").dxTextBox("instance").option("value", accheadname);
        }

        // Don't load data on page load — just initialize empty grid
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        dataGrid.option("dataSource", []);
    });

    // On button click: toggle API and load data
    function onBtnShowRecordsClick() {
        const btn = $("#btnShowRecords").dxButton("instance");
        const currentText = btn.option("text");

        const accLedgerNo = $("#AccountLedgerNo").dxTextBox("instance").option("value");

        if (!accLedgerNo) {
            DevExpress.ui.notify("Please enter Account Ledger No", "warning", 2000);
            return;
        }

        let apiUrl = "";
        if (currentText === "Show Mapping Details") {
            // User wants to see Subledger Mapping
            btn.option("text", "Show Receivable/Payables with Advance");
            apiUrl = "/api/SalaryPayableMapping/GetSubledgerMapping";
        } else {
            // User wants to go back to Ledger Mapping
            btn.option("text", "Show Mapping Details");
            apiUrl = "/api/SalaryPayableMapping/GetLedgerMapping";
        }

        const dataGrid = $("#dataGrid").dxDataGrid("instance");

        dataGrid.option("dataSource", {
            load: function () {
                return $.getJSON(apiUrl, {
                    accid: accLedgerNo
                });
            }
        });

        dataGrid.refresh();
    }
</script>



