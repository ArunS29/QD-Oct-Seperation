 @page
@using DevExtreme.AspNet.Mvc;
@using DevExtreme.AspNet.Data;
<style type="text/css">



    /* Global styles for the card */
    .card {
        margin: 20px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    /* Card header styles */
    .card-header {
        background-color: #F0F8FF;
        color: black;
        font-weight: bold;
    }

    /* Card body styles */
    .card-body {
        padding: 15px;
        background-color: #ffffff;
        border-radius: 5px;
    }

    /* Styles for dx-fieldset with horizontal-container class */
    .dx-fieldset.horizontal-container {
        margin-bottom: 0px;
    }


    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }



    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }




    .button-alignment-down {
        margin-bottom: 10px
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    #AccountHeadName {
        width: 250px; /* Adjust the width as needed */
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="LedgerToSubLedgerMapping" class="no-border-title"></div>
    </div>
</div>
<div>
    @await Html.PartialAsync("FooterLedgerToSubLedgerMapping")
</div>
</br>
<div class="dx-fieldset horizontal-container" style="margin-bottom: 0px ; align-items: baseline;">

            <div>
                @(Html.DevExtreme().TextBox()
                    .ID("AccountLedgerNo")
                    .ReadOnly(true)
                    .Placeholder(new JS("formatMessage('Enter Account Ledger No')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .Label(new JS("formatMessage('Account Ledger No:')"))
                    )
            </div>

            <div>
                @(Html.DevExtreme().TextBox()
                    .ID("AccountHeadName")
                    .ReadOnly(true)
                    .Placeholder(new JS("formatMessage('Enter Account Head Name')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .Label(new JS("formatMessage('Account Head Name:')"))
                    )
            </div>




    <div style="margin-bottom: 20px;">
        @(Html.DevExtreme().Button()
            .ID("btnToggleGrids")
            .Icon("smalliconslayout")
            .Width(300)
            .TabIndex(4)
            .Text(new JS("formatMessage('Show Mapping Details')"))
            .OnClick("toggleGrids")
            )
    </div>

        </div>
<!-- Ledger Mapping Grid -->
<div class="dx-field ledgerResult" id="ledgerGridContainer">
    @(Html.DevExtreme().DataGrid()
        .ID("ledgerGrid")
        .KeyExpr("VoucherNoInVoucher")
        .RemoteOperations(ops => ops
        .Filtering(true)
        .Sorting(true)
        .Paging(true)
        .Grouping(false) // 👈 disable server-side grouping
        )
        .Height(550)
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .OnContextMenuPreparing("onContextMenuPreparing")
        .ColumnAutoWidth(true)
        .DataSource(ds => ds.WebApi()
        .RouteName("DefaultApi")
        .Controller("SalaryPayableMapping")
        .LoadAction("GetLedgerMapping")
        .LoadParams(new { accid = "" }).LoadParams(new { accid = "", drCrFilter = "" })  // Include drCrFilter as a parameter

       
        )
        .Columns(columns =>
        {
            columns.Add().DataField("AccountNoInVoucher").Caption(new JS("formatMessage('Account No')"));
           // columns.Add().DataField("AccountHead").Caption("Ledger Name");
            columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Ledger Name')")).GroupIndex(0);
            columns.Add().DataField("VoucherNoInVoucher").Caption(new JS("formatMessage('Voucher No')"));
            columns.Add().DataField("VoucherType").Caption(new JS("formatMessage('Voucher Type')"));
            columns.Add().DataField("AmountInVoucherFormatted").Caption(new JS("formatMessage('Voucher Amount')"));
            columns.Add().DataField("AmountInSubLedgerFormatted").Caption(new JS("formatMessage('Adjusted/Mapped')"));
            columns.Add().DataField("BalanceInVoucher").Caption(new JS("formatMessage('Balance Amount')"));
            columns.Add().DataField("Mapping").Caption(new JS("formatMessage('Mapping Status')"));
            columns.Add().DataField("DrCr").Caption(new JS("formatMessage('DrCr')"));
        })
        )
  
</div>

<!-- Subledger Mapping Grid -->
<div class="dx-field ledgerResult" id="subledgerGridContainer" style="display: none;">
    @(Html.DevExtreme().DataGrid()
        .ID("subledgerGrid")
        .KeyExpr("VoucherNoInVoucher")
        .RemoteOperations(true)
        .Height(550)
        .ShowBorders(true)
        .ColumnAutoWidth(true)
        .OnContextMenuPreparing("onContextMenuPreparing1")
        .DataSource(ds => ds.WebApi()
        .RouteName("DefaultApi")
        .Controller("SalaryPayableMapping")
        .LoadAction("GetSubledgerMapping")
        .LoadParams(new { accid = "" })
        )
        .Columns(columns =>
        {
            columns.Add().DataField("VoucherNoInVoucher").Caption(new JS("formatMessage('Voucher No In Voucher')"));
            columns.Add().DataField("VoucherNoInSubLedger").Caption(new JS("formatMessage('Voucher No In SubLedger')"));
            columns.Add().DataField("VoucherRefNo").Caption(new JS("formatMessage('Voucher Ref No')"));
            columns.Add().DataField("AccountNoInVoucher").Caption(new JS("formatMessage('Account No In Voucher')"));
            columns.Add().DataField("AccountNoInSubLedger").Caption(new JS("formatMessage('Account No In SubLedger')"));
            columns.Add().DataField("VoucherType").Caption(new JS("formatMessage('Voucher Type')"));
            columns.Add().DataField("ReferenceNoInSubLedger").Caption(new JS("formatMessage('Reference No In SubLedger')"));
            columns.Add().DataField("AmountInVoucherFormatted").Caption(new JS("formatMessage('Amount In Voucher Formatted')"));
            columns.Add().DataField("AmountInSubLedgerFormatted").Caption(new JS("formatMessage('Amount In SubLedger Formatted')"));
            columns.Add().DataField("TotalAmount").Caption(new JS("formatMessage('Total Amount')"));
            columns.Add().DataField("Mapping").Caption(new JS("formatMessage('Mapping')"));

        })
        )
</div>



<script>
    // ✅ Globally available toggleGrids function
    function toggleGrids() {
        const btn = $("#btnToggleGrids").dxButton("instance");
        const accid = $("#AccountLedgerNo").dxTextBox("instance").option("value");

        if (!accid) {
            DevExpress.ui.notify("Please enter Account Ledger No", "warning", 2000);
            return;
        }

        const currentText = btn.option("text");

        if (currentText === "Show Mapping Details") {
            $("#ledgerGridContainer").hide();
            $("#subledgerGridContainer").show();
            btn.option("text", "Show Receivable/Payables with Advance");

            const subGrid = $("#subledgerGrid").dxDataGrid("instance");
            subGrid.option("dataSource", {
                load: () => $.getJSON("/api/SalaryPayableMapping/GetSubledgerMapping", { accid })
            });
            subGrid.refresh();
        } else {
            $("#subledgerGridContainer").hide();
            $("#ledgerGridContainer").show();
            btn.option("text", "Show Mapping Details");

            const ledgerGrid = $("#ledgerGrid").dxDataGrid("instance");
            ledgerGrid.option("dataSource", {
                load: () => $.getJSON("/api/SalaryPayableMapping/GetLedgerMapping", { accid })
            });
            ledgerGrid.refresh();
        }
    }

    // ✅ On DOM Ready
    $(document).ready(function () {
        function getQueryParam(name) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(name);
        }

        // Get URL params
        const acchedid = getQueryParam("acchedid");
        const accheadname = getQueryParam("accheadname");
        const accid = getQueryParam("accid");
        const FromDate = getQueryParam("FromDate");
        const ToDate = getQueryParam("ToDate");
        const drCrFilter = getQueryParam("drCrFilter"); // Optional

        // Set TextBoxes
        if (acchedid) {
            $("#AccountLedgerNo").dxTextBox("instance").option("value", acchedid);
        }
        if (accheadname) {
            $("#AccountHeadName").dxTextBox("instance").option("value", accheadname);
        }

        // Load ledgerGrid by default
        const ledgerGrid = $("#ledgerGrid").dxDataGrid("instance");

        if (accid) {
            ledgerGrid.option("dataSource", {
                load: () => $.getJSON("/api/SalaryPayableMapping/GetLedgerMapping", {
                    accid: accid,
                    FromDate: FromDate,
                    ToDate: ToDate,
                    drCrFilter: drCrFilter // Optional
                })
            });
            ledgerGrid.refresh();
        }

        // Ensure visibility
        $("#ledgerGridContainer").show();
        $("#subledgerGridContainer").hide();

        // Clear subledger data source
        $("#subledgerGrid").dxDataGrid("instance").option("dataSource", []);
    });







    function handleReportClick(e) {
        const selected = e.itemData.text;
        if (selected === "ShowAllDebtors") {
            ShowAllDebtors();
        } else if (selected === "ShowAllCreditors") {
            ShowAllCreditors();
        }
    }
    function ShowAllDebtors() {
        const grid = $("#ledgerGrid").dxDataGrid("instance");
        grid.clearFilter(); // Clear any previous filters
        grid.option("dataSource", {
            load: () => $.getJSON("/api/SalaryPayableMapping/GetLedgerMapping", {
                accid: $("#AccountLedgerNo").dxTextBox("instance").option("value"),
                drCrFilter: "Dr"  // Passing filter to show only Dr
            })
        });
        grid.refresh();
        DevExpress.ui.notify("Showing All Debtors", "info", 1500);
    }

    function ShowAllCreditors() {
        const grid = $("#ledgerGrid").dxDataGrid("instance");
        grid.clearFilter();
        grid.option("dataSource", {
            load: () => $.getJSON("/api/SalaryPayableMapping/GetLedgerMapping", {
                accid: $("#AccountLedgerNo").dxTextBox("instance").option("value"),
                drCrFilter: "Cr"  // Passing filter to show only Cr
            })
        });
        grid.refresh();
        DevExpress.ui.notify("Showing All Creditors", "info", 1500);
    }

    //EditVoucher
    function onContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") {
            e.items = [
                {
                    text: "Edit Voucher",
                    onItemClick: function () {
                        const voucherType = e.row.data.VoucherType;
                        const voucherNo = e.row.data.VoucherNoInVoucher;

                        // Map voucher types to pages
                        const voucherPageMap = {
                            "Cash Payment": "VoucherCashPayment",
                            "Bank Payment": "VoucherBankPayment",
                            "Cash Receipts": "VoucherEntryCashReceipts",
                            "Bank Receipts": "VoucherEntryReceipts",
                            "Sales": "SalesVoucher",
                            "Purchases": "PurchaseVoucher",
                            "Journal": "VoucherJournal"
                        };

                        const pageName = voucherPageMap[voucherType];

                        if (!pageName) {
                            DevExpress.ui.notify("Unknown voucher type: " + voucherType, "error", 2000);
                            return;
                        }

                        const url = `/${tenantName}/Finance/${pageName}?argsledno=${voucherNo}&vouchertype=${voucherType}`;
                        window.open(url, "_blank");
                    }
                }
            ];
        }
    }
    function onContextMenuPreparing1(e) {
        if (e.row && e.row.rowType === "data") {
            e.items = [
                {
                    text: "Edit Voucher",
                    onItemClick: function () {
                        const voucherType = e.row.data.VoucherType;
                        const voucherNo = e.row.data.VoucherNoInVoucher;

                        // Map voucher types to pages
                        const voucherPageMap = {
                            "Cash Payment": "VoucherCashPayment",
                            "Bank Payment": "VoucherBankPayment",
                            "Cash Receipts": "VoucherEntryCashReceipts",
                            "Bank Receipts": "VoucherEntryReceipts",
                            "Sales": "SalesVoucher",
                            "Purchases": "PurchaseVoucher",
                            "Journal": "VoucherJournal"
                        };

                        const pageName = voucherPageMap[voucherType];

                        if (!pageName) {
                            DevExpress.ui.notify("Unknown voucher type: " + voucherType, "error", 2000);
                            return;
                        }

                        const url = `/${tenantName}/Finance/${pageName}?argsledno=${voucherNo}&vouchertype=${voucherType}`;
                        window.open(url, "_blank");
                    }
                }
            ];
        }
    }

