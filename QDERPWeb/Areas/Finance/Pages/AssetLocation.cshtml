@page
@model QD.ERP.Web.Areas.Finance.Pages.AssetLocationModel
@{
}

@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Add SweetAlert CSS and JS CDN -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.js"></script>

<style type="text/css">
    .card-container {
        background-color: white;
        padding: 0px 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }
    .dx-header-row {
        background-color: white;
    }
    .dx-button-add {
        background-color: #f5f8fb !important;
        color: red !important;
        border: 1px solid #b0c4de;
    }
    .action-buttons-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }
    .action-buttons-container .dx-button {
        margin-right: 10px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 0em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }

    .card-container1 {
        display: flex;
        align-items: end;
        justify-content: flex-start;
        gap: 0px;
        padding-bottom:20px;
    }

    .footer-fixed {
        position: fixed;
        bottom: 0;
        width: 100%;
        background-color: #fff;
        padding: 10px 20px;
        border-top: 1px solid #ccc;
        z-index: 1000;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

</style>

<div class="dx-card-header minimal-header">
    <div class="card-title-icon">

        <i class="fas fa-map-marker-plus"></i>
    </div>
    <h3 class="card-title-text">Asset Location Management</h3>
</div>
<div class="content-container-top">
    <div class="container4">
        <div class="card-container">
        <!-- Asset Location Form -->
        <div class="card-container1">
                    <div class="form-group">
                        @(
                            Html.DevExtreme().TextBox()
                            .Label(new JS("formatMessage('Asset Location')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("txtAssetLocation")
                            .Value(null)
                             .ValidationRules(rules =>
                             {
                             rules.AddRequired()
                                .Message(new JS("formatMessage('Email is required')"));
                             })
                             .Width(550)
                            )
                    </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @(Html.DevExtreme().Button()
                            .Text(new JS("formatMessage('ADD')"))
                            .ID("btnAddAssetLocation")
                            .Height(70)
                            .Width(178)
                            .Icon("plus")
                            .OnClick("function() { addAssetLocation(); }")
                            .ElementAttr(new { @class = "dx-button-add" })
                            )
                    </div>
            </div>
            </div>
            <!-- Grid to Display Asset Locations -->
            <div id="gridContainer"></div>
      

    </div>
    </div>
</div>
<div class="footer-fixed">
    <button id="btnUpdate" class="btn btn-primary">
        <i class="dx-icon-save"></i> Update
    </button>
    <button id="btnBack" class="btn btn-secondary">
        <i class="dx-icon-arrowleft"></i> Back
    </button>
</div>

<script type="text/javascript">
$(function () {
        $("#AssetLocationManagement").dxTextBox({
            text: formatMessage("Asset Location Management"),
            readOnly: true,
            onContentReady: function(e) {
						$(e.element).addClass("dx-textbox-heading");
				}
						

        });
        
    });

    $(function () {
        var updatedRows = []; // To store the updated rows

        // Initialize DevExtreme DataGrid for Asset Location
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "AssetLocationCode",
                load: function () {
                    return $.getJSON('/api/Master/GetAssetLocation'); // Fetch Asset Location data from the API
                },
                update: function (key, values) {
                    var updatedAssetLocation = {
                        AssetLocationCode: key, // Use the key for the asset location to identify it
                        AssetLocation: values.AssetLocation
                    };

                    // Add the updated asset location to the updatedRows array
                    updatedRows.push(updatedAssetLocation);

                    // Send the updated data to the backend via AJAX
                    return $.ajax({
                        type: "POST",
                        url: "/api/Master/UpdateAssetLocation",
                        data: JSON.stringify(updatedAssetLocation),
                        contentType: "application/json",
                        success: function (response) {
                            // Show success alert using SweetAlert
                            Swal.fire({
                                icon: 'success',
                                title: 'Asset Location Updated',
                                text: 'The asset location has been successfully updated.',
                                confirmButtonText: 'OK'
                            });
                        },
                        error: function (xhr) {
                            if (xhr.status === 400) { // If duplicate asset location is found
                                Swal.fire({
                                    icon: 'warning', // Show a warning instead of an error
                                    title: 'Duplicate Asset Location',
                                    text: 'This Asset Location already exists. Please choose a different name.',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    // Trigger the cancel action on the DataGrid after alert is closed
                                    var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                    dataGrid.cancelEditData();  // Cancel the current edit
                                });
                            } else if (xhr.status === 500) {
                                // Show error alert using SweetAlert
                                var errorMessage = xhr.status === 500
                                    ? "Server error: Please try again later."
                                    : "Validation error: " + xhr.responseText;
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: errorMessage,
                                    confirmButtonText: 'OK'
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'There was an error updating the asset location.',
                                    confirmButtonText: 'OK'
                                });
                            }
                        }
                    });
                },
                // remove: function (key) {
                //     // API request to delete the asset location
                //     return $.ajax({
                //         type: "POST",
                //         url: "/api/Master/DeleteAssetLocation", // Adjust API endpoint for deletion
                //         data: JSON.stringify({ AssetLocationCode: key }),
                //         contentType: "application/json",
                //         success: function () {
                //             // Show success alert after row is deleted
                //             Swal.fire({
                //                 icon: 'info',
                //                 title: 'Asset Location Deleted',
                //                 text: 'The asset location has been successfully deleted.',
                //                 confirmButtonText: 'OK'
                //             });
                //         },
                //         error: function (xhr) {
                //             Swal.fire({
                //                 icon: 'error',
                //                 title: 'Error',
                //                 text: 'There was an error deleting the asset location.',
                //                 confirmButtonText: 'OK'
                //             });
                //         }
                //     });
                // }
            }),
            editing: {
                mode: "batch", // Enable batch edit mode for multiple row editing
                allowUpdating: true,  // Allow cell updates
                allowAdding: false,   // No new rows
                allowDeleting: true,  // Allow row deletion
                useIcons: false, // Use icons for save/cancel
                texts: {
                    saveAll: "Update", // Custom text for save button
                    cancelAll: "Cancel All Changes" // Custom text for cancel button
                }
            },
            columns: [
                { dataField: "AssetLocationCode", caption: "Asset Location Code", width: 100, editorOptions: { readOnly: true } },
                { dataField: "AssetLocation", caption: "Asset Location" },
                 {
                    type: "buttons",
                    width: 100,
                    buttons: [
                        {
                            icon: "trash",
                            hint: "Delete",
                            onClick: function (e) {
                                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                var selectedData = e.row.data;
                               var AssetLocationCode = selectedData.AssetLocationCode;

                                // Send delete request to the API
                                $.ajax({
                                    type: "POST",
                                    url: "/api/Master/DeleteAssetLocation",
                                    data: JSON.stringify({ AssetLocationCode: AssetLocationCode }),
                                    contentType: "application/json",
                                    success: function (response) {
                                        if (response.success) {
                                            dataGrid.refresh(); // Refresh the grid
                                            Swal.fire({
                                                icon: 'success',
                                                title: 'Success',
                                                text: formatMessage(' deleted successfully.'),
                                                confirmButtonText: 'OK'
                                            });
                                        } else {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'Error',
                                                text: response.message,
                                                confirmButtonText: 'OK'
                                            });
                                        }
                                    },
                                    error: function (xhr) {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error',
                                            text: xhr.responseText,
                                            confirmButtonText: 'OK'
                                        });
                                    }
                                });
                            }
                        }
                    ]
                }
            ],
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: {
                visible: false,
                applyFilter: "auto"
            },
           
            onRowUpdated: function (e) {
                // Show SweetAlert when a row is updated
                Swal.fire({
                    icon: 'success',
                    title: 'Row Updated',
                    text: 'The row data was successfully updated.',
                    confirmButtonText: 'OK'
                });
            },
            onRowInserted: function (e) {
                // Show SweetAlert when a new row is inserted
                Swal.fire({
                    icon: 'success',
                    title: 'Row Inserted',
                    text: 'A new row was added successfully.',
                    confirmButtonText: 'OK'
                });
            },
            onRowRemoved: function (e) {
                // Show SweetAlert when a row is removed
                Swal.fire({
                    icon: 'info',
                    title: 'Row Removed',
                    text: 'The row has been removed from the grid.',
                    confirmButtonText: 'OK'
                });
            },
            // Enable virtual scrolling
            scrolling: {
                mode: "virtual", // Virtual scrolling for better performance
                rowRenderingMode: "virtual",
                useNative: true
            },
            height: 400,
            width: "100%" // Full width for the grid
        });
    });


    // Function to Add a New Asset Location
    function addAssetLocation() {
        var assetLocation = $("#txtAssetLocation").dxTextBox("instance").option("value");

        if (assetLocation) {
            var assetLocationData = { AssetLocation: assetLocation };

            // In the addAssetLocation function:
            $.ajax({
                type: "POST",
                url: "/api/Master/Addassetlocation",
                data: JSON.stringify(assetLocationData),
                contentType: "application/json",
                success: function () {
                    Swal.fire({
                        icon: 'success',
                        title: 'Asset Location Added',
                        text: 'The new asset location has been added.',
                        confirmButtonText: 'OK'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            location.reload(); // Reload the page after adding
                        }
                    });
                },
                error: function (xhr) {
                        if (xhr.status === 400 && errorMessage.includes("Asset Location already exists")) {
                               
                        Swal.fire({
                            icon: 'error',
                            title: 'Duplicate Asset Location',
                            text: 'This Asset Location already exists.',
                            confirmButtonText: 'OK'
                         })
                            } else {
                               Swal.fire({
                            icon: 'error',
                            title: 'Duplicate Asset Location',
                            text: 'This Asset Location already exists.',
                            confirmButtonText: 'OK'
                         })
                            }
                }
            });

        } else {
                    DevExpress.ui.notify("Please fill required details!", "error", 2000);
        }
    }


        $("#btnUpdate").on("click", function () {
        $("#gridContainer").dxDataGrid("instance").saveEditData();  // Save all edits
    });

    $("#btnBack").on("click", function () {
        window.parent.closeModal();  // Close modal
    });

</script>
