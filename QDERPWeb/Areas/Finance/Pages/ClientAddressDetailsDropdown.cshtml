@page
@model QD.ERP.Web.Areas.Finance.Pages.ClientAddressDetailsDropdownModel
@{
}
@using DevExtreme.AspNet.Mvc

<style>
    /* Form Container Styling */
    .address-form-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* Ensures even spacing between fields */
    .dx-field-item-content {
        display: flex;
        flex-grow: 1;
        gap: 10px;
    }

    /* Equal width for all input fields */
    .dx-texteditor, .dx-dropdownbox {
        width: 100%;
    }

    /* Improve label readability */
    .dx-field-label {
        font-weight: bold;
        color: #333;
        font-size: 14px;
    }

    /* Adjust dropdown styling */
    .dx-dropdownbox {
        border-radius: 5px;
        padding: 8px;
    }

    /* Spacing between form rows */
    .address-form-group .dx-field-item {
        margin-bottom: 12px;
    }
</style>

<div class="dx-viewport">
    @(
        Html.DevExtreme().Form()
        .ID("addressForm")
        .ColCount(1) // Main container with a single column
        .LabelLocation(FormLabelLocation.Top)
        .ElementAttr("class", "address-form-container")
        .Items(items =>
        {
            items.AddGroup()
            .ColCount(2) // Row 1 & 2 will be two columns
            .CssClass("address-form-group")
            .Items(groupItems =>
            {
                // Row 1: Street Name | Street Name (Arabic) (2 columns)
                groupItems.AddSimple().DataField("StreetName")
            .Label(l => l.Text("Address - Street Name *")).ColSpan(1);
                groupItems.AddSimple().DataField("StreetNameArabic")
            .Label(l => l.Text("Address - Street Name (Arabic) *")).ColSpan(1);

                // Row 2: Additional Address | Additional Address (Arabic) (2 columns)
                groupItems.AddSimple().DataField("AdditionalAddress")
            .Label(l => l.Text("Address - Additional Address")).ColSpan(1);
                groupItems.AddSimple().DataField("AdditionalAddressArabic")
            .Label(l => l.Text("Address - Additional Address (Arabic)")).ColSpan(1);
            });

            items.AddGroup()
            .ColCount(3) // Row 3, Row 4, and Row 5 will have three columns
            .CssClass("address-form-group")
            .Items(groupItems =>
            {
                // Row 3: Building Number | Client City | Client City (Arabic) (3 columns)
                groupItems.AddSimple().DataField("BuildingNumber")
            .Label(l => l.Text("Building Number")).ColSpan(1);
                groupItems.AddSimple().DataField("ClientCity")
            .Label(l => l.Text("Client City *")).ColSpan(1);
                groupItems.AddSimple().DataField("ClientCityArabic")
            .Label(l => l.Text("Client City (Arabic) *")).ColSpan(1);

                // Row 4: Additional Number | Province | Province (Arabic) (3 columns)
                groupItems.AddSimple().DataField("AdditionalNumber")
            .Label(l => l.Text("Additional Number")).ColSpan(1);
                groupItems.AddSimple().DataField("Province")
            .Label(l => l.Text("Province / State")).ColSpan(1);
                groupItems.AddSimple().DataField("ProvinceArabic")
            .Label(l => l.Text("Province / State (Arabic)")).ColSpan(1);

                // Row 5: Postal Code | District | District (Arabic) (3 columns)
                groupItems.AddSimple().DataField("PostalCode")
            .Label(l => l.Text("Postal Code *")).ColSpan(1);
                groupItems.AddSimple().DataField("District")
            .Label(l => l.Text("District / Neighborhood *")).ColSpan(1);
                groupItems.AddSimple().DataField("DistrictArabic")
            .Label(l => l.Text("District / Neighborhood (Arabic)")).ColSpan(1);

                // Row 6: Country Code Dropdown (1 column, full width)
                groupItems.AddSimple().DataField("CountryCode")
            .Label(l => l.Text("Country Code *"))
            .Editor(e => e.DropDownBox()
            .DataSource(new[] { "US", "UK", "IN", "SA", "UAE" })
            .Value("IN")
            ).ColSpan(3); // Spanning full width
            });
        })
        )
</div>
