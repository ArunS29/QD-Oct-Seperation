@page
@model QD.ERP.Web.Areas.Finance.Pages.ReportviewModel
@{
 //   Layout = null;
}

<div class="form-group">
    @(Html.DevExtreme().Button()
        .ID("btnshow")
        .Text("Show")
        .Height(70)
        .Width(178)
        .Icon("plus")
        .OnClick("showReport"))
</div>

<script>
    function showReport() {
        // Open the report in a new tab
        window.open('/Finance/Report/GenerateReport', '_blank');
    }
</script>
