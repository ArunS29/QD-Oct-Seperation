                var lastDrCr = "Dr"; // Default value for the first entry (Dr)
                let isUpdatingCell;
                function addVoucherEntry() {
                    // Get values from the fields
                    var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
                    var accountHead = $("#ddAccountHead").dxDropDownBox("instance").option("value");
                    var voucherAmount = $("#txtVoucherAmount").dxNumberBox("instance").option("value");
                    var drCr = lastDrCr; // Set DrCr based on the previous entry
                    var entryNarration = $("#txtEntryNarration").dxTextArea("instance").option("value");

                    // Reset previous error styles
                    $("#ddAccountHead").css("border", "");
                    $("#txtVoucherAmount").css("border", "");

                    // Validation logic
                    var isValid = true;

                    if (!accountHead) {
                        isValid = false;
                        $("#ddAccountHead").css("border", "1px solid red"); // Highlight accountHead in red
                        DevExpress.ui.notify("Account Head is required.", "error", 2000);
                    }

                    if (!voucherAmount || voucherAmount <= 0) {
                        isValid = false;
                        $("#txtVoucherAmount").css("border", "1px solid red"); // Highlight amount in red
                        DevExpress.ui.notify("Amount should not be 0 or less.", "error", 2000);
                    }

                    // Stop execution if validation fails
                    if (!isValid) {
                        return; // Exit function if validation fails
                    }

                    // Prepare the object to send
                    var VE = {
                        "VoucherNo": voucherNo,
                        "AccountHead": accountHead,
                        "VoucherAmount": voucherAmount,
                        "DrCr": drCr,
                        "AddedBy": "102",
                        "AddedOn": new Date(),
                        "EntryNarration": entryNarration
                    };

                    // AJAX request to add voucher entry
                    $.ajax({
                        type: "POST",
                        url: "/api/VoucherJournal/AddVoucherEntry",
                        contentType: "application/json",
                        data: JSON.stringify(VE),
                        dataType: "json",
                        success: function (response) {
                            console.log(response.data);
                            // Update the data grid with the new data
                            $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

                            // Clear Account Head and Amount fields after submission
                            $("#ddAccountHead").dxDropDownBox("instance").option("value", null);
                            $("#txtVoucherAmount").dxNumberBox("instance").option("value", null);

                            // Toggle DrCr for next entry and update the dropdown value
                            lastDrCr = (lastDrCr === "Dr") ? "Cr" : "Dr"; // Toggle Dr and Cr
                            $("#sbDrCr").dxSelectBox("instance").option("value", lastDrCr); // Set the dropdown value
                        },
                        error: function (xhr, status, error) {
                            DevExpress.ui.notify("Error occurred while updating data: " + error, "error", 3000);
                        }
                    });
                }


                function onVoucherNoChanged(e) {
                    $.ajax({
