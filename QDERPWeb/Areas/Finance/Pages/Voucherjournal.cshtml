        widget: "dxButton",
        options: {
            icon: "search",
            hint: "Toggle Search Panel",
           onClick: function () {
                const visible = grid.option("filterRow.visible");
                grid.option("filterRow.visible", !visible);
            }

        }
    };

    // Insert right after the built-in Column Chooser button if present
    const ccIndex = items.findIndex(i => i.name === "columnChooserButton");
    if (ccIndex >= 0) {
        items.splice(ccIndex + 1, 0, searchToggle);
    } else {
        // Fallback: just add it to the right side
        items.push(searchToggle);
    }
}




    renderContextMenu();
</script>
