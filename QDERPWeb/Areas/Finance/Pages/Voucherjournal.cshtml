                                                   <span>
                                                       <%- data.AccountHead ? data.AccountHead : "No Selection" %>
                                                   </span>
                                               </div>
                                           </text>)
                            .EditCellTemplate(@<text>


                    @(Html.DevExtreme().DropDownBox()
                                    .DataSource(d => d.WebApi()
                                    .Controller("VoucherJournal")
                                    .LoadAction("GetSupplierName")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("AccountId")
                                    )

                                    .LabelMode(EditorLabelMode.Floating)
                                    .ID("accountDropDownBoxEdit")
                                    .ShowClearButton(true)
                                    .AcceptCustomValue(true)
                                    .OpenOnFieldClick(false)
                                    .ValueChangeEvent("change")
                                    .HoverStateEnabled(true)
                                    .Value(new JS("data.AccountHead"))
                                    .ValueExpr("AccountId")
                                    .DisplayExpr("AccountHead")
                                    .OnValueChanged("gridBox_valueChanged")
                                    .OnOpened("onOpened")
                                                          @* .Width(250) *@
                                    .TabIndex(1)
                                    .DropDownOptions(o => o.Width(500))
                                    .OnKeyDown("onKeyDown")
                                    .ContentTemplate(new TemplateName("AccountHeadEditDropdownContentTemplate"))
                                    )


                </text>);
                            columns.Add()
                            .Caption(new JS("formatMessage('Debit')"))
                            .Alignment(HorizontalAlignment.Right)
                             .CalculateCellValue(@"
function(data) {
    // derive aDrAmount
    var DrAmount = data.DrCr === 'Dr' ? data.VoucherAmount : 0;

    if (DrAmount != null) {
        var currencyRate = $('#txtCurrencyRate').dxNumberBox('instance').option('value');
        currencyRate = Math.round(currencyRate * 100) / 100;

        var val = DrAmount / currencyRate;
        return Math.round(val * 100) / 100; // keep 2 decimals
    }
    return null;
}")
    .CustomizeText("function(e) { " +
        "return e.value !== undefined && e.value !== null ? " +
        "e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
    "}");


                            columns.Add()
                            .Caption(new JS("formatMessage('Credit')"))
                            .Alignment(HorizontalAlignment.Right)
                             .CalculateCellValue(@"
function(data) {
    // derive CrAmount
    var CrAmount = data.DrCr === 'Cr' ? data.VoucherAmount : 0;

    if (CrAmount != null) {
        var currencyRate = $('#txtCurrencyRate').dxNumberBox('instance').option('value');
        currencyRate = Math.round(currencyRate * 100) / 100;

        var val = CrAmount / currencyRate;
        return Math.round(val * 100) / 100; // keep 2 decimals
    }
    return null;
}")
    .CustomizeText("function(e) { " +
        "return e.value !== undefined && e.value !== null ? " +
        "e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
    "}");


                            columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('Entry Narration')"));

                          


                            columns.AddFor(m => m.AddedBy).Caption(new JS("formatMessage('Added By')")).Alignment(HorizontalAlignment.Left).Visible(false);
                            columns.AddFor(m => m.AddedOn).Caption(new JS("formatMessage('Added On')")).Alignment(HorizontalAlignment.Left).Visible(false);


                        })
                        .AllowColumnReordering(true)
				.ColumnResizingMode(ColumnResizingMode.Widget)
                        .AllowColumnResizing(true)
                        .ColumnChooser(c => c.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))

                        .ColumnFixing(fixing => fixing.Enabled(true))
                        .HeaderFilter(filter => filter.Visible(false))
                        .Height(250)
                        .ColumnAutoWidth(true)
                        .FilterRow(filterRow => filterRow.Visible(false))
                        .GroupPanel(groupPanel => groupPanel.Visible(false))
                        .ShowBorders(true)
            @* .Width("1") *@
                        .Editing(editing => editing
                        .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
                        .AllowUpdating(true)   // Enable editing of existing rows
                        .AllowDeleting(true)   // Enable deleting rows
                        .UseIcons(true)
                        )
                                    .OnRowPrepared(@"
            function(e) {
                   
                    if (e.rowType === 'data' && e.data.DrCr === 'Cr') {
                    $(e.rowElement).css('background-color', 'var(--header-color) !important');
                    
                    }
                    if (e.rowType === 'data' && e.data.DrCr === 'Dr') {
                    $(e.rowElement).css('background-color', 'var(--title-background-color) !important');
                    $(e.rowElement).find('td').css('color', 'white');
                    
                    }
            }
            ")
                        .OnEditorPreparing("onEditorPreparing")
                                                                // ✅ Add Total Summary for Debit & Credit Fields
                        .Summary(summary =>
                        {
                            summary.TotalItems(totalItems =>
                            {
                                totalItems.Add()
                            .Column("Debit")
                            .SummaryType(SummaryType.Sum)
                            .DisplayFormat("Total Debit: {0}")
                           .CustomizeText("function(e) { " +
           "return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
           "}");
                                totalItems.Add()
                            .Column("Credit")
                            .SummaryType(SummaryType.Sum)
                            .DisplayFormat("Total Credit: {0}")
                           .CustomizeText("function(e) { " +
           "return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; " +
           "}");
                            });
                        })
                        )

