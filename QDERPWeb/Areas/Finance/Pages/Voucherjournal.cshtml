@page
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
.context-menu {
    display: none;
    position: absolute;
    background-color: white;
    border: 1px solid #ccc;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    list-style: none;
    padding: 8px 0;
    z-index: 1000;
    width: 380px; /* Increased width */
}

.context-menu li {
    padding: 8px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
}

.context-menu li:hover {
    background-color: #f0f0f0;
}

.no-border-input {
    white-space: normal;      /* Wrap text */
    word-break: break-word;   /* Break long words */
    flex: 1;                  /* Fill remaining space */
    padding-left: 8px;        /* Space from icon */
}


    .dx-field-label {
        font-weight: bold !important;
    }
    .paddingLeft{
        padding-left: 15px;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="JournalVoucherEntry" class="no-border-input"></div>
    </div>
</div>

<div id="costAllocationPopup" style="display:none;">
    <div style="margin-bottom:10px">
        @(Html.DevExtreme().Button()
            .ID("btnSaveCostAllocation")
            .Icon("save")
            .Text(new JS("formatMessage('Save')"))
            .OnClick("function() { saveCostAllocation(); }")
            )
    </div>
</div>


<div class="dx-fieldset horizontal-container" style="margin-bottom: 0px">
    <div class="form-group">
        @(Html.DevExtreme().TextBox()
            .Label(new JS("formatMessage('Voucher No')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("VoucherNo")
            .Value("")
            .Placeholder(new JS("formatMessage('Generating...')"))
            .OnValueChanged("updateTemporaryNo")
          
            )
    </div>
    <div class="form-group">
        @(Html.DevExtreme().DateBox()
            .Label(new JS("formatMessage('Voucher Date')"))
            .ID("VoucherDate")
            .InputAttr("aria-label", "Date")
            .LabelMode(EditorLabelMode.Outside)
            .Type(DateBoxType.Date)
            .DisplayFormat("dd-MMM-yyyy")
            .Value(DateTime.Now)
            )
    </div>
    <div class="form-group">
        @(Html.DevExtreme().DateBox()
            .Label(new JS("formatMessage('Effective Date')"))
            .ID("EffectiveDate")
            .InputAttr("aria-label", "Date")
            .LabelMode(EditorLabelMode.Outside)
            .Type(DateBoxType.Date)
            .DisplayFormat("dd-MMM-yyyy")
            .Value(DateTime.Now)
            )
    </div>
    <div class="form-group">
        @(Html.DevExtreme().SelectBox()
            .Label(new JS("formatMessage('VoucherType')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("VoucherType")
            .DataSource(new[] { "Journal" })
            .Value("Journal")
            .Disabled(true)
            )
    </div>


    <div class="form-group">
        @(Html.DevExtreme().TextBox()
            .Label(new JS("formatMessage('Temporary No')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("TemporaryNo")
            .Value("")
            .Placeholder(new JS("formatMessage('Generating...')"))
            .ReadOnly(true)
            )
    </div>
</div>



<div class="dx-fieldset horizontal-container " style="margin-bottom:0px;">

    <div class="form-group">
        <div class="button-alignment-down">
        </div>
        @(
            Html.DevExtreme().SelectBox()
            .Label(new JS("formatMessage('Dr/Cr')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("sbDrCr")
            .DataSource(new[] { "Dr", "Cr" })
            .Value("Dr")
            .Placeholder(new JS("formatMessage('Select Transaction Type')"))
            .Width(90)
            )
    </div>
    <div class="form-group">
        @(Html.DevExtreme().DropDownBox()
            .Label(new JS("formatMessage('Account Head')"))
            .DataSource(d => d.WebApi()
            .Controller("VoucherJournal")
            .LoadAction("GetSupplierName")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("AccountId")
            )
            .LabelMode(EditorLabelMode.Outside)
            .ID("ddAccountHead")
            .ShowClearButton(true)
            .AcceptCustomValue(true)
            .OpenOnFieldClick(false)
            .ValueChangeEvent("input")
            .HoverStateEnabled(true)
            .ValueExpr("AccountId")
            .DisplayExpr("AccountHead")
            .OnInput("dropDownBoxOnInput")
            .OnOpened("onOpened")
            .Width(650)
            .TabIndex(1)
            .DropDownOptions(o => o.Width(1000))
            .OnKeyDown("onKeyDown")
            .ContentTemplate(new TemplateName("AccountHeadContentTemplate"))

            )
    </div>
    <div class="form-group" style="margin-top:25px;">
        @(Html.DevExtreme().Button()
            .ID("btnAddAHead")
            .Icon("plus")
            .OnClick("showLedgerAccountPopup")
            )
        <!-- DevExtreme Popup -->
        @(Html.DevExtreme().Popup()
            .ID("ledgerAccountPopup")
            .Width("93%")
            .Height("85%")
            .Title("Add Ledger Account")
            .ShowTitle(true)
            .CloseOnOutsideClick(true)
            .Visible(false)
            .ResizeEnabled(true)
            .ContentTemplate(@<text>
            <div id="popupContent" class="background" style="width:100%; height:100%;">
                <iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
            </div>
        </text>)
            )
    </div>
    <div class="form-group" style="margin-top:25px;">
        @(Html.DevExtreme().Button()
            .ID("btnEditAHead")
            .Icon("edit")
            .OnClick("showLedgerAccountEditPopup")
            )
        @(Html.DevExtreme().Popup()
            .ID("ledgerEditAccountPopup")
            .Width("93%")
            .Height("85%")
            .Title("Edit Ledger Account")
            .ShowTitle(true)
            .CloseOnOutsideClick(true)
            .Visible(false)  // Hidden by default
            .ResizeEnabled(true)
            .ContentTemplate(@<text>
            <div id="popupContent" style="width:100%; height:100%;">
                <iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
            </div>
        </text>)
            )
    </div>
    <div class="form-group">
        @(
            Html.DevExtreme().NumberBox()
            .Label(new JS("formatMessage('Amount')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("txtVoucherAmount")
            .Value(0.00)

            .Min(0)
            .Placeholder("0.00")
            .Format("#,##0.00")
            .InputAttr(new
            {
                style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                type = "number",
                step = "0.01"
            })

            )
    </div>
    <div class="form-group">
        @(Html.DevExtreme().DropDownBox()
            .Label("Base Currency")
            .DataSource(d => d.WebApi()
            .Controller("Utility") // Use same controller or change if needed
            .LoadAction("GetCurrencyList")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("CurrencyExchangeId")
            )
            .ValidationRules(rules =>
            {
                rules.AddRequired()
                .Message("Please select a base currency.");
            })
            .LabelMode(EditorLabelMode.Outside)
            .ID("ddlBaseCurrency")
            .ShowClearButton(true)
            .AcceptCustomValue(false)
            .OpenOnFieldClick(true)
            .Value(1) // Change default value if needed
            .ValueExpr("CurrencyExchangeId")
            .DisplayExpr("CurrencyName")
            .OnInput("dropDownBoxOnInput") // Reuse or define separate handler if needed
            .OnOpened("onOpened")
            .Width(160)
            .TabIndex(2) // Different tabindex to separate from the first
            .DropDownOptions(o => o.Width(700))
            .OnKeyDown("onKeyDown")
            //.OnValueChanged("dropDownBoxValueChanged") // Optional
            .ContentTemplate(new TemplateName("BaseCurrencyContentTemplate"))
            )
    </div>

    @using (Html.DevExtreme().NamedTemplate("BaseCurrencyContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("basecurrency-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("Utility")
            .LoadAction("GetCurrencyList")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("CurrencyExchangeId")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            .Selection(sl => sl.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
            .OnSelectionChanged("onBaseCurrencySelectionChanged") // Define this JS function
            .Paging(p => p.PageSize(10))
            .Height(300)
            .Columns(columns =>
            {
                columns.Add().DataField("CurrencyExchangeId").Caption(new JS("formatMessage('ID')")).Visible(true);
                columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')"));
                columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Symbol')"));
                columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')"));
                columns.Add().DataField("CurrencyMasterCode").Caption(new JS("formatMessage('unicode')")).DataType(GridColumnDataType.Boolean);
                columns.Add().DataField("CurrencyPoints").Caption(new JS("formatMessage('point')")).DataType(GridColumnDataType.Boolean);

            })
            )
    }

    <div class="form-group">
        @(Html.DevExtreme().DropDownBox()
            .Label("Convertion Currency")
            .DataSource(d => d.WebApi()
            .Controller("Utility") // Adjust if needed
            .LoadAction("GetCurrencyList")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("CurrencyExchangeId")
            )
            .ValidationRules(rules =>
            {
                rules.AddRequired()
                .Message("Please select a currency.");
            })
            .LabelMode(EditorLabelMode.Outside)
            .ID("ddCurrency")
            .ShowClearButton(true)
            .AcceptCustomValue(false)
            .OpenOnFieldClick(true)
            .Value(1)
            .ValueExpr("CurrencyExchangeId")
            .DisplayExpr("CurrencyName")
            .OnInput("dropDownBoxOnInput")
            .OnOpened("onOpened")
            .Width(160)
            .TabIndex(1)
            .DropDownOptions(o => o.Width(700))
            .OnKeyDown("onKeyDown")
            //.OnValueChanged("dropDownBoxValueChanged")
            .ContentTemplate(new TemplateName("CurrencyContentTemplate"))
            )
    </div>
    <div class="form-group">
        @(Html.DevExtreme().TextBox()
            .Label("Convertion Rate")
            .LabelMode(EditorLabelMode.Outside)
            .ID("txtCurrencyRate")
            .Value("0.00")
            //  .ReadOnly(true) // Make it read-only
            .Width(160)
            )
    </div>
    @using (Html.DevExtreme().NamedTemplate("CurrencyContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("currency-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("Utility")
            .LoadAction("GetCurrencyList")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("CurrencyExchangeId")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            .Selection(sl => sl.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
            .OnSelectionChanged("onCurrencySelectionChanged")
            .Paging(p => p.PageSize(10))
            .Height(300)
            .Columns(columns =>
            {
                columns.Add().DataField("CurrencyExchangeId").Caption(new JS("formatMessage('ID')")).Visible(true);
                columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')"));
                columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Symbol')"));
                columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')"));
                columns.Add().DataField("CurrencyMasterCode").Caption(new JS("formatMessage('unicode')")).DataType(GridColumnDataType.Boolean);
                columns.Add().DataField("CurrencyPoints").Caption(new JS("formatMessage('point')")).DataType(GridColumnDataType.Boolean);

            })
            )
    }

</div>
<div class="dx-fieldset horizontal-container" style="margin-top:10px;">
    <div class="form-group">
    </div>

    <div class="form-group">
        @(
            Html.DevExtreme().TextArea()
            .Label(new JS("formatMessage('Narration')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("txtEntryNarration")
            .Value("")
            .Height(40)
            .Width(720)
            .Placeholder(new JS("formatMessage('Enter your comments here...')"))
            .MaxLength(500)
            )
    </div>
    <div class="form-group" style="margin-top: 25px;">
        @(Html.DevExtreme().Button()
            .ID("btnVoucherEntry")
            .Text(new JS("formatMessage('Add')"))
            .Height(40)
            .Width(178)
            .Icon("plus")
            .OnClick("function() { addVoucherEntry(); }")
            )
    </div>

</div>


<div class="dx-field ledgerResult">
    @(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl201VoucherEntryTemp>()
            .ID("dataGrid")
            .KeyExpr("VoucherEntryNo")
            .RemoteOperations(false)
            .OnRowRemoved("onRowRemoved")

            .Columns(columns =>
            {
                columns.AddFor(m => m.VoucherNo).Caption(new JS("formatMessage('Voucher No')")).Visible(false);
                columns.AddFor(m => m.VoucherEntryNo).Caption(new JS("formatMessage('VoucherEntryNo')")).Visible(false);
                columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('Dr/Cr')")).AllowEditing(false);

                columns.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('Account Head')"))
            .CellTemplate(@<text>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>
                <%- data.AccountHead ? data.AccountHead : "No Selection" %>
            </span>
        </div>
    </text>)
        .EditCellTemplate(@<text>


        @(Html.DevExtreme().DropDownBox()
        .DataSource(d => d.WebApi()
        .Controller("VoucherJournal")
        .LoadAction("GetSupplierName")
        .LoadMode(DataSourceLoadMode.Raw)
        .Key("AccountId")
        )

        .LabelMode(EditorLabelMode.Outside)
        .ID("accountDropDownBoxEdit")
        .ShowClearButton(true)
        .AcceptCustomValue(true)
        .OpenOnFieldClick(false)
        .ValueChangeEvent("change")
        .HoverStateEnabled(true)
        .Value(new JS("data.AccountHead"))
        .ValueExpr("AccountId")
        .DisplayExpr("AccountHead")
        .OnValueChanged("gridBox_valueChanged")
        .OnOpened("onOpened")
        @* .Width(250) *@
        .TabIndex(1)
        .DropDownOptions(o => o.Width(500))
        .OnKeyDown("onKeyDown")
        .ContentTemplate(new TemplateName("AccountHeadEditDropdownContentTemplate"))
        )


    </text>);
                columns.Add()
    .Caption(new JS("formatMessage('Debit')"))
    .Alignment(HorizontalAlignment.Right)
    .CalculateCellValue(@"
    function(data) {
    return data.DrCr === 'Dr' ? data.VoucherAmount : 0;
    }")
    .CustomizeText(@"
    function(e) {
    return Number(e.value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }");

                columns.Add()
    .Caption(new JS("formatMessage('Credit')"))
    .Alignment(HorizontalAlignment.Right)
    .CalculateCellValue(@"
    function(data) {
    return data.DrCr === 'Cr' ? data.VoucherAmount : 0;
    }")
    .CustomizeText(@"
    function(e) {
    return Number(e.value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }");

                columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('Entry Narration')"));

                columns.AddFor(m => m.VoucherEntryNo).Caption(new JS("formatMessage('DeleteLine')")).Visible(false);


                columns.AddFor(m => m.AddedBy).Caption(new JS("formatMessage('Added By')")).Alignment(HorizontalAlignment.Left).Visible(false);
                columns.AddFor(m => m.AddedOn).Caption(new JS("formatMessage('Added On')")).Alignment(HorizontalAlignment.Left).Visible(false);


            })
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnChooser(c => c.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.Select))

        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(true))
        .Height(250)
        .ColumnAutoWidth(true)
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        @* .Width("1") *@
        .Editing(editing => editing
        .Mode(GridEditMode.Cell) // or use .Batch(), .Cell(), or .Popup() depending on your requirement
        .AllowUpdating(true)   // Enable editing of existing rows
        .AllowDeleting(true)   // Enable deleting rows
        .UseIcons(true)
         )
         .OnRowPrepared(@"function(e) {
		if (e.rowType === 'data' && e.data.DrCr === 'Cr') {
		$(e.rowElement).css('background-color', 'lightgray');
		}
		}")
        .OnEditorPreparing("onEditorPreparing")
        // ✅ Add Total Summary for Debit & Credit Fields
        .Summary(summary =>
        {
            summary.TotalItems(totalItems =>
            {
                totalItems.Add()
            .Column("Debit")
            .SummaryType(SummaryType.Sum)
            .DisplayFormat("Total Debit: {0}")
            .CustomizeText("function(e) { return e.value ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0.00'; }");

                totalItems.Add()
            .Column("Credit")
            .SummaryType(SummaryType.Sum)
            .DisplayFormat("Total Credit: {0}")
            .CustomizeText("function(e) { return e.value ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0.00'; }");
            });
        })
        )
</div>
