        function onVoucherDateChanged(e) {
            console.log("Selected Date:", e.value);
            var voucherDate = $("#VoucherDate").dxDateBox("instance");
            var effectiveDate = $("#EffectiveDate").dxDateBox("instance");

            voucherDate.option("onValueChanged", function (e) {
                let voucherDateval = e.value; // Get Date from DevExtreme DateBox

                // Check if voucherDateval is valid
                if (!voucherDateval) return;

                // Set effectiveDate to the same value as voucherDate
                effectiveDate.option("value", voucherDateval);

                // Convert to 'yyyy-MM-dd' format
                let formattedDate = new Date(voucherDateval).toISOString().split("T")[0];

                // Define the cutoff date (2021-12-31)
                let cutoffDate = new Date("2021-12-31");

                // Get the current date to set if the voucher date is blocked
                let currentdate = new Date();
                let formattedCurrentDate = currentdate.toISOString().split("T")[0]; // Format it as 'yyyy-MM-dd'

                // Check if the formatted voucher date is before the cutoff date
                if (new Date(formattedDate) < cutoffDate) {
                    // Show alert for blocked entry
                    DevExpress.ui.notify("This Voucher Entry date has been blocked. Please review your entry date.", "Blocked Entry");

                    // Set both voucherDate and effectiveDate to the current date
                    voucherDate.option("value", formattedCurrentDate);
                    effectiveDate.option("value", formattedCurrentDate);
                }
            });
        }
        function fetchVoucherDetails(voucherNo) {


            $.ajax({
                type: "GET",
                url: "/api/VoucherJournal/GetVoucherMasterEntries",
                contentType: "application/json",
                data: { voucherNo: voucherNo },
                success: function (response) {
                    if (!response.success) {
                        // DevExpress.ui.notify(response.message, "error", 2000);
                        //return;
                    }
                    debugger
                    console.log(response.data[0]);


                    const data = response.data[0];
                    if (data) {
                        
                        $("#VoucherDate").dxDateBox("instance").option("value", data.VoucherDate);
                        $("#EffectiveDate").dxDateBox("instance").option("value", data.VoucherEffectiveDate);
                        // $("#BillDate").dxDateBox("instance").option("value", data.BillDate || "");
                        $("#VoucherNarration").dxTextBox("instance").option("value", data.VoucherNarration || "");
                        $("#Remarks").dxTextBox("instance").option("value", data.BillRemarks || "");
                        $("#VerifiedBy").dxCheckBox("instance").option("value", data.IsVerified || false);
                     $("#VerifiedBytext").dxTextBox("instance").option("value", data.VoucherVerifiedBy || "");
                     $("#ApprovedBy").dxCheckBox("instance").option("value", data.IsApproved || false);
                     $("#ApprovedBytext").dxTextBox("instance").option("value", data.VoucherApprovedBy || "");
                   

                   $("#txtCurrencyRate").dxNumberBox("instance").option("value", data.currencyrate || 1);

                    var ddCurrency = $("#ddCurrency").dxDropDownBox("instance");
                    ddCurrency.option("value", data.currencyid || "");

                     var verifiedDate = data.VoucherVerifiedOn ? new Date(data.VoucherVerifiedOn) : null;
                    var formattedDate = verifiedDate
                        ? verifiedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
                        : "";

                    $("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate);
                    var approvedDate = data.VoucherApprovedOn ? new Date(data.VoucherApprovedOn) : null;
                    var formattedApprovedDate = approvedDate
                        ? approvedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
