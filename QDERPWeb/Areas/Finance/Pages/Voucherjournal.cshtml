    var lastDrCr = "Dr"; // Default value for the first entry (Dr)
    let isUpdatingCell;
    function addVoucherEntry() {
        debugger;
        // Get values from the fields
        var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
            if(IsAccHead==false)
            {
                accountHead = $("#ddAccountHead").dxDropDownBox("instance").option("value");
            }
         var amount = $("#txtVoucherAmount").dxNumberBox("instance").option("value") || 0;
          amount = Math.round(amount * 100) / 100;

    // Format to always have 2 decimals
    amount = parseFloat(amount).toFixed(2);
            var currencyRate = $("#txtCurrencyRate").dxNumberBox("instance").option("value") || 1;
             currencyRate = Math.round(currencyRate * 100) / 100;

    // Format to always have 2 decimals
    currencyRate = parseFloat(currencyRate).toFixed(2);
            var voucherAmount = amount * currencyRate;
              
        var drCr = $("#sbDrCr").dxSelectBox("instance").option("value");; // Set DrCr based on the previous entry
        var entryNarration = $("#txtEntryNarration").dxTextArea("instance").option("value");

        // Reset previous error styles
        $("#ddAccountHead").css("border", "");
        $("#txtVoucherAmount").css("border", "");

        // Validation logic
        var isValid = true;

        if (!accountHead) {
            isValid = false;
            $("#ddAccountHead").css("border", "1px solid red"); // Highlight accountHead in red
            DevExpress.ui.notify("Account Head is required.", "error", 2000);
        }

        if (!voucherAmount || voucherAmount <= 0) {
            isValid = false;
            $("#txtVoucherAmount").css("border", "1px solid red"); // Highlight amount in red
            DevExpress.ui.notify("Amount should not be 0 or less.", "error", 2000);
        }

        // Stop execution if validation fails
        if (!isValid) {
            return; // Exit function if validation fails
        }

        // Prepare the object to send
        var VE = {
            "VoucherNo": voucherNo,
            "AccountHead": accountHead,
            "VoucherAmount": voucherAmount,
            "DrCr": drCr,
            "AddedBy": "102",
            "AddedOn": new Date(),
            "EntryNarration": entryNarration
        };

        // AJAX request to add voucher entry
        $.ajax({
            type: "POST",
            url: "/api/VoucherJournal/AddVoucherEntry",
            contentType: "application/json",
            data: JSON.stringify(VE),
            dataType: "json",
            success: function (response) {
                console.log(response.data);
                
                  $("#txtEntryNarration").dxTextArea("instance").option("value","");
                  var accountGrid = $("#accounthead-datagrid").dxDataGrid("instance");

                  $("#ddCurrency").dxDropDownBox("instance").option("readOnly", true);
                   $("#txtCurrencyRate").dxNumberBox("instance").option("readOnly", true);

                    // Unselect the selected row
                    accountGrid.clearSelection();  
                // Update the data grid with the new data
                $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

                // Clear Account Head and Amount fields after submission
                $("#ddAccountHead").dxDropDownBox("instance").option("value", null);
               // $("#txtVoucherAmount").dxNumberBox("instance").option("value", null);


                // Calculate total Dr and Cr amounts IsEqual clear Amount field 
                   let totalDr = 0;
                let totalCr = 0;

                response.data.forEach(entry => {
                    if (entry.DrCr === "Dr") {
                        totalDr += entry.VoucherAmount || 0;
                    } else if (entry.DrCr === "Cr") {
                        totalCr += entry.VoucherAmount || 0;
                    }
                });
                debugger;
                const voucherAmountBox = $("#txtVoucherAmount").dxNumberBox("instance");
                var Currencyrate  = currencyRate;
                       
                if (totalDr === totalCr) {
                    // Amounts are balanced, clear the box
                    voucherAmountBox.option("value", null);
                } else if (totalDr < totalCr) {
                    // Credit is more, set difference as debit
                    voucherAmountBox.option("value",  (totalCr - totalDr) / Currencyrate );
                } else {
                    // Debit is more, set difference as credit
                    voucherAmountBox.option("value", (totalDr - totalCr) / Currencyrate);
                }


                // Toggle DrCr for next entry and update the dropdown value
                lastDrCr = (lastDrCr === "Dr") ? "Cr" : "Dr"; // Toggle Dr and Cr
                $("#sbDrCr").dxSelectBox("instance").option("value", lastDrCr); // Set the dropdown value
            },
            error: function (xhr, status, error) {
                DevExpress.ui.notify("Error occurred while updating data: " + error, "error", 3000);
            }
        });
    }


