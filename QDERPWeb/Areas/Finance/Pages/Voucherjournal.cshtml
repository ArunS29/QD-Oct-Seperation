    $("#btnSaveAndClose").on("click", function (e) {
        e.preventDefault();
        

        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var gridData = dataGrid.option("dataSource");

        if (!gridData || gridData.length === 0) {
            DevExpress.ui.notify("There are no line items to save. Please add transaction details.", "error", 2000);
            return;
        }

        var totalDrAmount = 0;
        var totalCrAmount = 0;

        gridData.forEach(function (row) {
            if (row.DrCr === "Dr" && row.VoucherAmount && row.VoucherAmount > 0) {
                totalDrAmount += row.VoucherAmount;
            }
            if (row.DrCr === "Cr" && row.VoucherAmount && row.VoucherAmount > 0) {
                totalCrAmount += row.VoucherAmount;
            }
        });

        if (totalDrAmount !== totalCrAmount) {
            DevExpress.ui.notify("Voucher Entry is not tallying, please check the Debit / Credit Totals.", "error", 2000);
            return;
        }

        var voucherTextBox = $("#VoucherNo").dxTextBox("instance");
        var existingVoucherNo = voucherTextBox ? voucherTextBox.option("value") : "";

        // **Use globalVoucherNo if it exists**
        var finalVoucherNo = globalVoucherNo || "";

        var VM = {
            VoucherMaster: {
                     "basecurrencyid": $("#ddlBaseCurrency").dxDropDownBox("instance").option("value"),
                        "currencyid": $("#ddCurrency").dxDropDownBox("instance").option("value"),
                        "currencyrate": $("#txtCurrencyRate").dxNumberBox("instance").option("value"),
                    "VoucherNo": finalVoucherNo, // Pass the latest VoucherNo
                    "VoucherDate": $("#VoucherDate").dxDateBox("instance").option("value"),
                    "VoucherEffectiveDate": $("#EffectiveDate").dxDateBox("instance").option("value"),
                    "VoucherNarration": ($("#VoucherNarration").dxTextBox("instance").option("value") || "").trim(),
                    "BillRemarks": ($("#Remarks").dxTextBox("instance").option("value") || "").trim(),
                    "IsVerified": $("#VerifiedBy").dxCheckBox("instance").option("value"),
                    "IsApproved": $("#ApprovedBy").dxCheckBox("instance").option("value"),
                    "VoucherVerifiedBy": ($("#VerifiedBytext").dxTextBox("instance").option("value") || "").trim(),
                    "VoucherApprovedBy": ($("#ApprovedBytext").dxTextBox("instance").option("value") || "").trim(),
                    "VoucherVerifiedOn": ($("#VerifiedOnDate").dxTextBox("instance").option("value") || null),
                    "VoucherApprovedOn": ($("#ApprovedOntext").dxTextBox("instance").option("value") || null),
                    "VoucherType": ($("#VoucherType").dxSelectBox("instance").option("value") || "").trim(),
            },
            VoucherEntries: gridData
        };

        var button = $("#btnSaveAndClose").dxButton("instance");
        var action = finalVoucherNo ? "UpdateVoucher" : "SaveVoucher"; // Determine Save or Update

        $.ajax({
            type: "POST",
            url: `/api/VoucherJournal/${action}`,
            contentType: "application/json",
            data: JSON.stringify(VM),
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    // Update voucher number if saving a new voucher
                    if (!finalVoucherNo) {
                        globalVoucherNo = response.voucherNo;
                        if (voucherTextBox) {
                            voucherTextBox.option("value", globalVoucherNo);
                        }
                    }

                    var successMessage = action === "SaveVoucher"
                        ? "Voucher saved successfully with matching Debit and Credit amounts."
                        : "Voucher updated successfully!";
                    $("#popupMessage").text(successMessage);
                    const popupInstance = $("#successPopup").dxPopup("instance");
                    popupInstance.show();

                    setTimeout(() => {
                        popupInstance.hide();
                    }, 2000); // Auto-close after 2 seconds
                    setTimeout(function () {
                        window.history.back(); // Navigate to the previous page
                    }, 2000);
                    // Change button text to "Update" after saving
                    // if (action === "SaveVoucher") {
                    //   button.option("text", "Update");
                    // }
                } else {
                    DevExpress.ui.notify("Update failed: " + response.message, "error", 2000);
                }
            },
            error: function (xhr, status, error) {
                DevExpress.ui.notify(
                    "An error occurred while processing the voucher. Please try again.",
                    "error",
                    2000
                );
            }
        });
    });


 

