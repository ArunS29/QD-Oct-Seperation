        }
    });



    // 2) Click outside closes
    document.addEventListener("mousedown", function (e) {
        const menu = document.getElementById("contextMenu");
        if (!menu) return;
        if (isMenuOpen() && !menu.contains(e.target)) hideContextMenu();
    });

    // 3) One global keydown (capture) that only acts if menu is open
    document.addEventListener("keydown", function (e) {
        if (!isMenuOpen()) return;

        const menu = document.getElementById("contextMenu");
        const items = menu.querySelectorAll("li");
        if (!items.length) return;

        // prevent grid from swallowing keys
        e.preventDefault();
        e.stopPropagation();

        if (e.key === "ArrowDown") {
            currentIndex = (currentIndex + 1) % items.length;
            highlightItem(items[currentIndex]);
        } else if (e.key === "ArrowUp") {
            currentIndex = (currentIndex - 1 + items.length) % items.length;
            highlightItem(items[currentIndex]);
        } else if (e.key === "Enter" || e.key === " ") {
            items[currentIndex].click();
        } else if (e.key === "Escape") {
            hideContextMenu();
        }
    }, true); // <- capture mode so we intercept before DataGrid
