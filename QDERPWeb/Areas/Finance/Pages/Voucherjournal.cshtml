        });

        let dialogContainer = dialog.show(); // Show the dialog
        const style = document.createElement("style");
        style.innerHTML = `
          .dx-dialog-custom-close:hover {
            color: red;
          }
        `;
        document.head.appendChild(style);
        setTimeout(() => {
        let titleElement = document.querySelector(".dx-dialog .dx-popup-title");
        if (titleElement) {
            // Apply flex styling to title bar
            titleElement.style.display = "flex";
            titleElement.style.justifyContent = "space-between";
            titleElement.style.alignItems = "center";

            // Create the close button
            let closeButton = document.createElement("span");
            closeButton.innerHTML = "&times;";
            closeButton.classList.add("dx-dialog-custom-close");

            // Optional styling for the close button
            closeButton.style.cursor = "pointer";
            closeButton.style.fontSize = "20px";
            closeButton.style.marginLeft = "auto";
            closeButton.style.padding = "0 10px";

            titleElement.appendChild(closeButton);

            closeButton.addEventListener("click", () => {
                let dialogElement = document.querySelector(".dx-dialog");
                if (dialogElement) {
                    dialogElement.remove();
                }
            });
        }

        let dialogPopup = document.querySelector(".dx-dialog");
        if (dialogPopup) {
            dialogPopup.classList.remove("dx-draggable");
        }
    }, 0);

