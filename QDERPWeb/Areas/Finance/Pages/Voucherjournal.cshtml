    // Attach the function to the button click event
    $("#btnSave").on("click", function (e) {
        e.preventDefault();
        saveVoucher();
    });

    function saveVoucher() {
        debugger;
        
        var button = $("#btnSave").dxButton("instance");
        var finalVoucherNo = globalVoucherNo || argsledno || "";

        //alert(argsledno)

        // If argsledno is present, force "UpdateVoucher" action, else determine based on finalVoucherNo
        var action = finalVoucherNo ? "UpdateVoucher" : "SaveVoucher";


        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var gridData = dataGrid.option("dataSource");

        if (!gridData || gridData.length === 0) {
            DevExpress.ui.notify("There are no line items to save. Please add transaction details.", "error", 2000);
            return;
        }

        var totalDrAmount = 0;
        var totalCrAmount = 0;

        gridData.forEach(function (row) {
            if (row.DrCr === "Dr" && row.VoucherAmount && row.VoucherAmount > 0) {
                totalDrAmount += row.VoucherAmount;
            }
            if (row.DrCr === "Cr" && row.VoucherAmount && row.VoucherAmount > 0) {
                totalCrAmount += row.VoucherAmount;

            }
        });
        // keep them as numbers with 2 decimals
        totalDrAmount = Math.round(totalDrAmount * 100) / 100;
        totalCrAmount = Math.round(totalCrAmount * 100) / 100;

        if (totalDrAmount !== totalCrAmount) {
            DevExpress.ui.notify("Voucher Entry is not tallying, please check the Debit / Credit Totals.", "error", 2000);
            return;
        }

        var voucherTextBox = $("#VoucherNo").dxTextBox("instance");
        var existingVoucherNo = voucherTextBox ? voucherTextBox.option("value") : "";

        // **Use globalVoucherNo if it exists**
        //var finalVoucherNo =  globalVoucherNo || "";

        var VM = {
            VoucherMaster: {
                    "basecurrencyid": $("#ddlBaseCurrency").dxDropDownBox("instance").option("value"),
                        "currencyid": $("#ddCurrency").dxDropDownBox("instance").option("value"),
                        "currencyrate": $("#txtCurrencyRate").dxNumberBox("instance").option("value"),
                   "VoucherNo" : finalVoucherNo, // Pass the latest VoucherNo
                "VoucherDate": $("#VoucherDate").dxDateBox("instance").option("value"),
                "VoucherEffectiveDate": $("#EffectiveDate").dxDateBox("instance").option("value"),
                "VoucherNarration": ($("#VoucherNarration").dxTextBox("instance").option("value") || "").trim(),
                "BillRemarks": ($("#Remarks").dxTextBox("instance").option("value") || "").trim(),
                
                "VoucherType": ($("#VoucherType").dxSelectBox("instance").option("value") || "").trim(),
            },
            VoucherEntries: gridData
        };

        var button = $("#btnSave").dxButton("instance");
        var action = finalVoucherNo ? "UpdateVoucher" : "SaveVoucher"; // Determine Save or Update

        $.ajax({
            type: "POST",
            url: `/api/VoucherJournal/${action}`,
