    function showLedgerAccountPopup() {
        var popup = $("#ledgerAccountPopup").dxPopup("instance");
        popup.show();

        // Correct URL to your LedgerAccount view
        $("#ledgerAccountFrame").attr("src", `/${tenantName}/Finance/LedgerAccount`);
    }
    function showLedgerAccountEditPopup() {
        var dropDownBox = $("#ddAccountHead").dxDropDownBox("instance"); // Get DropDownBox instance
        var accheadid = dropDownBox.option("value"); // Get the selected value

        IsEdit = true;

        // Ensure variables are initialized properly
        refno = refno || "";
        accheadar = accheadar || "";
        accheadname = accheadname || "";
        accgroup = accgroup || "";
        accgroupid = accgroupid || "";

        // Validate AccountHead selection
        if (!accheadid) {
            DevExpress.ui.notify("Please select an Account Head before editing.", "error", 2000);
            return;
        }

        // Construct the URL only if AccountHeadID is valid
        const url = `/${tenantName}/Finance/LedgerAccount?AccountHeadID=${encodeURIComponent(accheadid)}&ReferenceNo=${encodeURIComponent(refno)}&AccountHeadName=${encodeURIComponent(accheadname)}&AccountGroup=${encodeURIComponent(accgroup)}&IsEdit=${IsEdit}&AccountGroupID=${encodeURIComponent(accgroupid)}&AccountHeadAr=${encodeURIComponent(accheadar)}`;

        // Show the popup
        var popupInstance = $("#ledgerEditAccountPopup").dxPopup("instance");
        popupInstance.show();

        // Use DevExtreme popup's `onShown` event to wait for rendering before setting iframe src
        popupInstance.option("onShown", function () {
            var iframe = document.getElementById("ledgerEditAccountFrame");

            if (!iframe) {
                console.error("Error: ledgerEditAccountFrame not found!");
                return;
            }

            // Clear iframe src to prevent caching issues
            iframe.src = "";

            // Set new iframe src
            iframe.onload = function () {
                console.log("Iframe loaded successfully.");
            };

            iframe.src = url;
        });
    }


</script>
