                function addCostAllocation() {
                    $("#costAllocationPopup").dxPopup("instance").show();
                }
                function saveCostAllocation() {
                    $("#costAllocationPopup").dxPopup("instance").close();
                }
                function dropDownBoxOnInput(e) {
                    const ddbInstance = e.component;
                    if (!ddbInstance.option("opened")) ddbInstance.open();


                    const text = ddbInstance.option("text");
                    if (dataGrid) {
                        dataGrid.option("searchPanel.text", text);
                    }
                }

                function onOpened(e) {
                    setTimeout(() => {
                        e.component.focus();
                    });
                }

                function onKeyDown(e) {
                    const ddbInstance = e.component;
                    if (e.event.keyCode !== 40) return;
                    if (!ddbInstance.option("opened")) {
                        ddbInstance.open();
                    } else {
                        let focusedIndex = dataGrid.option("focusedRowIndex");
                        let visibleRows = dataGrid.getVisibleRows().length - 1;
                        if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                        dataGrid.focus(dataGrid.getRowElement(focusedIndex));
                    }
                }

                function dataGridSelectionChanged(e) {
                    const selectedKey = e.selectedRowKeys[0];
                    const ddbInstance = $("#SupplierNameDropDown").dxDropDownBox("instance");

                    if (selectedKey) {
                        ddbInstance.option("value", selectedKey);
                        if (ddbInstance.option("opened")) {
                            ddbInstance.close();
                        }
                    }

                }

                function dataGridInitialized(e) {
                    dataGrid = e.component;
                }
                function dataGridAccountHeadInitialized(e) {
                    dataGrid = e.component;
                }
                function onRowRemoved(e) {
                    Swal.fire({
                        title: "Are you sure?",
                        text: "You are about to delete the Voucher Entry from the database. You cannot revert the changes.",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#d33",
                        cancelButtonColor: "#3085d6",
                        confirmButtonText: "Yes, delete it!",
                        cancelButtonText: "Cancel"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: "/api/VoucherJournal/Delete",
                                type: 'GET',
                                data: { VoucherEntryNo: e.data.VoucherEntryNo },
                                success: function (response) {
                                    if (response.success) {
                                        Swal.fire("Deleted!", "Line Entry has been successfully removed from the database.", "success");
                                    } else {
                                        Swal.fire("Error!", "Failed to delete the item. " + response.message, "error");
                                    }
                                },
                                error: function () {
                                    Swal.fire("Error!", "An error occurred while deleting the item.", "error");
                                }
                            });
                        }
                    });
                }



                // Function to display a toast notification
                function showToast(message, type) {
                    // Create a new DevExtreme toast notification
                    $("#toast").dxToast({
                        message: message,
                        type: type,  // "success" or "error"
                        displayTime: 3000,  // Duration of the toast in milliseconds
                        closeOnClick: true  // Close the toast on click
                    }).dxToast("show");
                }


                function updateTemporaryNo(e) {
                    const voucherNo = e.value;
                    const temporaryNo = $("#TemporaryNo").dxTextBox("instance");
                    temporaryNo.option("value", voucherNo);
                }


                $(document).ready(function () {
                    $.ajax({
                        url: '@Url.Action("GetNewVoucherNo", "VoucherJournal")',
                        type: 'GET',
                        success: function (data) {
                            const voucherNoField = $("#VoucherNo").dxTextBox("instance");
                            voucherNoField.option("value", data);
                            updateTemporaryNo({ value: data });
                        },
                        error: function () {
                            alert("Error generating voucher number.");
                        }
                    });
                });
                $(function () {
                    const dataGrid = $("#dataGrid").dxDataGrid("instance");
                    const totalDebitTextbox = $("#totalDebitTextbox").dxTextBox("instance");
                    const totalCreditTextbox = $("#totalCreditTextbox").dxTextBox("instance");

                    function calculateTotals() {
                        const data = dataGrid.getVisibleRows().map(row => row.data);
                        const totalDebit = data.reduce((sum, row) => sum + (row.DrAmount || 0), 0);
                        const totalCredit = data.reduce((sum, row) => sum + (row.CrAmount || 0), 0);

                        // Update TextBox values dynamically
                        totalDebitTextbox.option("value", totalDebit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                        totalCreditTextbox.option("value", totalCredit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                    }

                    // Recalculate totals on content changes
                    dataGrid.on("contentReady", calculateTotals);
                    dataGrid.on("dataSourceChanged", calculateTotals);
                });
                function onVerifyButtonClick() {
                    const dataGrid = $("#dataGrid").dxDataGrid("instance");
                    const rowCount = dataGrid.getVisibleRows().length;

                    // Check if dataGrid exists and contains rows
                    if (rowCount == 0) {
                        Swal.fire({
                            title: "Voucher is not Verified",
                            text: "Voucher has not been Approved, Click Yes if you want to Verify and Approve this Voucher.",
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonText: "Yes",
                            cancelButtonText: "No"
                        })
                    } else {
                        proceedWithVerification(); // If data exists, proceed with verification
                    }
                }

                function proceedWithVerification() {
                    // Set VerifiedBy checkbox to true
                    $("#VerifiedBy").dxCheckBox("instance").option("value", true);
                    const vno = $("#VoucherNo").dxTextBox("instance").option("value");

                    // Prepare data for verification
                    const currentDate = new Date();
                    const formattedDate = currentDate.toLocaleDateString("en-GB", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    }).replace(/ /g, '-');

                    const data = {
                        voucherNo: vno,
                        verifiedBy: "Admin",
                        verifiedOn: new Date().toISOString()
                    };

                    $.ajax({
                        data: JSON.stringify(data),
                        success: function (response) {
                            Swal.fire({
                                title: "Success!",
                                text: `Voucher has been Verified.`,
                                icon: "success",
                                confirmButtonText: "OK"
                            }).then(() => {
                                $("#VerifiedBytext").dxTextBox("instance").option("value", "Admin");
                                $("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate);
                            });
                        },
                        error: function () {
                            Swal.fire({
                                title: "Error",
                                text: "Please save the transactions after proceeding!!",
                                icon: "error",
                                confirmButtonText: "OK"
                            });
                        }
                    });
                }


                function disableEditing() {
                    // Disable all input fields and buttons except for specific ones
                    $('input, select, textarea').prop('disabled', true);

                    $('.dx-button').each(function () {
                        const allowedButtons = ['btnBack', 'btnPreview', 'btnPrint', 'btnAttach'];
                        if (!allowedButtons.includes($(this).attr('id'))) {
                            $(this).dxButton('option', 'disabled', true);
                        }
                    });
                }

                function onApproveButtonClick() {
                    const dataGrid = $("#dataGrid").dxDataGrid("instance");
                    const rowCount = dataGrid.getVisibleRows().length;

                    if (rowCount == 0) {
                        Swal.fire({
                            title: "Voucher is not Approved",
                            text: "Voucher has not been Approved, Click Yes if you want to Verify and Approve this Voucher.",
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonText: "Yes",
                            cancelButtonText: "No"
                        })
                    } else {
                        proceedWithApproval();
                    }
                }

                function proceedWithApproval() {
                    $("#ApprovedBy").dxCheckBox("instance").option("value", true);
                    var vno = $("#VoucherNo").dxTextBox("instance").option("value");

                    const currentDate = new Date();
                    const formattedDate = currentDate.toLocaleDateString("en-GB", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    }).replace(/ /g, '-');

                    $.ajax({
                        success: function () {
                            Swal.fire({
                                title: "Success!",
                                text: "Voucher has been Approved.",
                                icon: "success",
                                confirmButtonText: "OK"
                            }).then(() => {
                                disableEditing();
                                $("#ApprovedBytext").dxTextBox("instance").option("value", "Admin");
                                $("#ApprovedOntext").dxTextBox("instance").option("value", formattedDate);
                            });
                        },
                        error: function () {
                            Swal.fire({
                                title: "Error",
                                text: "Please save the transactions after proceeding!",
                                icon: "error",
                                confirmButtonText: "OK"
                            });
                        }
                    });
                }


                // You can also add logic here to trigger an alert when the save button is clicked
                function onSaveButtonClick() {
                    var dataGrid = $("#dataGrid").dxDataGrid("instance");
                    var data = dataGrid.option("dataSource");

                    // Check if there is only one row
                    if (data.length === 1) {
                        // Show an alert for only one entry
                        DevExpress.ui.notify("Voucher Entry is not talling please check the Debit/ Credit Totals.", "info", 3000);
                    }
                }
                function onEditorPreparing(e) {
                    // Check if the data field being edited is 'EntryNarration'
                    if (e.dataField === 'EntryNarration') {
                        if (isUpdatingCell) {
                            return; // Prevent recursive triggering
                        }

                        e.cancel = true; // Prevent the default editor behavior

                        const dataGridInstance = e.component; // Get the DataGrid instance
                        const rowIndex = e.row.rowIndex; // Get the row index of the clicked cell
                        const initialValue = e.row.data[e.dataField] || ""; // Get the current value of the cell

                        // Show Swal modal for editing EntryNarration
                        Swal.fire({
                            title: `<i class="fas fa-edit" style="color:#007bff"></i> Edit Entry Narration`,
                            html: `
                                                                    <textarea id="swal-field-editor"
                                                                              style="width:100%; height:100px; font-size:16px; padding:10px; border-radius:8px; border:1px solid #ddd;"
                                                                              placeholder="Enter Entry Narration...">${initialValue}</textarea>
                                                                `,
                            showCancelButton: true,
                            confirmButtonText: 'OK',
                            cancelButtonText: 'Cancel',
                            focusConfirm: false,
                            didOpen: () => {
                                // Focus the textarea and move the cursor to the end
                                const textarea = document.getElementById('swal-field-editor');
                                textarea.focus();
                                textarea.setSelectionRange(initialValue.length, initialValue.length);
                            },
                            preConfirm: () => {
                                const newValue = document.getElementById('swal-field-editor').value.trim();
                                return newValue; // Return the new value from the modal
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                const newValue = result.value;

                                // Only update the cell if the new value is different
                                if (newValue !== initialValue) {
                                    isUpdatingCell = true; // Set the flag before updating the cell
                                    dataGridInstance.cellValue(rowIndex, e.dataField, newValue); // Update the specific cell dynamically
                                    dataGridInstance.saveEditData(); // Save the edit data
                                    dataGridInstance.refresh(); // Refresh the grid to reflect changes
                                    isUpdatingCell = false; // Reset the flag after updating
                                }
                            } else if (result.isDismissed) {
                                console.log('Edit cancelled');
                            }
                        });
                    }
                }
                function showLedgerAccountPopup() {
                    var popup = $("#ledgerAccountPopup").dxPopup("instance");
                    popup.show();

                    // Correct URL to your LedgerAccount view
                    $("#ledgerAccountFrame").attr("src", "/Finance/LedgerAccount");
                }
            </script>
