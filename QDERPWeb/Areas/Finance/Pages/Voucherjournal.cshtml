        window.editSalaryPayable = function () {
            let rowIndex = document.getElementById("contextMenu").dataset.rowIndex;
            let dataGrid = $("#dataGrid").dxDataGrid("instance");

            if (!rowIndex || rowIndex < 0) {
                console.error("Invalid row index detected.");
                return;
            }

            let visibleRows = dataGrid.getVisibleRows(); // Get all visible rows
            let rowData = visibleRows[rowIndex]?.data; // Fetch the correct row's data

