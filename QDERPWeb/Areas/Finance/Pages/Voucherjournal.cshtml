    function onContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") {
            // Row is right-clicked
            selectedRowData = e.row.data;
            //  alert(selectedRowData.SubLedgerId);
            e.items = [
                {
                    text: "Delete Line Entry",
                    onItemClick: function () {

                        if (confirm(`You are about to delete the Bills Payable Records from the database. You cannot revert the changes. Are you sure you want to delete?`)) {

                            // Call server-side delete method
                            $.post(`/Finance/api/BillsPayableReceivable/DeleteRecord?id=${selectedRowData.SubLedgerId}`, function (response) {

                                if (response.success) {
                                    alert("Bills Payable Records have been successfully removed from the database");

                                    // Remove the selected row from the DataGrid
                                    if (dataGridInstance2) {
                                        // Remove the row directly from the grid data source
                                        let dataSource = dataGridInstance2.option('dataSource');  // Get the current data source

                                        // Filter out the deleted record based on SubLedgerId
                                        let updatedDataSource = dataSource.filter(function (item) {
                                            return item.SubLedgerId !== selectedRowData.SubLedgerId;  // Remove the row by matching SubLedgerId
                                        });

                                        // Update the grid's data source to the new filtered data (which no longer includes the deleted row)
                                        dataGridInstance2.option('dataSource', updatedDataSource);
                                    }

                                } else {
                                    alert(`Error: ${response.message}`);
                                }
                            }).fail(function () {
                                alert("An error occurred while processing your request.");
                            });
                        }
                    }
                }
            ];
        }
    }
    document.addEventListener("DOMContentLoaded", function () {
        const grid = document.getElementById("dataGrid");
        const contextMenu = document.getElementById("contextMenu");
        const contentContainer = document.getElementById("contentContainer"); // Div to load pages

        grid.addEventListener("contextmenu", function (e) {
            e.preventDefault();

            // Find the closest row element
            const rowElement = e.target.closest(".dx-data-row");

            if (rowElement) {
                let rowIndex = parseInt(rowElement.getAttribute("aria-rowindex"), 10) - 1;
                contextMenu.dataset.rowIndex = rowIndex;

                let mouseX = e.clientX;
                let mouseY = e.clientY;
                const windowWidth = window.innerWidth;
                const windowHeight = window.innerHeight;
                const menuWidth = contextMenu.offsetWidth;
                const menuHeight = contextMenu.offsetHeight;

                // Prevent overflow
                if (mouseX + menuWidth > windowWidth) {
                    mouseX -= menuWidth;
                }
                if (mouseY + menuHeight > windowHeight) {
                    mouseY -= menuHeight;
                }

                contextMenu.style.display = "block";
                contextMenu.style.left = `${mouseX}px`;
                contextMenu.style.top = `${mouseY}px`;
            }
        });

        // Hide context menu when clicking elsewhere
        document.addEventListener("click", function () {
            contextMenu.style.display = "none";
        });



