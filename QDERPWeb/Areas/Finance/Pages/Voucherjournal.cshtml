                $("#btnSave").on("click", function (e) {
                    e.preventDefault();

                    var dataGrid = $("#dataGrid").dxDataGrid("instance"); // Get the DataGrid instance
                    var gridData = dataGrid.option("dataSource"); // Get the current data in the DataGrid

                    // Check if gridData is null or undefined
                    if (!gridData || gridData.length === 0) {
                        DevExpress.ui.notify("There are no line items to save. Please add transaction details.", "error", 2000);
                        return; // Stop further processing if no data in the grid
                    }

                    var totalDrAmount = 0; // Variable to store total Debit amount
                    var totalCrAmount = 0; // Variable to store total Credit amount

                    // Sum the total Debit and Credit amounts
                    gridData.forEach(function (row) {
                        if (row.DrAmount && row.DrAmount > 0) {
                            totalDrAmount += row.DrAmount; // Add to total Debit amount
                        }
                        if (row.CrAmount && row.CrAmount > 0) {
                            totalCrAmount += row.CrAmount; // Add to total Credit amount
                        }
                    });

                    // Check if both Debit and Credit amounts are equal
                    if (totalDrAmount !== totalCrAmount) {
                        DevExpress.ui.notify("Voucher Entry is not tallying, please check the Debit / Credit Totals.", "error", 2000);
                        return; // Stop further processing if amounts don't match
                    }

                    // Prepare the data object to send
                    var VM = {
                        "VoucherNo": $("#VoucherNo").dxTextBox("instance").option("value"),
                        "VoucherDate": $("#VoucherDate").dxDateBox("instance").option("value"),
                        "VoucherEffectiveDate": $("#EffectiveDate").dxDateBox("instance").option("value"),
                        "VoucherNarration": $("#VoucherNarration").dxTextBox("instance").option("value") || null,
                        "Remarks": $("#Remarks").dxTextBox("instance").option("value") || null,
                        "IsVerified": $("#VerifiedBy").dxCheckBox("instance").option("value"),
                        "IsApproved": $("#ApprovedBy").dxCheckBox("instance").option("value"),
                        "VoucherVerifiedOn": new Date(),
                        "VoucherApprovedOn": new Date()
                    };

                    // Check the button text to determine save or update action
                    var button = $("#btnSave").dxButton("instance");
                    var action = button.option("text") === "Save" ? "SaveVoucher" : "UpdateVoucher";

                    // Perform AJAX request to save/update the voucher data
                    $.ajax({
                        type: "POST",
                        url: `/api/VoucherJournal/${action}`,
                        contentType: "application/json",
                        data: JSON.stringify(VM),
                        dataType: "json",
                        success: function (response) {
                            if (response.success) {
                                // Show appropriate success message based on the action
                                var successMessage =
                                    action === "SaveVoucher"
                                        ? "Voucher saved successfully with matching Debit and Credit amounts."
                                        : "Voucher updated successfully!";
                                DevExpress.ui.notify(successMessage, "success", 2000);

                                // Change button label to "Update" after saving
                                if (action === "SaveVoucher") {
                                    button.option("text", "Update");
                                }
                            } else {
                                DevExpress.ui.notify("Update failed: " + response.message, "error", 2000);
                            }
                        },
                        error: function (xhr, status, error) {
                            DevExpress.ui.notify(
                                "An error occurred while processing the voucher. Please try again.",
                                "error",
                                2000
                            );
                        }
                    });
                });


