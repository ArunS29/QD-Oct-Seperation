    <script>
        $(function () {
			$("#DepreciationMaster").dxTextBox({
					text:formatMessage("Depreciation Master"),
                    readOnly: true,
					onContentReady: function(e) {
		            $(e.element).addClass("dx-textbox-heading");
            }
       });
    });
        
        function ddBtnShowRecords_click(filterType) {
            const dataGrid = $("#DepreciationdataGrid").dxDataGrid("instance");

            const today = new Date();
            let startDate = null, endDate = null;


            switch (filterType) {
                case 'today':
                    startDate = new Date(today.setHours(0, 0, 0, 0));
                    endDate = new Date(today.setHours(23, 59, 59, 999));
                    break;

                case 'yesterday':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - 1);
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'week':
                    startDate = new Date(today);
                    startDate.setDate(today.getDate() - today.getDay());
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setDate(startDate.getDate() + 6);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'tillmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'tillyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'fullyear':
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today.getFullYear(), 11, 31);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'lastmonth':
                    startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                case 'lastyear':
                    startDate = new Date(today.getFullYear() - 1, 0, 1);
                    endDate = new Date(today.getFullYear() - 1, 11, 31);
                    endDate.setHours(23, 59, 59, 999);
                    break;

                default:

                    dataGrid.option("dataSource", {
                        load: function () {
                            return $.ajax({
                                url: "/api/DepreciationMaster/GetExpensesClaims",
                                type: "GET"
                            });
                        }
                    });
                    dataGrid.refresh();
                    return;
            }

            if (startDate && endDate) {

                $("#VoucherDate").dxDateBox("instance").option("value", startDate);
                $("#EffectiveDate").dxDateBox("instance").option("value", endDate);


                dataGrid.option("dataSource", {
                    load: function () {
                        return $.ajax({
                            url: "/api/DepreciationMaster/GetExpensesClaims",
                            data: {
                                startDate: startDate.toISOString(),
                                endDate: endDate.toISOString()
                            },
                            type: "GET"
                        });
                    }
                });


                dataGrid.refresh();
            }
        }

    function highlightRow(checkbox) {
        var row = $(checkbox).closest('.dx-data-row');
        if (checkbox.checked) {
            row.css("background-color", 'rgb(192, 255, 192)');
        } else {
            row.css("background-color", "");
        }
    }

        function onDepreciationRowPrepared(e) {
            if (e.rowType === "data" && e.data.IsPosted === true) {
                e.rowElement.css("background-color", "rgb(192, 255, 192)");
            }
        }

    // Remove previous click event handlers to avoid duplicates
    $(document).off("click", ".dx-data-row").on("click", ".dx-data-row", function (e) {
        $("#voucherPopup").dxPopup("instance").show();
    });

    // Remove previous document click event and reattach
    $(document).off("click").on("click", function (e) {
        if (
            !$(e.target).closest("#voucherPopup").length &&
            !$(e.target).closest(".dx-data-row").length
        ) {
            $("#voucherPopup").dxPopup("instance").hide();
        }
    });
      function onDepreciationContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") {
            e.items = [
                {
                    text: "Edit Depreciation",
                    icon: "edit", // DevExtreme built-in icon
                    onItemClick: () => {
                        debugger;
                        editDepreciation(e.row.data);
                    },
                    cssClass: "context-menu-edit"
                },
                {
                    text: "Delete Depreciation",
                    icon: "trash", // DevExtreme built-in icon
                    onItemClick: () => {
                        deleteDepreciation(e.row.data);
                    },
                    cssClass: "context-menu-delete"
                }
            ];
        }
      }
     function editDepreciation(rowData) {
      
        const depreciationDocNo = rowData.DepreciationDocNo;

        if (!depreciationDocNo) {
            DevExpress.ui.notify("DepreciationDocNo not found.", "error", 3000);
            return;
        }

        const targetUrl = `/${tenantName}/Finance/CreateDepreciation?DepreciationDocNo=${encodeURIComponent(depreciationDocNo)}`;

        // Optionally open in new tab:
        // window.open(targetUrl, '_blank');

        // Or redirect in same tab:
        window.location.href = targetUrl;
     }

    </script>
