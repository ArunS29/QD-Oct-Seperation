                band.Add().DataField("AssetTotalDebitTrans").Caption(new JS("formatMessage('Debit Transactions')")).DataType(GridColumnDataType.Number).Format("#,##0.00");
                band.Add().DataField("AssetTotalCreditTrans").Caption(new JS("formatMessage('Credit Transactions')")).DataType(GridColumnDataType.Number).Format("#,##0.00");
                band.Add().DataField("AssetClosingBalance").Caption(new JS("formatMessage('Closing Balance')")).DataType(GridColumnDataType.Number).Format("#,##0.00");
                band.Add().DataField("AccumulatedOpeningBalance").Caption(new JS("formatMessage('Accumulated Opening Balance')")).DataType(GridColumnDataType.Number).Format("#,##0.00");
                band.Add().DataField("TotalDepreciationAmount").Caption(new JS("formatMessage('Total Depreciation Amount')")).DataType(GridColumnDataType.Number).Format("#,##0.00");
                band.Add().DataField("AccumulatedTotalBalance").Caption(new JS("formatMessage('Accumulated Closing Balance')")).DataType(GridColumnDataType.Number).Format("#,##0.00");
