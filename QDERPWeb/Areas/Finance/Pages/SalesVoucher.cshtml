				const menuWidth = contextMenu.offsetWidth;
				const menuHeight = contextMenu.offsetHeight;


				// Always position at the bottom
				let menuX = mouseX;
				let menuY = windowHeight - menuHeight - 10; // 10px padding from bottom

				// Prevent overflow on the right
				if (menuX + menuWidth > windowWidth) {
					menuX = windowWidth - menuWidth - 10; // Adjust to fit
