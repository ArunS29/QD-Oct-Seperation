		function onRowRemoving() {
			var dataGrid = $("#dataGrid").dxDataGrid("instance"); // Get the DataGrid instance


			// Get the selected row's data
			var selectedRows = dataGrid.getSelectedRowsData(); // Array of selected rows
			var selectedRowData = selectedRows.length > 0 ? selectedRows[0] : null;

			if (!selectedRowData) {
				DevExpress.ui.notify("No row selected. Please select a row first.", "error", 2000);
				return;
			}


			// Retrieve the unique identifier for the row
			var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
			var voucherEntryNo = selectedRowData.VoucherEntryNo;

			// Validate VoucherEntryNo
			if (!voucherEntryNo) {
				DevExpress.ui.notify("Invalid entry number. Cannot delete.", "error", 2000);
				return;
			}

			// Send an AJAX request to the API to delete the record
			$.ajax({
				url: `/api/VoucherMaster/DeleteVoucherEntry?voucherEntryNo=${encodeURIComponent(voucherEntryNo)}&VoucherNo=${encodeURIComponent(voucherNo)}`, // API URL with the identifier
				type: "POST", // HTTP POST request
				success: function (response) {
					if (response.data) {
						// Update the DataGrid's data source with the updated data
						$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

						DevExpress.ui.notify("Record deleted successfully!", "success", 2000);
					} else {
						DevExpress.ui.notify("No updated data returned from the server.", "error", 2000);
					}
				},
				error: function (xhr, status, error) {
					DevExpress.ui.notify("Error deleting record: " + error, "error", 2000);
				}
			});
		}

		$("#btnSaveAndClose").on("click", function (e) {
			e.preventDefault();

			// Perform validation for required fields
			var isValid = true;
			var requiredFields = [
				{ id: "#VoucherNo", type: "dxTextBox" },
				{ id: "#VoucherDate", type: "dxDateBox" },
				{ id: "#VoucherEffectiveDate", type: "dxDateBox" },
				{ id: "#VoucherType", type: "dxSelectBox" }
				// Removed validation for VoucharNarration, BillRemarks, and VoucherRefNo
			];

			requiredFields.forEach(function (field) {
				var instance = $(field.id)[field.type]("instance");
				var value = instance.option("value");

				if (!value) {
					isValid = false;

					// Highlight the field with an error (optional)
					instance.option("validationError", { message: "This field is required." });
					instance.option("isValid", false);
				} else {
					instance.option("isValid", true); // Clear any existing errors
				}
			});

			if (!isValid) {
				DevExpress.ui.notify("Cannot continue saving with errors, please clear the errors and continue.", "error", 3000);
				return; // Exit the function without saving
			}

			var dataGrid = $("#dataGrid").dxDataGrid("instance"); // Get the DataGrid instance
			var rowCount = dataGrid.getVisibleRows().length; // Get the number of rows in the grid

			if (rowCount !== 0) {
				var VM = {
					"VoucherNo": $("#VoucherNo").dxTextBox("instance").option("value"),
					"VoucherDate": $("#VoucherDate").dxDateBox("instance").option("value"),
					"VoucherEffectiveDate": $("#VoucherEffectiveDate").dxDateBox("instance").option("value"),
					"InvoiceSubmittedDate": $("#InvoiceSubmittedDate").dxDateBox("instance").option("value"),
					"InvoiceDueDate": $("#InvoiceDueDate").dxDateBox("instance").option("value"),
					"InvoiceNoOfDays": $("#InvoiceNoOfDays").dxNumberBox("instance").option("value"),
					"VoucherRefNo": $("#VoucherRefNo").dxTextBox("instance").option("value"),
					"VoucharNarration": $("#VoucharNarration").dxTextBox("instance").option("value"),
					"VoucherType": $("#VoucherType").dxSelectBox("instance").option("value"),
					"BillRemarks": $("#BillRemarks").dxTextBox("instance").option("value"),
					"UseSubmittedDate": $("#UseSubmittedDate").dxCheckBox("instance").option("value"),
					"IsVerified": $("#VerifiedBy").dxCheckBox("instance").option("value"),
					"IsApproved": $("#ApprovedBy").dxCheckBox("instance").option("value"),
					"VoucherVerifiedOn": new Date(),
					"VoucherApprovedOn": new Date()
				};

				$.ajax({
					type: "POST",
					url: "/api/PurchaseVoucher/SaveVoucher",
					contentType: "application/json",
					data: JSON.stringify(VM),
					dataType: "json",
					success: function (response) {
						if (response.success) {
							DevExpress.ui.notify("Voucher details saved successfully!", "success", 2000);
							var button = $("#btnSave").dxButton("instance");
							button.option("text", "Update");
							window.location.reload();
						} else {
							DevExpress.ui.notify("Voucher has no line items to be saved, please enter transaction to save!", "error", 2000);
						}
					},
					error: function (xhr, status, error) {
						DevExpress.ui.notify("Voucher has no line items to be saved, please enter transaction to save!", "error", 2000);
					}
				});
			} else {
				DevExpress.ui.notify("Voucher has no line items to be saved, please enter transaction to save!", "error", 2000);
			}
		});

