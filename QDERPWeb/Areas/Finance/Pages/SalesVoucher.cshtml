										.ValueChangeEvent("input")
										.HoverStateEnabled(true)
										.ValueExpr("AccountId")
										.DisplayExpr("AccountHead")
										.OnInput("dropDownBoxOnInput")
										.OnOpened("onOpened")
										.TabIndex(9)
										.DropDownOptions(o => o
										.Width(1000)
										)
										.OnKeyDown("onKeyDown")
																//.OnValueChanged("dropDownBoxValueChanged")
										.ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
										                                                         .Buttons(buttons => {
        // Built-in clear button
        buttons.Add()
            .Name("clear");

     buttons.Add()
    .Name("addLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("plus")
        .ElementAttr(new { @class = "custom-hover-button add-hover" })
        .OnClick("showLedgerAccountPopup"));

buttons.Add()
    .Name("editLedger")
    .Location(TextEditorButtonLocation.After)
    .Widget(w => w.Button()
        .Type(ButtonType.Default)
        .Icon("edit")
        .ElementAttr(new { @class = "custom-hover-button edit-hover" })
