			showCancelButton: true,
			confirmButtonText: "Single File",
			cancelButtonText: "Multiple Files",
			reverseButtons: true
		}).then((result) => {
			if (result.isConfirmed) {
				handleFileSelection(false); // Single file selection
			} else if (result.dismiss === Swal.DismissReason.cancel) {
				handleFileSelection(true); // Multiple file selection
			}
		});
	}

