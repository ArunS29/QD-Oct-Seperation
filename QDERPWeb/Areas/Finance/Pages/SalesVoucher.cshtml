	function openAttachmentOptions() {
		// Show an options dialog using SweetAlert for Single/Multiple selection
		Swal.fire({
			title: "Select Attachment Option",
			html: "<p>How would you like to attach files?</p>",
			showCancelButton: true,
			confirmButtonText: "Single File",
			cancelButtonText: "Multiple Files",
			reverseButtons: true
		}).then((result) => {
			if (result.isConfirmed) {
				handleFileSelection(false); // Single file selection
			} else if (result.dismiss === Swal.DismissReason.cancel) {
				handleFileSelection(true); // Multiple file selection
			}
		});
	}

