<div class="content-container-top">
	<div class="dx-card-container">
		<div class="dx-card-header minimal-header">
			<div class="card-title-icon">
				<i class="fas fa-file-invoice-dollar"></i>
			</div>
			<h3 class="card-title-text">Sales Voucher</h3>
		</div>
	</div>

<div class="dx-card-body">
	<div class="form-container" style="display: flex; flex-wrap: wrap; align-items: flex-end; position: relative; padding: 0 15px; overflow-x: hidden;">
		<!-- Top Row -->
		<div class="row w-100 align-items-center" >
    <!-- Sales Invoice No -->
    <div class="form-group col-md-2 col-sm-6">
        @(Html.DevExtreme().TextBox()
            .Label(new JS("formatMessage('Sales Invoice No')"))
            .LabelMode(EditorLabelMode.Floating)
            .ID("VoucherNo")
            .Value("")
			.TabIndex(0)
            .OnValueChanged("onVoucherNoChanged")
            .ElementAttr(new { @class = "custom-disabled-textbox" })
            .ValidationRules(rules =>
            {
                rules.AddRequired().Message(new JS("formatMessage('Sales Invoice No is required')"));
            })
        )
    </div>
	 <div class="form-group col-md-1 col-sm-6">
				@(
								Html.DevExtreme().SelectBox()
								.Label(new JS("formatMessage('Dr/Cr')"))
								.LabelMode(EditorLabelMode.Floating)
								.ID("sbDrCr")
								.DataSource(new[] { "Dr", "Cr" })
								.Value("Cr")
								.TabIndex(8)
								.OnValueChanged("onVoucherDrCrValueChanged")
								.Placeholder(new JS("formatMessage('Select Transaction Type')"))
								)

			</div>
    <!-- Invoice Date -->
    <div class="form-group col-md-2 col-sm-6">
        @(Html.DevExtreme().DateBox()
            .Label(new JS("formatMessage('Invoice Date')"))
            .ID("VoucherDate")
            .InputAttr("aria-label", "Date")
            .LabelMode(EditorLabelMode.Floating)
            .Type(DateBoxType.Date)
            .DisplayFormat("dd-MMM-yyyy")
			.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })
            .Value(DateTime.Now)
						.TabIndex(1)

            .OnValueChanged("onVoucherDateChange")
        )
    </div>

    <!-- Effective Date -->
    <div class="form-group col-md-2 col-sm-6">
        @(Html.DevExtreme().DateBox()
            .Label(new JS("formatMessage('Effective Date')"))
            .ID("VoucherEffectiveDate")
            .InputAttr("aria-label", "Date")
            .LabelMode(EditorLabelMode.Floating)
            .Type(DateBoxType.Date)
						.TabIndex(2)

            .DisplayFormat("dd-MMM-yyyy")
			.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })
            .Value(DateTime.Now)
        )
    </div>

    <!-- Submitted Date (Checkbox + Date) -->
    <div class="form-group col-md-2 col-sm-6" style="margin-bottom:15px;">
        <div class="d-flex align-items-center mb-1">
            @(Html.DevExtreme().CheckBox()
                .Text("")
                .ID("UseSubmittedDate")
							.TabIndex(3)

                .OnValueChanged("updateDueDate")
            )
            <label for="UseSubmittedDate" style="margin-left: 5px; font-size: 13px;">@Html.Raw("Submitted Date")</label>
        </div>
        <div>
            @(Html.DevExtreme().DateBox()
                .ID("InvoiceSubmittedDate")
                .InputAttr("aria-label", "Date")
                .LabelMode(EditorLabelMode.Floating)
                .Type(DateBoxType.Date)
				.TabIndex(4)

                .DisplayFormat("dd-MMM-yyyy")
				.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })
                .Value(DateTime.Now)
            )
        </div>
    </div>

    <!-- Due Date -->
    <div class="form-group col-md-2 col-sm-6">
        @(Html.DevExtreme().DateBox()
            .Label(new JS("formatMessage('Due Date or Payment Terms')"))
            .ID("InvoiceDueDate")
            .InputAttr("aria-label", "Date")
            .LabelMode(EditorLabelMode.Floating)
			.ElementAttr(new { @class = "light-theme-input dynamicFormatDateBox" })
            .Type(DateBoxType.Date)
			.TabIndex(5)
            .DisplayFormat("dd-MMM-yyyy")
            .Value(DateTime.Now)
        )
    </div>

    <!-- No. of Days -->
    <div class="form-group col-md-1 col-sm-6">
        @(Html.DevExtreme().NumberBox()
            .Label(new JS("formatMessage('No. Of Days')"))
            .LabelMode(EditorLabelMode.Floating)
            .ID("InvoiceNoOfDays")
            .Value(0)
            .ShowSpinButtons(true)
            .Min(0)
			.TabIndex(6)
            .Max(1000)
            .Step(1)
            .OnValueChanged("onDaysChange")
        )
    </div>
</div>



		<!-- Second Row -->
		<div class="row w-100 align-items-end">
    <!-- Sales Invoice No -->
			
			
				 <div class="form-group col-md-3 col-sm-6">

					@(Html.DevExtreme().DropDownBox()
										.Label(new JS("formatMessage('Account Head')"))
