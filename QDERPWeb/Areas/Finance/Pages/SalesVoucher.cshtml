					"InvoiceDueDate": $("#InvoiceDueDate").dxDateBox("instance").option("value"),
					"InvoiceNoOfDays": $("#InvoiceNoOfDays").dxNumberBox("instance").option("value"),
					"VoucherRefNo": $("#VoucherRefNo").dxTextBox("instance").option("value"),
					"VoucharNarration": $("#VoucharNarration").dxTextBox("instance").option("value"),
					"VoucherType": $("#VoucherType").dxSelectBox("instance").option("value"),
					"BillRemarks": $("#BillRemarks").dxTextBox("instance").option("value"),
					"UseSubmittedDate": $("#UseSubmittedDate").dxCheckBox("instance").option("value"),
					"IsVerified": $("#VerifiedBy").dxCheckBox("instance").option("value"),
					"IsApproved": $("#ApprovedBy").dxCheckBox("instance").option("value"),
					"VoucherVerifiedOn": new Date(),
					"VoucherApprovedOn": new Date()
				};

				$.ajax({
					type: "POST",
					url: "/api/PurchaseVoucher/SaveVoucher",
					contentType: "application/json",
					data: JSON.stringify(VM),
