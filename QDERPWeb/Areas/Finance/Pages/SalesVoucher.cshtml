<div id="costAllocationPopup" style="display:none;">
	<div style="margin-bottom:10px">
		@(Html.DevExtreme().Button()
				.ID("btnSaveCostAllocation")
				.Icon("save")
				.Text("Save")
				.OnClick("function() { saveCostAllocation(); }")
				)
	</div>
</div>
<div class="card-header" style=" color: slategrey; font-weight:bolder; font-size: 24px;background-color:  aliceblue;">

	SalesVoucher:
</div>


<div class="content-container-top">
	<div class="container">
		<div class="row g-4">
			<div class="col-md-3">
				<div class="form-group">
					<label for="SalesInvoiceNo" class="button-alignment-down">Sales Invoice No</label>
					@(
												Html.DevExtreme().TextBox()
												.ID("VoucherNo")
												.Value(null)
												.OnValueChanged("onVoucherNoChanged")
												.ValidationRules(rules =>
												{
													rules.AddRequired()
													.Message("Sales Invoice No is required");
												})
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="InvoiceDate" class="button-alignment-down">Invoice Date</label>
					@(Html.DevExtreme().DateBox()
												.ID("VoucherDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="EffectiveDate" class="button-alignment-down">Effective Date</label>
					@(Html.DevExtreme().DateBox()
												.ID("VoucherEffectiveDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<div class="button-alignment-down">
						<label for="UseSubmittedDate">Received Date</label>
						@(Html.DevExtreme().CheckBox()
													.ID("UseSubmittedDate")
													.OnValueChanged("updateDueDate")
													)
					</div>
					@(Html.DevExtreme().DateBox()
												.ID("InvoiceSubmittedDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												@* .OnValueChanged("onDateChange") *@
												)
				</div>

			</div>
		</div>
	</div>
	<div class="clear"></div>
	<div class="container  mt-3">
		<div class="row g-5">
			<div class="col-md-6" style="padding-right:0px">
				<div class="form-group">
					<label for="ClientName" class="">Client Name:</label>
					@(Html.DevExtreme().DropDownBox()
												.DataSource(d => d.WebApi()
												.Controller("SalesVoucher")
												.LoadAction("GetClientName")
												.LoadMode(DataSourceLoadMode.Raw)
												.Key("AccountId")
												)
												.ValidationRules(rules =>
												{
													rules.AddRequired()
													.Message("Client Name is required");
												})
												.LabelMode(EditorLabelMode.Outside)
												.ID("ClientNameDropDown")
												.ShowClearButton(true)
												.AcceptCustomValue(true)
												.OpenOnFieldClick(false)
												.ValueChangeEvent("input")
												.HoverStateEnabled(true)
												.ValueExpr("AccountId")
												.DisplayExpr("AccountHead")
												.OnInput("dropDownBoxOnInput")
												.OnOpened("onOpened")
												.TabIndex(1)
												.OnKeyDown("onKeyDown")

												.ContentTemplate(new TemplateName("ClientNameContentTemplate"))
												)

				</div>
			</div>

			<div class="col-md-1" style="margin-top:72px;padding-left:0px;padding-right:0px;width:3%">
				@(Html.DevExtreme().Button()
								.ID("btnAddVoucher")
								.Icon("plus")
								.OnClick("navigateToLedger")
								)
			</div>
			<div class="col-md-1" style="margin-top:72px;padding-left:0px;width:3%;padding-right:0px">
				@(Html.DevExtreme().Button()
								.ID("btnEditVoucher")
								.Icon("edit")
								)
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="InvoiceDueDate" class="">DueDate or Payment Terms</label>
					@(Html.DevExtreme().DateBox()
												.ID("InvoiceDueDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-2">
				<div class="form-group">
					<label for="InvoiceNoOfDays" class="">No. Of Days</label>
					<div style="display:flex;">
						@(Html.DevExtreme().NumberBox()
													.ID("InvoiceNoOfDays")
													.Value(0)
													.ShowSpinButtons(true)
													.Min(0)
													.Max(1000)
													.Step(1)
													.OnValueChanged("onDaysChange")
													)
						<label style="margin-top:10px;" for="InvoiceNoOfDays">Days</label>
					</div>
				</div>
			</div>
		</div>




		<div class="dx-fieldset horizontal-container backgroundcolor" style="margin-top:15px;margin-bottom:0px;">
			<div class="form-group" style="padding-left:20px">
				<div class="button-alignment-down">
					<label for="DrCr">Dr/Cr</label>
				</div>
				@(
								Html.DevExtreme().SelectBox()
								.ID("sbDrCr")
								.DataSource(new[] { "Dr", "Cr" })
								.Value("Cr")
								.Placeholder("Select Transaction Type")
								.Width(90)
								)
			</div>
			<div class="form-group">
				<label for="AccountHead" class="button-alignment-down">Account Head:</label>
				@(Html.DevExtreme().DropDownBox()
								.DataSource(d => d.WebApi()
								.Controller("SalesVoucher")
								.LoadAction("GetClientName")
								.LoadMode(DataSourceLoadMode.Raw)
								.Key("AccountId")
								)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message("Account Head is required");
								})
								.LabelMode(EditorLabelMode.Outside)
								.ID("ddAccountHead")
								.ShowClearButton(true)
								.AcceptCustomValue(true)
								.OpenOnFieldClick(false)
								.ValueChangeEvent("input")
								.HoverStateEnabled(true)
								.ValueExpr("AccountId")
								.DisplayExpr("AccountHead")
								.OnInput("dropDownBoxOnInput")
								.OnOpened("onOpened")
								.Width(650)
								.TabIndex(1)
								.DropDownOptions(o => o
								.Width(1000)
								)
								.OnKeyDown("onKeyDown")

								.ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
								)
			</div>
			<div class="form-group" style="margin-top:56px;margin-left:-10px">
				@(Html.DevExtreme().Button()
								.ID("btnAddAHead")
								.Icon("plus")
								.OnClick("navigateToLedger")
								)
			</div>
			<div class="form-group" style="margin-top:56px;margin-left:-10px">
				@(Html.DevExtreme().Button()
								.ID("btnEditAHead")
								.Icon("edit")
								)
			</div>
			<div class="form-group">
				<label for="Amount" class="button-alignment-down">Amount</label>

				@(
								Html.DevExtreme().NumberBox()
								.ID("txtVoucherAmount")
								.Value(0.00)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message("Amount value doesnot allow to add Zero or negative");
								})
								.Min(0)
								.Placeholder("0.00")
								.Format("#,##0.00")
								.InputAttr(new
								{
									style = "font-family: Inter; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
									type = "number",
									step = "0.01"
								})

								)
			</div>
		</div>
		<div class="dx-fieldset horizontal-container backgroundcolor" style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px">
			<div class="form-group" style="padding-left:20px">
				<label for="Amount" class="button-alignment-down" style="margin-right:25px">Narration</label>
			</div>
			<div class="form-group">
				@(
								Html.DevExtreme().TextArea()
								.ID("txtEntryNarration")
								.Value("")
								.Height(40)
								.Width(720)
								.Placeholder("Enter your comments here...")
								.MaxLength(500)
								)
			</div>
			<div class="form-group" style="">
				@(Html.DevExtreme().Button()
								.ID("btnVoucherEntry")
								.Text("ADD")
								.Height(40)
								.Width(178)
								.Icon("plus")
								.OnClick("function() { addVoucherEntry(); }")
								)
			</div>
		</div>


		<div class="dx-field ledgerResult">
			@(
						Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
						.ID("dataGrid")
						.RemoteOperations(false)
						.Columns(columns =>
						{
							columns.AddFor(m => m.DrCr).Caption("Dr/Cr");
							columns.AddFor(m => m.AccountHead)
							.Caption("Account Head")
							.DataType(GridColumnDataType.String)
							.Lookup(lookup => lookup
							.DataSource(ds => ds.WebApi()
							.Controller("SalesVoucher")
							.LoadAction("GetClientName"))
							.ValueExpr("AccountId")
							.DisplayExpr("AccountHead"));

							columns.AddFor(m => m.DrAmount)
							.Caption("Debit")
							.Alignment(HorizontalAlignment.Right)
							.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
							columns.AddFor(m => m.CrAmount)
							.Caption("Credit")
							.Alignment(HorizontalAlignment.Right)
							.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
							columns.AddFor(m => m.EntryNarration).Caption("Entry Narration");
							columns.AddFor(m => m.SysRemarks).Caption("Remarks");
							columns.AddFor(m => m.VoucherEntryNo).Caption("VoucherEntryNo").Visible(false);
						})
						.Selection(selection => selection.Mode(SelectionMode.Single))
						.AllowColumnReordering(true)
						.AllowColumnResizing(true)
						.ColumnFixing(fixing => fixing.Enabled(true))
						.HeaderFilter(filter => filter.Visible(true))
						.Height(300)
						.ColumnAutoWidth(true)
						.FilterRow(filterRow => filterRow.Visible(false))
						.GroupPanel(groupPanel => groupPanel.Visible(false))
						.ShowBorders(true)
						.Width("100%")
						)
		</div>




		<div id="footerTotals" style="display: flex; justify-content: space-between; background-color: aliceblue; color: white; padding:10px; font-size: 14px; max-width:1245px;position:relative;">
			<div style="flex: 1;">&nbsp;</div>
			<div style="flex: 1;">&nbsp;</div>
			<div style="flex: none; text-align: right;">
				@(Html.DevExtreme().TextBox()
								.ID("totalDebitTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("60%")
								.InputAttr(new { style = "text-align: right;" })
								)
			</div>
			<div style="flex: none; text-align: right;">
				@(Html.DevExtreme().TextBox()
								.ID("totalCreditTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("60%")
								.InputAttr(new { style = "text-align: right;" })
								)
			</div>
			<div style="flex: 2;">&nbsp;</div>
		</div>

		<!-- Context Menu for Actions -->
		<ul id="contextMenu" class="context-menu" style="display: none;">
			<li onclick="editCostAllocation()">
				<i class="fas fa-edit" style="margin-right: 8px;"></i> Edit Cost Allocation
			</li>
			<li onclick="editBillReceivable()">
				<i class="fas fa-file-invoice" style="margin-right: 8px;"></i> Edit Bill Receivable
			</li>
			<li onclick="editPropertyAllocation()">
				<i class="fas fa-cogs" style="margin-right: 8px;"></i> Edit Property Allocation
			</li>
			<li onclick="onRowRemoving()">
				<i class="fas fa-trash-alt" style="margin-right: 8px;"></i> Delete Line Items
			</li>
		</ul>


		<div class="container">
			<div class="row g-3">
				<div class="col-md-2 backgroundcolor" style="padding-top:10px;padding-bottom:10px">
					<div class="form-group">
						<label for="VoucherRefNo">Client PO No</label>
						@(
													Html.DevExtreme().TextBox()
													.ID("VoucherRefNo")

													.Value(null)
													)
					</div>
					<div class="form-group mt-3">
						<label for="VoucherType">VoucherType</label>
						@(
													Html.DevExtreme().SelectBox()
													.ID("VoucherType")
													.DataSource(new[] { "Sales", "Purchase", "Journal" })
													.Value("Sales")
													.Disabled(true)
													)

					</div>
				</div>
				<div class="col-md-9 backgroundcolor" style="padding-top:10px;padding-bottom:10px">
					<div class="form-group">
						<label for="VoucharNarration">Voucher Narration</label>
						@(
													Html.DevExtreme().TextBox()
													.ID("VoucharNarration")
													.Value(null)
													)
					</div>
					<div class="form-group mt-3">
						<label for="BillRemarks">Remarks</label>
						@(
													Html.DevExtreme().TextBox()
													.ID("BillRemarks")
													.Value(null)

													)

					</div>
					<div class="row">
						<div class="col-md-6">

							<div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
								@(Html.DevExtreme().CheckBox().ID("VerifiedBy"))
								<span style="margin-left:5px">Verified By:</span>
								@(Html.DevExtreme().TextBox()
															.ID("VerifiedBytext")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															)
							</div>

							<div class="form-group d-flex align-items-center mt-2">
								<span>Verified On:</span>
								@(Html.DevExtreme().TextBox()
															.ID("VerifiedOnDate")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															.ElementAttr(new { style = "margin-left: 10px;" })
															)
							</div>
						</div>
						<div class="col-md-6">

							<div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
								@(Html.DevExtreme().CheckBox().ID("ApprovedBy"))
								<span style="margin-left:5px">Approved By:</span>
								@(Html.DevExtreme().TextBox()
															.ID("ApprovedBytext")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															)
							</div>

							<div class="form-group d-flex align-items-center mt-2">
								<span>Approved On:</span>
								@(Html.DevExtreme().TextBox()
															.ID("ApprovedOntext")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															.ElementAttr(new { style = "margin-left: 10px;" })
															)
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-1 backgroundcolor">
					<div class="form-group " style="padding-top:50px;padding-left:7px;">
						@(Html.DevExtreme().Button()
													.ID("btnAttachment")
													.Icon("fa fa-book")
													.Height(70)
													.Width(70)
													)
					</div>
				</div>
			</div>
		</div>


		<br />

		<div>
			@await Html.PartialAsync("_FormFooter")
		</div>

		@using (Html.DevExtreme().NamedTemplate("ClientNameContentTemplate"))
		{
			@(Html.DevExtreme().DataGrid()
						.ID("clientname-datagrid")
						.DataSource(d => d.WebApi()
						.Controller("SalesVoucher")
						.LoadAction("GetClientName")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.WordWrapEnabled(true)
						.ShowBorders(true)

						.SearchPanel(sp => sp.HighlightSearchText(true))
						.Selection(sl => sl.Mode(SelectionMode.Single))
						.OnSelectionChanged("dataGridSelectionChanged")
						.OnInitialized("dataGridInitialized")
						.HeaderFilter(p => p.Visible(true))
						.ShowBorders(true)
						.HoverStateEnabled(true)
						.Paging(p => p.PageSize(15))
						.FilterRow(f => f.Visible(true))
						.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
						.Height(345)
						.Selection(s => s.Mode(SelectionMode.Single))
						.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
						.Columns(columns =>
						{
							columns.Add().DataField("AccountId");
							columns.Add().DataField("AccountHead");
							columns.Add().DataField("AccountHeadArabic");
							columns.Add().DataField("IsLedgerObselete").Alignment(HorizontalAlignment.Center)
						.CellTemplate(@<text>
			<div class="dx-icon">
				<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
			</div>
		</text>);

						})
					)
		}<div id="footerTotals" style="display: flex; background-color: aliceblue; color: white; padding: 5px 10px; font-size: 14px;">
			<div style="flex: 3.4;">&nbsp;</div>

			<div style="flex: 1; text-align: center;">
				@(Html.DevExtreme().TextBox()
								.ID("totalDebitTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("100%")
								)
			</div>

			<div style="flex: 1; text-align: center;">
				@(Html.DevExtreme().TextBox()
								.ID("totalCreditTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("100%")
								)
			</div>
			<div style="flex: 4;">&nbsp;</div>
		</div>


		@using (Html.DevExtreme().NamedTemplate("AccountHeadContentTemplate"))
		{
			@(Html.DevExtreme().DataGrid()
						.ID("accounthead-datagrid")
						.DataSource(d => d.WebApi()
						.Controller("SalesVoucher")
						.LoadAction("GetClientName")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.WordWrapEnabled(true)
						.ShowBorders(true)
						.SearchPanel(sp => sp.HighlightSearchText(true))
						.Selection(sl => sl.Mode(SelectionMode.Single))
						.OnSelectionChanged("dataGridAccountHeadSelectionChanged")
						.OnInitialized("dataGridAccountHeadInitialized")
						.HeaderFilter(p => p.Visible(true))
						.ShowBorders(true)
						.HoverStateEnabled(true)
						.Paging(p => p.PageSize(15))
						.FilterRow(f => f.Visible(true))
						.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
						.Height(345)
						.Selection(s => s.Mode(SelectionMode.Single))
						.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
						.Columns(columns =>
						{
							columns.Add().DataField("AccountId");
							columns.Add().DataField("AccountHead");
							columns.Add().DataField("AccountHeadArabic");
							columns.Add().DataField("IsLedgerObselete").Alignment(HorizontalAlignment.Center)
						.CellTemplate(@<text>
			<div class="dx-icon">
				<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
			</div>
		</text>);

						})
					)
		}


	</div>
