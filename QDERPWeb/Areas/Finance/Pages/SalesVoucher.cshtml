			function updateDueDate() {


				// Check if the UseSubmittedDate checkbox is checked
				const useSubmittedDate = $("#UseSubmittedDate").dxCheckBox("instance").option("value");

				// If the checkbox is not checked, run the else condition (onDateChange logic)
				if (!useSubmittedDate) {


					// Call the onDateChange function to validate the due date based on the voucher date
					onDateChange();
					return; // Exit function early, as we are running the date change logic
				}



				const noOfDays = $("#InvoiceNoOfDays").dxNumberBox("instance").option("value");


				let baseDate;
				if (useSubmittedDate) {
					// Get the Submitted Date
					baseDate = $("#InvoiceSubmittedDate").dxDateBox("instance").option("value");
				} else {
					// Get the Voucher Date (if checkbox is unchecked, no action will reach here)
					baseDate = $("#VoucherDate").dxDateBox("instance").option("value");
				}

				if (!baseDate) {
					alert("Please select a valid base date!");
					return;
				}

				const calculatedDate = new Date(baseDate);

				// If UseSubmittedDate is checked, calculate the difference in days between Submitted Date and Due Date
				if (useSubmittedDate) {
					const submittedDate = new Date($("#InvoiceSubmittedDate").dxDateBox("instance").option("value"));
					const dueDate = new Date($("#InvoiceDueDate").dxDateBox("instance").option("value"));

					const timeDiff = dueDate - submittedDate;  // Difference in milliseconds
					const daysDifference = timeDiff / (1000 * 3600 * 24);  // Convert milliseconds to days

					// Ensure no decimals are shown, rounding to the nearest integer
					const roundedDays = Math.floor(daysDifference);  // Rounds down to the nearest integer

					// Update the "No. Of Days" field
					$("#InvoiceNoOfDays").dxNumberBox("instance").option("value", roundedDays);
				} else {
					// This block runs if the checkbox is unchecked. Perform the date validation logic.


					// Trigger the onDateChange function logic when checkbox is unchecked.
					onDateChange();
				}


			}

			// The onDateChange function to ensure that the Due Date is not earlier than the Voucher Date
			function onDateChange() {
				const voucherDate = new Date($("#VoucherDate").dxDateBox("instance").option("value"));
				const dueDate = new Date($("#InvoiceDueDate").dxDateBox("instance").option("value"));

				// Ensure that Due Date is not less than Voucher Date
				if (dueDate < voucherDate) {
					alert("Due Date cannot be earlier than Voucher Date.");
					$("#InvoiceDueDate").dxDateBox("instance").option("value", voucherDate); // Reset Due Date
					return;
				}

				// Calculate the difference in days
				const diffTime = Math.abs(dueDate - voucherDate);
				const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

				// Set the difference in the No. Of Days field
				$("#InvoiceNoOfDays").dxNumberBox("instance").option("value", diffDays);
			}

			$(function () {
				// Trigger the updateDueDate function when the Submitted Date is changed
				$("#InvoiceSubmittedDate").dxDateBox({
					onValueChanged: function () {
						updateDueDate();
					}
				});

				// Trigger the updateDueDate function when the Voucher Date is changed
				$("#VoucherDate").dxDateBox({
					onValueChanged: function () {
						updateDueDate();
					}
				});

				// Trigger the updateDueDate function when the "No. Of Days" is changed
				$("#InvoiceNoOfDays").dxNumberBox({
					onValueChanged: function () {
						updateDueDate();
					}
				});

				// Trigger the updateDueDate function when the checkbox is toggled
				$("#UseSubmittedDate").dxCheckBox({
					onValueChanged: function () {
						updateDueDate();
					}
				});
			});



