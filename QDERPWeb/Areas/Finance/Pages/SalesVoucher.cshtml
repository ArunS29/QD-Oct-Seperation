		$("#btnSave").on("click", function (e) {
			e.preventDefault();

			var isValid = true;
			var requiredFields = [
				{ id: "#VoucherNo", type: "dxTextBox" },
				{ id: "#VoucherDate", type: "dxDateBox" },
