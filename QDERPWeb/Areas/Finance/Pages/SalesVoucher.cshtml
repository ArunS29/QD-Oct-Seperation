	// Function to open a popup (Cost Allocation)
	function openCostAllocationPopup(params) {
		const queryString = Object.keys(params)
			.map(key => `${key}=${params[key]}`)
			.join('&');
		
		$.ajax({
			url: `/api/VoucherEntryReceipts/CostAllocation?${queryString}`,
			type: "GET",
			dataType: "html",
			success: function (data) {
				// Get the popup's unique identifier, for example, use the voucher number
				const popupId = `CostAllocationPopup-${params.VoucherEntryNo}`;
				
				// Check if the popup is already opened
				if (!openedPopups[popupId]) {
					// Create and store the popup instance
					let popupInstance = $("#CostAllocationPopup").dxPopup("instance");
					popupInstance.option("contentTemplate", function () {
						return $("<div>").html(data);
					});

					// Store the popup instance in the openedPopups map
					openedPopups[popupId] = popupInstance;
					// popupInstance.popupId = popupId;
					console.log(openedPopups);
					popupInstance.show();
				} else {
					// If the popup is already opened, just show it
					openedPopups[popupId].show();
				}
			},
			error: function (xhr, status, error) {
				console.error("Error loading Cost Allocation view:", error);
				alert("Failed to load cost allocation details.");
			}
		});
	}

