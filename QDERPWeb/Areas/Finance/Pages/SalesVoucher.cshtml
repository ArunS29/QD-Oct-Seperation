	function onVoucherNoChanged(e) {
		const voucherNo = e.value;

		const urlParams = new URLSearchParams(window.location.search);
		const argsledno = urlParams.get("argsledno");

		// If the voucher number is coming from the URL, accept it without validation
		if (argsledno && argsledno === voucherNo) {
			return;
		}

		// Make an AJAX request to check if the Sales Invoice No exists
		$.ajax({
			type: "GET",
			url: "/api/SalesVoucher/CheckVoucherExists", // API endpoint to validate voucher existence
			contentType: "application/json",
			data: { voucherNo: voucherNo },
			success: function (response) {
				if (!response.success) {
					// Show error notification if the input is invalid or empty
					DevExpress.ui.notify(response.message, "error", 3000);

					// Clear the TextBox value
					$("#VoucherNo").dxTextBox("instance").option("value", null);
					return;
				}

				if (response.exists) {
					// Show error notification if the voucher already exists
					DevExpress.ui.notify("Sales Invoice No already exists. Please use a different number.", "error", 3000);

					// Clear the TextBox value
					$("#VoucherNo").dxTextBox("instance").option("value", null);
				}
			},
			error: function (xhr, status, error) {
				DevExpress.ui.notify("An error occurred while validating Sales Invoice No.", "error", 3000);
			}
		});
	}


		function addVoucherEntry() {
			var accountHead = $("#ddAccountHead").dxDropDownBox("instance");
			var ClientName = $("#ClientNameDropDown").dxDropDownBox("instance");
			var txtVoucherAmt = $("#txtVoucherAmount").dxNumberBox("instance");
			var voucherNo = $("#VoucherNo").dxTextBox("instance");
