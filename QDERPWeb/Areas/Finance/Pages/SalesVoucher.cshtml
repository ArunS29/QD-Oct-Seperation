@page
@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style type="text/css">
	.dx-datagrid .dx-row {
		border-bottom: 1px solid #ccc;
	}

	.error-message {
		color: red;
		font-size: 12px;
		margin-top: 5px;
	}

	.dx-selectbox .dx-texteditor-input {
		text-align: center;
	}

	.context-menu {
		display: none;
		position: absolute;
		background-color: white;
		border: 1px solid #ccc;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
		list-style: none;
		padding: 8px 0;
		z-index: 1000;
	}

		.context-menu li {
			padding: 8px 16px;
			cursor: pointer;
			display: flex;
			align-items: center;
		}

			.context-menu li:hover {
				background-color: #f0f0f0;
			}

</style>
<div id="costAllocationPopup" style="display:none;">
	<div style="margin-bottom:10px">
		@(Html.DevExtreme().Button()
				.ID("btnSaveCostAllocation")
				.Icon("save")
				.Text(new JS("formatMessage('Save')"))
				.OnClick("function() { saveCostAllocation(); }")
				)
	</div>
</div>
<div class="title">
	<div class="header-container">
		<div id="SalesVoucher" class="no-border-input"></div>
	</div>
</div>
<div class="content-container-top" style="background-color:#909ead00;">
	<div class="container">
		<div class="row g-4" style="padding:1em;">
			<div class="col-md-3">
				<div class="form-group">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Sales Invoice No')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("VoucherNo")
												.Value("")
												.OnValueChanged("onVoucherNoChanged")
												.ValidationRules(rules =>
												{
													rules.AddRequired()
													.Message(new JS("formatMessage('Sales Invoice No is required')"));
												})
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					@(Html.DevExtreme().DateBox()
												.Label(new JS("formatMessage('Invoice Date')"))
												.ID("VoucherDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					@(Html.DevExtreme().DateBox()
												.Label(new JS("formatMessage('Effective Date')"))
												.ID("VoucherEffectiveDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<div class="button-alignment-down">
						@(Html.DevExtreme().CheckBox()
													.Text(new JS("formatMessage('Received Date')"))
													.ID("UseSubmittedDate")
													.OnValueChanged("updateDueDate")
													)
					</div>
					@(Html.DevExtreme().DateBox()
												.ID("InvoiceSubmittedDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												@* .OnValueChanged("onDateChange") *@
												)
				</div>

			</div>
		</div>
	</div>
		<div class="row g-5" style="padding:1em;gap:1px">
			<div class="col-md-6" style="padding-right:0px">
				<div class="form-group">
					@(Html.DevExtreme().DropDownBox()
												.Label(new JS("formatMessage('Client Name')"))
												.DataSource(d => d.WebApi()
												.Controller("SalesVoucher")
												.LoadAction("GetClientName")
												.LoadMode(DataSourceLoadMode.Raw)
												.Key("AccountId")
												)
												.ValidationRules(rules =>
												{
													rules.AddRequired()
													.Message(new JS("formatMessage('Client Name is required')"));
												})
												.LabelMode(EditorLabelMode.Outside)
												.ID("ClientNameDropDown")
												.ShowClearButton(true)
												.AcceptCustomValue(true)
												.OpenOnFieldClick(false)
												.ValueChangeEvent("input")
												.HoverStateEnabled(true)
												.ValueExpr("AccountId")
												.DisplayExpr("AccountHead")
												.OnInput("dropDownBoxOnInput")
												.OnOpened("onOpened")
												.TabIndex(1)
												.OnKeyDown("onKeyDown")

												.ContentTemplate(new TemplateName("ClientNameContentTemplate"))
												)

				</div>
			</div>

		<div class="col-md-1" style="margin-top: 62px;padding-left:0px;padding-right:0px;width: 4%;">
				@(Html.DevExtreme().Button()
								.ID("btnAddVoucher")
								.Icon("plus")
								.OnClick("navigateToLedger")
								)
			</div>
		<div class="col-md-1" style="margin-top: 62px;padding-left:0px;padding-right:0px;width: 4%;">
				@(Html.DevExtreme().Button()
								.ID("btnEditVoucher")
								.Icon("edit")
								)
			</div>
			<div class="col-md-3">
				<div class="form-group">
					@(Html.DevExtreme().DateBox()
												.Label(new JS("formatMessage('Due Date or Payment Terms')"))
												.ID("InvoiceDueDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												)
				</div>
			</div>
			<div class="col-md-2">
				<div class="form-group">
					<div style="display:flex;">
						@(Html.DevExtreme().NumberBox()
													.Label(new JS("formatMessage('No. Of Days')"))
													.LabelMode(EditorLabelMode.Outside)
													.ID("InvoiceNoOfDays")
													.Value(0)
													.ShowSpinButtons(true)
													.Min(0)
													.Max(1000)
													.Step(1)
													.OnValueChanged("onDaysChange")
													)
					<label id="Days" class="no-border-input" style="margin-top:10px;" for="InvoiceNoOfDays"></label>
					</div>
				</div>
			</div>
		</div>




		<div class="dx-fieldset horizontal-container" style="margin-top:15px;margin-bottom:0px;">
			<div class="form-group" style="padding-left:20px">
				<div class="button-alignment-down">
				</div>
				@(
								Html.DevExtreme().SelectBox()
								.Label(new JS("formatMessage('Dr/Cr')"))
								.LabelMode(EditorLabelMode.Outside)
								.ID("sbDrCr")
								.DataSource(new[] { "Dr", "Cr" })
								.Value("Cr")
								.Placeholder(new JS("formatMessage('Select Transaction Type')"))
								.Width(90)
								)
			</div>
			<div class="form-group">
				@(Html.DevExtreme().DropDownBox()
								.Label(new JS("formatMessage('Account Head')"))
								.DataSource(d => d.WebApi()
								.Controller("SalesVoucher")
								.LoadAction("GetClientName")
								.LoadMode(DataSourceLoadMode.Raw)
								.Key("AccountId")
								)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message("Account Head is required");
								})
								.LabelMode(EditorLabelMode.Outside)
								.ID("ddAccountHead")
								.ShowClearButton(true)
								.AcceptCustomValue(true)
								.OpenOnFieldClick(false)
								.ValueChangeEvent("input")
								.HoverStateEnabled(true)
								.ValueExpr("AccountId")
								.DisplayExpr("AccountHead")
								.OnInput("dropDownBoxOnInput")
								.OnOpened("onOpened")
								.Width(650)
								.TabIndex(1)
								.DropDownOptions(o => o
								.Width(1000)
								)
								.OnKeyDown("onKeyDown")

								.ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
								)
			</div>
			<div class="form-group" style="margin-top:43px;">
				@(Html.DevExtreme().Button()
								.ID("btnAddAHead")
								.Icon("plus")
								.OnClick("navigateToLedger")
								)
			</div>
			<div class="form-group" style="margin-top:43px;">
				@(Html.DevExtreme().Button()
								.ID("btnEditAHead")
								.Icon("edit")
								)
			</div>
			<div class="form-group">

				@(
								Html.DevExtreme().NumberBox()
								.Label(new JS("formatMessage('Amount')"))
								.LabelMode(EditorLabelMode.Outside)
								.ID("txtVoucherAmount")
								.Value(0.00)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message("Amount value doesnot allow to add Zero or negative");
								})
								.Min(0)
								.Placeholder("0.00")
								.Format("#,##0.00")
								.InputAttr(new
								{
									style = "font-family: Inter; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
									type = "number",
									step = "0.01"
								})

								)
			</div>
		</div>
		<div class="dx-fieldset horizontal-container" style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px">
			<div class="form-group" style="padding-left:20px">
			</div>
			<div class="form-group">
				@(
								Html.DevExtreme().TextArea()
								.Label(new JS("formatMessage('Narration')"))
								.LabelMode(EditorLabelMode.Outside)
								.ID("txtEntryNarration")
								.Value("")
								.Height(40)
								.Width(720)
								.Placeholder(new JS("formatMessage('Enter your comments here...')"))
								.MaxLength(500)
								)
			</div>
			<div class="form-group" style="">
				@(Html.DevExtreme().Button()
								.ID("btnVoucherEntry")
								.Text(new JS("formatMessage('ADD')"))
								.Height(40)
								.Width(178)
								.Icon("plus")
								.OnClick("function() { addVoucherEntry(); }")
								)
			</div>
		</div>


		<div class="dx-field ledgerResult">
			@(
						Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
						.ID("dataGrid")
						.RemoteOperations(false)
						.Columns(columns =>
						{
							columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('Dr/Cr')"));
							columns.AddFor(m => m.AccountHead)
							.Caption(new JS("formatMessage('Account Head')"))
							.DataType(GridColumnDataType.String)
							.Lookup(lookup => lookup
							.DataSource(ds => ds.WebApi()
							.Controller("SalesVoucher")
							.LoadAction("GetClientName"))
							.ValueExpr("AccountId")
							.DisplayExpr("AccountHead"));

							columns.AddFor(m => m.DrAmount)
							.Caption(new JS("formatMessage('Debit')"))
							.Alignment(HorizontalAlignment.Right)
							.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
							columns.AddFor(m => m.CrAmount)
							.Caption(new JS("formatMessage('Credit')"))
							.Alignment(HorizontalAlignment.Right)
							.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
							columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('Entry Narration')"));
							columns.AddFor(m => m.SysRemarks).Caption(new JS("formatMessage('Remarks')"));
							columns.AddFor(m => m.VoucherEntryNo).Caption(new JS("formatMessage('Voucher Entry No')")).Visible(false);
						})
						.Selection(selection => selection.Mode(SelectionMode.Single))
						.AllowColumnReordering(true)
						.AllowColumnResizing(true)
						.ColumnFixing(fixing => fixing.Enabled(true))
						@* .HeaderFilter(filter => filter.Visible(true)) *@
						.Height(300)
						.ColumnAutoWidth(true)
						.FilterRow(filterRow => filterRow.Visible(false))
						.GroupPanel(groupPanel => groupPanel.Visible(false))
						.ShowBorders(true)
						.Width("100%")
						)
		</div>




		<div id="footerTotals" style="display: flex; justify-content: space-between; color: white; padding:10px; font-size: 14px; max-width:1245px;position:relative;">
			<div style="flex: 2;">&nbsp;</div>
			<div style="flex: 1;">&nbsp;</div>
			<div style="flex: none; text-align: right;">
				@(Html.DevExtreme().TextBox()
								.ID("totalDebitTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("60%")
								.InputAttr(new { style = "text-align: right;" })
								)
			</div>
			<div style="flex: none; text-align: right;">
				@(Html.DevExtreme().TextBox()
								.ID("totalCreditTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("60%")
								.InputAttr(new { style = "text-align: right;" })
								)
			</div>
			<div style="flex: 2;">&nbsp;</div>
		</div>

		<!-- Context Menu for Actions -->
		<ul id="contextMenu" class="context-menu" style="display: none;">
			<li onclick="editCostAllocation()">
            <i class="fas fa-edit" style="margin-right: 8px;"></i><div id="EditCostAllocation" class="no-border-input"></div>
        </li>
			<li onclick="editBillReceivable()">
            <i class="fas fa-file-invoice" style="margin-right: 8px;"></i><div id="EditBillReceivable" class="no-border-input"></div>
        </li>
		    <li onclick="editPropertyAllocation()">
            <i class="fas fa-cogs" style="margin-right: 8px;"></i><div id="EditPropertyAllocation" class="no-border-input"></div>
        </li>
			<li onclick="onRowRemoving()">
            <i class="fas fa-trash-alt" style="margin-right: 8px;"></i><div id="DeleteLineEntry" class="no-border-input"></div>
        </li>
		</ul>


			<div class="row g-3" style="padding:1em">
				<div class="col-md-2" style="padding-top:10px;padding-bottom:10px">
					<div class="form-group">
						@(
													Html.DevExtreme().TextBox()
													.Label(new JS("formatMessage('Client PO No')"))
													.LabelMode(EditorLabelMode.Outside)
													.ID("VoucherRefNo")

													.Value(null)
													)
					</div>
					<div class="form-group mt-3">
						@(
													Html.DevExtreme().SelectBox()
													.Label(new JS("formatMessage('Voucher Type')"))
													.LabelMode(EditorLabelMode.Outside)
													.ID("VoucherType")
													.DataSource(new[] { "Sales", "Purchase", "Journal" })
													.Value("Sales")
													.Disabled(true)
													)

					</div>
				</div>
				<div class="col-md-9" style="padding-top:10px;padding-bottom:10px">
					<div class="form-group">
						@(
													Html.DevExtreme().TextBox()
													.Label(new JS("formatMessage('Voucher Narration')"))
													.LabelMode(EditorLabelMode.Outside)
													.ID("VoucharNarration")
													.Value(null)
													)
					</div>
					<div class="form-group mt-3">
						@(
													Html.DevExtreme().TextBox()
													.Label(new JS("formatMessage('Remarks')"))
													.LabelMode(EditorLabelMode.Outside)
													.ID("BillRemarks")
													.Value(null)

													)

					</div>
					<div class="row">
						<div class="col-md-6">

							<div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
								@(Html.DevExtreme().CheckBox().ID("VerifiedBy").Text(new JS("formatMessage('Verified By:')")))
								@(Html.DevExtreme().TextBox()
															.ID("VerifiedBytext")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															)
							</div>

							<div class="form-group d-flex align-items-center mt-2">
								<span id="VerifiedOn"class="no-border-input"></span>
								@(Html.DevExtreme().TextBox()
															.ID("VerifiedOnDate")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															.ElementAttr(new { style = "margin-left: 10px;" })
															)
							</div>
						</div>
						<div class="col-md-6">

							<div class="form-group d-flex align-items-center" style="padding-top:10px;padding-bottom:10px">
								@(Html.DevExtreme().CheckBox().ID("ApprovedBy").Text(new JS("formatMessage('Approved By:')")))
								@(Html.DevExtreme().TextBox()
															.ID("ApprovedBytext")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															)
							</div>

							<div class="form-group d-flex align-items-center mt-2">
								<span id="ApprovedOn" class="no-border-input"></span>
								@(Html.DevExtreme().TextBox()
															.ID("ApprovedOntext")
															.Value(null)
															.Disabled(true)
															.Width("200px")
															.ElementAttr(new { style = "margin-left: 10px;" })
															)
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-1">
					<div class="form-group " style="padding-top:50px;padding-left:7px;">
						@(Html.DevExtreme().Button()
						.ID("btnAttachment")
						.Icon("fa fa-book")
						.Height(70)
						.Width(70)
						)
					</div>
				</div>
			</div>
		<div>
			@await Html.PartialAsync("_FormFooter")
		</div>

		@using (Html.DevExtreme().NamedTemplate("ClientNameContentTemplate"))
		{
			@(Html.DevExtreme().DataGrid()
						.ID("clientname-datagrid")
						.DataSource(d => d.WebApi()
						.Controller("SalesVoucher")
						.LoadAction("GetClientName")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.WordWrapEnabled(true)
						.ShowBorders(true)

						.SearchPanel(sp => sp.HighlightSearchText(true))
						.Selection(sl => sl.Mode(SelectionMode.Single))
						.OnSelectionChanged("dataGridSelectionChanged")
						.OnInitialized("dataGridInitialized")
						.HeaderFilter(p => p.Visible(true))
						.ShowBorders(true)
						.HoverStateEnabled(true)
						.Paging(p => p.PageSize(15))
						.FilterRow(f => f.Visible(true))
						.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
						.Height(345)
						.Selection(s => s.Mode(SelectionMode.Single))
						.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
						.Columns(columns =>
						{
					columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
					columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"));
					columns.Add().DataField("AccountHeadArabic").Caption(new JS("formatMessage('Account Head Arabic')"));
					columns.Add().DataField("IsLedgerObselete").Caption(new JS("formatMessage('Is Ledger Obselete')")).Alignment(HorizontalAlignment.Center)
						.CellTemplate(@<text>
			<div class="dx-icon">
				<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
			</div>
		</text>);

						})
					)
		}<div id="footerTotals" style="display: flex padding: 5px 10px; font-size: 14px;">
			<div style="flex: 3">&nbsp;</div>

			<div style="flex: 1; text-align: center;">
				@(Html.DevExtreme().TextBox()
								.ID("totalDebitTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("100%")
								)
			</div>

			<div style="flex: 1; text-align: center;">
				@(Html.DevExtreme().TextBox()
								.ID("totalCreditTextbox")
								.Value("0.00")
								.ReadOnly(true)
								.Width("100%")
								)
			</div>
			<div style="flex: 4;">&nbsp;</div>
		</div>


		@using (Html.DevExtreme().NamedTemplate("AccountHeadContentTemplate"))
		{
			@(Html.DevExtreme().DataGrid()
						.ID("accounthead-datagrid")
						.DataSource(d => d.WebApi()
						.Controller("SalesVoucher")
						.LoadAction("GetClientName")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountId")
						)
						.WordWrapEnabled(true)
						.ShowBorders(true)
						.SearchPanel(sp => sp.HighlightSearchText(true))
						.Selection(sl => sl.Mode(SelectionMode.Single))
						.OnSelectionChanged("dataGridAccountHeadSelectionChanged")
						.OnInitialized("dataGridAccountHeadInitialized")
						.HeaderFilter(p => p.Visible(true))
						.ShowBorders(true)
						.HoverStateEnabled(true)
						.Paging(p => p.PageSize(15))
						.FilterRow(f => f.Visible(true))
						.Scrolling(s => s.Mode(GridScrollingMode.Virtual))
						.Height(345)
						.Selection(s => s.Mode(SelectionMode.Single))
						.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
						.Columns(columns =>
						{
					columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
					columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"));
					columns.Add().DataField("AccountHeadArabic").Caption(new JS("formatMessage('Account Head Arabic')"));
					columns.Add().DataField("IsLedgerObselete").Caption(new JS("formatMessage('Is Ledger Obselete')")).Alignment(HorizontalAlignment.Center)
						.CellTemplate(@<text>
			<div class="dx-icon">
				<%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
			</div>
		</text>);

						})
					)
		}


	</div>
	<script>
		$(function () {
                                        $("#EditCostAllocation").dxTextBox({
                                                    text:formatMessage("Edit Cost Allocation"),
                                                readOnly: true

                                });
								});
	$(function () {
                        
                                        $("#DeleteAllLineEntries").dxTextBox({
