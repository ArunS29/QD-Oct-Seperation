	function proceedWithApproval() {
		$("#ApprovedBy").dxCheckBox("instance").option("value", true);
		var vno = $("#VoucherNo").dxTextBox("instance").option("value");

		const currentDate = new Date();
		const formattedDate = currentDate.toLocaleDateString("en-GB", {
			day: "2-digit",
			month: "short",
			year: "numeric"
		}).replace(/ /g, '-');

		$.ajax({
			success: function () {
				Swal.fire({
					title: "Success!",
					text: "Voucher has been Approved.",
					icon: "success",
					confirmButtonText: "OK"
				}).then(() => {
					disableEditing();
					$("#ApprovedBytext").dxTextBox("instance").option("value", "Admin");
					$("#ApprovedOntext").dxTextBox("instance").option("value", formattedDate);
				});
			},
			error: function () {
				Swal.fire({
					title: "Error",
					text: "Please save the transactions after proceeding!",
					icon: "error",
					confirmButtonText: "OK"
				});
			}
		});
