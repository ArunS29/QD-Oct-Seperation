@page
@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style type="text/css">
	.dx-datagrid .dx-row {
		border-bottom: 1px solid #ccc;
	}


	.error-message {
		color: red;
		font-size: 12px;
		margin-top: 5px;
	}

	.dx-selectbox .dx-texteditor-input {
		text-align: center;
	}

	.context-menu {
		display: none;
		position: absolute;
		background-color: white;
		border: 1px solid #ccc;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
		list-style: none;
		padding: 8px 0;
		z-index: 1000;
	}

		.context-menu li {
			padding: 8px 16px;
			cursor: pointer;
			display: flex;
			align-items: center;
		}

			.context-menu li:hover {
				background-color: #f0f0f0;
			}

</style>
<div id="costAllocationPopup" style="display:none;">
	<div style="margin-bottom:10px">
		@(Html.DevExtreme().Button()
				.ID("btnSaveCostAllocation")
				.Icon("save")
				.Text(new JS("formatMessage('Save')"))
				.OnClick("function() { saveCostAllocation(); }")
				)
	</div>
</div>
<div class="title">
	<div class="header-container">
		<div id="SalesVoucher" class="no-border-input"></div>
	</div>
</div>
<div class="content-container-top" style="background-color:#909ead00;">
	<div class="container1">
		<div class="row g-4">
			<div class="col-md-3">
				<div class="form-group">
					@(
												Html.DevExtreme().TextBox()
												.Label(new JS("formatMessage('Sales Invoice No')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("VoucherNo")
												.Value("")
												.OnValueChanged("onVoucherNoChanged")
												.ValidationRules(rules =>
												{
													rules.AddRequired()
													.Message(new JS("formatMessage('Sales Invoice No is required')"));
												})
												)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					@(Html.DevExtreme().DateBox()
												.Label(new JS("formatMessage('Invoice Date')"))
												.ID("VoucherDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
											    .OnValueChanged("onVoucherDateChange") // JS function name// JS function name
																										)
					
				</div>
			</div>

			<div class="col-md-3">
				<div class="form-group">
					@(Html.DevExtreme().DateBox()
												.Label(new JS("formatMessage('Effective Date')"))
												.ID("VoucherEffectiveDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
							)
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<div class="">
						@(Html.DevExtreme().CheckBox()
													.Text(new JS("formatMessage('Submitted Date')"))
													.ID("UseSubmittedDate")
													.OnValueChanged("updateDueDate")
													)
					</div>
					@(Html.DevExtreme().DateBox()
												.ID("InvoiceSubmittedDate")
												.InputAttr("aria-label", "Date")
												.LabelMode(EditorLabelMode.Outside)
												.Type(DateBoxType.Date)
												.DisplayFormat("dd-MMM-yyyy")
												.Value(DateTime.Now)
												@* .OnValueChanged("onDateChange") *@
												)
				</div>

			</div>
		</div>
	</div>
	<div class="row g-5" style="padding:1em;gap:1px">
		<div class="col-md-6" style="padding-right:0px">
			<div class="form-group">
				@(Html.DevExtreme().DropDownBox()
								.Label(new JS("formatMessage('Client Name')"))
								.DataSource(d => d.WebApi()
								.Controller("SalesVoucher")
								.LoadAction("GetClientName")
								.LoadMode(DataSourceLoadMode.Raw)
								.Key("AccountId")
								)
								.ValidationRules(rules =>
								{
									rules.AddRequired()
									.Message(new JS("formatMessage('Client Name is required')"));
								})


								.LabelMode(EditorLabelMode.Outside)
								.ID("accountDropDownBox")
								.ShowClearButton(true)
								.AcceptCustomValue(true)
								.AcceptCustomValue(false)
								.OpenOnFieldClick(false)
								.ValueChangeEvent("input")
								.HoverStateEnabled(true)
								.ValueExpr("AccountId")
								.DisplayExpr("AccountHead")
								.OnInput("dropDownBoxOnInput")
								.OnOpened("onOpened")
								.TabIndex(1)
								.OnKeyDown("onKeyDown")
								.OnValueChanged("onSupplierNameChanged")
								.ContentTemplate(new TemplateName("ClientNameContentTemplate"))
								)

			</div>
		</div>

		<div class="col-md-1" style="margin-top: 67px;padding-left:0px;padding-right:0px;width: 4%;">
			@* 	@(Html.DevExtreme().Button()
								.ID("btnAddVoucher")
								.Icon("plus")
								.OnClick("navigateToLedger")
								) *@

			@(Html.DevExtreme().Button()
						.ID("btnAddVoucher")
						.Icon("plus")
						.OnClick("showLedgerAccountPopup")
						)

			<!-- DevExtreme Popup -->
			@(Html.DevExtreme().Popup()
						.ID("ledgerAccountPopup")
						.Width("93%")
						.Height("85%")
						.Title("Add Ledger Account")
						.ShowTitle(true)
						.CloseOnOutsideClick(true)
						.Visible(false)
						.ResizeEnabled(true)
						.ContentTemplate(@<text>
				<div id="popupContent" class="background" style="width:100%; height:100%;">
					<iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
				</div>
			</text>)
						)

		</div>
		<div class="col-md-1" style="margin-top: 67px;padding-left:0px;padding-right:0px;width: 4%;">
			@* 			@(Html.DevExtreme().Button()
								.ID("btnEditVoucher")
								.Icon("edit")
								) *@
			@(Html.DevExtreme().Button()
						.ID("btnEditVoucher")
						.Icon("edit")
						.OnClick("showLedgerAccountEditPopup")
						)

			@(Html.DevExtreme().Popup()
						.ID("ledgerEditAccountPopup")
						.Width("93%")
						.Height("85%")
						.Title("Edit Ledger Account")
						.ShowTitle(true)
						.CloseOnOutsideClick(true)
						.Visible(false)  // Hidden by default
						.ResizeEnabled(true)
						.ContentTemplate(@<text>
				<div id="popupContent" style="width:100%; height:100%;">
					<iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
				</div>
			</text>)
						)
		</div>
		<div class="col-md-3">
			<div class="form-group">
				@(Html.DevExtreme().DateBox()
								.Label(new JS("formatMessage('Due Date or Payment Terms')"))
								.ID("InvoiceDueDate")
								.InputAttr("aria-label", "Date")
								.LabelMode(EditorLabelMode.Outside)
								.Type(DateBoxType.Date)
								.DisplayFormat("dd-MMM-yyyy")
								.Value(DateTime.Now)
								)
			</div>
		</div>
		<div class="col-md-2">
			<div class="form-group">
				<div style="display:flex;">
					@(Html.DevExtreme().NumberBox()
												.Label(new JS("formatMessage('No. Of Days')"))
												.LabelMode(EditorLabelMode.Outside)
												.ID("InvoiceNoOfDays")
												.Value(0)
												.ShowSpinButtons(true)
												.Min(0)
												.Max(1000)
												.Step(1)
												.OnValueChanged("onDaysChange")
												)
					<label id="Days" class="no-border-input" style="margin-top:10px;" for="InvoiceNoOfDays"></label>
				</div>
			</div>
		</div>
	</div>




	<div class="dx-fieldset horizontal-container" style="margin-top:15px;margin-bottom:0px;">
		<div class="form-group">
			<div class="button-alignment-down">
			</div>
			@(
						Html.DevExtreme().SelectBox()
						.Label(new JS("formatMessage('Dr/Cr')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("sbDrCr")
						.DataSource(new[] { "Dr", "Cr" })
						.Value("Cr")
						.Placeholder(new JS("formatMessage('Select Transaction Type')"))
						.Width(90)
						)
		</div>
		<div class="form-group">
			@(Html.DevExtreme().DropDownBox()
						.Label(new JS("formatMessage('Account Head')"))
						.DataSource(d => d.WebApi()
						.Controller("SalesVoucher")
						.LoadAction("GetAccountHead")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("AccountHead")
						)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message(new JS("formatMessage('Ledger Account should be entered')"));
						})
						.LabelMode(EditorLabelMode.Outside)
						.ID("ddAccountHead")
						.ShowClearButton(true)
						.AcceptCustomValue(true)
						.AcceptCustomValue(false)
						.OpenOnFieldClick(false)
						.ValueChangeEvent("input")
						.HoverStateEnabled(true)
						.ValueExpr("AccountId")
						.DisplayExpr("AccountHead")
						.OnInput("dropDownBoxOnInput")
						.OnOpened("onOpened")
						.Width(315)
						.TabIndex(1)
						.DropDownOptions(o => o
						.Width(1000)
						)
						.OnKeyDown("onKeyDown")
						//.OnValueChanged("dropDownBoxValueChanged")
						.ContentTemplate(new TemplateName("AccountHeadContentTemplate"))
						)
		</div>
		<div class="form-group" style="margin-top:25px;">
			@* 	@(Html.DevExtreme().Button()
								.ID("btnAddAHead")
								.Icon("plus")
								.OnClick("navigateToLedger")
								) *@

			@(Html.DevExtreme().Button()
						.ID("btnAddAHead")
						.Icon("plus")
						.OnClick("showLedgerAccountPopup")
						)

			<!-- DevExtreme Popup -->
			@(Html.DevExtreme().Popup()
						.ID("ledgerAccountPopup")
						.Width("93%")
						.Height("85%")
						.Title("Add Ledger Account")
						.ShowTitle(true)
						.CloseOnOutsideClick(true)
						.Visible(false)
						.ResizeEnabled(true)
						.ContentTemplate(@<text>
				<div id="popupContent" class="background" style="width:100%; height:100%;">
					<iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
				</div>
			</text>)
						)
		</div>
		<div class="form-group" style="margin-top:25px;">
			@* 	@(Html.DevExtreme().Button()
								.ID("btnEditAHead")
								.Icon("edit")
								) *@
			@(Html.DevExtreme().Button()
						.ID("btnEditAHead")
						.Icon("edit")
						.OnClick("showLedgerAccountHeadEditPopup")
						)

			@(Html.DevExtreme().Popup()
						.ID("ledgerEditAccountPopup")
						.Width("93%")
						.Height("85%")
						.Title("Edit Ledger Account")
						.ShowTitle(true)
						.CloseOnOutsideClick(true)
						.Visible(false)  // Hidden by default
						.ResizeEnabled(true)
						.ContentTemplate(@<text>
				<div id="popupContent" style="width:100%; height:100%;">
					<iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
				</div>
			</text>)
						)
		</div>
		<div class="form-group">

			@(
						Html.DevExtreme().NumberBox()
						.Label(new JS("formatMessage('Amount')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("txtVoucherAmount")
						.Value(0.00)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message("Amount cannot be empty");

							rules.AddCustom()
							.ValidationCallback("validateAmount")
							.Message("Amount value must be greater than zero");
						})
						.Min(0)
						.Placeholder("0.00")
						.Format("#,##0.00")
						.InputAttr(new
						{
							style = "font-family: Inter; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
							type = "number",
							step = "0.01"
						})

						)
		</div>
		<div class="form-group">
			@(Html.DevExtreme().DropDownBox()
						.Label("Base Currency")
						.DataSource(d => d.WebApi()
						.Controller("Utility") // Use same controller or change if needed
						.LoadAction("GetCurrencyList")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("CurrencyID")
						)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message("Please select a base currency.");
						})
						.LabelMode(EditorLabelMode.Outside)
						.ID("ddlBaseCurrency")
						.ShowClearButton(true)
						.AcceptCustomValue(false)
						.OpenOnFieldClick(true)
						.Value(1) // Change default value if needed
						.ValueExpr("CurrencyID")
						.DisplayExpr("CurrencyName")
						.OnInput("dropDownBoxOnInput") // Reuse or define separate handler if needed
						.OnOpened("onOpened")
						.Width(160)
						.TabIndex(2) // Different tabindex to separate from the first
						.DropDownOptions(o => o.Width(700))
						.OnKeyDown("onKeyDown")
						//.OnValueChanged("dropDownBoxValueChanged") // Optional
						.ContentTemplate(new TemplateName("BaseCurrencyContentTemplate"))
						)
		</div>

		@using (Html.DevExtreme().NamedTemplate("BaseCurrencyContentTemplate"))
		{
			@(Html.DevExtreme().DataGrid()
					.ID("basecurrency-datagrid")
					.DataSource(d => d.WebApi()
					.Controller("Utility")
					.LoadAction("GetCurrencyList")
					.LoadMode(DataSourceLoadMode.Raw)
					.Key("CurrencyID")
					)
					.WordWrapEnabled(true)
					.ShowBorders(true)
					.Selection(sl => sl.Mode(SelectionMode.Single))
					.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
					.SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
					.OnSelectionChanged("onBaseCurrencySelectionChanged") // Define this JS function
					.Paging(p => p.PageSize(10))
					.Height(300)
					.Columns(columns =>
					{
						columns.Add().DataField("CurrencyID").Caption("ID").Visible(false);
						columns.Add().DataField("CurrencyName").Caption("Currency Name");
						columns.Add().DataField("CurrencySymbol").Caption("Symbol");
						columns.Add().DataField("CurrencyUnicode").Caption("Unicode");
						columns.Add().DataField("IsDefault").Caption("Default").DataType(GridColumnDataType.Boolean);
					})
					)
		}

		<div class="form-group">
			@(Html.DevExtreme().DropDownBox()
						.Label("Exchange Currency")
						.DataSource(d => d.WebApi()
						.Controller("Utility") // Adjust if needed
						.LoadAction("GetCurrencyList")
						.LoadMode(DataSourceLoadMode.Raw)
						.Key("CurrencyID")
						)
						.ValidationRules(rules =>
						{
							rules.AddRequired()
							.Message("Please select a currency.");
						})
						.LabelMode(EditorLabelMode.Outside)
						.ID("ddCurrency")
						.ShowClearButton(true)
						.AcceptCustomValue(false)
						.OpenOnFieldClick(true)
						.Value(1)
						.ValueExpr("CurrencyID")
						.DisplayExpr("CurrencyName")
						.OnInput("dropDownBoxOnInput")
						.OnOpened("onOpened")
						.Width(160)
						.TabIndex(1)
						.DropDownOptions(o => o.Width(700))
						.OnKeyDown("onKeyDown")
						//.OnValueChanged("dropDownBoxValueChanged")
						.ContentTemplate(new TemplateName("CurrencyContentTemplate"))
						)
		</div>
		<div class="form-group">
			@(Html.DevExtreme().TextBox()
						.Label("Currency Rate")
						.LabelMode(EditorLabelMode.Outside)
						.ID("txtCurrencyRate")
						.Value("0.00")
						//  .ReadOnly(true) // Make it read-only
						.Width(160)
						)
		</div>
		@using (Html.DevExtreme().NamedTemplate("CurrencyContentTemplate"))
		{
			@(Html.DevExtreme().DataGrid()
					.ID("currency-datagrid")
					.DataSource(d => d.WebApi()
					.Controller("Utility")
					.LoadAction("GetCurrencyList")
					.LoadMode(DataSourceLoadMode.Raw)
					.Key("CurrencyID")
					)
					.WordWrapEnabled(true)
					.ShowBorders(true)
					.Selection(sl => sl.Mode(SelectionMode.Single))
					.SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
					.SearchPanel(sp => sp.HighlightSearchText(true).Visible(true))
					.OnSelectionChanged("onCurrencySelectionChanged")
					.Paging(p => p.PageSize(10))
					.Height(300)
					.Columns(columns =>
					{
						columns.Add().DataField("CurrencyID").Caption("ID").Visible(false);
						columns.Add().DataField("CurrencyName").Caption("Currency Name");
						columns.Add().DataField("CurrencySymbol").Caption("Symbol");
						columns.Add().DataField("CurrencyUnicode").Caption("Unicode");
						columns.Add().DataField("IsDefault").Caption("Default").DataType(GridColumnDataType.Boolean);
					})
					)
		}
	</div>
	<div class="dx-fieldset horizontal-container" style="margin-top:0px;margin-bottom:0px;padding-top:15px;padding-bottom:30px">
		<div class="form-group">
		</div>
		<div class="form-group">
			@(
						Html.DevExtreme().TextArea()
						.Label(new JS("formatMessage('Narration')"))
						.LabelMode(EditorLabelMode.Outside)
						.ID("txtEntryNarration")
						.Value("")
						.Height(40)
						.Width(720)
						.Placeholder(new JS("formatMessage('Enter your comments here...')"))
						.MaxLength(500)
						)
		</div>
		<div class="form-group" style="margin-top:25px;">
			@(Html.DevExtreme().Button()
						.ID("btnVoucherEntry")
						.Text(new JS("formatMessage('ADD')"))
						.Height(40)
						.Width(178)
						.Icon("plus")
						.OnClick("function() { addVoucherEntry(); }")
						)
		</div>
	</div>


	<div class="dx-field ledgerResult">
		@(
				Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201VoucherEntryScreenDisplay>()
				.ID("dataGrid")
				.RemoteOperations(false)
				.Columns(columns =>
				{
					columns.AddFor(m => m.DrCr).Caption(new JS("formatMessage('Dr/Cr')"));
						columns.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('Account Head')"))
					.CellTemplate(@<text>
			<div style="display: flex; justify-content: space-between; align-items: center;">
				<span>
					<%- data.AccountHead ? data.AccountHead : "No Selection" %>
				</span>
			</div>
		</text>)
				.EditCellTemplate(@<text>


			@(Html.DevExtreme().DropDownBox()
			.DataSource(d => d.WebApi()
			.Controller("VoucherMaster")
			.LoadAction("GetEditAccountHead")
			.LoadMode(DataSourceLoadMode.Raw)
			.Key("AccountId")
			)
			.LabelMode(EditorLabelMode.Outside)
			.ID("accountDropDownBoxEdit")
			.ShowClearButton(true)
			.AcceptCustomValue(false)
			.AcceptCustomValue(true)
			.OpenOnFieldClick(false)
			.ValueChangeEvent("change")
			.HoverStateEnabled(true)
			.Value(new JS("data.AccountHead"))
			.ValueExpr("AccountId")
			.DisplayExpr("AccountHead")
			.OnValueChanged("gridpurchase_valueChanged")
			.OnOpened("onOpened")
                @* .Width(250) *@
			.TabIndex(1)
			.DropDownOptions(o => o.Width(500))
			.OnKeyDown("onKeyDown")
			.ContentTemplate(new TemplateName("AccountHeadEditDropdownContentTemplate"))
			)


		</text>);

					columns.AddFor(m => m.DrAmount)
					.Caption(new JS("formatMessage('Debit')"))
					.Alignment(HorizontalAlignment.Right)
					.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }").AllowEditing(false);
					columns.AddFor(m => m.CrAmount)
					.Caption(new JS("formatMessage('Credit')"))
					.Alignment(HorizontalAlignment.Right)
					.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }").AllowEditing(false);
					columns.AddFor(m => m.EntryNarration).Caption(new JS("formatMessage('Entry Narration')"));
					columns.AddFor(m => m.SysRemarks).Caption(new JS("formatMessage('Remarks')"));
					columns.AddFor(m => m.VoucherEntryNo).Caption(new JS("formatMessage('Voucher Entry No')")).Visible(false);
				})
				.Selection(selection => selection.Mode(SelectionMode.Single))
				.AllowColumnReordering(true)
				.AllowColumnResizing(true)
				.ColumnFixing(fixing => fixing.Enabled(true))
				.HeaderFilter(filter => filter.Visible(true))
				.Height(250)
				.ColumnAutoWidth(true)
				.FilterRow(filterRow => filterRow.Visible(false))
				.GroupPanel(groupPanel => groupPanel.Visible(false))
				.ShowBorders(true)
				.Width("100%")
				.OnEditorPreparing("onEditorPreparing")
				.OnRowUpdating("onRowUpdating")
				.OnRowRemoving("onRowRemoving")
				.OnRowPrepared(@"function(e) {
		if (e.rowType === 'data' && e.data.DrCr === 'Cr') {
		$(e.rowElement).css('background-color', 'lightgray');
		}
		}")
				.Editing(editing => editing
				.Mode(GridEditMode.Cell)
				.AllowUpdating(true)
				.AllowDeleting(true)
				.UseIcons(true)
				)
				.Summary(summary =>
				{
					summary.TotalItems(totalItems =>
					{

						totalItems.Add().Column("Debit").SummaryType(SummaryType.Sum)
					.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

						totalItems.Add().Column("Credit").SummaryType(SummaryType.Sum)
					.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
					});
				})
				)
	</div>




	<!-- Context Menu for Actions -->
	<ul id="contextMenu" class="context-menu" style="display: none;">
		<li onclick="editCostAllocation()">
