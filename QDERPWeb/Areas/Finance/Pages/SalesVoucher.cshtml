			var ClientNameValidator = $("#ClientNameDropDown").dxValidator("instance");
			var voucherAmtValidator = $("#txtVoucherAmount").dxValidator("instance");

			// Manually validate if the fields are not empty
			var isValid = true;

			if (!voucherNo.option("value")) {
				alert("Please enter Sales No.");
				isValid = false;
			}

			if (!ClientName.option("value")) {
				alert("Please select Client Name.");
				isValid = false;
			}

			if (!accountHead.option("value")) {
				alert("Please select Account Head.");
				isValid = false;
			}

			if (!txtVoucherAmt.option("value") || txtVoucherAmt.option("value") <= 0) {
				alert("Please enter a valid Amount.");
				isValid = false;
			}

			if (isValid) {
				var paymentaccheadname = accountHead.option("text"); // Assuming this gets the display text
				var accheadname = ClientName.option("text"); // Assuming this gets the display text

				var sysRemarks1 = accheadname ? `Invoiced To : ${accheadname}` : "";
				var sysRemarks2 = paymentaccheadname || "";

				var VE1 = {
					"VoucherNo": voucherNo.option("value"),
					"AccountHead": accountHead.option("value"),
					"VoucherAmount": txtVoucherAmt.option("value"),
					"DrCr": $("#sbDrCr").dxSelectBox("instance").option("value"),
					"AddedBy": "102",
					"AddedOn": new Date(),
					"EntryNarration": $("#txtEntryNarration").dxTextArea("instance").option("value"),
					"SysRemarks": sysRemarks1
				};

				var VE2 = {
					"VoucherNo": voucherNo.option("value"),
					"AccountHead": ClientName.option("value"),
					"VoucherAmount": txtVoucherAmt.option("value"),
					"DrCr": ($("#sbDrCr").dxSelectBox("instance").option("value") === "Cr" ? "Dr" : "Cr"),
					"AddedBy": "102",
					"AddedOn": new Date(),
					"EntryNarration": $("#txtEntryNarration").dxTextArea("instance").option("value"),
					"SysRemarks": sysRemarks2
				};

				// Send the first entry
				$.ajax({
					type: "POST",
					url: "/api/SalesVoucher/AddVoucherEntry",
					contentType: "application/json",
					data: JSON.stringify(VE1),
					dataType: "json",
					success: function (response) {
						$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

						// Clear AccountHead and VoucherAmount after successful response
						accountHead.option("value", null); // Clear AccountHead
						txtVoucherAmt.option("value", null); // Clear VoucherAmount

						// Reset validation states
						accountHeadValidator.reset();
						voucherAmtValidator.reset();
					},
					error: function (xhr, status, error) {
						alert("Error occurred while updating data: " + error);
					}
				});

				// Send the second entry
				$.ajax({
					type: "POST",
					url: "/api/SalesVoucher/AddVoucherEntry",
					contentType: "application/json",
					data: JSON.stringify(VE2),
					dataType: "json",
					success: function (response) {
						$("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

						// Clear AccountHead and VoucherAmount again
						accountHead.option("value", null); // Clear AccountHead
						txtVoucherAmt.option("value", null); // Clear VoucherAmount

						// Reset validation states
						accountHeadValidator.reset();
						voucherAmtValidator.reset();
					},
					error: function (xhr, status, error) {
						alert("Error occurred while updating data: " + error);
					}
				});
			}
		}


