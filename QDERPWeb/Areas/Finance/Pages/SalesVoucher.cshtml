		function onDaysChange(e) {
			var daysToAdd = e.value;
			var dueDateBox = $("#InvoiceDueDate").dxDateBox("instance");
			var currentDate = new Date();


			var newDueDate = new Date(currentDate);
			newDueDate.setDate(newDueDate.getDate() + daysToAdd);


			dueDateBox.option("value", newDueDate);
		}


		function updateDueDate() {
			// Get checkbox value and "No of Days"
			const useSubmittedDate = $("#UseSubmittedDate").dxCheckBox("instance").option("value");
			const noOfDays = $("#InvoiceNoOfDays").dxNumberBox("instance").option("value");

			// Determine the base date (Submitted Date or Voucher Date)
			const baseDate = useSubmittedDate
				? $("#InvoiceSubmittedDate").dxDateBox("instance").option("value")
				: $("#VoucherDate").dxDateBox("instance").option("value");

			// Validate the base date
			if (!baseDate) {
				//alert("Please select a valid base date!");
				return;
			}

			// Calculate the Due Date
			const calculatedDate = new Date(baseDate);
			calculatedDate.setDate(calculatedDate.getDate() + noOfDays);

			// Update Due Date
			$("#InvoiceDueDate").dxDateBox("instance").option("value", calculatedDate);
		}

		function onDateChange() {
			// Get Voucher Date and Due Date
			const voucherDate = new Date($("#VoucherDate").dxDateBox("instance").option("value"));
			const dueDate = new Date($("#InvoiceDueDate").dxDateBox("instance").option("value"));

			// Validate that Due Date is not earlier than Voucher Date
			if (dueDate < voucherDate) {
				alert("Due Date cannot be earlier than Voucher Date.");
				$("#InvoiceDueDate").dxDateBox("instance").option("value", voucherDate); // Reset Due Date to Voucher Date
				return;
			}

			// Calculate the difference in days and update "No of Days"
			const diffTime = dueDate - voucherDate;
			const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
			$("#InvoiceNoOfDays").dxNumberBox("instance").option("value", diffDays);
		}

		// Initialize the event handlers
		$(function () {
			$("#InvoiceSubmittedDate").dxDateBox({
				onValueChanged: updateDueDate, // Recalculate Due Date on change
			});

			$("#VoucherDate").dxDateBox({
				onValueChanged: updateDueDate, // Recalculate Due Date on change
			});

			$("#InvoiceNoOfDays").dxNumberBox({
				onValueChanged: function () {
					const noOfDays = $("#InvoiceNoOfDays").dxNumberBox("instance").option("value");
					const useSubmittedDate = $("#UseSubmittedDate").dxCheckBox("instance").option("value");

					const baseDate = useSubmittedDate
						? $("#InvoiceSubmittedDate").dxDateBox("instance").option("value")
						: $("#VoucherDate").dxDateBox("instance").option("value");

					if (baseDate) {
						const calculatedDate = new Date(baseDate);
						calculatedDate.setDate(calculatedDate.getDate() + noOfDays);
						$("#InvoiceDueDate").dxDateBox("instance").option("value", calculatedDate);
					}
				},
			});

			$("#UseSubmittedDate").dxCheckBox({
				value: true, // Default: Checked
				onValueChanged: function () {
					updateDueDate(); // Recalculate Due Date when checkbox is toggled
				},
			});
		});



