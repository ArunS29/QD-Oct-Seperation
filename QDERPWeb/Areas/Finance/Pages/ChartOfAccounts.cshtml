        function onCellPrepared(e) {
        if (e.rowType === "data" && e.column.dataField === "AccountHead") {
            if (!e.data.IsLedgerObselete) {
                e.cellElement.css({
                    "background-color": "white",
                    "color": "green",
                    "font-weight": "bold"
                });
            } else {
                e.cellElement.css({
                    "background-color": "red",
                    "color": "white",
                    "background-color": "white",
                    "color": "#ef5353",
                    "font-weight": "bold"

                });
            }
        }
    }
</script>
