        }

        .context-menu-item:hover {
            background-color: #f1f1f1;
        }

    .popup-message {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #4CAF50; /* Success green color */
        color: white;
        padding: 20px 30px;
        border-radius: 10px;
        font-size: 16px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        z-index: 1001;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

</style>

