@page
<style>
    .content-container {
        background-color: #c0dceb;
        border-radius: 10px;
        padding: 5px;
    }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        border-radius: 5px;
    }

    .context-menu-item {
        padding: 10px 15px;
        cursor: pointer;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

        .context-menu-item i {
            margin-right: 10px; /* Space for the icon */
        }

        .context-menu-item:hover {
            background-color: #f1f1f1;
        }

    .popup-message {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #4CAF50; /* Success green color */
        color: white;
        padding: 20px 30px;
        border-radius: 10px;
        font-size: 16px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        z-index: 1001;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

 
</style>

<input id="formId" value="uc20101ChartOfAccounts" type="hidden" />
<div class="content-container-top">
   <div style="color:black; font-weight: bold;  width: 100%;font-size:20px;">
    Chart Of Accounts
</div>
<div id="popupContainer"></div>

    <div class="dx-field chartOfAccount">
        @(
                Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry20107ChartOfAccount>()
                .ID("dataGrid")
                .DataSource(d => d.WebApi()
                .Controller("ChartOfAccounts")
                .LoadAction("GetChartOfAccounts")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("AccountId"))
                .RemoteOperations(false)
                .ShowBorders(true)
                .Columns(columns =>
                {
           
          columns.AddFor(m => m.AccountId).Caption("Account ID").Alignment(HorizontalAlignment.Center).Visible(true).CellTemplate(@<text>
    <a href="javascript:void(0);" onclick="openPopup('<%-data.AccountId%>')">
        <%-data.AccountId%>
    </a>
</text>);

                    columns.AddFor(m => m.AccountHead).Caption("Account Head").Alignment(HorizontalAlignment.Center).Visible(true);
                    columns.AddFor(m => m.MasterGroup).Caption("Account Master").Alignment(HorizontalAlignment.Center).GroupIndex(0);
                    columns.AddFor(m => m.AccountHeadArabic).Caption("Account Head (Ar)").Alignment(HorizontalAlignment.Right).Visible(true);
                    columns.AddFor(m => m.AccountGroup).Caption("Account Group").Alignment(HorizontalAlignment.Center).GroupIndex(1);
                    columns.AddFor(m => m.AccountGroup).Caption("Account Group").Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.OpeningBalance).Caption("Opening Balance").Alignment(HorizontalAlignment.Right).Visible(true).CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        let positiveValue = Math.abs(e.value); // Ensure positive values
        return positiveValue.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }");
                    columns.AddFor(m => m.OpeningBalanceDrCr).Caption("Dr/Cr").Alignment(HorizontalAlignment.Center).Visible(true);
                    columns.AddFor(m => m.IsLedgerObselete).Caption("Is Ledger Obsolete").Alignment(HorizontalAlignment.Center)
                .CellTemplate(@<text>
            <div class="dx-icon">
                <%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
            </div>
        </text>)
            .Visible(true);
                })
            .Height(500)
            .Paging(p => p.PageSize(10))
            .ColumnAutoWidth(true)
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnFixing(fixing => fixing.Enabled(true))
            .FilterRow(filterRow => filterRow.Visible(false))
            .GroupPanel(groupPanel => groupPanel.Visible(false))
            .ColumnChooser(c => c.Enabled(true).Title("Show/Hide Column").Mode(GridColumnChooserMode.Select))
            .HeaderFilter(hf => hf.Visible(true))
            .OnCellPrepared("onCellPrepared")
            )
    </div>
    <div>
        @await Html.PartialAsync("_chartofaccounts")
    </div>
</div>

<!-- Context Menu (hidden initially) -->
<div id="contextMenu" class="context-menu">
    <div class="context-menu-item" onclick="editLedger()">
        <i class="fa fa-edit"></i> Edit Ledger Account
    </div>
    <div class="context-menu-item" onclick="viewTransactions()">
        <i class="fa fa-search"></i> View Ledger Transactions
    </div>
    <div class="context-menu-item" onclick="deleteLedger()">
        <i class="fa fa-trash"></i> Delete Ledger Account
    </div>
</div>

<script type="text/javascript">
function openPopup(accountId) {
    $("#popupContainer").dxPopup({
        contentTemplate: function(contentElement) {
            $("<iframe>")
                .attr("src", "/Finance/LedgerAccount?AccountId=" + accountId)
                .css({ width: "100%", height: "500px", border: "none" })
                .appendTo(contentElement);
        },
        width: 1200,
        height: 600,
        title: "Ledger Account Details",
        showCloseButton: true,  // ✅ Displays the (X) close button
        visible: true,
        closeOnOutsideClick: true,  // ✅ Allows closing when clicking outside the popup
        onHiding: function() { 
            $("#popupContainer").dxPopup("instance").dispose(); // ✅ Cleanup
        }
    }).dxPopup("instance").show();
}




    $(function () {
        var contextMenu = $("#contextMenu");

        // Hide context menu when clicking outside
        $(document).on("click", function () {
            contextMenu.hide();
        });

        // Right-click event to show context menu
        $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
            e.preventDefault();

            // Get instance of the DataGrid
            var dataGridInstance = $("#dataGrid").dxDataGrid("instance");
            var visibleRows = dataGridInstance.getVisibleRows(); // Retrieve visible rows
            var rowIndex = $(this).index();

            // Debugging: Ensure rowIndex is correct
            console.log("Row Index:", rowIndex);

            var rowData = visibleRows[rowIndex]?.data; // Retrieve the row data from visible rows
            console.log("Row Data:", rowData); // Debugging: Log the row data

            if (rowData && rowData.AccountId) {
                window.selectedRowData = rowData; // Store selected row data for use in actions
                contextMenu.css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
            } else {
                alert("Error: AccountId is undefined. Please select a valid row.");
            }
        });
    });
    // Function to handle Edit Ledger Account action
    function editLedger() {
        var rowData = window.selectedRowData;
        if (rowData && rowData.AccountId) {   
            // Navigate to frm201LedgerAccount with Edit mode
           // window.location.href = `/frm201LedgerAccount?mode=edit&accountId=${rowData.AccountId}`;
             window.location.href = `/Finance/LedgerAccount?AccountId=${selectedRowData.AccountId}&IsDisabled=${encodeURIComponent(selectedRowData.IsDisabled)}`;
        } else {
            alert("No valid row selected for editing.");
        }
    }

    // Function to handle View Ledger Transactions action
    function viewTransactions() {
        var rowData = window.selectedRowData;
        if (rowData && rowData.AccountId) {
            // Navigate to frm201LedgerAccount with View Transactions mode
          window.location.href = `/Finance/AccountingLedgers?AccountId=${selectedRowData.AccountId}&IsDisabled=${encodeURIComponent(selectedRowData.IsDisabled)}`;

           // window.location.href = `/frm201LedgerAccount?mode=view&accountId=${rowData.AccountId}`;
        } else {
            alert("No valid row selected to view transactions.");
        }
    }

    $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault();
        var rowIndex = $(this).index();
        var rowData = $("#dataGrid").dxDataGrid("instance").getDataSource().items()[rowIndex];
        window.selectedRowData = rowData;
    });

    function deleteLedger() {
        var rowData = window.selectedRowData;
        if (rowData && rowData.AccountId) {
            // Correct API endpoint URL
            var deleteUrl = `/api/ChartOfAccounts/Delete?accountId=${rowData.AccountId}`;

            console.log("Delete URL:", deleteUrl);

            // Confirmation dialog
            if (confirm("You are about to delete the Ledger Account from the database")) {
                $.ajax({
                    url: deleteUrl,
                    type: 'POST', // Ensure the correct HTTP method
                    success: function (response) {
                        if (response.success) {
                            alert(response.message || "Ledger Account deleted successfully.");
                            $("#dataGrid").dxDataGrid("instance").refresh(); // Refresh the grid
                        } else {
                            alert(response.message || "Error deleting ledger account.");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error deleting ledger account:", error);
                        var errorMessage = xhr.responseJSON?.message || "An unexpected error occurred.";
                        alert(errorMessage);
                    }
                });
            }
        } else {
            alert("Error: AccountId is undefined. Please select a valid row.");
        }
    }


    function onCellPrepared(e) {
        if (e.rowType === "data" && e.column.dataField === "AccountHead") {
            if (!e.data.IsLedgerObselete) {
                e.cellElement.css({
                    "background-color": "red",
                    "color": "white"
                });
            }
        }
    }
</script>
