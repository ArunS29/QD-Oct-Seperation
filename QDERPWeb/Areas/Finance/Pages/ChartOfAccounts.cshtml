        padding: 5px;
    }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        border-radius: 5px;
    }

    .context-menu-item {
        padding: 10px 15px;
        cursor: pointer;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

        .context-menu-item i {
