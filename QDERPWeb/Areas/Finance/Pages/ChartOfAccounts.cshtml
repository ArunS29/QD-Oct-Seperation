<style>
    .content-container {
        background-color: #c0dceb;
        border-radius: 10px;
        padding: 5px;
    }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        border-radius: 5px;
    }

    .context-menu-item {
        padding: 10px 15px;
        cursor: pointer;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

        .context-menu-item i {
            margin-right: 10px; /* Space for the icon */
        }

        .context-menu-item:hover {
            background-color: #f1f1f1;
        }

    .popup-message {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #4CAF50; /* Success green color */
        color: white;
        padding: 20px 30px;
        border-radius: 10px;
        font-size: 16px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        z-index: 1001;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

</style>

