            .Paging(p=>p.PageSize(10))
            .ColumnAutoWidth(true)
            .AllowColumnReordering(true) // Enable column reordering
            .AllowColumnResizing(true)   // Enable column resizing
            .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
            .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
            .GroupPanel(groupPanel => groupPanel.Visible(true)) // Display group panel
            .ColumnChooser(c => c.Enabled(true).Title("Show/Hide Column").Mode(GridColumnChooserMode.Select))
            //.Paging(paging => paging.Enabled(false))
            .HeaderFilter(hf => hf
            .Visible(true)  // Display header filters for each column
            )
            .ShowBorders(true)
            .Summary(s => s
            .TotalItems(totalItems =>
            {
                totalItems.AddFor(m => m.AccountId).SummaryType(SummaryType.Count);
            }))
            )
