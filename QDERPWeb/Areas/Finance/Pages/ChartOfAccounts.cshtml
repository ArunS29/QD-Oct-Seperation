<script type="text/javascript">


    // Initialize the Ledger Account Popup
    $("#ledgerAccountPopup").dxPopup({
        width: 1200,
        height: 600,
        title: "Ledger Account Details",
        showCloseButton: true,  // Show close button
        visible: false,  // Initially hidden
        closeOnOutsideClick: true,  // Allow closing when clicking outside
        onHiding: function () {
            // Trigger DataGrid refresh when the popup is closed
            var dataGrid = $("#dataGrid").dxDataGrid("instance");
            dataGrid.refresh(); // Refresh the DataGrid
        }
    });

    // Initialize the Error Popup
    $("#errorPopup").dxPopup({
        width: 350,
        height: 300,
        title: "⚠ Error",
        visible: false,  // Initially hidden
        showCloseButton: true,  // Show close button
        dragEnabled: false,  // Disable dragging for the popup
        closeOnOutsideClick: true  // Allow closing when clicking outside
    });

    // Initialize the close button for the error popup
    $("#errorCloseBtn").dxButton({
        text: "Close",  // Button text
        type: "danger",  // Button style type
        onClick: function () {
            // Hide the error popup when the close button is clicked
            $("#errorPopup").dxPopup("instance").hide();
            // Trigger DataGrid refresh after closing the popup
            var dataGrid = $("#dataGrid").dxDataGrid("instance");
            dataGrid.refresh(); // Refresh the DataGrid
        }
    });

    // Function to show Ledger Account popup
    function showLedgerAccountPopup() {
        var popup = $("#ledgerAccountPopup").dxPopup("instance");
        popup.show();

        // Set the iframe src to the Ledger Account URL
   
        $("#ledgerAccountFrame").attr("src", `/${tenantName}/Finance/LedgerAccount`);
   
            $("#ledgerAccountFrame").attr("src", `/${tenantName}/Finance/LedgerAccount`);

            // Close and refresh the DataGrid when the popup is closed
            popup.option("onHiding", function () {
                var dataGrid = $("#dataGrid").dxDataGrid("instance");
                dataGrid.refresh(); // Refresh the DataGrid
            });
    
    }

    // Call this function wherever you need to show the Ledger Account popup
    // Example: When a button is clicked, you can trigger the showLedgerAccountPopup()
    $("#btnAddNewAccount").on("click", function () {
        showLedgerAccountPopup();
    });





    $(function () {
        $("#EditLedgerAccount").dxTextBox({
            text: formatMessage("Edit Ledger Account"),
            readOnly: true

        });
    });
    $(function () {
        $("#ViewLedgerTransactions").dxTextBox({
            text: formatMessage("View Ledger Transactions"),
            readOnly: true

        });
    });
    $(function () {
        $("#DeleteLedgerAccount").dxTextBox({
            text: formatMessage("Delete Ledger Account"),
            readOnly: true

        });
    });
    $(function () {
        $("#ChartOfAccounts").dxTextBox({
            text: formatMessage("Chart Of Accounts"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }

        });
    });


    let IsCharOfAccounts = true; // Global variable origin Flag

    function openPopup(accountId) {
        $("#popupContainer").dxPopup({
            contentTemplate: function (contentElement) {
                // Construct URL with both AccountId and the global IsCharOfAccounts variable
                var url = `/${tenantName}/Finance/LedgerAccount?AccountId=` + accountId + "&IsCharOfAccounts=" + IsCharOfAccounts;

                $("<iframe>")
                    .attr("src", url)
                    .css({ width: "100%", height: "600px", border: "none" })
                    .appendTo(contentElement);
            },
            width: 1200,
            height: 600,
            title: "Ledger Account Details",
            showCloseButton: true,  // ✅ Displays the (X) close button
            visible: true,
            closeOnOutsideClick: true,  // ✅ Allows closing when clicking outside the popup
            onHiding: function () {
                $("#popupContainer").dxPopup("instance").dispose(); // ✅ Cleanup popup instance
                location.reload();  // ✅ Reloads the page after closing popup
            }
        }).dxPopup("instance").show();
    }


    $(function () {
        var contextMenu = $("#contextMenu");

        // Hide context menu when clicking outside
        $(document).on("click", function () {
            contextMenu.hide();
        });

        // Right-click event to show context menu
        $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
            e.preventDefault();

            // Get instance of the DataGrid
            var dataGridInstance = $("#dataGrid").dxDataGrid("instance");
            var visibleRows = dataGridInstance.getVisibleRows(); // Retrieve visible rows
            var rowIndex = $(this).index();

            // Debugging: Ensure rowIndex is correct
            console.log("Row Index:", rowIndex);

            var rowData = visibleRows[rowIndex]?.data; // Retrieve the row data from visible rows
            console.log("Row Data:", rowData); // Debugging: Log the row data

            if (rowData && rowData.AccountId) {
                window.selectedRowData = rowData; // Store selected row data for use in actions
                contextMenu.css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
            } else {
                alert("Error: AccountId is undefined. Please select a valid row.");
            }
        });
    });
    // Function to handle Edit Ledger Account action
    function editLedger() {
        var rowData = window.selectedRowData;
        if (rowData && rowData.AccountId) {
            // Open the popup with the selected AccountId
            openPopup(rowData.AccountId);
            //window.location.href = `/Finance/LedgerAccount?AccountId=${selectedRowData.AccountId}&IsDisabled=${encodeURIComponent(selectedRowData.IsDisabled)}`;
        } else {
            alert("No valid row selected for editing.");
        }
    }

    // Function to handle View Ledger Transactions action
    function viewTransactions() {
        var rowData = window.selectedRowData;
        if (rowData && rowData.AccountId) {
            // Navigate to frm201LedgerAccount with View Transactions mode
            window.location.href = `/${tenantName}/Finance/AccountingLedgers?AccountId=${selectedRowData.AccountId}&IsDisabled=${encodeURIComponent(selectedRowData.IsDisabled)}`;

            // window.location.href = `/frm201LedgerAccount?mode=view&accountId=${rowData.AccountId}`;
        } else {
            alert("No valid row selected to view transactions.");
        }
    }

    $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault();
        var rowIndex = $(this).index();
        var rowData = $("#dataGrid").dxDataGrid("instance").getDataSource().items()[rowIndex];
        window.selectedRowData = rowData;
    });

    function deleteLedger() {
        var rowData = window.selectedRowData;
        if (rowData && rowData.AccountId) {
            // Correct API endpoint URL
            var deleteUrl = `/api/ChartOfAccounts/Delete?accountId=${rowData.AccountId}`;

            console.log("Delete URL:", deleteUrl);

            // Confirmation dialog
            if (confirm("You are about to delete the Ledger Account from the database")) {
                $.ajax({
                    url: deleteUrl,
                    type: 'POST', // Ensure the correct HTTP method
                    success: function (response) {
                        if (response.success) {
                            alert(response.message || "Ledger Account deleted successfully.");
                            $("#dataGrid").dxDataGrid("instance").refresh(); // Refresh the grid
                        } else {
                            alert(response.message || "Error deleting ledger account.");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error deleting ledger account:", error);
                        var errorMessage = xhr.responseJSON?.message || "An unexpected error occurred.";
                        alert(errorMessage);
                    }
                });
            }
        } else {
            alert("Error: AccountId is undefined. Please select a valid row.");
        }
    }


