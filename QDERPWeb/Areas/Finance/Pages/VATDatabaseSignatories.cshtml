@page
@model QD.ERP.Web.Areas.Finance.Pages.VATDatabaseSignatoriesModel
@{
}
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
<style>

.signatory-form-container {
    background-color: #f5f9ff;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    margin-bottom: 20px;
}

.form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    gap: 16px;
}

.form-row input,
.form-row .dx-textbox,
.form-row .dx-selectbox {
    flex: 1;
}

.image-upload-row {
    align-items: center;
    gap: 10px;
}

.signature-upload {
    border: 1px solid #ccc;
    padding: 8px;
    background-color: #fff;
}

</style>
<div class="signatory-form-container">
    <h3>Type a New Signatory & Add to the Existing List:</h3>
    
    <div class="form-row">
        @(Html.DevExtreme().TextBox().ID("SignatoryName").Label(new JS("formatMessage('Signatory Name')")).LabelMode(EditorLabelMode.Outside))
        @(Html.DevExtreme().TextBox().ID("SignatoryNameArabic").Label(new JS("formatMessage('Signatory Name (Arabic)')")).LabelMode(EditorLabelMode.Outside))
    </div>

    <div class="form-row">
        @(Html.DevExtreme().TextBox().ID("SignatoryPosition").Label(new JS("foramtMessage('Signatory Position')")).LabelMode(EditorLabelMode.Outside))
        @(Html.DevExtreme().TextBox().ID("SignatoryPositionArabic").Label(new JS("formatMessage('Signatory Position (Arabic)')")).LabelMode(EditorLabelMode.Outside))
    </div>

    <div class="form-row">
        @(Html.DevExtreme().TextBox().ID("SignatoryContact").Label(new JS("formatMessage('Signatory Contact No.')")).LabelMode(EditorLabelMode.Outside))
        @(Html.DevExtreme().TextBox().ID("SignatoryEmail").Label(new JS("formatMessage('Signatory Email')"))
        .LabelMode(EditorLabelMode.Outside))
    </div>

    <div class="form-row">
        @(Html.DevExtreme().SelectBox()
            .ID("SignatoryUserId")
           
            .DisplayExpr("UserName")
            .ValueExpr("Id")
            .Placeholder("Signatory User ID"))
    </div>

    <div class="form-row image-upload-row">
        <label>Add Signature Image here:</label>
        <input type="file" class="signature-upload" />
    </div>

    <div class="form-row">
        <button class="dx-button dx-button-success">Add</button>
    </div>
</div>

<hr />

@(Html.DevExtreme().DataGrid()
    .ID("SignatoryGrid")
    .ShowBorders(true)
   
    .Columns(columns => {
        columns.Add().DataField("SignatoryID").Caption("Signatory ID").Width(80);
        columns.Add().DataField("SignatoryName").Caption("Signatory Name");
        columns.Add().DataField("SignatoryPosition").Caption("Signatory Position");
        columns.Add().DataField("SignatoryContact").Caption("Signatory Contact");
        columns.Add().DataField("SignatoryEmail").Caption("Signatory Email");
        columns.Add().Caption("Signature Image").CellTemplate(@<text>
            <img src="@Url.Content("~/uploads/@item.SignatureImage")" style="height:40px;" />
        </text>);
    }))

<div style="margin-top: 20px;">
    <button class="dx-button dx-button-default">Update</button>
    <button class="dx-button dx-button-normal">Back</button>
</div>

