<script>

		$(document).ready(function () {
		$(".limited-footer .btn-containerIvoiceEdit").each(function () {
			if (!$(this).find("#ddButtonLayout,#btnToggleSearch,#btngetcostofgoodssold,#btnpostcogsvoucher").length) {
				$(this).remove();
