    $(document).ready(function () {
        function getQueryParam(name) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(name);
        }

        const acchedid = getQueryParam("acchedid") || "";
        const accheadname = getQueryParam("accheadname") || "";
        const startDate = getQueryParam("FromDate");
        const endDate = getQueryParam("ToDate");

        if (acchedid) {
            $("#AccountLedgerNo").dxTextBox("instance").option("value", acchedid);
        }
        if (accheadname) {
            $("#AccountHeadName").dxTextBox("instance").option("value", accheadname);
        }

        // ✅ Ensure Date Parameters Are Passed Correctly
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        dataGrid.option("dataSource", {
            store: DevExpress.data.AspNet.createStore({
                loadUrl: "/api/SalaryPayableMapping/GetSalaryMappings",
                loadParams: {
                    acchedid: acchedid,
                    startDate: startDate ? new Date(startDate).toISOString() : null,
                    endDate: endDate ? new Date(endDate).toISOString() : null
                }
            })
        });

        dataGrid.refresh();
    });




    </script>
