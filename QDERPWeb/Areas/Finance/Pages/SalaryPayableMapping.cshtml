    <script>
        $(function () {
			$("#AccountLedgertoSalaryPayableMapping").dxTextBox({
	    			text:formatMessage("Account Ledger to Salary Payable Mapping"),
                    readOnly: true,
                    width:"510px",
					onContentReady: function(e) {
			            $(e.element).addClass("dx-textbox-heading");
		            }
                });
			});
       

    function ddBtnShowRecords_click(filterType) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const startDateBox = $("#StartDate").dxDateBox("instance");
        const endDateBox = $("#EndDate").dxDateBox("instance");
        const today = new Date();
        let startDate = null, endDate = null;

        switch (filterType) {
            case 'today':
                startDate = new Date(today.setHours(0, 0, 0, 0));
                endDate = new Date(today.setHours(23, 59, 59, 999));
                break;
            case 'yesterday':
                startDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 1);
                endDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 1, 23, 59, 59, 999);
                break;
            case 'week':
                startDate = new Date(today.setDate(today.getDate() - today.getDay()));
                endDate = new Date(today.setDate(startDate.getDate() + 6));
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date();
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0, 23, 59, 59, 999);
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date();
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31, 23, 59, 59, 999);
                break;
            case 'lastmonth':
                startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                endDate = new Date(today.getFullYear(), today.getMonth(), 0, 23, 59, 59, 999);
                break;
            case 'lastyear':
                startDate = new Date(today.getFullYear() - 1, 0, 1);
                endDate = new Date(today.getFullYear() - 1, 11, 31, 23, 59, 59, 999);
                break;
            default:
                dataGrid.clearFilter();
                return;
        }

        // ✅ Update the DateBox values
        startDateBox.option("value", startDate);
        endDateBox.option("value", endDate);

        // ✅ Apply filter to DataGrid
        dataGrid.option("dataSource", {
            store: DevExpress.data.AspNet.createStore({
                loadUrl: "/api/SalaryPayableMapping/GetSalaryMappings",  // ✅ Match with API method name
                loadParams: {
                    startDate: startDate.toISOString(),
                    endDate: endDate.toISOString()
                }
            })
        });

        dataGrid.refresh();
    }


