	$(document).ready(function () {
		// Bind the click event to the Delete button
		$("#AEbtnDelete").dxButton("instance").on("click", function () {
			// Show DevExpress confirmation dialog
			DevExpress.ui.dialog.confirm("You are about to reset Employee allocation details for the voucher entry. Are you sure you want to reset the Cost Allocation?", "Are you sure?")
				.done(function (result) {
					if (result) {
						resetCostDataGrid();
					}
				});
		});
	});




	// Function to reset the DataGrid and reinitialize it
	function resetCostDataGrid() {
		debugger;
		const costdataGrid = $('#AEdataGrid').dxDataGrid('instance');

		if (costdataGrid) {
			costdataGrid.option('dataSource', []); // Clear the grid data
		}

		// Re-execute the script to reset the grid
		reinitializeGrid();
	}

	// Function to reinitialize the grid with default data
	function reinitializeGrid() {
		const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;

		const costData = [
			{
				DrCr: '@drCr',
				EffectiveDate: new Date().toLocaleDateString('en-GB', {
					day: 'numeric',
					month: 'short',
					year: 'numeric',
				}),
				VoucherAmount: initialVoucherAmount.toFixed(2),
				Remarks: ''
			}
		];

		const costdataGrid = $('#AEdataGrid').dxDataGrid('instance');

		if (costdataGrid) {
			costdataGrid.option('dataSource', costData); // Reload initial data
		}
	}

	function confirmDelete() {
		var dataGrid = $("#AEdataGrid").dxDataGrid("instance");
		var selectedRows = dataGrid.getSelectedRowKeys();

		if (selectedRows.length === 0) {
			DevExpress.ui.dialog.alert("Please select at least one row to delete.", "Warning");
			return;
		}

		DevExpress.ui.dialog.confirm("You are about to delete this line entry Item for the Employee Allocated. Delete Line Item.", "Confirm Deletion").done(function (dialogResult) {
			if (dialogResult) {
				selectedRows.forEach(function (key) {
					dataGrid.getDataSource().store().remove(key).done(function () {
						dataGrid.refresh();
					}).fail(function (error) {
						console.error("Error deleting row:", error);
					});
				});
			}
		});
	}



	$(document).ready(function () {
		let dataGrid = $("#AEdataGrid").dxDataGrid("instance");

		// Handle right-click (context menu event)
		dataGrid.option("onContextMenuPreparing", function (e) {
			if (e.row && e.target === "content") { // Ensure right-click is on a row, not the header
				e.event.preventDefault(); // Prevent the default browser context menu
				confirmDelete(e.row.data); // Show delete confirmation
			}
		});
	});

	function setEffectiveDate(e) {
		var $dataGrid = $("#AEdataGrid");

		if ($dataGrid.length) {
			var dataGrid = $dataGrid.dxDataGrid("instance");
			dataGrid.selectRows(e.value, false);
		}
		if (e.value) {
			debugger;
			let grid = $("#AEdataGrid").dxDataGrid("instance");
