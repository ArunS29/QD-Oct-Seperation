			DevExpress.ui.notify("No data in the grid to save.", "error", 2000);
			return;
		}

		// Extract values from the first row (you can adjust logic for multiple rows if needed)
		const firstRowData = dataGridData[0];

		const remarks = firstRowData.Remarks || null; // Remarks column value


		// Construct the ViewModel object
		const VM = {

			EmployeeNo: employeeId,
			EffectiveDate: new Date().toISOString().split('T')[0],
			AmountAllocated: VocuherAmount, // Ensure server-side value is correctly populated
			CostAllocRemarks: remarks,
			VoucherNo:'@VoucherNo',
			EmpAllocDrCr:'@drCr'
		};

		// Debug to ensure VM is correctly populated
		console.log("VM to be sent:", VM);
				debugger;
				$.ajax({
					type: "POST",
					url: "/api/EmployeeAllocation/SaveEmployeeAllocation",
					contentType: "application/json",
					data: JSON.stringify(VM),
					dataType: "json",
					success: function (response) {
						if (response.success) {
								DevExpress.ui.notify("Employee Allocation Details updated Successfully.", "success", 2000);

								let popupInstance = $("#EmployeeAllocationPopup").dxPopup("instance");
								popupInstance.hide();



