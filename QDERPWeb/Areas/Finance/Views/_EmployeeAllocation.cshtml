					 $("#AEbtnSave").on("click", function (e) {
			e.preventDefault();
			
			let grid = $("#AEdataGrid").dxDataGrid("instance");
			let allRowsData = grid.getDataSource().items();
			let voucherchildno = parseInt('@voucherEntryNo'.trim(), 10);
			let voucherno = '@VoucherNo';
			let accountid = '@accountId';


			let costAllocations = allRowsData.map(row => ({
				EmployeeAllocationId: row.EmployeeAllocationId || 0, // 0 if it's a new record
				EmployeeNo: row.EmployeeNo || null,
				EffectiveDate: row.EffectiveDate ? new Date(row.EffectiveDate).toISOString() : null,
				AmountAllocated: row.VoucherAmount,
				CostAllocRemarks: row.Remarks,
				VoucherNo: voucherno,
				VoucherEntryId: voucherchildno,
				EmpAllocDrCr: row.DrCr,
				LedgerAccountNo: accountid
			}));


			// Optional: validate before sending

			$.ajax({
				type: "POST",
				url: "/api/EmployeeAllocation/SaveEmployeeAllocations", // adjust area/controller path if needed
				contentType: "application/json",
				data: JSON.stringify(costAllocations),
				success: function (response) {

					DevExpress.ui.dialog.alert(
						"Employee Allocation Details updated Successfully.",
						"Update Successful"
					).then(function () {
						let popupInstance = $("#EmployeeAllocationPopup").dxPopup("instance");
						popupInstance.hide();
					});

					//     window.location.reload();
					// CostAllocationPopup.hide();
					// Hide the popup

				},
				error: function (xhr) {
					DevExpress.ui.notify("Error saving data: " + xhr.responseText, "error", 4000);
				}
			});
		});
	function gridBoxEmployeevalueChanged(e) {
		var $dataGrid = $("#AEdataGrid");

		if ($dataGrid.length) {
			var dataGrid = $dataGrid.dxDataGrid("instance");
			dataGrid.selectRows(e.value, false);
		}
		if (e.value) {
			let grid = $("#AEdataGrid").dxDataGrid("instance");
			let rowIndex = e.element.closest("tr").index(); // Get the edited row index
			let rowData = grid.getVisibleRows()[rowIndex].data;

			let costAllocationDropdownGrid = $("#EmployeeAllocationDropdownGrid").dxDataGrid("instance");
			let selectedRowData = costAllocationDropdownGrid.getSelectedRowsData()[0]; // Get first selected row

			if (selectedRowData) {
					rowData.EmployeeNo = selectedRowData.EmployeeId;
					rowData.EmployeeName = selectedRowData.EmployeeName; // Update AccountHead
					grid.cellValue(rowIndex, "EmployeeNo", selectedRowData.EmployeeId);
					grid.cellValue(rowIndex, "EmployeeName", selectedRowData.EmployeeName);// Store the correct ID

			}

		

		}



		// Close the dropdown after selection
		e.component.option("opened", false);
	}
