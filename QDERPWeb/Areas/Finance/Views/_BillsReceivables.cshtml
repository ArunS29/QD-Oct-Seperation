@page
@model QD.ERP.Web.Areas.Finance.Views._BillsReceivablesModel
@{
    string voucherNo = ViewBag.VoucherNo;
    string drCr = ViewBag.DrCr;
    string accountHead = ViewBag.AccountHead;
    string accountId = ViewBag.AccountId;
    string voucherAmount = ViewBag.VoucherAmount;
    long voucherEntryNo = ViewBag.VoucherEntryNo;
    double? voucherAmountParsed = null;

    // Try parsing the voucherAmount
    if (!string.IsNullOrEmpty(voucherAmount))
    {
        double parsedAmount;
        if (double.TryParse(voucherAmount, out parsedAmount))
        {
            voucherAmountParsed = Math.Round(parsedAmount, 2);
        }
    }

    // Determine Reference Type and Voucher Type
    string referenceType = "Against Reference";
    string voucherType = "Sales";
    bool hideRetentionAmount = false;
    bool isPayable = false;

    if (!string.IsNullOrEmpty(voucherNo))
    {
        if (voucherNo.Contains("CP") || voucherNo.Contains("BP"))
        {
            referenceType = "Against Reference";
            voucherType = "Purchases";
            hideRetentionAmount = true; // Hide Retention Amount for Purchases
            isPayable = true;
        }
        else if (voucherNo.Contains("CR") || voucherNo.Contains("BR"))
        {
            referenceType = "Against Reference";
            voucherType = "Sales";
            hideRetentionAmount = true; // Hide Retention Amount for Sales
            isPayable = false;
        }
        else if (voucherNo.Contains("PUR"))
        {
            referenceType = "Against Reference";
            voucherType = "Purchases";
            hideRetentionAmount = false; // Hide Retention Amount for Sales
            isPayable = true;
        }
    }
}
<style>
    .footer-fixed{
        bottom:0px!important;
    }
</style>
<div class="content-container-top" style="background-color:#909ead00;" >
<div class="title">
    <div class="header-container">
        <div class="title">Bills Receivables / Receivables </div>
    </div>
</div>
    <div class="row w-100 align-items-center" style="margin-top: 8px;">
        <div class="form-group col-3">
                    
                    @(
                        Html.DevExtreme().TextBox()
                        .Label("Voucher Entry ID :")
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("VoucherNoId")
                        .Value(voucherNo)
                        //.OnValueChanged("onVoucherNoChanged")
                        .Disabled(true)
                        )
        </div>



        <div class="form-group col-4">
                    
                    @(Html.DevExtreme().SelectBox()
                    .ID("PaymentNameDropdown")
                    .DataSource(new[] { accountHead }) // Only the selected AccountHead
                        .Label("Payment Account:")
                        .LabelMode(EditorLabelMode.Floating)
                    .Value(accountHead) // Pre-selected value
                    .Disabled(true) // Make the dropdown read-onlyr

                    )

        </div>


        <div class="form-group col-3">
                    @(Html.DevExtreme().NumberBox()
                        .ID("AmountId")
                        .Label("Amount:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Value(voucherAmountParsed)
                        .ShowSpinButtons(true)
                       
                        .Format("#,##0.00")
                        .Disabled(true)
                        )

        </div>


        <div class="form-group col-2">
                   
                    @(
                        Html.DevExtreme().SelectBox()
                        .ID("DrCrId")
                        .Label("DrCr:")
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { drCr })
                        .Value(drCr)
                        .Placeholder("Select Transaction Type")
                        .Width(90)
                        .Disabled(true)
                        )
        </div>

           
        
    </div>
  

    <div class="row w-100 align-items-center" style="margin-top: 8px;">
        <div class="form-group col-3">
            
                
            
            @(
                Html.DevExtreme().SelectBox()
                .ID("Reference")
                .Label("Reference:")
                .LabelMode(EditorLabelMode.Floating)
                .DataSource(new[] { "New Reference", "Against Reference" })
                .Value(referenceType)
                .Placeholder("Select Transaction Type")
                
                )
        </div>
        <div class="form-group col-4">
            @(Html.DevExtreme().DropDownBox()
                        .ID("ReferenceAcountHead")
                        .Label("Reference No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .ValueExpr("ReferenceNo")
                        .DisplayExpr("ReferenceNo")
                        .Value("")
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Reference No Head is required");
                        })
                        .DataSource(d => d.WebApi()
                        .Controller("BillsReceivable")
                        .LoadAction("GetSubLedgerReceivables")
                        .LoadParams(new { voucherType = voucherType, accountId = accountId, isPayable = isPayable })
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("ReferenceNo")
                        )
                        .DropDownOptions(o => o.Width(1000))
                        
                        .ContentTemplate(@<text>
                @(Html.DevExtreme().DataGrid()
                                .ID("ReferenceGrid")
                                .Height(300) 
                                .DataSource(d => d.WebApi()
                                .Controller("BillsReceivable")
                                .LoadAction("GetSubLedgerReceivables")
                                .LoadParams(new { voucherType = voucherType, accountId = accountId, isPayable = isPayable })
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("ReferenceNo")
                                )
                                .ShowBorders(true)
                                .Selection(s => s.Mode(SelectionMode.Single))
                                .HoverStateEnabled(true)
                                .Paging(p => p.Enabled(false))
                                .Scrolling(s => s.Mode(GridScrollingMode.Virtual)) 
                                .Columns(columns =>
                                {
                                    columns.Add().DataField("ReferenceNo").Caption("Reference No");
                                    columns.Add().DataField("ReceivableAmount").Caption("Receivable Amount").Format(format => format.Type(Format.FixedPoint).Precision(2)).CustomizeText("function(cellInfo) { if (cellInfo.value < 0) { return '(' + Math.abs(cellInfo.value).toFixed(2) + ')'; } return cellInfo.value.toFixed(2); }");
                                    columns.Add().DataField("Received").Caption("Received").Format(format => format.Type(Format.FixedPoint).Precision(2)).CustomizeText("function(cellInfo) { if (cellInfo.value < 0) { return '(' + Math.abs(cellInfo.value).toFixed(2) + ')'; } return cellInfo.value.toFixed(2); }");
                                    columns.Add().DataField("Balance").Caption("Balance").Format(format => format.Type(Format.FixedPoint).Precision(2)).CustomizeText("function(cellInfo) { if (cellInfo.value < 0) { return '(' + Math.abs(cellInfo.value).toFixed(2) + ')'; } return cellInfo.value.toFixed(2); }");
                                    columns.Add().DataField("RetentionAmount").Caption("Retention Amount").Format(format => format.Type(Format.FixedPoint).Precision(2)).CustomizeText("function(cellInfo) { if (cellInfo.value < 0) { return '(' + Math.abs(cellInfo.value).toFixed(2) + ')'; } return cellInfo.value.toFixed(2); }");
                                    columns.Add().DataField("BalanceDueWithOutRetention").Caption("Balance Due Without Retention").Format(format => format.Type(Format.FixedPoint).Precision(2)).CustomizeText("function(cellInfo) { if (cellInfo.value < 0) { return '(' + Math.abs(cellInfo.value).toFixed(2) + ')'; } return cellInfo.value.toFixed(2); }");
                                })
                                .OnSelectionChanged("onReferenceGridSelectionChanged")
                                )
            </text>)

                        )

            <div style="display:flex;">
                @(Html.DevExtreme().CheckBox()
                                .ID("Retainedcheck")
                                
                                )

                <label for="Amount">Show Retained Value</label>
            </div>
        </div>
       

        <div class="form-group col-3">
            
            @(
                Html.DevExtreme().NumberBox()
                .ID("txtAmount2")
                .Label("Amount:")
                .LabelMode(EditorLabelMode.Floating)
                .Value(0)
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired()
                            .Message("Voucher Amount Cannot be Zero Or Negative");
                            rules.AddRange().Min(0).Message("Voucher Amount Cannot be Zero Or Negative");
                        })
                .Min(0)
               
                .Format("#,##0.00")
                .InputAttr(new
                {
                    style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                    type = "number",
                    step = "0.01"
                })
                )

        </div>
        <div class="form-group col-2">
            @(Html.DevExtreme().Button()
                .ID("btnBillsVoucherEntry")
                .Text("ADD")
                .Height(50)
                .Width(150)
                .Icon("plus")
                .OnClick("function() { addBillsPayableReceivable(); }")
                .Disabled(!hideRetentionAmount)
                )
        </div>
       
    </div>

    <div class="dx-field ledgerResult" >
        @(
            Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl201SubLedgerMaster>()
            .ID("ReceivabledataGrid")
            .KeyExpr("ReferenceNo")
            .RemoteOperations(false)
            .OnInitialized("dataGridInitialized")
            
            .Columns(columns =>
            {
                columns.AddFor(m => m.SubLedgerId).Caption("ledgerid").Alignment(HorizontalAlignment.Center).AllowEditing(false).Visible(false);
                columns.AddFor(m => m.VoucherEntryNo).Caption("#").Alignment(HorizontalAlignment.Center).AllowEditing(false);
                columns.AddFor(m => m.DrCr).Caption("DrCr").Alignment(HorizontalAlignment.Center).AllowEditing(false);
                columns.AddFor(m => m.ReferenceType).Caption("Reference Type").Alignment(HorizontalAlignment.Left).AllowEditing(false);
                columns.AddFor(m => m.ReferenceNo).Caption("Reference No").Alignment(HorizontalAlignment.Center).AllowEditing(false);
                columns.AddFor(m => m.Amount).Caption("Amount").Alignment(HorizontalAlignment.Right).AllowEditing(false).CustomizeText(@"
        function(e) {
        if(e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        return e.value.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }
        ");
                columns.AddFor(m => m.RetentionAmount).Caption("Retention Amount").Alignment(HorizontalAlignment.Center).Visible(!hideRetentionAmount).CustomizeText(@"
                function(e) {
                if(e.value === null || e.value === undefined) {
                return ''; // Return empty string for null values
                }
                return e.value.toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
                });
                }
                ").AllowEditing(true); 


            })
                .Summary(summary =>
                {
                    summary.TotalItems(items =>
                    {
                        items.Add().Column("Amount").SummaryType(SummaryType.Sum)
                    .CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");
                    });
                })
                
            //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
            .AllowColumnReordering(true) // Enable column reordering
            .AllowColumnResizing(true)   // Enable column resizing
            .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
            .HeaderFilter(filter => filter.Visible(false))
            .Height(250)
            .ColumnAutoWidth(true)
            .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
            .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
            .ShowBorders(true)
            .Width("100%")
                .Editing(editing => editing
                .Mode(GridEditMode.Cell)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)
                )
                

            )
    </div>
    <div class="footer-fixed">
        @await Html.PartialAsync("_BPRFooter")
    </div>
   
</div>
 
 
       
<script>

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dataGridEPRPaymentSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#PaymentNameDropDown").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }

    }
    function dataGridEPRAccountHeadSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#ReferenceAcountHead").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }

    }
    function dataGridEPRPaymentInitialized(e) {
        dataGrid = e.component;
    }
    function dataGridEPRAccountHeadInitialized(e) {
        dataGrid = e.component;
    }

    function addBillsPayableReceivable() {
        const voucherEntryNo = '@voucherEntryNo';
        const VoucherNo = '@voucherNo';
        const accountId = '@accountId';
        const drCr = $("#DrCrId").dxSelectBox("instance").option("value");
        const referenceType = $("#Reference").dxSelectBox("instance").option("value");
        const referenceNo = $("#ReferenceAcountHead").dxDropDownBox("instance").option("value");
        const amount = $("#txtAmount2").dxNumberBox("instance").option("value");

        var referenceValidator = $("#ReferenceAcountHead").dxValidator("instance");

        var AmtValidator = $("#txtAmount2").dxValidator("instance");

        var referenceValidation = referenceValidator.validate();

        var AmtValidation = AmtValidator.validate();
      if (referenceValidation.isValid && AmtValidation.isValid && amount != "0.00") {

        $.ajax({
            url: "/api/BillsReceivable/AddSubLedgerEntry",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                voucherEntryNo: voucherEntryNo,
                drCr: drCr,
                referenceType: referenceType,
                referenceNo: referenceNo,
                amount: amount,
                accountId: accountId,accountId,
                VoucherNo: VoucherNo
            }),
            success: function (response) {
                if (response.success) {
                   
                   const voucherNo = '@voucherEntryNo';

                   var accountGrid = $("#ReferenceGrid").dxDataGrid("instance");

                    // Unselect the selected row
                    accountGrid.clearSelection();

                        setTimeout(function () {
                    // Refresh Receivable DataGrid
                    const grid = $("#ReceivabledataGrid").dxDataGrid("instance");
                    $.get("/api/BillsReceivable/GetSubLedgerByVoucher", { voucherNo: voucherNo }, function (data) {
                        grid.option("dataSource", data);
                        setTimeout(function () {
                           const totalAmountUsed = grid.getTotalSummaryValue("Amount") || 0;
                                    const amountIdValue = $("#AmountId").dxNumberBox("instance").option("value") || 0;

                                    const backButton = $("#btnBackERP").dxButton("instance");

                                    if (totalAmountUsed == amountIdValue ) {
                                        // Equal (within floating point tolerance) → Enable button
                                        backButton.option("disabled", false);
                                    } else {
                                        // Not equal → Disable button
                                        backButton.option("disabled", true);
                                    }
                        }, 500);
                    });
                    
                    // Refresh DropDownBox and its data source
                    const referenceBox = $("#ReferenceAcountHead").dxDropDownBox("instance");
                    

                    referenceBox.option("dataSource", newDataSource);
                    referenceBox.option("value", null);
                }, 500); // Delay of 500 milliseconds

                
                    const amtBox = $("#txtAmount2").dxNumberBox("instance");
                    amtBox.option("value", null); // Clear the amount field

                    // ✅ Reset validator UI states
                    referenceValidator.reset();
                    AmtValidator.reset();

                    
                         DevExpress.ui.notify("Subledger entry added.", "success", 2000);
                } else {
                    DevExpress.ui.notify(response.message || "Error adding entry.", "error", 3000);
                }
            },
            error: function (xhr) {
                DevExpress.ui.notify("Server error occurred.", "error", 3000);
            }
        });
      } else {

           DevExpress.ui.dialog.alert(
                    "Cannot continue saving with errors,please clear the errors and continue.",
                    "Clear Errors"
           );

      }
    }
    

  

    $("#btnBackERP").on("click", function (e) {
        e.preventDefault();

        // Get the instance of the SalaryPaidEntryPopup
        const salaryPaidEntryPopup = $("#SalaryPaidEntryPopup").dxPopup("instance");


        if (salaryPaidEntryPopup) {
            const content = salaryPaidEntryPopup.content();

            // Hide the popup
            salaryPaidEntryPopup.hide();


        }
    });
    // Function to hide the popup
    function hidePopup() {
        document.getElementById('SalaryPaidEntryPopup').style.display = 'none';
        document.getElementById('popupOverlay').style.display = 'none';
    }
    function hidePopup() {
        const popup = document.getElementById("SalaryPaidEntryPopup");
        if (popup) {
            popup.style.display = "none"; // Attempt to hide

        } else {
            console.error("Popup element not found!");
        }
    }


    let dataGridInstance2 = null; // Reference to DataGrid
    let selectedRowData = null;   // Store selected row data

    // Store the DataGrid instance when initialized
    function dataGridInitialized(e) {
        dataGridInstance2 = e.component; // Assign the grid instance
    }

    // Handle the right-click context menu event
    function onContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") {
            // Row is right-clicked
            selectedRowData = e.row.data;
            //  alert(selectedRowData.SubLedgerId);
            e.items = [
                {
                    text: "Delete Line Entry",
                    onItemClick: function () {

                        if (confirm(`You are about to delete the Bills Payable Records from the database. You cannot revert the changes. Are you sure you want to delete?`)) {

                            // Call server-side delete method
                            $.post(`/Finance/api/BillsPayableReceivable/DeleteRecord?id=${selectedRowData.SubLedgerId}`, function (response) {

                                if (response.success) {
                                    alert("Bills Payable Records have been successfully removed from the database");

                                    // Remove the selected row from the DataGrid
                                    if (dataGridInstance2) {
                                        // Remove the row directly from the grid data source
                                        let dataSource = dataGridInstance2.option('dataSource');  // Get the current data source

                                        // Filter out the deleted record based on SubLedgerId
                                        let updatedDataSource = dataSource.filter(function (item) {
                                            return item.SubLedgerId !== selectedRowData.SubLedgerId;  // Remove the row by matching SubLedgerId
                                        });

                                        // Update the grid's data source to the new filtered data (which no longer includes the deleted row)
                                        dataGridInstance2.option('dataSource', updatedDataSource);
                                    }

                                } else {
                                    alert(`Error: ${response.message}`);
                                }
                            }).fail(function () {
                                alert("An error occurred while processing your request.");
                            });
                        }
                    }
                }
            ];
        }
    }
    function onReferenceGridSelectionChanged(e) {
        if (e.selectedRowsData.length > 0) {
            const selectedRow = e.selectedRowsData[0];
            const selectedReference = selectedRow.ReferenceNo;

            // Check if Retainedcheck checkbox is checked
            const retainedCheckBox = $("#Retainedcheck").dxCheckBox("instance");
            const isRetainedChecked = retainedCheckBox.option("value");

             // Get rowBalance and retentionAmount as absolute values
            let rowBalance = Math.abs(selectedRow.Balance || 0);
            const retentionAmount = Math.abs(selectedRow.BalanceDueWithOutRetention || 0);

            if (isRetainedChecked) {
                rowBalance = retentionAmount;
            }

            // Set ReferenceNo in DropDownBox
            const dropDownBox = $("#ReferenceAcountHead").dxDropDownBox("instance");
            dropDownBox.option("value", selectedReference);
            dropDownBox.close();

            // Get the original voucher amount from AmountId
            const amountIdInstance = $("#AmountId").dxNumberBox("instance");
            const originalAmount = amountIdInstance.option("value") || 0;

            // Get the total already used from DataGrid summary
            const receivableGrid = $("#ReceivabledataGrid").dxDataGrid("instance");
            const totalAmountUsed = receivableGrid.getTotalSummaryValue("Amount") || 0;

            // Calculate available amount
            const availableAmount = originalAmount - totalAmountUsed;

            // Decide what value to set in txtAmount2
            const finalAmountToSet = availableAmount < rowBalance ? availableAmount : rowBalance;

            // Set value in txtAmount2
            const txtAmount2Instance = $("#txtAmount2").dxNumberBox("instance");
            txtAmount2Instance.option("value", finalAmountToSet);
        }
    }




    $(document).ready(function () {

         var voucherNo = '@voucherEntryNo';

        if (voucherNo) {
            $.ajax({
                url: '/api/BillsReceivable/GetSubLedgerByVoucher',
                type: 'GET',
                data: { voucherNo: voucherNo },
                success: function (data) {
                    const grid = $("#ReceivabledataGrid").dxDataGrid("instance");
                    grid.option("dataSource", data);
                },
                error: function (xhr, status, error) {
                    console.warn("Error loading subledger data:", error);
                }
            });
        }
    });

    function onReferenceDropdownOpened(e) {
        const grid = $("#ReferenceGrid").dxDataGrid("instance");
        if (grid) {
            grid.getDataSource().reload();
        }
    }

    $("#btnUpdateAndClose").on("click", function (e) {
        e.preventDefault();

        // Get DataGrid instance
        const dataGrid = $("#ReceivabledataGrid").dxDataGrid("instance");

        // Get all rows from the grid
        const gridData = dataGrid.getDataSource().items();

        // Calculate total of Amount column
        let totalGridAmount = 0;
        gridData.forEach(item => {
            totalGridAmount += parseFloat(item.Amount || 0);
        });

        // Get AmountId NumberBox value
        const numberBox = $("#AmountId").dxNumberBox("instance");
        const amountBoxValue = parseFloat(numberBox.option("value") || 0);

        // Compare total
        if (Math.abs(totalGridAmount - amountBoxValue) > 0.01) {
            // Show error alert if they don't match
            DevExpress.ui.dialog.alert("Ledger Amount does not match with the Bill Allocated Amount", "Validation Error");
            return;
        }
      let Allocations = gridData.map(row => ({
        SubLedgerId: row.SubLedgerId || 0, // 0 if it's a new record
        VoucherEntryNo: row.VoucherEntryNo || null,
        DrCr: row.DrCr ,
        ReferenceType: row.ReferenceType,
        ReferenceNo: row.ReferenceNo,
        Amount: row.Amount,
        RetentionAmount: row.RetentionAmount || null
        
      }));

        // If valid, send grid data to controller
        $.ajax({
            url: '/api/BillsReceivable/UpdateSubLedgerEntries', // Replace with your actual controller action
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(Allocations),
            success: function (response) {
                   DevExpress.ui.dialog.alert("Bills Receivable Updated successful!", "Success").then(function () {
                        let popupInstance = $("#BillsReceivablePopup").dxPopup("instance");
                        popupInstance.hide();
                    });

                // Optionally close popup or reload
            },
            error: function (xhr, status, error) {
                DevExpress.ui.dialog.alert("Update failed. Please try again.", "Error");
            }
        });
    });
    $(document).ready(function () {
        const dataGrid = $("#ReceivabledataGrid").dxDataGrid("instance");

        dataGrid.option("onRowRemoving", function (e) {
            const data = e.data;

            if (!data || !data.VoucherEntryNo || data.Amount === undefined) {
                DevExpress.ui.dialog.alert("Invalid data for deletion.", "Error");
                e.cancel = true;
                return;
            }

            e.cancel = true; // Prevent auto-delete before confirmation

            
                    $.ajax({
                        url: '/api/BillsReceivable/DeleteSubLedgerEntry',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            voucherEntryNo: data.VoucherEntryNo,
                            amount: data.Amount
                        }),
                        success: function (response) {
                            if (response.success) {
                                    const voucherNo = '@voucherEntryNo';

                                

                                 setTimeout(function () {
                                     // Refresh Receivable DataGrid
                                     const grid = $("#ReceivabledataGrid").dxDataGrid("instance");
                                     $.get("/api/BillsReceivable/GetSubLedgerByVoucher", { voucherNo: voucherNo }, function (data) {
                                         grid.option("dataSource", data);
                                     });
                                 }, 500);
                                DevExpress.ui.dialog.alert("Row deleted successfully.", "Success");
                            } else {
                                DevExpress.ui.dialog.alert(response.message || "Failed to delete.", "Error");
                            }
                        },
                        error: function () {
                            DevExpress.ui.dialog.alert("Server error during deletion.", "Error");
                        }
                    });
                
        });
        dataGrid.option("onRowPrepared", function (e) {
                if (e.rowType === "data") {
                    // Apply light orange background to data rows
                    e.rowElement.css("background-color", "#fff3e0");
                }
        });
    });

    $(document).ready(function () {
        const isPayable = '@isPayable';

        $("#ReferenceAcountHead").dxDropDownBox("instance").on("opened", function () {
            const grid = $("#ReferenceGrid").dxDataGrid("instance");
            if (!grid) return;

            // ✅ Reload data
            grid.getDataSource().reload();

            // ✅ Update captions dynamically
            if (isPayable) {
                grid.columnOption("ReceivableAmount", "caption", "Payable Amount");
                grid.columnOption("Received", "caption", "Paid");
            } else {
                grid.columnOption("ReceivableAmount", "caption", "Receivable Amount");
                grid.columnOption("Received", "caption", "Received");
            }
        });
    });
</script>