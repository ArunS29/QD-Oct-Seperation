@page
@model QD.ERP.Web.Areas.Finance.Views._BillsReceivablesModel
@{
    
    string voucherNo = ViewBag.VoucherNo;
    string drCr = ViewBag.DrCr;
    string accountHead = ViewBag.AccountHead;
    string voucherAmount = ViewBag.VoucherAmount;
    long voucherEntryNo = ViewBag.VoucherEntryNo;
    double? voucherAmountParsed = null;

    // Try parsing the voucherAmount to a nullable double
    if (!string.IsNullOrEmpty(voucherAmount))
    {
        double parsedAmount;
        if (double.TryParse(voucherAmount, out parsedAmount))
        {
            voucherAmountParsed = parsedAmount;
        }
    }

    // If voucherAmountParsed is not null, ensure it's formatted to 2 decimal places
    if (voucherAmountParsed.HasValue)
    {
        // Format the amount to 2 decimal places and then parse it back to double
        voucherAmountParsed = Math.Round(voucherAmountParsed.Value, 2);
    }
}
<div class="content-container-top" style="background:aliceblue;">
<div class="title">
    <div class="header-container">
        <div class="title">Bills Receivables / Salary Payable </div>
    </div>
</div>
    <div class="dx-fieldset horizontal-container" style="margin-bottom:0px">
        <div class="form-group">
                    <label for="SalesInvoiceNo">Voucher Entry ID:</label>
                    @(
                        Html.DevExtreme().TextBox()
                        .ID("VoucherNoId")
                        .Value(voucherNo)
                        //.OnValueChanged("onVoucherNoChanged")
                        .Disabled(true)
                        )
                </div>
            

            
                <div class="form-group" style="width:300px">
                    <label for="PaymentAccount" class="">Payment Account:</label>
                    @(Html.DevExtreme().SelectBox()
                    .ID("PaymentNameDropdown")
                    .DataSource(new[] { accountHead }) // Only the selected AccountHead
                    .Value(accountHead) // Pre-selected value
                    .Disabled(true) // Make the dropdown read-onlyr

                    )

                </div>


        <div class="form-group button-alignment-down" style="width:5%">
                @(Html.DevExtreme().Button()
                    .ID("btnAddPaymentAccount")
                    .Icon("plus")
                    .Disabled(true)
                    )
            </div>
            
                <div class="form-group">
                    <label for="Amount" >Amount</label>
                    @(Html.DevExtreme().NumberBox()
                        .ID("AmountId")
                        .Value(voucherAmountParsed)
                        .ShowSpinButtons(true)
                       
                        .Format("#,##0.00")
                        .Disabled(true)
                        )

                </div>
            
           
                <div class="form-group" style=" width:50px" >
                    <label for="DrCr" class="">DrCr</label>
                    @(
                        Html.DevExtreme().SelectBox()
                        .ID("DrCrId")
                        .DataSource(new[] { drCr })
                        .Value(drCr)
                        .Placeholder("Select Transaction Type")
                        .Width(90)
                        .Disabled(true)
                        )
                </div>

           
        
    </div>
  

    <div class="dx-fieldset horizontal-container" >
        <div class="form-group" style="width:250px" >
            
                <label for="Reference">Reference:</label>
            
            @(
                Html.DevExtreme().SelectBox()
                .ID("Reference")
                .DataSource(new[] { "New Reference", "Against Reference" })
                .Value("Against Reference")
                .Placeholder("Select Transaction Type")
                
                )
        </div>
        <div class="form-group" style="width:300px">
            <label for="AccountHead">Reference No:</label>
            @(Html.DevExtreme().DropDownBox()
                .DataSource(new[] {
            new { AccountId = "2024-00088", AccountHead = "Account 2024-00088" },
            new { AccountId = "2024-00089", AccountHead = "Account 2024-00089" }
            })
                .ValidationRules(rules =>
                {
                    rules.AddRequired().Message("Account Head is required");
                })
                .LabelMode(EditorLabelMode.Outside)
                .ID("ddAccountHead")
                .ShowClearButton(true)
                .AcceptCustomValue(true)
                .OpenOnFieldClick(false)
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("AccountId")
                .DisplayExpr("AccountHead")
                .Value("2024-00088")
                .TabIndex(1)
                .DropDownOptions(o => o.Width(1000))
                .ContentTemplate(new TemplateName("ReferenceNoContentTemplate"))
                )

        </div>
        <div class="form-group">
            @(Html.DevExtreme().Button()
                .ID("btnAddAHead")
                .Icon("plus")
                )
        </div>

        <div class="form-group">
            <label for="Amount2">Amount</label>
            @(
                Html.DevExtreme().NumberBox()
                .ID("txtAmount2")
                .Value(null)
                .ValidationRules(rules =>
                {
                    rules.AddRequired()
                    .Message("Amount is required");
                })
                .Min(0)
                .Placeholder("0.00")
                .Format("#,##0.00")
                .InputAttr(new
                {
                    style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
                    type = "number",
                    step = "0.01"
                })
                )

        </div>
        <div class="form-group button-alignment-down">
            @(Html.DevExtreme().Button()
                .ID("btnVoucherEntry")
                .Text("ADD")
                .Height(50)
                .Width(150)
                .Icon("plus")
                .OnClick("function() { addBillsPayableReceivable(); }")
                )
        </div>
        <div style="display:flex;" class="button-alignment-down">
        @(Html.DevExtreme().CheckBox()
            .ID("IsVerified1")
            )

            <label for="Amount">Show Retained Value</label>
    </div>
    </div>

    <div class="dx-field ledgerResult" >
        @(
            Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl201SubLedgerMaster>()
            .ID("dataGrid2")
            .KeyExpr("ReferenceNo")
            .RemoteOperations(false)
            .OnInitialized("dataGridInitialized")
            .OnContextMenuPreparing("onContextMenuPreparing")
            .Columns(columns =>
            {
                columns.AddFor(m => m.SubLedgerId).Caption("Sub Ledger Id").Alignment(HorizontalAlignment.Center).Width(100);
                columns.AddFor(m => m.DrCr).Caption("DrCr").Alignment(HorizontalAlignment.Center).Width(100);
                columns.AddFor(m => m.ReferenceType).Caption("Reference Type").Alignment(HorizontalAlignment.Left).Width(100);
                columns.AddFor(m => m.ReferenceNo).Caption("Reference No").Alignment(HorizontalAlignment.Center).Width(100);
                columns.AddFor(m => m.Amount).Caption("Amount").Alignment(HorizontalAlignment.Right).Width(100).CustomizeText(@"
        function(e) {
        if(e.value === null || e.value === undefined) {
        return ''; // Return empty string for null values
        }
        return e.value.toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }
        ");
                columns.AddFor(m => m.RetentionAmount).Caption("Retention Amount").Alignment(HorizontalAlignment.Center).Width(100);


            })
            //.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title("Column Chooser").Mode(GridColumnChooserMode.Select))
            .AllowColumnReordering(true) // Enable column reordering
            .AllowColumnResizing(true)   // Enable column resizing
            .ColumnFixing(fixing => fixing.Enabled(true)) // Allow column fixing (pinning)
            .HeaderFilter(filter => filter.Visible(true))
            .Height(250)
            .ColumnAutoWidth(true)
            .FilterRow(filterRow => filterRow.Visible(false)) // Initially hide the FilterRow
            .GroupPanel(groupPanel => groupPanel.Visible(false)) // Display group panel
            .ShowBorders(true)
            .Width("100%")
            )
    </div>
    <div>
        @await Html.PartialAsync("_BPRFooter")
    </div>
    </div>
    
   


    <!-- Drop Down Account Head Grid Template -->
            @using (Html.DevExtreme().NamedTemplate("ReferenceNoContentTemplate"))
            {
                @(Html.DevExtreme().DataGrid()
                        .ID("accounthead-datagrid")
                        .DataSource(d => d.WebApi()
                        //.Controller("PurchaseVoucher")
                        //.LoadAction("GetAccountHead")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("AccountId")
                        )
                        .WordWrapEnabled(true)
                        .ShowBorders(true)
                        .SearchPanel(sp => sp.HighlightSearchText(true))
                        .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                        .OnSelectionChanged("dataGridEPRAccountHeadSelectionChanged")
                        .OnInitialized("dataGridEPRAccountHeadInitialized")
                        .HeaderFilter(p => p.Visible(true))
                        .ShowBorders(true)
                        .HoverStateEnabled(true)
                        .Paging(p => p.PageSize(15))
                        .FilterRow(f => f.Visible(true))
                        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                        .Height(345)
                        .Width(300)
                        .Selection(s => s.Mode(SelectionMode.Single))
                        .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                        .Columns(columns =>
                        {
                            columns.Add().DataField("AccountId");
                            columns.Add().DataField("AccountHead");
                            columns.Add().DataField("AccountHeadArabic");
                            columns.Add().DataField("IsLedgerObselete").Alignment(HorizontalAlignment.Center)
                        .CellTemplate(@<text>
        <div class="dx-icon">
            <%= data.IsLedgerObselete ? '<i style="color:green" class="fa fa-toggle-on"></i>' : '<i style="color:red" class="fa fa-toggle-off"></i>' %>
        </div>
    </text>);

                        })
                    )
            }

   
</div>
       
<script>

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dataGridEPRPaymentSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#PaymentNameDropDown").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }

    }
    function dataGridEPRAccountHeadSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#ddAccountHead").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }

    }
    function dataGridEPRPaymentInitialized(e) {
        dataGrid = e.component;
    }
    function dataGridAccountEPRHeadInitialized(e) {
        dataGrid = e.component;
    }

    function addBillsPayableReceivable() {

        var DrCr = $("#DrCrId").dxSelectBox("instance").option("value");
        var ReferenceType = $("#Reference").dxSelectBox("instance").option("value");
        var ReferenceNo = $("#ddAccountHead").dxDropDownBox("instance").option("value");
        var Amount = $("#txtAmount2").dxNumberBox("instance").option("value");

        if (!DrCr || !ReferenceType || !ReferenceNo || !Amount) {
            alert("Please fill in all required fields before submitting.");
            return;
        }

        var VE = {
            "DrCr": DrCr,
            "ReferenceType": ReferenceType,
            "ReferenceNo": ReferenceNo,
            "Amount": Amount,
        };

        $.ajax({
            type: "POST",
            url: "/Finance/api/BillsPayableReceivable/AddBillsPayableReceivable",
            contentType: "application/json",
            data: JSON.stringify(VE),
            dataType: "json",
            success: function (response) {
                DevExpress.ui.notify("BillsPayable/Receivable details saved succfully!", "success", 2000);

                console.log(response.data);
                $("#dataGrid2").dxDataGrid("instance").option("dataSource", response.data);

            },
            error: function (xhr, status, error) {
                alert("Error occurred while updating data: " + error);
            }
        });
    }

    $("#btnUpdateAndClose").on("click", function (e) {
        e.preventDefault();

        var VM = {
            "VoucherNo": $("#VoucherNoId").dxTextBox("instance").option("value"),
            "DrCr": $("#DrCrId").dxSelectBox("instance").option("value"),
            "ReferenceType": $("#Reference").dxSelectBox("instance").option("value"),
            "ReferenceNo": $("#ddAccountHead").dxDropDownBox("instance").option("value"),
            "Amount": $("#txtAmount2").dxNumberBox("instance").option("value")
        };

        $.ajax({
            type: "POST",
            url: "/Finance/api/BillsPayableReceivable/UpdateBillsPayableReceivable",
            contentType: "application/json",
            data: JSON.stringify(VM),
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    alert("Data Updated successfully..");

                } else {
                    alert("Update failed: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert("Error occurred while updating data: " + error);
            }
        });

    });

    $("#btnBackERP").on("click", function (e) {
        e.preventDefault();

        // Get the instance of the SalaryPaidEntryPopup
        const salaryPaidEntryPopup = $("#SalaryPaidEntryPopup").dxPopup("instance");


        if (salaryPaidEntryPopup) {
            const content = salaryPaidEntryPopup.content();

            // Hide the popup
            salaryPaidEntryPopup.hide();


        }
    });
    // Function to hide the popup
    function hidePopup() {
        document.getElementById('SalaryPaidEntryPopup').style.display = 'none';
        document.getElementById('popupOverlay').style.display = 'none';
    }
    function hidePopup() {
        const popup = document.getElementById("SalaryPaidEntryPopup");
        if (popup) {
            popup.style.display = "none"; // Attempt to hide

        } else {
            console.error("Popup element not found!");
        }
    }


    let dataGridInstance2 = null; // Reference to DataGrid
    let selectedRowData = null;   // Store selected row data

    // Store the DataGrid instance when initialized
    function dataGridInitialized(e) {
        dataGridInstance2 = e.component; // Assign the grid instance
    }

    // Handle the right-click context menu event
    function onContextMenuPreparing(e) {
        if (e.row && e.row.rowType === "data") {
            // Row is right-clicked
            selectedRowData = e.row.data;
            //  alert(selectedRowData.SubLedgerId);
            e.items = [
                {
                    text: "Delete Line Entry",
                    onItemClick: function () {

                        if (confirm(`You are about to delete the Bills Payable Records from the database. You cannot revert the changes. Are you sure you want to delete?`)) {

                            // Call server-side delete method
                            $.post(`/Finance/api/BillsPayableReceivable/DeleteRecord?id=${selectedRowData.SubLedgerId}`, function (response) {

                                if (response.success) {
                                    alert("Bills Payable Records have been successfully removed from the database");

                                    // Remove the selected row from the DataGrid
                                    if (dataGridInstance2) {
                                        // Remove the row directly from the grid data source
                                        let dataSource = dataGridInstance2.option('dataSource');  // Get the current data source

                                        // Filter out the deleted record based on SubLedgerId
                                        let updatedDataSource = dataSource.filter(function (item) {
                                            return item.SubLedgerId !== selectedRowData.SubLedgerId;  // Remove the row by matching SubLedgerId
                                        });

                                        // Update the grid's data source to the new filtered data (which no longer includes the deleted row)
                                        dataGridInstance2.option('dataSource', updatedDataSource);
                                    }

                                } else {
                                    alert(`Error: ${response.message}`);
                                }
                            }).fail(function () {
                                alert("An error occurred while processing your request.");
                            });
                        }
                    }
                }
            ];
        }
    }


</script>