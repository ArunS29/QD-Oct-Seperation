	<div class="dx-field ledgerResult">
        @(
                Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201SubLedgerPayablesMaster>()
                            .ID("SupplierdataGrid")
                            .RemoteOperations(false)
                            .Columns(columns =>
                            {
                                columns.AddFor(m => m.ReferenceNo)
                            .Caption(new JS("formatMessage('Reference No')"));

                                columns.AddFor(m => m.PurchaseBillNo)
            .Caption(new JS("formatMessage('Supplier Bill No')"));

                                columns.AddFor(m => m.PurchaseOrderNo)
            .Caption(new JS("formatMessage('Purchase Order No')"));


                                columns.AddFor(m => m.VoucherDate)
            .Caption(new JS("formatMessage('Voucher Date')"))
                                .DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy")
                                .AllowEditing(true);

                                columns.AddFor(m => m.VoucherEffectiveDate)
            .Caption(new JS("formatMessage('Effective month')"))
                                .DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy")
                                .AllowEditing(true);

                                columns.AddFor(m => m.InvoiceDueDate)
            .Caption(new JS("formatMessage('Invoice Due Date')"))
                                .DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy")
                                .AllowEditing(true);

                                columns.AddFor(m => m.VoucherNarration)
            .Caption(new JS("formatMessage('Voucher Narration')"));


						columns.AddFor(m => m.PayableAmount)
            .Caption(new JS("formatMessage('Payable Amount')"))
			.Alignment(HorizontalAlignment.Right)
            .CustomizeText(@"
        function(e) {
            var val = Math.abs(e.value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return e.value < 0 ? '(' + val + ')' : val;
        }
    ");

						columns.AddFor(m => m.Paid)
            .Caption(new JS("formatMessage('Paid')"))
			.Alignment(HorizontalAlignment.Right)
			.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                            columns.AddFor(m => m.Balance)
            .Caption(new JS("formatMessage('Balance to Pay')"))
			.Alignment(HorizontalAlignment.Right)
            .CustomizeText(@"
        function(e) {
            var val = Math.abs(e.value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return e.value < 0 ? '(' + val + ')' : val;
        }
    ");

                    columns.AddFor(m => m.OverdueDays).Caption(new JS("formatMessage('Overdue Days')"));
						
					})
				.Selection(selection => selection.Mode(SelectionMode.Single))
				.AllowColumnReordering(true)
				.AllowColumnResizing(true)
				.ColumnFixing(fixing => fixing.Enabled(true))
				.HeaderFilter(filter => filter.Visible(true))
				.Height("47vh")
				.ColumnAutoWidth(true)
				.FilterRow(filterRow => filterRow.Visible(false))
				.GroupPanel(groupPanel => groupPanel.Visible(false))
				.ShowBorders(true)
				.Width("100%")
				.Selection(s => s.Mode(SelectionMode.Multiple).ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always))
				.Editing(editing => editing
				.Mode(GridEditMode.Cell)
				.AllowUpdating(true)
				
				
				)
				.Summary(summary =>
				{
					summary.TotalItems(totalItems =>
					{
						totalItems.Add().Column("PayableAmount").SummaryType(SummaryType.Sum)
					.CustomizeText(@"
        function(e) {
            var val = Math.abs(e.value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return e.value < 0 ? '(' + val + ')' : val;
        }
    ");

						totalItems.Add().Column("Paid").SummaryType(SummaryType.Sum)
					.CustomizeText("function(e) { return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }");

                    totalItems.Add().Column("Balance").SummaryType(SummaryType.Sum)
					.CustomizeText(@"
        function(e) {
            var val = Math.abs(e.value).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return e.value < 0 ? '(' + val + ')' : val;
        }
    ");
					});
				})
				)
	</div>
    @using (Html.DevExtreme().NamedTemplate("SupplierContentTemplate"))
    {
        @(
            Html.DevExtreme().DataGrid()
            .ID("supplier-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("ExpenseClaim")
            .LoadAction("GetSupplierAccount")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("AccountId")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            .SearchPanel(sp => sp.HighlightSearchText(true))
            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
            .OnSelectionChanged("dataGridsupplierSelectionChanged")

            .OnInitialized("dataGridsupplierInitialized")
            .HeaderFilter(p => p.Visible(true))
            .ShowBorders(true)
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .FilterRow(f => f.Visible(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Width(500)

            .Columns(columns =>
            {
                columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Id')"));
                columns.Add().DataField("AccountHead").Caption(new JS("formatMessage('Account Head')"))
                .Alignment(HorizontalAlignment.Center);


            })

            )
    }
    
</div> 

<script>
            let supplieraccheadId,supplieraccheadname;

    function dropDownBoxInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }
    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }
    function dataGridsupplierSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#supplierDropDownBox").dxDropDownBox("instance");
        spentry = selectedKey;
        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
            var selectedRowData = $("#supplier-datagrid").dxDataGrid("instance").getSelectedRowsData();
            // Get ReferenceNo from selected row
            if (selectedRowData.length > 0) {
                
                supplieraccheadId = selectedRowData[0].AccountId;
                supplieraccheadname = selectedRowData[0].AccountHead;

                $.ajax({
    url: '/api/ExpenseClaim/GetSubLedgerData',
    type: 'GET',
    data: {
        accountId: supplieraccheadId,
        accountHead: supplieraccheadname
    },
    success: function (data) {
            const targetGrid = $("#SupplierdataGrid").dxDataGrid("instance");
        targetGrid.option("dataSource", data);
    },
    error: function (err) {
        DevExpress.ui.notify("Failed to load data", "error", 2000);
        console.error(err);
    }
});



            }
        }
    }

        function dataGridsupplierInitialized(e) {
            dataGrid = e.component;
        }
