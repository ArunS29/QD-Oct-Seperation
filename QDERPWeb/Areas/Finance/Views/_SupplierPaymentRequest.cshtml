        .LoadMode(DataSourceLoadMode.Raw)
        .Key("AccountId")
        )
        .Label(new JS("formatMessage('Select the Supplier Name:')"))
        .LabelMode(EditorLabelMode.Floating)
        .ID("supplierDropDownBox")
        .ShowClearButton(true)
        .AcceptCustomValue(false)
        .OpenOnFieldClick(false)
        .ValueChangeEvent("onSupplierChanged") // Detects changes in the dropdown
        .HoverStateEnabled(true)

        .ValueExpr("AccountId")
        .DisplayExpr("AccountHead")

        //.OnInput("dropDownBoxInput")
        .OnOpened("onOpened")
        .Width(440)
        .TabIndex(1)
        .DropDownOptions(o => o.Width(500))
        .OnKeyDown("onKeyDown")
        .ContentTemplate(new TemplateName("SupplierContentTemplate"))
        )
    </div>
