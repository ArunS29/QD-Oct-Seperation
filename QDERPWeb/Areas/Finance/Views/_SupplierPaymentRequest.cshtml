     $("#btnaddsupplier").on("click", function (e) {
                e.preventDefault();
        const gridInstance = $("#SupplierdataGrid").dxDataGrid("instance");
        const selectedRows = gridInstance.getSelectedRowsData();

        if (selectedRows.length === 0) {
            DevExpress.ui.notify("Please select at least one row to create a payment request.", "warning", 2000);
            return;
        }

        // Step 1: Get NewClaimNo
        $.ajax({
            url: '@Url.Action("GetNewPaymentNo", "ExpenseClaim")',
            type: 'GET',
            success: function (newClaimNo) {
                if (!newClaimNo) {
                    DevExpress.ui.notify("Failed to get new claim number.", "error", 2000);
                    return;
                }

                const childRecords = selectedRows.map(row => ({
                    ClaimRefNo: newClaimNo,
                    BillRefNo: row.PurchaseBillNo,
                    BillDate: row.VoucherDate,
                    ExpenseDescription: row.VoucherNarration,
                    ClaimedAmount: Math.abs(row.Balance),
                    ApprovedAmount: Math.abs(row.Balance),
                    VoucherNo: row.ReferenceNo,
                    CostCenterCode: "ADMIN-0001",
                    AccountId: supplieraccheadId
                }));

                // Step 2: Insert child records
                $.ajax({
                    url: '/api/ExpenseClaim/AddExpenseClaimChildRecords',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(childRecords),
                    success: function () {
                        // Step 3: Call stored procedure
                        $.ajax({
                            url: '@Url.Action("InsertClaimMaster", "ExpenseClaim")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                ClaimRefNo: newClaimNo,
                                ClaimRemarks: `Payment request for ${supplieraccheadname}.`,
                                SupplierPaymentLedgerNo: supplieraccheadId
                            }),
                            success: function () {
                                    window.location.href = `/${tenantName}/finance/CreatePaymentRequest?claimRefNo=${encodeURIComponent(newClaimNo)}`;
                            },
                            error: function () {
                                DevExpress.ui.notify("Failed to insert Claim Master.", "error", 2000);
                            }
                        });
                    },
                    error: function () {
                        DevExpress.ui.notify("Failed to insert child records.", "error", 2000);
                    }
                });

            },
            error: function () {
                DevExpress.ui.notify("Error generating voucher number.", "error", 2000);
            }
        });
     });

</script>
