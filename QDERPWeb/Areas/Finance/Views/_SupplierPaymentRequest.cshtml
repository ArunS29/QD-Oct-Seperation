

@{
    ViewData["Title"] = "Supplier Payment Request";
}

<style>
    .dx-popup-content{
        padding:0px !important;
    }
#a1btnPrint .dx-icon {
    color: green !important; /* Change to your desired color */
}

/* Search button icon color */
#a1btnToggleSearch .dx-icon {
    color: blue !important;
}

/* Group button icon color */
#a1btntoggleGroupPanel .dx-icon {
    color: orange !important;
}

/* Column chooser button icon color */
#a1btnColumnChooser .dx-icon {
    color: purple !important;
}

/* Dropdown button icon color */
#a1ddButtonLayout .dx-icon {
    color: crimson !important;
}

#a1btnToggleHeaderFilter .dx-icon {
    color: #a148aaaa !important;
}

#a1btnRefresh .dx-icon {
    color: #a100ff11 !important;
}

#a1btnToggleHeaderFilter,
#a1btnPrint,
#a1btnRefresh,
#a1btnToggleSearch,
#a1btntoggleGroupPanel,
#a1btnColumnChooser,
#a1ddButtonLayout,
#a1rowHeightProperties {
    display: inline-block;
    width: 75px !important;
    overflow: hidden;
    transition: width 0.3s ease-in-out;
}


#a1btnToggleHeaderFilter:hover,
#a1btnPrint:hover,
#a1btnRefresh:hover,
#a1btnToggleSearch:hover,
#a1btntoggleGroupPanel:hover,
#a1btnColumnChooser:hover,
#a1ddButtonLayout:hover,
#a1rowHeightProperties:hover {
    width: 200px !important;
}

    /* Hide button text initially */
    #a1btnToggleHeaderFilter .dx-button-text,
    #a1btnRefresh .dx-button-text,
    #a1btnPrint .dx-button-text,
    #a1btnToggleSearch .dx-button-text,
    #a1btntoggleGroupPanel .dx-button-text,
    #a1btnColumnChooser .dx-button-text,
    #a1ddButtonLayout .dx-button-text,
    #a1rowHeightProperties .dx-button-text {
        display: none;
    }

/* Show button text on hover */
#a1btnToggleHeaderFilter:hover .dx-button-text,
#a1btnRefresh .dxe-button-text,
#a1btnPrint:hover .dx-button-text,
#a1btnToggleSearch:hover .dx-button-text,
#a1btntoggleGroupPanel:hover .dx-button-text,
#a1btnColumnChooser:hover .dx-button-text,
#a1ddButtonLayout:hover .dx-button-text,
#a1rowHeightProperties:hover .dx-button-text {
    display: inline-block;
}
</style>


<div class="container2">
    <div class="ddw" style="margin-left:20px">
    @(Html.DevExtreme().DropDownBox()
        .DataSource(d => d.WebApi()
        .Controller("ExpenseClaim")
