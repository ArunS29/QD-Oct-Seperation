					<label for="DrCr">Dr/Cr</label>
					@(
												Html.DevExtreme().SelectBox()
												.ID("PaDrCr")
												.DataSource(new[] { drCr })
												.Value(drCr)
												.ReadOnly(true)

												.Width(90)
