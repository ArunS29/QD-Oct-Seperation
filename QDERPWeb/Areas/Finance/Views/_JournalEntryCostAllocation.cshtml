    $(document).ready(function () {
        setTimeout(function () {
            let btnInstance = $("#btnCostDelete").dxButton("instance");
            if (btnInstance) {
                btnInstance.on("click", function () {
                    DevExpress.ui.dialog.confirm("You are about to reset Cost allocation details for the voucher entry. Are you sure you want to reset the Cost Allocation?", "Are you sure?")
                        .done(function (result) {
                            if (result) {
                                resetCostDataGrid();
                            }
                        });
                });
            } else {
                console.error("btnCostDelete instance not found.");
            }
        }, 500);
    });

    // Function to reset the DataGrid
    function resetCostDataGrid() {
        
        const costdataGrid = $('#costdataGrid').dxDataGrid('instance');

        if (costdataGrid) {
            costdataGrid.option('dataSource', []); // Clear the grid data
        }

        reinitializeGrid();
    }

    // Function to reinitialize the grid
    function reinitializeGrid() {
        const initialVoucherAmount = $("#CostAmount").dxNumberBox("instance")?.option("value") || 0;
        const drcr = $("#DrCr").dxSelectBox("instance")?.option("value") || "";

        const costData = [
            {
                DrCr: drcr,
                EffectiveDate: new Date().toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                }),
                VoucherAmount: initialVoucherAmount.toFixed(2),
                Remarks: ''
            }
        ];

        const costdataGrid = $('#costdataGrid').dxDataGrid('instance');

        if (costdataGrid) {
            costdataGrid.option('dataSource', costData);
        }
    }



    function confirmDelete() {
        var dataGrid = $("#costdataGrid").dxDataGrid("instance");
        var selectedRows = dataGrid.getSelectedRowKeys();

        if (selectedRows.length === 0) {
            DevExpress.ui.dialog.alert("Please select at least one row to delete.", "Warning");
            return;
        }

        DevExpress.ui.dialog.confirm("You are about to delete this line entry Item for the Cost Allocated. Delete Line Item.", "Confirm Deletion").done(function (dialogResult) {
            if (dialogResult) {
                selectedRows.forEach(function (key) {
                    dataGrid.getDataSource().store().remove(key).done(function () {
                        dataGrid.refresh();
                    }).fail(function (error) {
                        console.error("Error deleting row:", error);
                    });
                });
            }
        });
    }



    $(document).ready(function () {
        let dataGrid = $("#costdataGrid").dxDataGrid("instance");

        // Handle right-click (context menu event)
        dataGrid.option("onContextMenuPreparing", function (e) {
            if (e.row && e.target === "content") { // Ensure right-click is on a row, not the header
                e.event.preventDefault(); // Prevent the default browser context menu
                confirmDelete(e.row.data); // Show delete confirmation
            }
        });
    });

    function setEffectiveDate(e) {
        var $dataGrid = $("#costdataGrid");

        if ($dataGrid.length) {
            var dataGrid = $dataGrid.dxDataGrid("instance");
            dataGrid.selectRows(e.value, false);
        }
        if (e.value) {
            
            let grid = $("#costdataGrid").dxDataGrid("instance");
            let rowIndex = e.element.closest("tr").index(); // Get the edited row index
            let rowData = grid.getVisibleRows()[rowIndex].data;




            rowData.EffectiveDate = e.value; // Update the row data
            grid.cellValue(rowIndex, "EffectiveDate", e.value); // Ensure it reflects in the grid

        }
    }

    function closeParentModal() {
        const voucherEntryNo = $("#CurrentVoucherEntryNo").val();
if (!voucherEntryNo) {
    console.warn("VoucherEntryNo not found in hidden field.");
    return;
}

const popup = popupInstances[voucherEntryNo];
if (popup) {
    popup.hide();
} else {
    console.warn("No popup instance found for VoucherEntryNo:", voucherEntryNo);
}
    }

    $(document).ready(function () {
        var costDataGrid = $("#costdataGrid").dxDataGrid({
            onRowUpdating: function (e) {
                let costAmount = $("#CostAmount").dxNumberBox("instance").option("value"); // Get CostAmount value
                let newAmount = e.newData.VoucherAmount; // New value entered in the grid
                let oldAmount = e.oldData.VoucherAmount; // Previously loaded value
                let dataSource = $("#costdataGrid").dxDataGrid("instance").option("dataSource");

                if (newAmount > oldAmount) {
                    // Prevent increasing the amount, reset to old value
                    e.newData.VoucherAmount = oldAmount;
                    e.cancel = true;
                    // DevExpress.ui.notify("Amount cannot be increased! Resetting to " + oldAmount, "error", 2000);
                    return;
                }

                if (newAmount < oldAmount) {
                    let balanceAmount = oldAmount - newAmount; // Calculate the remaining balance

                    // Add new row with the balance amount
                    let newRow = { ...e.oldData, CostAllocationUnit: "Common Overheads", CostAllocationUnitId: "ADMIN-0001", VoucherAmount: balanceAmount, CostAllocationId: 0, Remarks: null, EffectiveDate: new Date() };

                    // Add the new row to the grid
                    dataSource.push(newRow);
                    $("#costdataGrid").dxDataGrid("instance").option("dataSource", dataSource);
                    // DevExpress.ui.notify("Balance amount of " + balanceAmount + " added as a new row.", "success", 2000);
                }
            }
        }).dxDataGrid("instance");
    });





</script>