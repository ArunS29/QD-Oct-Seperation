    $("#btnCostSaveAndClose").dxButton("instance").option("onClick", function () {
        let grid = $("#costdataGrid").dxDataGrid("instance");
        let allRowsData = grid.getDataSource().items();
        let journalchildno = parseInt('@voucherEntryNo'.trim(), 10);
        let voucherno = '@voucherNo';
        

        let costAllocations = allRowsData.map(row => ({
            CostAllocationId: row.CostAllocationId || 0, // 0 if it's a new record
            CostAllocDrCr: row.DrCr,
            CostAllocationUnitId: row.CostAllocationUnitId,
            EffectiveDate: row.EffectiveDate ? new Date(row.EffectiveDate).toISOString() : null,
            AmountAllocated: row.VoucherAmount,
            CostAllocRemarks: row.Remarks,
            JournalChildNo: journalchildno,
            VoucherNo: voucherno
        }));


        // Optional: validate before sending

        $.ajax({
            type: "POST",
            url: "/api/JournalEntryEdit/SaveCostAllocations", // adjust area/controller path if needed
            contentType: "application/json",
            data: JSON.stringify(costAllocations),
            success: function (response) {
                
                Closepopup();
                DevExpress.ui.dialog.alert(
                    "Cost Allocation Details updated Successfully.",
                    "Update Successful"
                ).then(function () {
                    setTimeout(function () {
                        loadLedgerGridData('@voucherNo');
                    }, 500);
                    if (popupInstances[journalchildno]) {
                        popupInstances[journalchildno].hide();
                    }
                });

                //     window.location.reload();
                // CostAllocationPopup.hide();
                // Hide the popup
                
            },
            error: function (xhr) {
                DevExpress.ui.notify("Error saving data: " + xhr.responseText, "error", 4000);
            }
        });
    });


