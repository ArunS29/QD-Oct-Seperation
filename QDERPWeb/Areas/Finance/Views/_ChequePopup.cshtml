@page
@model QD.ERP.Web.Areas.Finance.Views._ChequePopupModel
@{
    Layout = null; // This ensures it's loaded as a partial
}

<div id="chequePopupContainer">
    @(
        Html.DevExtreme().Popup()
        .ID("chequePopup")
        .Title(new JS("formatMessage('Bank Cheque Printing')"))
        .Visible(false)
        .HideOnOutsideClick(false)
        .ShowCloseButton(true) // Display close button
        .Width(1000)
        .Height(450)
        .ContentTemplate(@<div class="background" style="padding: 10px;">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    @(Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Cheque No')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("ChequeNo")
                    .Value(null)
                    .ValidationRules(rules =>
                    {
                    rules.AddRequired()
                    .Message(new JS("formatMessage('ChequeNo is required')"));
                    })
                    .ElementAttr(new { style = "background-color: lightGrey; color: darkgrey;" })
                    )


                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @(Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Voucher No')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("PopVoucherNo")
                    .Value(null)
                    .Disabled(true)
                    .ElementAttr(new { style = "background-color: lightGrey; color: darkgrey;" }) // Set color styles

                    )
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @(Html.DevExtreme().DateBox()
                    .Label(new JS("formatMessage('Cheque Date')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("ChequeDate")
                    .InputAttr("aria-label", "Date")
                    .LabelMode(EditorLabelMode.Outside)
                    .Type(DateBoxType.Date)
                    .DisplayFormat("dd-MMM-yyyy")
                    .Value(DateTime.Now)
                    )
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @(Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('Place of Issue')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("PlaceofIssue")
                    .ValidationRules(rules =>
                    {
                    rules.AddRequired()
                    .Message("PlaceofIssue is required");
                    })
                    .Value(null)
                    )
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-md-12">

                <div class="form-group">
                    <label for="ChequeIssuedinfavourof" class="button-alignment-down"></label>
                    <div class="btn" style="position:relative;display:flex;gap: 10px;justify-content: start;align-items: baseline;">
                        @(Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Cheque Issued in favour of')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ChequeIssuedinfavourof")
                        .Width(650)
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired()
                        .Message("Cheque Issued in favour of is required");
                        })
                        .Value(null) )
                        @(Html.DevExtreme().Button()
                        .ID("popupbtnAddAHead")
                        .Icon("plus")
                        .OnClick("function() { onPopupAddButtonClick(); }")
                        )
                        <div style="margin-top:10px;color:blue" >Use Ledger Account Name</div>
                    </div>

                   
                </div>
            </div>

        </div>



        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @(Html.DevExtreme().TextBox()
                    .Label(new JS("formatMessage('AmountinWords')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("AmountinWords")
                    .Value("No Riyals Only.")
                    .ValidationRules(rules =>
                    {
                    rules.AddRequired()
                    .Message("Amount in Words is required");
                    })
                    )
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @(Html.DevExtreme().NumberBox()
                    .Label(new JS("formatMessage('AmountinSAR')"))
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("AmountinSAR")
                    .Width(150)
                    .Value(0)
                    .ShowSpinButtons(true)
                    .Min(0)
                    .Format("###,###,###,##0.00")  // Numeric format with thousands separator and two decimal places
                    .InputAttr(new { type = "number", step = "1.00",  maxLength = 16, autocomplete = "off" })
                    .Step(1))
                </div>
            </div>
      
            <div class="row">
                 <div class="col-md-3">
   <div class="form-group">
@(Html.DevExtreme().SelectBox()
    .ID("txtbasecurrency")
    .Label("Base Currency")
    .LabelMode(EditorLabelMode.Outside)
    .DataSource(d => d.WebApi()
        .Controller("Utility")
        .LoadAction("GetCurrencyList")
        .LoadMode(DataSourceLoadMode.Raw)
        .Key("CurrencyID")
    )
    .Value("SAR")
    .ValueExpr("CurrencyID")
    .DisplayExpr("CurrencyName")
    .Placeholder("Select Base Currency")
    .Width(200)
)

   </div>
   </div>
    <div class="col-md-3">
      <div class="form-group">
@(Html.DevExtreme().SelectBox()
    .ID("txttxcurrency")
    .Label("Convertion Currency")
    .LabelMode(EditorLabelMode.Outside)
    .DataSource(d => d.WebApi()
        .Controller("Utility")
        .LoadAction("GetCurrencyList")
        .LoadMode(DataSourceLoadMode.Raw)
        .Key("CurrencyID")
    )
    .Value("SAR")
    .ValueExpr("CurrencyID")
    .DisplayExpr("CurrencyName")
    .Placeholder("Select To Currency")
    .Width(200)
)
</div>
   </div>
    <div class="col-md-3">
        <div class="form-group">
                @(Html.DevExtreme().TextBox()
                    .Label("Convertion Rate")
                    .LabelMode(EditorLabelMode.Outside)
                    .ID("txtchequeCurrencyRate")
                    .Value("")
                    .Placeholder("Enter convertion Rate")
                    .Width(160)
                    )
            </div>
            </div>
        </div>
        </div>
   

        <div class="dx-fieldset horizontal-container mt-2">

            @(Html.DevExtreme().Button()
            .ID("PopSave")
            .Text(new JS("formatMessage('Save')"))
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("save")
            .OnClick("function() { SavePopVoucherEntry(); }")
            .ElementAttr(new { @class = "bold-button" }) 
            )
            @(Html.DevExtreme().Button()
            .ID("btnSaveAndClose")
            .Text(new JS("formatMessage('Save and Close')"))
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("save")
            .OnClick("function() { SavePopCloseVoucherEntry(); }")
            .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
            )
            
            @(Html.DevExtreme().Button()
            .ID("btnPrint")
            .Text(new JS("formatMessage('Print')"))
            .Icon("print")
            .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
            .OnClick("function() { exportDataGridToPDF('dataGrid'); }")
            )
            @(Html.DevExtreme().Button()
            .ID("btnDelete")
            .Text(new JS("formatMessage('Delete')"))
            .Icon("close")
            .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
            .OnClick("function() { onDeleteButtonClick(); }") // Trigger the onClick event
            )

            @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text(new JS("formatMessage('Back')"))
            .Icon("arrowleft")
            .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
            .OnClick("function() { closeChequePopup(); }")
            )

        </div>
    </div>)
        )
</div>

<script>
    function closeChequePopup() {
        $("#chequePopup").dxPopup("instance").hide();
    }

    function SavePopVoucherEntry() {
        var chequeNo = $("#ChequeNo").dxTextBox("instance").option("value");

        var voucherNo = $("#PopVoucherNo").dxTextBox("instance").option("value"); // Get VoucherNo

        if (!chequeNo) {
            DevExpress.ui.notify("Cheque No is required", "error", 2000);
            return;
        }

        // Check if Cheque No already exists, excluding the current voucher
        $.ajax({
            type: "GET",
            url: "/api/VoucherMaster/CheckChequeExists",
            data: { chequeNo: chequeNo, voucherNo: voucherNo },
            success: function (exists) {
                if (exists) {
                    DevExpress.ui.notify("Cheque No already exists", "error", 2000);
                } else {
                    // If Cheque No does not exist, proceed with saving
                    saveChequeDetails(chequeNo, voucherNo);
                }
            },
            error: function (xhr, status, error) {
                alert("Error occurred while checking Cheque No: " + error);
            }
        });
    }

    // Function to save cheque details
    function saveChequeDetails(chequeNo, voucherNo) {
           var baseCurrency = $("#txtbasecurrency").dxSelectBox("instance");
    if (!baseCurrency) {
        DevExpress.ui.notify("Base Currency dropdown is not initialized.", "error", 2000);
        return;
    }
     var data = {
        "ChequeNo": chequeNo,
        "VoucherNo": voucherNo,
        "ChequeDate": $("#ChequeDate").dxDateBox("instance").option("value"),
        "PlaceOfIssue": $("#PlaceofIssue").dxTextBox("instance").option("value"),
        "currencyid": $("#txttxcurrency").dxSelectBox("instance").option("value"),
        "Currencyrate": $("#txtchequeCurrencyRate").dxTextBox("instance").option("value"),
        "basecurrencyid": baseCurrency.option("value")
    };

        debugger;
        $.ajax({
            type: "POST",
            url: "/api/VoucherMaster/SaveChequeDetails",
            contentType: "application/json",
            data: JSON.stringify(data),
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 2000);
                    var button = $("#PopSave").dxButton("instance");
                    button.option("text", "Update");
                } else {
                    alert("Update failed: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert("Error occurred while updating data: " + error);
            }
        });
    }
    $(function () {
        const popup = $("#chequePopup").dxPopup("instance"); // Popup instance
        const chequeboxNo = $("#ChequeNoReferenceNo").dxTextBox("instance").option("value");
        const chequeBox = $("#ChequeNo").dxTextBox("instance");
        if (chequeBox) {
            chequeBox.option("value", chequeboxNo);
        }
        // Initialize event when popup is shown
        popup.on("shown", function () {
            const amountInSAR = $("#AmountinSAR").dxNumberBox("instance");
            const amountInWords = $("#AmountinWords").dxTextBox("instance");

            if (amountInSAR && amountInWords) {
                // Attach valueChanged event to AmountinSAR NumberBox
                amountInSAR.on("valueChanged", function (e) {
                    const numValue = e.value || 0; // Get the new value, default to 0

                    const words = numberToWords(numValue) + " Saudi Riyals Only"; // Convert to words and append
                    amountInWords.option("value", words); // Update AmountinWords TextBox
                });
            }
        });

        // Number-to-words conversion function
        function numberToWords(number) {
            const units = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"];
            const teens = ["Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
            const tens = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];
            const scales = ["", "Thousand", "Million", "Billion"];

            if (number === 0) return "Zero";

            let words = "";

            const numToWords = (n) => {
                if (n < 10) return units[n];
                if (n < 20) return teens[n - 10];
                if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 > 0 ? " " + units[n % 10] : "");
                if (n < 1000)
                    return (
                        units[Math.floor(n / 100)] +
                        " Hundred" +
                        (n % 100 > 0 ? " " + numToWords(n % 100) : "")
                    );
            };

            let scaleIndex = 0;

            while (number > 0) {
                const chunk = number % 1000;
                if (chunk > 0) {
                    words =
                        numToWords(chunk) +
                        (scales[scaleIndex] ? " " + scales[scaleIndex] : "") +
                        (words ? " " + words : "");
                }
                number = Math.floor(number / 1000);
                scaleIndex++;
            }

            return words.trim();
        }
    });
    function onPopupAddButtonClick() {
        if (accheadname == null) {
            DevExpress.ui.notify("Please select an Account Head...!", "error", 2000);
        }
        else {
            $("#ChequeIssuedinfavourof").dxTextBox("instance").option("value", accheadname);

        }

    }

    function SavePopCloseVoucherEntry() {
        var chequeNo = $("#ChequeNo").dxTextBox("instance").option("value");
        var voucherNo = $("#PopVoucherNo").dxTextBox("instance").option("value"); // Get VoucherNo

        if (!chequeNo) {
            DevExpress.ui.notify("Cheque No is required", "error", 2000);
            return;
        }

        // Check if Cheque No already exists, excluding the current voucher
        $.ajax({
            type: "GET",
            url: "/api/VoucherMaster/CheckChequeExists",
            data: { chequeNo: chequeNo, voucherNo: voucherNo },
            success: function (exists) {
                if (exists) {
                    DevExpress.ui.notify("Cheque No already exists", "error", 2000);
                } else {
                    // If Cheque No does not exist, proceed with saving
                    saveCloseChequeDetails(chequeNo, voucherNo);
                }
            },
            error: function (xhr, status, error) {
                alert("Error occurred while checking Cheque No: " + error);
            }
        });
    }
    function onDeleteButtonClick() {
        var chequeNo = $("#ChequeNo").dxTextBox("instance").option("value");

        if (!chequeNo) {
            DevExpress.ui.notify("Cheque No is required to delete.", "error", 2000);
            return;
        }
        
        // Confirm deletion
        DevExpress.ui.dialog.confirm("Are you sure you want to delete this cheque?", "Delete Cheque").done(function (dialogResult) {
            
            if (dialogResult) {
                // Perform the delete operation
                
                $.ajax({
        
                    type: "POST",
                    url: "/api/VoucherMaster/DeleteCheque",
                    contentType: "application/json",
                    
                    data: JSON.stringify(chequeNo), // Send chequeNo as a plain string
                    success: function (response) {
                        if (response.success) {
                            DevExpress.ui.notify(response.message, "success", 2000);
                            closeChequePopup(); // Close the popup after deletion
                        } else {
                            DevExpress.ui.notify(response.message, "error", 2000);
                        }
                    },
                    error: function (xhr, status, error) {
                        DevExpress.ui.notify("Error occurred while deleting the cheque: " + error, "error", 2000);
                    }
                });
            }
        });
    }



    function saveCloseChequeDetails(chequeNo, voucherNo) {
           var baseCurrency = $("#txtbasecurrency").dxSelectBox("instance");
    if (!baseCurrency) {
        DevExpress.ui.notify("Base Currency dropdown is not initialized.", "error", 2000);
        return;
    }
         var data = {
        "ChequeNo": chequeNo,
        "VoucherNo": voucherNo,
        "ChequeDate": $("#ChequeDate").dxDateBox("instance").option("value"),
        "PlaceOfIssue": $("#PlaceofIssue").dxTextBox("instance").option("value"),
        "currencyid": $("#txttxcurrency").dxSelectBox("instance").option("value"),
        "Currencyrate": $("#txtchequeCurrencyRate").dxTextBox("instance").option("value"),
        "basecurrencyid": baseCurrency.option("value")
    };

        $.ajax({
            type: "POST",
            url: "/api/VoucherMaster/SaveChequeDetails",
            contentType: "application/json",
            data: JSON.stringify(data),
            dataType: "json",
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify("Cheque Information Updated sucessfully!", "success", 2000);
                    var button = $("#PopSave").dxButton("instance");
                    button.option("text", "Update");
                    closeChequePopup();

                } else {
                    alert("Update failed: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert("Error occurred while updating data: " + error);
            }
        });
    }
</script>
