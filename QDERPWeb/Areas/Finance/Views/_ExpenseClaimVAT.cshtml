                SupplierName: $("#suppliername").dxDropDownBox("instance").option("value"),
                SupplierVATNo: $("#suppliervatno").dxTextBox("instance").option("value"),
                SupplierNameAr: $("#ar_supplierName").dxTextBox("instance").option("value"),
                PurchaserName: $("#purchaserName").dxTextBox("instance").option("value"),
                LineNarration: $("#linenarration").dxTextArea("instance").option("value"),
                VATApplicableRate: parseInt($("#taxpercentage").dxDropDownBox("instance").option("value"), 10),
                EmployeeNo: $("#costemployees").dxDropDownBox("instance").option("value"),
                PropertyNo: $("#costproperty").dxDropDownBox("instance").option("value"),
                IsTaxIncluded: true
            };

            $.ajax({
                url: '/api/ExpenseClaim/SaveExpenseClaimEntry',
                type: 'POST',
                data: JSON.stringify(data),
