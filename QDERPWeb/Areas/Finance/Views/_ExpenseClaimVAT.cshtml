    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dataGridpercentageSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#taxpercentage").dxDropDownBox("instance");
        spentry = selectedKey;
        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
            var selectedRowData = $("#percentage-datagrid").dxDataGrid("instance").getSelectedRowsData();
            // Get ReferenceNo from selected row
            if (selectedRowData.length > 0) {
                paymentaccheadId = selectedRowData[0].CostAllocationUnitId;
                paymentaccheadname = selectedRowData[0].CostAllocationUnit;




            }
        }

    }
    function dataGridInitialized(e) {
        dataGrid = e.component;
    }
    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();
         

        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    
    function onTaxBoxClosed(e) {
        const typedText = e.component.option("text");
        const grid = $(e.component.content()).find("#percentage-datagrid").first().dxDataGrid("instance");

        if (!grid) return;

        const visibleRows = grid.getVisibleRows();
        const match = visibleRows.find(r => r.data.PurchaseTaxSlab === typedText);

        if (!match) {
            // Clear the value if not valid
            e.component.option("value", null);

        }
    }
    function dataGridsupplierSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#suppliername").dxDropDownBox("instance");
        spentry = selectedKey;
        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
            var selectedRowData = $("#suppliername-datagrid").dxDataGrid("instance").getSelectedRowsData();
            // Get ReferenceNo from selected row
            if (selectedRowData.length > 0) {
                
                const supplierVatNo = selectedRowData[0].SupplierVatno;

                // Set the Supplier VAT No into the textbox
                $("#suppliervatno").dxTextBox("instance").option("value", supplierVatNo);


            }
        }

    }
    // Fetch translated Arabic text using MyMemory API
    async function translateToArabic(text) {
        try {
            const response = await fetch(
                `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|ar`
            );
            const data = await response.json();
            return data.responseData.translatedText;
        } catch (error) {
            console.error("Translation failed:", error);
            return "Translation Error";
        }
    }
    // Translate value from one DevExtreme TextBox to another
    async function translateFieldToArabic(sourceId, targetId) {
        const sourceInstance = $(`#${sourceId}`).dxDropDownBox("instance");
        const targetInstance = $(`#${targetId}`).dxTextBox("instance");

        if (!sourceInstance || !targetInstance) {
            console.error("TextBox instances not initialized.");
            alert("Textbox instances not found. Check IDs and that DevExtreme is loaded.");
            return;
        }

        const englishText = sourceInstance.option("value");
        if (!englishText || englishText.trim() === "") {
            alert("Please enter text to translate.");
            return;
        }

        const arabicTranslation = await translateToArabic(englishText);
        targetInstance.option("value", arabicTranslation);
    }
