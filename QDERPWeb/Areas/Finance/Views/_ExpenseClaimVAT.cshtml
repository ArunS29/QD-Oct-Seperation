    $(function () {
        $("#calculateVAT").dxButton("instance").option("onClick", function () {
            
            // Step 1: Get billAmount and roundoff values
            let billAmount = $("#billAmount").dxNumberBox("instance").option("value");
            const roundoff = $("#roundoff").dxNumberBox("instance").option("value");

            // Step 2: Adjust billAmount if roundoff is provided
            if (roundoff && !isNaN(roundoff) && roundoff > 0) {
                billAmount += roundoff;
            }

            // Step 3: Get selected text from DropDownBox
            const selectedItem = $("#taxpercentage").dxDropDownBox("instance").option("text");

            if (!selectedItem) {
                DevExpress.ui.notify("Please select a Tax Percentage.", "warning", 2000);
                return;
            }

            // Step 4: Extract percentage from the selected text
            const match = selectedItem.match(/^(\d+(?:\.\d+)?)%/);
            if (!match) {
                DevExpress.ui.notify("Invalid Tax Percentage format.", "error", 2000);
                return;
            }

            const vatPercent = parseFloat(match[1]);

            // Step 5: Calculate taxable and VAT amount
            const taxableAmount = billAmount / (1 + vatPercent / 100);
            const vatAmount = billAmount - taxableAmount;

            // Step 6: Set values
            $("#taxableamount").dxNumberBox("instance").option("value", taxableAmount.toFixed(2));
            $("#vatAmount").dxNumberBox("instance").option("value", vatAmount.toFixed(2));
        });
