    // Fetch translated Arabic text using MyMemory API
 
    // Translate value from one DevExtreme TextBox to another
    async function translateFieldToArabic(sourceId, targetId) {
        const sourceInstance = $(`#${sourceId}`).dxDropDownBox("instance");
        const targetInstance = $(`#${targetId}`).dxTextBox("instance");

        if (!sourceInstance || !targetInstance) {
            console.error("TextBox instances not initialized.");
            alert("Textbox instances not found. Check IDs and that DevExtreme is loaded.");
            return;
        }

        const englishText = sourceInstance.option("value");
        if (!englishText || englishText.trim() === "") {
            alert("Please enter text to translate.");
            return;
        }

        const arabicTranslation = await translateToArabic(englishText);
        targetInstance.option("value", arabicTranslation);
    }
