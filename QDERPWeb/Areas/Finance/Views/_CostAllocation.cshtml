    $(document).ready(function () {
        const dataGrid = $("#costdataGrid").dxDataGrid("instance");
           dataGrid.option("onRowUpdating", function (e) {
                
                        const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
                        const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
                        const drCr = '@drCr';
                        const accountHead = '@accountHead';
                        const voucherno = '@voucherNo'; // You declared this in your message
                        
                    const oldData = e.oldData;
                    const newData = e.newData;

                     const updatedAmount = newData.VoucherAmount !== undefined ? parseFloat(newData.VoucherAmount) : parseFloat(oldData.VoucherAmount) / currencyRate;
                     const originalAmount = parseFloat(oldData.VoucherAmount) / currencyRate;

                    // Check if VoucherAmount changed
                    const isVoucherAmountChanged = newData.VoucherAmount !== undefined && updatedAmount !== originalAmount;
                    if (updatedAmount <=  0 ) {
                        DevExpress.ui.notify("Negative or invalid voucher amounts are not allowed.", "warning", 3000);
                        e.cancel = true;
                        return;
                    }


                    // Prevent increasing the amount
                    if (isVoucherAmountChanged && updatedAmount > originalAmount) {
                        DevExpress.ui.notify("Updated amount cannot be greater than the original amount.", "warning", 3000);
                        e.cancel = true;
                        return;
                    }

                    // Cancel default update — we'll do it manually
                    e.cancel = true;

                    // Case 1: Amount changed and is lower than original — split
                    if (isVoucherAmountChanged && updatedAmount < originalAmount) {
                        const remainingAmount = originalAmount - updatedAmount;
                        const updateAmount = updatedAmount * currencyRate;
                        const remainAmount = remainingAmount * currencyRate;
                        const adjustOldRow = {
                            CostAllocationId: oldData.CostAllocationId,
                            VoucherAmount: updateAmount,
                            CostAllocRemarks: newData.CostAllocRemarks ?? oldData.CostAllocRemarks,
                            CostAllocationUnitId: newData.CostAllocationUnitId ?? oldData.CostAllocationUnitId,
                            EffectiveDate: newData.EffectiveDate ?? oldData.EffectiveDate
                        };

                                                const newRow = {
                                                    CostAllocationId: 0,
                                                    CostAllocDrCr: drCr,
                                                    CostAllocationUnitId:  'ADMIN-0001',
                                                    EffectiveDate: new Date(),
                                                     AmountAllocated: remainAmount.toFixed(2),
                                                    CostAllocRemarks: null,
                                                    VoucherEntryId: VoucherEntryId,
                                                    VoucherNo: voucherno,
                                                    CurrencyRate: Number(currencyRate)
                                                };

                        // Update old amount first
                        $.ajax({
                            type: "POST",
                            url: "/api/CostAllocation/UpdateCostAllocationWithFields",
                            contentType: "application/json",
                            data: JSON.stringify(adjustOldRow),
                            success: function () {
                                // Insert new row
                                $.ajax({
                                    type: "POST",
                                    url: "/api/CostAllocation/InsertDefaultCostAllocation",
                                    contentType: "application/json",
                                    data: JSON.stringify(newRow),
                                    success: function (refreshedData) {
                                        $.ajax({
                                                url: `/api/CostAllocation/GetCostAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
                                                type: 'GET',
                                                success: function (refreshedData) {
                                                    dataGrid.option('dataSource', refreshedData);
                                                },
                                                error: function () {
                                                    DevExpress.ui.notify("Failed to refresh cost allocation data after insert.", "error", 4000);
                                                }
                                        });
                                    },
                                    error: function () {
                                        DevExpress.ui.notify("Failed to insert new cost allocation.", "error", 3000);
                                    }
                                });
                            },
                            error: function () {
                                DevExpress.ui.notify("Failed to update original cost allocation.", "error", 3000);
                            }
                        });
                    }
                    // Case 2: Other fields updated — update existing row directly
                    else {
                         const updateAmount = updatedAmount * currencyRate;
                        const updateRow = {
                            CostAllocationId: oldData.CostAllocationId,
                            VoucherAmount: updateAmount,
                            CostAllocRemarks: newData.Remarks ?? oldData.Remarks,
                            CostAllocationUnitId: newData.CostAllocationUnitId ?? oldData.CostAllocationUnitId,
                            EffectiveDate: newData.EffectiveDate ?? oldData.EffectiveDate
                        };

                        $.ajax({
                            type: "POST",
                            url: "/api/CostAllocation/UpdateCostAllocationWithFields",
                            contentType: "application/json",
                            data: JSON.stringify(updateRow),
                            success:  function () {
                               
                               $.ajax({
                                                url: `/api/CostAllocation/GetCostAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
                                                type: 'GET',
                                                success: function (Data) {
                                                     dataGrid.option('dataSource', Data);
                                                    dataGrid.refresh(); // ✅ Fix: Properly call refresh
                                                    dataGrid.cancelEditData(); // ✅ Fix: Exit edit mode
                                                },
                                                error: function () {
                                                    DevExpress.ui.notify("Failed to refresh cost allocation data after insert.", "error", 4000);
                                                }
                               });
                            },
                            error: function () {
                                DevExpress.ui.notify("Failed to update cost allocation.", "error", 3000);
                            }
                        });
                    }
           });
           dataGrid.option("onRowRemoving", function (e) {
               
                const rowData = e.data;
                const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
                const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
                const drCr = '@drCr';
                const voucherno = '@voucherNo';

                e.cancel = true; // Cancel default deletion — we handle it manually

                const allRows = dataGrid.option("dataSource");

                if (allRows.length === 1) {
                    // Only one row - call confirmDelete
                    confirmDelete();
                    return;
                }

                const deletedRowIndex = allRows.findIndex(row => row.CostAllocationId === rowData.CostAllocationId);
                if (deletedRowIndex == 0) {
                    const previousRow = allRows[deletedRowIndex + 1];
                    const currentRow = allRows[deletedRowIndex];
                    const CostAllocationId = currentRow.CostAllocationId;;


                    const updatedPreviousRow = {
                        CostAllocationId: previousRow.CostAllocationId,
                        VoucherAmount: parseFloat(previousRow.VoucherAmount) + parseFloat(rowData.VoucherAmount),
                        CostAllocRemarks: previousRow.CostAllocRemarks,
                        CostAllocationUnitId: previousRow.CostAllocationUnitId,
                        EffectiveDate: previousRow.EffectiveDate
                    };

                    // Step 1: Update previous row
                    $.ajax({
                           type: "POST",
                            url: `/api/CostAllocation/DeleteCostAllocation?costAllocationId=${CostAllocationId}`,
                            contentType: "application/json",

                        success: function () {
                            // Step 2: Delete selected row
                            $.ajax({
                                    type: "POST",
                                    url: "/api/CostAllocation/UpdateCostAllocationWithFields",
                                    contentType: "application/json",
                                    data: JSON.stringify(updatedPreviousRow),
                                success: function () {
                                    // Step 3: Refresh grid
                                    $.ajax({
                                        url: `/api/CostAllocation/GetCostAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
                                        type: 'GET',
                                        success: function (refreshedData) {
                                            dataGrid.option('dataSource', refreshedData);
                                            dataGrid.refresh();
                                        },
                                        error: function () {
                                            DevExpress.ui.notify("Failed to refresh cost allocation data after deletion.", "error", 4000);
                                        }
                                    });
                                },
                                error: function () {
                                    DevExpress.ui.notify("Failed to delete selected cost allocation row.", "error", 3000);
                                }
                            });
                        },
                        error: function () {
                            DevExpress.ui.notify("Failed to update previous row with merged amount.", "error", 3000);
                        }
                    });
                } else {
                    // DevExpress.ui.notify("Cannot merge the first row with any previous entry.", "warning", 3000);
                }

                if (deletedRowIndex > 0) {
                    const previousRow = allRows[deletedRowIndex - 1];
                    const currentRow = allRows[deletedRowIndex];
                    const CostAllocationId = currentRow.CostAllocationId;;


                    const updatedPreviousRow = {
                        CostAllocationId: previousRow.CostAllocationId,
                        VoucherAmount: parseFloat(previousRow.VoucherAmount) + parseFloat(rowData.VoucherAmount),
                        CostAllocRemarks: previousRow.CostAllocRemarks,
                        CostAllocationUnitId: previousRow.CostAllocationUnitId,
                        EffectiveDate: previousRow.EffectiveDate
                    };

                    // Step 1: Update previous row
                    $.ajax({
                           type: "POST",
                            url: `/api/CostAllocation/DeleteCostAllocation?costAllocationId=${CostAllocationId}`,
                            contentType: "application/json",
                            
                        success: function () {
                            // Step 2: Delete selected row
                            $.ajax({
                                    type: "POST",
                                    url: "/api/CostAllocation/UpdateCostAllocationWithFields",
                                    contentType: "application/json",
                                    data: JSON.stringify(updatedPreviousRow),
                                success: function () {
                                    // Step 3: Refresh grid
                                    $.ajax({
                                        url: `/api/CostAllocation/GetCostAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
                                        type: 'GET',
                                        success: function (refreshedData) {
                                            dataGrid.option('dataSource', refreshedData);
                                            dataGrid.refresh();
                                        },
                                        error: function () {
                                            DevExpress.ui.notify("Failed to refresh cost allocation data after deletion.", "error", 4000);
                                        }
                                    });
                                },
                                error: function () {
                                    DevExpress.ui.notify("Failed to delete selected cost allocation row.", "error", 3000);
                                }
                            });
                        },
                        error: function () {
                            DevExpress.ui.notify("Failed to update previous row with merged amount.", "error", 3000);
                        }
                    });
                } else {
                    // DevExpress.ui.notify("Cannot merge the first row with any previous entry.", "warning", 3000);
                }
           });
            setTimeout(function () {
                let btnInstance = $("#btnCostDelete").dxButton("instance");
                if (btnInstance) {
                    btnInstance.on("click", function () {
                        DevExpress.ui.dialog.confirm("You are about to reset Cost allocation details for the voucher entry. Are you sure you want to reset the Cost Allocation?", "Are you sure?")
                            .done(function (result) {
                                if (result) {
                                   confirmDelete();
                                }
                            });
                    });
                } else {
                    console.error("btnCostDelete instance not found.");
                }
            }, 500);

        function confirmDelete() {
            const dataGrid = $("#costdataGrid").dxDataGrid("instance");

            const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
            const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
            const drCr = '@drCr';
            const voucherno = '@voucherNo';

            const visibleRowCount = dataGrid.getVisibleRows().length;

            const insertAndRefresh = () => {
                const newRow = {
                    CostAllocationId: 0,
                    CostAllocDrCr: drCr,
                    CostAllocationUnitId: 'ADMIN-0001',
                    EffectiveDate: new Date(),
                    AmountAllocated: initialVoucherAmount.toFixed(2),
                    CostAllocRemarks: null,
                    VoucherEntryId: VoucherEntryId,
                    VoucherNo: voucherno,
                    CurrencyRate: Number(currencyRate)
                };

                $.ajax({
                    type: "POST",
                    url: "/api/CostAllocation/InsertDefaultCostAllocation",
                    contentType: "application/json",
                    data: JSON.stringify(newRow),
                    success: function () {
                        $.ajax({
                            url: `/api/CostAllocation/GetCostAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
                            type: 'GET',
                            success: function (refreshedData) {
                                dataGrid.option('dataSource', refreshedData);
                            },
                            error: function () {
                                DevExpress.ui.notify("Failed to refresh cost allocation data.", "error", 4000);
                            }
                        });
                    },
                    error: function () {
                        DevExpress.ui.notify("Failed to insert default cost allocation.", "error", 3000);
                    }
                });
            };

            if (visibleRowCount > 0) {
                 const deleterequest = {

                                     VoucherEntryId: VoucherEntryId,
                                     VoucherNo: voucherno,


                 };
                $.ajax({
                    type: "POST",
                    url: "/api/CostAllocation/DeleteByVoucherNo",
                    contentType: "application/json",
                    data: JSON.stringify(deleterequest),
                    success: function () {
                        insertAndRefresh();
                    },
                    error: function () {
                        DevExpress.ui.notify("Failed to delete cost allocations.", "error", 3000);
                    }
                });
            } else {
                insertAndRefresh();
            }
        }
   });



