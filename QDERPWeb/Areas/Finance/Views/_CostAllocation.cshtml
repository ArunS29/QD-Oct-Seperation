    $("#btnCostmasterSaveAndClose").dxButton("instance").option("onClick", function () {
        let grid = $("#costdataGrid").dxDataGrid("instance");
        let allRowsData = grid.getDataSource().items();
        let voucherchildno = parseInt('@voucherEntryNo'.trim(), 10);
        let voucherno = '@voucherNo';
        let expectedVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0; // Parsed from Razor
        let CurrencyRate ='@currencyRate';
        // Sum the VoucherAmount from all rows
        let totalAmount = allRowsData.reduce((sum, row) => sum + (parseFloat(row.VoucherAmount) || 0), 0);

        // Compare rounded to 2 decimals
        if (Math.abs(totalAmount - expectedVoucherAmount) > 0.01) {
            DevExpress.ui.dialog.alert(
                `The total allocated amount (${totalAmount.toFixed(2)}) does not match the voucher amount (${expectedVoucherAmount.toFixed(2)}). Please adjust the cost allocations.`,
                "Amount Mismatch"
            );
            return; // Stop execution
        }

        // Prepare data for submission
        let costAllocations = allRowsData.map(row => ({
            CostAllocationId: row.CostAllocationId || 0,
            CostAllocDrCr: row.DrCr,
            CostAllocationUnitId: row.CostAllocationUnitId,
            EffectiveDate: row.EffectiveDate ? new Date(row.EffectiveDate).toISOString() : null,
            AmountAllocated: row.VoucherAmount ,
            CostAllocRemarks: row.Remarks,
            VoucherEntryId: voucherchildno,
            VoucherNo: voucherno
        }));

        // Submit to backend
        $.ajax({
            type: "POST",
            url: "/api/CostAllocation/SaveCostAllocations",
            contentType: "application/json",
            data: JSON.stringify(costAllocations),
            success: function (response) {
                DevExpress.ui.dialog.alert(
                    "Cost Allocation Details updated Successfully.",
                    "Update Successful"
                ).then(function () {
                    let popupInstance = $("#CostAllocationPopup").dxPopup("instance");
                    popupInstance.hide();
                });
            },
            error: function (xhr) {
                DevExpress.ui.notify("Error saving data: " + xhr.responseText, "error", 4000);
            }
        });
    });


    

