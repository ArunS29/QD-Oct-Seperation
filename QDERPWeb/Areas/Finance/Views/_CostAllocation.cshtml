    $("#btnCostmasterSaveAndClose").dxButton("instance").option("onClick", function () {
        let grid = $("#costdataGrid").dxDataGrid("instance");
        let allRowsData = grid.getDataSource().items();
        let voucherchildno = parseInt('@voucherEntryNo'.trim(), 10);
        let voucherno = '@voucherNo';
        

        let costAllocations = allRowsData.map(row => ({
            CostAllocationId: row.CostAllocationId || 0, // 0 if it's a new record
            CostAllocDrCr: row.DrCr,
            CostAllocationUnitId: row.CostAllocationUnitId,
            EffectiveDate: row.EffectiveDate ? new Date(row.EffectiveDate).toISOString() : null,
            AmountAllocated: row.VoucherAmount,
            CostAllocRemarks: row.Remarks,
            VoucherEntryId: voucherchildno,
            VoucherNo: voucherno
        }));


        // Optional: validate before sending

        $.ajax({
            type: "POST",
            url: "/api/CostAllocation/SaveCostAllocations", // adjust area/controller path if needed
            contentType: "application/json",
            data: JSON.stringify(costAllocations),
            success: function (response) {
               
                DevExpress.ui.dialog.alert(
                    "Cost Allocation Details updated Successfully.",
                    "Update Successful"
                ).then(function () {
                   let popupInstance = $("#CostAllocationPopup").dxPopup("instance");
                    popupInstance.hide();
                });

                //     window.location.reload();
