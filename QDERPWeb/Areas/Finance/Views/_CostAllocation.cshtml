    $(document).ready(function () {
        debugger;
            const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
            const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
            const drCr = '@drCr';
            const accountHead = '@accountHead';
            const voucherno = '@voucherNo'; // You declared this in your message
            const costdataGrid = $('#costdataGrid').dxDataGrid('instance');

            $.ajax({
                url: `/api/CostAllocation/GetCostAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
                type: 'GET',
                success: function (data) {
                    if (data && data.length > 0) {
                        costdataGrid.option('dataSource', data);
                    } else {
                        // Check if account is cost-allocated
                        $.ajax({
                            type: "GET",
                            url: "/api/CostAllocation/CheckCostAllocation",
                            data: { AccountHead: accountHead },
                            success: function (response) {
                                if (response.isAllocated) {
                                    // Create default row for backend insertion
                                    const newRow = {
                                        CostAllocationId: 0,
                                        CostAllocDrCr: drCr,
                                        CostAllocationUnitId:  'ADMIN-0001',
                                        EffectiveDate: new Date(),
                                        AmountAllocated: initialVoucherAmount.toFixed(2),
                                        CostAllocRemarks: null,
                                        VoucherEntryId: VoucherEntryId,
                                        VoucherNo: voucherno,
                                        CurrencyRate: Number(currencyRate)
                                    };

                                    // Save to backend
                                    $.ajax({
                                        type: "POST",
                                        url: "/api/CostAllocation/InsertDefaultCostAllocation",
                                        data: JSON.stringify(newRow),
                                        contentType: "application/json",
                                        success: function (insertedResponse) {
                                            // After successful insert, fetch updated data
                                            $.ajax({
                                                url: `/api/CostAllocation/GetCostAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
                                                type: 'GET',
                                                success: function (refreshedData) {
                                                    costdataGrid.option('dataSource', refreshedData);
                                                },
                                                error: function () {
                                                    DevExpress.ui.notify("Failed to refresh cost allocation data after insert.", "error", 4000);
                                                }
                                            });
                                        },
                                        error: function () {
                                            DevExpress.ui.notify("Failed to insert default cost allocation.", "error", 4000);
                                        }
                                    });
                                }
                            },
                            error: function () {
                                DevExpress.ui.notify("Failed to check cost allocation eligibility.", "error", 4000);
                            }
                        });
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Failed to load cost allocation data.", "error", 4000);
                }
            });

          
    

            $('#CostAmount').dxNumberBox({
                valueChanged: function (e) {
                    const newVoucherAmount = e.value.toFixed(2);
                    const updatedData = [{
                        DrCr: drCr,
                        EffectiveDate: new Date().toISOString(),
                        VoucherAmount: newVoucherAmount,
                        Remarks: ''
                    }];
                    costdataGrid.option('dataSource', updatedData);
