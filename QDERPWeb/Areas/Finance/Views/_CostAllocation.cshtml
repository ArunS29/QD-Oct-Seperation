    function gridBox_valueChanged(e) {
        var $dataGrid = $("#costdataGrid");

        if ($dataGrid.length) {
            var dataGrid = $dataGrid.dxDataGrid("instance");
            dataGrid.selectRows(e.value, false);
        }
        if (e.value) {
            let grid = $("#costdataGrid").dxDataGrid("instance");
            let rowIndex = e.element.closest("tr").index(); // Get the edited row index
            let rowData = grid.getVisibleRows()[rowIndex].data;

            let costAllocationDropdownGrid = $("#costAllocationDropdownGrid").dxDataGrid("instance");
            let selectedRowData = costAllocationDropdownGrid.getSelectedRowsData()[0]; // Get first selected row

            if (selectedRowData) {
                selectedCostAllocationUnitID = selectedRowData.CostAllocationUnitId; // Store the correct ID

            }

            rowData.CostAllocationUnit = e.value; // Update the row data
            grid.cellValue(rowIndex, "CostAllocationUnit", e.value); // Ensure it reflects in the grid

        }



        // Close the dropdown after selection
        e.component.option("opened", false);
    }

