             // Disable editing and deleting in DataGrid
             var gridInstance = $("#costdataGrid").dxDataGrid("instance");
             if (gridInstance) {
                 gridInstance.option("editing.allowUpdating", false);
                 gridInstance.option("editing.allowDeleting", false);
             }

             // Disable all buttons except btncostBack
             $(".dx-button").each(function () {
                  const allowedButtons = ['btnBack','btnPrints', 'btnPrintp', 'btnAttach', 'btnPrint', 'btnAddAHead', 'btncostBack'];
                 if (!allowedButtons.includes($(this).attr('id'))) {
                     $(this).dxButton("instance").option("disabled", true);
                 }
             });
              disableEditing();
         }
     });



