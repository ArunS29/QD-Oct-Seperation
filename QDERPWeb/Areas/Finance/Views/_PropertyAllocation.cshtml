	// Save Button Click
	$("#btnpropertySave").on("click", function (e) {
		e.preventDefault();
		debugger;
		let grid = $("#propertydataGrid").dxDataGrid("instance");
		let allRowsData = grid.getDataSource().items();
		let voucherchildno = parseInt('@voucherEntryNo'.trim(), 10);
		let voucherno = '@voucherNo';
		let accountid = '@accountId';


		let costAllocations = allRowsData.map(row => ({
			PropertyAllocationId: row.PropertyAllocationId || 0, // 0 if it's a new record
			PropertyNo: row.PropertyNo,
			EffectiveDate: row.EffectiveDate ? new Date(row.EffectiveDate).toISOString() : null,
			AmountAllocated: row.VoucherAmount,
			PropertyAllocRemarks: row.Remarks,
			VoucherNo: voucherno,
			VoucherEntryId: voucherchildno,
			PropertyAllocDrCr: row.DrCr,
			LedgerAccountNo: accountid
		}));


		// Optional: validate before sending

		$.ajax({
			type: "POST",
			url: "/api/PropertyAllocation/SavePropertyAllocations", // adjust area/controller path if needed
			contentType: "application/json",
			data: JSON.stringify(costAllocations),
			success: function (response) {

				DevExpress.ui.dialog.alert(
					"Property Allocation Details updated Successfully.",
					"Update Successful"
				).then(function () {
					let popupInstance = $("#PropertyAllocationPopup").dxPopup("instance");
					popupInstance.hide();
				});

