				hide: { type: "fade", duration: 300 }
			},
			position: {
				at: "center",
				my: "center",
				of: window
			}
		});
		

	});
		

	function applyRemarks() {
			const popup = $("#remarksPopup").dxPopup("instance");
			const newValue = $("#remarksTextBox").val();

			if (editingRowIndex !== null) {
				const grid = $("#propertydataGrid").dxDataGrid("instance");
				grid.cellValue(editingRowIndex, editingColumn, newValue);
			}

			popup.hide();
			editingRowIndex = null;
			editingColumn = null;
	}

		function cancelRemarks() {
			$("#remarksPopup").dxPopup("instance").hide();
			editingRowIndex = null;
			editingColumn = null;
		}
