<script>
	
	$(document).ready(function () {
		   const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
			const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
			const drCr = '@drCr';
			const accountHead = '@accountHead';
            const accountId = '@accountId';
			const voucherno = '@voucherNo'; // You declared this in your message
			const costdataGrid = $('#propertydataGrid').dxDataGrid('instance');

			$.ajax({
				url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
				type: 'GET',
				success: function (data) {
					if (data && data.length > 0) {
						costdataGrid.option('dataSource', data);
					} else {
						// Check if account is cost-allocated
						$.ajax({
							type: "GET",
							url: "/api/PropertyAllocation/CheckPropertyAllocation",
							data: { AccountHead: accountHead , AccountID: accountId},
							success: function (response) {
								if (response.isAllocated) {
									// Create default row for backend insertion
									const newRow = {
										PropertyAllocationId: 0,
										PropertyAllocDrCr: drCr,
										PropertyNo:  null,
										EffectiveDate: new Date(),
										AmountAllocated: initialVoucherAmount.toFixed(2),
										PropertyAllocRemarks: null,
										VoucherEntryId: VoucherEntryId,
										VoucherNo: voucherno,
                                        LedgerAccountNo: accountId
									};

									// Save to backend
									$.ajax({
										type: "POST",
										url: "/api/PropertyAllocation/InsertDefaultPropertyAllocation",
										data: JSON.stringify(newRow),
										contentType: "application/json",
										success: function (insertedResponse) {
											// After successful insert, fetch updated data
											$.ajax({
												url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
												type: 'GET',
												success: function (refreshedData) {
													costdataGrid.option('dataSource', refreshedData);
												},
												error: function () {
													DevExpress.ui.notify("Failed to refresh cost allocation data after insert.", "error", 4000);
												}
											});
										},
										error: function () {
											DevExpress.ui.notify("Failed to insert default cost allocation.", "error", 4000);
										}
									});
								}
							},
							error: function () {
								DevExpress.ui.notify("Failed to check cost allocation eligibility.", "error", 4000);
							}
						});
					}
				},
				error: function () {
					DevExpress.ui.notify("Failed to load cost allocation data.", "error", 4000);
				}
			});

		// Function to handle changes to the NumberBox value
		$('#propertyAmount').dxNumberBox({
			valueChanged: function (e) {
				const newVoucherAmount = e.value.toFixed(2);

				// Update the data in the DataGrid
				if (costdataGrid) {
					$.ajax({
						url: '/api/VoucherEntryReceipts/CheckPropertyAllocation',
						method: 'GET',
						data: { AccountHead: '@accountHead', AccountID: '@accountId' }, // Pass accountHead as a parameter
						success: function (response) {
							const updatedData = [{
								DrCr: '@drCr',
								CostAllocated: '',
								EffectiveDate: new Date().toLocaleDateString('en-GB', {
									day: 'numeric',
									month: 'short',
									year: 'numeric',
								}),
								VoucherAmount: newVoucherAmount,
								Remarks: 'N/A'
							}];

							costdataGrid.option('dataSource', updatedData);
						},
						error: function (xhr, status, error) {
							console.error('Error checking employee allocation:', error);
						}
					});
				}
			}
		});
	});

	

	function formatEffectiveDate(dateString) {
		if (!dateString) return 'N/A';

		const dateObj = new Date(dateString);
		const options = { day: 'numeric', month: 'short', year: 'numeric' };
		return dateObj.toLocaleDateString('en-GB', options).replace(/ /g, '-');
	}

