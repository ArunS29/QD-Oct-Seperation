	let editingRowIndex = null;
	let editingColumn = null;


	$(document).ready(function () {
		const dataGrid = $("#propertydataGrid").dxDataGrid("instance");
		   dataGrid.option("onRowUpdating", function (e) {
				debugger;
						const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
						const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
						const drCr = '@drCr';
						const accountHead = '@accountHead';
						const voucherno = '@voucherNo'; // You declared this in your message
						const accountId = '@accountId';

					const oldData = e.oldData;
					const newData = e.newData;

					const updatedAmount = newData.VoucherAmount !== undefined ? parseFloat(newData.VoucherAmount) : parseFloat(oldData.VoucherAmount);
					const originalAmount = parseFloat(oldData.VoucherAmount);

					// Check if VoucherAmount changed
					const isVoucherAmountChanged = newData.VoucherAmount !== undefined && updatedAmount !== originalAmount;
					if (updatedAmount <=  0 ) {
						DevExpress.ui.notify("Negative or invalid voucher amounts are not allowed.", "warning", 3000);
						e.cancel = true;
						return;
					}


					// Prevent increasing the amount
					if (isVoucherAmountChanged && updatedAmount > originalAmount) {
						DevExpress.ui.notify("Updated amount cannot be greater than the original amount.", "warning", 3000);
						e.cancel = true;
						return;
					}

					// Cancel default update — we'll do it manually
					e.cancel = true;

					// Case 1: Amount changed and is lower than original — split
					if (isVoucherAmountChanged && updatedAmount < originalAmount) {
						const remainingAmount = originalAmount - updatedAmount;

						const adjustOldRow = {
							PropertyAllocationId: oldData.PropertyAllocationId,
							VoucherAmount: updatedAmount,
							PropertyAllocRemarks: newData.PropertyAllocRemarks ?? oldData.PropertyAllocRemarks,
							PropertyNo: newData.PropertyNo ?? oldData.PropertyNo,
							EffectiveDate: newData.EffectiveDate ?? oldData.EffectiveDate
						};

									const newRow = {
										PropertyAllocationId: 0,
										PropertyAllocDrCr: drCr,
										PropertyNo:  null,
										EffectiveDate: new Date(),
										AmountAllocated: remainingAmount.toFixed(2),
										PropertyAllocRemarks: null,
										VoucherEntryId: VoucherEntryId,
										VoucherNo: voucherno,
										LedgerAccountNo: accountId
									};

						// Update old amount first
						$.ajax({
							type: "POST",
							url: "/api/PropertyAllocation/UpdatePropertyAllocationWithFields",
							contentType: "application/json",
							data: JSON.stringify(adjustOldRow),
							success: function () {
								// Insert new row
								$.ajax({
									type: "POST",
									url: "/api/PropertyAllocation/InsertDefaultPropertyAllocation",
									contentType: "application/json",
									data: JSON.stringify(newRow),
									success: function (refreshedData) {
										$.ajax({
												url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
												type: 'GET',
												success: function (refreshedData) {
													dataGrid.option('dataSource', refreshedData);
												},
												error: function () {
													DevExpress.ui.notify("Failed to refresh cost allocation data after insert.", "error", 4000);
												}
										});
									},
									error: function () {
										DevExpress.ui.notify("Failed to insert new cost allocation.", "error", 3000);
									}
								});
							},
							error: function () {
								DevExpress.ui.notify("Failed to update original cost allocation.", "error", 3000);
							}
						});
					}
					// Case 2: Other fields updated — update existing row directly
					else {
						const updateRow = {
							PropertyAllocationId: oldData.PropertyAllocationId,
							VoucherAmount: updatedAmount,
							PropertyAllocRemarks: newData.PropertyAllocRemarks ?? oldData.PropertyAllocRemarks,
							PropertyNo: newData.PropertyNo ?? oldData.PropertyNo,
							EffectiveDate: newData.EffectiveDate ?? oldData.EffectiveDate
						};

						$.ajax({
							type: "POST",
							url: "/api/PropertyAllocation/UpdatePropertyAllocationWithFields",
							contentType: "application/json",
							data: JSON.stringify(updateRow),
							success:  function () {

							   $.ajax({
												url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
												type: 'GET',
												success: function (Data) {
													 dataGrid.option('dataSource', Data);
													dataGrid.refresh(); // ✅ Fix: Properly call refresh
													dataGrid.cancelEditData(); // ✅ Fix: Exit edit mode
												},
												error: function () {
													DevExpress.ui.notify("Failed to refresh cost allocation data after insert.", "error", 4000);
												}
							   });
							},
							error: function () {
								DevExpress.ui.notify("Failed to update cost allocation.", "error", 3000);
							}
						});
					}
		   });
		   dataGrid.option("onRowRemoving", function (e) {
			   debugger;
				const rowData = e.data;
				const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
				const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
				const drCr = '@drCr';
				const voucherno = '@voucherNo';
				const accountId = '@accountId';

				e.cancel = true; // Cancel default deletion — we handle it manually

				const allRows = dataGrid.option("dataSource");

				if (allRows.length === 1) {
					// Only one row - call confirmDelete
					confirmDelete();
					return;
				}

				const deletedRowIndex = allRows.findIndex(row => row.PropertyAllocationId === rowData.PropertyAllocationId);
				if (deletedRowIndex == 0) {
					const previousRow = allRows[deletedRowIndex + 1];
					const currentRow = allRows[deletedRowIndex];
					const PropertyAllocationId = currentRow.PropertyAllocationId;;


					const updatedPreviousRow = {
						PropertyAllocationId: previousRow.PropertyAllocationId,
						VoucherAmount: parseFloat(previousRow.VoucherAmount) + parseFloat(rowData.VoucherAmount),
						PropertyAllocRemarks: previousRow.PropertyAllocRemarks,
						PropertyNo: previousRow.PropertyNo,
						EffectiveDate: previousRow.EffectiveDate
					};

					// Step 1: Update previous row
					$.ajax({
						   type: "POST",
							url: `/api/PropertyAllocation/DeletePropertyAllocation?propertyAllocationId=${PropertyAllocationId}`,
							contentType: "application/json",

						success: function () {
							// Step 2: Delete selected row
							$.ajax({
									type: "POST",
									url: "/api/PropertyAllocation/UpdatePropertyAllocationWithFields",
									contentType: "application/json",
									data: JSON.stringify(updatedPreviousRow),
								success: function () {
									// Step 3: Refresh grid
									$.ajax({
										url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
										type: 'GET',
										success: function (refreshedData) {
											dataGrid.option('dataSource', refreshedData);
											dataGrid.refresh();
										},
										error: function () {
											DevExpress.ui.notify("Failed to refresh cost allocation data after deletion.", "error", 4000);
										}
									});
								},
								error: function () {
									DevExpress.ui.notify("Failed to delete selected cost allocation row.", "error", 3000);
								}
							});
						},
						error: function () {
							DevExpress.ui.notify("Failed to update previous row with merged amount.", "error", 3000);
						}
					});
				} else {
					// DevExpress.ui.notify("Cannot merge the first row with any previous entry.", "warning", 3000);
				}

				if (deletedRowIndex > 0) {
					const previousRow = allRows[deletedRowIndex - 1];
					const currentRow = allRows[deletedRowIndex];
					const PropertyAllocationId = currentRow.PropertyAllocationId;;


					const updatedPreviousRow = {
						PropertyAllocationId: previousRow.PropertyAllocationId,
						VoucherAmount: parseFloat(previousRow.VoucherAmount) + parseFloat(rowData.VoucherAmount),
						PropertyAllocRemarks: previousRow.PropertyAllocRemarks,
						PropertyNo: previousRow.PropertyNo,
						EffectiveDate: previousRow.EffectiveDate
					};

					// Step 1: Update previous row
					$.ajax({
						   type: "POST",
							url: `/api/PropertyAllocation/DeletePropertyAllocation?propertyAllocationId=${PropertyAllocationId}`,
							contentType: "application/json",

						success: function () {
							// Step 2: Delete selected row
							$.ajax({
									type: "POST",
									url: "/api/PropertyAllocation/UpdatePropertyAllocationWithFields",
									contentType: "application/json",
									data: JSON.stringify(updatedPreviousRow),
								success: function () {
									// Step 3: Refresh grid
									$.ajax({
										url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
										type: 'GET',
										success: function (refreshedData) {
											dataGrid.option('dataSource', refreshedData);
											dataGrid.refresh();
										},
										error: function () {
											DevExpress.ui.notify("Failed to refresh cost allocation data after deletion.", "error", 4000);
										}
									});
								},
								error: function () {
									DevExpress.ui.notify("Failed to delete selected cost allocation row.", "error", 3000);
								}
							});
						},
						error: function () {
							DevExpress.ui.notify("Failed to update previous row with merged amount.", "error", 3000);
						}
					});
				} else {
					// DevExpress.ui.notify("Cannot merge the first row with any previous entry.", "warning", 3000);
				}
		   });
			setTimeout(function () {
				let btnInstance = $("#btnpropertyDelete").dxButton("instance");
				if (btnInstance) {
					btnInstance.on("click", function () {
						DevExpress.ui.dialog.confirm("You are about to reset Property allocation details for the voucher entry. Are you sure you want to reset the Cost Allocation?", "Are you sure?")
							.done(function (result) {
								if (result) {
								   confirmDelete();
								}
							});
					});
				} else {
					console.error("btnCostDelete instance not found.");
				}
			}, 500);

		function confirmDelete() {
				const dataGrid = $("#propertydataGrid").dxDataGrid("instance");

				const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
				const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
				const drCr = '@drCr';
				const voucherno = '@voucherNo';
				const accountId = '@accountId';


				// Step 1: Delete all by VoucherNo
				$.ajax({
					type: "POST",
					url: "/api/PropertyAllocation/DeleteByVoucherNo",
					contentType: "application/json",
					data: JSON.stringify({ voucherNo: voucherno }),
					success: function () {
						// Step 2: Insert default row
						const newRow = {
										PropertyAllocationId: 0,
										PropertyAllocDrCr: drCr,
										PropertyNo:  null,
										EffectiveDate: new Date(),
										AmountAllocated: initialVoucherAmount.toFixed(2),
										PropertyAllocRemarks: null,
										VoucherEntryId: VoucherEntryId,
										VoucherNo: voucherno,
										LedgerAccountNo: accountId
						};

						$.ajax({
							type: "POST",
							url: "/api/PropertyAllocation/InsertDefaultPropertyAllocation",
							contentType: "application/json",
							data: JSON.stringify(newRow),
							success: function () {
								// Step 3: Refresh grid
								$.ajax({
									url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
									type: 'GET',
									success: function (refreshedData) {
										dataGrid.option('dataSource', refreshedData);
									},
									error: function () {
										DevExpress.ui.notify("Failed to refresh cost allocation data.", "error", 4000);
									}
								});
							},
							error: function () {
								DevExpress.ui.notify("Failed to insert default cost allocation.", "error", 3000);
							}
						});
					},
					error: function () {
						DevExpress.ui.notify("Failed to delete cost allocations.", "error", 3000);
					}
				});

		}

		 // Attach onEditorPreparing
	  dataGrid.option("onEditorPreparing", function (e) {
		if (e.parentType === "dataRow" && e.dataField === "Remarks") {
			e.cancel = true; // Prevent default cell editor

			// Store the context for update
			editingRowIndex = e.row.rowIndex;
			editingColumn = e.dataField;

			// Show existing value in popup textarea
			const currentValue = e.row.data[editingColumn] || "";
			$("#remarksTextBox").val(currentValue);

			// Show the popup
			$("#remarksPopup").dxPopup("instance").show();
		}
	  });
	    $("#remarksPopup").dxPopup({
			width: 350,
