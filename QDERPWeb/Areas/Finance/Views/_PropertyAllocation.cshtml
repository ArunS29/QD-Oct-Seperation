			},
			error: function (xhr) {
				DevExpress.ui.notify("Error saving data: " + xhr.responseText, "error", 4000);
			}
		});
	});

	function gridBoxPropertyvalueChanged(e) {
		var $dataGrid = $("#propertydataGrid");

		if ($dataGrid.length) {
			var dataGrid = $dataGrid.dxDataGrid("instance");
			dataGrid.selectRows(e.value, false);
		}
		if (e.value) {
			let grid = $("#propertydataGrid").dxDataGrid("instance");
			let rowIndex = e.element.closest("tr").index(); // Get the edited row index
			let rowData = grid.getVisibleRows()[rowIndex].data;

			let costAllocationDropdownGrid = $("#propertyAllocationDropdownGrid").dxDataGrid("instance");
			let selectedRowData = costAllocationDropdownGrid.getSelectedRowsData()[0]; // Get first selected row

			if (selectedRowData) {
				rowData.PropertyNo = selectedRowData.PropertyNo;
				rowData.PropertyDescription = selectedRowData.PropertyDescription; // Update AccountHead
				grid.cellValue(rowIndex, "PropertyNo", selectedRowData.PropertyNo);
				grid.cellValue(rowIndex, "PropertyDescription", selectedRowData.PropertyDescription);// Store the correct ID

			}

			 // Ensure it reflects in the grid

		}



		// Close the dropdown after selection
		e.component.option("opened", false);
	}
	$(document).ready(function () {
		// Bind the click event to the Delete button
		$("#btnpropertyDelete").dxButton("instance").on("click", function () {
			// Show DevExpress confirmation dialog
			DevExpress.ui.dialog.confirm("You are about to reset Property allocation details for the voucher entry. Are you sure you want to reset the Cost Allocation?", "Are you sure?")
				.done(function (result) {
					if (result) {
						resetCostDataGrid();
					}
				});
		});
	});




	// Function to reset the DataGrid and reinitialize it
	function resetCostDataGrid() {
		
		const costdataGrid = $('#propertydataGrid').dxDataGrid('instance');

		if (costdataGrid) {
			costdataGrid.option('dataSource', []); // Clear the grid data
		}

		// Re-execute the script to reset the grid
		reinitializeGrid();
	}

	// Function to reinitialize the grid with default data
	function reinitializeGrid() {
		const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;

		const costData = [
			{
				DrCr: '@drCr',
				EffectiveDate: new Date().toLocaleDateString('en-GB', {
					day: 'numeric',
					month: 'short',
					year: 'numeric',
				}),
				VoucherAmount: initialVoucherAmount.toFixed(2),
				Remarks: ''
			}
		];

		const costdataGrid = $('#propertydataGrid').dxDataGrid('instance');

		if (costdataGrid) {
			costdataGrid.option('dataSource', costData); // Reload initial data
		}
	}


	function confirmDelete() {
		var dataGrid = $("#propertydataGrid").dxDataGrid("instance");
		var selectedRows = dataGrid.getSelectedRowKeys();

		if (selectedRows.length === 0) {
			DevExpress.ui.dialog.alert("Please select at least one row to delete.", "Warning");
			return;
		}

		DevExpress.ui.dialog.confirm("You are about to delete this line entry Item for the Property Allocated. Delete Line Item.", "Confirm Deletion").done(function (dialogResult) {
			if (dialogResult) {
				selectedRows.forEach(function (key) {
					dataGrid.getDataSource().store().remove(key).done(function () {
						dataGrid.refresh();
					}).fail(function (error) {
						console.error("Error deleting row:", error);
					});
				});
			}
		});
	}



	$(document).ready(function () {
		let dataGrid = $("#propertydataGrid").dxDataGrid("instance");

		// Handle right-click (context menu event)
		dataGrid.option("onContextMenuPreparing", function (e) {
			if (e.row && e.target === "content") { // Ensure right-click is on a row, not the header
				e.event.preventDefault(); // Prevent the default browser context menu
				confirmDelete(e.row.data); // Show delete confirmation
			}
		});
	});

	function setEffectiveDate(e) {
		var $dataGrid = $("#propertydataGrid");

		if ($dataGrid.length) {
			var dataGrid = $dataGrid.dxDataGrid("instance");
			dataGrid.selectRows(e.value, false);
		}
		if (e.value) {
			
			let grid = $("#propertydataGrid").dxDataGrid("instance");
			let rowIndex = e.element.closest("tr").index(); // Get the edited row index
			let rowData = grid.getVisibleRows()[rowIndex].data;




			rowData.EffectiveDate = e.value; // Update the row data
			grid.cellValue(rowIndex, "EffectiveDate", e.value); // Ensure it reflects in the grid

		}
	}

	function ClosePropertyModel() {
		let popupInstance = $("#EmployeeAllocationPopup").dxPopup("instance");
		popupInstance.hide();
	}



	$(document).ready(function () {
		var costDataGrid = $("#propertydataGrid").dxDataGrid({
			onRowUpdating: function (e) {
				let costAmount = $("#propertyAmount").dxNumberBox("instance").option("value"); // Get CostAmount value
				let newAmount = e.newData.VoucherAmount; // New value entered in the grid
				let oldAmount = e.oldData.VoucherAmount; // Previously loaded value
				let dataSource = $("#propertydataGrid").dxDataGrid("instance").option("dataSource");

				if (newAmount > oldAmount) {
					// Prevent increasing the amount, reset to old value
					e.newData.VoucherAmount = oldAmount;
					e.cancel = true;
					// DevExpress.ui.notify("Amount cannot be increased! Resetting to " + oldAmount, "error", 2000);
					return;
				}

				if (newAmount < oldAmount) {
					let balanceAmount = oldAmount - newAmount; // Calculate the remaining balance

					// Add new row with the balance amount
					let newRow = { ...e.oldData, PropertyDescription:null, VoucherAmount: balanceAmount };

					// Add the new row to the grid
					dataSource.push(newRow);
					$("#propertydataGrid").dxDataGrid("instance").option("dataSource", dataSource);
					// DevExpress.ui.notify("Balance amount of " + balanceAmount + " added as a new row.", "success", 2000);
				}
			}
		}).dxDataGrid("instance");
	});
</script>
