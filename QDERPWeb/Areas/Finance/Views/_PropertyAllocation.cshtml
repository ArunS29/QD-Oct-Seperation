<script>
	
	$(document).ready(function () {
		// Make an AJAX request to check the condition
		const VoucherEntryId = parseInt('@voucherEntryNo'.trim(), 10);
		const initialVoucherAmount = parseFloat('@voucherAmountParsed'.replace(/"/g, '')) || 0;
		const drCr = '@drCr';
		const costdataGrid = $('#propertydataGrid').dxDataGrid('instance');

		$.ajax({
			url: `/api/PropertyAllocation/GetPropertyAllocationsBydatagrid?voucherEntryId=${VoucherEntryId}`,
			type: 'GET',
			success: function (data) {
				if (data && data.length > 0) {
					costdataGrid.option('dataSource', data);
				} else {


					// No data found – insert a default row
					const defaultRow = [{
						DrCr: drCr,
						EffectiveDate: new Date().toISOString(),
						VoucherAmount: initialVoucherAmount.toFixed(2),
						Remarks: '',
						// default fallback value
					}];
					costdataGrid.option('dataSource', defaultRow);
				}
			},
			error: function () {
				DevExpress.ui.notify("Failed to load cost allocation data.", "error", 4000);
			}
		});

		// Function to handle changes to the NumberBox value
		$('#propertyAmount').dxNumberBox({
			valueChanged: function (e) {
				const newVoucherAmount = e.value.toFixed(2);

				// Update the data in the DataGrid
				if (costdataGrid) {
					$.ajax({
						url: '/api/VoucherEntryReceipts/CheckPropertyAllocation',
						method: 'GET',
						data: { AccountHead: '@accountHead', AccountID: '@accountId' }, // Pass accountHead as a parameter
						success: function (response) {
							const updatedData = [{
								DrCr: '@drCr',
								CostAllocated: '',
								EffectiveDate: new Date().toLocaleDateString('en-GB', {
									day: 'numeric',
									month: 'short',
									year: 'numeric',
								}),
								VoucherAmount: newVoucherAmount,
								Remarks: 'N/A'
							}];

							costdataGrid.option('dataSource', updatedData);
						},
						error: function (xhr, status, error) {
							console.error('Error checking employee allocation:', error);
						}
					});
				}
			}
		});
	});

	

	function formatEffectiveDate(dateString) {
		if (!dateString) return 'N/A';

		const dateObj = new Date(dateString);
		const options = { day: 'numeric', month: 'short', year: 'numeric' };
		return dateObj.toLocaleDateString('en-GB', options).replace(/ /g, '-');
	}

