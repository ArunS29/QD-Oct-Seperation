@page
@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="~/js/global/print.js"></script>


<style>
    .custom-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-end;
        margin-bottom: 25px;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .toolbar-item {
        min-width: 260px;
        flex: 1;
    }

    .dx-field-label,
    .dx-texteditor-label {
        font-weight: 600 !important;
        font-size: 14px;
        color: #34495e;
        margin-bottom: 5px;
    }

    .dx-texteditor,
    .dx-dropdownbutton {
        border-radius: 8px !important;
    }

    .dx-dropdownbutton {
        background-color: #e6f0ff !important;
    }

    .dx-button {
        font-weight: 500;
        border-radius: 8px !important;
        transition: background-color 0.3s ease;
    }

    .dx-button:hover {
        background-color: #d0e2ff !important;
    }

    .button-alignment-down {
        margin-top: 8px;
    }

    .limited-footer {
        margin-top: 20px;
        padding: 15px;
        background-color: #ffffff;
        border-top: 1px solid #e0e0e0;
        border-radius: 0 0 12px 12px;
    }

    .context-menuInvoice {
        position: absolute;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        width: 200px;
        display: none;
        flex-direction: column;
        padding: 5px 0;
        z-index: 1000;
    }

    .context-menu-itemInvoice {
        display: flex;
        align-items: center;
        padding: 10px 15px;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s ease-in-out;
        color: #333;
    }

        .context-menu-itemInvoice i {
            margin-right: 10px;
            font-size: 16px;
            color: #007bff;
        }

        .context-menu-itemInvoice:hover {
            background: #f0f0f0;
        }

        .context-menu-itemInvoice:not(:last-child) {
            border-bottom: 1px solid #e0e0e0;
        }

    /* Responsive Tweaks */
    @@media screen and (max-width: 768px) {
        .toolbar-item {
            min-width: 100%;
        }

        h2 {
            font-size: 22px;
        }

        #dataGrid {
            padding: 10px;
        }
    }
</style>

<div class="container-fluid"></div>
<div class="title">
    <div class="header-container">
        <div id="StockInventoryMainForm" class="no-border-title"></div>
    </div>
</div>
<div class="Footer">
    @await Html.PartialAsync("/Pages/Shared/ERM/StockInventoryFooter.cshtml")
</div>
<div class="context-menuInvoice" id="contextMenu">
    <div class="context-menu-itemInvoice" onclick="viewRecord()">
        <i class="dx-icon-search"></i> View
    </div>
    <div class="context-menu-itemInvoice" onclick="editRecord()">
        <i class="dx-icon-edit"></i> Edit
    </div>
    <div class="context-menu-itemInvoice" onclick="deleteRecord()">
        <i class="dx-icon-trash"></i> Delete
    </div>
</div>
    <div class="dx-field ledgerResult" >
      @(Html.DevExtreme().DataGrid<Qry60001inventoryStockView>()
    .ID("dataGrid")
    .DataSource(ds => ds.Mvc()
        .Controller("StockInventory")
        .LoadAction("GetInventory"))
    .RemoteOperations(false)
    .Columns(columns =>
    {
        columns.AddFor(m => m.Gscode)
                .Caption(new JS("formatMessage('Stock Code')"))
            .Width(120);
        columns.AddFor(m => m.Gsdescrpition)
                .Caption(new JS("formatMessage('Description')"))
            .Width(280);
        columns.AddFor(m => m.GsgroupName)
                .Caption(new JS("formatMessage('Stock Group')"))
            .Width(180)
            .GroupIndex(0);
        columns.AddFor(m => m.ItemPartNo)
                .Caption(new JS("formatMessage('Item Part No')"))
            .Width(150);
        columns.AddFor(m => m.UnitType)
                .Caption(new JS("formatMessage('Unit')"))
            .Width(100);
        columns.AddFor(m => m.GssellingRate)
                .Caption(new JS("formatMessage('Selling Price')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120);
        columns.AddFor(m => m.CostPrice)
                .Caption(new JS("formatMessage('Cost Price')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120);
        columns.AddFor(m => m.OpeningBalance)
                .Caption(new JS("formatMessage('Opening Balance')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120);
        columns.AddFor(m => m.TotalReceived)
                .Caption(new JS("formatMessage('Received')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120);
        columns.AddFor(m => m.TotalIssues)
                .Caption(new JS("formatMessage('Issues')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120);
        columns.AddFor(m => m.ClosingBalance)
                .Caption(new JS("formatMessage('Closing Balance')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120);
        columns.AddFor(m => m.MaxQty)
                .Caption(new JS("formatMessage('Inventory Value (FIFO)')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(150);
        columns.AddFor(m => m.IsDiscontinued)
            .Caption(new JS("formatMessage('IsDiscontinued')"))
            .Visible(false)
            .Width(150);
    })
    .Paging(p => p.PageSize(20))
    .AllowColumnReordering(true)
    .AllowColumnResizing(true)
    .ColumnAutoWidth(false)
    .WordWrapEnabled(true)
    .FilterRow(f => f.Visible(false))
    .Grouping(g => g.AutoExpandAll(true))
    .GroupPanel(gp => gp.Visible(false))
    .ShowBorders(true)
    
    .Height("100%")
    .Width("100%")
)

    </div>

<script>
    let selectedRowData = null;

    $(function () {
        const contextMenu = $("#contextMenu");

        $(document).on("click", function () {
            contextMenu.hide();
        });

       $("#dataGrid").customizeGridContextMenu();
          $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault();
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowIndex = $(this).index();
        selectedRowData = dataGrid.getVisibleRows()[rowIndex].data;

        $("#contextMenu").css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
    });

    });
    function viewRecord() {
        if (selectedRowData) {
            const code = selectedRowData.Gscode;
            window.location.href = `/${tenantName}/ERM/InventoryStockDetails?code=${encodeURIComponent(code)}&mode=view`;
        }
    }

    function editRecord() {
        if (selectedRowData) {
            const code = selectedRowData.Gscode;
            window.location.href = `/${tenantName}/ERM/InventoryStockDetails?code=${encodeURIComponent(code)}&mode=edit`;
        }
    }


          function deleteRecord() {
        if (!selectedRowData) {
            DevExpress.ui.notify("Please select a row to delete.", "warning", 2000);
            return;
        }

        const code = selectedRowData.Gscode;

        DevExpress.ui.dialog.confirm(
            `Are you sure you want to delete stock item: <b>${code}</b>?`,
            "Confirm Deletion"
        ).done(function (dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: "/api/StockInventory/DeleteStockItem",
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(code),
                    success: function (result) {
                        const messageType = result.success ? "Success" : "Error";
                        const messageColor = result.success ? "green" : "red";

                        DevExpress.ui.dialog.alert(
                            `<div style="color: ${messageColor}; font-weight: bold;">
                                ${result.message}
                            </div>`,
                            messageType
                        );

                        if (result.success) {
                            const grid = $("#dataGrid").dxDataGrid("instance");
                            grid.refresh();
                        }
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("Error deleting stock item", "error", 2000);
                        console.error(xhr);
                    }
                });
            }
        });
    }
    $(function () {
        $("#StockInventoryMainForm").dxTextBox({
            text: formatMessage("Stock Inventory"),
                readOnly: true,
                onContentReady: function (e) {
                    $(e.element).addClass("dx-textbox-heading");
                }
            });
        });


    

</script>






