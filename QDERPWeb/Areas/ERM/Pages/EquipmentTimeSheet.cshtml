@section scripts {
    <script>
        var popover;

         $(function () {
        // Initialize Popover
        popover = $("#gridPopover").dxPopover({
            target: "#ddGridTrigger",
            showEvent: null,
            hideEvent: null,
            width: 600,
            height: 400,
            shading: true,
            position: "bottom"
        }).dxPopover("instance");

        // Select Button
        $("#btnSelect").dxButton({
            text: "Select",
            type: "success",
            onClick: function () {
                var grid = $("#gridInsidePopover").dxDataGrid("instance");
                var selected = grid.getSelectedRowsData();
                if (selected.length > 0) {
                    $("#ddGridTrigger").dxDropDownBox("instance").option("value", selected[0].ID);
                    popover.hide();
                    DevExpress.ui.notify("You selected: " + selected[0].Name, "success", 2000);
                } else {
                    DevExpress.ui.notify("Please select a row first!", "warning", 2000);
                }
            }
        });
    });

        function showPopover() {
            popover.show();
        }
    </script>
}
<script>
	
	 $(function () {
        const dd = $("#ddBtnYearMonth").dxDropDownButton("instance");

        // Cancel (X) closes dropdown
        $(document).on("click", "#closeDropdown", function () {
            dd.close();
        });

        // Month click
        $(document).on("click", ".month-btn", function () {
            $(".month-btn").removeClass("selected");
            $(this).addClass("selected");

            var month = parseInt($(this).data("month"));
            var year = parseInt($("#yearSelect").val());

            updatePeriod(month, year, $(this).text());
        });

        // Year change
        $("#yearSelect").on("change", function () {
            var year = parseInt($(this).val());
            var selectedMonthBtn = $(".month-btn.selected");

            if (selectedMonthBtn.length > 0) {
                var month = parseInt(selectedMonthBtn.data("month"));
                updatePeriod(month, year, selectedMonthBtn.text());
            } else {
                $("#dataGrid").dxDataGrid("instance").option("dataSource", []);
                dd.option("text", "Select Period");
            }
        });

        // Common update function
        function updatePeriod(month, year, monthName) {
            var fromDate = new Date(year, month - 1, 1);
            var toDate = new Date(year, month, 0);

            var frmDateStr = fromDate.toISOString().split("T")[0];
            var toDateStr = toDate.toISOString().split("T")[0];

            dd.option("text", monthName + " " + year);

            loadData(frmDateStr, toDateStr);
            loadPopoverData(frmDateStr, toDateStr); // your extra function
        }

        // Load API data into grid
        function loadData(frmDate, toDate) {
            $.ajax({
                url: '/api/ERRequestforQuotationList/GetGenarateTimeGrid',
                type: 'GET',
                data: { fromDate: frmDate, toDate: toDate },
                success: function (data) {
                    console.log("Returned Data: ", data);

                    var records = [];
                    if (Array.isArray(data) && data.length > 0) {
                        records = data[0].Records || [];
                    }

                    var grid = $("#dataGrid").dxDataGrid("instance");
                    grid.option("dataSource", records);
                    grid.refresh();
                },
                error: function (xhr) {
                    console.log("AJAX Error", xhr.responseText);
                    DevExpress.ui.notify("Error while loading data", "error", 2000);
                }
            });
        }
    });

	function loadPopoverData(frmDate, toDate) {
    function formatDateToMMDDYYYY(dateStr) {
        var d = new Date(dateStr);
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var yyyy = d.getFullYear();
        return mm + '/' + dd + '/' + yyyy;
    }

    var frmDateFormatted = formatDateToMMDDYYYY(frmDate);
    var toDateFormatted = formatDateToMMDDYYYY(toDate);

    $.ajax({
        url: '/api/ERRequestforQuotationList/GenerateTimeGrid',
        type: 'GET',
        data: { frmDate: frmDateFormatted, toDate: toDateFormatted },
        success: function (data) {
            console.log("Popover Grid Data: ", data);

            var grid = $("#gridInsidePopover").dxDataGrid("instance");
            grid.option("dataSource", data || []);
            grid.refresh();

            // 🔹 Show the popover after loading
            popover.show();
        },
        error: function (xhr) {
            console.log("AJAX Error", xhr.responseText);
            DevExpress.ui.notify("Error while loading popover data", "error", 2000);

            var grid = $("#gridInsidePopover").dxDataGrid("instance");
            grid.option("dataSource", []);
            grid.refresh();

            popover.show(); // still show empty grid
        }
    });
}

	function onContextMenuPreparing(e) {
		if (e.target === "content" && e.row && e.row.data) {
			const rowData = e.row.data;
		    const PropertyNo = encodeURIComponent(rowData.PropertyNo);
			const PropertyDescription = encodeURIComponent(rowData.PropertyDescription);
			const PlateNo = encodeURIComponent(rowData.PlateNo);
			const Deducation = encodeURIComponent(rowData.Deducation);
			const TimeSheetMasterId = encodeURIComponent(rowData.TimeSheetMasterId);
			const tenantName = window.tenantName || "defaultTenant";

			e.items = [
				{
					text: "Edit Timesheet",
					icon: "edit",
					onItemClick: function () {
				    const url = `/${tenantName}/ERM/EquipmentTimeSheetData?PropertyNo=${PropertyNo}&PropertyDescription=${PropertyDescription}&PlateNo=${PlateNo}&Deducation=${Deducation}&TimeSheetMasterId=${TimeSheetMasterId}`;
                    window.location.href = url;
					}
				},
				{
					text: "Delete Timesheet",
					icon: "trash",
					onItemClick: function () {
						if (confirm(`Are you sure you want to delete RFQ ${Rfqno}?`)) {
							// Replace with your actual delete logic, e.g., an AJAX call
							fetch(`/${tenantName}/ERM/DeleteRFQ?Rfqno=${Rfqno}`, {
								method: 'DELETE'
							})
								.then(response => {
									if (response.ok) {
										alert(`RFQ ${Rfqno} deleted successfully.`);
										// Refresh the DataGrid or remove the row
										e.component.refresh();
									} else {
										alert(`Failed to delete RFQ ${Rfqno}.`);
									}
								})
								.catch(error => {
									console.error('Error deleting RFQ:', error);
									alert('An error occurred while deleting the RFQ.');
								});
						}
					}
				},
				{
					text: "Edit Property",
					icon: "unlock",
					onItemClick: function () {
						// Replace with your actual unlock logic, e.g., an AJAX call
						fetch(`/${tenantName}/ERM/UnlockRFQ?Rfqno=${Rfqno}`, {
							method: 'POST'
						})
							.then(response => {
								if (response.ok) {
									alert(`RFQ ${Rfqno} unlocked successfully.`);
									// Optionally refresh the DataGrid
									e.component.refresh();
								} else {
									alert(`Failed to unlock RFQ ${Rfqno}.`);
								}
							})
							.catch(error => {
								console.error('Error unlocking RFQ:', error);
								alert('An error occurred while unlocking the RFQ.');
							});
					}
				},
				{
					text: "Print TimeSheet (Client)",
					icon: "add",
					onItemClick: function () {
						const url = `/${tenantName}/ERM/CreatePurchaseOrder?Rfqno=${Rfqno}`;
						window.location.href = url;
					}
				},
				{
					text: "Print TimeSheet (Supplier)",
					icon: "add",
					onItemClick: function () {
						const url = `/${tenantName}/ERM/CreatePurchaseOrder?Rfqno=${Rfqno}`;
						window.location.href = url;
					}
				},
				{
