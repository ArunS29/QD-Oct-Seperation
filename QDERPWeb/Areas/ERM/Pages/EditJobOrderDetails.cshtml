<meta charset="UTF-8">
<div class="title">
    <div class="header-container">
        <div id="EditJobOrderDetails" class="no-border-title"></div>
    </div>
</div>
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                    Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%")
