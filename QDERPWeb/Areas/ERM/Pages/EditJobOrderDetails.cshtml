                    .Icon("folder")
                .Text("Job Order Details")
                    .Template(@<text>
            <div class="dx-card p-3">
                <div class="row g-2">

                    <!-- Row 1 -->
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("Joboreder1")
