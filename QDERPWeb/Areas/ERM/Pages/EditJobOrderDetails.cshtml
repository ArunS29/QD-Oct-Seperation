                        )   

                    </div>
                </div>
            </div>
        </text>);

                    })
                )
                <style>
                    .joborder-container {
                        display: flex;
                        height: 90vh;
                    }

                    .joborder-tabs {
                        width: 220px;
                        padding-top: 10px;
                        min-height: 100%;
                        border: 1px solid #ddd;
                    }

                    .joborder-content {
                        flex: 1;
                        padding: 18px 18px 0 18px;
                    }

                    .joborder-form-table {
                        width: 100%;
                        border-collapse: separate;
                        border-spacing: 10px 8px;
                    }

                        .joborder-form-table td {
                            padding: 0;
                            vertical-align: middle;
                        }

                    .manual-valves-cell {
                        background: #d3d3d3;
                        font-weight: bold;
                        padding: 4px 8px;
                        color: #222;
                        border-radius: 2px;
                    }

                    .joborder-desc-label {
                        font-weight: bold;
                        font-size: 13px;
                        margin-bottom: 4px;
                        display: block;
                    }

                    .joborder-footer {
                        display: flex;
                        justify-content: space-between;
                        font-size: 12px;
                        margin-top: 4px;
                        padding: 0 2px;
                    }
                </style>
        <div class="joborder-container">
            <!-- Left Vertical Tabs -->
            <div class="joborder-tabs">
                @(Html.DevExtreme().List()
                    .ID("jobOrderTabs")
                    .DataSource(new[] {
                new { id = 1, text = "Job Order Attributes", icon = "folder" },
                new { id = 2, text = "Initial Observation", icon = "search" },
                new { id = 3, text = "Visual Inspection", icon = "find" },
                new { id = 4, text = "Repair Report", icon = "preferences" },
                new { id = 5, text = "Dispatch Report", icon = "car" }
                })
                    .DisplayExpr("text")
                    .KeyExpr("id")
                    .SelectionMode(ListSelectionMode.Single)
                    .SelectedItemKeys(new[] { 1 })
                    .OnItemClick("onJobOrderTabClick")
                    )
            </div>
            <!-- Right Content Area -->
            <div class="joborder-content">
                <div id="tabContent_1">
                    <form>
                        <table class="joborder-form-table">
                            <tr>
                                <td>
                                    @(Html.DevExtreme().SelectBox().ID("Type").Width("100%").Label(new JS("formatMessage('Type:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("Operator").Width("100%").Label(new JS("formatMessage('Operator:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("ModelNo").Width("100%").Label(new JS("formatMessage('Model No:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("ClientWorkOrderNo").Width("100%").Label(new JS("formatMessage('Client Work Order No:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("Size").Width("100%").Label(new JS("formatMessage('Size:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("Material").Width("100%").Label(new JS("formatMessage('Material:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("TagNo").Width("100%").Label(new JS("formatMessage('Tag No:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("ClientProject").Width("100%").Label(new JS("formatMessage('Client Project:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("Class").Width("100%").Label(new JS("formatMessage('Class:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("Make").Width("100%").Label(new JS("formatMessage('Make:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("SerialNo").Width("100%").Label(new JS("formatMessage('Serial No:')"))
                                        .LabelMode(EditorLabelMode.Outside)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextArea().ID("valuetype").Placeholder(new JS("formatMessage('Manual Valves')")).Width("100%").Label(new JS("formatMessage('Valve Type:')"))
                                    .LabelMode(EditorLabelMode.Outside)
                                    )
                                </td>
                            </tr>
                        </table>
                        <div style="margin-top: 10px;">
                            @(Html.DevExtreme().TextArea().ID("JobOrderDescription").Width("100%").ElementAttr("style", "  height: 400px ! important;").Label(new JS("formatMessage('Job Order Description (Detailed)')"))
                                .LabelMode(EditorLabelMode.Outside)
                                )
