                        .Label("Job Order Date:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-6" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .ID("GetProjectDropDown1")
                        .Label(new JS("formatMessage('Client Name:')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .ValueExpr("ClientCode")
                        .DisplayExpr("ClientName")
                        .Width("100%")
                        )


                        @(Html.DevExtreme().Button()
                        .ID("editClient1")
                        .Icon("edit")
                        .Hint("Add Client")
                        .Width(18)
                        .ElementAttr("style", "margin-left: 5px; vertical-align: top;")
                        )
                        @(Html.DevExtreme().Button()
                        .ID("AddClient1")
                        .Icon("plus")
                        .Hint("Add Client")
                        .Width(18)
                        .ElementAttr("style", "margin-left: 5px; vertical-align: top;")
                        .OnClick("redirecttoClientLeadmaster1")
                        )

                    </div>

                    <!-- Row 2 -->
                    <div class="col-md-2" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("clientPOnumber1")
                        .Label("Work Order/Sales Order No:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )

                    </div>
                    <div class="col-md-3" style="display:flex;align-items:end;">
                      
                        @(Html.DevExtreme().DropDownBox()
                        .Label("Job Order Status")
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddGetSalesPerson")
                        .Width(900)
