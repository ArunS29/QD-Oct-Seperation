                        <div class="joborder-footer">
                            <div>
                                <span>Entered By: &mdash;</span><br />
                                <span>Entered On: &mdash;</span>
                            </div>
                            <div>
                                <span>Modified By: &mdash;</span><br />
                                <span>Modified On: &mdash;</span>
                            </div>
                        </div>
                    </form>
                </div>
