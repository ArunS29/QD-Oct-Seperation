                        .Label("Job Order No:")
                        .LabelMode(EditorLabelMode.Outside)
                        .ReadOnly(false)
                        .Width("100%")
                        )


                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().DateBox()
                        .ID("deliveryNoteDate1")
