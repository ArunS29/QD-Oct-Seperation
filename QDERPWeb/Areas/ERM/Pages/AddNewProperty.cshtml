<script>
          function onTabSelectionChanged(e) {
              // Hide all main tab content
              document.querySelectorAll('.tab-content').forEach(div => div.style.display = 'none');

              // Show selected main tab
              const selectedIndex = e.component.option('selectedIndex') + 1;
              const selectedTabId = `tab-content-${selectedIndex}`;
              const selectedContent = document.getElementById(selectedTabId);
              if (selectedContent) {
                  selectedContent.style.display = 'block';
              }
          }

          function onNestedTabSelectionChanged(e) {
              // Hide all nested tab content
              document.querySelectorAll('.nested-tab-content').forEach(div => div.style.display = 'none');

              // Show selected nested tab
              const selectedIndex = e.component.option('selectedIndex') + 1;
              const selectedTabId = `nested-tab-${selectedIndex}`;
              const selectedContent = document.getElementById(selectedTabId);
              if (selectedContent) {
                  selectedContent.style.display = 'block';
              }
          }


      

