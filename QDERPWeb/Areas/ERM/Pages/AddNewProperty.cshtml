    function refreshFields() {
            const editorTypes = [
                "dxTextBox",
                "dxNumberBox",
                "dxTextArea",
                "dxSelectBox",
                "dxCheckBox",
                "dxColorBox",
                "dxDateBox",
                "dxDropDownBox"
            ];
                 editorTypes.forEach(type => {
            $(`.${type}`).each(function () {
                const instance = $(this)[type]("instance");
                if (!instance) return;

                if (type === "dxCheckBox") {
                    instance.option("value", false);
                } else {
                    instance.option("value", null);
                }
            });
        });
    }

