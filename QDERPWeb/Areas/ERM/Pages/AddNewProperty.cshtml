<div class="property-form">
    <div class="form-columns">

        <!-- Row 1: Property Type -->
        <div class="form-group" style="grid-column: span 2; display:flex;flex-direction: row;">
            @(Html.DevExtreme().DropDownBox()
                    .ID("PropertyType")
                    .Label(new JS("formatMessage('Property Type:*')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ShowClearButton(true)
                    .Width("100%")
                    .DataSource(d => d.WebApi()
                    .Controller("AddNewProperty")
                    .LoadAction("GetAllPropertyTypes")
                    .LoadMode(DataSourceLoadMode.Raw)
                        .Key("PropertyType")
                    )
                    .Option("dataGridId", "GetPropertyType-datagrid")
                    .OpenOnFieldClick(false)
                    .ValueChangeEvent("input")
                    .HoverStateEnabled(true)
                    .ValueExpr("PropertyTypeId")
                    .DisplayExpr("PropertyType")
                    .OnInput("dropDownBoxOnInput")
                    .OnOpened("onOpened")
                    .TabIndex(1)
                    .Width("100%")
                    .OnKeyDown("onKeyDown")
                    .ContentTemplate(new TemplateName("GetTypeOfPropertytypeContentTemplate"))
                    .Buttons(buttons =>
                    {
                        buttons.Add()
                        .Name("btnpropertytype")
                        .Location(TextEditorButtonLocation.After)
                        .Widget(w => w.Button()
                        .Type(ButtonType.Default)
                        .Icon("plus")
                        .ElementAttr(new { @class = "custom-hover-button add-hover" })
                        .OnClick("Protype"));
                        buttons.Add()
                        .Name("dropDown");
                    })
            )
        </div>

        <!-- Row 2: Property No and Description -->
        <div class="form-group">
            @(Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Property No:*')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("PropertyNo")
                        .Width("100%")
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired().Message("Property No is required");
                        })
                        )
        </div>

        <div class="form-group">
            @(Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Property Description:*')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("PropertyDescription")
                        .Width("100%"))
        </div>

        <!-- Row 3: Category and Specification -->
        <div class="form-group" style=" display:flex; flex-direction: row;">
            @(Html.DevExtreme().DropDownBox()
                        .ID("PropertyCategory")
                        .Label(new JS("formatMessage('Property Category:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(d => d.WebApi()
                        .Controller("PropertyCategory")
                        .LoadAction("GetAllProperty")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("PropertyCategoryId")
                        )
                        .Option("dataGridId", "GetPropertyCategory-datagrid")
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .Width("100%")
                        .ValueExpr("PropertyCategoryId")
                        .DisplayExpr("PropertyCategoryName")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("GetTypeOfPropertyCategoryContentTemplate"))
                        .Buttons(buttons =>
                        {
                            buttons.Add()
                            .Name("btnAddAccount")
                            .Location(TextEditorButtonLocation.After)
                            .Widget(w => w.Button()
                            .Type(ButtonType.Default)
                            .Icon("plus")
                            .ElementAttr(new { @class = "custom-hover-button add-hover" })
                            .OnClick("Propertycategory")); 
                            buttons.Add()
                            .Name("dropDown");
                        })
                        .ValidationRules(rules =>
                        {
                            rules.AddRequired().Message("Property Category is required");
                        })
            )
          
        </div>

        <div class="form-group">
            @(Html.DevExtreme().TextArea()
                        .Label(new JS("formatMessage('Property Specification:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("PropertySpecification")
                        .Height(60)
                        .ElementAttr("style", "height: 60px !important;")
                        .Width("100%")
            )
        </div>

        <!-- Row 4: Property Group -->
        <div class="form-group" style="display:flex; align-items:end;flex-direction: row;">
            @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Property Group:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("PropertyGroup")
                        .Width("100%")
                        .DataSource(d => d.WebApi()
                        .Controller("PropertyGroup")
                        .LoadAction("GetPropertyGroup")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("PropertyGroupId")
                        )
                        .Option("dataGridId", "GetPropertyCategory-datagrid")
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("PropertyGroupId")
                        .DisplayExpr("PropertyGroup")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("GetTypeOfPropertyGroupContentTemplate"))
                        .Buttons(buttons =>
                        {
                            buttons.Add()
                            .Name("btnPropertygrp")
                            .Location(TextEditorButtonLocation.After)
                            .Widget(w => w.Button()
                            .Type(ButtonType.Default)
                            .Icon("plus")
                            .ElementAttr(new { @class = "custom-hover-button add-hover" })
                            .OnClick("Progroup"));
                            buttons.Add()
                            .Name("dropDown");
                        }) )
        </div>

    </div>

    <!-- Image -->
    <div class="form-image">
        <img src="~/images/ERMproperty.png" alt="Property Image" />
    </div>
</div>

<div class="dx-fieldset horizontal-container">
    @(Html.DevExtreme().Tabs()
        .Items(items =>
        {
            items.Add().Icon("preferences").Text(new JS("formatMessage('Specification')"));
            items.Add().Icon("chart").Text(new JS("formatMessage('Purchased')"));
            items.Add().Icon("image").Text(new JS("formatMessage('Hired')"));
            items.Add().Icon("money").Text(new JS("formatMessage('Document')"));
            items.Add().Icon("tags").Text(new JS("formatMessage('Mob/Demob Details')"));
            items.Add().Icon("cart").Text(new JS("formatMessage('Maintenance Details')"));
            items.Add().Icon("runner").Text(new JS("formatMessage('Cost Summary')"));
            items.Add().Icon("repeat").Text(new JS("formatMessage('Operators')"));
        })
        .SelectedIndex(0)
        .OnSelectionChanged("onTabSelectionChanged")
        )
</div>
