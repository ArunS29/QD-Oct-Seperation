<script>
        let ItemReceivedGridInstance = null;


    function onItemReceivedGridInitialized(e) {
        ItemReceivedGridInstance = e.component;
        console.log("ItemReceivedGrid initialized", ItemReceivedGridInstance);

        const urlParams = new URLSearchParams(window.location.search);
        const requestNo = urlParams.get("code");

        if (requestNo) {
            loadItemReceivedGrid(requestNo);
        }
    }

        async function loadItemReceivedGrid(equipmentNo) {
        try {
            console.log("Fetching data for equipmentNo:", equipmentNo);

            const response = await fetch(`/api/PropertyOperator/GetByEquipmentNo?equipmentNo=${encodeURIComponent(equipmentNo)}`, {
                method: "GET",
                headers: {
                    "Accept": "application/json"
                }
            });

            console.log("Raw response:", response);

            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const result = await response.json();
            console.log("Parsed JSON result:", result);

            // ✅ Extract data safely
            const data = Array.isArray(result) ? result : result.data || result.items || [];

            if (!Array.isArray(data)) {
                console.error("Expected an array for the grid, got:", data);
                DevExpress.ui.notify("Invalid data format from server", "error", 3000);
                return;
            }

            console.log("Final data bound to grid:", data);

            // ✅ Get grid instance safely
            const grid = $("#OperatorGrid").dxDataGrid("instance");
            if (grid) {
                grid.option("dataSource", data);
                grid.refresh();
            } else {
                console.warn("OperatorGrid instance not found!");
            }
        } catch (error) {
            console.error("Error fetching ItemReceived data:", error);
            DevExpress.ui.notify("Failed to load item receipt data", "error", 3000);
        }
    }







        function OnmobilzationInitialize(e) {
        const grid = e.component;
        const urlParams = new URLSearchParams(window.location.search);
        const propertyNo = urlParams.get("code");

        console.log("PropertyNo from query:", propertyNo);

        $.ajax({
            url: `/api/AddNewProperty/GetByMobilzation`,
            type: "GET",
            data: { PropertyNo: propertyNo },
            success: function (data) {
                console.log("API Data:", data);

                grid.option("dataSource", data);
                grid.refresh();
            },
            error: function (xhr, status, error) {
                console.error("Error fetching mobilization data:", error);
            }
        });
    }

         function OnCostSummary(e) {
         const grid = e.component;
         const urlParams = new URLSearchParams(window.location.search);
         const propertyNo = urlParams.get("code");

         console.log("PropertyNo from query:", propertyNo);

