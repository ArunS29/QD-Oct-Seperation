              url: `/api/AddNewProperty/GetByCostSummary`,
             type: "GET",
             data: { PropertyNo: propertyNo },
             success: function (data) {
                 console.log("API Data:", data);

                 grid.option("dataSource", data);
                 grid.refresh();
