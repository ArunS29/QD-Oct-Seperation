          const propertyNo = urlParams.get("code");

          console.log("PropertyNo from query:", propertyNo);

          $.ajax({
                url: `/api/AddNewProperty/GetByDocument`,
              type: "GET",
              data: { PropertyNo: propertyNo },
              success: function (data) {
                  console.log("API Data:", data);

                  grid.option("dataSource", data);
                  grid.refresh();
              },
              error: function (xhr, status, error) {
                  console.error("Error fetching mobilization data:", error);
              }
          });
      }
        function OnMaintenance(e) {
          const grid = e.component;
          const urlParams = new URLSearchParams(window.location.search);
          const propertyNo = urlParams.get("code");

          console.log("PropertyNo from query:", propertyNo);

          $.ajax({
                url: `/api/AddNewProperty/GetByMaintenance`,
