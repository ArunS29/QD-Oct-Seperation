                    const selected = grid.getSelectedRowsData();
                    if (selected.length > 0) {
                        grid.deleteRow(grid.getRowIndexByKey(selected[0].id)); // Use correct key field
                    }
                    break;

                case "delete-selected":
                    const selectedKeys = grid.getSelectedRowKeys();
                    selectedKeys.forEach(key => {
                        const rowIndex = grid.getRowIndexByKey(key);
