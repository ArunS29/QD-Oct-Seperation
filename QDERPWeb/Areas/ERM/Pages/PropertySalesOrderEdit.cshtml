            const salesOrderNo = getQueryParam("SalesOrderNo");
            const salesOrderTextBox = $("#SalesOrderNO").dxTextBox("instance");
            if (!salesOrderTextBox) {
                console.warn("SalesOrderNO TextBox not initialized yet.");
                return;
