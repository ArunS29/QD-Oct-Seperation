@page
@model QD.ERP.Web.Areas.ERM.Pages.PropertySalesOrderEditModel
@{
}

<style>
    

    /* Only affects Delivery & Checklist section */
    .delivery-checklist-section {
        display: flex;
        gap: 20px; /* space between the two cards */
        align-items: flex-start; /* align them at the top */
    }

        /* Each card inside should take equal width */
        .delivery-checklist-section .form-card {
            flex: 1;
            background-color: #f8fbff;
            border: 1px solid #c5c5c5;
            border-radius: 4px;
            padding: 12px;
        }


    .ledgerResult {
        overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
        width: 100%;
    }

    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold;
        font-size: 14px;
        padding: 10px 15px;
    }


        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue;
            color: white !important;
        }

    .dx-tabpanel {
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        margin: 15px;
        width: 99%;
        padding: 5px;
        border-radius: 1px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .select-box {
        width: 20vh;
    }

    #lineItemContextMenu {
        background: #fff;
        border: 1px solid #bbb;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        border-radius: 4px;
        min-width: 220px;
        position: absolute;
        z-index: 9999;
        display: none;
    }

        #lineItemContextMenu .ctx-menu-item:hover {
            background: #f0f0f0;
        }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .form-section {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-card {
        flex: 1;
        padding: 15px;
    }


    .form-row {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }

    .form-group {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-weight: bold;
            font-size: 13px;
            color: #2c3e50;
            margin-bottom: 2px;
        }
    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .containers {
        display: flex;
    }

    .dx-card {
        background: var(--background-color);
    }


    .limited-footer .btn-container:not(:has(#ddButtonLayout,#btnMoveDown,#btnMoveUp,#btnSave,#btnSaveAndClose,#btnPrint1,#btnAddNew,#btnDelete,#btnBack,#btnSubmit,#btnVerify,#btnApprove,#btnStockAvailability)) {
        display: none !important;
    }

    .dx-dropDownBox.dx-invalid .dx-texteditor-input {
        border-color: red !important;
        border-width: 2px;
    }



    #BranchDivisionsTab .dx-label-has-text .dx-label span {
        color: #003366 !important;
        font-weight: bold;
    }

    #BranchDivisionsTab .dx-texteditor.dx-editor-outlined,
    #BranchDivisionsTab .dx-dropdowneditor.dx-editor-outlined,
    #BranchDivisionsTab .dx-datebox.dx-editor-outlined {
        background-color: #f9fbff;
        border-radius: 8px;
        border: 1px solid #d0d7e5;
    }



</style>

<meta charset="UTF-8">
<div class="title">
    <div class="header-container">
        <div id="EditsalesOrders" class="no-border-title"></div>
    </div>
</div>


<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->

