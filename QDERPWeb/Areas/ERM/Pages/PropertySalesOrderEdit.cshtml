                                                            .Controller("ERSalesOrders")   // Controller Name
                                                            .LoadAction("GetClientPONos") // API Method
                                                            .Key("ClientPono")                  // Primary key
                                                            )
                                                            .ValueExpr("ClientPono")                // Bind value as SlNo
                                                            .DisplayExpr("ClientPono")        // Show text as ClientPono
                                                            .Label("Client PO No:")
                                                            .LabelMode(EditorLabelMode.Floating)
                                                            .StylingMode(EditorStylingMode.Outlined)
                                                            .Width("100%")
                                                            .Buttons(b =>
