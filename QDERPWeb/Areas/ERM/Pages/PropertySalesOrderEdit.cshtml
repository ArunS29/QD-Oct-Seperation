        function onDeleteSalesOrderClick() {
                var salesOrderNo = $('#SalesOrderNO').dxTextBox("instance").option("value");

            if (!salesOrderNo) {
                DevExpress.ui.notify("Please enter or select a Sales Order to delete.", "warning", 3000);
                return;
            }

            DevExpress.ui.dialog.confirm(
                "You are about to delete this Sales Order and its child items. Click Yes to continue.",
                "Confirm Deletion"
            ).done(function (dialogResult) {
                if (dialogResult) {
                    // User confirmed deletion
                    $.ajax({
                        url: `/api/ERSalesOrders/DeleteSalesOrder?salesOrderNo=${encodeURIComponent(salesOrderNo)}`,
                        type: 'DELETE',
                        success: function (response) {
                            DevExpress.ui.dialog.alert("Sales Order deleted successfully.", "Deleted").done(function () {
                                location.reload();
                            });
                        },
                        error: function (xhr) {
                            const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting Sales Order.';
                            DevExpress.ui.notify(msg, 'error', 3000);
                        }
                    });
                }
            });
        }
    
        function onRowUpdating(e) {
        const data = Object.assign({}, e.oldData, e.newData);

        const qty = parseFloat(data.QuotedQuantity) || 0;
        const unitPrice = parseFloat(data.QuotedUnitPrice) || 0;
        const discount = parseFloat(data.QuotedDiscount) || 0;
        const vatRate = parseFloat(data.QuotedTaxSlab) || 0;

        // Your updated formula
        const amount = (qty * unitPrice) + discount;
        const vat = (amount * vatRate) / 100;
        const total = amount + vat;

        // Add calculated values to update object
        e.newData.LineTaxAmount = amount.toFixed(2);
        e.newData.VAT = vat.toFixed(2);
        e.newData.Total = total.toFixed(2);
    }
    ///submitbutton
       $("#btnSubmit").on("click", function () {
        const salesOrderNo = $("#SalesOrderNO").dxTextBox("instance").option("value")?.trim();

        if (!salesOrderNo) {
            DevExpress.ui.notify("Please enter a Sales Order Number.", "error", 2000);
            return;
        }

        $.ajax({
            url: '/api/ERSalesOrders/SubmitSalesOrder',
            type: 'POST',
            data: JSON.stringify(salesOrderNo),
            contentType: 'application/json',
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 2000);

                

                    // 🛑 Disable Submit button
                    if ($("#btnSubmit").data("dxButton")) {
                        $("#btnSubmit").dxButton("instance").option("disabled", true);
                    } else {
                        $("#btnSubmit").attr("disabled", true);
                    }
                } else {
                    DevExpress.ui.notify(response.message, "error", 2000);
                }
            },
            error: function (xhr) {
                const errMsg = xhr.responseJSON?.message || "Unexpected error.";
                DevExpress.ui.notify(errMsg, "error", 2000);
            }
        });
    });
