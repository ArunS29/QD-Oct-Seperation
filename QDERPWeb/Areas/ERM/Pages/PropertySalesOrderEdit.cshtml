                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%"))
                                </div>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 3 -->
                    <tr>
                            <td style="display: flex; align-items: flex-end;">
                                @(Html.DevExtreme().SelectBox()
                                                            .ID("ClientPoNo")
