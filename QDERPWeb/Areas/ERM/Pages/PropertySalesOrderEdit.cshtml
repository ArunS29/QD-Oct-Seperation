            $("#btnSave").on("click", function (e) {
            e.preventDefault();

            const gridInstance = $("#itemGrid").dxDataGrid("instance");

            // ✅ Save pending cell edits before proceeding
            if (gridInstance.hasEditData()) {
                gridInstance.saveEditData().done(() => {
                    validateAndSave();
                });
            } else {
                validateAndSave();
            }

            function validateAndSave() {
                // ✅ Validate required DropDown fields
                const requiredFields = [
                    { id: "#ClientNames", label: "Client Name" },
                    // { id: "#TypeOFSalesOrder", label: "Type of Sales Order" },
                    // { id: "#CompanyBranch", label: "Company Branch" },
                    // Add more if needed
                ];

                let allValid = true;
                let missingLabels = [];

                requiredFields.forEach(field => {
                    const $el = $(field.id);
                    const inst = $el.dxDropDownBox("instance");

                    if (inst) {
                        const value = inst.option("value");
                        if (!value) {
                            allValid = false;
                            missingLabels.push(field.label);
                            $el.addClass("dx-invalid");
                        } else {
                            $el.removeClass("dx-invalid");
                        }
                    } else {
                        console.warn("Instance not found:", field.id);
                    }
                });

                if (!allValid) {
                    DevExpress.ui.dialog.alert(
                        "Please fill the required field(s): " + missingLabels.join(", "),
                        "Validation Failed"
                    );
                    return;
                }

                // ✅ Helper to extract date in yyyy-MM-dd format
                   function getDateOnlyValue(dateBoxId) {
        var val = $(dateBoxId).dxDateBox("instance").option("value");
        if (!val) return null;
        // Format as yyyy-MM-dd (local date, no time)
        return val instanceof Date
            ? val.getFullYear() + '-' +
              String(val.getMonth() + 1).padStart(2, '0') + '-' +
              String(val.getDate()).padStart(2, '0')
            : val;
    }

