                    QuoteNo: $("#QuotationNo").dxTextBox("instance").option("value"),
                    QuotedQuantity: row.QuotedQuantity ?? null,
                    UnitRateMethod: row.UnitRateMethod ?? null,
                    Gscode: row.Gscode ?? "",
