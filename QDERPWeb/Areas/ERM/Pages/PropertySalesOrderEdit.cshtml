    const controlIds = [
        "SalesOrderNO",         // dxTextBox
        "SalesOrderDate",       // dxDateBox
        "ClientNamesDropDown",  // dxSelectBox
        "QuotationNo",          // dxTextBox
        "QuotationDate",        // dxDateBox
        "ClientRefName",        // dxTextBox
        "ClientContact",        // dxTextBox
        "ClientPoNo",           // dxSelectBox
        "ClientPoDate",         // dxDateBox
        "ClientEmail",          // dxTextBox
        "ReferenceNo",          // dxTextBox (Project + ClientRefNo)
        "SiteContactPerson",    // dxTextBox
        "Email",                // dxTextBox
        "MobileNo",             // dxTextBox
        "SiteLocation",         // dxTextBox
        "SiteRegion",           // dxSelectBox
        "Duration",             // dxSelectBox
        "PaymentMode",          // dxSelectBox
        "MobDemobBy",           // dxSelectBox
        "AdvanceAmount",        // dxNumberBox
        "CustomsCharges",       // dxSelectBox
        "CreditPeriod",         // dxSelectBox
        "CreditLimit",          // dxNumberBox
        "ddGetCompany",         // dxDropDownBox
        "SalesPerson",          // dxDropDownBox
        "OrderExpiryDate",      // dxDateBox
        "ddPreparedby",         // dxDropDownBox
        "ddVerifiedby",         // dxDropDownBox
        "ddApprovedby",         // dxDropDownBox
        "currencyexchangerate", // dxNumberBox
        "ddlGoodsGroup3",       // dxDropDownBox
        "ddlGoodsGroup4",       // dxDropDownBox
        "itemGrid"  ,            // dxDataGrid
        "btnSave",
        "btnSaveAndClose",
        "btnDelete",
        "btnDelete",
        "btnVerify",
        "btnApprove",
        "btnApprove",
        "btnAddNew",
        "btnSoreStock"
    ];

    controlIds.forEach(function (id) {
        const $el = $("#" + id);
        if (!$el.length) {
            console.warn("Element not found:", id);
            return;
        }

        const widget = $el.data("dxComponents"); // returns array of widget names
        if (!widget || !widget.length) {
            console.warn("No DevExtreme widget attached for:", id);
            return;
        }

        const widgetName = widget[0];
        const instance = $el[widgetName]("instance");

        if (!instance) return;

        // ✅ Handle widget-specific disabling
        if (["dxTextBox", "dxTextArea", "dxDateBox", "dxNumberBox"].includes(widgetName)) {
            instance.option("readOnly", true);
        } else if (["dxDropDownBox", "dxSelectBox"].includes(widgetName)) {
            instance.option("disabled", true);
        } else if (widgetName === "dxButton") {
            instance.option("disabled", true);
        } else if (widgetName === "dxDataGrid") {
            instance.option({
                editing: {
                    allowUpdating: false,
                    allowAdding: false,
                    allowDeleting: false
                },
                selection: { mode: "none" }
            });
        } else {
            console.warn("Unhandled widget type:", widgetName, "for", id);
        }
    });
}











