    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("600px")
        .DataSource(new JS("window.itemGridDataSource"))
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )
        .Columns(columns =>
        {
            columns.Add().DataField("SalesOrderChildId").Visible(false).AllowEditing(false);
            columns.Add().Caption("#").Width(60).CellTemplate(new JS("serialTemplate"));

            columns.Add().DataField("Gscode").Caption("Property Type Ordered");

            columns.Add()
            .DataField("Gsdescrpition")
            .Caption("Description")
            .Width(400)
            .EditCellTemplate(new JS("descriptionDropDownTemplate"));

            columns.Add()
            .DataField("UnitRateMethod")
            .Caption("Unit Rate Method")
            .Width(400)
            .EditCellTemplate(new JS("unitRateMethodDropDownTemplate"))
            .CellTemplate(new JS(@"
        function (container, options) {
        const unit = unitCodesList.find(u => u.UnitCode === options.value);
        container.text(unit ? unit.UnitDesc : options.value);
        }
        "));
            columns.Add().DataField("QuotedQuantity").Caption("Qty");
            columns.Add().DataField("QuotedUnitPrice").Caption("Unit Price");
            columns.Add().DataField("CostPrice").Caption("Gross Amount");
            columns.Add().DataField("QuotedDiscount").Caption("Mob Rate");
            columns.Add().DataField("QuotedDiscount").Caption("Demob Rate");
            columns.Add().DataField("LineTaxAmount").Caption("Net Total").AllowEditing(false);
        })
        .ColumnAutoWidth(true)
        .Width("100%")
        .WordWrapEnabled(true)
        .OnCellClick("function(e) { handleCellClick(e); }")
        .ColumnChooser(columnChooser => columnChooser
        .Enabled(true)
        .Title(new JS("formatMessage('Show/Hide Column')"))
        .Mode(GridColumnChooserMode.DragAndDrop)
        )
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(false))
        .Paging(p => p.Enabled(false))
        .Pager(pager => pager.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .ShowRowLines(true)
        .Editing(editing => editing
        .Mode(GridEditMode.Cell)
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
        )
        .OnContextMenuPreparing("onGridRightClick")
        )
    

</div>
