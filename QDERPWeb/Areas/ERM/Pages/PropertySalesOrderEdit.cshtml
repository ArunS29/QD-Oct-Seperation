                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%"))
                                </div>
                               
                                <div class="col-md-4">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("ClientContact")
                                    .Label("Client Contact No:")
