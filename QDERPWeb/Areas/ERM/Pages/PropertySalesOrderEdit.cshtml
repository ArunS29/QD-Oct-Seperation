<div id="lineItemContextMenu" style="display:none; position:absolute; z-index:9999;">
    <ul style="list-style:none; margin:0; padding:0; min-width:220px;">
        <li class="ctx-menu-item" data-action="delete-line" style="padding:8px;cursor:pointer;">
            <span style="color:red;font-size:18px;">&#10060;</span> Delete Line Item
        </li>
        <li class="ctx-menu-item" data-action="delete-selected" style="padding:8px;cursor:pointer;">
            <span style="color:red;font-size:18px;">&#10060;</span> Delete Selected Line Items
        </li>
        <li class="ctx-menu-item" data-action="add-line" style="padding:8px;cursor:pointer;">
            <span style="color:green;font-size:18px;">&#10133;</span> Add Line Item
        </li>
        <li class="ctx-menu-item" data-action="generate-jo" style="padding:8px;cursor:pointer;">
            <span style="color:#666;font-size:18px;">&#128202;</span> Generate Job Orders
        </li>
    </ul>
</div>

<!-- Generate Job Order Modal -->
<div id="generateJobOrderModal" style="display:none; position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); background:white; color:black; padding:20px; border-radius:8px; z-index:10000;">
    <div style="font-weight:bold; margin-bottom:10px;">Create Job Orders for:</div>
    <div>
        <label><input type="radio" name="joType" value="Manual Valves" checked> <b>Manual Valves</b></label><br>
        <label><input type="radio" name="joType" value="Control Valves"> <b>Control Valves</b></label><br>
        <label><input type="radio" name="joType" value="Safety Valves"> <b>Safety Valves</b></label>
    </div>
    <div style="margin-top:15px;">
        <button id="btnGenerateJO" style="margin-right:10px;">
            <span style="font-size:18px;">&#128202;</span> Generate JO
        </button>
        <button id="btnCloseJO" style="background:#c00;color:#fff;">
            <span style="font-size:18px;">&#10060;</span> Close
        </button>
    </div>
</div>

@using (Html.DevExtreme().NamedTemplate("ClientDropDownTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                        .ID("clientGrid")
                        .DataSource(ds => ds
                            .Mvc()
                                .Controller("ERSalesOrders")
                                .LoadAction("GetClientNames")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("ClientCode")
                        )
                        .Height(300)
                        .ShowBorders(true)
                        .FilterRow(f => f.Visible(true))
                        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                        .Selection(s => s.Mode(SelectionMode.Single))  // Single selection
                        .Columns(columns =>
                        {
                            columns.Add().DataField("ClientCode").Caption("Client Code");
                            columns.Add().DataField("ClientName").Caption("Client Name");
                        })
                        .OnSelectionChanged("onClientSelected")  // Trigger onClientSelected on row selection
                    )
}

