       function isDxInitialized($el, widgetName) {
        return $el.data(widgetName) !== undefined;
    }

    function setDefaultValue(fieldId) {
        const $el = $("#" + fieldId);
        let instance = null;

        if (isDxInitialized($el, "dxTextBox")) {
            instance = $el.dxTextBox("instance");
        } else if (isDxInitialized($el, "dxTextArea")) {
            instance = $el.dxTextArea("instance");
        } else {
            DevExpress.ui.notify("Field '" + fieldId + "' not initialized yet.", "warning", 1000);
            return;
        }

        const value = instance.option("value");

        if (value !== undefined) {
            localStorage.setItem(fieldId + "_default", value);
            DevExpress.ui.notify("Default value for " + fieldId + " saved!", "success", 1000);
        }
    }

    function loadDefaultValue(fieldId) {
        return localStorage.getItem(fieldId + "_default");
    }

    function setWidgetValue(fieldId, value) {
        const $el = $("#" + fieldId);
        let instance = null;

        if (isDxInitialized($el, "dxTextBox")) {
            instance = $el.dxTextBox("instance");
        } else if (isDxInitialized($el, "dxTextArea")) {
            instance = $el.dxTextArea("instance");
        }

        if (instance) {
            instance.option("value", value);
        }
    }

