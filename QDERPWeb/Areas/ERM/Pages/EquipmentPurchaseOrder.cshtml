                    item.Add().Text(new JS("formatMessage('Cancellation')")).Icon("home").Title(new JS("formatMessage('Cancellation')")).Template(@<text>
                    <div style="padding:10px; width:50%;">
                        @(Html.DevExtreme().TextArea()
                        .ID("Cancellation")
                        .Label(new JS("formatMessage('Cancellation Remarks')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ElementAttr("style", "height:160px !important;")   
