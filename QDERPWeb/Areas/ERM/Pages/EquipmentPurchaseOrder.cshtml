                $("#Subject").dxTextArea("instance")?.option("value", data.Master.SubjectTitle ?? "");
                $("#Cancellation").dxTextArea("instance")?.option("value", data.Master.CancellationRemarks ?? "");
                $("#ReferenceNo").dxTextBox("instance")?.option("value", data.Master.SupplierRefNo ?? "");
                setDxFieldValue("verifiedBy2", data.Master.VerifiedBy ?? "");
                setDxFieldValue("approvedBy2", data.Master.ApprovedBy ?? "");
