    function deletePoChild(poChildNos) {
        if (!Array.isArray(poChildNos)) poChildNos = [poChildNos];

        DevExpress.ui.dialog.confirm(
            `Are you sure you want to delete ${poChildNos.length > 1 ? "these line items" : "this line item"}?`,
            "Confirm Delete"
        ).done(function (dialogResult) {
            if (dialogResult) {
                // ✅ Wrap PochildNo values as child objects expected by server
                const childrenPayload = poChildNos.map(poChildNo => ({ PochildNo: poChildNo }));

                $.ajax({
                    url: '/api/PurchaseOrders/DeletePoChild',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Children: childrenPayload }), // ✅ matches backend model
                    success: function (response) {
                        if (response.success) {
                            DevExpress.ui.notify(response.message, "success", 2000);
                            const grid = $("#itemGrid").dxDataGrid("instance");
                            grid.refresh();
                        } else {
                            DevExpress.ui.notify(response.message, "error", 2000);
                        }
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("Delete failed: " + (xhr.responseJSON?.message || xhr.statusText), "error", 3000);
                    }
                });
            }
        });
    }

$("#btnSave").on("click", function () {
    const btn = $("#btnSave").dxButton("instance");
    btn.option("text", "Update");
    btn.option("disabled", true); // prevent double-click saves

    // 🔹 Validate Supplier selection
    const supplier = $("#SupplierName").dxSelectBox("instance")?.option("value");
    if (!supplier) {
        DevExpress.ui.notify("Please select a Supplier.", "error", 3000);
        $("#SupplierName").dxValidator("instance")?.validate();
        btn.option("disabled", false);
        return;
    }

    // 🔹 Collect Master data
    const master = {
        Pono: $("#PurchaseOrderNo").dxTextBox("instance")?.option("value"),
        Podate: $("#PoDate").dxDateBox("instance")?.option("value"),
        SupplierCode: supplier,
        PorevisionNo: $("#RevNo").dxSelectBox("instance")?.option("value"),
        SupplierQuoteNo: $("#SupplierQuotationNo").dxTextBox("instance")?.option("value"),
        SupplierQuoteDate: $("#SupplierQuoteDate").dxDateBox("instance")?.option("value"),
        Attention: $("#AttentionTo").dxTextBox("instance")?.option("value"),
        SupplierContactNo: $("#SupplierContactNo").dxTextBox("instance")?.option("value"),
        SupplierContactEmail: $("#SupplierEmail").dxTextBox("instance")?.option("value"),
        ProjectMasterCode: $("#Project").dxSelectBox("instance")?.option("value"),
        Project: $("#ClientProjectRef").dxTextBox("instance")?.option("value"),
        Posummary: $("#PoSummary").dxTextArea("instance")?.option("value"),
        Pointroduction: $("#PoIntro").dxTextArea("instance")?.option("value"),
        PothanksNote: $("#Thanks").dxTextArea("instance")?.option("value"),
        SubjectTitle: $("#Subject").dxTextArea("instance")?.option("value"),
        CancellationRemarks: $("#Cancellation").dxTextArea("instance")?.option("value"),
        AdditionsText: $("#ShipmentHandling").dxTextBox("instance")?.option("value"),
        AdditionsAmount: $("#ShipmentHandlingMethod").dxNumberBox("instance")?.option("value"),
        DiscountsText: $("#Discount").dxTextBox("instance")?.option("value"),
        DeductionsAmount: $("#DiscountMethod").dxNumberBox("instance")?.option("value"),
        CompanyBranch: $("#CompanyName").dxSelectBox("instance")?.option("value"),
        VatapplicableRate: $("#ddGetTax").dxDropDownBox("instance")?.option("value"),
        SubmittedBy: $("#preparedBy2").dxSelectBox("instance")?.option("value"),
        VerifiedBy: $("#verifiedBy2").dxSelectBox("instance")?.option("value"),
        SupplierRefNo: $("#ReferenceNo").dxTextBox("instance")?.option("value"),
        ApprovedBy: $("#approvedBy2").dxSelectBox("instance")?.option("value"),
        CurrencyRate: $("#currencyexchangerate").dxNumberBox("instance")?.option("value"),
        BaseCurrencyId: $("#ddlGoodsGroup4").dxDropDownBox("instance")?.option("value"),
        CurrencyId: $("#ddlGoodsGroup3").dxDropDownBox("instance")?.option("value"),
    };

    // 🔹 Validate PO number
    if (!master.Pono) {
        DevExpress.ui.notify("PO number is missing. Please refresh and try again.", "error", 3000);
        btn.option("disabled", false);
        return;
    }

    // 🔹 Validate grid
    const grid = $("#itemGrid").dxDataGrid("instance");
    if (!grid) {
        console.warn("itemGrid is not initialized");
        btn.option("disabled", false);
        return;
    }

    grid.saveEditData();
    let children = grid.getDataSource()?.items() || [];
    children = children.map(({ PropertyPochildNo, ...rest }) => rest); // remove ID if needed

    // 🔹 Send AJAX request
    $.ajax({
        url: "/api/EQPurchaseOrder/SavePurchaseOrder",
        type: "POST",
        data: JSON.stringify({ master, children }),
