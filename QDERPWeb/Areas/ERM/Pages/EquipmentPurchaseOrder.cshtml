                        // Auto-generate Purchase Order Number
                        $.ajax({
                            url: "/api/EQPurchaseOrder/GetAutoGeneratedPurchaseorderNumber",
                            type: "GET",
                            success: function (data) {
                                console.log("Auto-generated PO No:", data);

                                const invoiceBox = $("#PurchaseOrderNo").dxTextBox("instance");
