                //   $("#ddlGoodsGroup3").dxDropDownBox("instance")?.option("value", data.Master.CurrencyId ?? "");

            // ✅ Load children grid
            if (Array.isArray(data.Children)) {
                const cleanChildren = data.Children.map((row, index) => ({
                    ...row,
