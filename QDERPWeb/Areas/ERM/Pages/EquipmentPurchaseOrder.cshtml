@page
@model QD.ERP.Web.Areas.ERM.Pages.EquipmentPurchaseOrderModel
@{
}
<style>
    .my-description-column .dx-texteditor-input {
    height: 120px !important;
}

 .custom-btn-size {
    height: 70px !important;
    min-height: 70px !important;
    line-height: 70px !important;
    width: 70px !important;
    min-width: 70px !important;
}
    .ledgerResult {
        overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
        width: 100%;
    }

    .titleCard-toggle1 {
        display: none;
    }
    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold;
        font-size: 14px;
        padding: 10px 15px;
    }


        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue;
            color: white !important;
        }

    .dx-tabpanel {
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        padding: 5px 10px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
    }

    .form-row {
        display: flex;
        gap: 10px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .select-box {
        width: 20vh;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .left-card, .right-card {
        padding: 10px;
        border-radius: 6px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }
   
    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .layout-container {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-column {
        flex: 1 1 48%;
        display: flex;
        flex-direction: column;
    }

    .field-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.3rem;
    }

    .field-label {
        font-size: 0.95rem;
        font-weight: 500;
        color: #333;
    }

    .field-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-solid {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: #6c757d;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-outline {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: transparent;
        color: #6c757d;
        border: 1px solid #6c757d;
        border-radius: 4px;
        cursor: pointer;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

 

    .dx-card {
        background: var(--background-color);
    }


   

     #goToTopBtn { 
       z-index: 100; 
     } 
</style>
<input id="formId" value="EQPurchaseOrderEdit" type="hidden" />
<div class="dx-card-container">
    <div class="dx-card-header minimal-header">
        <div class="card-title-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div id="PurchaseOrder" class="titleText no-border-title"></div>
    </div>
</div>
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%").Height(240)
                .Items(item =>
                {
                    item.Add()
                .Title(new JS("formatMessage('Purchase Order Details')"))
                .Icon("folder")
                .Text(new JS("formatMessage('Purchase Order Details')"))
                .Template(@<text>
            <div class="p-3">
                <table style="table-layout: fixed; width: 125%;">
                    <colgroup>
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                    </colgroup>

                    <!-- Row 1 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("PurchaseOrderNo")
                            .Value("")
                            .Label(new JS("formatMessage('Purchase Order No:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ReadOnly(true)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().SelectBox()
                            .ID("RevNo")
                            .Label(new JS("formatMessage('REV.No')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("PoDate")
                            .Label(new JS("formatMessage('PO Date')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .DisplayFormat("dd-MMM-yyyy")
                            .Value(DateTime.Now)
                            .Width("100%"))
                        </td>   
                        <td>
                            <div style="display: flex; align-items:end;">
                                @(Html.DevExtreme().SelectBox()
                                .ID("SupplierName")
                                .Label(new JS("formatMessage('Supplier Name:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .StylingMode(EditorStylingMode.Outlined)
                                .Width("100%")
                                .DataSource(d => d.Mvc()
                                .Controller("PurchaseOrders")
                                .LoadAction("GetClients")
                                )
                                .ValidationRules(rules =>
                                    {
                                    rules.AddRequired()
                                    .Message("Supplier Name is required");
                                    })
                                .ValueExpr("SupplierCode")
                                .DisplayExpr("SupplierName")
                                .SearchEnabled(true)
                                .SearchExpr("SupplierName")
                                  .OnOpened("onSelectBoxOpened")
                                .ShowClearButton(true)
                                .OnValueChanged("onSupplierChanged")
                                .Buttons(buttons => {
								// Clear Button
								buttons.Add()
									.Name("clear");

								// Add Client Button
								buttons.Add()
									.Name("AddSupplier")
									.Location(TextEditorButtonLocation.After)
									.Widget(w => w.Button()
										.Type(ButtonType.Default)
										.Icon("plus")
										.ElementAttr(new { @class = "custom-hover-button add-hover" })
										.OnClick("redirecttoClientLeadmaster1")
									);

								// Edit Client Button
								buttons.Add()
									.Name("btnEditClient")
									.Location(TextEditorButtonLocation.After)
									.Widget(w => w.Button()
										.Type(ButtonType.Default)
										.Icon("edit")
										.ElementAttr(new { @class = "custom-hover-button edit-hover" })
											.OnClick("editSelectedSupplier")
									);
									  buttons.Add()
									   .Name("dropDown");
							})
						)
                             </div>
                        </td>
                    </tr>
                    <!-- Row 2 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierQuotationNo")
                            .Label(new JS("formatMessage('Supplier Quotation No:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("SupplierQuoteDate")
                            .Label(new JS("formatMessage('Supplier Quote Date:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .DisplayFormat("dd-MMM-yyyy")
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            <div style="display: flex; align-items:end;">
                              @(Html.DevExtreme().TextBox()
                                    .ID("AttentionTo")
                                    .Label(new JS("formatMessage('Attention To:')"))
                                    .LabelMode(EditorLabelMode.Floating)
                                    .Width("100%")
                                    .Buttons(buttons =>
                                    {
                                        buttons.Add()
                                            .Name("AddAttention")
                                            .Location(TextEditorButtonLocation.After)
                                            .Widget(w => w.Button()
                                                .Type(ButtonType.Default)
                                                .Icon("plus")
                                                .OnClick("onSupplierContactClick")
                                                .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                            );
                                    })
                            )
                            </div>
                        </td>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierContactNo")
                            .Label(new JS("formatMessage('Supplier Contact No:')"))
                            .InputAttr(new { onkeypress = "return event.charCode >= 48 && event.charCode <= 57", type = "text", maxlength = "15" })
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                       
                    </tr>

                    <!-- Row 3 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("ReferenceNo")
                            .Label(new JS("formatMessage('Reference No:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            <div style="display: flex; align-items:end;">
                                @(Html.DevExtreme().SelectBox()
                                .ID("Project")
                                .Label(new JS("formatMessage('Project:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .StylingMode(EditorStylingMode.Outlined)
                                .Width("100%")
                                .SearchEnabled(true)
                                .SearchExpr("ProjectDescription")
                                .OnOpened("onSelectBoxOpened")
                                .ShowClearButton(true)
                                .DataSource(d => d.Mvc()
                                .Controller("PurchaseOrders")
                                .LoadAction("GetProjects")
                                )
                                .ValueExpr("ProjectId")
                                .DisplayExpr("ProjectDescription")
                              
                                    .Buttons(buttons =>
                                    {
                                    buttons.Add()
                                    .Name("dropDown");
                                    buttons.Add()
                                    .Name("AddProject")
                                    .Location(TextEditorButtonLocation.After)
                                    .Widget(w => w.Button()
                                    .Type(ButtonType.Default)
                                    .Icon("plus")
                                    .OnClick("AddProject")
                                    .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                    );
                                 })
                               )
                              
                            </div>
                        </td>
                        @* <td>
                            @(Html.DevExtreme().SelectBox()
                            .ID("SalesPerson")
                            .Label(new JS("formatMessage('Sales Person:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%")
                            .DataSource(d => d.Mvc()
                            .Controller("AddNewClientRequest")
                            .LoadAction("GetSalesPerson")
                            )
                            .ValueExpr("SalesPersonCode")
                            .DisplayExpr("SalesPersonName")
                            .SearchEnabled(true)
                            .SearchExpr("SalesPersonName")
                                .Option("searchMode", "contains")  
                            )

                        </td> *@
                       @*  <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("RFQNo")
                            .Label(new JS("formatMessage('RFQ No')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td> *@
                         <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierEmail")
                            .Label(new JS("formatMessage('Supplier Email:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .Mode(TextBoxMode.Email)
                            .ValidationRules(value => value.AddEmail().Message(new JS("formatMessage('Please Enter the Valid Email Address')")))
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                         <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("ClientProjectRef")
                            .Label(new JS("formatMessage('Client Project Ref:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                    </tr>
                </table>
            </div>  

        </text>);
                    item.Add().Title(new JS("formatMessage('Order Details')")).Icon("detailslayout").Text(new JS("formatMessage('Order Details')")).Template(@<text>
            <div class="layout-container">
                <!-- Subject and Po Summary -->
