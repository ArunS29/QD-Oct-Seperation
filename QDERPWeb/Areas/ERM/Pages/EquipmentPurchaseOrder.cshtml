 function createDropDown($container, cellInfo, data) {
    $("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({
        valueExpr: "PropertyTypeId",
        displayExpr: "PropertyType",
        value: cellInfo.value,
        dataSource: data,      
        searchEnabled: true,
        searchExpr: "PropertyType",
        searchMode: "contains",
        dropDownOptions: { width: 545 },

        contentTemplate: function (e) {
            return $("<div>").dxDataGrid({
                dataSource: data,
                keyExpr: "PropertyTypeId",
                height: 300,
                paging: { enabled: false },
                searchPanel: {
                    visible: true,
                    width: 540,
                    placeholder: "Search..."
                },
                selection: { mode: "single" },
                columns: [
                    { dataField: "PropertyTypeId", caption: "ID", width: 80 },
                    { dataField: "PropertyType", caption: "Property Type", width: 200 }
                ],
                onSelectionChanged: function (selectedItems) {
                    const selectedItem = selectedItems.selectedRowsData[0];
                    if (!selectedItem) return;

                    // set value in editing cell
                    cellInfo.setValue(selectedItem.PropertyTypeId);

                    // also update other column values in grid row
                    const dataGrid = $("#itemGrid").dxDataGrid("instance");
                    const rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);

                    if (rowIndex !== -1) {
                        dataGrid.cellValue(rowIndex, "PropertyTypeId", selectedItem.PropertyTypeId);
                        dataGrid.cellValue(rowIndex, "PropertyType", selectedItem.PropertyType);
                    }

                    e.component.close();
                }
            });
        }
    });
}

