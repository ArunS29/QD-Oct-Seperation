                                    setDxFieldValue("preparedBy2", response.Master.SubmittedBy ?? "");
                                    $("#Discount").dxTextBox("instance")?.option("value", response.Master.DiscountsText ?? "");
                                    $("#Subject").dxTextArea("instance")?.option("value", response.Master.SubjectTitle ?? "");
                                    $("#Cancellation").dxTextArea("instance")?.option("value", response.Master.CancellationRemarks ?? "");
                                    $("#ReferenceNo").dxTextBox("instance")?.option("value", response.Master.SupplierRefNo ?? "");
                                    setDxFieldValue("verifiedBy2", response.Master.VerifiedBy ?? "");
                                    setDxFieldValue("approvedBy2", response.Master.ApprovedBy ?? "");
                                    $("#currencyexchangerate").dxNumberBox("instance")?.option("value", response.Master.CurrencyRate ?? "");
                                    setDxFieldValue("ddlGoodsGroup4", response.Master.BaseCurrencyId ?? "");
                                    setDxFieldValue("ddlGoodsGroup3", response.Master.CurrencyId ?? "");
                                }

                                // ✅ Load child rows into grid
                                $.ajax({
                                    type: "GET",
                                    url: `/api/EQPurchaseOrder/GetPurchaseOrderByRefNo?poNo=${encodeURIComponent(Pono)}`,
                                    dataType: 'json',
                                    success: function (gridResponse) {
                                        console.log("Grid", gridResponse);

                                        if (Array.isArray(response.Children)) {
                                            const cleanChildren = response.Children.map((row, index) => ({
                                                ...row,
                                                SNo: index + 1
                                            }));

                                            const grid = $("#ItemGrid").dxDataGrid("instance");
                                            if (grid) {
                                                grid.option("dataSource", cleanChildren);
                                                grid.refresh();
                                            }
                                        }
                                    },
                                    error: function (xhr, status, error) {
                                        console.error("Error fetching grid data:", error);
                                    }
                                });

                            } else {
                                console.warn("No client details found in the response.");
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Error fetching client details:", error);
                        }
                    });
                }

