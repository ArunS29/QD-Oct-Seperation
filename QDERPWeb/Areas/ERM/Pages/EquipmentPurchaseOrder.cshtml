             function setDxFieldValue(fieldId, value) {
                const $el = $("#" + fieldId);
                if ($el.length === 0) return;

                // Try all known DevExtreme widgets
                const widgetTypes = [
                    "dxTextBox", "dxTextArea", "dxDateBox", "dxSelectBox", "dxDropDownBox", "dxNumberBox", "dxCheckBox"
                ];

                for (let i = 0; i < widgetTypes.length; i++) {
                    const type = widgetTypes[i];
                    if ($el.data(type)) {
                        const instance = $el[type]("instance");
                        if (type === "dxCheckBox") {
                            instance.option("value", !!value);
                        } else if (type === "dxSelectBox" || type === "dxDropDownBox") {
                            // Wait for dataSource to load, then set value
                            instance.getDataSource().load().done(function(items) {
                                // Only set if value exists in dataSource
                                if (items.some(item => item[instance.option("valueExpr")] == value)) {
                                    instance.option("value", value);
                                }
                            });
                        } else {
                            instance.option("value", value);
                        }
                        break;
                    }
                }
            }
