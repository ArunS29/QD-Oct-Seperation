        url: "/api/PurchaseOrders/SaveReportAttribute",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({
            reportNo: "IMS-PO-001",
            field: fieldName,
            value: value
        }),
        success: function () {
            DevExpress.ui.notify(`PO ${name} has been set as default.`, "success", 2000);
        },
        error: function (xhr) {
            DevExpress.ui.dialog.alert("Failed to save data", "Error");
            console.error("Save error:", xhr.responseText);
        }
    });
}
