	const allButtonIds = [
    "ddButtonLayout",
    "btnAddNew",
    "btnSubmit",
    "btnApprove",
    "btnVerify",
    "btnDelete",
    "btnPrint4",
    "btnAttach",
    "btnBack",
    "btnSaveAndClose",
    "btnSave",
    "btnMoveDown",
    "btnMoveUp"
];


	allButtonIds.forEach(id => {
		const keepEnabled = exceptions.includes(id);
		const $el = $("#" + id);

		if ($el.length) {
			let instance = DevExpress.ui.dxButton.getInstance($el[0]);
			if (!instance) {
				instance = DevExpress.ui.dxDropDownButton.getInstance($el[0]);
			}

			if (instance) {
				instance.option("disabled", !keepEnabled);
			} else {
				console.warn("Instance not found for:", id);
			}
		}
	});
