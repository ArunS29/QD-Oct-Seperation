                                    .LoadAction("GetDocumentSignatories")
                                    )
                                    .ValueExpr("SignatoryName")
                                    .DisplayExpr("SignatoryName")
                                    .ShowClearButton(true)
                                    .Label(new JS("formatMessage('Verified By:')"))
                                    .LabelMode(EditorLabelMode.Floating)
                                    .ShowDropDownButton(true)
                                    .Width("100%")
                                    .SearchEnabled(true)
                                    .SearchExpr("SignatoryName")
                                     .Option("searchMode", "contains") 
