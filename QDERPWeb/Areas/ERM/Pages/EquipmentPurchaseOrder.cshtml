   function deletePurchaseOrder() {
        const poNo = $("#PurchaseOrderNo").dxTextBox("instance")?.option("value");
    if (!poNo) {
        DevExpress.ui.notify("PO number is missing.", "error", 3000);
        return;
    }

    // Optional: confirm with the user
    DevExpress.ui.dialog.confirm("Are you sure you want to delete this purchase order?", "Confirm Delete")
        .done(function (confirmed) {
            if (!confirmed) return;

            $.ajax({
                url: `/api/EQPurchaseOrder/DeletePurchaseOrder/${encodeURIComponent(poNo)}`,
                type: "DELETE",
                success: function (result) {
                    if (result?.success) {
                        DevExpress.ui.notify(result.message, "success", 3000);

                              // ✅ Navigate to EquipmentPurchaseOrder page after 2 seconds
                       setTimeout(function () {
							const tenantName = window.tenantName || "defaultTenant"; // replace with your actual tenantName logic
							window.location.href = `/${tenantName}/ERM/EquipmentPurchaseOrder`;
						}, 300);
                    } else {
                        // Show specific warning messages returned from API
                        DevExpress.ui.notify(result?.message || "Delete failed", "error", 3000);
                    }
                },
                error: function (xhr) {
                    // Try to parse JSON error message from API
                    const errMsg = xhr.responseJSON?.message || xhr.responseText || xhr.statusText;
                    DevExpress.ui.notify("Error: " + errMsg, "error", 3000);
                }
            });
        });
}

