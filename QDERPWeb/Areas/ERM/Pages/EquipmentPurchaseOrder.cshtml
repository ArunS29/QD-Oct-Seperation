        if (values.Certification) descParts.push(values.Certification);
        if (values.Capacity) descParts.push(values.Capacity);
        if (values.Operator) descParts.push(values.Operator);
        if (values.Attachment) descParts.push(values.Attachment);

        let combined = descParts.join(" | ");
        form.getEditor("PropertyAddlDescription").option("value", combined);
    }

    // Function to save form data back to grid
 function saveToGrid(form) {
    const formData = form.option("formData");

    // update grid row value
    grid.cellValue(rowIndex, "PropertyAddlDescription", formData.PropertyAddlDescription);

    // also update in dataSource immediately
    const ds = grid.getDataSource();
    const store = ds.store();

    const rowKey = grid.getKeyByRowIndex(rowIndex);

    store.update(rowKey, formData)
        .then(() => {
            ds.reload(); // refresh grid dataSource
            DevExpress.ui.notify("Description saved to grid & datasource.", "success", 2000);
        });
}

    const formInstance = $container.dxForm({
        formData: {
            PropertyAddlDescription: rowData.PropertyAddlDescription || "",
            Certification: rowData.Certification || "",
            Capacity: rowData.Capacity || "",
            Operator: rowData.Operator || "",
            Attachment: rowData.Attachment || ""
        },
        labelLocation: "top",
        colCount: 2,
        items: [
            {
                colSpan: 2,
                template: function() {
                    return $("<div>")
                        .addClass("flex justify-between items-center")
                        .append(`<label style="font-weight:bold;">Detailed Description / Specification:</label>`)
                        .append(`<a href="#" id="btnUseItemDesc-${rowIndex}" style="margin-left:auto; font-size:12px; text-decoration:underline; cursor:pointer;">Use Item Description</a>`)
                        .append(`<span id="btnAddDesc-${rowIndex}" style="margin-left:10px; cursor:pointer;">➕</span>`);
                }
            },
            {
                dataField: "PropertyAddlDescription",
                colSpan: 2,
                editorType: "dxTextArea",
                editorOptions: {
                height: 120,
                labelMode: "hidden",
                width: "100%"
                },
                cssClass: "my-description-column"
            },
            {
                dataField: "Certification",
                editorType: "dxSelectBox",
                editorOptions: {
                    placeholder: "Select Certification",
                    items: [
                        "ARAMCO CERTIFIED",
                        "TUV CERTIFIED",
                        "ARAMCO / SPSP CERTIFIED"
                    ],
                    acceptCustomValue: true,
                    onValueChanged: function(e) {
                        updateDescription(formInstance);
                    }
                }
            },
            {
                dataField: "Capacity",
                editorType: "dxSelectBox",
                editorOptions: {
                    placeholder: "Select Capacity",
                    acceptCustomValue: true,
                    onValueChanged: function(e) {
                        updateDescription(formInstance);
                    }
                }
            },
            {
                dataField: "Operator",
                editorType: "dxSelectBox",
                editorOptions: {
                    placeholder: "Select Operator",
                    items: [
                        "With Operator",
                        "With Aramco Certified Operator",
                        "Without Operator"
                    ],
                    acceptCustomValue: true,
                    onValueChanged: function(e) {
                        updateDescription(formInstance);
                    }
                }
            },
            {
                dataField: "Attachment",
                editorType: "dxSelectBox",
                editorOptions: {
                    placeholder: "Select Attachment",
                    items: [
                        "WITH BUCKET",
                        "WITH BUCKET / FORK",
                        "WITH PWAS"
                    ],
                    acceptCustomValue: true,
                    onValueChanged: function(e) {
                        updateDescription(formInstance);
                    }
                }
            },
            {
                colSpan: 2,
                template: function() {
                    return $("<div>")
                        .addClass("flex justify-end")
                        .append($("<div>").dxButton({
                            text: "Save",
                            type: "default",
                            onClick: function() {
                            saveToGrid(formInstance);
                            $("#rowPopover").dxPopover("instance").hide();
                          }
                    }));
                }
            }
        ]
    }).dxForm("instance");
}

 $(document).ready(function () {
        console.log('Start permission handling');
        var formId = "EQPurchaseOrderEdit";
        // Call the API to get permissions
        $.ajax({
            url: '/api/Permissions/GetAccessDetails?formId=' + formId,
            type: 'GET',
            contentType: 'application/json',
            success: function (response) {
                console.log("API Response:", response); // Log the API response

                if (response.success && response.permissions) {
                    // Default visibility and enable status for buttons
                    var controlStates = {
                        "btnSave":{ "Visible": false, "Enabled": false },
                        "btnSaveAndClose": { "Visible": false, "Enabled": false },
                        "btnDelete": { "Visible": false, "Enabled": false },
                        "btnBack": { "Visible": false, "Enabled": false },
                        "btnSubmit": { "Visible": false, "Enabled": false },
                        "btnVerify": { "Visible": false, "Enabled": false },
                        "btnApprove": { "Visible": false, "Enabled": false },
                        "btnCancel": { "Visible": false, "Enabled": false },
                        "btnAttach": { "Visible": false, "Enabled": false },
                        "btnAddNew": { "Visible": false, "Enabled": false },
                        "btnPrint4": { "Visible": false, "Enabled": false },
                    };


                    // Check for full access
                    var fullAccess = response.permissions.find(p =>
                        p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
                    );

                    if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
                        // Grant full access: make all controls visible and enabled
                        Object.keys(controlStates).forEach(key => {
                            controlStates[key] = { "Visible": true, "Enabled": true };
                        });
                    } else {
                        // Update states based on specific permissions for each control
                        Object.keys(controlStates).forEach(key => {
                            var controlPermission = response.permissions.find(p =>
                                p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
                            );
                            if (controlPermission) {
                                controlStates[key] = {
                                    "Visible": controlPermission.ItemVisible || false,
                                    "Enabled": controlPermission.ItemEnabled || false
                                };
                            }
                        });
                    }

                        console.log("Control States:", controlStates); // Log the control states

                        // Dynamically update button visibility and enabled state
                        Object.keys(controlStates).forEach(key => {
                            var button = document.getElementById(key);
                            if (button) {
                                // Handle visibility
                                button.style.display = controlStates[key].Visible ? "inline-block" : "none";
                                // Handle enable/disable state
                                button.disabled = !controlStates[key].Enabled;
                                console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
                            } else {
                                console.warn(`Button with ID "${key}" not found in the DOM.`);
                            }
                        });
                    } else {
                        console.warn("Failed to fetch permissions or no permissions available.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching permissions:", error);
                    alert('An error occurred while fetching permissions. Please try again.');
                }
            });
            showColumnChooser();
            console.log('End permission handling');
        });

