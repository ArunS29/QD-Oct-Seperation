                       item.Add()
                    .Text(new JS("formatMessage('Branch / Division')"))
                    .Icon("user")
                    .Title(new JS("formatMessage('Branch/Divisions')"))
                    .Template(@<text>
                        <div class="layout-container" style="display: flex; gap: 0px; padding: 15px; flex-direction: row;">

                            <!-- Branch & Divisions -->
                            <div style="padding: 10px; border-radius: 6px; flex: 1;">
                                @(Html.DevExtreme().SelectBox()
                                    .ID("CompanyName")
                                    .Label(new JS("formatMessage('Company Branch')"))
                                    .DataSource(d => d.Mvc()
                                        .Controller("DeliveryNote")
                                        .LoadAction("GetCompanyBranch")
                                    )
                                    .DisplayExpr("CompanyName")
                                    .ValueExpr("CompanyId")
                                    .LabelMode(EditorLabelMode.Floating)
                                    .Width("100%")
                                    .SearchEnabled(true)
                                    .SearchExpr("CompanyName")
                                    .Option("searchMode", "contains")
                                )
                            </div>

                            <!-- Shipment & Discounts -->
                            <div style="padding: 10px; flex: 1;">

                                <!-- Tax Slab -->
                                <div style="flex: 2; margin-bottom: 10px;">
                                    @(Html.DevExtreme().DropDownBox()
															.Label(new JS("formatMessage('Expected VAT %')"))
															.DataSource(d => d.WebApi()
															.Controller("AddNewClientRequest")
															.LoadAction("GetTax")
															.LoadMode(DataSourceLoadMode.Raw)
															.Key("PurchaseTaxSlabCode")
															)
															.LabelMode(EditorLabelMode.Floating)
															.ID("ddGetTax")
															.Width(900)
															.OpenOnFieldClick(false)
															.ValueChangeEvent("input")
															.HoverStateEnabled(true)
															.ValueExpr("PurchaseTaxSlabCode")
															.DisplayExpr("PurchaseTaxSlab")
															.OnInput("dropDownBoxOnInput")
															.OnOpened("onOpened")
															.TabIndex(1)
															.Width("100%")
															.OnKeyDown("onKeyDown")
															.ContentTemplate(new TemplateName("GetTaxContentTemplate"))
															)
                                </div>

                                <!-- Shipments & Handling -->
                                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                                    <div style="flex: 2;">
                                        @(Html.DevExtreme().TextBox()
                                            .ID("ShipmentHandling")
                                            //.Placeholder("(+) Shipments & Handling:")
                                            .Value("(+) Shipments & Handling")
                                            .LabelMode(EditorLabelMode.Hidden)
                                            .Width("100%")
                                        )
                                    </div>
                                    <div style="flex: 1;">
                                        @(Html.DevExtreme().NumberBox()
                                            .ID("ShipmentHandlingMethod")
                                            .LabelMode(EditorLabelMode.Hidden)
                                            .Value(0.00)
                                            .Min(0)
										    .Max(99999999)
										    .Placeholder("0.00")
										    .Format("#,##0.00")
										    .TabIndex(11)
										    .InputAttr(new
										    {
											     type = "number",
											    step = "0.01",
											    style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
											    maxLength = 16,
											    autocomplete = "off"
										    })
                                            .Width("100%")
                                        )
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div style="display: flex; gap: 10px;">
                                    <div style="flex: 2;">
                                        @(Html.DevExtreme().TextBox()
                                            .ID("Discount")
                                            //.Placeholder("(-) Discount")
                                            .Value("(-) Discount")
                                            .LabelMode(EditorLabelMode.Hidden)
                                            .Width("100%")
                                        )
                                    </div>
                                    <div style="flex: 1;">
                                        @(Html.DevExtreme().NumberBox()
                                            .ID("DiscountMethod")
                                            .LabelMode(EditorLabelMode.Hidden)
                                            .Value(0.00)
                                            .Min(0)
										    .Max(99999999)
										    .Placeholder("0.00")
										    .Format("#,##0.00")
										    .TabIndex(11)
										    .InputAttr(new
										    {
											    type = "number",
											    step = "0.01",
											    style = "font-family: Cambria; font-size: 11pt; font-weight: bold; color: maroon; text-align: right;",
											    maxLength = 16,
											    autocomplete = "off"
										    })
                                                .Width("100%")
                                            )
                                    </div>
                                </div>
                            </div>
                        </div>
                    </text>);
                    item.Add().Text(new JS("formatMessage('Signatories')")).Icon("user").Title(new JS("formatMessage('Signatories')")).Template(@<text>
            <div class="layout-container">
                <div class="p-3">
                    <table class=" table-borderless w-100">
                        <tbody>
                            <tr>
                                <!-- Prepared By SelectBox -->
