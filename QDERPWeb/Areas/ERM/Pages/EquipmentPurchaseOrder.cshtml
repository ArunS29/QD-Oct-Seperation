                function loadClientDetails(Pono) {
                    $.ajax({
                        url: `/api/EQPurchaseOrder/GetAbbreviatedCompanyCode?code=${encodeURIComponent(Pono)}`,
                        type: 'GET',
                        dataType: 'json',
                        success: function (response) {
                            if (response) {
                                console.log("Client Details:", response);

                                let Approved = response.IsApproved;

                                // ✅ Disable buttons if already approved
                                if (Approved === true) {
                                    hideAllButtonsExcept([
                                        "btnPrint1",
                                        "ddButtonLayout",
                                        "btnBack",
                                        "btnAttach"
                                    ]);
                                    disableAllDropDownsAndSelects();

                                    const gridInstance = $("#ItemGrid").dxDataGrid("instance");
                                    if (gridInstance) {
                                        gridInstance.option({
                                            editing: {
                                                allowUpdating: false,
                                                allowAdding: false,
                                                allowDeleting: false
                                            },
                                            selection: {
                                                mode: "none"
                                            }
                                        });
                                    }
                                }

                                // ✅ Use response.Master safely
                                if (response.Master) {
                                    $("#btnSave").dxButton("instance").option("text", "Update");
                                    $("#PurchaseOrderNo").dxTextBox("instance")?.option("value", response.Master.Pono ?? "");
