            const fields = ["Subject", "PoSummary", "PoIntro", "Thanks","BillingAddress","ShippingAddress","BillingAddress"];
            fields.forEach((fieldId) => {
                const value = loadDefaultValue(fieldId);
                if (value !== null) {
                    setWidgetValue(fieldId, value);
                }
            });
        }, 300); // Delay to allow DevExtreme to finish rendering
    });
