async function onFinalAddClick(e) {
    debugger;

    const quoteNo = $("#txtQuotationNo").dxTextBox("instance").option("value");
    if (!quoteNo) {
        DevExpress.ui.notify("QuoteNo is missing!", "error", 2000);
        return;
    }

    const eqQuotedFor = $("#EquipmentQuotedFor").dxDropDownBox("instance");
    const description = eqQuotedFor.option("text");
    const qty        = $("#Quantity").dxNumberBox("instance").option("value");
    const unitMethod = $("#QuoteMethod").dxDropDownBox("instance").option("text");
    const rate1      = $("#UnitRate").dxNumberBox("instance").option("value");
    const quotedUOM  = $("#UOM").dxTextBox("instance").option("value");

    let grid = $("#B2BdataGrid").dxDataGrid("instance");
    let data = grid.option("dataSource") || [];
    if (!Array.isArray(data)) data = data.items ? data.items : [];

    try {
        // ✅ Step 1: Call POST API to add/update child row
        const apiResponse = await $.ajax({
            url: "/api/AddNewQuotation1/AddQuoteChild",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                QuoteNo: quoteNo,
                PropertyAddlDescription: description,
                QuotedQuantity: qty,
                QuoteMethod: unitMethod,
                UnitRateMethod: rate1,
                QuotedUOM: quotedUOM
            })
        });

        if (apiResponse && apiResponse.success) {
            const lineOrderNo = apiResponse.rowData.LineOrderNo;

            // ✅ Step 2: Fetch extra details from second API
            const detailResponse = await $.ajax({
                url: `/api/AddNewQuotation1/GetQuoteChildDetails?quoteNo=${quoteNo}&lineOrderNo=${lineOrderNo}`,
                method: "GET"
            });

            // ✅ Step 3: Build new row combining both responses
            const newRow = {
                LineOrderNo: lineOrderNo,
                Description: description || "",
                Qty: qty || 0,
                UnitMethod: unitMethod || "",
                Rate1: rate1 || 0,
                UOM: quotedUOM || "",
                DetailedDescription: detailResponse?.DetailedDescription || "",
                MobRate: detailResponse?.MobRate || 0,
                DemobRate: detailResponse?.DemobRate || 0
            };

            // Replace if updated, else push
            const existingIndex = data.findIndex(x => x.LineOrderNo === newRow.LineOrderNo);
            if (existingIndex > -1) {
                data[existingIndex] = newRow;
            } else {
                data.push(newRow);
            }

            grid.option("dataSource", data);
            DevExpress.ui.notify(apiResponse.message, "success", 2000);
        } else {
            DevExpress.ui.notify("Failed to add/update child row.", "error", 3000);
        }
    } catch (err) {
        console.error(err);
        DevExpress.ui.notify("Error: " + (err.responseText || err.message), "error", 3000);
    }
}









