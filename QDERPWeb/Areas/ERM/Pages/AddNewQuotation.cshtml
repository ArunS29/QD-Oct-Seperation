	function validateContactNo(e) {
    const regex = /^[0-9]+$/;  
    return regex.test(e.value); // ✅ only digits
}






function disableFirstTabControls() {
    const controlIds = [
        "TrnScope",
        "Jobsite",
        "Project",
        "ddGetTypeOfRequest",
        "ddGetModeOfRequest",
        "ClientContactNo",
        "ClientEmail",
        "ClientRefName",
        "MprNumber",
        "GetProjectDropDown",
        "QuotationDate",
        "txtRevisionNo",
        "txtQuotationNo",
		"ddGetSalesPerson",
		"btnApprove",
		"btnVerify",
		"btnSubmit",
		"btnAttach",
		"btnDelete",
		"btnSave",
       "btnSaveAndClose",
	   "Detlz",
	   "btnFinalAdd",
	   "UnitRate",
	   "Quantity",
	   "UOM",
	   "QuoteMethod",
	   "EquipmentQuotedFor",
	   "Subject",
	   "QuoteSummary",
	   "QuoteIntro",
	   "QuoteThanks",
	   "Addreset",
	   "tnxreset",
	   "SubmittedBy",
	   "SubmittedOn",
	   "BidClosingDate",
	   "ddGetQuoteStatus",
	   "txtAdditions",
	   "QuoteTransport",
	   "txtDeductions",
	   "QuoteDiscount",
	   "ddGetCompany",
	   "ReferenceNo",
	   "ddGetInventoryGroup",
	   "ddPreparedby",
	   "ddVerifiedby",
	   "ddApprovedby",
	   "ddlGoodsGroup4",
	   "ddlGoodsGroup3",
	   "currencyexchangerate",
	   "B2BdataGrid"

	  


    ];

    controlIds.forEach(function (id) {
        const $el = $("#" + id);
        if (!$el.length) {
            console.warn("Element not found:", id);
            return;
        }

        const widget = $el.data("dxComponents"); // gives array of widget names
        if (!widget || !widget.length) {
            console.warn("No DevExtreme widget attached for:", id);
            return;
        }

        const widgetName = widget[0];
        const instance = $el[widgetName]("instance");

        if (!instance) return;

        if (["dxTextBox","dxTextArea", "dxDateBox", "dxNumberBox"].includes(widgetName)) {
            instance.option("readOnly", true);
        } else if (["dxDropDownBox", "dxSelectBox"].includes(widgetName)) {
            instance.option("disabled", true);
        } else if (widgetName === "dxButton") {
            instance.option("disabled", true); // ✅ disable button
        } else if (widgetName === "dxDataGrid") {
            instance.option({
                editing: {
                    allowUpdating: false,
                    allowAdding: false,
                    allowDeleting: false
                },
                selection: { mode: "none" }
            });
        } else {
            console.warn("Unhandled widget type:", widgetName, "for", id);
        }
    });
}





	function validateContactNo(e) {
    if (!e.value) return false; 
    return /^\d{10}$/.test(e.value); // must be exactly 10 digits
}


function onClientSelected(e) {
    var clientCode = e.value;
    if (!clientCode) return;

    $.ajax({
        type: "GET",
        url: `/api/AddNewQuotation1/GetClientDetailz?clientCode=${encodeURIComponent(clientCode)}`,
        contentType: "application/json",
        success: function (response) {
            if (response) {
                // Build ClientRefName from ContactPerson + Title
                let refName = "";
                if (response.contactPerson) {
                    refName += response.contactPerson.trim();
                }
                if (response.contactPersonTitle) {
                    if (refName) refName += ", "; // add comma only if contactPerson exists
                    refName += response.contactPersonTitle.trim();
                }

                // Autofill target textboxes
                $("#ClientRefName").dxTextBox("instance").option("value", refName || "");
                $("#ClientEmail").dxTextBox("instance").option("value", response.contactEmail || "");
                $("#ClientContactNo").dxTextBox("instance").option("value", response.contactMobile1 || "");
                $("#ClientTitle").dxTextBox("instance").option("value", response.contactPersonTitle || "");

                DevExpress.ui.notify("Client details loaded successfully.", "success", 2000);
            } else {
                DevExpress.ui.notify("No client details found.", "warning", 2000);
            }
        },
        error: function (xhr) {
            const msg = xhr.responseJSON?.message || "Failed to fetch client details.";
            DevExpress.ui.notify(msg, "error", 3000);
        }
    });
}







