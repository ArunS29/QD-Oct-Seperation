	function proceedWithApproval() {
    const approveBtn = $("#btnApprove").dxButton("instance");
    approveBtn.option("disabled", true);

    const quoteNo = $('#txtQuotationNo').dxTextBox("instance").option("value");
    if (!quoteNo) {
        DevExpress.ui.notify("Quote No is required!", "error", 2000);
        approveBtn.option("disabled", false);
        return;
    }

    $.ajax({
        type: "POST",
        url: `/api/AddNewQuotation1/ApproveQuotation?QuoteNo=${encodeURIComponent(quoteNo)}`,
        contentType: "application/json",
        success: function (response) {
            if (response && response.Message) {
                if (response.VoucherApprovedBy) {
                    const approvedByBox = $("#ddApprovedby").dxDropDownBox("instance");
                    if (approvedByBox) {
                        approvedByBox.option("value", response.VoucherApprovedBy);
                        approvedByBox.getDataSource().reload();
                        approvedByBox.repaint();
                    }
                }

               // syncWorkflowFromFields();
                DevExpress.ui.notify("Quotation has been Approved.", "success", 3000);

				disableFirstTabControls();

                // hideAllButtonsExcept([
                //     "btnPrint",
                //     "ddButtonLayout",
                //     "btnBack",
                //     "btnAttach"
                // ]);

                // ✅ Disable DataGrid after approval
                const gridInstance = $("#B2BdataGrid").dxDataGrid("instance");
                if (gridInstance) {
                    gridInstance.option({
                        editing: {
                            allowUpdating: false,
                            allowAdding: false,
                            allowDeleting: false
                        },
                        selection: {
                            mode: "none"
                        }
                    });
                }
				  disableAllDropDownsAndSelects();
            } else {
                DevExpress.ui.notify("Update failed: Unable to apply changes!", "error", 2000);
                approveBtn.option("disabled", false);
            }
        },
        error: function (xhr) {
            approveBtn.option("disabled", false);
            const msg = xhr.responseJSON?.Message || "An error occurred.";
            DevExpress.ui.notify(msg, "error", 2000);
        }
    });
}


function hideAllButtonsExcept(exceptions) {
			const allButtonIds = [
				"btnAddNew",
				"btnSave",
				"btnSaveAndClose",
				"btnDelete",
				"btnSubmit",
				"btnVerify",
				"btnApprove",
				"btnCancel",
