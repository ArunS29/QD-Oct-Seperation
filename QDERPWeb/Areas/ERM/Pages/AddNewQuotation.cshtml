function saveField(fieldName, dxId,name) {
    let instance = null;

    try {
        instance = $("#" + dxId).dxTextBox("instance");
    } catch (e) {
        // Not a TextBox, try TextArea next
    }

    if (!instance) {
        try {
            instance = $("#" + dxId).dxTextArea("instance");
        } catch (e) {
            console.error(`Neither dxTextBox nor dxTextArea initialized for: ${dxId}`);
            DevExpress.ui.dialog.alert("Component not initialized: " + dxId, "Error");
            return;
        }
    }
    const value = instance.option("value");

    $.ajax({
        url: "/api/Quotation/SaveReportAttribute",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({
            reportNo: "IMS-QTN-01",
            field: fieldName,
            value: value
        }),
        success: function () {
            DevExpress.ui.notify(`Quotation ${name} has been set as default.`, "success", 2000);
        },
        error: function (xhr) {
            DevExpress.ui.dialog.alert("Failed to save data", "Error");
            console.error("Save error:", xhr.responseText);
        }
    });
}
