		var sCreditDebit = $('#ddlCreditDebit').dxDropDownBox('option', 'value');

		const data = {
			AccountID: formattedAccountId,
			OpeningBalance: sOpeningBalance,
			OpeningBalanceDrCr: sCreditDebit
		};

		const values = JSON.stringify(data);

		$.ajax({
			url: "/api/AccountLedgerMaster/InsertOpeningBalance",
			type: 'POST',
			contentType: 'application/json',  // Set the content type to JSON
			data: values,  // Convert the object to JSON
