    .TabIndex(1)
    .Width("100%")
    .OnKeyDown("onKeyDown")
    .ContentTemplate(new TemplateName("GetClientContentTemplate"))
    .ValidationRules(rules =>
    {
        rules.AddRequired()
            .Message(new JS("formatMessage('Client Name should be entered')"));
    })
    .Buttons(buttons =>
    {
        buttons.Add().Name("dropDown");  
        buttons.Add().Name("editClient").Location(TextEditorButtonLocation.After)
            .Widget(w => w.Button()
                .Type(ButtonType.Default)
                .Icon("edit")
                .Hint("Edit Client")
                .OnClick(@"function() {
                    var dropDownBox = $('#GetProjectDropDown').dxDropDownBox('instance');
                    var selectedValue = dropDownBox.option('value');
                    if (!selectedValue) {
                        DevExpress.ui.notify('Please select a client.', 'warning', 2000);
                        return;
                    }
                    var url = '/' + tenantName + '/IMS/ClientLeadMaster?clientCode=' + encodeURIComponent(selectedValue);
                    openModal(url, 'Client Master');
                }")
            );
        buttons.Add().Name("addClient").Location(TextEditorButtonLocation.After)
            .Widget(w => w.Button()
                .Type(ButtonType.Default)
                .Icon("plus")
                .Hint("Add Client")
                .OnClick("redirecttoClientLeadmaster")
            );
    })
)




                    </div>

