@page
@model QD.ERP.Web.Areas.ERM.Pages.ClientContactListModel
@{
    ViewData["Title"] = "Client Contact List";
}

<style>

    .mainContainer {
        width: 100%;
        color: black;
        border-radius: 6px;
    }


    .form-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 10px;
    }

    .form-field {
        flex: 1;
        margin-top: 20px;
        margin-left: 10px;
    }

    .form-header {
        padding: 10px;
        text-align: center;
        margin-top: 50px;
    }

    .white-bg .dx-icon {
        font-size: 20px; /* Adjust the icon size */
        color: #007bff; /* Change the icon color */
    }

    .dx-field-item-label-text > {
        color: black !important;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }


    .white-bg .dx-texteditor-input {
        background-color: white !important;
    }

    .toolbar-buttons {
        margin: 50px;
        display: flex;
        justify-content: flex-start; /* or center, or space-between */
        gap: 20px; /* space between buttons */
        margin-top: 20px;
        padding: 10px 0;
    }

    .dx-button {
        font-weight: bold;
        font-size: 10px;
    }

    .black-text .dx-button-text {
        color: black !important;
    }

</style>

<div class="title">
    <div class="header-container">
        <div id="ClientContactList" class="no-border-title"></div>
    </div>
</div>
<div class="formContainer">

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("clientCode")
                .Value("")
                .Label("Client Code")
                .Width("100%")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))

        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("clientHidden")
                .Disabled(true)
                .Width("100%")
                .Value("-1")
                .ReadOnly(true)
                .Label(" ")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("txtclientName")
                .Value("")
                .Width("100%")
                .Label("Client Name")
                .LabelMode(EditorLabelMode.Outside)

                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("font") // built-in person icon

                .Type(ButtonType.Normal)
                )


        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("contactPerson")
                .Value("")
                .Label("Contact Person")
                .LabelMode(EditorLabelMode.Outside)
                .Width("100%")
                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("user") // built-in person icon

                .Type(ButtonType.Normal)
                )

        </div>
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("title")
                .Value("")
                .Width("100%")
                .Label("Title")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("card") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("division")
                .Value("")
                .Width("100%")
                .Label("Division / Branch")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("folder") // built-in person icon

                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("location")
                .Value("")
                .Width("100%")
                .Label("Location")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("map") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("mobile1")
                .Value("")
                .Width("100%")
                .Label("Mobile Number (1)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("phone1")
                .Value("")
                .Width("100%")
                .Label("Phone No. (1)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("mobile2")
                .Width("100%")
                .Label("Mobile Number (2)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("phone2")
                .Value("")
                .Width("100%")
                .Label("Phone No. (2)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
