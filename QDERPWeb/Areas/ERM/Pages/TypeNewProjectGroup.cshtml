@page
@model QD.ERP.Web.Areas.ERM.Pages.TypeNewProjectGroupModel
@{
}

<style>
    .dx-datagrid-column-chooser-button {
        display: none !important;
    }

    .dx-fieldset {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 15px;
        padding: 20px;
        background-color: transparent;
        width: 250px;
        height: 10%;
    }


    .dx-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-left: 10px;
    }

    .field-label {
        font-weight: bold;
    }

    .aligned-input {
        width: 100%;
    }
    .input-group {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .dx-textarea {
        width: 100%;
        height: 60px;
    }

    .dx-card {
        width: 1000px;
        background: var(--background-color);
    }

    .limited-footer .btn-container:not(:has(#btnSave,#btnBack)) {
        display: none !important;
    }

    .container {
        display: none !important;
    }

    .dx-button-text{
        color:black;
    }
    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }
    .playIcon {
        display: none;
    }
    .maincontainer{
        width:97%;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="Projectsub" class="no-border-input"></div>
    </div>
</div>
<div class="dx-card" style="margin: auto; padding:15px; width:100%;">
    <!-- Input Fields -->
    <div class="row mb-2">
        <div class="col-md-12">
            @(Html.DevExtreme().TextBox().ID("txtGroup").Label(new JS("formatMessage('Type a New Projects Group & Add to the Existing List:')"))
                .LabelMode(EditorLabelMode.Outside).Width("50%"))
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6" style="display:flex; align-items:end;">
            @(Html.DevExtreme().TextBox().ID("txtGroupArabic").Label(new JS("formatMessage('Projects Group (In Arabic):')"))
                .LabelMode(EditorLabelMode.Outside).Width("100%"))

                <div>
                @(Html.DevExtreme().Button()
                    .ID("convertToArabic3")
                    .Height(30)
                    .Hint("Convert to Arabic")
                    .Icon("fas fa-language") // Ensure Font Awesome class is correct
                    .ElementAttr(new { @class = "input-button" })
                    .OnClick("convertToArabic"))
                    
                </div>
        </div>
    </div>
    <div style="display:flex; align-items:end; gap:20px;" >
            @(Html.DevExtreme().TextBox().ID("txtGroupCode").Label(new JS("formatMessage('Group Code:')"))
                .LabelMode(EditorLabelMode.Outside).Width("27%"))
       
    
            @(Html.DevExtreme().SelectBox()
                .ID("categorySelect")
                .Label(new JS("formatMessage('Category:')"))
                .LabelMode(EditorLabelMode.Outside)
                .ShowDropDownButton(true)
                .Width("29%"))

          <div >  
                @(Html.DevExtreme().Button()
                    .ID("btnAdd")
                    .Text("Add")
                    .Icon("plus")
                    .Type(ButtonType.Success)
                    .Width(300))
        </div>
    </div>

    <!-- DataGrid -->
    <div class="dx-card" style="margin: auto; width:100%; margin-top: 30px; ">
        <!-- DataGrid Only -->
        @(Html.DevExtreme().DataGrid()
            .ID("Projectsubgroup")
            .KeyExpr("ProjectSubUnitCode")
            .Columns(columns =>
            {
                columns.Add().DataField("ProjectSubUnitCode").Caption("Code").AllowEditing(false);
                columns.Add().DataField("Group").Caption("Group");
                columns.Add().DataField("ProjectSubUnitName").Caption("Project Group (In Arabic)");
                columns.Add().DataField("Category").Caption("Category");
            })
            .Height(400)
            .ShowBorders(true)
            .ShowRowLines(true)
            .ColumnAutoWidth(true)
            .ColumnResizingMode(ColumnResizingMode.Widget)
            .ColumnFixing(fix => fix.Enabled(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Standard))
            .Paging(p => p.PageSize(10))
            .Selection(s => s.Mode(SelectionMode.Single))
            )
    </div>

    <!-- Action Buttons -->
    <div class="mt-3 d-flex justify-content-between">
        @(Html.DevExtreme().Button()
            .ID("btnUpdate")
            .Text("Update")
            .Icon("save")
            .Type(ButtonType.Default)
            .Width(200))

        @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text("Back")
            .OnClick("goBack")
            .Icon("arrowleft")
            .Type(ButtonType.Normal)
            .Width(120))
    </div>
</div>
<script>
     $(function () {
    $("#Projectsub").dxTextBox({
    text: formatMessage("Project Group"),
        readOnly: true,
        onContentReady: function (e) {
        $(e.element).addClass("dx-textbox-heading");
        }
        });
    });
        function goBack() {
        window.history.back();
    }

     async function convertToArabic() {
        const textBox1Instance = $("#txtGroup").dxTextBox("instance");
        const textBox2Instance = $("#txtGroupArabic").dxTextBox("instance");
        if (!textBox1Instance || !textBox2Instance) {
            console.error("TextBox instances are not properly initialized.");
            return;
        }
        const englishText = textBox1Instance.option("value");
        if (!englishText || englishText.trim() === "") {
            alert("Please enter text to translate.");
            return;
        }
        const arabicTranslation = await translateToArabic(englishText);
        textBox2Instance.option("value", arabicTranslation);
    }
     async function translateToArabic(text) {
        try {
            const response = await fetch(
                `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|ar`
            );
            const data = await response.json();
            console.log(data);
            return data.responseData.translatedText;
        } catch (error) {
            console.error("Translation failed:", error);
            return "Translation Error";
        }
    }
</script>