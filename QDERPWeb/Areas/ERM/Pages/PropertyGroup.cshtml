@page
@model QD.ERP.Web.Areas.ERM.Pages.PropertyGroupModel
@{
}



@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
<style>
    .signatory-form-container {
        padding: 20px;
    }

    .form-row {
        display: flex;
        gap: 15px;
        align-items: end;
    }

    .dx-datagrid-save-button,
    .dx-datagrid-cancel-button {
        display: none !important;
    }

    /* Also hide the entire right-aligned toolbar space */
    .dx-toolbar-after {
        display: none !important;
    }

    /* Optionally, remove padding/margin if needed */
    .dx-datagrid-headers .dx-toolbar {
        padding-right: 0 !important;
    }

    .form-row .form-row-btn {
        margin: 2px;
        width: 340px;
        padding: 0px;
    }

    .rtl-textbox input {
        text-align: right;
    }

    .form-row input,
    .form-row .dx-textbox,
    .form-row .dx-selectbox {
        flex: 1;
    }

    .dx-fileuploader-input-wrapper .dx-button {
        float: left;
        margin-top: -10px;
    }

    .image-upload-row {
        align-items: center;
        gap: 10px;
    }

    .signature-upload {
        border: 1px solid #ccc;
        background-color: #fff;
    }

    .limited-footer .btn-container:not(:has(#btnUpdate,#btnBack)) {
        display: none !important;
    }


    .grid {
        padding: 20px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: flex-start;
        background-color: var(--background-color);
    }

    .mainContainer {
        margin-top: 1em;
    }

    .playIcon {
        display: none;
    }

</style>
<div class="form-row" style="padding:20px;">
    <div class="col-md-6">
        @(Html.DevExtreme().TextBox()
            .ID("txtPropertyGroup")
            .Label(new JS("formatMessage('Type a New Property Group & Add to the Existing List:')"))
            .LabelMode(EditorLabelMode.Floating)
            .ValidationRules(rules =>
            {
                rules.AddRequired().Message("Property Group is required");
            })
            )

    </div>
</div>

<div class="form-row" style="padding:20px;">
    <div class="col-md-6">
        @(Html.DevExtreme().TextBox()
            .ID("txtProGroupCode")
            .Label(new JS("formatMessage('Property Group Code')"))
            .LabelMode(EditorLabelMode.Floating)
            .ValidationRules(rules =>
            {
                rules.AddRequired().Message("Property Group Code is required");
            })
            )
    </div>
    <div class="col-md-2">
        @(Html.DevExtreme().Button()
            .ID("btnAddSalesPerson")
            .Text(new JS("formatMessage('ADD')"))
            .Icon("plus")
            .OnClick("function() { addSignatoryToGrid(); }")
            .ElementAttr(new { @class = "dx-button-add" })
            )
    </div>
</div>




<div class="dx-field ledgerResult">
    @(Html.DevExtreme().DataGrid()
        .ID("TypeOfRequestGrid")
        .KeyExpr("PropertyGroupId")
        .RemoteOperations(false)
        .DataSource(d => d.WebApi()
        .Controller("PropertyGroup")
        .LoadAction("GetPropertyGroup")
        .LoadMode(DataSourceLoadMode.Raw)
        )
        .Editing(editing => editing
        .Mode(GridEditMode.Batch)
        .AllowUpdating(true)
        .AllowDeleting(true)
        )
        .Toolbar(toolbar =>
        {
            toolbar.Items(items => { }); // hide default toolbar
        })
        .OnRowUpdating("onPropertyGroupUpdating")
        .Columns(columns =>
        {
            columns.Add().DataField("PropertyGroupId").Caption(new JS("formatMessage('ID')")).Width(80).AllowEditing(false);
            columns.Add().DataField("PropertyGroup").Caption(new JS("formatMessage('Property Group')")).Width(200);
            columns.Add().DataField("PropertyGroupCode").Caption(new JS("formatMessage('Code')")).Width(200);
            // Add delete button column
            columns.Add()
            .Type(GridCommandColumnType.Buttons)
            .Buttons(buttons =>
            {
                buttons.Add()
            .Name(GridColumnButtonName.Delete)
            .Icon("trash") // Use a trash icon
            .Hint("Delete Row") // Tooltip
            .OnClick("onDeleteButtonClick");
            });
        })
        .Height("70vh")
        .ColumnAutoWidth(true)
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(f => f.Enabled(true))
        .Paging(p => p.Enabled(true))
        .Scrolling(s => s
        .Mode(GridScrollingMode.Virtual)
        .RowRenderingMode(GridRowRenderingMode.Virtual)
        .PreloadEnabled(true)
        .ScrollByContent(true)
        )
        .ShowBorders(true)
        .ShowRowLines(true)
        .Width("100%")
        )


</div>


<div class="limited-footer">
    @await Html.PartialAsync("InventoryModuleFooter")
</div>
<script>

    $(document).ready(function () {

            $(".limited-footer .btn-container").each(function () {

              if (!$(this).find("#btnUpdate,#btnBack").length) {

                  $(this).remove();

              }

          });

      });

    $(document).on("click", "#btnBack", function () {
        window.history.back();
    });

      $(function () {
            $("#DatabaseSignatories").dxTextBox({
                text: formatMessage("Database "),
                readOnly: true,


            });
        });

    $(function () {
            $("#QuotationTypeofRequest").dxTextBox({
                text: formatMessage("Quotation Type of Request"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    async function convertToArabic(sourceId, targetId) {
        const sourceBox = $("#" + sourceId).dxTextBox("instance");
        const targetBox = $("#" + targetId).dxTextBox("instance");

        if (!sourceBox || !targetBox) {
            console.error("TextBox not initialized.");
            return;
        }

        const sourceText = sourceBox.option("value");

        if (!sourceText || sourceText.trim() === "") {
            alert("Please enter a value to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(sourceText);
            targetBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    //img
    let businessCard1Base64 = "";
    function addSignatoryToGrid() {


        const data = {
            PropertyGroup: $("#txtPropertyGroup").dxTextBox("instance").option("value"),
            PropertyGroupCode: $("#txtProGroupCode").dxTextBox("instance").option("value")


        };

        $.ajax({
               url: '/api/PropertyGroup/SaveOrUpdatePropertyGroup',
            //url: '/api/QuotationTypeOfRequest/SaveOrUpdateSignatory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Property Group saved successfully!", "success", 2000);
                $("#TypeOfRequestGrid").dxDataGrid("instance").refresh();
            },
              error: function (xhr, status, error) {
                    let errorMessage = (xhr.responseJSON && xhr.responseJSON.Message)
                        ? xhr.responseJSON.Message
                        : "An error occurred.";
                    DevExpress.ui.notify(errorMessage, "error", 2000);
                }
        });
    }


    $("#btnUpdate").on("click", function () {
        const grid = $("#TypeOfRequestGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


    function onPropertyGroupUpdating(e) {
        const data = {
            PropertyGroupId: e.oldData.PropertyGroupId,
            PropertyGroup: e.newData.PropertyGroup ?? e.oldData.PropertyGroup,
            PropertyGroupCode: e.newData.PropertyGroupCode ?? e.oldData.PropertyGroupCode
        };

        e.cancel = true; // prevents grid from doing its own update

        return $.ajax({
            url: '/api/PropertyGroup/SaveOrUpdatePropertyGroup',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#TypeOfRequestGrid").dxDataGrid("instance").refresh();
                // Refresh parent dropdown
                   if (window.parent && typeof window.parent.propergroupgridupdate === "function") {
                    window.parent.propergroupgridupdate();
                }
            },
               error: function (xhr, status, error) {
                    let errorMessage = (xhr.responseJSON && xhr.responseJSON.Message)
                        ? xhr.responseJSON.Message
                        : "An error occurred.";
                    DevExpress.ui.notify(errorMessage, "error", 2000);
                }
        });
    }

       function onDeleteButtonClick(e) {
        e.event.preventDefault(); // prevent default delete behavior

        var grid = $("#TypeOfRequestGrid").dxDataGrid("instance");
        var key = e.row.data.PropertyGroupId; // row's primary key

        DevExpress.ui.dialog.confirm("Are you sure you want to delete this Property Group?", "Confirm Deletion")
            .done(function (dialogResult) {
                if (dialogResult) { // only proceed if user clicked "Yes"
                    $.ajax({
                        url: '/api/PropertyGroup/Delete?key=' + key,
                        type: 'DELETE',
                        success: function () {
                            // refresh the grid
                            grid.refresh();
                            DevExpress.ui.notify("Deleted successfully", "success", 2000);

                            // refresh parent dropdown if it exists
                            if (window.parent && typeof window.parent.refreshTypeOfRequestDropDown === "function") {
                                setTimeout(() => {
                                    window.parent.refreshTypeOfRequestDropDown('PropertyGroup');
                                }, 300);
                            }
                        },
                        error: function (xhr) {
                            let msg = xhr.responseJSON?.message || "Delete failed";
                            DevExpress.ui.notify(msg, "error", 3000);
                        }
                    });
                }
            });
        }





</script>