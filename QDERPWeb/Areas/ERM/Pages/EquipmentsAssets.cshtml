}

@{
    ViewData["Title"] = "Suppliers";

}
<link rel="stylesheet" href="~/css/animationCard.css" />
<style>
    .header-box {
        background-color: #3c8dbc;
        color: white;
        padding: 20px;
        font-size: 20px;
        font-weight: bold;
        /* display: flex; */
        align-items: center;
        border-radius: 4px 4px 0 0;
        width: 300px;
        height: 200px;
        margin-left: 15px;
    }

        .header-box i {
            margin-right: 10px;
            font-size: 24px;
        }

        .header-box h5 {
            margin-top: 40px;
        }



    .toolbar-buttons {
        /* position: fixed; */
        bottom: 20px; /* Distance from bottom */
        left: 20px; /* Distance from left */
        display: flex;
        gap: 10px; /* Space between buttons */
        /* z-index: 9999; /* Make sure it's on top */ */
        /* background-color: white; /* Optional: background */ */ padding: 10px; /* Optional: inner spacing */
        border-radius: 6px;
        margin-top: 10px;
        /* box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); */
    }

    .mainContainer {
        width: 96%;
        overflow-x: hidden;
    }
</style>
<div class="title">
    <input id="formId" value="frm201LedgerView" type="hidden" />

    <div class="card blue shine compact">
        <h2 class="title-slide">Equipment Assets</h2>
        <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.3); margin: 6px 0;">
        <h6 class="fade-in">QuickDice ERP Solutions</h6>

    </div>

    <div id="mainCard" class="card today-bg">
        <div class="tabs">
            <div class="tab-text active" onclick="switchTab(0)">Today</div>
            <div class="tab-text" onclick="switchTab(1)">Week</div>
            <div class="tab-text" onclick="switchTab(2)">Month</div>
        </div>

        <div class="tab-content active">
            <h4>&#128276; Pending Verifications</h4>
            <div class="count" id="count0">0</div>
            @* <div class="trend">🔺 12% more than yesterday</div> *@
            @* <div class="message">You're getting things moving!</div> *@
        </div>

        <div class="tab-content">
            <h4>&#9989; Vouchers Verified</h4>
            <div class="count" id="count1">0</div>
            @* <div class="trend">🔼 25% higher than last week</div> *@
            @* <div class="message">Awesome pace — keep it up!</div> *@
        </div>

        <div class="tab-content">
            <h4>&#128229; New Vouchers</h4>
            <div class="count" id="count2">0</div>
            @* <div class="trend">🔽 10% drop this month</div> *@
            @* <div class="message">Fewer vouchers — time to catch up?</div> *@
        </div>
    </div>
    <div class="card purple sparkle">
        <p>&#10024;</p>
        <h4>No of Items</h4>
        <h1 id="turnover">0</h1>
        <h3>for this period</h3>
    </div>
</div>
