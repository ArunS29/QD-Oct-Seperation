	}
		$(function () {
					$("#EquipmentEnquiry").dxTextBox({
						text: formatMessage("Equipment Enquiry"),
				readOnly: true,
				onContentReady: function (e) {
					$(e.element).addClass("dx-textbox-heading");
				}
			});
		});

	function onDeleteRequest(Mprno) {
		if (!Mprno) {
			DevExpress.ui.notify('MPRNo is missing.', 'error', 3000);
			return;
		}

		$.ajax({
			url: `/api/MaterialRequestEnquiriesDetails1/DeletePurchaseRequest?Mprno=${Mprno}`,
			method: 'POST',
			success: function (response) {
				if (response.success) {
					DevExpress.ui.notify(response.message, 'success', 2000);
					$("#dataGrid").dxDataGrid("instance").refresh();
				} else {
					DevExpress.ui.notify(response.message, 'error', 3000);
				}
			},
			error: function () {
				DevExpress.ui.notify('An error occurred while attempting to delete the request.', 'error', 3000);
			}
		});
	}

	function onCloneRequest(originalData) {
    if (!originalData) {
        console.error("No data to clone.");
        return;
    }

    // Create a deep copy of the original data
    const clonedData = JSON.parse(JSON.stringify(originalData));

    // Reset fields that should be unique or re-initialized
    clonedData.Mprno = null; // Assuming Mprno is a unique identifier
    clonedData.MprrevisionNo = false;
    clonedData.Mprdate = new Date().toISOString().split('T')[0]; // Set to today's date
    clonedData.IsSubmitted = false;
    clonedData.IsVerified = false;
    clonedData.IsApproved = false;
    clonedData.IsCancelled = false;
    clonedData.AddedOn = new Date().toISOString().split('T')[0];
    clonedData.ModifiedOn = null;
    clonedData.SubmittedOn = null;
    clonedData.VerifiedOn = null;
    clonedData.ApprovedOn = null;
    clonedData.CancelledOn = null;
    clonedData.Remarks = "Cloned from MPR";

    // Insert the cloned data into the DataGrid
    const dataGrid = $("#dataGrid").dxDataGrid("instance");
    dataGrid.getDataSource().store().insert(clonedData).then(() => {
        dataGrid.refresh();
    }).catch((error) => {
        console.error("Error inserting cloned data:", error);
    });
}


