<script>

	function onToolbarPreparing(e) {
		// Remove/hide the column chooser button on initial load
		e.toolbarOptions.items = e.toolbarOptions.items.filter(function (item) {
			return item.name !== "columnChooserButton";
		});
	}
	// // Assuming tenantName is already defined globally
	let CreditNoteNo = null;
		let IsEdit = false;

		// Assuming tenantName is already defined globally
		function viewInvoice() {
			if (!CreditNoteNo) {
					alert("CreditNoteNo is not set.");
				return;
			}

			IsEdit = true;

			const params = new URLSearchParams({
				CreditNoteNo: CreditNoteNo,
			    IsEditflag: IsEdit,
				modal: true // If you want to explicitly include modal=true
			});

			const url = `/${tenantName}/VAT/CreditNoteEditForm?${params.toString()}`;
		    window.location.href = url;
		//	openModal(url, title);
		}
	$(function () {
			var now = new Date();
			var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
			var tillmonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
			$("#frmdateBox").dxDateBox("instance").option("value", firstDay);
			$("#todateBox").dxDateBox("instance").option("value", tillmonth);
			ddBtnShowRecords_click('range');
	});
	function ddBtnShowRecords_click(duration) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var frmDate = new Date(frmDateBox.option("value"));
		var toDate = new Date(toDateBox.option("value"));
		var currentDate = new Date();

		switch (duration) {
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
		}

		frmDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		toDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		FromDate = frmDate;
		ToDate = toDate;

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		$.ajax({
			url: '/api/MaterialRequestEnquiriesDetails1/GetVatCreditNoteDetails',
			type: 'GET',
			data: {
				frmDate: frmDate,
				toDate: toDate
			},
			success: function (data) {
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
				var dataGrid = $("#dataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.option("dataSource");
				if (dataSource && dataSource.length > 0) {
					var lastRow = dataSource[dataSource.length - 1];
					VoucherAmountFormatted = lastRow.VoucherAmountFormatted;
					var firstRow = dataSource[0];
					firstrowVoucherAmountFormatted = firstRow.VoucherAmountFormatted;
				}
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}
	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}

	function onContextMenuPreparing(e) {
		if (e.target === "content" && e.row) {
			e.items = [
				{
					text: "Edit Request / Enquiry",
					icon: "edit",
					onItemClick: function () {
						const rowData = e.row.data;
						if (!rowData) {
							console.error("Row data is unavailable.");
							return;
						}

						const { Mprno, RequestEnquiry } = rowData;
						const tenantName = window.tenantName || "defaultTenant";
						let url = "";
						let title = "";

						switch (RequestEnquiry) {
							case "Client Request":
								url = `/${tenantName}/ERM/AddNewClientRequest?Mprno=${Mprno}`;
								title = "Edit Client Request";
								break;
							case "Project Request":
								url = `/${tenantName}/ERM/MRAddNewProjectRequest?Mprno=${Mprno}`;
								title = "Edit Project Request";
								break;
							case "Store Request":
								url = `/${tenantName}/ERM/MRAddNewStoreRequest?Mprno=${Mprno}`;
								title = "Edit Store Request";
								break;
							default:
								console.warn("Unknown RequestEnquiry type:", RequestEnquiry);
								return;
						}

						//openModal(url, title);
						window.location.href=url;
					}
				},

				{
					text: "Clone Request / Enquiry",
					icon: "copy",
					onItemClick: function () {
						onCloneRequest(e.row.data);
					}
				},
				{
					text: "Revise the Request / Enquiry",
