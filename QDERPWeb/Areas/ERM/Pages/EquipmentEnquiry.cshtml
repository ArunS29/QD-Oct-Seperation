	}

	.context-menu {
		position: absolute;
		background: #fff;
		border-radius: 8px;
		box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
		width: 300px;
		max-height: 600px;
		overflow-y: auto;
		display: none;
		flex-direction: column;
		padding: 5px 0;
		z-index: 1000;
	}

	.context-menu-item {
		align-items: center;
		padding: 14px 20px;
		font-size: 15px;
		cursor: pointer;
		transition: background 0.2s ease-in-out;
		color: #333;
