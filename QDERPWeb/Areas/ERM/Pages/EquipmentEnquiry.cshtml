							if (dialogResult) {
								var Mprno=e.row.data.Mprno;
								console.log("number", Mprno);
								onDeleteRequest(Mprno);
							}
						});
					}
				},
				{
					text: "Unlock the Request / Enquiry",
					icon: "unlock",
