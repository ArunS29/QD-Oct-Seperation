<script>

	function onToolbarPreparing(e) {
		// Remove/hide the column chooser button on initial load
		e.toolbarOptions.items = e.toolbarOptions.items.filter(function (item) {
			return item.name !== "columnChooserButton";
		});
	}
	// // Assuming tenantName is already defined globally
	let CreditNoteNo = null;
		let IsEdit = false;

		// Assuming tenantName is already defined globally
		function viewInvoice() {
			if (!CreditNoteNo) {
					alert("CreditNoteNo is not set.");
				return;
			}

			IsEdit = true;

			const params = new URLSearchParams({
				CreditNoteNo: CreditNoteNo,
			    IsEditflag: IsEdit,
				modal: true // If you want to explicitly include modal=true
			});

			const url = `/${tenantName}/VAT/CreditNoteEditForm?${params.toString()}`;
		    window.location.href = url;
		//	openModal(url, title);
		}
	$(function () {
			var now = new Date();
			var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
			var tillmonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
			$("#frmdateBox").dxDateBox("instance").option("value", firstDay);
			$("#todateBox").dxDateBox("instance").option("value", tillmonth);
			ddBtnShowRecords_click('range');
	});
	function ddBtnShowRecords_click(duration) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var frmDate = new Date(frmDateBox.option("value"));
		var toDate = new Date(toDateBox.option("value"));
		var currentDate = new Date();

		switch (duration) {
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
		}

		frmDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		toDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		FromDate = frmDate;
		ToDate = toDate;

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		$.ajax({
			url: '/api/MaterialRequestEnquiriesDetails1/GetVatCreditNoteDetails',
			type: 'GET',
			data: {
				frmDate: frmDate,
				toDate: toDate
			},
			success: function (data) {
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
				var dataGrid = $("#dataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.option("dataSource");
				if (dataSource && dataSource.length > 0) {
					var lastRow = dataSource[dataSource.length - 1];
					VoucherAmountFormatted = lastRow.VoucherAmountFormatted;
					var firstRow = dataSource[0];
					firstrowVoucherAmountFormatted = firstRow.VoucherAmountFormatted;
				}
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}
	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}

	function onContextMenuPreparing(e) {
		if (e.target === "content" && e.row) {
			e.items = [
				{
					text: "Edit Request / Enquiry",
					icon: "edit",
					onItemClick: function () {
						const rowData = e.row.data;
						if (!rowData) {
							console.error("Row data is unavailable.");
							return;
						}

						const { Mprno, RequestEnquiry } = rowData;
						const tenantName = window.tenantName || "defaultTenant";
						let url = "";
						let title = "";

						switch (RequestEnquiry) {
							case "Client Request":
								url = `/${tenantName}/ERM/AddNewClientRequest?Mprno=${Mprno}`;
								title = "Edit Client Request";
								break;
							case "Project Request":
								url = `/${tenantName}/ERM/MRAddNewProjectRequest?Mprno=${Mprno}`;
								title = "Edit Project Request";
								break;
							case "Store Request":
								url = `/${tenantName}/ERM/MRAddNewStoreRequest?Mprno=${Mprno}`;
								title = "Edit Store Request";
								break;
							default:
								console.warn("Unknown RequestEnquiry type:", RequestEnquiry);
								return;
						}

						//openModal(url, title);
						window.location.href=url;
					}
				},

				{
					text: "Clone Request / Enquiry",
					icon: "copy",
					onItemClick: function () {
						onCloneRequest(e.row.data);
					}
				},
				{
					text: "Revise the Request / Enquiry",
					icon: "repeat",
					onItemClick: function () {
						onReviseRequest(e.row.data);
					}
				},
				{
					text: "Delete Request / Enquiry",
					icon: "trash",
					onItemClick: function () {
						DevExpress.ui.dialog.confirm(
							"You are about to delete the Request / Enquiry.\nYou cannot revert the changes.\nAre you sure?",
							"Confirm Delete"
						).done(function (dialogResult) {
							if (dialogResult) {
								var Mprno=e.row.data.Mprno;
								console.log("number", Mprno);
								onDeleteRequest(Mprno);
							}
						});
					}
				},
				{
					text: "Unlock the Request / Enquiry",
					icon: "unlock",
					onItemClick: function () {
						onUnlockRequest(e.row.data);
					}
				},
				{
					text: "Create a RFQ",
					icon: "plus",
					onItemClick: function () {
						onCreateRFQ(e.row.data);
					}
				},
				{
					text: "Create a Quotation",
					icon: "plus",
					onItemClick: function () {
						onCreateQuotation(e.row.data);
					}
				},
				{
					text: "Create a Purchase Order",
					icon: "cart",
					onItemClick: function () {
						onCreatePO(e.row.data);
					}
				},
				{
					text: "Create Material Receipt",
					icon: "box",
					onItemClick: function () {
						onCreateMaterialReceipt(e.row.data);
					}
				},
				{
					text: "Create Material Issue Note",
					icon: "export",
					onItemClick: function () {
						onCreateMaterialIssueNote(e.row.data);
					}
				},
				{
					text: "View Revision History",
					icon: "clock",
					onItemClick: function () {
						let Mprno = e.row.data.Mprno;
						let tenantName = window.tenantName || "defaultTenant"; // replace with dynamic tenant logic if needed
						let url = `/${tenantName}/ERM/MPRRevisionHistory?Mprno=${Mprno}`;
						let title = `MPRRevisionHistory - ${Mprno}`;
						openModal(url, title);
						
					}
				}
			];
		}
	}
		$(function () {
					$("#EquipmentEnquiry").dxTextBox({
						text: formatMessage("Equipment Enquiry"),
				readOnly: true,
				onContentReady: function (e) {
					$(e.element).addClass("dx-textbox-heading");
				}
			});
		});

	function onDeleteRequest(Mprno) {
		if (!Mprno) {
			DevExpress.ui.notify('MPRNo is missing.', 'error', 3000);
			return;
		}

		$.ajax({
			url: `/api/MaterialRequestEnquiriesDetails1/DeletePurchaseRequest?Mprno=${Mprno}`,
			method: 'POST',
			success: function (response) {
				if (response.success) {
					DevExpress.ui.notify(response.message, 'success', 2000);
					$("#dataGrid").dxDataGrid("instance").refresh();
				} else {
					DevExpress.ui.notify(response.message, 'error', 3000);
				}
			},
			error: function () {
				DevExpress.ui.notify('An error occurred while attempting to delete the request.', 'error', 3000);
			}
		});
	}

	function onCloneRequest(originalData) {
    if (!originalData) {
        console.error("No data to clone.");
        return;
    }

    // Create a deep copy of the original data
    const clonedData = JSON.parse(JSON.stringify(originalData));

    // Reset fields that should be unique or re-initialized
    clonedData.Mprno = null; // Assuming Mprno is a unique identifier
    clonedData.MprrevisionNo = false;
    clonedData.Mprdate = new Date().toISOString().split('T')[0]; // Set to today's date
    clonedData.IsSubmitted = false;
    clonedData.IsVerified = false;
    clonedData.IsApproved = false;
    clonedData.IsCancelled = false;
    clonedData.AddedOn = new Date().toISOString().split('T')[0];
    clonedData.ModifiedOn = null;
    clonedData.SubmittedOn = null;
    clonedData.VerifiedOn = null;
    clonedData.ApprovedOn = null;
    clonedData.CancelledOn = null;
    clonedData.Remarks = "Cloned from MPR";

    // Insert the cloned data into the DataGrid
    const dataGrid = $("#dataGrid").dxDataGrid("instance");
    dataGrid.getDataSource().store().insert(clonedData).then(() => {
        dataGrid.refresh();
    }).catch((error) => {
        console.error("Error inserting cloned data:", error);
    });
}


</script>	