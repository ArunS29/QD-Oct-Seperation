@page
@model QD.ERP.Web.Areas.ERM.Pages.QuotedCostItemModel
@{
}




<style>
 
    .dx-datagrid-column-chooser-button {

        display: none !important;

    }
 
    .dx-fieldset {

        display: grid;

        grid-template-columns: 1fr 1fr 1fr;

        gap: 15px;

        padding: 20px;

        background-color: transparent;

        width: 250px;

        height: 10%;

    }
 
 
    .dx-field {

        display: flex;

        flex-direction: column;

        gap: 5px;

        margin-left: 10px;

    }
 
    .field-label {

        font-weight: bold;

    }
 
    .aligned-input {

        width: 100%;

    }
 
    .input-group {

        display: flex;

        align-items: center;

        gap: 5px;

    }
 
    .dx-textarea {

        width: 100%;

        height: 60px;

    }
 
    .dx-card {

        width: 1000px;

        background: var(--background-color);

    }
 
    .limited-footer .btn-container:not(:has(#btnUpdate,#btnBack)) {

        display: none !important;

    }
 
    .container {

        display: none !important;

    }
 
    .dx-button-text {

        color: black;

    }
 
    .input-button {

        color: black;

    }
 
    .dx-button-mode-contained.dx-button-success .dx-icon {

        color: black;

    }
 
    .frame {

        display: none !important;

    }
 
    .footerContainer {

        display: none !important;

    }
 
    .playIcon {

        display: none;

    }
 
    .dx-label-cell {

        text-align: right;

        font-weight: bold;

        padding-right: 8px;

        white-space: nowrap;

    }
 
    .dx-field-table {

        width: 100%;

        border-collapse: separate;

        border-spacing: 10px 6px;

    }
 
        .dx-field-table td {

            vertical-align: middle;

        }
 
    .form-header {

        color: white;

        padding: 10px;

        font-size: 18px;

        font-weight: bold;

        margin-bottom: 10px;

    }
</style>
 
<div class="title">
<div class="header-container">
<div id="AddQuotationCostItem" class="no-border-input"></div>
</div>
</div>
 
<table class="dx-field-table" style="padding:20px;">
<tr>
<td>

            @(Html.DevExtreme().TextBox()

                .ID("QuotationNo")

                .LabelMode(EditorLabelMode.Outside)
                .Disabled(true)
                .Label(new JS("formatMessage('Quotation No')")))
</td>
 
        <td>

            @(Html.DevExtreme().TextBox()

                .ID("StockCode")
                .Disabled(true)
                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Stock Item Code:')")))
</td>
 
        <td>

            @(Html.DevExtreme().TextBox()

                .ID("StockDescription")
                .Disabled(true)
                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Stock Description:')")))
</td>
<td >

            @(Html.DevExtreme().NumberBox()

                .ID("Quantity")
                .Disabled(true)
                .ShowSpinButtons(true)

                .Width("100%")

                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Quantity')")))
</td>
<td>

            @(Html.DevExtreme().NumberBox()

                .ID("CostPrice")
                .Disabled(true)
                .Width("100%")

                .Format("#,##0.00")

                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Cost Price')")))
</td>
</tr>
</table>
 
<table class="dx-field-table" style="padding:20px;"  >
<tr>
<td colspan="3">
            @(Html.DevExtreme().DropDownBox()
                .Label(new JS("formatMessage('Cost Item:')"))
                .DataSource(d => d.WebApi()
                .Controller("Quotation1")
                .LoadAction("GetCostItem")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CostItemCode")
                )
                .LabelMode(EditorLabelMode.Outside)
                .ID("ddCostItem")
                .Width(900)
                @*  .ShowClearButton(true)
            .AcceptCustomValue(true) *@
                .OpenOnFieldClick(false)//
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("CostItemCode")
                .DisplayExpr("CostItem")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .TabIndex(1)
                .Width("100%")
                .OnKeyDown("onKeyDown")
                //.OnValueChanged("dropDownBoxValueChanged")
                .ContentTemplate(new TemplateName("GetTaxContentTemplate"))
                .ValidationRules(rules =>
                {
                    rules.AddRequired().Message("Cost Item is required");
                })
                )
           
</td>
 
        <td>

            @(Html.DevExtreme().NumberBox()

                .ID("Percentage")

                .Min(0).Max(100).Format("#0.00")

                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Percentage (%)')")))
</td>
 
        <td>

            @(Html.DevExtreme().NumberBox()

                .ID("ItemQty")

                .Min(1)

                .ShowSpinButtons(true)

                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Quantity')")))
</td>
<td>

            @(Html.DevExtreme().NumberBox()

                .ID("CostAmount")

                .Format("#,##0.00")

                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Cost Amount:')")))
</td>
 
        <td style="display:flex; align-items:end;">

            @(Html.DevExtreme().NumberBox()

                .ID("TotalCost")

                .Format("#,##0.00")
                .Disabled(true)
                .Width("70%")

                .LabelMode(EditorLabelMode.Outside)

                .Label(new JS("formatMessage('Total Cost:')")))

            @(Html.DevExtreme().Button()

                .ID("btnAdd")

                .Text("Add")

                .Type(ButtonType.Success)

                .Icon("plus")

                .OnClick("function(){addProjectToGrid();}")
        )
</td>
</tr>
</table>
 
<hr />

    <!-- Data Grid -->
<div class="dx-field ledgerResult">
    @(Html.DevExtreme().DataGrid()
        .ID("SignatoryGrid")
        .KeyExpr("CostItemCode")
        .RemoteOperations(false)
        .DataSource(d => d.WebApi()
        .Controller("Quotation1")
        .LoadAction("GetCostItemGrid")
        .LoadMode(DataSourceLoadMode.Raw)
        )
        .Editing(editing => editing
        .Mode(GridEditMode.Batch)
        .AllowUpdating(true)
        .AllowDeleting(true)
        .UseIcons(true)
        )
        .Toolbar(toolbar =>
        {
            toolbar.Items(items =>
            {
                items.Add()
            .Name("saveButton")
            .Location(ToolbarItemLocation.After)
            .Visible(false);

                items.Add()
            .Name("revertButton")
            .Location(ToolbarItemLocation.After)
            .Visible(false);
            });
        })


       .OnRowUpdating("onProjectUpdating")                       // Handles saving
        .Columns(columns =>
        {
            columns.Add().DataField("CostItemCode").Caption("Cost Item Code").AllowEditing(false);

            columns.Add().DataField("CostItemDescription").Caption("Cost Item Description");

            columns.Add().DataField("CostPercentage").Caption("Cost Percentage");

            columns.Add().DataField("CostItemQty").Caption("Cost Item Qty");

            columns.Add().DataField("CostItemPrice").Caption("Cost Item Price");
            columns.Add().DataField("CostItemSubTotal").Caption("Total Cost");
            columns.Add().DataField("QuoteCostSlNo").Caption("Total");

         
            // Add delete button column
            columns.Add()
            .Type(GridCommandColumnType.Buttons)
            .Buttons(buttons =>
            {
                buttons.Add()
            .Text("Delete")
            .Icon("trash")
            .Hint("Delete Row")
            .OnClick("onDeleteButtonClicks"); // Custom handler
            });


        })
        .Height(500)
        .ColumnAutoWidth(true)
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(f => f.Enabled(true))
        .Paging(p => p.Enabled(true))
        .Scrolling(s => s
        .Mode(GridScrollingMode.Virtual)
        .RowRenderingMode(GridRowRenderingMode.Virtual)
        .PreloadEnabled(true)
        .ScrollByContent(true)
        )
        .ShowBorders(true)
        .ShowRowLines(true)
        .Width("100%")
        )




</div>
<!-- Footer Buttons -->
<div class="limited-footer">
    @await Html.PartialAsync("InventoryModuleFooter")
</div>
@using (Html.DevExtreme().NamedTemplate("GetTaxContentTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                        .ID("GetTax-datagrid")
                        .DataSource(d => d.WebApi()
                            .Controller("Quotation1")
                            .LoadAction("GetCostItem")
                        .LoadMode(DataSourceLoadMode.Raw)
                            .Key("CostItemCode")
                        )
                        .WordWrapEnabled(true)
                        .ShowBorders(true)
                        @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
                        .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
                        .OnSelectionChanged("dataGridSelectionChanged5")
                        .OnInitialized("dataGridInitialized5")
                        .HeaderFilter(p => p.Visible(true))
                        .ShowBorders(true)
                        .HoverStateEnabled(true)
                        .Paging(p => p.PageSize(15))
                        .FilterRow(f => f.Visible(false))//
                        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                        .Height(345)
                        .Selection(s => s.Mode(SelectionMode.Single))
                        .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                        .Columns(columns =>
                        {
                                columns.Add().Caption(new JS("formatMessage('Code')")).DataField("CostItemCode");
                                columns.Add().Caption(new JS("formatMessage('Description')")).DataField("CostItem");



                        })
                        )
}
<script>
    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function dataGridSelectionChanged5(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#ddCostItem").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }
    function dataGridInitialized5(e) {
        dataGrid = e.component;
    }
    function addCostItem() {

        DevExpress.ui.notify("Add clicked", "info", 1000);

    }
 
    function formatMessage(labelText) {

        return labelText;

    }
 
        $(function () {

        $("#AddQuotationCostItem").dxTextBox({

            text: formatMessage("Additional Cost On Items"),

                readOnly: true,

                onContentReady: function (e) {

                    $(e.element).addClass("dx-textbox-heading");

                }

            });

        });

            function Goback() {

        window.parent.closeModal(); // This closes the current window/tab

         $(document).ready(function () {

            $(".limited-footer .btn-container").each(function () {

                if (!$(this).find("#btnUpdate,#btnBack").length) {

                    $(this).remove();

                }

            });

        });

        $(document).on("click", "#btnBack", function () {
            window.parent.closeModal();
        });

        }
            function addProjectToGrid() {
            // Validate fields using the Validator components
                const nameValidationResult = $("#ddCostItem").dxValidator("instance").validate();


            if (!nameValidationResult.isValid) {
                DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
                return;
            }

            const data = {

                            CostItemCode: $("#ddCostItem").dxDropDownBox("instance").option("value"),
                            CostPercentage: $("#Percentage").dxNumberBox("instance").option("value"),
                            CostItemQty: $("#ItemQty").dxNumberBox("instance").option("value"),
                            CostItemPrice: $("#CostAmount").dxNumberBox("instance").option("value"),
                        // CostAllocationUnitId: $("#TotalCost").dxNumberBox("instance").option("value"),
                    

            };

            $.ajax({
                 url: '/api/Quotation1/SaveOrUpdateQuotedCostitem',
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function () {
                    DevExpress.ui.notify("Cost Item saved successfully!", "success", 2000);
                    $("#SignatoryGrid").dxDataGrid("instance").refresh();
                },
                error: function () {
                    DevExpress.ui.notify("Failed to save Projectgroup.", "error", 2000);
                }
            });
        }
             $("#btnUpdate").on("click", function () {
            const grid = $("#SignatoryGrid").dxDataGrid("instance");
            grid.saveEditData(); // 🔥 only triggers on manual click
        });
            function onProjectUpdating(e) {

            const data = {
                        QuoteCostSlNo: e.oldData.QuoteCostSlNo,
                            CostItemCode: e.newData.CostItemCode ?? e.oldData.CostItemCode,
                            CostPercentage: e.newData.CostPercentage ?? e.oldData.CostPercentage,
                            CostItemQty: e.newData.CostItemQty ?? e.oldData.CostItemQty,
                            CostItemPrice: e.newData.CostItemPrice ?? e.oldData.CostItemPrice
               };

            e.cancel = true;

            return $.ajax({
                        url: '/api/Quotation1/SaveOrUpdateQuotedCostitem',
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function () {
                    DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                    $("#SignatoryGrid").dxDataGrid("instance").refresh();
                },
                error: function () {
                    DevExpress.ui.notify("Failed to save.", "error", 1500);
                }
            });
        }
             function onDeleteButtonClicks(e) {
           
                
            e.event.preventDefault(); // prevent default delete

            var grid = $("#SignatoryGrid").dxDataGrid("instance");
                var key = e.row.data.QuoteCostSlNo; // get the ID of the row


            if (confirm("Are you sure you want to delete this row?")) {
                $.ajax({
                      url: '/api/Quotation1/Deletes?key=' + key,
                    type: 'DELETE',
                    success: function () {
                        // Refresh the grid after delete
                        grid.refresh();
                        DevExpress.ui.notify("Deleted successfully", "success", 2000);
                    },
                    error: function () {
                        DevExpress.ui.notify("Delete failed", "error", 2000);
                    }
                });
            }
        }
</script>
 

