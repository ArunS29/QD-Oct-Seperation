@page
@model QD.ERP.Web.Areas.ERM.Pages.EquipmentRevenueCostSummaryModel
@{
}
@* <input id="formId" value="frm201LedgerView" type="hidden" /> *@

<div class="title">
	<div class="header-container">
		<div id="SalesOrdersDetails" class="no-border-input"></div>
	</div>
</div>

@await Html.PartialAsync("/Pages/Shared/ERM/DetailsFooter.cshtml")


<div class="dx-fieldset horizontal-container">
	@(Html.DevExtreme().DateBox()
		.ID("frmdateBox")
		.Label(new JS("formatMessage('Start Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) // First day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(2)
		)

	@(Html.DevExtreme().DateBox()
		.ID("todateBox")
		.Label(new JS("formatMessage('End Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(3)
		)


	@(Html.DevExtreme().DropDownButton()
		.ID("ddBtnShowRecords")
		.Text(new JS("formatMessage('Show Records')"))
		.Icon("smalliconslayout")
		.Width(180)
		.ElementAttr("class", "button-alignment-down")
		.TabIndex(4)
		.SplitButton(true)
.OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }") // MAIN button click
				.DropDownOptions(options => options.Width(230))
				.Items(items =>
				{
					items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").Option("color", "#4285F4").OnClick("function() { ddBtnShowRecords_click('range'); }");
					items.Add().Text(new JS("formatMessage('Today')")).Icon("event").Option("color", "#34A853").OnClick("function() { ddBtnShowRecords_click('today'); }");
					items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").Option("color", "#EA4335").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
					items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").Option("color", "#FBBC05").OnClick("function() { ddBtnShowRecords_click('week'); }");
					items.Add().Text(new JS("formatMessage('This Month Till Date')")).Option("color", "#AB47BC").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
					items.Add().Text(new JS("formatMessage('This Month (Full)')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
					items.Add().Text(new JS("formatMessage('This Year Till Date')")).Option("color", "#FF7043").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
					items.Add().Text(new JS("formatMessage('This Year (Full)')")).Option("color", "#4285F4").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
					items.Add().Text(new JS("formatMessage('Last Month')")).Option("color", "#FBBC05").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
					items.Add().Text(new JS("formatMessage('Last Year')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
				})
				.ItemTemplate(@<text>
            <div class="custom-dropdown-item" >
                  <div style="background-color:<%- color %>;height:90%" class="side-bar"></div>
                <div class="item-content">
                    <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                    <div>
                        <div class="item-title"><%- text %></div>
                    </div>
                </div>
            </div>
        </text>)
		)

</div>
<div class="dx-field ledgerResult">
	@(Html.DevExtreme().DataGrid()
		.ID("dataGrid")
		.RemoteOperations(false)
		.DataSource(d => d.Mvc()
		.Controller("EquipmentRevenueCostReport")
		.LoadAction("GetEquipmentRevenueCostData")
		)
		.Columns(columns =>
		{
			columns.Add().Caption("Property / Equipment Details").Columns(subColumns =>
			{
				subColumns.Add().DataField("PropertyNo").Caption("Property No").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("PropertyDescription").Caption("Property Description").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("PropertyType").Caption("Property Type").Alignment(HorizontalAlignment.Center).Visible(true);
			});

			columns.Add().Caption("Rental to the Clients (Timesheet)").Columns(subColumns =>
			{
				subColumns.Add().DataField("ClientRegHoursTotal").Caption("Client Reg. Hours").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("ClientOTHoursTotal").Caption("Client O.T. Hours").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("ClientRegAmountTotal").Caption("Client Reg. Total").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("ClientOTAmountTotal").Caption("Client O.T. Total").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("ClientAmountTotal").Caption("Client Total Amount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().Caption("Details").Alignment(HorizontalAlignment.Center).Visible(true);
			});

			columns.Add().Caption("Hiring Details of Supplier (Timesheet)").Columns(subColumns =>
			{
				subColumns.Add().DataField("SuppRegHoursTotal").Caption("Supplier Reg. Hours").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("SuppOTHoursTotal").Caption("Supplier O.T. Hours").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("SuppRegAmountTotal").Caption("Supplier Reg. Total Amount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("SuppOTAmountTotal").Caption("Supplier O.T. Amount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("SuppAmountTotal").Caption("Supplier Total Amount").Alignment(HorizontalAlignment.Center).Visible(true);
			});

			columns.Add().Caption("Revenue Details").Columns(subColumns =>
			{
				subColumns.Add().DataField("InvoicedAmountTotal").Caption("Invoiced Amount").Alignment(HorizontalAlignment.Center).Visible(true);
			});

			columns.Add().Caption("Finance Records").Columns(subColumns =>
			{
				subColumns.Add().DataField("RevenueAllocTotal").Caption("Revenue Allocated Amount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.Add().DataField("ExpensesAllocTotal").Caption("Expenses Allocated Amount").Alignment(HorizontalAlignment.Center).Visible(true);
			});
		})
		.Height(680)
		.ColumnAutoWidth(true)
		.Width("98%")
		.WordWrapEnabled(true)
		.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.Paging(p => p.Enabled(false))
		.Pager(pager => pager.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.ShowRowLines(true)


		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.StateStoring(stateStoring =>
		{
			stateStoring
			.Enabled(true)
			.Type(StateStoringType.LocalStorage)
			.StorageKey("gridContainerState");
		})
		.OnInitialized("function(e) { loadGridState(); }")
		)


</div>
<div id="invoiceErrorPopup"></div>

<script>


			 $(function () {
		$("#SalesOrdersDetails").dxTextBox({
		text: formatMessage("Sales Order Details"),
			readOnly: true,
			onContentReady: function (e) {
			$(e.element).addClass("dx-textbox-heading");
			}
			});
		});

		document.addEventListener("DOMContentLoaded", function () {
		const gridElement = document.getElementById("dataGrid");
		const contextMenu = document.getElementById("contextMenu");

		// Add context menu listener to the grid
		gridElement.addEventListener("contextmenu", function (e) {
			e.preventDefault();

			// Find the data row that was right-clicked
			const rowElement = e.target.closest(".dx-data-row");

			if (rowElement) {
				// Select the clicked row in the DataGrid instance
				const dxGrid = $("#dataGrid").dxDataGrid("instance");
				const rowIndex = parseInt(rowElement.getAttribute("aria-rowindex"), 10) - 1;

				dxGrid.selectRowsByIndexes([rowIndex]);
				contextMenu.dataset.rowIndex = rowIndex;

				// Temporarily show context menu (hidden) to measure dimensions
				contextMenu.style.visibility = "hidden";
				contextMenu.style.display = "block";

				const menuWidth = contextMenu.offsetWidth;
				const menuHeight = contextMenu.offsetHeight;
				const windowWidth = window.innerWidth;
				const windowHeight = window.innerHeight;

				let mouseX = e.clientX;
				let mouseY = e.clientY;

				// Boundary check
				if (mouseX + menuWidth > windowWidth) {
					mouseX = windowWidth - menuWidth - 10;
				}
				if (mouseY + menuHeight > windowHeight) {
					mouseY = windowHeight - menuHeight - 10;
				}

				// Final position and make visible
				contextMenu.style.left = `${mouseX}px`;
				contextMenu.style.top = `${mouseY}px`;
				contextMenu.style.visibility = "visible";
			}
		});

		// Hide context menu when clicking elsewhere
		document.addEventListener("click", function (e) {
			if (!e.target.closest("#contextMenu")) {
				contextMenu.style.display = "none";
			}
		});
	});



		function ddBtnShowRecords_click(duration) {
			 var frmDateBox = $("#frmdateBox").dxDateBox("instance");
				var toDateBox = $("#todateBox").dxDateBox("instance");
				var frmDate = new Date(frmDateBox.option("value"));
				var toDate = new Date(toDateBox.option("value"));
				var currentDate = new Date();
				switch (duration) {
					case 'today':
						frmDate = toDate = currentDate;
						break;
					case 'yesterday':
						var dateObj = new Date();
						// Subtract one day from current time
						dateObj.setDate(dateObj.getDate() - 1);
						frmDate = toDate = dateObj;
						break;
					case 'week':
						var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

						// Calculate the start of the week (Saturday)
						var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

						// Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
					frmDate = new Date(currentDate.setDate(startOfWeek)); // 7 days before Saturday
						toDate = new Date(currentDate.setDate(startOfWeek + 6));
						break;
					case 'tillmonth':
						// Get the first and last day of the current month
						frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
						toDate = currentDate; //Today
						break;
					case 'fullmonth':
						// Get the first and last day of the current month
						frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
						toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
						break;
					case 'tillyear':
						// Get the first and last day of the current year
						frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
						toDate = currentDate;// Today
						break;
						// Get the first and last day of the current year
						frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
						toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
						break;
					case 'lastyear':
						// Get the first and last day of the last year
						frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
						toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
						break;
					case 'lastmonth':
						// Get the first and last day of the current month
						frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
						toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
						break;
				}
					frmDate = frmDate.toISOString().split('T')[0];
		toDate = toDate.toISOString().split('T')[0];

					$.ajax({
			url: '/api/ERSalesOrders/GetSalesOrdersDetails',
			type: 'GET',
			data: {
				fromDate: frmDate,
				toDate: toDate
			},
			success: function (data) {
				console.log("Returned Data: ", data); // debug
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
			},
			error: function (xhr) {
				console.log("AJAX Error", xhr.responseText); // debug
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});



		}

</script>