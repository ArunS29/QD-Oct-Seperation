    function savePropertyQuoteChild() {
        debugger;

        // get ?code=... from URL
        const params = new URLSearchParams(window.location.search);
        const quotationNo = params.get("code");


        if (!quotationNo) {
            DevExpress.ui.notify("QuotationNo (code) is missing in the URL.", "error", 3000);
            return;
        }

        // safe getter for DevExtreme widgets
        const getVal = (id, widget) => {
            const $el = $(`#${id}`);
            if (!$el.length) return null;
            const inst = $el[widget] ? $el[widget]("instance") : null;
            return inst ? inst.option("value") : null;
        };

        const getText = (id, widget) => {
            const $el = $(`#${id}`);
            if (!$el.length) return null;
            const inst = $el[widget] ? $el[widget]("instance") : null;
            return inst ? inst.option("text") : null;
        };

        // 🚫 don't generate LineOrderNo here — server will handle it
        const data = {
            QuoteNo: quotationNo,
            DetailedDescription: getVal("DetailedDescription", "dxTextArea"),
            Certification: getVal("Certification", "dxSelectBox"),
            Capacity: getVal("Capacity", "dxTextBox"),
            Operator: getVal("Operator", "dxSelectBox"),
            Attachment: getVal("Attachment", "dxSelectBox"),

            UnitRateMethod2: getText("QuoteMethod2", "dxDropDownBox"),
            UnitRate2: getVal("Rate2", "dxNumberBox"),
            UnitRateMethod3: getText("QuoteMethod3", "dxDropDownBox"),
            UnitRate3: getVal("Rate3", "dxNumberBox"),

            QuoteMethod2: getVal("QuoteMethod2", "dxDropDownBox"),
            Rate2: getVal("Rate2", "dxNumberBox"),
            QuoteMethod3: getVal("QuoteMethod3", "dxDropDownBox"),
            Rate3: getVal("Rate3", "dxNumberBox"),

            Notes: getVal("Notes", "dxTextBox"),
            AdditionalNotes: getVal("AdditionalNotes", "dxTextBox"),
            MobilizationRate: getVal("MobilizationRate", "dxNumberBox"),
            DemobRate: getVal("DemobRate", "dxNumberBox"),
            DeliveryDetails: getVal("DeliveryDetails", "dxTextBox")
        };



        // derive tenant dynamically (first segment of URL path)
        const tenant = window.location.pathname.split("/").filter(Boolean)[0];

        const apiUrl = `/api/AddNewQuotation1/SaveOrUpdateQuotationChild`;

        $.ajax({
            url: apiUrl,
            method: "POST",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(data),
            success: function (response) {
                if (response && response.success) {
                    DevExpress.ui.notify(response.message || "Saved.", "success", 3000);
                } else {
                    DevExpress.ui.notify((response && response.message) || "Save failed.", "error", 3000);
                }
            },
            error: function (xhr) {
                console.error("POST failed", xhr.status, xhr.responseText);
                DevExpress.ui.notify(`Failed to save data (${xhr.status}).`, "error", 3000);
            }
        });
    }









    </script>