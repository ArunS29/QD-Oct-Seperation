@page
@model QD.ERP.Web.Areas.ERM.Pages.EQDetailedDescriptionModel
@{
}
<style>
   

    /* Section body wrapper */
   
        /* Labels inside body */
        .section-body label {
            font-weight: bold;
            color: #000;
        }

    .dx-button-text {
        color: black;
    }

    /* Two-column layout */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 20px; /* row-gap / column-gap */
    }

    /* Single-column layout */
    .form-grid-1 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }


    /* Three-column layout */
    .form-grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px 20px; /* row-gap / column-gap */
    }



    /* Four-column layout */
    .form-grid-4 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 10px 20px; /* row-gap / column-gap */
    }





    /* NumberBox / TextBox alignment */
    .dx-textbox, .dx-numberbox, .dx-selectbox, .dx-textarea {
        width: 100% !important;
    }


    .btn-container {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .btn-solid {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: #6c757d;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-outline {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: transparent;
        color: #6c757d;
        border: 1px solid #6c757d;
        border-radius: 4px;
        cursor: pointer;
    }

 
</style>


<div class="p-3"  >

    <!-- Detailed Description -->
    @(Html.DevExtreme().TextArea()
        .ID("DetailedDescription")
        .Label(new JS("formatMessage('Detailed Description / Specification')"))
        .LabelMode(EditorLabelMode.Floating)
        .Width("100%")
        .ElementAttr("style", "height:100px !important;")  
        )


    <div class="form-grid">
        <div>
            @(Html.DevExtreme().SelectBox()
                        .ID("Certification")
                        .Label(new JS("formatMessage('Certification')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "ARAMCO CERTIFIED", "TUV CERTIFIED", "ARAMCO / SPSP CERTIFIED" })
                        .Width("100%")
                        )
        </div>

        <div>
            @(Html.DevExtreme().TextBox()
                        .ID("Capacity")
                        .Label(new JS("formatMessage('Capacity')"))
                        .LabelMode(EditorLabelMode.Floating)
                        )
        </div>
    </div>



    <div class="form-grid mt-2">
        <div>
            @(Html.DevExtreme().SelectBox()
                        .ID("Operator")
                        .Label(new JS("formatMessage('Operator')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "WITHOUT OPERATOR", "With OPERATOR", "WITH ARAMCO CERTIFIED OPERATOR" })  
                        .Width("100%")
                        )
        </div>

        <div>
            @(Html.DevExtreme().SelectBox()
                        .ID("Attachment")
                        .Label(new JS("formatMessage('Attachment')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "WITH BUCKET", "WITH BUCKET & FORK", "WITH PWAS" })   
                        .Width("100%")
                        )
        </div>
    </div>

    <div class="form-grid-4 mt-2">
        <!-- Quote Method 2 -->
        @(Html.DevExtreme().DropDownBox()
                .ID("QuoteMethod2")
                .Label(new JS("formatMessage('Quote Method 2')"))
                .LabelMode(EditorLabelMode.Floating)
                .Width("100%")
                .DataSource(d => d.WebApi()
                .Controller("StockInventory")    
                .LoadAction("GetUnitCodes")   
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("UnitCode"))          

                .Option("dataGridId", "GetUOM-datagrid") 
                .OpenOnFieldClick(false)
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("UnitCode")           
                .DisplayExpr("UnitType")       
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .TabIndex(2)
                .OnKeyDown("onKeyDown")
                .ContentTemplate(new TemplateName("GetQuoteMethodContentTemplate"))
                )


        <!-- Rate 2 -->
        <div>
            @(Html.DevExtreme().NumberBox()
                        .ID("Rate2")
                        .Label(new JS("formatMessage('Rate')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Format("#,##0.00")       
                        .Value(0.00)              
                        .ShowSpinButtons(true)    
                        .Step(1)                  
                        .Min(0)                   
                        .Width("100%")
                        )
        </div>


        <!-- Quote Method 3 -->
        <div>
            @(Html.DevExtreme().DropDownBox()
                        .ID("QuoteMethod3")
                        .Label(new JS("formatMessage('Quote Method 3')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        .DataSource(d => d.WebApi()
                        .Controller("StockInventory")     // your controller
                        .LoadAction("GetUnitCodes")       // your API method
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("UnitCode")                  // primary key field
                        )
                        .Option("dataGridId", "GetUOM-datagrid-3")  // unique datagrid id
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("UnitCode")                // value field
                        .DisplayExpr("UnitType")              // display field
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(3)
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("GetQuoteMethodContentTemplate2"))
                        )

        </div>

        <!-- Rate 3 -->
        <div>
            @(Html.DevExtreme().NumberBox()
                        .ID("Rate3")
                        .Label(new JS("formatMessage('Rate')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Format("#,##0.00")
                        .Value(0.00)              // default value
                        .ShowSpinButtons(true)    // show up/down arrows
                        .Step(1)                  // increment/decrement step
                        .Min(0)                   // optional: no negative values
                        .Width("100%")
                        )
        </div>

    </div>


    <div class="form-grid mt-2">
        <!-- Notes -->
        <div>
            @(Html.DevExtreme().TextBox()
                        .ID("Notes")
                        .Label(new JS("formatMessage('Notes')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
        </div>

        <!-- Additional Notes -->
        <div>
            @(Html.DevExtreme().TextBox()
                        .ID("AdditionalNotes")
                        .Label(new JS("formatMessage('Additional Notes')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
        </div>
    </div>

    <div class="form-grid-3 mt-2">
        <!-- Mobilization Rate -->
        <div>
            @(Html.DevExtreme().NumberBox()
                        .ID("MobilizationRate")
                        .Label(new JS("formatMessage('Mob Rate')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Format("#,##0.00")
                        .Value(0.00)              
                        .ShowSpinButtons(true)    
                        .Step(1)                  
                        .Min(0)                   
                        .Width("100%")
                        )
        </div>


        <!-- Demob Rate -->
        <div>
            @(Html.DevExtreme().NumberBox()
                        .ID("DemobRate")
                        .Label(new JS("formatMessage('Demob Rate')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Format("#,##0.00")
                        .Value(0.00)              
                        .ShowSpinButtons(true)    
                        .Step(1)                  
                        .Min(0)                   
                        .Width("100%")
                        )
        </div>


        <!-- Delivery Details -->
        <div>
            @(Html.DevExtreme().TextBox()
                        .ID("DeliveryDetails")
                        .Label(new JS("formatMessage('Delivery Details')"))
                        .LabelMode(EditorLabelMode.Floating)
                        )
        </div>
    </div>


    <div class="btn-container">
        @* Final Add button *@
        @(Html.DevExtreme().Button()
                .ID("SbmtBtnn")
                .Text(new JS("formatMessage('Submit')"))
                .Type(ButtonType.Success)
                .OnClick("savePropertyQuoteChild")
                )
    </div>

   




</div>


@using (Html.DevExtreme().NamedTemplate("GetQuoteMethodContentTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                        .ID("GetUOM-datagrid")
                        .DataSource(d => d.WebApi()
                            .Controller("StockInventory")
                            .LoadAction("GetUnitCodes")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("UnitCode")
                        )
                        .WordWrapEnabled(true)
                        .ShowBorders(true)
                        .Selection(sl => sl.Mode(SelectionMode.Single))
                       .OnSelectionChanged("quoteMethodSelectionChanged")
                       .OnInitialized("quoteMethodGridInitialized")
                        .HeaderFilter(p => p.Visible(true))
                        .FilterRow(f => f.Visible(false))
                        .ShowBorders(true)
                        .HoverStateEnabled(true)
                        .Paging(p => p.PageSize(15))
                        .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                        .Height(345)
                        .Selection(s => s.Mode(SelectionMode.Single))
                        .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                        .SelectedRowKeys(new JS(@"['']"))  // keep empty initially

                        .Columns(columns =>
                        {
                            columns.Add().DataField("UnitCode").Visible(false);
                            columns.Add().DataField("UnitType");


                        })
                        )
}


