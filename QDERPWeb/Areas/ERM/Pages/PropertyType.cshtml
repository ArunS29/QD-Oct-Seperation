@page
@model QD.ERP.Web.Areas.ERM.Pages.PropertyTypeModel

<style type="text/css">
	.dx-fieldset {
		margin: 0px 20px;
		padding: 0;
	}
	.dx-button-mode-contained.dx-button-default {
		color: black;
	}

	.dx-button-mode-contained.dx-button-success {
		color: black;
	}

	.container {
		display: none !important;
	}

	.frame {
		display: none !important;
	}

	.footerContainer {
		display: none !important;
	}

	.bodyContainer {
		display: flex;
		justify-content: center;
	}

	.imagecontainer {
		border-bottom: 2px;
	}

	.mainContainer {
		margin-top: 1em;
		width: 100%;
	}

	.playIcon {
		display: none;
	}
</style>

@* <div class="title">
	<div class="header-container">
		<div id="ItemClassification" class="no-border-input"></div>
	</div>
</div> *@
<!-- Filter/Info Section -->


<div class="dx-fieldset">
	<div class="store-master-container">
		<!-- Store Name Input -->
		<div>
			<div>
				<div style="display:flex; align-items:end;">
					@(Html.DevExtreme().TextBox()
							.ID("propertytype")
							.Label(new JS("formatMessage('Type a New Property & Add to the Existing List')"))
							.LabelMode(EditorLabelMode.Floating)
							.Width("70%")
							)
					<div class="add-button-wrap" style="margin-left:50%; margin-top:10px;">
						@(Html.DevExtreme().Button()
									.ID("Addproperty")
									.Text(new JS("formatMessage('Add')"))
									.Type(ButtonType.Success)
									.ElementAttr(new { @class = "custom-ui-button" })
									.Icon("plus")
									.Width("100%")
									)
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Data Grid -->
	<br />
	<div>
		@(Html.DevExtreme().DataGrid()
				.ID("storeGrid")
				.Height("75vh")
				.Width("100%")
				.ShowBorders(true)
				.ColumnAutoWidth(true)
				.ShowColumnLines(true)
				.ShowRowLines(true)
				.RowAlternationEnabled(true)
				.DataSource(d => d.WebApi()
				.Controller("AddNewProperty")
				.LoadAction("GetAllPropertyTypes")
				.UpdateAction("UpdatePropertyType")
				.UpdateMethod("PUT")
				.DeleteAction("DeletePropertyType")
				.DeleteMethod("DELETE")
				.Key("PropertyTypeId")
				)
				.Editing(editing => editing
				.Mode(GridEditMode.Row)
				.AllowUpdating(true)
				.AllowDeleting(true)
				.UseIcons(true)
				)
				.Columns(columns =>
				{
					columns.Add().DataField("PropertyTypeId")
					.Caption(new JS("formatMessage('ID')"))
					.Width(100)
					.Alignment(HorizontalAlignment.Center)
					.AllowEditing(false);

					columns.Add().DataField("PropertyType")
					.Caption(new JS("formatMessage('Property Type')"))
					.Width(300)
					.Alignment(HorizontalAlignment.Center)
					.AllowEditing(true);

					columns.Add()
					.Type(GridCommandColumnType.Buttons)
					.Width(150)
					.Buttons(buttons =>
					{
						buttons.Add().Name("edit");
						buttons.Add().Name("save");
						buttons.Add().Name("cancel");
						buttons.Add().Name("customDelete")
					.Icon("trash")
					.Hint("Delete")
					.OnClick("onCustomDeleteClick");
					});
				})
				.AllowColumnReordering(true)
				.AllowColumnResizing(true)
				.ColumnFixing(fixing => fixing.Enabled(true))
				.GroupPanel(g => g.Visible(false))
				.ShowColumnHeaders(true)
				)
	</div>
	<br />
	<!-- Buttons -->
	<div style="display:flex; gap:1%;">

		<div class="action-buttons">
			@(Html.DevExtreme().Button()
						.Text(new JS("formatMessage('Back')"))
						.Icon("arrowleft")
						.OnClick("Goback")
						.ElementAttr(new { @class = "dx-button-custom btn-back" })
						.Width(120)
						.Type(ButtonType.Default))
		</div>
	</div>
</div>
<script>
	function Goback() {
		window.parent.closeModal();
	}

	$(function () {
		// Add Property Type button click
		$("#Addproperty").dxButton({
			onClick: function () {
				var newProperty = $("#propertytype").dxTextBox("instance").option("value");

				if (!newProperty || newProperty.trim() === "") {
					DevExpress.ui.notify("Please enter a Property Type.", "error", 2000);
					return;
				}

				$.ajax({
					url: '/api/AddNewProperty/AddPropertyType',
					type: 'POST',
					contentType: 'application/json',
					data: JSON.stringify({ PropertyType: newProperty }),
					success: function () {
						DevExpress.ui.notify("Property Type added successfully!", "success", 2000);
						// Clear input box
						$("#propertytype").dxTextBox("instance").option("value", "");
						// Refresh the grid
						$("#storeGrid").dxDataGrid("instance").refresh();
						// Refresh parent dropdown
						setTimeout(() => {
							if (window.parent && typeof window.parent.refreshTypeOfRequestDropDown === "function") {
								window.parent.refreshTypeOfRequestDropDown('PropertyType');
							}
						}, 300);
					},
					error: function () {
						DevExpress.ui.notify("Failed to add Property Type.", "error", 3000);
					}
				});
			}
		});

		// Show success on update
		var grid = $("#storeGrid").dxDataGrid("instance");
		if (grid) {
			grid.option("onRowUpdated", function () {
				DevExpress.ui.notify("Property Type updated successfully.", "success", 2000);
			});
		}
	});

	// Custom delete handler
	function onCustomDeleteClick(e) {
		if (!e || !e.row || !e.row.data || !e.row.data.PropertyTypeId) {
			DevExpress.ui.notify("Invalid record selected.", "error", 2000);
			return;
		}

		DevExpress.ui.dialog.confirm("Are you sure you want to delete this Property Type?", "Confirm Deletion")
			.done(function (dialogResult) {
				if (dialogResult) {
					$.ajax({
						url: '/api/AddNewProperty/DeletePropertyType?key=' + e.row.data.PropertyTypeId,
						type: 'DELETE',
						success: function () {
							DevExpress.ui.notify("Property Type deleted successfully!", "success", 2000);
							$("#storeGrid").dxDataGrid("instance").refresh();
							 setTimeout(() => {
                    if (window.parent && typeof window.parent.refreshTypeOfRequestDropDown === "function") {
                        window.parent.refreshTypeOfRequestDropDown('PropertyType');
                    }
                }, 300);
						},
						error: function () {
							DevExpress.ui.notify("Failed to delete Property Type.", "error", 2000);
						}
					});
				}
			});
	}
</script>