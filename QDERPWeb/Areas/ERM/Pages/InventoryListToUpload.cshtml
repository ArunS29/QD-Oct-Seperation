@page
@model QD.ERP.Web.Areas.ERM.Pages.InventoryListToUploadModel
@{
}
<link rel="stylesheet" href="~/css/Site.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />

<style type="text/css">
	.overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5); /* Transparent background */

		z-index: 1000;
	}

	.overlay-content {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100%;
		height: 80%;
		background: #909ead00;
		box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
		border-radius: 8px;
		overflow: hidden;
	}

	#overlay-frame {
		width: 100%;
		height: 100%;
	}

	.mainContainer {
		margin-top: 5em;
		width: 99%;
		padding: 20px; 
	}

	.close-btn {
		position: absolute;
		top: 10px;
		right: 20px;
		font-size: 30px;
		cursor: pointer;
	}




	.footer {
		display: flex;
		align-items: center;
		height: 0px;
		margin-left: auto; /* Pushes it fully to the right */
		margin-top: 15px;
		padding-top: 22px;
	}


	

	.no-border-title {
		border: none !important;
		outline: none !important;
		box-shadow: none !important;
		background: transparent !important;
		font-weight: bold;
		font-size: 20px !important;
		color: white;
		pointer-events: none; 
	}
	
</style>


<div class="title">
	<div class="header-container">
		<div id="InventoryListsToUpload" class="no-border-title"></div>
	</div>
</div>

<div style="width:100%;" >

	<table width="100%" style="font-size:14px; margin:10px 0;" cellpadding="5">

		<tr>
			<td style="display: flex; align-items:end;">
				
					@(Html.DevExtreme().DropDownBox()
								.Label("Stock Group")
								.LabelMode(EditorLabelMode.Outside)
								.Width("100%")
								)
					@(Html.DevExtreme().Button()
								.Icon("plus")
								.Width(45))
					
				
			</td>
			<td>
				
					@(Html.DevExtreme().TextBox()
										.Label("Vat Purchase No.")
										.LabelMode(EditorLabelMode.Outside)
										.Width("100%")
										)
					
			</td>
			<td>

				@(Html.DevExtreme().TextBox()
								.Label("Proforma Invoice No.")
								.LabelMode(EditorLabelMode.Outside)
								.Width("100%")
								)

			</td>
			<td>

				@(Html.DevExtreme().TextBox()
								.Label("Invoice No.")
								.LabelMode(EditorLabelMode.Outside)
								.Width("100%")
								)

			</td>
			<td>

				@(Html.DevExtreme().TextBox()
								.Label("Request No.")
								.LabelMode(EditorLabelMode.Outside)
								.Width("100%")
								)

			</td>
			
		</tr>
	</table>
   <table>
		<tr>
			<td>
				@(Html.DevExtreme().DataGrid()
								.DataSource(new[] { new { } })
								.ShowBorders(true)
								.ColumnAutoWidth(true)
								.ShowColumnLines(true)
								.ShowRowLines(true)
								.AllowColumnResizing(true) // Enable column resizing
								.ColumnResizingMode(ColumnResizingMode.NextColumn) // Optional: can be "Widget" or "NextColumn"
								.AllowColumnReordering(true) // Optional: allow dragging columns
								.ColumnChooser(chooser => chooser
								.Enabled(true)
								.Mode(GridColumnChooserMode.DragAndDrop) // You can also use "DragAndDrop"
								)
								.Paging(p => p.Enabled(false))
								.Columns(columns =>
								{

									columns.Add()
									.Caption("Stock Details")
									.Alignment(HorizontalAlignment.Center)
									.Columns(sub =>
									{
										sub.Add().DataField("SINO").Caption("SI NO").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("GSCode").Caption("GS Code").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("GSDescription").Caption("GS Description").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("GSUoM").Caption("GSUoM").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("Quanti").Caption("Quanti").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("UnitPrice").Caption("Unit Price").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("PlanNo").Caption("Plan No").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("Manufacturer").Caption("Manufacturer").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("DeliveryPeriod").Caption("Delivery Period").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("Remarks").Caption("Remarks").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("GSUoMDesc").Caption("GSUoM Desc").Visible(true).Alignment(HorizontalAlignment.Center);
										sub.Add().DataField("Item").Caption("Item").Visible(true).Alignment(HorizontalAlignment.Center);
									});
								})
								.Width("100%")
								.Height(450)
								)
			</td>
		</tr>

	</table>
</div>

<script>


	$(function () {
		 $("#InventoryListsToUpload").dxTextBox({
			 text:formatMessage("Inventory List To Upload"),
					readOnly: true,
					onContentReady: function(e) {
						$(e.element).addClass("dx-textbox-heading");
					}
		 });
	});

	
</script>