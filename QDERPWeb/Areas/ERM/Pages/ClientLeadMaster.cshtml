<script>
    
    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const clientCode = urlParams.get("clientCode");
       
         const cleanClientCode = clientCode ? clientCode.split("?")[0] : null;   // Trim off anything after '?' if it's accidentally included in value
        // ✅ Define globally so Razor grid can access it
    // window.getClientCodeParams = function () {
    //     return { cleanClientCode: cleanClientCode };
    // };

        if (cleanClientCode) {
            loadClientDetails(cleanClientCode); 
        }
    
    });

    function loadClientDetails(cleanClientCode) {
        
    $.ajax({
        url: `/api/ClientLeadMaster1/GetClientByCode?clientCode=${cleanClientCode}`,
        type: 'GET',
        success: function (data) {
              $("#btnSave").dxButton("instance").option("text", "Update");
            console.log("binddata:",data);
            if (data) {
