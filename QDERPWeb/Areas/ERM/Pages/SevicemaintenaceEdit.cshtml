                    function loadClientDetails(ServiceSheetNo) {
                        $.ajax({
                            url: `/api/ServiceMaintenance/GetServiceProperty?code=${encodeURIComponent(ServiceSheetNo)}`,
                            type: 'GET',
                            dataType: 'json',
                            success: function (response) {
                                if (!response) {
                                    console.warn("No client details found in the response.");
                                    return;
                                }

                                console.log("Client details:", response);

                                // Change Save button to Update
                                const saveBtn = $("#btnSave").dxButton("instance");
                                if (saveBtn) saveBtn.option("text", "Update");

                                // Row 1
                                $("#txtServiceOrderNo").dxTextBox("instance")?.option("value", response.ServiceSheetNo);
                                $("#ServiceEntryDate").dxDateBox("instance")?.option("value", response.ServiceDate);
                                $("#ddlVehicleDescription").dxDropDownBox("instance")?.option("value", response.PropertyNo);

                                // Row 2
                                $("#ddlMechanicName").dxSelectBox("instance")?.option("value", response.ServicedBy);
                                $("#ddlPropertyBroughtBy").dxSelectBox("instance")?.option("value", response.PropertyBroughtBy);
                                $("#txtOperatorName").dxTextBox("instance")?.option("value", response.OperatorName);
                                $("#txtDriverContact").dxTextBox("instance")?.option("value", response.OperatorContactNo);

                                // Row 3
                                $("#ddlServiceType").dxSelectBox("instance")?.option("value", response.ServiceOrderType);
                                $("#ddlServiceStatus").dxSelectBox("instance")?.option("value", response.ServiceStatus);
                                $("#txtLocation").dxTextBox("instance")?.option("value", response.Location);
                                $("#txtProject").dxTextBox("instance")?.option("value", response.Project);
                                $("#ddlPropertyComplaint").dxtextArea("instance").option("value", response.Complaint);
                                $('#currencyexchangerate').dxNumberBox("instance").option("value", response.CurrencyRate);
						        $("#ddlGoodsGroup4").dxDropDownBox("instance").option("value", response.BaseCurrencyId);
						        $("#ddlGoodsGroup3").dxDropDownBox("instance").option("value", response.CurrencyId);

                                   // ✅ Load children grid
                                if (Array.isArray(response.Children)) {
                                    const cleanChildren = response.Children.map((row, index) => ({
                                        ...row,
                                        SNo: index + 1
                                    }));

                                    const grid = $("#itemGrid").dxDataGrid("instance");
                                    if (grid) {
                                        grid.option("dataSource", cleanChildren);
                                        grid.refresh();
                                    }
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error("Error fetching client details:", error);
                            }
                        });
                    }

