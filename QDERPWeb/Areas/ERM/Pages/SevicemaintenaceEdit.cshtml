           <div class="dx-field ledgerResult">
				@(Html.DevExtreme().DataGrid()
					.ID("itemGrid") 
					.Height("38vh")
					.DataSource(new JS("window.itemGridDataSource"))
					.Columns(columns =>
					{
						columns.Add().DataField("RequestChildSlNo").Caption("#").Width(50).AllowEditing(false).CellTemplate(new JS("serialTemplate")).Visible(false);
						columns.Add().DataField("PropertyType").Caption(new JS("formatMessage('Item Code')")).Width(120).AllowEditing(false)
						.CellTemplate(new JS(@"
						function(container, options) {
						container.text(options.data?.PropertyTypeId || '');
						}
					"));
					columns.Add()
                            .DataField("Description")
                            .Caption(new JS("formatMessage('Item Description')"))
                            .Width(400)
                            .EditCellTemplate(new JS("descriptionDropDownTemplate"))
                            .CellTemplate(new JS(@"
                                function (container, options) {
                                    if (!options.value) {
                                        $('<span>').text('').appendTo(container);
                                        return;
                                    }
                                    $.getJSON('/api/GoodsandServices/GetGoodsAndServiceByCode?code=' + options.rowData.Gscode)
                                        .done(function (data) {
                                            $('<span>').text(data.GSDescrpition).appendTo(container);
                                        });
                                }
                            "));

						columns.Add()
						.DataField("UnitRateMethod")
						.Caption(new JS("formatMessage('Unit')"))
						.Width(400)
						.EditCellTemplate(new JS("unitRateMethodDropDownTemplate"))
						.CellTemplate(new JS("function (container, options) { const unit = unitCodesList.find(u => u.UnitCode === options.value); container.text(unit ? unit.UnitDesc : options.value); }"));
						columns.Add()
						.DataField("QtyRequested")
						.Caption(new JS("formatMessage('Qty Used')"))
						.DataType(GridColumnDataType.Number)  
						.Width(150)
						.EditorOptions(new {
							maxLength = 8
							});
						columns.Add().DataField("ExpectedUnitRate").Caption(new JS("formatMessage('Cost Price')")).DataType(GridColumnDataType.Number).EditorOptions(new {value = 0});

						columns.Add().DataField("UnitsRequested").Caption(new JS("formatMessage('Total Cost')")).DataType(GridColumnDataType.Number).EditorOptions(new {value = 0});

						columns.Add()
							.Type(GridCommandColumnType.Buttons)
							.Width(60)
							.Buttons(b =>
							{
								b.Add()
								 .Hint("Delete")
								 .Icon("remove")            
								 .OnClick("deleteChild");
							});
					})
					.ColumnAutoWidth(true)
					.Width("100%")
					.WordWrapEnabled(false)
					.AllowColumnReordering(true)
					.AllowColumnResizing(true)
					.ColumnFixing(fixing => fixing.Enabled(true))
					.HeaderFilter(filter => filter.Visible(false))
					.Paging(p => p.Enabled(false))
					.Pager(pager => pager.Visible(false))
					.Grouping(grouping => grouping.AutoExpandAll(true))
					.FilterRow(filterRow => filterRow.Visible(false))
					.GroupPanel(groupPanel => groupPanel.Visible(false))
					.ShowBorders(true)
					.ShowRowLines(true)
					.Editing(editing => editing
					.Mode(GridEditMode.Cell)
					.AllowUpdating(true)
					.AllowDeleting(true)
					)
					.OnContextMenuPreparing("onGridRightClick")
					)
		              </div>
                </div>
            </div>
