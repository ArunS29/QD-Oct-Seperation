         $("#btnSave").on("click", function (e) {
             debugger;
            const $btn = $(this).dxButton("instance");
            $btn.option("disabled", true); // prevent double clicks

            // ✅ Step 1: Validate required field
            const PropertyValidator = $("#ddlVehicleDescription").dxValidator("instance");
            const PropertyValidation = PropertyValidator.validate();

            if (!PropertyValidation.isValid) {
                DevExpress.ui.dialog.alert(
                    "Cannot continue saving with errors, please clear the errors and continue.",
                    "Clear Errors"
                );
                $btn.option("disabled", false);
                return;
            }

            // ✅ Step 2: Build master object
            const master = {
                ServiceSheetNo: $("#txtServiceOrderNo").dxTextBox("instance")?.option("value"),
                ServiceDate: $("#ServiceEntryDate").dxDateBox("instance")?.option("value"),
                PropertyNo: $("#ddlVehicleDescription").dxDropDownBox("instance")?.option("value"),
                ServicedBy: $("#ddlMechanicName").dxSelectBox("instance")?.option("value"),
                PropertyBroughtBy: $("#ddlPropertyBroughtBy").dxSelectBox("instance")?.option("value"),
                OperatorName: $("#txtOperatorName").dxTextBox("instance")?.option("value"),
                OperatorContactNo: $("#txtDriverContact").dxTextBox("instance")?.option("value"),
                Location: $("#txtLocation").dxTextBox("instance")?.option("value"),
                Project: $("#txtProject").dxTextBox("instance")?.option("value"),
                ServiceStatus: $("#ddlServiceStatus").dxSelectBox("instance")?.option("value"),
                StoreIssuedFrom: $("#dditemfromstore").dxDropDownBox("instance")?.option("value"),
                ServiceOrderType: $("#ddlServiceType").dxSelectBox("instance")?.option("value"),
                CurrencyRate : $('#currencyexchangerate').dxNumberBox("instance")?.option("value"),
                BaseCurrencyId : $("#ddlGoodsGroup4").dxDropDownBox("instance")?.option("value"),
                CurrencyId : $("#ddlGoodsGroup3").dxDropDownBox("instance")?.option("value"),
                AddedBy: "CurrentUser",
                AddedOn: new Date()
            };

            // ✅ Step 3: Get children from DataGrid
            const gridInstance = $("#itemGrid").dxDataGrid("instance");
            const children = gridInstance?.getDataSource()?.items() || [];

            if (!children || children.length === 0) {
                DevExpress.ui.notify("No child records to save.", "error", 3000);
                $btn.option("disabled", false);
                return;
            }

            // ✅ Step 4: Build DTO payload
            const model = {
                Master: [master],  // wrap in array for DTO
                Children: children
            };

            // ✅ Step 5: AJAX call to save data
            $.ajax({
                type: "POST",
                url: "/api/ServiceMaintenance/SaveOrUpdateServiceRequest",
                contentType: "application/json",
                data: JSON.stringify(model),
                success: function (response) {
                    DevExpress.ui.notify(response.message || "Saved successfully.", "success", 3000);

                    // Optional: refresh parent grid if exists
                    if (window.parent && window.parent.$("#dataGrid").length) {
                        const dataGrid = window.parent.$("#dataGrid").dxDataGrid("instance");
                        if (dataGrid) dataGrid.refresh();
                    }

                    $btn.option("disabled", false);
                },
                error: function (xhr) {
                    DevExpress.ui.notify("Error: " + (xhr.responseJSON?.message || xhr.statusText), "error", 5000);
                    $btn.option("disabled", false);
                }
            });
        });

