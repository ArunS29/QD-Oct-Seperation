    function descriptionDropDownTemplate(cellElement, cellInfo) {
    let $container = $("<div>").css({
        display: "flex",
        alignItems: "center",
        gap: "5px",
        width: "100%"
    }).appendTo(cellElement);

    let selectedItemData = {};
    const dropdownStore = new DevExpress.data.CustomStore({
        key: "GSCode",
        load: function (loadOptions) {
            const pageNumber = Math.floor((loadOptions.skip || 0) / loadOptions.take) + 1;
            const pageSize = loadOptions.take;
            return $.getJSON("/api/GoodsandServices/GetGoodsAndServices", {
                pageNumber,
                pageSize
            }).then(response => {
                return {
                    data: response.data,
                    totalCount: response.totalCount
                };
            });
        }
    });

    // dropdown with DataGrid content
    $("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({
        valueExpr: "GSCode",
        displayExpr: "GSDescrpition",
        value: cellInfo.value,
        dataSource: dropdownStore,
        searchEnabled: true,
        searchExpr: "GSDescrpition",
        searchMode: "contains",
        minSearchLength: 3,
        deferRendering: true,
        dropDownOptions: { width: 800 },
        contentTemplate: function (e) {
            return $("<div>").dxDataGrid({
                dataSource: e.component.getDataSource(),
                keyExpr: "GSCode",
                height: 300,
                remoteOperations: true,
                paging: { enabled: true, pageSize: 15 },
                pager: { visible: true, showPageSizeSelector: true },
                selection: { mode: "single" },
                columns: [
                    { dataField: "GSCode", caption: "Code", width: 80 },
                    { dataField: "ItemPartNo", caption: "Item Part No", width: 100 },
                    { dataField: "GSDescrpition", caption: "Description", width: 200 },
                    { dataField: "GsdescriptionAr", caption: "Arabic Description", width: 200 },
                    { dataField: "IsDiscontinued", caption: "Discontinued", dataType: "boolean", width: 150 }
                ],
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.IsDiscontinued) {
                        e.rowElement.css("background-color", "#ffcccc");
                    }
                },
                onSelectionChanged: function (selectedItems) {
                    const selectedItem = selectedItems.selectedRowsData[0];
                    if (!selectedItem) return;
                    selectedItemData = selectedItem;

                    cellInfo.setValue(selectedItem.GSDescrpition);

                    const dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
                    const rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);
                    if (rowIndex !== -1) {
                        dataGrid.cellValue(rowIndex, "Gscode", selectedItem.GSCode);
                        dataGrid.cellValue(rowIndex, "Cost Price", selectedItem.CostPrice || 0);
                        dataGrid.cellValue(rowIndex, "GSSellingRate", selectedItem.GSSellingRate || 0);
                        dataGrid.cellValue(rowIndex, "Qty", 1);
                        dataGrid.cellValue(rowIndex, "UnitRateMethod", selectedItem.GsuoM);
                    }

                    e.component.close();
                }
            });
        }
    });

    // add/edit buttons
    const $actionButtonWrapper = $("<div>").appendTo($container);
    $("<div>").dxButton({
        icon: "plus",
        hint: "Add new item",
        onClick: function () {
            openModal(`/${tenantName}/IMS/GoodsAndService`, "Goods and Services");
        }
    }).appendTo($actionButtonWrapper);

    $("<div>").dxButton({
        icon: "edit",
        hint: "Edit item",
        onClick: function () {
            const grid = $("#B2BdataGrid").dxDataGrid("instance");
            const rowIndex = cellInfo.rowIndex;
            const rowData = grid.cellValue(rowIndex, "Gscode");
            if (!rowData) {
                DevExpress.ui.notify("Item Code (Gscode) is missing", "warning", 2000);
                return;
            }
            const url = `/${tenantName}/IMS/GoodsAndService?gscode=${encodeURIComponent(rowData)}`;
            openModal(url, "Goods and Services", function () {
                grid.refresh();
            });
        }
    }).appendTo($actionButtonWrapper);
}



