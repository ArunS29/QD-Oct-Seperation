            	function deleteChild(SpareSlNo) {
				DevExpress.ui.dialog.confirm(
					"Do you want to delete this child record?",
					"Confirmation"
				).done(function (dialogResult) {
					if (dialogResult) {
						$.ajax({
							url: `/api/ServiceMaintenance/DeleteServiceChild/${encodeURIComponent(SpareSlNo)}`,
							type: "DELETE",
							success: function (response) {
							DevExpress.ui.notify(response.message, "success", 2000);

							 const grid = $("#itemGrid").dxDataGrid("instance");
                                if (grid) {
                                    const ds = grid.getDataSource();

                                    if (ds && typeof ds.reload === "function") {
                                        // ✅ For remote or array store
                                        ds.reload().done(() => grid.refresh());
                                    } else {
                                        // ✅ Fallback: force fetch again
                                        grid.option("dataSource", new DevExpress.data.DataSource({
                                            load: () => $.getJSON("/api/ServiceMaintenance/GetChildren")
                                        }));
                                    }
                                }
						},
							error: function (xhr) {
								DevExpress.ui.notify(
									"Error: " + (xhr.responseJSON?.error || "Something went wrong"),
									"error",
									3000
								);
							}
						});
					}
				});
			}

              $(document).ready(function () {
                const urlParams = new URLSearchParams(window.location.search);
                const ServiceSheetNo = urlParams.get("code");

                if (!ServiceSheetNo) {
                    console.warn("⚠️ No 'code' parameter found in the URL.");
                    return;
                }

                // ✅ Direct AJAX call to hit API
                $.ajax({
                    url: "/api/ServiceMaintenance/GetServiceProperty?ServiceSheetNo=" + encodeURIComponent(ServiceSheetNo),
                    method: "GET",
                    data: { code: ServiceSheetNo }, 
                    success: function (response) {
                        console.log("✅ API Response:", response);

                        if (response) {
                            // Row 1
                            $("#txtServiceOrderNo").dxTextBox("instance").option("value", response.Master?.ServiceSheetNo ?? "");
                            $("#ServiceEntryDate").dxDateBox("instance").option("value", response.Master?.ServiceDate);
                            $("#ddlVehicleDescription").dxDropDownBox("instance").option("value", response.Master?.PropertyNo);

                            // Row 2
                            $("#ddlMechanicName").dxSelectBox("instance").option("value", response.Master?.ServicedBy);
                            $("#ddlPropertyBroughtBy").dxSelectBox("instance").option("value", response.Master?.PropertyBroughtBy);
                            $("#txtOperatorName").dxTextBox("instance").option("value", response.Master?.OperatorName);
                            $("#txtDriverContact").dxTextBox("instance").option("value", response.Master?.OperatorContactNo);

                            // Row 3
                            $("#ddlServiceType").dxSelectBox("instance").option("value", response.Master?.ServiceOrderType);
                            $("#ddlServiceStatus").dxSelectBox("instance").option("value", response.Master?.ServiceStatus);
                            $("#txtLocation").dxTextBox("instance").option("value", response.Master?.Location);
                            $("#txtProject").dxTextBox("instance").option("value", response.Master?.Project);
                            $("#ddlPropertyComplaint").dxTextArea("instance").option("value", response.Master?.Complaint);
                            $("#dditemfromstore").dxDropDownBox("instance").option("value", response.Master?.StoreIssuedFrom);
                            $('#currencyexchangerate').dxNumberBox("instance").option("value", response.CurrencyRate);
                            $("#ddlGoodsGroup4").dxDropDownBox("instance").option("value", response.BaseCurrencyId);
                            $("#ddlGoodsGroup3").dxDropDownBox("instance").option("value", response.CurrencyId);

                            // ✅ Load children grid
                            if (Array.isArray(response.Children)) {
                                const cleanChildren = response.Children.map((row, index) => ({
                                    ...row,
                                    SNo: index + 1
                                }));

                                const grid = $("#itemGrid").dxDataGrid("instance");
                                if (grid) {
                                    grid.option("dataSource", cleanChildren);
                                    grid.refresh();
                                }
                            }
                        }
                    },
                    error: function (err) {
                        console.error("❌ Error loading service order", err);
                    }
                });
            });

  function ServiceDelete() {
      debugger;
    const serviceSheetNo = $("#txtServiceOrderNo").dxTextBox("instance")?.option("value");

    if (!serviceSheetNo) {
        DevExpress.ui.notify("Service Sheet No is missing.", "error", 3000);
        return;
    }

    DevExpress.ui.dialog.confirm(
        "Do you really want to delete this Service Sheet?",
        "Delete Confirmation"
    ).done(function (dialogResult) {
        if (dialogResult) {
            $.ajax({
                url: `/api/ServiceMaintenance/DeleteServiceMaster/${serviceSheetNo}`, // ✅ pass value to API
                type: "DELETE",
                success: function (response) {
                    DevExpress.ui.notify(response.message || "Deleted successfully.", "success", 3000);

                    // ✅ reload your DataGrid if it exists
                    setTimeout(function () {
                        history.back();   // goes to the last visited page
                    }, 1500);
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.error || "Failed to delete record.";
                    DevExpress.ui.notify(msg, "error", 4000);
                }
            });
        }
    });
}


