<script>
    $(document).ready(function () {

        $(".limited-footer .btn-container").each(function () {

            if (!$(this).find("#btnSave,#btnSaveAndClose,#btnDelete,btnPrint,#btnBack").length) {

                $(this).remove();

            }

        });

    });

    $(document).on("click", "#btnBack", function () {
        window.history.back();
    });

    function dataGridSelectionChanged1(e) {
        const selectedRow = e.selectedRowsData[0];
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#GetProjectDropDown").dxDropDownBox("instance");

        if (selectedRow && selectedKey) {
            // Get ClientCategoryCode (numeric value) and ClientCode (formatted value)
            const clientCategoryCode = selectedRow.GsgroupId;
            const categoryCode = selectedRow.GsgroupCode; // Full ClientCode (e.g., "SW-0004")

            // 1. Set value in DropDownBox to ClientCategoryCode (numeric)
            ddbInstance.option("value", clientCategoryCode);

            // 2. Close the DropDownBox after selecting
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }

            // 3. Call generateNextClientCode with the full ClientCode (e.g., "SW-0004")
            generateNextClientCode(categoryCode);
        }
    }
    function generateNextClientCode(categoryCode) {

        $.ajax({
            url: `/api/GoodsandServices1/GetLatestClientCode?categoryCode=${categoryCode}`,
            type: 'GET',
            success: function (latestCode) {
                let nextNumber = 1;

                if (latestCode) {
                    const parts = latestCode.split("-");
                    if (parts.length === 2 && !isNaN(parts[1])) {
                        nextNumber = parseInt(parts[1]) + 1;
                    }
                }

                // ✅ Format with leading zeros (e.g., "0004")
                const formattedNumber = String(nextNumber).padStart(5, '0');
                const newClientCode = `${categoryCode}-${formattedNumber}`;

                $("#txtGoodsCode7").dxTextBox("instance").option("value", newClientCode);
            },
            error: function () {
                DevExpress.ui.notify("Error getting latest Client Code", "error", 3000);
            }
        });
    }

    function dataGridInitialized1(e) {
        dataGrid = e.component;
    }

    function dataGridSelectionChanged2(e) {
        const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
        const ddbInstance = $("#GetLedgerNoDropDown").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
    }
    function dataGridInitialized2(e) {
        dataGrid = e.component;
    }



    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

     function dropDownBoxOnInput(e) {
                const ddbInstance = e.component;
                if (!ddbInstance.option("opened")) ddbInstance.open();


                const text = ddbInstance.option("text");
                if (dataGrid) {
                    dataGrid.option("searchPanel.text", text);
                }
            }

             function onOpened(e) {
                setTimeout(() => {
                    e.component.focus();
                });
            }

            
    

    async function convertDescriptionToArabic() {
        const englishBox = $("#txtDescription8").dxTextArea("instance");
            const arabicBox = $("#txtDescriptionArabic").dxTextArea("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    async function convertDetailedDescToArabic() {
        const englishBox = $("#txtDetailedDescription").dxTextArea("instance");
            const arabicBox = $("#txtDetailedDescriptionArabic").dxTextArea("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a detailed description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }


    async function translateToArabic(text) {
        try {
            const response = await fetch(
                `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|ar`
            );

            if (!response.ok) {
                throw new Error("Translation API request failed.");
            }

            const data = await response.json();
            console.log("Translation result:", data);

            return data?.responseData?.translatedText || "Translation not found";

        } catch (error) {
            console.error("Translation failed:", error);
            throw error;
        }
    }


    $("#btnSaveAndClose").on("click", function (e) {
        e.preventDefault();
        onSaveClientMasterClick();
    });
    $("#btnSave").on("click", function (e) {
        e.preventDefault();
        onSaveClientMasterClick();
    });
    function onSaveClientMasterClick(e) {
        
        // Collecting form data from client master form
        var Gscode = $('#txtGoodsCode7').dxTextBox("instance").option("value");
      
        var GsgroupId = $('#GetProjectDropDown').dxDropDownBox("instance").option("value");
        var ItemPartNo = $('#txtItemPartNo4').dxTextBox("instance").option("value");
        var Gsdescrpition = $('#txtDescription8').dxTextArea("instance").option("value");

        var GsdescriptionAr = $('#txtDescriptionArabic').dxTextArea("instance").option("value");
        var GsuoM = $('#GetLedgerNoDropDown').dxDropDownBox("instance").option("value");

        var GspackingUnit = $('#packingUnit').dxNumberBox("instance").option("value");
        var GssellingRate = $('#sellingRate').dxNumberBox("instance").option("value");

        var CostPrice = $('#txtCostPrice3').dxNumberBox("instance").option("value");

        var GsdetailedDesc = $('#txtDetailedDescription').dxTextArea("instance").option("value");
        var GsdetailedDescAr = $('#txtDetailedDescriptionArabic').dxTextArea("instance").option("value");
       

        // Validate required fields
        var clientNameValidator = $("#txtGoodsCode7").dxValidator("instance");
        var clientCodeValidator = $("#txtDescription8").dxValidator("instance");

        var clientNameValidation = clientNameValidator.validate();
        var clientCodeValidation = clientCodeValidator.validate();

        if (clientNameValidation.isValid && clientCodeValidation.isValid) {
            // Construct the data object to send to the API
            const data = {
                Gscode: Gscode,
                GsgroupId: GsgroupId,
                ItemPartNo: ItemPartNo,
                Gsdescrpition: Gsdescrpition,
                GsdescriptionAr: GsdescriptionAr,
                GsuoM: GsuoM,
                GspackingUnit: GspackingUnit,
                GssellingRate: GssellingRate,
                CostPrice: CostPrice,
                GsdetailedDesc: GsdetailedDesc,
                GsdetailedDescAr: GsdetailedDescAr

            };

            console.log(data);

            // Send data via AJAX POST request
            $.ajax({
                url: '/api/GoodsandServices1/InsertOrUpdate', // Change this URL to your actual API endpoint
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data), // Send the data as a JSON string
                success: function (response) {
                    if (response.success) {
                        DevExpress.ui.notify(response.message, "success", 3000);
                        // Close the form or popup if needed
                        // setTimeout(function () {
                        //     $("#clientMasterPopup").dxPopup("instance").hide();
                        // }, 2000);
                    } else {
                        DevExpress.ui.notify("Error: " + response.message, "error", 3000);
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Error: " + error);
                    DevExpress.ui.notify("An error occurred while saving the data", "error", 3000);
                }
            });
        } else {
            DevExpress.ui.notify("Please fill all required fields", "error", 3000);
        }
    }

    //delete
    $("#btnDelete").on("click", function (e) {
        e.preventDefault();
        onDeleteButtonClick();
    });
    function onDeleteButtonClick(e) {
        
        var GoodsCode = $('#txtGoodsCode7').dxTextBox("instance").option("value");

        if (!GoodsCode) {
            DevExpress.ui.notify("Please enter or select a Journal Entry to delete.", "warning", 3000);
            return;
        }

        $.ajax({
            url: "/api/GoodsandServices1/DeleteGoodsandService",
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(GoodsCode), // 👈 plain string
            success: function (response) {
                DevExpress.ui.notify(response.message, 'success', 3000);
                setTimeout(function () {
                    location.reload();
                }, 2000);
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                DevExpress.ui.notify(msg, 'error', 3000);
            }
        });
    }





</script>
