@page
@model Demo.Areas.Security.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Demo.styles.css" asp-append-version="true" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/jquery.idle.js"></script>
<script src="~/js/jwt-decode.min.js"></script>
<style>
    /* Fullscreen background */
    body {
        margin: 0;
        padding: 0;
        height: 100vh;
        font-family: Arial, sans-serif;
        background-color: #ffffff; /* White background for the entire body */
    }

    /* Outer container */
    .background-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        position: relative;
        min-height: 100vh;
        /* background: url('~/images/background.gif') no-repeat center center; */
    }

    /* Login Box */
    .login-container {
        background: #ffffff;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        padding: 30px;
        width: 400px;
        text-align: center;
        z-index: 10;
        border: 1px solid #ddd;
        animation: fadeIn 1s ease-in-out; /* Apply fade-in animation */
    }

    /* Labels and Input fields */
    label {
        display: block;
        text-align: left;
        font-size: 14px;
        margin-bottom: 5px;
        color: #333;
    }

    input {
        width: 100%;
        padding: 10px;
        margin: 10px 0;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
        background-color: #f9f9f9;
    }

        input:focus {
            outline: none;
            border-color: #007bff;
            background-color: #fff;
        }

    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        margin-bottom: 20px;
    }

    .remember-me {
        display: flex;
        align-items: center; /* Aligns the checkbox and text horizontally */
        gap: 5px; /* Space between checkbox and text */
    }

    .forgot-password {
        text-decoration: none;
        color: #007bff;
        margin-left: auto; /* Pushes the text to the right */
    }

    /* Button */
    button {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 10px;
        width: 100%;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
    }

        button:hover {
            background-color: #0056b3;
        }

    /* Logo */
    .logo {
        margin-bottom: 20px;
        position: relative; /* Set position to relative */
        z-index: 10; /* Higher z-index to bring it to the front */
    }

        .logo img {
            width: 200px;
            height: 80px;
        }

    /* Background container */
    .background-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        position: relative;
        min-height: 100vh;
    }

    /* Full-size Building Skyline */
    .skyline {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100vh; /* Full viewport height */
        background: url('~/images/background.gif') no-repeat center center;
        background-size: cover;
        z-index: 1; /* Lower z-index to keep it behind other elements */
    }

    /* Footer Text */
    .footer {
        font-size: 12px;
        text-align: center;
        color: #777;
        margin-top: 20px;
    }

    /* Password toggle visibility icon */
    .input-group {
        position: relative;
    }

    .input-group-append {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
    }

        .input-group-append button {
            background: none;
            border: none;
            cursor: pointer;
            color: #007bff;
        }

    /* Mandatory fields indication */
    .mandatory {
        color: red;
    }

    .error-message {
        color: red;
        font-size: 14px;
        margin-bottom: 15px;
    }

    /* Modal Styling */
    .modal {
        display: none;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.3); /* Light overlay for background */
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 300px;
        text-align: center;
        position: relative;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

        .modal-content .close {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 18px;
            font-weight: bold;
            color: #fff; /* White color for the "X" */
            background-color: #ff0000; /* Red background for contrast */
            border: none;
            border-radius: 50%;
            width: 25px;
            height: 25px;
            line-height: 25px;
            text-align: center;
            cursor: pointer;
        }

            .modal-content .close:hover {
                background-color: #cc0000; /* Slightly darker red on hover */
            }

        .modal-content p {
            font-size: 16px;
            color: #ff0000;
            margin: 20px 0 0;
        }

 </style>

<div class="background-container">
    <!-- Logo -->
    <div class="logo">
        <img src="~/images/Pulse.png" alt="Logo">
    </div>

    <!-- Login Box -->
    <div class="login-container">
        <h2>Login</h2>
        <p>Welcome back! Please login to your account</p>

        <div class="input-group">
            <label for="UserId">User ID<span class="mandatory">*</span></label>
            <input type="text" id="UserId" placeholder="Enter Your User ID" required />
        </div>

        <div class="input-group">
            <label for="password">Password <span class="mandatory">*</span></label>
            <input type="password" id="password" name="password" placeholder="Enter your password" required>
            <div class="input-group-append">
                <button type="button" id="togglePassword">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
        </div>

        <div class="form-options">
            <div class="remember-me">
                <input type="checkbox" name="remember">RememberMe
            </div>
            <a href="#" class="forgot-password">Forgot Password?</a>
        </div>

        <button id="LoginButton" class="btn btn-primary">Login</button>
    </div>

    <!-- Skyline Background -->
    <div class="skyline"></div>
</div>

<script>
    document.getElementById('LoginButton').onclick = function() {
        var userId = document.getElementById('UserId').value;
        var password = document.getElementById('password').value;
        var tenantName = "@Model.TenantName";

        // Validate input
        if (!userId || !password || !tenantName) {
            alert('Please fill in all fields.');
            return;
        }

        $.ajax({
            url: `/api/Login/SignIn`, // API endpoint
            type: 'POST', // HTTP method
            contentType: 'application/json', // Content-Type
            data: JSON.stringify({
                Username: userId,
                Password: password,
                TenantName: tenantName
            }),
            success: function (data) {
                if (data.success) {
                    // Redirect or show success message
                    alert("Login successful!");
                    sessionStorage.setItem('AuthToken', data.token);
                    sessionStorage.setItem('Permissions', JSON.stringify(data.permissions));
                    sessionStorage.setItem('tenantName', tenantName);
                    var decodedToken = jwt_decode(data.token);
                    var tokenExpiry = new Date(decodedToken.exp * 1000); // Token expiry time in milliseconds
                    sessionStorage.setItem('TokenExpiry', tokenExpiry);
                    sessionStorage.setItem(tenantName + "jwtToken", data.token);
                    window.location.href = `/${tenantName}/Finance/Index`; // Redirect to a dashboard or other page
                } else {
                    alert(data.message);
                    $('#errorMessage').html(data.message);
                    $('#errorMessage').show(); // Use jQuery to show the error message
                }
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                alert('An error occurred while logging in.');
            }
        });
    };

    $('#togglePassword').click(function () {
        var passwordField = $('#password');
        var type = passwordField.attr('type') === 'password' ? 'text' : 'password';
        passwordField.attr('type', type);
        var icon = $(this).find('i');
        icon.toggleClass('fa-eye fa-eye-slash');
    });
</script>

