@page
@model QD.ERP.Web.Areas.IMS.Pages.MaterialRequestModel
@using QD.ERP.Web.DAL.Entities
@{
}


@{
    ViewData["Title"] = "Clients";

}

<style>
    .limited-footer .btn-container:not(:has(#ddButtonLayout,#btnPrint,#btnToggleSearch,#btntoggleGroupPanel,#btnRequestEnquiry,#btnAddMaterialRequest)) {
	display: none !important;
    }
    .datagrid {
        height: 600px;
        padding: 18px;
    }

    .toolbar-buttons {
        /* position: fixed; */
        bottom: 20px; /* Distance from bottom */
        left: 20px; /* Distance from left */
        display: flex;
        gap: 10px; /* Space between buttons */
        /* z-index: 9999; /* Make sure it's on top */
        /* background-color: white; /* Optional: background */ */ padding: 10px; /* Optional: inner spacing */
        border-radius: 6px;
        margin-top: 10px;
        /* box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); */
    }

  

</style>
<div class="title">
    <div class="header-container">
        <div id="Material Request" class="no-border-input"></div>
    </div>
</div>
<div class="Container">
<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("InventoryModuleFooter")
    </div>
</div>

<div class="dx-fieldset horizontal-container ">
    @(Html.DevExtreme().DateBox()
        .ID("frmdateBox")
        .Label(new JS("formatMessage('Start Date')"))
        .LabelMode(EditorLabelMode.Outside)
        .InputAttr("aria-label", "Date")
        .Type(DateBoxType.Date)
        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
        .DisplayFormat("dd-MMM-yyyy")
        .TabIndex(2)
        )


    @(Html.DevExtreme().DateBox()
        .ID("todateBox")
        .Label(new JS("formatMessage('End Date')"))
        .LabelMode(EditorLabelMode.Outside)
        .InputAttr("aria-label", "Time")
        .Type(DateBoxType.Date)
        .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)))
        .DisplayFormat("dd-MMM-yyyy")
        .TabIndex(3)
        )
    @(Html.DevExtreme().DropDownButton()
        .ID("ddBtnShowRecords")
        .Text(new JS("formatMessage('Show Records')"))
        .Icon("smalliconslayout")
        .Width(180)
        .ElementAttr("class", "button-alignment-down")
        .TabIndex(4)
        .DropDownOptions(options => options.Width(230))
       @*  .Items(items =>
        {
            items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
            items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
            items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
            items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
            items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
            items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
            items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
            items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
            items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
            items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");

        }) *@
        )
</div>
        <div class="dx-fieldset horizontal-container ">

    @(
         Html.DevExtreme().DataGrid<Qry30101ClientList>()
        .ID("DataGrid")
        .DataSource(ds => ds.Mvc()
        .Controller("ClientLeads")
        .LoadAction("Get"))
        .KeyExpr("ClientCode")
        .ElementAttr("class", "datagrid")
        .ShowBorders(true)
        .ColumnAutoWidth(true)
        .ShowColumnLines(true)
        .ShowRowLines(true)
        .OnContextMenuPreparing("onClientsGridContextMenu")
        .AllowColumnResizing(true) // Enable column resizing
        .ColumnResizingMode(ColumnResizingMode.NextColumn) // Optional: can be "Widget" or "NextColumn"
        .AllowColumnReordering(true) // Optional: allow dragging columns
        .ColumnChooser(chooser => chooser
        .Enabled(true)

        .Mode(GridColumnChooserMode.Select) // You can also use "DragAndDrop"


        )
        .Paging(p => p.Enabled(false))
        .Columns(columns =>
        {
            columns.Add().DataField("Category").Caption(new JS("formatMessage('Material Request/Enquiry')")).Visible(true).GroupIndex(0);
            columns.Add().DataField("ClientCode").Caption(new JS("formatMessage('Request No')")).Visible(true);
            columns.Add().DataField("ClientName").Caption(new JS("formatMessage('Rev.No')")).Visible(true);
            columns.Add().DataField("ContactPerson").Caption(new JS("formatMessage('Requested By')")).Visible(true);
            columns.Add().DataField("ContactMobile1").Caption(new JS("formatMessage('Purchase Request Status')")).Visible(true);
            columns.Add().DataField("ContactPhone1").Caption(new JS("formatMessage('Is Submitted')")).Visible(true);
            columns.Add().DataField("ClientLedgerNo").Caption(new JS("formatMessage('Is Verified')")).Visible(true);
            columns.Add().DataField("ClientLedgerNo").Caption(new JS("formatMessage('Is Approved')")).Visible(true);
            columns.Add().DataField("ClientLedgerNo").Caption(new JS("formatMessage('Is Cancelled')")).Visible(true);

             columns.Add().DataField("ClientLedgerNo").Caption(new JS("formatMessage('No Of Items')")).Visible(true);
             columns.Add().DataField("ClientLedgerNo").Caption(new JS("formatMessage('No Of RFQ Issued')")).Visible(true);
             columns.Add().DataField("ClientLedgerNo").Caption(new JS("formatMessage('No Of Quotations')")).Visible(true);

            // Image columns with cell template
            columns.Add().DataField("DecodedBusinessCard1")
            .Caption(new JS("formatMessage('Business Card 1')"))
            .CellTemplate(new JS(@"
    function(cellElement, cellInfo) {
    if (cellInfo.value) {
    $('<img>')
    .attr('src', cellInfo.value)
    .css({ width: '100px', height: 'auto' })
    .appendTo(cellElement);
    }
    }
    "));

            columns.Add().DataField("DecodedBusinessCard2")
            .Caption(new JS("formatMessage('Business Card 2')"))
            .CellTemplate(new JS(@"
    function(cellElement, cellInfo) {
    if (cellInfo.value) {
    $('<img>')
    .attr('src', cellInfo.value)
    .css({ width: '100px', height: 'auto' })
    .appendTo(cellElement);
    }
    }
    "));
        })

        .Summary(s => s.TotalItems(items =>
        {
            // Count for ClientName column
            items.Add().Column("ClientCode")
            .SummaryType(SummaryType.Count)
            .DisplayFormat(new JS("formatMessage('Total Clients: {0}')"));
        }))

        )

</div>
</div>
<!-- Bottom Toolbar -->


<script>

    $(document).ready(function () {
   

        $(".limited-footer .btn-container").each(function () {

            if (!$(this).find("#ddButtonLayout,#btnPrint,#btnToggleSearch,#btntoggleGroupPanel,#btnRequestEnquiry,#btnAddMaterialRequest").length) {
                $(this).remove();
            }

        });

        // Handle Back button click
        // $(document).on('click', '#btnBack', function () {
        //     window.history.back();
        // });

    });
    function onGridReady(e) {
        const items = e.component.getDataSource().items();
        console.log("Image src: ", "data:image/png;base64," + data.BusinessCard1);

    }
    $(function () {
        $("#ClientLeads").dxTextBox({
            text: formatMessage("Material Request"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });

    function onClientsGridContextMenu(e) {
        if (e.target === "content" && e.row) {
            e.items = [{
                text: "Client Edit",
                onItemClick: function () {
                    let clientCode = e.row.data.ClientCode;
                    let tenantName = window.tenantName || "defaultTenant"; // replace with dynamic tenant logic if needed
                    let url = `/${tenantName}/IMS/ClientLeadMaster?clientCode=${clientCode}`;
                    let title = `Edit Client - ${clientCode}`;
                    openModal(url, title);
                }
            }];
        }
    }




</script>