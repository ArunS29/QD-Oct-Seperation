                        <!-- Requesting Unit -->
                          <td style="display: flex; align-items: end;">
                            @(Html.DevExtreme().TextBox()
                            .ID("RequestingUnit")
                            .Label("Requesting Unit:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))
                                @(Html.DevExtreme().Button()
                                .ID("AddInventoryGroup")
                                .Icon("plus")
                                .Hint("Add Group")
                                .Width(35)
                                .ElementAttr("style","justify-content: center")
