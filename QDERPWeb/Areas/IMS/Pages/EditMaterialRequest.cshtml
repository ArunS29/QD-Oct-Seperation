                    </tr>
                </table>
                </div>
                <div style="width: 100%;">
                    <table style="width: 95%;">
                    <tr>
                        <!-- Bid Closing Date -->
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("BiClosingDate")
                            .Label("Bid Closing Date:")
                            .LabelMode(EditorLabelMode.Outside)
