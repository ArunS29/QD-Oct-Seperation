                                .Width(35)
                                .ElementAttr("style","justify-content: center")
                                )
                            </div>
                        </td>

                        <!-- Verified By -->
                        <td style="width: 33%;">
                            @(Html.DevExtreme().DropDownBox()
                            .ID("VerifiedBy")
                            .Label("Verified By:")
