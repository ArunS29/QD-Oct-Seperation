                        </td>

                        <!-- Set Reminder -->
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("SetReminder")
                            .Label("Set Reminder On:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))
                        </td>
                    </tr>
                    <tr>
                        <!-- Client Project Details -->
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("ClientProjectDetails")
                            .Label("Client Project Details:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("97%"))
                        </td>
                    </tr>
                </table>
                </div>
            </div>
        </text>);
                    item.Add().Text("Signatories").Icon("user").Title("Signatories").Template(@<text>
            <div class="form-container">
                <table style="width: 99%;">
                    <tr>
                        <!-- Prepared By -->
                        <td style="width: 33%;">
                            <div style="display: flex; align-items: end;">
                                @(Html.DevExtreme().DropDownBox()
                                .ID("PreparedBy")
                                .Label("Prepared By:")
                                .LabelMode(EditorLabelMode.Outside)
                                .Width("100%"))
                                @(Html.DevExtreme().Button()
                                .ID("AddPreparedBy")
                                .Icon("plus")
