                            .Width("100%"))
                        </td>
                        <!-- Approved By -->
                        <td style="width: 33%;">
                            @(Html.DevExtreme().DropDownBox()
                            .ID("ApprovedBy")
                            .Label("Approved By:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))
                        </td>
                    </tr>
                </table>
                <br />
                <!-- Checkboxes -->
                <div style="display:grid; gap: 20px;">
                    @(Html.DevExtreme().CheckBox()
                    .ID("PrintInLetterhead")
                    .Text("Print in Letter Head")
                    .Value(true))
                    @(Html.DevExtreme().CheckBox()
                    .ID("ShowCompanySeal")
                    .Text("Show Company Seal")
                    .Value(true))
                    @(Html.DevExtreme().CheckBox()
                    .ID("ShowSignature")
                    .Text("Show Signature")
                    .Value(true))
                </div>
            </div>
        </text>);
                })
            )

    </div>
    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("600px")
        .ShowBorders(true)
        .AllowColumnReordering(true) 
        .AllowColumnResizing(true)
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )
        .Columns(columns =>
        {
            columns.Add().Caption("#").CellTemplate(@<text>
        @(ViewData["rowIndex"] = ((int)(ViewData["rowIndex"] ?? 0)) + 1)
        @ViewData["rowIndex"]
    </text>).Width(30);

            columns.Add().DataField("SubGroup").Caption("SubGroup");
            columns.Add().DataField("ItemCode").Caption("Item Code");
            columns.Add().DataField("Description").Caption("Description");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("UnitRateMethod").Caption("Unit Rate Method");
            columns.Add().DataField("Qty").Caption("Qty");
            columns.Add().DataField("ExpectedPrice").Caption("Expected Price").Format("currency");
            columns.Add().DataField("LineTotal").Caption("Line Total").Format("currency");
        })
        )
</div>
      
<div class="form-container">
    <div class="footer-buttons">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnSave")
            .Text("Save")
            .Icon("check")
            .OnClick("onSaveSupplierMasterClick"))
                </div>
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnSaveClose")
            .Text("Save & Close")
            .Icon("check"))
                </div>
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnDelete")
            .Text("Delete")
            .Icon("trash")) 
                </div>
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnBack")
            .Text("Back")
            .Icon("arrowleft"))
                </div>
            </div>
        </div>
    </div>
</div>