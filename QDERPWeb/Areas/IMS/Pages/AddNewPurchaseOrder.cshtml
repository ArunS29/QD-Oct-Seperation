                    item.Add().Text("Branch / Division").Icon("user").Title("Branch / Division").Template(@<text>
            <div style="display: flex; gap: 15px;padding: 15px;">

                <!-- Branch & Divisions -->
                <div style="padding: 10px; border-radius: 6px; flex: 1;">
                    <div style="margin-bottom: 5px;">Branch & Divisions:</div>

