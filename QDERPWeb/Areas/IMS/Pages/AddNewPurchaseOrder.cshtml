                    .LabelMode(EditorLabelMode.Outside)
                    .Width("100%")
                    )

                    <!-- Exchange Rate -->
                    <div style="display: flex; gap: 10px; margin-top: 10px;">
                        <div style="flex: 2;">
                            @(Html.DevExtreme().NumberBox()
                            .ID("ExchangeRate")
                            .Label("Currency Exchange Rate:")
                            .Value(0)
                            .Min(0.00)
                            .Step(0.01)
                            .ShowSpinButtons(true)
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            )
                        </div>
                    </div>
                </div>

