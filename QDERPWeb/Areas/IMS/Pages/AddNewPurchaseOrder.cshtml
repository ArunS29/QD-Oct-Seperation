}
<style>
    .dx-datagrid-headers {
        border: 1px solid #686868 !important;
        width: 100%; /* Adjust to fit the container */
        overflow-x: auto; /* Enable horizontal scrolling */
        white-space: nowrap; /* Prevent wrapping of headings */
        overflow-y: hidden;
    }

    .dx-datagrid .dx-header-row .dx-datagrid-text-content {
        font-size: 12px !important;
        white-space: nowrap !important; /* Prevent wrapping of text */
        text-align: center !important;
        font-weight: bold;
        color: black;
    }

    .ledgerResult {
        overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
        width: 100%;
    }

    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold;
        font-size: 14px;
        padding: 10px 15px;
    }


        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue;
            color: white !important;
        }

    .dx-tabpanel {
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        margin: 15px;
        width: 99%;
        padding: 5px;
        border-radius: 1px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .select-box {
        width: 20vh;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .left-card, .right-card {
        padding: 10px;
        border-radius: 6px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .layout-container {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-column {
        flex: 1 1 48%;
        display: flex;
        flex-direction: column;
    }

    .field-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.3rem;
    }

    .field-label {
        font-size: 0.95rem;
        font-weight: 500;
        color: #333;
    }

    .field-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-solid {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: #6c757d;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-outline {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: transparent;
        color: #6c757d;
        border: 1px solid #6c757d;
        border-radius: 4px;
        cursor: pointer;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .containers {
        display: flex;
    }

    .dx-card {
        background: var(--background-color);
    }


    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .limited-footer .btn-container:not(:has(#ddButtonLayout,#btnSave,#btnSaveAndClose,#btnPrint,#btnDelete,#btnAddNew,#btnAttach,#btnSubmit,#btnVerify,#btnApprove)) {
        display: none !important
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }

    #goToTopBtn{
    z-index:100;
    }
    </style>
<meta charset="UTF-8">
<div class="title">
    <div class="header-container">
        <div id="PurchaseOrder" class="no-border-title"></div>
    </div>
</div>
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%")
                .Items(item =>
                {
                    item.Add()
                .Title("Purchase Order Details")
                .Icon("folder")
                .Text("Purchase Order Details")
                .Template(@<text>
            <div class="dx-card p-3">
                <table style="table-layout: fixed; width: 100%;">
                    <colgroup>
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                    </colgroup>

                    <!-- Row 1 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("PurchaseOrderNo")
                            .Value("")
                            .Label("Purchase Order No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .ReadOnly(true)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().SelectBox()
                            .ID("RevNo")
                            .Label("Rev. No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("PoDate")
                            .Label("PO Date:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Value(DateTime.Now)
                            .Width("100%"))
                        </td>
                        <td>
                            <div style="display: flex; align-items:end;">
                                @(Html.DevExtreme().SelectBox()
                                .ID("SupplierName")
                                .Label("Supplier Name:")
                                .LabelMode(EditorLabelMode.Outside)
                                .StylingMode(EditorStylingMode.Outlined)
                                .Width("100%")
                                .DataSource(d => d.Mvc()
                                .Controller("PurchaseOrders")
                                .LoadAction("GetClients")
                                )
                                .ValueExpr("ClientCode")      
                                .DisplayExpr("ClientName")
                                .SearchEnabled(true)
                                .OnValueChanged("onSupplierChanged")
                                )

                                <div style="margin-left: 5px;">
                                    @(Html.DevExtreme().Button()
                                    .ID("AddSupplier")
                                    .Icon("plus")
                                    .OnClick("redirecttoClientLeadmaster1")
                                    .Hint("Add Supplier"))
                                </div>
                            </div>
                        </td>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("ClientProjectRef")
                            .Label("Client Project Ref:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierQuotationNo")
                            .Label("Supplier Quotation No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("SupplierQuoteDate")
                            .Label("Supplier Quote Date:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            <div style="display: flex; align-items:end;">
                                @(Html.DevExtreme().TextBox()
                                .ID("AttentionTo")
                                .Label("Attention To:")
                                .LabelMode(EditorLabelMode.Outside)
                                .StylingMode(EditorStylingMode.Outlined)
                                .Width("100%"))
                                <div style="margin-left: 5px;">
                                    @(Html.DevExtreme().Button()
                                    .ID("AddAttentionTo")
                                    .Icon("plus")
                                    .Hint("Add Attention"))
                                </div>
                            </div>
                        </td>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierContactNo")
                            .Label("Supplier Contact No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierEmail")
                            .Label("Supplier Email:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Mode(TextBoxMode.Email)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                    </tr>

                    <!-- Row 3 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("ReferenceNo")
                            .Label("Reference No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            <div style="display: flex; align-items:end;">
                                @(Html.DevExtreme().SelectBox()
                                .ID("Project")
                                .Label("Project:")
                                .LabelMode(EditorLabelMode.Outside)
                                .StylingMode(EditorStylingMode.Outlined)
                                .Width("100%")
                                .DataSource(d => d.Mvc()
                                .Controller("PurchaseOrders")
                                .LoadAction("GetProjects")
                                )
                                .ValueExpr("ProjectId")
                                .DisplayExpr("ProjectDescription")
                                .SearchEnabled(true)
                                )
                                <div style="margin-left: 5px;">
                                    @(Html.DevExtreme().Button()
                                    .ID("AddProject")
                                    .Icon("plus")
                                    .Hint("Add Project"))
                                </div>
                            </div>
                        </td>
                        <td>
                            @(Html.DevExtreme().SelectBox()
                            .ID("SalesPerson")
                            .Label("Sales Person:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%")
                            .DataSource(d => d.Mvc()
                            .Controller("AddNewClientRequest") 
                            .LoadAction("GetSalesPerson")      
                            )
                            .ValueExpr("SalesPersonCode")         
                            .DisplayExpr("SalesPersonName")         
                            .SearchEnabled(true)
                            )

                        </td>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("RFQNo")
                            .Label("RFQ No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().SelectBox()
                            .ID("RequestingUnit")
                            .Label("Requesting Unit:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%")
                            .DataSource(d => d.Mvc()
                            .Controller("PurchaseOrders")      // Replace with your actual controller name
                            .LoadAction("GetRequestingUnits")  // This should match the method name above
                            )
                            .ValueExpr("ProjectSubUnitCode")       // The ID field
                            .DisplayExpr("ProjectSubUnitName")     // The name to show in dropdown
                            .SearchEnabled(true)
                            )

                        </td>
                    </tr>
                </table>
            </div>

        </text>);
                    item.Add().Title("Order Details").Icon("detailslayout").Text("Order Details").Template(@<text>
            <div class="dx-card layout-container">
                <!-- Subject and Po Summary -->
                <div class="form-row">
                    <div class="form-column">
                        <div class="field-header">
                            <label for="Subject" class="field-label">Subject:</label>
                            <div class="field-buttons">
                                <button class="btn-solid" onclick="setDefaultValue('Subject')">Set Default</button>
                                <button class="btn-outline"><i class="fa fa-font"></i></button>
                            </div>
                        </div>
                        @(Html.DevExtreme().TextBox()
                        .ID("Subject")
                        .LabelMode(EditorLabelMode.Hidden)
                        .Width("100%")
                        )
                    </div>
                    <div class="form-column">
                        <div class="field-header">
                            <label for="PoSummary" class="field-label">Po Summary:</label>
                            <div class="field-buttons">
                                <button class="btn-solid" onclick="setDefaultValue('PoSummary')">Set Default</button>
                                <button class="btn-outline"><i class="fa fa-font"></i></button>
                            </div>
                        </div>
                        @(Html.DevExtreme().TextArea()
                        .ID("PoSummary")
                        .Height(80)
                        .LabelMode(EditorLabelMode.Hidden)
                        .Width("100%")
                        )
                    </div>
                </div>

                <!-- Po Introduction and Thanks Notes -->
                <div class="form-row">
                    <div class="form-column">
                        <div class="field-header">
                            <label for="PoIntro" class="field-label">Po Introduction:</label>
                            <div class="field-buttons">
                                <button class="btn-solid" onclick="setDefaultValue('PoIntro')">Set Default</button>
                                <button class="btn-outline"><i class="fa fa-font"></i></button>
                            </div>
                        </div>
                        @(Html.DevExtreme().TextBox()
                        .ID("PoIntro")
                        .LabelMode(EditorLabelMode.Hidden)
                        .Width("100%")
                        )
                    </div>
                    <div class="form-column">
                        <div class="field-header">
                            <label for="Thanks" class="field-label">Thanks Notes:</label>
                            <div class="field-buttons">
                                <button class="btn-solid" onclick="setDefaultValue('Thanks')">Set Default</button>
                                <button class="btn-outline"><i class="fa fa-font"></i></button>
                            </div>
                        </div>
                        @(Html.DevExtreme().TextArea()
                        .ID("Thanks")
                        .Height(80)
                        .LabelMode(EditorLabelMode.Hidden)
                        .Width("100%")
                        )
                    </div>
                </div>
            </div>
       

        </text>);
                    item.Add().Text("Shipping Details").Icon("home").Title("Shipping Details").Template(@<text>
            <div style="display: flex; gap: 15px;  padding: 15px; border-radius: 6px;">

                <!-- Left Card -->
                <div style=" padding: 10px;flex: 1; display: flex; flex-direction: column; gap: 10px;">

                    <!-- Row 1 -->
                    <div style="display: flex; gap: 10px;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().SelectBox()
                            .ID("PaymentTerm")
                            .DataSource(new[] { "Cash", "Net 30", "Net 60" })
                            .Label("Payment Term:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            )
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().SelectBox()
                            .ID("DocumentsRequired")
                            .DataSource(new[] { "Invoice", "Packing List", "Certificate of Origin" })
                            .Label("Documents Required:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            )
                        </div>
                    </div>

                    <!-- Row 2 -->
                    <div style="display: flex; gap: 10px;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().SelectBox()
                            .ID("DeliveryTerm")
                            .DataSource(new[] { "FOB", "CIF", "EXW" })
                            .Label("Delivery Term:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            )
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().SelectBox()
                            .ID("WarrantyPeriod")
                            .DataSource(new[] { "6 Months", "1 Year", "2 Years" })
                            .Label("Warranty Period:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            )
                        </div>
                    </div>

                    <!-- Row 3 -->
                    <div>
                        @(Html.DevExtreme().SelectBox()
                        .ID("DeliveryPeriod")
                        .DataSource(new[] { "7 Days", "14 Days", "30 Days" })
                        .Label("Delivery Period:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                    </div>
                </div>

                <!-- Right Card -->
                <div style="padding: 10px; flex: 1; display: flex; flex-direction: column; gap: 10px;">

                    <!-- PoSummary 1 -->
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <label for="ShippingAddress" style="font-weight: bold;">Shipping Address</label>
                            <div style="display: flex; gap: 5px;">
                                <button class="btn-solid" onclick="setDefaultValue('ShippingAddress')">Set Default</button>
                                <button style="padding: 3px 8px; border: 1px solid #8c8c8c; background-color: transparent; color: #333;">A</button>
                            </div>
                        </div>
                        @(Html.DevExtreme().TextArea()
                        .ID("ShippingAddress")
                        .Height(80)
                        .LabelMode(EditorLabelMode.Hidden)
                        .Width("100%")
                        )
                    </div>

                    <!-- PoSummary 2 -->
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <label for="BillingAddress" style="font-weight: bold;">Billing Address</label>
                            <div style="display: flex; gap: 5px;">
                                <button class="btn-solid" onclick="setDefaultValue('BillingAddress')">Set Default</button>
                                <button style="padding: 3px 8px; border: 1px solid #8c8c8c; background-color: transparent; color: #333;">A</button>
                            </div>
                        </div>
                        @(Html.DevExtreme().TextArea()
                        .ID("BillingAddress")
                        .Height(80)
                        .LabelMode(EditorLabelMode.Hidden)
                        .Width("100%")
                        )
                    </div>
                </div>
            </div>

        </text>);
                    item.Add().Text("Approvals").Icon("user").Title("Approvals").Template(@<text>
