                    item.Add().Text("Branch / Division").Icon("user").Title("Branch / Division").Template(@<text>
            <div style="display: flex; gap: 15px;padding: 15px;">

                <!-- Branch & Divisions -->
                <div style="padding: 10px; border-radius: 6px; flex: 1;">
                    <div style="margin-bottom: 5px;">Branch & Divisions:</div>

                    <!-- Company Branch -->
                    @(Html.DevExtreme().SelectBox()
                    .ID("CompanyName")
                    .Label("Company Branch")
                    .DataSource(d => d.Mvc()
                    .Controller("DeliveryNote")
                    .LoadAction("GetCompanyBranch")
                    )
                    .DisplayExpr("CompanyName")
                    .ValueExpr("CompanyId")
                    .LabelMode(EditorLabelMode.Outside)
                    .Width("95%")
                    )

                    <!-- Type of Request + P.O. Category -->
                    <div style="display: flex; gap: 10px; margin-top: 10px;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().SelectBox()
                            .ID("RequestType")
                            .DataSource(d => d.Mvc()
                            .Controller("PurchaseOrders") // replace with actual name
                            .LoadAction("GetTypeOfRequests")
                            )
                            .ValueExpr("TypeOfRequestID")
                            .DisplayExpr("TypeOfRequest")
                            .Label("Type of Request:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            )

                        </div>
                        <div style="flex: 1; display: flex; align-items: flex-end;">
                            <div style="width: 100%;">
                                @(Html.DevExtreme().SelectBox()
                                .ID("POCategory")
                                .DataSource(d => d.Mvc()
                                .Controller("PurchaseOrders") 
                                .LoadAction("GetPOCategories")
                                )
                                .ValueExpr("POCategoryCode")
                                .DisplayExpr("POCategoryName")
                                .Label("P.O. Category:")
                                .LabelMode(EditorLabelMode.Outside)
                                .Width("100%")
                                )
                            </div>
                            <div style="margin-left: 5px;">
                                @(Html.DevExtreme().Button()
                                .ID("AddAPOCategory")
                                .Icon("plus")
                                .Hint("Add POCategory"))
                            </div>
                        </div>
                    </div>

                    <!-- Inventory Group Master -->
                    <div style="margin-top: 10px;">
                        @(Html.DevExtreme().SelectBox()
                        .ID("InventoryGroup")
                        .DataSource(d => d.Mvc()
                        .Controller("PurchaseOrders") // Replace with your controller name
                        .LoadAction("GetInventoryGroups")
                        )
                        .ValueExpr("InventoryMasterGroupId")
                        .DisplayExpr("InventoryMasterGroup")
                        .Label("Inventory Group Master: *")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )

                    </div>
                </div>

                <!-- Foreign Currency -->
                <div style="padding: 10px; flex: 1;">
                    <div style="margin-bottom: 5px;">Foreign Currency:</div>

                    <!-- Currency -->
                    @(Html.DevExtreme().SelectBox()
                    .ID("CurrencyExchange")
                    .DataSource(d => d.Mvc()
                    .Controller("PurchaseOrders") // Replace with your controller
                    .LoadAction("GetCurrencyList")
                    )
                    .ValueExpr("CurrencyExchangeId")
                    .DisplayExpr("CurrencyName")
                    .Label("Currency")
                    .LabelMode(EditorLabelMode.Outside)
                    .Width("100%")
                    )


                    <!-- Exchange Rate -->
                    <div style="display: flex; gap: 10px; margin-top: 10px;">
                        <div style="flex: 2;">
                            @(Html.DevExtreme().NumberBox()
                            .ID("ExchangeRate")
                            .Label("Currency Exchange Rate:")
                            .Value(0)
                            .Min(0.00)
                            .Step(0.01)
                            .ShowSpinButtons(true)
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            )
                        </div>
                    </div>
                </div>

                <!-- Shipment & Discounts -->
                <div style=" padding: 10px; flex: 1;">
                    <div style="margin-bottom: 5px;">Shipment & Discounts:</div>

                    <!-- Shipments & Handling -->
                    <div style="display: flex; gap: 10px;">
                        <div style="flex: 2;">
                            @(Html.DevExtreme().TextBox()
                            .ID("ShipmentHandling")
                            .Label("")
                            .Placeholder("(+) Shipments & Handling:")
                            .LabelMode(EditorLabelMode.Hidden)
                            .Width("100%")
