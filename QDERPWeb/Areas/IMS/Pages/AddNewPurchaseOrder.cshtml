        function onSupplierChanged(e) {
        const supplierCode = e.value;
        if (!supplierCode) return;

        const selectBoxInstance = $("#SupplierName").dxSelectBox("instance");

        // Set selected value and close the dropdown
        if (selectBoxInstance) {
            selectBoxInstance.option("value", supplierCode);
            selectBoxInstance.close();
        }

        // 🔁 Fetch full supplier contact details from API
        $.ajax({
            url: '/api/RequestforQuotationList/GetSupplierContactDetails',
            type: 'GET',
            data: { supplierCode: supplierCode },
            success: function (data) {
                $('#ClientProjectRef').dxTextBox("instance").option("value", data.ClientProjectRef || "");
                $('#AttentionTo').dxTextBox("instance").option("value", data.ContactName || "");
                $('#SupplierEmail').dxTextBox("instance").option("value", data.ContactEmail || "");
                $('#SupplierContactNo').dxTextBox("instance").option("value", data.ContactMobile || "");
                console.log("Fetched Supplier Details:", data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching supplier details:", error);
            }
        });
