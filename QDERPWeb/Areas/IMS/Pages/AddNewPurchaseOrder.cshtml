       $("#btnSubmit").dxButton({
    onClick: function () {
        const pono = $("#PurchaseOrderNo").dxTextBox("instance").option("value");
        if (!pono) {
            DevExpress.ui.notify(" Please save before submitting.", "warning", 3000);
            return;
        }

        DevExpress.ui.dialog.confirm("Are you sure you want to submit?", "Confirm Submit").done(function (dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: '/api/PurchaseOrders/SubmitPurchaseOrder',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({Pono: pono}),
                    success: function (response) {
                        if (response.success) {
                            DevExpress.ui.notify("Submitted successfully.", "success", 3000);
                        } else {
                            DevExpress.ui.notify(response.message, "warning", 3000);
                        }
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("Failed to submit: " + (xhr.responseText || ""), "error", 3000);
                    }
                });
            }
        });
    }
