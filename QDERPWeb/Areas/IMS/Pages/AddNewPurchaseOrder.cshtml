                                    )
                                </td>

                                <!-- Verified By SelectBox -->
                                <td>
                                    @(Html.DevExtreme().SelectBox()
                                    .ID("verifiedBy2")
                                    .DataSource(new[] { "Verifier 1", "Verifier 2", "Verifier 3" })
                                    .ShowClearButton(true)
                                    .ShowDropDownButton(true)
                                    .Width("100%")
                                    )
                                </td>

                                <!-- Approved By SelectBox -->
                                <td>
                                    @(Html.DevExtreme().SelectBox()
                                    .ID("approvedBy2")
                                    .DataSource(new[] { "Approver 1", "Approver 2", "Approver 3" })
                                    .ShowClearButton(true)
                                    .ShowDropDownButton(true)
                                    .Width("100%")
                                    )
                                </td>
                            </tr>

                            <tr>
                                <!-- Prepared By Checkboxes -->
                                <td>
                                    @(Html.DevExtreme().CheckBox().ID("showSeal2").Value(true).Text("Show Company Seal"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("showSignature2").Value(true).Text("Show Signature"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("printLetterhead2").Value(true).Text("Print in Letter Head"))
                                </td>

                                <!-- Verified By Checkboxes -->
                                <td>
                                    @(Html.DevExtreme().CheckBox().ID("pageBreakBefore2").Text("Page Break before Terms"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("pageBreakAfter2").Text("Page Break after Terms"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("ShowHSCodeinsteadStockCode").Text("Show HS Code instead Stock Code"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("ShowitemPartNumberinsteadStockCode").Text("Show item Part Number instead Stock Code"))
                                </td>

                                <!-- Approved By Checkboxes -->
                                <td>
                                    @(Html.DevExtreme().CheckBox().ID("ShowFullSupplierAcceptance").Text("Show Full Supplier Acceptance"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("ShowSimpleSuppilerAcceptance").Text("Show Simple Suppiler Acceptance (One Line Only)"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("ShowSignatoryPositionOnly").Text("Show Signatory Position Only"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("ShowPaymentTermsShippingDetails").Text("Show Payment Terms & Shipping Details"))
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </text>);
                })
            )

    </div>
    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("600px")
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )
        .Columns(columns =>
        {
            columns.Add().Caption("#").CellTemplate(@<text>
        @(ViewData["rowIndex"] = ((int)(ViewData["rowIndex"] ?? 0)) + 1)
        @ViewData["rowIndex"]
    </text>).Width(100);
            columns.Add().DataField("ItemCode").Caption("Item Code");
            columns.Add().DataField("Description").Caption("Description");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("UnitRateMethod").Caption("Unit Rate Method");
            columns.Add().DataField("Qty").Caption("Qty");
            columns.Add().DataField("UnitPrice").Caption("Unit Price");
            columns.Add().DataField("iremDiscount").Caption("Item Discount");
            columns.Add().DataField("VATDesc").Caption("VAT Desc");
            columns.Add().DataField("VAT").Caption("VAT");
            columns.Add().DataField("Amount").Caption("Amount").Format("currency");
            columns.Add().DataField("MRItemNumber").Caption("MR Item Number");
        })
        .ColumnAutoWidth(true)
        .Width("100%")
        .WordWrapEnabled(true)
        .OnCellClick("function(e) {handleCellClick(e);}")
        .ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.Select))
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(false))
        .Paging(p => p.Enabled(false))
        .Pager(pager => pager.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .ShowRowLines(true)
        )
</div>

