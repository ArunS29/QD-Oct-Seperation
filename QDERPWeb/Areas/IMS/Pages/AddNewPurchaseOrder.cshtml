                                @(Html.DevExtreme().TextBox()
                                .ID("AttentionTo")
                                .Label("Attention To:")
                                .LabelMode(EditorLabelMode.Outside)
                                .StylingMode(EditorStylingMode.Outlined)
                                .Width("100%"))
                                <div style="margin-left: 5px;">
                                    @(Html.DevExtreme().Button()
                                    .ID("AddAttentionTo")
                                    .Icon("plus")
                                    .Hint("Add Attention"))
                                </div>
                            </div>
                        </td>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierContactNo")
                            .Label("Supplier Contact No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SupplierEmail")
                            .Label("Supplier Email:")
