                        </div>
                    </div>

                    <!-- Inventory Group Master -->
                    <div style="margin-top: 10px;">
                        @(Html.DevExtreme().SelectBox()
                        .ID("InventoryGroup")
                        .DataSource(new[] { "Inventory Master Group", "Other Group" })
                        .Value("Inventory Master Group")
                        .Label("Inventory Group Master: *")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                    </div>
                </div>

                <!-- Foreign Currency -->
                <div style="padding: 10px; flex: 1;">
                    <div style="margin-bottom: 5px;">Foreign Currency:</div>

