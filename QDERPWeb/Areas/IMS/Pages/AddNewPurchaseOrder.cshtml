                    </div>

                    <!-- Discount -->
                    <div style="display: flex; gap: 10px; margin-top: 10px;">
                        <div style="flex: 2;">
                            @(Html.DevExtreme().TextBox()
                            .ID("Discount")
                            .Placeholder("(-) Discount")
                            .LabelMode(EditorLabelMode.Hidden)
                            .Width("100%")
                            )
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().SelectBox()
                            .ID("DiscountMethod")
                            .DataSource(new[] { "Flat", "Percentage" })
                            .Label("")
                            .LabelMode(EditorLabelMode.Hidden)
                            .Width("100%")
                            )
                        </div>
                    </div>
                </div>
            </div>


        </text>);
                    item.Add().Text("Signatories").Icon("user").Title("Signatories").Template(@<text>
            <div class="form-container">
                <div class="dx-card p-3">
                    <table class=" table-borderless w-100">
                        <thead>
                            <tr>
                                <th>Prepared By</th>
                                <th>Verified By</th>
                                <th>Approved By</th>
                            </tr>
                        </thead>
                        <tbody>
