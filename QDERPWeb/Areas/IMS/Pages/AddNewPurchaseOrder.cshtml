    function saveField(fieldName, dxId,name) {
    let instance = null;

    try {
        instance = $("#" + dxId).dxTextBox("instance");
    } catch (e) {
        // Not a TextBox, try TextArea next
    }

    if (!instance) {
        try {
            instance = $("#" + dxId).dxTextArea("instance");
        } catch (e) {
            console.error(`Neither dxTextBox nor dxTextArea initialized for: ${dxId}`);
            DevExpress.ui.dialog.alert("Component not initialized: " + dxId, "Error");
            return;
        }
    }
    const value = instance.option("value");

    $.ajax({
        url: "/api/PurchaseOrders/SaveReportAttribute",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({
            reportNo: "IMS-PO-001",
            field: fieldName,
            value: value
        }),
        success: function () {
            DevExpress.ui.notify(`PO ${name} has been set as default.`, "success", 2000);
        },
        error: function (xhr) {
            DevExpress.ui.dialog.alert("Failed to save data", "Error");
            console.error("Save error:", xhr.responseText);
        }
    });
}
   $(function () {
    $.ajax({
        url: "/api/PurchaseOrders/GetReportAttributes?reportNo=IMS-PO-001", // ✅ fixed missing quote
        type: "GET",
        success: function (data) {
            console.log("Loaded:", data);

            $("#Subject").dxTextArea("instance")?.option("value", data.ReportSubject || "");
            $("#PoSummary").dxTextArea("instance")?.option("value", data.ReportSummary || "");
            $("#PoIntro").dxTextArea("instance")?.option("value", data.ReportIntroduction || "");
            $("#Thanks").dxTextArea("instance")?.option("value", data.ReportThanksNote || "");
        },
        error: function (xhr, status, error) {
            console.error("Error loading report data:", error);
        }
    });
});
       
     function onBaseCurrencyInitialized(e) {
              const ddb = e.component;

              setTimeout(() => {
                  const ds = ddb.getDataSource();

                  if (ds) {
                      ds.load().done(function (data) {
                          if (data && data.length > 0) {
                              const firstItemId = data[0].CurrencyExchangeId;
                              ddb.option("value", firstItemId);
                          }
                      });
                  } else {
                      console.warn("DataSource is not available yet.");
                  }
              }, 100);
          }
           function CurrencyClick() {
          let url = `/${tenantName}/VAT/DatabaseMasterModule`; // Example edit page
          let title = "Currency Master";
          openModal(url, title);
      }
        function dataGridInvoiceCurrencyHeadSelectionChanged(e) {
          const selectedRow = e.selectedRowsData[0]; // full object
          const selectedKey = e.selectedRowKeys[0];
          const ddbInstance = $("#ddlGoodsGroup3").dxDropDownBox("instance");

          if (selectedKey) {
              ddbInstance.option("value", selectedKey); // CurrencyId
              if (ddbInstance.option("opened")) {
                  ddbInstance.close();
              }

              // Set CurrencyRate from the selected grid row
              const exchangeRate = selectedRow?.ExchangeRate ?? 1.00;
              $("#currencyexchangerate").dxNumberBox("instance").option("value", exchangeRate);
          }
      }

      function dataGridTaxCurrencyHeadSelectionChanged(e) {
          debugger;
          const selectedKey = e.selectedRowKeys[0];
          const ddbInstance = $("#ddlGoodsGroup4").dxDropDownBox("instance");

          if (selectedKey) {
              ddbInstance.option("value", selectedKey); // BaseCurrencyId
              if (ddbInstance.option("opened")) {
                  ddbInstance.close();
              }
          }
      }

         function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }
</script>
