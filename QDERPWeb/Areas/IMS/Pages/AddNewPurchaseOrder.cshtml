    function savePurchaseOrder() {
        const data = {
            Pono: $("#PurchaseOrderNo").dxTextBox("instance").option("value"),
            Podate: $("#PoDate").dxDateBox("instance").option("value"),
            SupplierCode: $("#SupplierName").dxSelectBox("instance").option("value"),
            SupplierQuoteNo: $("#SupplierQuotationNo").dxTextBox("instance").option("value"),
            SupplierQuoteDate: $("#SupplierQuoteDate").dxDateBox("instance").option("value"),
            Attention: $("#AttentionTo").dxTextBox("instance").option("value"),
            SupplierContactNo: $("#SupplierContactNo").dxTextBox("instance").option("value"),
            SupplierContactEmail: $("#SupplierEmail").dxTextBox("instance").option("value"),
            Rfqno: $("#RFQNo").dxTextBox("instance").option("value"),
            ProjectMasterCode: $("#Project").dxSelectBox("instance").option("value"),
            SalesPersonCode: $("#SalesPerson").dxSelectBox("instance").option("value"),
            ProjectSubUnitCode: $("#RequestingUnit").dxSelectBox("instance").option("value"),
            Subject: $("#Subject").dxTextBox("instance").option("value"),
            PoSummary: $("#PoSummary").dxTextArea("instance").option("value"),
            PoIntro: $("#PoIntro").dxTextBox("instance").option("value"),
            Thanks: $("#Thanks").dxTextArea("instance").option("value"),
            PaymentTerm: $("#PaymentTerm").dxSelectBox("instance").option("value"),
            DocumentsRequired: $("#DocumentsRequired").dxSelectBox("instance").option("value"),
            DeliveryTerm: $("#DeliveryTerm").dxSelectBox("instance").option("value"),
            WarrantyPeriod: $("#WarrantyPeriod").dxSelectBox("instance").option("value"),
            DeliveryPeriod: $("#DeliveryPeriod").dxSelectBox("instance").option("value"),
            ShippingAddress: $("#ShippingAddress").dxTextArea("instance").option("value"),
            BillingAddress: $("#BillingAddress").dxTextArea("instance").option("value"),
            CompanyName: $("#CompanyName").dxSelectBox("instance").option("value"),
            RequestType: $("#RequestType").dxSelectBox("instance").option("value"),
            POCategory: $("#POCategory").dxSelectBox("instance").option("value"),
            InventoryGroup: $("#InventoryGroup").dxSelectBox("instance").option("value"),
            CurrencyExchange: $("#CurrencyExchange").dxSelectBox("instance").option("value"),
            ExchangeRate: $("#ExchangeRate").dxNumberBox("instance").option("value"),
            ShipmentHandling: $("#ShipmentHandling").dxTextBox("instance").option("value"),
            ShipmentHandlingMethod: $("#ShipmentHandlingMethod").dxSelectBox("instance").option("value"),
            Discount: $("#Discount").dxTextBox("instance").option("value"),
            DiscountMethod: $("#DiscountMethod").dxSelectBox("instance").option("value")
        };

        // Save master data first
        $.ajax({
            url: '/api/PurchaseOrders/SavePurchaseOrder',
            type: 'POST',
            data: JSON.stringify(data),
            contentType: 'application/json',
            success: function () {
                // Now get the grid instance and items
                const grid = $("#itemGrid").dxDataGrid("instance");
                const rawItems = grid.getDataSource().items();
                const pono = data.Pono;

                // Add pono to each child item
                const gridItems = rawItems.map(item => {
                    return { ...item, Pono: pono };
                });

                // Save child items
                $.ajax({
                    url: '/api/PurchaseOrders/SaveItem',
                    type: 'POST',
                    data: JSON.stringify(gridItems),
                    contentType: 'application/json',
                    success: function () {
                        DevExpress.ui.notify("Saved successfully", "success", 3000);
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("Failed to save items: " + (xhr.responseText || ""), "error", 3000);
                    }
                });
            },
            error: function (xhr) {
                DevExpress.ui.notify("Failed to save purchase order: " + (xhr.responseText || ""), "error", 3000);
            }
        });
    }

