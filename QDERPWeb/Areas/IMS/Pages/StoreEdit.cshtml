@page
@model QD.ERP.Web.Areas.IMS.Pages.StoreEditModel
@{
}


@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
<style>
    .signatory-form-container {
        padding: 20px;
    }

    .form-row {
        display: flex;
        gap:15px;
        align-items: end;
    }

    .dx-datagrid-save-button,
    .dx-datagrid-cancel-button {
        display: none !important;
    }

    /* Also hide the entire right-aligned toolbar space */
    .dx-toolbar-after {
        display: none !important;
    }

    /* Optionally, remove padding/margin if needed */
    .dx-datagrid-headers .dx-toolbar {
        padding-right: 0 !important;
    }
    .form-row .form-row-btn {
        margin: 2px;
        
        width: 340px;
        padding: 0px;
    }

    .rtl-textbox input {
        text-align: right;
    }
        .form-row input,
        .form-row .dx-textbox,
        .form-row .dx-selectbox {
            flex: 1;
        }

    .dx-fileuploader-input-wrapper .dx-button {
        float: left;
        margin-top: -10px;
    }
    .image-upload-row {
        align-items: center;
        gap: 10px;
    }

    .signature-upload {
        border: 1px solid #ccc;
        background-color: #fff;
    }

    .limited-footer .btn-container:not(:has(#btnUpdate,#btnBack)) {
        display: none !important;
    }
    
    .upload{
        display: block;
        top: 26px;
        position: relative;
        left: 0px;
    }

    .grid{
        padding:20px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: flex-start;
        background-color: var(--background-color);
    }

    .mainContainer {
        margin-top: 1em;
    }

    .imagecontainer {
        background-color: #fff;
        border: 1px solid #90caf9;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .playIcon {
        display: none;
    }
</style>
<div class="signatory-form-container">
    <table style="width: 60%;">
        <tr>
            <td style="vertical-align: top; padding-right: 20px;">
                <!-- ✅ First Row: Store Name + Store Code -->
                <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                            .ID("txtStoreName")
                            .Label(new JS("formatMessage('Type a newStore & Add to the Existing List')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ValidationRules(rules => {
                                rules.AddRequired().Message("Store Name is required");
                            })
                        )
                    </div>
                    <div style="flex: 1;">
                        @(Html.DevExtreme().TextBox()
                            .ID("txtStoreCode")
                            .Label(new JS("formatMessage('Store Code')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ValidationRules(rules => {
                                rules.AddRequired().Message("Store Code is required");
                            })
                        )
                    </div>
                </div>

                <!-- ✅ Second Row: Dropdown + Add Button -->
                <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap;">
                    <div style="flex: 1;">
                        @(Html.DevExtreme().DropDownBox()
                            .ID("ddCostcenter")
                            .Label(new JS("formatMessage('Cost Center Code:(Finance Modules)')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ShowClearButton(true)
                            .OpenOnFieldClick(true)
                            .AcceptCustomValue(false)
                            .DataSource(d => d.WebApi()
                                .Controller("StoreCode")
                                .LoadAction("GetCostCenter")
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("CostAllocationUnitId")
                            )
                            .ValueExpr("CostAllocationUnitId")
                            .DisplayExpr("CostAllocationUnit")
                            .ContentTemplate(@<text>
                                <div id="SignatoryGridContainer"></div>
                                <script>
                                    $(function () {
                                        $("#SignatoryGridContainer").dxDataGrid({
                                            dataSource: DevExpress.data.AspNet.createStore({
                                                key: "CostAllocationUnitId",
                                                loadUrl: "/api/StoreCode/GetCostCenter"
                                            }),
                                            height: 250,
                                            selection: { mode: "single" },
                                            hoverStateEnabled: true,
                                            paging: { pageSize: 10 },
                                            pager: {
                                                showPageSizeSelector: true,
                                                allowedPageSizes: [5, 10, 20]
                                            },
                                            columns: [
                                                { dataField: "CostAllocationUnitId", caption: formatMessage("ID"), width: 250 },
                                                { dataField: "CostAllocationUnit", caption: formatMessage("Name"), width: 250 },
                                                { dataField: "CostAllocationGroup", caption: formatMessage("ID"), width: 250 },
                                                { dataField: "CostAllocationMasterGroup", caption: formatMessage("Name"), width: 250 }
                                            ],
                                            onSelectionChanged: function (e) {
                                                var selected = e.selectedRowsData[0];
                                                if (selected) {
                                                    $("#ddCostcenter").dxDropDownBox("instance").option("value", selected.CostAllocationUnitId);
                                                }
                                            }
                                        });
                                    });
                                </script>
                            </text>)
                        )
                    </div>
                    <div>
                        @(Html.DevExtreme().Button()
                            .ID("btnAddSalesPerson")
                            .Text(new JS("formatMessage('ADD')"))
                            .Icon("plus")
                            .OnClick("function() { addStoreToGrid(); }")
                            .ElementAttr(new { @class = "dx-button-add" })
                        )
                    </div>
                </div>
            </td>
        </tr>
    </table>




<div class="dx-field ledgerResult">
    @(Html.DevExtreme().DataGrid()
            .ID("StoryGrid")
            .KeyExpr("StoreId")
            .RemoteOperations(false)
            .DataSource(d => d.WebApi()
        .Controller("StoreCode")
        .LoadAction("GetStoreData")
            .LoadMode(DataSourceLoadMode.Raw)
            )
        .Editing(editing => editing
        .Mode(GridEditMode.Batch)
        .AllowUpdating(true)
            .AllowDeleting(true)
        )
        .Toolbar(toolbar =>
        {
            toolbar.Items(items => { }); // hide default toolbar
        })
        .OnRowUpdating("onStoryUpdating")                       // Handles saving
            .Columns(columns =>
            {
                columns.Add().DataField("StoreId").Caption(new JS("formatMessage('Store ID')")).Width(300).AllowEditing(false);
                columns.Add().DataField("StoreName").Caption(new JS("formatMessage('Store Name')")).Width(500);
                columns.Add().DataField("CostAllocationUnitId").Caption(new JS("formatMessage('Cost Center for Consumption')")).Width(200)
                 .Lookup(lookup => lookup
                            .DataSource(d => d.WebApi()
                            .Controller("StoreCode")
                            .LoadAction("GetCostCenter")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("CostAllocationUnitId")
                            )
                            .ValueExpr("CostAllocationUnitId")    // This must match your model's field if it's storing the ID
                            .DisplayExpr("CostAllocationUnit")
                            );
                // Add delete button column
                columns.Add()
                .Type(GridCommandColumnType.Buttons)
                .Buttons(buttons =>
                {
                    buttons.Add()
                .Name(GridColumnButtonName.Delete)
                .Icon("trash") // Use a trash icon
                .Hint("Delete Row") // Tooltip
                .OnClick("onDeleteButtonClick");
                });
 
            })
        .Height("65vh")
        .ColumnAutoWidth(true)
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(f => f.Enabled(true))
        .Paging(p => p.Enabled(true))
        .Scrolling(s => s
        .Mode(GridScrollingMode.Virtual)
        .RowRenderingMode(GridRowRenderingMode.Virtual)
        .PreloadEnabled(true)
        .ScrollByContent(true)
        )
        .ShowBorders(true)
        .ShowRowLines(true)
        .Width("100%")
        )


</div>

</div>
<div class="limited-footer">
    @await Html.PartialAsync("InventoryModuleFooter")
</div>
 <script>

    $(document).ready(function () {

          $(".limited-footer .btn-container").each(function () {

              if (!$(this).find("#btnUpdate,#btnBack").length) {

                  $(this).remove();

              }

          });

      });

    $(document).on("click", "#btnBack", function () {
        window.history.back();
    });

      $(function () {
            $("#DatabaseSignatories").dxTextBox({
                text: formatMessage("Database "),
                readOnly: true,
                           

            });
        });

    $(function () {
        $("#TypeStore").dxTextBox({
            text: formatMessage("Stores"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    async function convertToArabic(sourceId, targetId) {
        const sourceBox = $("#" + sourceId).dxTextBox("instance");
        const targetBox = $("#" + targetId).dxTextBox("instance");

        if (!sourceBox || !targetBox) {
            console.error("TextBox not initialized.");
            return;
        }

        const sourceText = sourceBox.option("value");

        if (!sourceText || sourceText.trim() === "") {
            alert("Please enter a value to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(sourceText);
            targetBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    
  
    function addStoreToGrid() {
               var StoreCodevalidator = $("#txtStoreCode").dxValidator("instance");
               var StoreNameValidator = $("#txtStoreName").dxValidator("instance");


             var StoreCodevalidation = StoreCodevalidator.validate();
             var StoreNameValidation = StoreNameValidator.validate();



    // If the branch name is valid, proceed with the AJAX request
    if (StoreCodevalidation.isValid && StoreNameValidation.isValid) {

        const data = {
            StoreId: $("#txtStoreCode").dxTextBox("instance").option("value"),
            StoreName: $("#txtStoreName").dxTextBox("instance").option("value"),
            CostAllocationUnitId: $("#ddCostcenter").dxDropDownBox("instance").option("value")
           
        };

        $.ajax({
            url: '/api/StoreCode/SaveOrUpdateStory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Story saved successfully!", "success", 2000);
                $("#StoryGrid").dxDataGrid("instance").refresh();

                $("#txtStoreCode").dxTextBox("instance").option("value",""),
                $("#txtStoreName").dxTextBox("instance").option("value",""),
                 $("#ddCostcenter").dxDropDownBox("instance").option("value","")

                   $("#txtStoreCode").dxValidator("instance").reset();
                   $("#txtStoreName").dxValidator("instance").reset();
                   
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || "Failed to save.";
                DevExpress.ui.notify(msg, "error", 3000); // ✅ Shows backend message
            }
        });
        } else {
            // If validation fails, show a notification
            DevExpress.ui.notify(formatMessage('Please fill required details!'), "error", 2000);
        }
    }


    $("#btnUpdate").on("click", function () {
        const grid = $("#StoryGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


    function onStoryUpdating(e) {
        
        const data = {
            StoreId: e.oldData.StoreId,
            StoreName: e.newData.StoreName ?? e.oldData.StoreName,
            CostAllocationUnitId: e.newData.CostAllocationUnitId ?? e.oldData.CostAllocationUnitId
          
        };

        e.cancel = true; // prevents grid from doing its own update

        return $.ajax({
            url: '/api/StoreCode/SaveOrUpdateStory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#StoryGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }

          function onDeleteButtonClick(e) {
         e.event.preventDefault(); // prevent default delete

                var grid = $("#StoryGrid").dxDataGrid("instance");
        var key = e.row.data.StoreId; // get the ID of the row

            if (confirm("Are you sure you want to delete this row?")) {
                $.ajax({
                        url: '/api/StoreCode/Delete?key=' + key,
                    type: 'DELETE',
                    success: function () {
                        // Refresh the grid after delete
                        grid.refresh();
                        DevExpress.ui.notify("Deleted successfully", "success", 2000);
                    },
                    error: function () {
                        DevExpress.ui.notify("Delete failed", "error", 2000);
                    }
                });
            }
        }
   


    </script>