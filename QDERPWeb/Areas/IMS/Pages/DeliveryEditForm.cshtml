                console.log("Selected Row SNo: ", selectedSNo);
            }
        });

        // Bind move up
        $("#btnMoveUp").dxButton({
            text: "Move Up",
            onClick: function () {
                moveRow(-1); // up = -1
            }
        });

        // Bind move down
        $("#btnMoveDown").dxButton({
            text: "Move Down",
            onClick: function () {
                moveRow(1); // down = +1
            }
        });
