                            $("#clientPOnumber").dxTextBox("instance").option("value", data.clientPono);
                            $("#ClientPODate").dxDateBox("instance").option("value", data.clientPodate);
                            $("#ClientRefName").dxTextBox("instance").option("value", data.attention);
                            $("#ClientContactNo").dxTextBox("instance").option("value", data.clientContactNo);
                            $("#ClientEmail").dxTextBox("instance").option("value", data.clientContactEmail);
                            $("#ddGetModeOfRequest").dxDropDownBox("instance").option("value", data.StoreCode);
                            $("#ddGetTypeOfRequest").dxDropDownBox("instance").option("value", data.projectId);
                            $("#clientProject").dxTextBox("instance").option("value", data.clientProject);
                            $("#DeliveryNoteRemarks").dxTextArea("instance").option("value", data.deliveryNoteRemarks);
                            $("#Salesman").dxTextBox("instance").option("value", data.salesman);
                            $("#DeliveredBy").dxTextBox("instance").option("value", data.transportedBy);
                            $("#DriverName").dxTextBox("instance").option("value", data.driversName);
                            $("#DriverID").dxTextBox("instance").option("value", data.driversId);
                            $("#VehicleNo").dxTextBox("instance").option("value", data.vehicleNo);
                            $("#CompanyName").dxSelectBox("instance").option("value", data.companyBranch);
                            $("#DeliveryType").dxSelectBox("instance").option("value", data.deliveryType);
                            $("#InventoryGroup").dxSelectBox("instance").option("value", data.inventoryMasterGroupId);
                            $("#SalesOrderNo").dxTextBox("instance").option("value", data.salesOrderNo);
                            $("#QuotationNo").dxTextBox("instance").option("value", data.quotationNo);
                            $("#EnquiryRequestNo").dxTextBox("instance").option("value", data.enquiryRequestNo);
                            $("#Dnsignatory").dxDropDownBox("instance").option("value", data.Dnsignatory);
                            $('#currencyexchangerate').dxNumberBox("instance")?.option("value", data.CurrencyRate);
                            $("#ddlGoodsGroup4").dxDropDownBox("instance").option("value", data.BaseCurrencyId);
                            $("#ddlGoodsGroup3").dxDropDownBox("instance").option("value", data.CurrencyId);

                            // Set item grid data
                            const itemGridInstance = $("#itemGrid").dxDataGrid("instance");
                            itemGridInstance.option("dataSource", data.items);

                            // Approval logic
                                const isApproved = data.IsApproved === true || data.IsApproved === 1;
                                console.log("Is Approved:", isApproved);

                            if (isViewMode || isApproved) {
                                setReadOnlyMode();
                                itemGridInstance.option("editing", {

                                    allowUpdating: false,
                                    allowAdding: false,
                                    allowDeleting: false
                                });

                                DevExpress.ui.notify(
                                    isApproved
                                        ? "This delivery note is approved. You are not allowed to edit it."
                                        : "This delivery note is in view mode. Fields are read-only.",
                                    "info",
                                    4000
                                );
                            } else if (isEditMode) {
                                // Enable grid editing
                                itemGridInstance.option("editing", {
                                        mode: "cell",
                                        allowUpdating: true,
                                    allowAdding: true,
                                    allowDeleting: true
                                });
                            }
                        }
                    })
                    .catch(error => {
                        console.error("Error loading delivery note:", error);
                        alert("Failed to load delivery details.");
                    });
            }, 100);
        }

