        $(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const deliveryNoteNo = urlParams.get("deliveryNoteNo");
        const salesOrderNo = urlParams.get("salesOrderNo");
        const salesOrderChildIds = urlParams.getAll("salesOrderChildId") || [];
        const mode = urlParams.get("mode");

        if (mode === "create" && deliveryNoteNo) {
            $("#deliveryNoteNo").dxTextBox("instance").option("value", deliveryNoteNo);

            if (salesOrderNo) {
                loadFullSalesOrder(salesOrderNo, salesOrderChildIds);
            } else if (salesOrderChildIds.length > 0) {
                $.get(`/api/SalesOrders/GetSalesOrderNoByChildId`, { salesOrderChildId: salesOrderChildIds[0] })
                    .done(function (res) {
                        if (res.success) {
                            loadFullSalesOrder(res.salesOrderNo, salesOrderChildIds);
                        } 
                        else
                        {
                            DevExpress.ui.notify("Sales order not found.", "error", 2000);
                        }
                    })
                    .fail(function () {
                        DevExpress.ui.notify("Error getting sales order number.", "error", 2000);
                    });
            }
        }
    });

    function loadFullSalesOrder(salesOrderNo, filterChildIds = []) {
        $.get(`/api/SalesOrders/GetSalesOrderByNo`, { salesOrderNo })
            .done(function (data) {
                // Bind header fields
                $("#GetProjectDropDown").dxDropDownBox("instance").option("value", data.ClientCode);
                $("#clientPOnumber").dxTextBox("instance").option("value", data.ClientPono);
                $("#ClientPODate").dxDateBox("instance").option("value", data.ClientPodate);
                $("#ClientRefName").dxTextBox("instance").option("value", data.Attention);
                $("#ClientContactNo").dxTextBox("instance").option("value", data.ClientContactNo);
                $("#ClientEmail").dxTextBox("instance").option("value", data.ClientContactEmail);
                $("#clientProject").dxTextBox("instance").option("value", data.Project);
                $("#SalesOrderNo").dxTextBox("instance").option("value", data.SalesOrderNo);
                $("#QuotationNo").dxTextBox("instance").option("value", data.QuoteNo);

                let children = data.SalesOrderChildren || [];

                // ✅ Correctly filter multiple child IDs
                if (filterChildIds.length > 0) {
                    children = children.filter(c => filterChildIds.includes(String(c.SalesOrderChildId)));
                }

                const deliveryItems = children.map((child, index) => ({
                    SNo: index + 1,
                    ItemCode: child.Gscode,
                    StockDescription: child.Gsdescrpition,
                    UnitRateMethod: child.UnitRateMethod,
                    Qty: child.QuotedQuantity,
                    UnitCostPrice: child.CostPrice
                      }));

                $("#itemGrid").dxDataGrid("instance").option("dataSource", deliveryItems);
            })
            .fail(function () {
                DevExpress.ui.notify("Failed to load sales order details.", "error", 2000);
            });
    }
       function receiveModalFieldData(modalData) {
          console.log("📥 Received from modal:", modalData);

          const dataGridInstance = $("#itemGrid").dxDataGrid("instance"); // ✅ add this line

          if (!dataGridInstance) {
              console.error("❌ dataGridInstance is not initialized.");
              return;
          }

          if (!window.currentDescriptionCell || !window.currentDescriptionCell.key) {
              console.error("❌ currentDescriptionCell is missing or invalid.");
              return;
          }

          const rowKey = window.currentDescriptionCell.key;
          console.log("🔑 Editing key:", rowKey);

          const rowIndex = dataGridInstance.getRowIndexByKey(rowKey);

          if (rowIndex === -1) {
              console.warn("⚠️ Row not found in grid for key:", rowKey);
              return;
          }

          // ✅ Set the new values from modal
          dataGridInstance.cellValue(rowIndex, "AddlDescription", modalData.AddlDescription || "");
              dataGridInstance.cellValue(rowIndex, "DeliveryRemarks", modalData.DeliveryRemarks || "");
              dataGridInstance.cellValue(rowIndex, "EmployeeNo", modalData.EmployeeNo || "");
              dataGridInstance.cellValue(rowIndex, "PropertyNo", modalData.PropertyNo || "");
      }

