                        .DataSource(d => d.Mvc()
                        .Controller("DeliveryNote")
                        .LoadAction("GetCompanyBranch")
                        )
                        .DisplayExpr("CompanyName")
                        .ValueExpr("CompanyId")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("95%")
                        )
                    </div>




                    <div class="col-md-4">
                        @(Html.DevExtreme().SelectBox()
                        .ID("DeliveryType")
                        .DataSource(new[] {
                        new { Id = 1, Name = "Issued to Client" } // hardcoded item
                        })
                        .ValueExpr("Id")             // The value that will be posted (1)
                        .DisplayExpr("Name")         // What is shown to user ("Issued to Client")
                        .Value(1)                    // Default selected value
                        .Label("Delivery Type:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        .Disabled(true)              // Make it readonly
                        )
