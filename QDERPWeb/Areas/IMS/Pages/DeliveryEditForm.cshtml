                        item.Add().Text("Branch / Division").Icon("home").Title("Branch / Division").Template(@<text>
            <div class="dx-card p-3">
                <div class="row g-3">
                    <!-- Row 1: Branch / Delivery Type / Inventory Group -->
                    <div class="col-md-4">
                        @(Html.DevExtreme().SelectBox()
                        .ID("CompanyName")
