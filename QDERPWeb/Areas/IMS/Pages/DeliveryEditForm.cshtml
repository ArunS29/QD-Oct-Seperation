                { selector: "#SalesOrderNo", type: "dxTextBox" },
                { selector: "#QuotationNo", type: "dxTextBox" },
                { selector: "#EnquiryRequestNo", type: "dxTextBox" },
                { selector: "#Dnsignatory", type: "dxDropDownBox" }
            ];

            readOnlyFields.forEach(field => {
                const instance = $(field.selector)[field.type]("instance");
