    @(Html.DevExtreme().DataGrid()
            .ID("itemGrid")
            .Height("600px")
            .DataSource(new JS("[]")) // using global JS array
            .KeyExpr("ItemCode")
            .Selection(s => s
            .Mode(SelectionMode.Multiple)
            .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
            )
            .Editing(editing => editing
            .Mode(GridEditMode.Row)
            .AllowAdding(true)
            .AllowUpdating(true)
            .AllowDeleting(true)
            )
