    function moveRow(direction) {
        const grid = $("#B2BdataGrid").dxDataGrid("instance");
        let data = grid.getDataSource().items(); // get flat data

        if (!selectedSNo) {
            DevExpress.ui.notify("Please select a row first.", "warning", 2000);
            return;
        }

        // Find row index
        const rowIndex = data.findIndex(r => r.SNo === selectedSNo);

        if (rowIndex === -1) return;

        const targetIndex = rowIndex + direction;

        // prevent moving out of range
        if (targetIndex < 0 || targetIndex >= data.length) {
            return;
        }

        // swap
        const temp = data[rowIndex];
        data[rowIndex] = data[targetIndex];
        data[targetIndex] = temp;

        // resequence SNo
        data.forEach((row, idx) => {
            row.SNo = idx + 1;
        });

        // rebind
        grid.option("dataSource", data);

        // select moved row
        grid.selectRows([data[targetIndex].SNo]);
        grid.option("focusedRowIndex", targetIndex);
    }
     
