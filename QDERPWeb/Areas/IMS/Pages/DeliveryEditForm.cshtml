                        .Label("Delivery Note No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .ReadOnly(true)
                        .Width("100%")
                        )


                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().DateBox()
                        .ID("deliveryNoteDate")
                        .Value(DateTime.Now)
                        .Label("Delivery Note Date:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-6" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .ID("GetProjectDropDown")
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetClientDetails")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("ClientCode")
                        )
                        .Label(new JS("formatMessage('Client Name:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ValueExpr("ClientCode")
                        .DisplayExpr("ClientName")
                        .ContentTemplate(new TemplateName("GetClientContentTemplate"))
                        .ValueChangeEvent("change")
                        .OnValueChanged("onClientSelected")
                        .Width("100%")
                        )


                        @(Html.DevExtreme().Button()
                        .ID("editClient")
                        .Icon("edit")
                        .Hint("Add Client")
                        .Width(18)
                        .ElementAttr("style", "margin-left: 5px; vertical-align: top;")
                        .OnClick("redirecttoClientLeadmaster")
                        )
                        @(Html.DevExtreme().Button()
                        .ID("AddClient")
                        .Icon("plus")
                        .Hint("Add Client")
                        .Width(18)
                        .ElementAttr("style", "margin-left: 5px; vertical-align: top;")
                        .OnClick("redirecttoClientLeadmaster1")
                        )

                    </div>

                    <!-- Row 2 -->
