                $("#ClientEmail").dxTextBox("instance").option("value", data.ClientContactEmail);
                $("#clientProject").dxTextBox("instance").option("value", data.Project);
                $("#SalesOrderNo").dxTextBox("instance").option("value", data.SalesOrderNo);
                $("#QuotationNo").dxTextBox("instance").option("value", data.QuoteNo);

                let children = data.SalesOrderChildren || [];

                // ✅ Correctly filter multiple child IDs
                if (filterChildIds.length > 0) {
                    children = children.filter(c => filterChildIds.includes(String(c.SalesOrderChildId)));
                }

                const deliveryItems = children.map((child, index) => ({
                    SNo: index + 1,
                    ItemCode: child.Gscode,
                    StockDescription: child.Gsdescrpition,
                    UnitRateMethod: child.UnitRateMethod,
