@page
@model QD.ERP.Web.Areas.IMS.Pages.DeliveryEditFormModel
@{
}

<style>
    

    

    .ledgerResult {
    overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
    width: 100%;
    }

    .dx-tabpanel .dx-tab {
    color: black !important;
    font-weight: bold;
    font-size: 14px;
    padding: 10px 15px;
    }


    .dx-tabpanel .dx-tab.dx-selection {
    background-color: lightblue;
    color: white !important;
    }

    .dx-tabpanel {
    }


    .mainContainer {
    overflow-x: hidden;
    }

    .form-container1 {
        padding: 5px 10px;
    }

    .form-container {
    width: 100%;
    border-radius: 1px;
    }

    .form-row {
    display: flex;
    gap: 10px;
    padding: 10px;
    margin-bottom: 15px;
    width: 100%;
    }


    .form-label {
    color: black;
    padding: 5px;
    font-weight: bold;
    width: 200px;
    text-align: Left;
    display: flex;
    align-items: center;
    gap: 10px;
    }

    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
    }

    .dx-button {
    margin-left: 5px;
    }

    .dx-selectbox {
    width: 100%;
    }

    .footer-buttons .row {
    margin-top: 20px;
    }

    .form-control-with-border {
    border-radius: 4px;
    padding: 8px;
    width: 100%;
    }


    .horizontal-container {
    display: flex;
    gap: 20px;
    justify-content: start;
    align-items: center;
    margin: 15px;
    }

    .button-group {
    align-items: center;
    justify-content: center;
    padding: 8px;
    }

    .form-row.border-outline {
    border: 1px solid gray;
    padding: 10px;
    margin-bottom: 15px;
    border-radius: 8px;
    }

    .select-box {
    width: 20vh;
    }

    .imagecontainer {
    background-color: #e0f7fa;
    border: 1px solid #90caf9;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
    position: relative;
    }

    .imagecontainer img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    }

    .imagecontainer span {
    color: #555;
    font-style: italic;
    position: absolute;
    }

    .layout-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    }

    .form-column {
    flex: 1 1 48%;
    display: flex;
    flex-direction: column;
    }

    .field-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.3rem;
    }

    .field-label {
    font-size: 0.95rem;
    font-weight: 500;
    color: #333;
    }

    .field-buttons {
    display: flex;
    gap: 0.5rem;
    }

    .btn-solid {
    padding: 4px 10px;
    font-size: 0.875rem;
    background-color: #6c757d;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    }

    .btn-outline {
    padding: 4px 10px;
    font-size: 0.875rem;
    background-color: transparent;
    color: #6c757d;
    border: 1px solid #6c757d;
    border-radius: 4px;
    cursor: pointer;
    }

    .flex-row {
    display: flex;
    align-items: end;
    }

    .form-container {
    gap: 20px;
    font-family: Arial, sans-serif;
    width: 100%;
    box-sizing: border-box;
    }

    .form-card1 {
    width: 50%;
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding: 1%;
    }

    .form-row1 {
    display: flex;
    gap: 20px;
    }

    .form-group1 {
    flex: 1;
    display: flex;
    flex-direction: column;
    }

    label {
    margin-bottom: 5px;
    font-weight: bold;
    }

    .containers {
    display: flex;
    }



    .important-height {
    height: 135px !important;
    }

</style>
<meta charset="UTF-8">
<div class="title">
    <div class="header-container">
        <div id="addNewDeliverytoClient" class="no-border-title"></div>
    </div>
</div>
<input id="formId" value="frm60106DeliveryNoteView" type="hidden" />
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                    Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%").Height(210)
                    .Items(item =>
                    {
                        item.Add()
                    .Title("Delivery Note Details")
                    .Icon("folder")
                    .Text("Delivery Note Details")
                    .Template(@<text>
            <div class="p-3">
                <div class="row g-2">

                    <!-- Row 1 -->
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("deliveryNoteNo")
                        .Value("") // leave it blank initially
                        .Label("Delivery Note No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .ReadOnly(true)
                        .Width("100%")
                        )


                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().DateBox()
                        .ID("deliveryNoteDate")
                        .Value(DateTime.Now)
                             .Type(DateBoxType.Date)
                             .DisplayFormat("dd-MMM-yyyy")
                        .Label("Delivery Note Date:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-4" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .ID("GetProjectDropDown")
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetClientDetails")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("ClientCode")
                        )
                        .Label(new JS("formatMessage('Client Name:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ValueExpr("ClientCode")
                        .DisplayExpr("ClientName")
                        .ContentTemplate(new TemplateName("GetClientContentTemplate"))
                        .ValueChangeEvent("change")
                        .OnValueChanged("onClientSelected")
                        .Width("100%")
                        .ValidationRules(rules =>
							{
								rules.AddRequired()
									.Message(new JS("formatMessage('Client Name should be entered')"));
							})
                        .Buttons(buttons => {
                            // Clear Button
                            buttons.Add()
                                .Name("clear");

                            // Add Client Button
                            buttons.Add()
                                .Name("AddDebits")
                                .Location(TextEditorButtonLocation.After)
                                .Widget(w => w.Button()
                                    .Type(ButtonType.Default)
                                    .Icon("plus")
                                    .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                    .OnClick("redirecttoClientLeadmaster1")
                                );

                            // Edit Client Button
                            buttons.Add()
                                .Name("btnEditClient")
                                .Location(TextEditorButtonLocation.After)
                                .Widget(w => w.Button()
                                    .Type(ButtonType.Default)
                                    .Icon("edit")
                                    .ElementAttr(new { @class = "custom-hover-button edit-hover" })
                                    .OnClick("redirecttoClientLeadmaster")
                                );
                                    buttons.Add()
                                    .Name("dropDown");
                        })
                        )

                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientContactNo")
                        .Label("Client Contact No:")
                                                    .InputAttr(new { onkeypress = "return event.charCode >= 48 && event.charCode <= 57", type = "text", maxlength = "15" })
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>

                    <!-- Row 2 -->
                    <div class="col-md-3" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .Label("Sales Person / Store Incharge :")
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetSalesPerson")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("TypeOfRequestId")
                        )
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("ddGetSalesPerson")
                        .Width(900)
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("SalesPersonCode")
                        .DisplayExpr("SalesPersonName")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetSalesPersonContentTemplate"))
                        .Buttons(buttons =>
                        {
                            buttons.Add()
                        .Name("btnAddSalesperson")
                        .Location(TextEditorButtonLocation.After)
                        .Widget(w => w.Button()
                        .Type(ButtonType.Default)
                        .Icon("plus")
                        .ElementAttr(new { @class = "custom-hover-button add-hover" })
                        .OnClick("redirecttosalespersonmaster"));
                            buttons.Add()
                        .Name("dropDown");
                        }))

                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("clientPOnumber")
                        .Label("Client PO No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().DateBox()
                        .ID("ClientPODate")
                         .Value(DateTime.Now)
                             .Type(DateBoxType.Date)
                             .DisplayFormat("dd-MMM-yyyy")
                        .Label("Client PO Date:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientRefName")
                        .Label("Client Ref. Name / Attention To:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>
                    

                    <!-- Row 3 -->
                    <div class="col-md-3" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .Label("Stock Delivery From Store:")
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetStores")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("StoreId")
                        )
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("ddStockfromStore")
                        .Width(900)
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("StoreId")
                        .DisplayExpr("StoreName")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetModeOfRequestContentTemplate"))
                        .Buttons(buttons => {
                            buttons.Add()
                                .Name("clear");
                            buttons.Add()
                                .Name("AddModeReq")
                                .Location(TextEditorButtonLocation.After)
                                .Widget(w => w.Button()
                                    .Type(ButtonType.Default)
                                    .Icon("plus")
                                    .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                    .OnClick("AddModeReq")
                                );
                            buttons.Add()
                            .Name("dropDown");
                        })
                        )
                    </div>
                    <div class="col-md-3" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .Label("Issued to Projects:")
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetTypeOfRequest")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("TypeOfRequestId")
                        )
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("ddGetTypeOfRequest")
                        .Width(900)
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("TypeOfRequestId")
                        .DisplayExpr("TypeOfRequest")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        .Disabled(true)
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetTypeOfRequestContentTemplate"))
                        .Buttons(buttons => {
                            buttons.Add()
                                .Name("clear");
                            buttons.Add()
                                .Name("AddTypeReq")
                                .Location(TextEditorButtonLocation.After)
                                .Widget(w => w.Button()
                                    .Type(ButtonType.Default)
                                    .Icon("plus")
                                    .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                    .OnClick("AddTypeReq")
                                );
                            buttons.Add()
                            .Name("dropDown");
                        })
                        )
                    </div>
                    <div class="col-md-3" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientEmail")
                        .Mode(TextBoxMode.Email)
                        .Label("Client Email:")
                        .LabelMode(EditorLabelMode.Floating)
                                                    .ValidationRules(value => value.AddEmail().Message(new JS("formatMessage('Please Enter the Valid Email Address')")))
                        .Width("100%")
                        )
                    </div>

                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("clientProject")
                        .Label(" Client Project:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>
                </div>
            </div>

        </text>);

                        item.Add().Title("Delivery Details").Icon("detailslayout").Text("Delivery Details").Template(@<text>
