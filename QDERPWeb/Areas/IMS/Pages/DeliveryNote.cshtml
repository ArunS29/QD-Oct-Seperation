			function animateTodayVoucherCount(target) {
			let i = 0;
			const el = document.getElementById("todayCount");
			if (!el) return;

			el.classList.remove('bounce');

			const timer = setInterval(() => {
				if (i >= target) {
					el.innerText = target;
					el.classList.add('bounce');
					clearInterval(timer);
				} else {
					el.innerText = i++;
				}
			}, 30);
		}
				function animateTodayVoucherCount(target) {
			let i = 0;
			const el = document.getElementById("valueDisplayes");
