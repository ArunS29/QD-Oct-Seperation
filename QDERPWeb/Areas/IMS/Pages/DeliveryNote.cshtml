				subColumns.AddFor(m => m.InvoiceNo).Caption("Invoice No").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.ClientName).Caption("Client Name").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.ClientPono).Caption("Client Po no").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.ClientProject).Caption("Client Project").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.SalesOrderNo).Caption("SalesOrder No").Alignment(HorizontalAlignment.Center).Visible(true);
			});
			columns.Add().Caption("Delivery To Store").Columns(subColumns =>
			{
				subColumns.AddFor(m => m.StoreName).Caption("Store Name").Alignment(HorizontalAlignment.Center).Visible(true);
			});
		})
		.Height("55vh") // Fixed height for the grid
		.ColumnAutoWidth(true)
		.Width("98%")
		.WordWrapEnabled(true)
