<script>


			 $(function () {
		$("#SalesOrders").dxTextBox({
		text: formatMessage("Sales Orders"),
			readOnly: true,
			onContentReady: function (e) {
			$(e.element).addClass("dx-textbox-heading");
			}
			});
		});

		document.addEventListener("DOMContentLoaded", function () {
		const gridElement = document.getElementById("dataGrid");
		const contextMenu = document.getElementById("contextMenu");

		// Add context menu listener to the grid
		gridElement.addEventListener("contextmenu", function (e) {
			e.preventDefault();

			// Find the data row that was right-clicked
			const rowElement = e.target.closest(".dx-data-row");

			if (rowElement) {
				// Select the clicked row in the DataGrid instance
				const dxGrid = $("#dataGrid").dxDataGrid("instance");
				const rowIndex = parseInt(rowElement.getAttribute("aria-rowindex"), 10) - 1;

				dxGrid.selectRowsByIndexes([rowIndex]);
				contextMenu.dataset.rowIndex = rowIndex;

				// Temporarily show context menu (hidden) to measure dimensions
				contextMenu.style.visibility = "hidden";
				contextMenu.style.display = "block";

				const menuWidth = contextMenu.offsetWidth;
				const menuHeight = contextMenu.offsetHeight;
				const windowWidth = window.innerWidth;
				const windowHeight = window.innerHeight;

				let mouseX = e.clientX;
				let mouseY = e.clientY;

				// Boundary check
				if (mouseX + menuWidth > windowWidth) {
					mouseX = windowWidth - menuWidth - 10;
				}
				if (mouseY + menuHeight > windowHeight) {
					mouseY = windowHeight - menuHeight - 10;
				}

				// Final position and make visible
				contextMenu.style.left = `${mouseX}px`;
				contextMenu.style.top = `${mouseY}px`;
				contextMenu.style.visibility = "visible";
			}
		});

		// Hide context menu when clicking elsewhere
		document.addEventListener("click", function (e) {
			if (!e.target.closest("#contextMenu")) {
				contextMenu.style.display = "none";
			}
		});
	});
			$(function () {
					var now = new Date();
					var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
					var tillmonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
					$("#frmdateBox").dxDateBox("instance").option("value", firstDay);
					$("#todateBox").dxDateBox("instance").option("value", tillmonth);
					ddBtnShowRecords_click('range');
			});
		function ddBtnShowRecords_click(duration) {
			 var frmDateBox = $("#frmdateBox").dxDateBox("instance");
				var toDateBox = $("#todateBox").dxDateBox("instance");
				var frmDate = new Date(frmDateBox.option("value"));
				var toDate = new Date(toDateBox.option("value"));
				var currentDate = new Date();
				switch (duration) {
					case 'today':
						frmDate = toDate = currentDate;
						break;
					case 'yesterday':
						var dateObj = new Date();
						// Subtract one day from current time
						dateObj.setDate(dateObj.getDate() - 1);
						frmDate = toDate = dateObj;
						break;
					case 'week':
						var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

						// Calculate the start of the week (Saturday)
						var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

						// Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
					frmDate = new Date(currentDate.setDate(startOfWeek)); // 7 days before Saturday
						toDate = new Date(currentDate.setDate(startOfWeek + 6));
						break;
					case 'tillmonth':
						// Get the first and last day of the current month
						frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
						toDate = currentDate; //Today
						break;
					case 'fullmonth':
						// Get the first and last day of the current month
						frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
						toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
						break;
					case 'tillyear':
						// Get the first and last day of the current year
						frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
						toDate = currentDate;// Today
						break;
						// Get the first and last day of the current year
						frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
						toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
						break;
					case 'lastyear':
						// Get the first and last day of the last year
						frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
						toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
						break;
					case 'lastmonth':
						// Get the first and last day of the current month
						frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
						toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
						break;
				}
				 // ✅ Update DateBoxes to reflect selection
	frmDateBox.option("value", frmDate);
	toDateBox.option("value", toDate);

					frmDate = frmDate.toISOString().split('T')[0];
		toDate = toDate.toISOString().split('T')[0];

					$.ajax({
			url: '/api/SalesOrders/GetSalesOrders',
			type: 'GET',
			data: {
				fromDate: frmDate,
				toDate: toDate
			},
			success: function (data) {
				console.log("Returned Data: ", data); // debug
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
			},
			error: function (xhr) {
				console.log("AJAX Error", xhr.responseText); // debug
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});



		}

				function onContextMenuPreparing(e) {
				if (e.target === "content" && e.row) {
					e.items = [
						{
							text: "Edit Sales Order",
							icon: "edit",
								onItemClick: function () {
			let salesOrderNo = e.row.data.SalesOrderNo; // Use the correct field from your data
			let tenantName = window.tenantName || "defaultTenant";
			let url = `/${tenantName}/IMS/AddNewSalesOrder?SalesOrderNo=${encodeURIComponent(salesOrderNo)}`;
			window.location.href = url; // <-- Redirects to the page
		}


						},

						{
    text: "Delete Sales Order",
    icon: "trash",
    onItemClick: function () {
        const salesOrderNo = e.row.data.SalesOrderNo;
        DevExpress.ui.dialog.confirm(
            "You are about to delete the Sales Order.\nYou cannot revert the changes.\nAre you sure?",
            "Confirm Delete"
        ).done(function (dialogResult) {
            if (dialogResult) {
                // First, check if deletable
                $.get(`/api/SalesOrders/CanDeleteSalesOrder?salesOrderNo=${encodeURIComponent(salesOrderNo)}`)
                    .done(function (checkRes) {
                        if (checkRes.success) {
                            // Now call delete
                            $.ajax({
                                url: `/api/SalesOrders/DeleteSalesOrder?salesOrderNo=${encodeURIComponent(salesOrderNo)}`,
                                type: "DELETE",
                                success: function (response) {
                                    DevExpress.ui.notify(response.message, "success", 2000);
                                    ddBtnShowRecords_click('range');
                                },
                                error: function (xhr) {
                                    DevExpress.ui.notify("Failed to delete sales order.", "error", 2000);
                                }
                            });
                        } else {
                            DevExpress.ui.notify(checkRes.message, "error", 3000);
                        }
                    })
                    .fail(function (xhr) {
                        DevExpress.ui.notify("Failed to check if sales order can be deleted.", "error", 3000);
                    });
            }
        });
    }
},
							{
		text: "Unlock the Order",
		icon: "unlock",
		onItemClick: function () {
			const salesOrderNo = e.row.data.SalesOrderNo;
					$.ajax({
		url: "/api/SalesOrders/UnlockSalesOrder",
		type: "POST",
		contentType: "application/json",
		data: JSON.stringify({ salesOrderNo: salesOrderNo }), // ✅ Now matches n
		success: function (response) {
			DevExpress.ui.notify(response.message, response.success ? "success" : "warning", 2000);
			if (response.success) {
				ddBtnShowRecords_click('range');
			}
		},
		error: function (xhr) {
			let msg = xhr.responseJSON?.message || "An error occurred while unlocking the sales order.";
			DevExpress.ui.notify(msg, "error", 2000);
			console.error("Unlock failed:", xhr.responseJSON);
		}
	});
		}
	},
						
						{
							text: "Create Proforma Invoice",
							icon: "plus",
							onItemClick: function () {
					const salesOrderNo = e.row.data.SalesOrderNo;
					checkIfApprovedAndProceed(salesOrderNo, function () {
						onCreateRFQ(e.row.data);
					}, "Proforma Invoice");
				}
						},
							{
		text: "Create Partial Delivery for this Sales Order",
		icon: "plus",
		onItemClick: function () {
			const salesOrderNo = e.row.data.SalesOrderNo;
			let tenantName = window.tenantName || "defaultTenant";

			checkIfApprovedAndProceed(salesOrderNo, function () {
				// Step 1: Check if delivery already exists
				$.get("/api/SalesOrders/CheckDeliveryExists", { salesOrderNo })
					.done(function (res) {
						if (res.exists) {
							DevExpress.ui.notify("Sales order delivered successfully. You cannot create anymore.", "warning", 3000);
						} else {
							// Step 2: Get delivery note number
							$.get("/api/DeliveryNote/GetAutoGeneratedDeliveryNoteNumberForTenant", { tenantName, salesOrderNo })
								.done(function (res) {
									if (res.success) {
										const deliveryNoteNo = res.deliveryNoteNo;

										// Step 3: Check if IsUseStoreAvailabilityInDeliveryNote is enabled
										$.get("/api/SalesOrders/GetStoreAvailabilitySetting")
											.done(function (settingRes) {
												if (settingRes.success) {
													if (settingRes.isUseStoreAvailability) {
														// Navigate to Store Stock Availability page with partial=true
														let url = `/${tenantName}/IMS/StoreStockAvalibilitys?salesOrderNo=${encodeURIComponent(salesOrderNo)}&partial=true`;
														window.location.href = url;
													} else {
														// Navigate to regular Delivery Edit form with partial=true
														let url = `/${tenantName}/IMS/DeliveryEditForm?deliveryNoteNo=${encodeURIComponent(deliveryNoteNo)}&salesOrderNo=${encodeURIComponent(salesOrderNo)}&mode=create&partial=true`;
														window.location.href = url;
													}
												} else {
													DevExpress.ui.notify(settingRes.message || "Failed to fetch delivery settings.", "error", 3000);
												}
											})
											.fail(function () {
												DevExpress.ui.notify("Error checking store availability setting.", "error", 3000);
											});
									} else {
										DevExpress.ui.notify(res.message || "Failed to generate Delivery Note No.", "error", 3000);
									}
								})
								.fail(function (xhr) {
									let msg = xhr.responseJSON?.message || "Failed to generate Delivery Note No.";
									DevExpress.ui.notify(msg, "error", 3000);
								});
						}
					})
					.fail(function () {
						DevExpress.ui.notify("Error checking delivery status.", "error", 3000);
					});
			}, "Create Partial Delivery for this sales order");
		}
	},

				{
    text: "Create full Delivery for this sales order",
    icon: "cart",
    onItemClick: function () {
        const salesOrderNo = e.row.data.SalesOrderNo;
        let tenantName = window.tenantName || "defaultTenant";

        checkIfApprovedAndProceed(salesOrderNo, function () {
            // Step 1: Check if delivery already exists
            $.get("/api/SalesOrders/CheckDeliveryExists", { salesOrderNo })
                .done(function (res) {
                    if (res.exists) {
                        DevExpress.ui.notify("Sales order delivered successfully. You cannot create anymore.", "warning", 3000);
                    } else {
                        // Step 1.5: Check if InvoiceStatus is 'Partially Delivered'
                        $.get("/api/SalesOrders/GetInvoiceStatus", { salesOrderNo })
                            .done(function (statusRes) {
									if (statusRes.success && statusRes.OrderStatus === "Partially Delivered") {
                                    DevExpress.ui.notify("Partially delivered. You cannot create full delivery.", "warning", 3000);
                                } else {
                                    // Step 2: Get delivery note number
                                    $.get("/api/DeliveryNote/GetAutoGeneratedDeliveryNoteNumberForTenant", { tenantName, salesOrderNo })
                                        .done(function (res) {
                                            if (res.success) {
                                                const deliveryNoteNo = res.deliveryNoteNo;

                                                // Step 3: Check if IsUseStoreAvailabilityInDeliveryNote is enabled
                                                $.get("/api/SalesOrders/GetStoreAvailabilitySetting")
                                                    .done(function (settingRes) {
                                                        if (settingRes.success) {
                                                            if (settingRes.isUseStoreAvailability) {
                                                                // Navigate to Store Stock Availability page
                                                                let url = `/${tenantName}/IMS/StoreStockAvalibilitys?salesOrderNo=${encodeURIComponent(salesOrderNo)}`;
                                                                window.location.href = url;
                                                            } else {
                                                                // Navigate to regular Delivery Edit form
                                                                let url = `/${tenantName}/IMS/DeliveryEditForm?deliveryNoteNo=${encodeURIComponent(deliveryNoteNo)}&salesOrderNo=${encodeURIComponent(salesOrderNo)}&mode=create`;
                                                                window.location.href = url;
                                                            }
                                                        } else {
                                                            DevExpress.ui.notify(settingRes.message || "Failed to fetch delivery settings.", "error", 3000);
                                                        }
                                                    })
                                                    .fail(function () {
                                                        DevExpress.ui.notify("Error checking store availability setting.", "error", 3000);
                                                    });
                                            } else {
                                                DevExpress.ui.notify(res.message || "Failed to generate Delivery Note No.", "error", 3000);
                                            }
                                        })
                                        .fail(function (xhr) {
                                            let msg = xhr.responseJSON?.message || "Failed to generate Delivery Note No.";
                                            DevExpress.ui.notify(msg, "error", 3000);
                                        });
                                }
                            })
                            .fail(function () {
                                DevExpress.ui.notify("Error checking invoice status.", "error", 3000);
                            });
                    }
                })
                .fail(function () {
                    DevExpress.ui.notify("Error checking delivery status.", "error", 3000);
                });
        }, "Create full Delivery for this sales order");
    }
