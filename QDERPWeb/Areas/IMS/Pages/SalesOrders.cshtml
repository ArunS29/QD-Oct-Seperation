<div class="horizontal-container" style="padding: 5px;">
	@(Html.DevExtreme().DateBox()
					.ID("frmdateBox")
					.Label(new JS("formatMessage('Start Date')"))
					.LabelMode(EditorLabelMode.Floating)
					.InputAttr("aria-label", "Date")
					.Type(DateBoxType.Date)
					.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) // First day of the month
					.DisplayFormat("dd-MMM-yyyy")
					.TabIndex(2)
					)

	@(Html.DevExtreme().DateBox()
					.ID("todateBox")
					.Label(new JS("formatMessage('End Date')"))
					.LabelMode(EditorLabelMode.Floating)
					.InputAttr("aria-label", "Date")
					.Type(DateBoxType.Date)
					.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
					.DisplayFormat("dd-MMM-yyyy")
					.TabIndex(3)
					)


	@(Html.DevExtreme().DropDownButton()
					.ID("ddBtnShowRecords")
					.Text(new JS("formatMessage('Show Records')"))
					.Icon("smalliconslayout")
					.Width(180)
					.ElementAttr("class", "button-alignment-up")
					.TabIndex(4)
					.DropDownOptions(options => options.Width(230))
					.Items(items =>
					{
						items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
						items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
						items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
						items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
						items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
						items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
						items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
						items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
						items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
						items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
					})
					)

</div>
<div class="ledgerResult">
	@(
		Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry60204salesOrderViewMaster>()
					.ID("dataGrid")
					.RemoteOperations(false)
					.DataSource(new JS("[]"))
					.Columns(columns =>
					{
						columns.Add().Caption(new JS("formatMessage('Sales Orders Details')")).Columns(subColumns =>
						{
							subColumns.AddFor(m => m.SalesOrderNo).Caption(new JS("formatMessage('Sales Order No')")).Alignment(HorizontalAlignment.Center).Visible(true);
						    subColumns.AddFor(m => m.SalesOrderDate).Caption(new JS("formatMessage('Sales Order Date')")).Alignment(HorizontalAlignment.Center).Visible(true).Format("dd-MMM-yyyy");
							subColumns.AddFor(m => m.ClientName).Caption(new JS("formatMessage('Client Name')")).Alignment(HorizontalAlignment.Center).Visible(true);
							subColumns.AddFor(m => m.ClientPono).Caption(new JS("formatMessage('Client PO No')")).Alignment(HorizontalAlignment.Center).Visible(true);
							subColumns.AddFor(m => m.Mprno).Caption(new JS("formatMessage('Mpr no')")).Alignment(HorizontalAlignment.Center).Visible(true);
							subColumns.AddFor(m => m.QuoteNo).Caption(new JS("formatMessage('Quotation No')")).Alignment(HorizontalAlignment.Center).Visible(true);
							subColumns.AddFor(m => m.OrderStatus).Caption(new JS("formatMessage('Delivery Status')")).Alignment(HorizontalAlignment.Center).Visible(true);
							subColumns.AddFor(m => m.InvoiceStatus).Caption(new JS("formatMessage('Invoice Status')")).Alignment(HorizontalAlignment.Center).Visible(true);

						});
						columns.Add().Caption(new JS("formatMessage('No Of Items')")).Columns(subColumns =>
						{
				subColumns.AddFor(m => m.NoOfItems).Caption(new JS("formatMessage('No Of Items')")).Alignment(HorizontalAlignment.Center).Visible(true).AllowEditing(true);
						});


						columns.Add().Caption(new JS("formatMessage('Sales Order Amount')")).Columns(subColumns =>
	{
		        subColumns.AddFor(m => m.TotalBeforeDiscount).Caption(new JS("formatMessage('Total Before Discount')")).Alignment(HorizontalAlignment.Center).Visible(true);

				subColumns.AddFor(m => m.Discount).Caption(new JS("formatMessage('Discount')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.TotalAfterDiscount).Caption(new JS("formatMessage('Total After Discount')")).Alignment(HorizontalAlignment.Center).Visible(true);

				subColumns.AddFor(m => m.TotalTaxAmount).Caption(new JS("formatMessage('Total Tax Amount')")).Alignment(HorizontalAlignment.Center).Visible(true);

				subColumns.AddFor(m => m.TotalWithTax).Caption(new JS("formatMessage('Total With Tax')")).Alignment(HorizontalAlignment.Center).Visible(true);

	});
		})
		//.ElementAttr("style", "height: 444px !important;")
		.ColumnAutoWidth(true)
		.Width("98%")
		.Height("60vh")
		.WordWrapEnabled(true)
		.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.Paging(p => p.Enabled(false))
		.Pager(pager => pager.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.Summary(s => s
		.TotalItems(totalItems =>
		{
			totalItems.AddFor(m => m.TotalBeforeDiscount)
			.SummaryType(SummaryType.Sum)
			.DisplayFormat("Total: {0}")
			.Alignment(HorizontalAlignment.Right);

			totalItems.AddFor(m => m.Discount)
			.SummaryType(SummaryType.Sum)
			.DisplayFormat("Total: {0}")
			.Alignment(HorizontalAlignment.Right);

			totalItems.AddFor(m => m.TotalAfterDiscount)
			.SummaryType(SummaryType.Sum)
			.DisplayFormat("Total: {0}")
			.Alignment(HorizontalAlignment.Right);

			totalItems.AddFor(m => m.TotalTaxAmount)
			.SummaryType(SummaryType.Sum)
			.DisplayFormat("Total: {0}")
			.Alignment(HorizontalAlignment.Right);

			totalItems.AddFor(m => m.TotalWithTax)
			.SummaryType(SummaryType.Sum)
			.DisplayFormat("Total: {0}")
			.Alignment(HorizontalAlignment.Right);
		})
		)
		.ShowBorders(true)
		.ShowRowLines(true)


		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.OnContextMenuPreparing("onContextMenuPreparing")
		.StateStoring(stateStoring =>
		{
		stateStoring
		.Enabled(true)
		.Type(StateStoringType.LocalStorage)
		.StorageKey("gridContainerState");
		})
		.OnInitialized("function(e) { loadGridState(); }")
		)

		
	

</div>
