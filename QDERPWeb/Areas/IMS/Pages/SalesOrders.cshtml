 $(function () {
	const dateBox = $("#todateBox").dxDateBox("instance");

	// When focus/typing starts, change to dd-MM-yyyy
	$("#todateBox").on("focusin", function () {
		dateBox.option("displayFormat", "dd-MM-yyyy");
	});

