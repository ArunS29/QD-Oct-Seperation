<script>
		let currentSlideIndex = 0;
		const slides = document.querySelectorAll('.voucher-slide');

		setInterval(() => {
			slides[currentSlideIndex].classList.remove('active');

			currentSlideIndex = (currentSlideIndex + 1) % slides.length;

			slides[currentSlideIndex].classList.add('active');
		}, 2000);
		let currentSlideIndex1 = 0;
		const slides1 = document.querySelectorAll('.voucher-slide1');

		setInterval(() => {
			slides1[currentSlideIndex1].classList.remove('active');

			currentSlideIndex1 = (currentSlideIndex1 + 1) % slides1.length;

			slides1[currentSlideIndex1].classList.add('active');
		}, 2000);







