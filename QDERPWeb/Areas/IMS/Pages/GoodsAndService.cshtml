    if (GsuoM === "" || GsuoM === undefined) {
        GsuoM = null;
    }


        var GspackingUnit = $('#packingUnit').dxNumberBox("instance").option("value");
        var GssellingRate = $('#sellingRate').dxNumberBox("instance").option("value");

