    function onSaveClientMasterClick(e) {
       
        // Collecting form data from client master form
        var Gscode = $('#txtGoodsCode7').dxTextBox("instance").option("value");
      
        var GsgroupId = $('#GetProjectDropDown').dxDropDownBox("instance").option("value");
        var ItemPartNo = $('#txtItemPartNo4').dxTextBox("instance").option("value");
