    function onDeleteButtonClick(e) {
        
        var GoodsCode = $('#txtGoodsCode7').dxTextBox("instance").option("value");

        if (!GoodsCode) {
            DevExpress.ui.notify("Please enter or select a Journal Entry to delete.", "warning", 3000);
            return;
        }

        $.ajax({
            url: "/api/GoodsandServices/DeleteGoodsandService",
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(GoodsCode), // 👈 plain string
            success: function (response) {
                DevExpress.ui.notify(response.message, 'success', 3000);
                setTimeout(function () {
                    location.reload();
                }, 2000);
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                DevExpress.ui.notify(msg, 'error', 3000);
            }
        });
    }

function bindGoodsAndServiceData() {
    const urlParams = new URLSearchParams(window.location.search);
    const gscode = urlParams.get("gscode");
    if (gscode) {
        $.get("/api/GoodsandServices/GetByGscode", { gscode: gscode })
            .done(function (data) {
                      console.log("Received data:", data);
                if (data) {
                    $('#txtGoodsCode7').dxTextBox("instance").option("value", data.Gscode || "");
                    $('#GetProjectDropDown').dxDropDownBox("instance").option("value", data.GsgroupId || "");
                    $('#txtItemPartNo4').dxTextBox("instance").option("value", data.ItemPartNo || "");
                    $('#txtDescription8').dxTextArea("instance").option("value", data.Gsdescrpition || "");
                    $('#txtDescriptionArabic').dxTextArea("instance").option("value", data.GsdescriptionAr || "");
                    $('#GetLedgerNoDropDown').dxDropDownBox("instance").option("value", data.GsuoM || "");
                    $('#packingUnit').dxNumberBox("instance").option("value", data.GspackingUnit || 1);
                    $('#sellingRate').dxNumberBox("instance").option("value", data.GssellingRate || 1);
                    $('#txtCostPrice3').dxNumberBox("instance").option("value", data.CostPrice || 1);
                    $('#txtDetailedDescription').dxTextArea("instance").option("value", data.GsdetailedDesc || "");
                    $('#txtDetailedDescriptionArabic').dxTextArea("instance").option("value", data.GsdetailedDescAr || "");
                }
            })
            .fail(function () {
                DevExpress.ui.notify("Failed to load Goods & Service details.", "error", 2000);
            });
    }
}

