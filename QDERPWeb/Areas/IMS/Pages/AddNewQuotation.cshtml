<input id="formId" value="frm60101QuotationEdit" type="hidden" />
<div class="dx-card-container">
    <div class="dx-card-header minimal-header">
        <div class="card-title-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div id="AddNewQuotation" class="titleText no-border-title">Add New Quotation</div>
    </div>
</div>
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%").Height(220)
                .Items(item =>
                {
                    item.Add()
				.Title(new JS("formatMessage('Quotation Details')"))
                .Icon("folder")
                .Text("Quotation Details")
                .Template(@<text>
            <div class="p-3">
                <div class="row g-2">

                    <!-- Row 1 -->
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("txtQuotationNo")
						.Label(new JS("formatMessage('Quotation No:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ReadOnly(true)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("txtRevisionNo")
						.Label(new JS("formatMessage('Revision #:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
						.Disabled(true)
                        )
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().DateBox()
                        .ID("QuotationDate")
                        .Value(DateTime.Now)
						.DisplayFormat("dd-MMM-yyyy")
						.Label(new JS("formatMessage('Quotation Date:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
						 .OnValueChanged("onQuotationDateChanged") // 🔁 hook event
                        )
                    </div>
              <div class="col-md-6" style="display:flex; align-items:flex-end;">
    @(Html.DevExtreme().DropDownBox()
        .AcceptCustomValue(true)
        .Label(new JS("formatMessage('Client Name:')"))
        .DataSource(d => d.WebApi()
            .Controller("AddNewClientRequest")
            .LoadAction("GetClientDetails")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("ClientCode")
        )
        .LabelMode(EditorLabelMode.Floating)
        .ID("GetProjectDropDown")
        .OpenOnFieldClick(false)
		  .Option("GetProjectDropDown", "GetProject-datagrid")  
        .ValueChangeEvent("input")
        .HoverStateEnabled(true)
        .ValueExpr("ClientCode")
        .DisplayExpr("ClientName")
        .OnInput("dropDownBoxOnInput")
        .OnOpened("onOpened")
        .TabIndex(1)
        .Width("100%")
        .OnKeyDown("onKeyDown")
        //.OnValueChanged("dropDownBoxValueChanged")
        .ContentTemplate(new TemplateName("GetClientContentTemplate"))
        .ValidationRules(rules =>
        {
            rules.AddRequired()
                .Message(new JS("formatMessage('Client Name should be entered')"));
        })
       .Buttons(buttons =>
		{
			// Clear button
			buttons.Add()
				.Name("clear");

			// Drop-down toggle button (must be 'dropDown')
			buttons.Add()
				.Name("dropDown");

			// Add new client button
			buttons.Add()
				.Name("addLedger")
				.Location(TextEditorButtonLocation.After)
				.Widget(w => w.Button()
					.Type(ButtonType.Default)
					.Icon("plus")
					.ElementAttr(new { @class = "custom-hover-button add-hover" })
					.OnClick("AddNewClient")
				);

			// Edit client button
			buttons.Add()
				.Name("editLedger")
				.Location(TextEditorButtonLocation.After)
				.Widget(w => w.Button()
					.Type(ButtonType.Default)
					.Icon("edit")
					.ElementAttr(new { @class = "custom-hover-button edit-hover" })
					.OnClick(@"function() {
						var dropDownBox = $('#GetProjectDropDown').dxDropDownBox('instance');
						var selectedValue = dropDownBox.option('value');
						if (!selectedValue) {
							DevExpress.ui.notify('Please select a client.', 'warning', 2000);
							return;
						}
						var url = '/' + tenantName + '/IMS/ClientLeadMaster?clientCode=' + encodeURIComponent(selectedValue);
						openModal(url, 'Client Master');
					}")
				);
		}))
</div>
                    <!-- Row 2 -->
                    <div class="col-md-2" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                        .Label(new JS("formatMessage('Sales Person:')"))
