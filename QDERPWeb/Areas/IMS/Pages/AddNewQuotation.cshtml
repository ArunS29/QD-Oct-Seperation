 function getDropdownData() {
	return $.ajax({
		url: "/api/VATModule/GetGoodsAndServices",
		method: "GET",
		dataType: "json"
	}).then(function (response) {
		console.log("GsData", response);
 
		// Safely get the array from the API response
		const data = Array.isArray(response.data) ? response.data : [];
 
		return data.map(item => ({
			GSCode: item.GSCode,
			GSDescrpition: item.GSDescrpition,
			GsdescriptionAr: item.GsdescriptionAr,
			ItemPartNo: item.ItemPartNo,
			CostPrice: item.CostPrice,
			GSSellingRate: item.GSSellingRate,
			ReorderQty: item.ReorderQty,
			GsuoM: item.GsuoM
		}));
	}).catch(function (error) {
		console.error("Error fetching dropdown data:", error);
		return [];
	});
}
