	//View e-Invoice

	$(document).ready(function () {

		const urlParams = new URLSearchParams(window.location.search);
		const QuoteNos = urlParams.get('QuoteNo');
		const QuoteNo = QuoteNos ? QuoteNos.split("?")[0] : null;
		
		loadClientDetails(QuoteNo);

		if (QuoteNo) {
			// If Mprno is present, load client details
			loadClientDetails(QuoteNo);
		} else {
			// If QuoteNo is not present and IsCurrent is not "true", generate a Autogenerate request number
			$.ajax({
				url: "/api/AddNewQuotation/GetNewDebitNoteNoApi",
				type: "GET",
				success: function (data) {
					console.log("Success:", data);

					const invoiceBox = $("#txtQuotationNo").dxTextBox("instance");
					if (invoiceBox) {
						invoiceBox.option("value", data || "");
					} else {
						console.warn("Invoice TextBox not initialized.");
					}
				},
				error: function (xhr, status, error) {
					console.error("Error loading Payment Accounts:", error);
					DevExpress.ui.dialog.alert("Failed to load QuoteNo details.", "Error");
				}
			});
		}
	});


	function loadClientDetails(QuoteNo) {
		$.ajax({
			url: `/api/AddNewQuotation/GetQuotationdataByCode?QuoteNo=${encodeURIComponent(QuoteNo)}`,
			type: 'GET',
			dataType: 'json',
			success: function (response) {


				if (response) {
					console.log("res", response);
					$("#btnSave").dxButton("instance").option("text", "Update");
					// Populate DevExtreme controls with the response data

					$('#txtQuotationNo').dxTextBox("instance").option("value", response.QuoteNo);
					$("#txtRevisionNo").dxTextBox("instance").option("value", response.RevisionNo);
					$("#QuotationDate").dxDateBox("instance").option("value", response.QuoteDate);
					$('#GetProjectDropDown').dxDropDownBox("instance").option("value", response.ClientCode);
					$('#ddGetSalesPerson').dxDropDownBox("instance").option("value", response.SalesPersonCode);

					$('#MprNumber').dxTextBox("instance").option("value", response.MPRNo);
					$('#ClientRefName').dxTextBox("instance").option("value", response.Attention);
					$('#ClientEmail').dxTextBox("instance").option("value", response.ClientContactEmail);
					$('#ClientContactNo').dxTextBox("instance").option("value", response.ClientContactNo);
					$('#ddGetModeOfRequest').dxDropDownBox("instance").option("value", response.ModeOfRequest);
					$("#ddGetTypeOfRequest").dxDropDownBox("instance").option("value", response.TypeOfRequest);
					$('#GetProjectDataDropDown').dxDropDownBox("instance").option("value", response.ProjectMasterCode);
					$('#ClientProjectRef').dxTextBox("instance").option("value", response.Project);
					$('#Subject').dxTextBox("instance").option("value", response.SubjectTitle);
					$("#QuoteSummary").dxTextArea("instance").option("value", response.QuotationSummary);
					$('#QuoteIntro').dxTextBox("instance").option("value", response.QuoteIntro);
					$("#QuoteThanks").dxTextArea("instance").option("value", response.QuoteThanksNote);
					$("#ddGetCompany").dxDropDownBox("instance").option("value", response.CompanyBranch);


					$("#ddGetInventoryGroup").dxDropDownBox("instance").option("value", response.InventoryMasterGroupId);
					$("#ReferenceNo").dxTextBox("instance").option("value", response.ClientRefNo);
					$("#SubmittedBy").dxTextBox("instance").option("value", response.QuoteSubmittedBy);

					$("#SubmittedOn").dxDateBox("instance").option("value", response.QuoteSubmittedOn);
					$("#BidClosingDate").dxDateBox("instance").option("value", response.BidClosingDate);

					$("#ddGetQuoteStatus").dxDropDownBox("instance").option("value", response.QuoteStatus);

					$("#txtTransportationScope").dxTextBox("instance").option("value", response.TransportationScope);

					$('#txtAdditions').dxTextBox("instance").option("value", response.AdditionsText);
					$("#QuoteTransport").dxNumberBox("instance").option("value", response.QuoteTransport);
					$("#txtDeductions").dxTextBox("instance").option("value", response.DiscountsText);
					$("#QuoteDiscount").dxNumberBox("instance").option("value", response.QuoteDiscount);

			        $("#ddPreparedby").dxDropDownBox("instance").option("value", response.QuoteSignatory);
					$("#ddVerifiedby").dxDropDownBox("instance").option("value", response.VerifiedSignatory);
					$("#ddApprovedby").dxDropDownBox("instance").option("value", response.ApprovedSignatory);



					// Fetch and initialize the data grid with invoice details
					$.ajax({
						type: "GET",
						url: `/api/AddNewQuotation/GetQuotationChildren?QuoteNo=${encodeURIComponent(QuoteNo)}`,
						dataType: 'json',
						success: function (gridResponse) {
							console.log("Grid", gridResponse);

							const rowData = gridResponse.map((item, index) => ({
								SNo: index + 1,
								...item
							}));

							// Initialize the data grid with the fetched row data
							initializeDataGrid(rowData);
						},
						error: function (xhr, status, error) {
							console.error("Error fetching grid data:", error);
						}
					});

				} else {
					console.warn("No Quotation details found in the response.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching client details:", error);
			}
		});
	}





