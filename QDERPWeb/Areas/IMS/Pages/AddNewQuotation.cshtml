                        .Controller("AddNewClientRequest")
                        .LoadAction("GetSalesPerson")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("TypeOfRequestId")
                        )
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("ddGetSalesPerson")
                        .Width(900)
						  .Option("ddGetSalesPerson", "GetSalesPerson-datagrid")  
