	$(function () {
		// Initialize the TextBox with default text
		$("#LedgerActive").dxTextBox({
			value: "Ledger is Currently Active:",
			readOnly: true
		});

		// Get the instance of the switch
		let switchInstance = $("#schLedgerActive").dxSwitch("instance");

		// Handle value change event
		switchInstance.option("onValueChanged", function (e) {
			let textBoxInstance = $("#LedgerActive").dxTextBox("instance");

			if (e.value) {
				// When switched ON, update text and apply red color
				textBoxInstance.option("value", "Ledger is set as obsolete:");
				$("#LedgerActive .dx-texteditor-input").css("color", "red");
			} else {
				// When switched OFF, update text and reset color
				textBoxInstance.option("value", "Ledger is Currently Active:");
				$("#LedgerActive .dx-texteditor-input").css("color", "black");
			}
		});
	});


