	function receiveModalFieldData(modalData) {
		console.log("📦 Received from modal:", modalData); // ✅ Step 1: Log

		const grid = $("#B2BdataGrid").dxDataGrid("instance");
		if (!window.currentDescriptionCell) {
			console.warn("❌ No currentDescriptionCell found");
			return;
		}

		const key = window.currentDescriptionCell.key;
		console.log("🔑 Editing key:", key); // ✅ Step 2: Confirm key

		const rowIndex = grid.getRowIndexByKey(key);
		if (rowIndex === -1) {
			console.warn("❌ Could not find rowIndex for key", key);
			return;
		}

		let rowData = grid.getDataSource().items()[rowIndex];
		console.log("📝 Before Update rowData:", rowData); // ✅ Step 3

		for (const [field, value] of Object.entries(modalData)) {
			rowData[field] = value;
			grid.cellValue(rowIndex, field, value);
		}

		console.log("✅ After Update rowData:", rowData); // ✅ Step 4
		grid.repaintRows([rowIndex]);
		DevExpress.ui.notify("Details saved", "success", 1500);
	}

