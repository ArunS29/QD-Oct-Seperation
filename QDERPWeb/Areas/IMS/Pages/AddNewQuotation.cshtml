                // ✅ Disable DataGrid after approval
                const gridInstance = $("#B2BdataGrid").dxDataGrid("instance");
                if (gridInstance) {
                    gridInstance.option({
                        editing: {
                            allowUpdating: false,
                            allowAdding: false,
                            allowDeleting: false
                        },
                        selection: {
                            mode: "none"
                        }
                    });
                }
				  disableAllDropDownsAndSelects();
            } else {
                DevExpress.ui.notify("Update failed: Unable to apply changes!", "error", 2000);
                approveBtn.option("disabled", false);
            }
        },
        error: function (xhr) {
            approveBtn.option("disabled", false);
            const msg = xhr.responseJSON?.Message || "An error occurred.";
            DevExpress.ui.notify(msg, "error", 2000);
        }
    });
}




