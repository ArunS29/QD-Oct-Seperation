	function onDeleteButtonClick(e) {
		var QuoteNo = $('#txtQuotationNo').dxTextBox("instance").option("value");

		if (!QuoteNo) {
			DevExpress.ui.notify("Please enter or select a Quotation Details to delete.", "warning", 3000);
			return;
		}

		DevExpress.ui.dialog.confirm(
			"You are about to delete the Quotation from the Database. Click Yes if you would like to continue.",
			"Confirm Deletion"
		).done(function (dialogResult) {
			if (dialogResult) {
				// User clicked 'Yes'
				$.ajax({
					url: `/api/AddNewQuotation/DeleteQuotation?QuoteNo=${encodeURIComponent(QuoteNo)}`,
					type: 'DELETE',
					success: function (response) {
						DevExpress.ui.dialog.alert("Quotation has been successfully removed from the database.", "Deleted").done(function () {
							location.reload(); // Reload after user clicks OK
						});
					},
					error: function (xhr) {
						const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
						DevExpress.ui.notify(msg, 'error', 3000);
					}
				});
			}
			// else: user clicked 'No' - do nothing
		});
	}




