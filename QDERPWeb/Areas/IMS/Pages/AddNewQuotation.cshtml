	function getSalesPersonByUser() {
	$.ajax({
		type: "GET",
		url: "/api/AddNewClientRequest/GetSalesPersonByUser",
		success: function (data) {
			if (data && data.SalesPersonCode) { 
					const salesPersonDropDown = $("#ddGetSalesPerson").dxDropDownBox("instance");
				if (salesPersonDropDown) {
						salesPersonDropDown.option("value", data.SalesPersonCode);
				}
			}
		},
		error: function (xhr) {
			console.log("SalesPerson fetch failed:", xhr.responseText);
		}
	});
}

function onQuotationDateChanged(e) {
    checkDateLocking();
}

function checkDateLocking() {
    $.ajax({
        url: '/api/AddNewQuotation/IsDateLocked',
        method: 'GET',
        success: function (isLocked) {
            if (isLocked) {
                DevExpress.ui.notify("Quotation entry date is locked for editing.", "warning", 3000);
            }
        },
        error: function () {
            DevExpress.ui.notify("Error checking date lock status.", "error", 3000);
        }
    });
}


