	function loadChildDataAndBindGrid(quoteno) {
		//
    if (!quoteno) {
        console.warn("No Quote number provided.");
        return;
    }

    $.ajax({
        type: "GET",
		url: `/api/AddNewQuotation/GetQuotationChildren?QuoteNo=${encodeURIComponent(quoteno)}`,
               dataType: "json",
        success: function (gridResponse) {
            if (!Array.isArray(gridResponse) || gridResponse.length === 0) {
                console.warn("No child details found in the response.");
                return;
            }

            console.log("Grid Response:", gridResponse);

            const rowData = gridResponse.map((item, index) => ({
                SNo: index + 1,
                ...item
            }));

            // ✅ Bind data to existing B2B grid
            const grid = $("#B2BdataGrid").dxDataGrid("instance");
            if (grid) {
                grid.option("dataSource", rowData);
            } else {
                console.error("B2B DataGrid instance not found.");
            }
        },
        error: function (xhr, status, error) {
            const errorMsg = xhr.responseJSON?.message || xhr.statusText || error;
            DevExpress.ui.notify("Failed to load child data: " + errorMsg, "error", 3000);
            console.error("Error fetching grid data:", errorMsg);
        }
    });
}
