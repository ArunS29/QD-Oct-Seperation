                    </div>

                    <!-- Row 3 -->
                    <div class="col-md-2" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                        .Label(new JS("formatMessage('Mode of Request:')"))
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetModeOfRequest")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("ModeOfRequestId")
                        )
						  .Option("ddGetModeOfRequest", "GetProject-datagrid1")  
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("ddGetModeOfRequest")
                        .Width(900)
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("ModeOfRequestId")
                        .DisplayExpr("ModeOfRequest")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
							.DropDownOptions(d => d.Width(230))
                        .ContentTemplate(new TemplateName("GetModeOfRequestContentTemplate"))
						.Buttons(buttons =>
							{
								 buttons.Add()
								 .Name("AddModeReq")
								 .Location(TextEditorButtonLocation.After)
								 .Widget(w => w.Button()
								 .Type(ButtonType.Default)
								 .Icon("plus")
								 .ElementAttr(new { @class = "custom-hover-button add-hover" })
								 .OnClick("AddModeReq"));
								 buttons.Add()
								 .Name("dropDown");
							}))
                    </div>
                    <div class="col-md-3" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                        .Label(new JS("formatMessage('Type of Request:')"))
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetTypeOfRequest")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("TypeOfRequestId")
                        )
						  .Option("ddGetTypeOfRequest", "GetTypeOfRequest-datagrid")  
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("ddGetTypeOfRequest")
                        .Width(900)
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("TypeOfRequestId")
                        .DisplayExpr("TypeOfRequest")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
						.DropDownOptions(d => d.Width(350))
                        .ContentTemplate(new TemplateName("GetTypeOfRequestContentTemplate"))
						.Buttons(buttons =>
							{
								 buttons.Add()
								 .Name("AddTypeReq")
								 .Location(TextEditorButtonLocation.After)
								 .Widget(w => w.Button()
								 .Type(ButtonType.Default)
								 .Icon("plus")
								 .ElementAttr(new { @class = "custom-hover-button add-hover" })
								 .OnClick("AddTypeReq"));
								 buttons.Add()
								 .Name("dropDown");
							}))
                      
                    </div>

                    <div class="col-md-3">
                        @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                        .Label(new JS("formatMessage('Project:')"))
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
						.LoadAction("GetProject")
                        .LoadMode(DataSourceLoadMode.Raw)
						.Key("ProjectId")
                        )
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("GetProjectDataDropDown")
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
						.ValueExpr("ProjectId")
						.DisplayExpr("ProjectDescription")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
						.DropDownOptions(d => d.Width(350))
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetProjectdataContentTemplate"))
                        )
                    </div>
                    <div class="col-md-4">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientProjectRef")
						.Label(new JS("formatMessage('Client Project (Ref):')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>

                </div>
            </div>

        </text>);

				item.Add().Title(new JS("formatMessage('Quote Text')")).Icon("detailslayout").Text("Quote Text").Template(@<text>
