                        .ContentTemplate(new TemplateName("GetSalesPersonContentTemplate"))
						.Buttons(buttons =>
						{
							 buttons.Add()
							 .Name("btnAddAccount")
							 .Location(TextEditorButtonLocation.After)
							 .Widget(w => w.Button()
							 .Type(ButtonType.Default)
							 .Icon("plus")
							 .ElementAttr(new { @class = "custom-hover-button add-hover" })
							 .OnClick("redirecttosalespersonmaster"));
							 buttons.Add()
							 .Name("dropDown");
						}))
                    
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("MprNumber")
						.Label(new JS("formatMessage('MPR / Enquiry No:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-3" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientRefName")
						.Label(new JS("formatMessage('Client Ref. Name / Attention To:')"))
                        .LabelMode(EditorLabelMode.Floating) 
                        .Width("100%")
						   .Buttons(buttons =>
					   {
						   buttons.Add()
						   .Name("btnClientContact")
						   .Location(TextEditorButtonLocation.After)
						   .Widget(w => w.Button()
						   .Type(ButtonType.Default)
						   .Icon("plus")
						   .ElementAttr(new { @class = "custom-hover-button add-hover" })
						.OnClick("onClientContactClick"));
					   }))
                    </div>
                    <div class="col-md-2">
