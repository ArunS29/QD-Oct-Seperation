    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("600px")
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )
        .Columns(columns =>
        {
            columns.Add().Caption("#").CellTemplate(@<text>
        @(ViewData["rowIndex"] = ((int)(ViewData["rowIndex"] ?? 0)) + 1)
        @ViewData["rowIndex"]
    </text>).Width(100);
            columns.Add().DataField("ItemCode").Caption("Item Code");
            columns.Add().DataField("Description").Caption("Description");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("UnitRateMethod").Caption("Unit Rate Method");
            columns.Add().DataField("Qty").Caption("Qty");
            columns.Add().DataField("UnitCostPrice").Caption("Unit Cost Price").Format("currency");
            columns.Add().DataField("...").Caption("...").Format("currency");
            columns.Add().DataField("UnitPrice").Caption("Unit Price");
            columns.Add().DataField("QuotedDiscount").Caption("Quoted Discount");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("VATDesc").Caption("VAT Desc");
            columns.Add().DataField("VAT").Caption("VAT");
            columns.Add().DataField("Total").Caption("Total");
            columns.Add().DataField("TotalCost").Caption("Total Cost");
            columns.Add().DataField("ProfitOrLose").Caption("Profit Or Lose");
        })
        .ColumnAutoWidth(true)
        .Width("100%")
        .WordWrapEnabled(true)
        .OnCellClick("function(e) {handleCellClick(e);}")
        .ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.Select))
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(false))
        .Paging(p => p.Enabled(false))
        .Pager(pager => pager.Visible(false))
        .Grouping(grouping => grouping.AutoExpandAll(true))
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)
        .ShowRowLines(true)
        )
</div>

