							                           .AcceptCustomValue(true) *@
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("SalesPersonCode")
                        .DisplayExpr("SalesPersonName")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetSalesPersonContentTemplate"))
					
                        )
                        @(Html.DevExtreme().Button()
                        .ID("btnAddSalesperson")
                        .Icon("plus")
                        .ElementAttr("class", "button-alignment-down button-group")
                        .OnClick("redirecttosalespersonmaster")
                        )

                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("MprNumber")
						.Label(new JS("formatMessage('MPR / Enquiry No:')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientRefName")
						.Label(new JS("formatMessage('Client Ref. Name / Attention To:')"))
                        .LabelMode(EditorLabelMode.Outside) 
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientEmail")
                        .Mode(TextBoxMode.Email)
						.Label(new JS("formatMessage('Client Email:')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientContactNo")
						.Label(new JS("formatMessage('Client Contact No:')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                    </div>

                    <!-- Row 3 -->
                    <div class="col-md-2" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Mode of Request:')"))
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetModeOfRequest")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("ModeOfRequestId")
                        )
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddGetModeOfRequest")
                        .Width(900)
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("ModeOfRequestId")
                        .DisplayExpr("ModeOfRequest")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetModeOfRequestContentTemplate"))
                        )
                        @(Html.DevExtreme().Button()
                        .ID("AddModeReq")
                        .Icon("plus")
                        .Hint("Add Description")
                        .Width(40)
                        .ElementAttr("style", "margin-top:18px;")
                        .OnClick("AddModeReq")
                        )
                    </div>
                    <div class="col-md-3" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Type of Request:')"))
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
                        .LoadAction("GetTypeOfRequest")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("TypeOfRequestId")
                        )
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("ddGetTypeOfRequest")
                        .Width(900)
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
                        .ValueExpr("TypeOfRequestId")
                        .DisplayExpr("TypeOfRequest")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetTypeOfRequestContentTemplate"))
                        )
                        @(Html.DevExtreme().Button()
                        .ID("AddTypeReq")
                        .Icon("plus")
                        .Hint("Add Description")
                        .Width(40)
                        .ElementAttr("style", "margin-top:18px;")
                        .OnClick("AddTypeReq")
                        )
                    </div>

                    <div class="col-md-3">
                        @(Html.DevExtreme().DropDownBox()
                        .Label(new JS("formatMessage('Project:')"))
                        .DataSource(d => d.WebApi()
                        .Controller("AddNewClientRequest")
						.LoadAction("GetProject")
                        .LoadMode(DataSourceLoadMode.Raw)
						.Key("ProjectId")
                        )
                        .LabelMode(EditorLabelMode.Outside)
                        .ID("GetProjectDataDropDown")
                        .OpenOnFieldClick(false)//
                        .ValueChangeEvent("input")
                        .HoverStateEnabled(true)
						.ValueExpr("ProjectId")
						.DisplayExpr("ProjectDescription")
                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                        .TabIndex(1)
                        .Width("100%")
                        .OnKeyDown("onKeyDown")
                        //.OnValueChanged("dropDownBoxValueChanged")
                        .ContentTemplate(new TemplateName("GetProjectdataContentTemplate"))
                        )
                    </div>
                    <div class="col-md-4">
                        @(Html.DevExtreme().TextBox()
                        .ID("ClientProjectRef")
						.Label(new JS("formatMessage('Client Project (Ref):')"))
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                    </div>

                </div>
            </div>

        </text>);

						item.Add().Title(new JS("formatMessage('Quote Text')")).Icon("detailslayout").Text("Quote Text").Template(@<text>
