@page
@model QD.ERP.Web.Areas.IMS.Pages.InventoryDocumentModel
@using DevExtreme.AspNet.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<style>
    /* Container for the entire page */
    .page-container {
        max-width: 1200px;
        margin: 20px auto;
        padding: 20px;
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgb(0 0 0 / 0.1);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Title heading */
    .title {
        font-size: 24px;
        font-weight: 700;
        color: #2d5799;
        margin-bottom: 25px;
        text-align: center;
    }

    /* Form container with two columns */
    .form-wrapper {
        display: flex;
        gap: 30px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .left-column {
        flex: 2;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .right-column {
        flex: 1;
        min-width: 250px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 20px;
        text-align: center;
    }

    /* Align elements inside left column rows */
    .form-row {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

        .form-row > div {
            flex: 1;
            min-width: 140px;
        }

    /* Align document type and add button in one line */
    .doc-type-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        flex-wrap: nowrap;
    }

    /* Align bottom buttons */
    .bottom-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    /* Buttons group on the right bottom */
    .right-buttons {
        display: flex;
        gap: 15px;
    }

    /* Notification info text */
    .notification-text {
        font-size: 14px;
        color: #666;
        text-align: right;
        margin-top: 5px;
    }

    /* DataGrid section */
    .grid-section {
        margin-top: 30px;
    }
</style>


<div class="page-container">

    <div class="title">Inventory Document</div>
    <script>
        window.getDocumentTypes = function() {
            return $.getJSON("/api/StockInventory/GetDocumentTypes")
                .fail(function(jqXHR, textStatus, errorThrown) {
                    console.error("Failed to load document types:", textStatus, errorThrown);
                });
        };
    </script>

    <!-- Form Section -->
    <div class="form-wrapper">

        <!-- Left Column -->
        <div class="left-column">
            <div class="form-row">
                <div>
                    @(Html.DevExtreme().TextBox()
                        .ID("DocumentNo")
                        .Label("Document No:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        .ReadOnly(true)
                        )
                </div>

                <div class="doc-type-row" style="flex: 2;">
                    @(Html.DevExtreme().SelectBox()
                        .ID("DocType")
                        .Label("Type of the Document Attached:")
                        .LabelMode(EditorLabelMode.Outside)
                        .DataSource(new JS("getDocumentTypes"))
                        .ValueExpr("id")
                        .DisplayExpr("text")
                        .SearchEnabled(true)
                        .DropDownOptions(o => o.Width(400))
                        .Placeholder("Select Document Type")
                        .Width("100%")
                        )


                    @(Html.DevExtreme().Button()
                        .ID("btnAdd")
                        .Icon("plus")
                        .Type(ButtonType.Success)
                        .Width(60)
                        .OnClick("onAddDocType")
                        )
                </div>
            </div>

            <div class="form-row">
                <div>
                    @(Html.DevExtreme().TextBox()
                        .ID("ReferenceNo")
                        .Label("Reference No:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                </div>

                <div>
                    @(Html.DevExtreme().TextBox()
                        .ID("Remarks")
                        .Label("Remarks / Notes:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                </div>
            </div>

            <div class="form-row">
                <div>
                    @(Html.DevExtreme().DateBox()
                        .ID("DocumentExpiryDate")
                        .Label("Document Expiry Date:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        )
                </div>

                <div>
                    @(Html.DevExtreme().DateBox()
                        .ID("HijriExpiryDate")
                        .Label("Expiry Date (Hijri):")
                        .LabelMode(EditorLabelMode.Outside)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Width("100%")
                        )
                </div>

                <div>
                    @(Html.DevExtreme().DateBox()
                        .ID("NotificationDate")
                        .Label("Notification Date:")
                        .LabelMode(EditorLabelMode.Outside)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Value(DateTime.Now.AddDays(7)) 
                        .Width("100%")
                        )
                </div>
            </div>

            <div class="notification-text">
                * A Notification will be issued to corresponding user at this date.
            </div>
        </div>

        <!-- Right Column -->
        <div class="right-column">
            <div>
                @(Html.DevExtreme().Button()
                    .Text("Attach a Document")
                    .Icon("fas fa-paperclip")
                    .Type(ButtonType.Normal)
                    .Width("100%")
                    .StylingMode(ButtonStylingMode.Outlined)
                    )
            </div>

            <div>
                @(Html.DevExtreme().Button()
                    .Text("Add")
                    .Icon("fas fa-plus")
                    .Type(ButtonType.Success)
                    .Width("100%")
                    .OnClick("onSaveDocument")
                    )
            </div>
        </div>
    </div>
    <p style="font-size: 15px; margin-left: 300px;">
        * A Notification will be issued to corresponding user at this date.
    </p>
    <!-- Grid Section -->
    <div class="grid-section">
        @(Html.DevExtreme().DataGrid()
            .ID("documentsGrid")
            .Height(600)
            .ShowBorders(true)
            .ColumnAutoWidth(true)
            .DataSource(d => d.Mvc()
            .Controller("StockInventory")
            .LoadAction("GetDocuments")
            )
            .Columns(columns =>
            {
                columns.Add().DataField("DocumentNo").Caption("Doc No").AllowEditing(false);
                columns.Add().DataField("DocumentType").Caption("Document Type");
                columns.Add().DataField("DocumentRefNo").Caption("Reference No");
                columns.Add().DataField("DocumentRemarks").Caption("Remarks");
                columns.Add().DataField("DocumentExpDate").Caption("Expiry On");
                columns.Add().DataField("DocumentExpDateAr").Caption("Expiry (Hijri)");
                columns.Add().DataField("DocumentNotificationDate").Caption("Notify On");
                columns.Add().DataField("DocumentStatus").Caption("Status");
                columns.Add().DataField("DocumentStatusRemarks").Caption("Status Remarks");
            })
            .Paging(p => p.Enabled(false))
            .HeaderFilter(f => f.Visible(false))
            .ShowRowLines(true)
            .Editing(e =>
            {
                e.Mode(GridEditMode.Row);
                e.AllowUpdating(true);
                e.AllowAdding(false);
                e.AllowDeleting(false);
            })
            .OnRowUpdating("onGridRowUpdating")
            )
    </div>

    <!-- Bottom Buttons -->
    <div class="bottom-buttons">
        @(Html.DevExtreme().Button()
            .Text("Add")
            .Icon("fas fa-plus")
            .Type(ButtonType.Success)
            .Width(120)
            .OnClick("onSaveDocument")
            )

        <div class="right-buttons">
            @(Html.DevExtreme().Button()
                .Text("Show All Documents")
                .Type(ButtonType.Normal)
                .Icon("fas fa-folder-open")
                .Width(180)
                )

            @(Html.DevExtreme().Button()
                .Text("Back")
                .Icon("fas fa-arrow-left")
                .Type(ButtonType.Normal)
                .Width(120)
                .OnClick("Goback")
                )
        </div>
    </div>
</div>

<script>
    // Call API to load Document No on page load
    $(function () {
        loadInitialDocumentNo();
    });

    function loadInitialDocumentNo() {
        $.get("/api/StockInventory/GenerateNewDocumentNo", function (data) {
            $("#DocumentNo").dxTextBox("instance").option("value", data);
        });
    }

       


    // Dummy button actions
    function onAddDocType() {
        DevExpress.ui.notify("Add new document type logic here", "info", 2000);
    }

    function onSaveDocument() {
        DevExpress.ui.notify("Save logic not implemented yet", "info", 2000);
    }

    function onGridRowUpdating(e) {
        // Your logic to save updates
    }

    function Goback() {
        window.history.back();
    }
</script>
