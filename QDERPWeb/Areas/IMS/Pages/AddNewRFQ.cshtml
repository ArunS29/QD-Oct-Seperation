@page
@model QD.ERP.Web.Areas.IMS.Pages.AddNewRFQModel
@{
}
<style>
    .dx-datagrid-headers {
        border: 1px solid #686868 !important;
        width: 100%; /* Adjust to fit the container */
        overflow-x: auto; /* Enable horizontal scrolling */
        white-space: nowrap; /* Prevent wrapping of headings */
        overflow-y: hidden;
    }

    .dx-datagrid .dx-header-row .dx-datagrid-text-content {
        font-size: 12px !important;
        white-space: nowrap !important; /* Prevent wrapping of text */
        text-align: center !important;
        font-weight: bold;
        color: black;
    }

    .ledgerResult {
        overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
        width: 100%;
    }
    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold; 
        font-size: 14px;
        padding: 10px 15px; 
    }

       
        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue;
            color: white !important;
        }
    .dx-tabpanel {
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        margin: 15px;
        width: 99%;
        padding: 5px;
        border-radius: 1px; 
    }

    .form-container {
        width: 100%;
        border-radius: 1px; 
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }
 
    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
      
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center; 
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }
    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }
    
    .select-box {
        width: 20vh;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container{
      
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .containers{
        display:flex;
    }

    .dx-card{ 
        background: var(--background-color);
    }
</style>
<meta charset="UTF-8">
<div class="title">
    <div class="header-container">
        <div id="RequestForQuotation" class="no-border-title"></div>
    </div>
</div>
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%")
                .Items(item =>
                {
                    item.Add()
                .Title("RFQ Details")
                .Icon("folder")
                .Text("RFQ Details")
                .Template(@<text>
            <div class="dx-card p-3">
                <!-- Row 1: 3 Columns -->
                <div class="row g-2">
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("RFQNo")
                        .Value("AIC-RFQ-2025-00002")
                        .Label("RFQ No")
                        .LabelMode(EditorLabelMode.Outside)
                        .ReadOnly(true)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().DateBox()
                        .ID("RFQDate")
                        .Value(DateTime.Today)
                        .Label("RFQ Date")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                    </div>
                    <div class="col-md-8" style="  display: flex; align-items: flex-end;">
                        @(Html.DevExtreme().SelectBox()
                        .ID("SupplierName")
                        .DataSource(new[] { "Supplier A", "Supplier B" })
                        .Label("Supplier Name")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("calc(47% - 40px)"))
                        @(Html.DevExtreme().Button()
                        .ID("AddSupplier")
                        .Icon("plus")
                        .Hint("Add Supplier")
                        .Width(35)
                        .ElementAttr("style", "margin-left: 5px;"))
                        <div style="flex: 1; margin-left: 10px;">
                            @(Html.DevExtreme().TextBox()
                            .ID("RequestNo")
                            .Label("Request / Enquiry No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))
                        </div>
                    </div>
                </div>

                <!-- Row 2: 5 Columns -->
                <div class="row g-2 mt-2">
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("ProjectRef")
                        .Label("Project Ref:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>
                    <div class="col-md-3" style="  display: flex; align-items: flex-end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("AttentionTo")
                        .Label("Attention To:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("calc(100% - 40px)"))
                        @(Html.DevExtreme().Button()
                        .ID("AddAttention")
                        .Icon("plus")
                        .Hint("Add Attention")
                        .Width(35)
                        .ElementAttr("style", "margin-left: 5px;"))
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierEmail")
                        .Label("Supplier Email:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Mode(TextBoxMode.Email)
                        .Width("100%"))
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierContact")
                        .Label("Supplier Contact No:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().TextBox()
                        .ID("ExtraField") // Optional if needed
                        .Label("Extra Field:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>
                </div>

                <!-- Row 3: 4 Columns -->
                <div class="row g-2 mt-2">
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierQuoteNo")
                        .Label("Supplier Quote No:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().DateBox()
                        .ID("SupplierQuoteDate")
                        .Label("Supplier Quote Date:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().SelectBox()
                        .ID("SalesPerson")
                        .DataSource(new[] { "Sales A", "Sales B" })
                        .Label("Sales Person:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().SelectBox()
                        .ID("Project")
                        .DataSource(new[] { "Project A", "Project B" })
                        .Label("Project:")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>
                </div>
            </div>

        </text>);

                    item.Add().Title("FRQ Sub Details").Icon("detailslayout").Text("FRQ Sub Details").Template(@<text>
            <div class="d-flex flex-wrap gap-3">
    <!-- Left Card: Subject + Quote Introduction -->
    <div class="dx-card p-3 flex-fill" style="min-width: 300px;">
        <table class=" w-100">
            <tbody>
                <!-- Subject -->
                <tr>
                    <td>
                        @(Html.DevExtreme().TextBox()
                            .ID("Subject")
                            .Value("Quotation for Materials")
                            .Label("RFQ Subject:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                        )
                        <div class="d-flex gap-1 mt-1">
                            <button class="btn btn-secondary btn-sm">Set Default</button>
                            <button class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-font"></i>
                            </button>
                        </div>
                    </td>
                </tr>

                <!-- Quote Introduction -->
                <tr>
                    <td>
                        @(Html.DevExtreme().TextArea()
                            .ID("QuoteIntro")
                            .Value("With reference to your enquiry, please find our competitive Quotation as follows:")
                            .Height(80)
                            .Label("RFQ Remarks:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                        )
                        <div class="d-flex gap-1 mt-1">
                            <button class="btn btn-secondary btn-sm">Set Default</button>
                            <button class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-font"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Right Card: Quote Summary -->
    <div class="dx-card p-3 " style="min-width: 300px;flex: 1 1 auto; ">
        <table class="w-100">
            <tbody>
                <tr>
                    <td>
                        @(Html.DevExtreme().TextArea()
                            .ID("QuoteSummary")
                            .Value("We hope that our offer is in line with your requirements. Please indicate in your purchase order our Quotation Reference and acceptance to the terms & conditions.")
                                    .ElementAttr("style", "height: 160px ! important;")
                            .Label("RFQ Summary:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                        )
                        <div class="d-flex gap-1 mt-1">
                            <button class="btn btn-secondary btn-sm">Set Default</button>
                            <button class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-font"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>



        </text>);
                    item.Add().Text("Signatories").Icon("user").Title("Signatories").Template(@<text>

            <div class="form-container">
                <div class="dx-card p-3">
                    <table class=" table-borderless w-100">
                        <thead>
                            <tr>
                                <th>Siguatory:</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <!-- Prepared By SelectBox -->
                                <td>
                                    @(Html.DevExtreme().SelectBox()
                                    .ID("preparedBy")
                                    .DataSource(new[] { "User 1", "User 2", "User 3" })
                                    .ShowClearButton(true)
                                    .ShowDropDownButton(true)
                                    .Width("40%")
                                    )   
                                </td>
                            <tr style="display: flex;" >
                                <!-- Prepared By Checkboxes -->
                                <td>
                                    @(Html.DevExtreme().CheckBox().ID("showSeal").Value(true).Text("Show Company Seal"))
                                    <br />
                                    @(Html.DevExtreme().CheckBox().ID("showSignature").Value(true).Text("Show Signature"))
                                    <br />
                                </td>
                                <td>@(Html.DevExtreme().CheckBox().ID("printLetterhead").Value(true).Text("Print in Letter Head"))</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </text>);
                    item.Add().Text("Branch / Divisions").Icon("home").Title("Branch / Divisions").Template(@<text>
            <div class="dx-card p-3">
                <div class="row g-2">
                    <!-- Column 1 -->
                                <div>
                                    @(Html.DevExtreme().SelectBox()
                                    .ID("TransportationScope")
                                    .DataSource(new[] { "Scope A", "Scope B" })
                                    .Label("Company Branch / Division")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .Width("50%")
                                    )
                                </div>

                                <div>
                                    @(Html.DevExtreme().SelectBox()
                                    .ID("QuoteValidity")
                                    .DataSource(new[] { "30 Days", "60 Days" })
                                    .Label("Inventory Group Master:*")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .Width("50%")   
                                    )
                                </div>
                        </div>
                    </div>
        </text>);
                })
            )

    </div>
    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("600px")
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )
        .Columns(columns =>
        {
            columns.Add().Caption("#").CellTemplate(@<text>
        @(ViewData["rowIndex"] = ((int)(ViewData["rowIndex"] ?? 0)) + 1)
        @ViewData["rowIndex"]
    </text>).Width(100);
            columns.Add().DataField("ItemCode").Caption("Item Code");
            columns.Add().DataField("Description").Caption("Description");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("UnitRateMethod").Caption("Unit Rate Method");
            columns.Add().DataField("Qty").Caption("Qty");
            columns.Add().DataField("UnitPrice").Caption("Unit Price");
            columns.Add().DataField("Total").Caption("Total");
            columns.Add().DataField("ItemDiscount").Caption("Item Discount");
            columns.Add().DataField("NewTotal").Caption("New Total");
        })
    .ColumnAutoWidth(true)
    .Width("100%")
    .WordWrapEnabled(true)
    .OnCellClick("function(e) {handleCellClick(e);}")
    .ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.Select))
    .AllowColumnReordering(true)
    .AllowColumnResizing(true)
    .ColumnFixing(fixing => fixing.Enabled(true))
    .HeaderFilter(filter => filter.Visible(false))
    .Paging(p => p.Enabled(false))
    .Pager(pager => pager.Visible(false))
    .Grouping(grouping => grouping.AutoExpandAll(true))
    .FilterRow(filterRow => filterRow.Visible(false))
    .GroupPanel(groupPanel => groupPanel.Visible(false))
    .ShowBorders(true)
    .ShowRowLines(true)
    )
</div>
      
<div class="form-container">
    <div class="footer-buttons">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnSave")
            .Text("Save")
            .Icon("check")
            .OnClick("onSaveSupplierMasterClick"))
                </div>
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnSaveClose")
            .Text("Save & Close")
            .Icon("check"))
                </div>
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnDelete")
            .Text("Delete")
            .Icon("trash")) 
                </div>
                <div class="col-md-2">
        @(Html.DevExtreme()
            .Button()
            .ID("btnBack")
            .Text("Back")
            .Icon("arrowleft"))
                </div>
            </div>
        </div>
    </div>
</div>
<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("VATModuleFooter")
    </div>
</div>
