			$(document).ready(function () {
				var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");

				// Attach the 'selectionChanged' event handler
				dataGrid.on("selectionChanged", function (e) {
					// Get the selected row data
					var selectedRowData = e.selectedRowsData[0]; // We assume only one row is selected at a time
					if (selectedRowData) {
				selectedSNo = selectedRowData.LineOrderNo; // Assign AccountGroupId to the global variable
						console.log("Selected AccountGroupId: ", selectedSNo); // Log the global variable
					}
				});

				// Binding 'moveRowUp' function to the 'btnMoveUp' button
				$("#btnMoveUp").dxButton({
					onClick: function () {
						moveRowUp();
					}
				});

				// Binding 'moveRowDown' function to the 'btnMoveDown' button
				$("#btnMoveDown").dxButton({
					onClick: function () {
						moveRowDown();
					}
				});
			});


			 function getFlatData(items) {
				var flatData = [];

				function flatten(items) {
					items.forEach(item => {
						if (item.items) {
							flatten(item.items); // Recursively flatten groups
						} else {
							flatData.push(item); // Push raw row data
						}
					});
				}

				flatten(items); // Flatten all grouped items

				return flatData;
			}

			  //MoveupDown functionality
			function moveRowUp() {
				var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.getDataSource();
				var data = getFlatData(dataSource.items()); // Flatten the grouped data
				//   var selectedRowKeys = dataGrid.option("selectedRowKeys");

				console.log("Flattened Data:", data); // Log flattened data for debugging


				// Find the row index based on the selected row key (AccountGroupId)
				var rowIndex = data.findIndex(item => item.LineOrderNo === selectedSNo);

				console.log("Row Index:", rowIndex); // Log row index for debugging

				// Proceed only if a valid row is selected and it's not the first row
				if (rowIndex > 0) {
					swapRows(data, rowIndex, rowIndex - 1); // Swap rows in the data

					// Update the data source with the new data order
					dataSource.store().update(data[rowIndex].LineOrderNo, data[rowIndex]);
					dataSource.store().update(data[rowIndex - 1].LineOrderNo, data[rowIndex - 1]);

					// After swap, select the moved row
					dataGrid.selectRows([data[rowIndex - 1].LineOrderNo]);
				}
			}


			function moveRowDown() {

				var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.getDataSource();
				var data = getFlatData(dataSource.items()); // Get flattened data
				// var selectedRowKeys = dataGrid.option("selectedRowKeys");


				var rowIndex = data.findIndex(item => item.LineOrderNo === selectedSNo);

				console.log("Row Index:", rowIndex);

				if (rowIndex < data.length - 1) {
					swapRows(data, rowIndex, rowIndex + 1);
					dataGrid.refresh();
					dataGrid.selectRows([data[rowIndex + 1].LineOrderNo]);
				} else {
					console.log("Cannot move row down: Row is already at the bottom.");
				}
			}


			  function swapRows(data, index1, index2) {
				var temp = data[index1];
				console.log("Swap Data1:", temp);

				// Swap the rows
				data[index1] = data[index2];
				console.log("Swap Data2:", data[index2]);

				data[index2] = temp;
				console.log("Swapped Data:", data);

				// Get the DataGrid instance and update the data source
				var dataGrid1 = $("#B2BdataGrid").dxDataGrid("instance");
				var dataGrid = $("#B2BdataGrid").dxDataGrid("instance").option("dataSource", data);


				dataGrid1.refresh();
			}


			function disableEditing() {
				// Disable all input fields and buttons except for specific ones
				$('input, select, textarea').prop('disabled', true);

				$('.dx-button').each(function () {
					const allowedButtons = ['btnMoveDown',  'btnMoveUp', 'btnSave','btnSaveAndClose','btnBack','btnPrint','btnPostToLedgers','btnPostTag'];
					if (!allowedButtons.includes($(this).attr('id'))) {
						$(this).dxButton('option', 'disabled', true);
					}
				});


			// Disable DataGrid Editing and Deleting
			var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
			if (dataGrid) {
				dataGrid.option("editing.allowUpdating", false);
				dataGrid.option("editing.allowDeleting", false);
			}

			}


