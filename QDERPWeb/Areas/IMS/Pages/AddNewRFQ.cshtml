@page
@model QD.ERP.Web.Areas.IMS.Pages.AddNewRFQModel
@{
}
<style>
    

	.titleCard-toggle1 {
		display: none;
	}
    .ledgerResult {
        overflow-x: auto;
        width: 100%;
    }
    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold; 
        font-size: 14px;
        padding: 10px 15px; 
    }

    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        padding: 5px 10px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
	}

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }
 

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center; 
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }
    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }
    
    .select-box {
        width: 20vh;
    }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container{
      
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .containers{
        display:flex;
    }
  
</style>
<meta charset="UTF-8">
@* <div class="title">
    <div class="header-container">
        <div id="RequestForQuotation" class="no-border-title"></div>
    </div>
</div> *@
<input id="formId" value="frm60113RFQMaster" type="hidden" />
<div class="dx-card-container">
	<div class="dx-card-header minimal-header">
		<div class="card-title-icon">
			<i class="fas fa-file-invoice-dollar"></i>
		</div>
		<div id="RequestForQuotation" class="titleText no-border-title"></div>
	</div>
</div>
<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%").Height(200)
                .Items(item =>
                {
                    item.Add()
					.Title(new JS("formatMessage('RFQ Details')"))
                .Icon("folder")
                .Text("RFQ Details")
                .Template(@<text>
            <div style="padding:10px;">
                <!-- Row 1: 3 Columns -->
                <div class="row g-2">
                    <div class="col-md-2">
                     
							@(Html.DevExtreme().TextBox()
								.Label(new JS("formatMessage('Request No')"))
								.ID("RFQNo")
								.LabelMode(EditorLabelMode.Floating)
								.Width("100%")
								)
                    </div>
                    <div class="col-md-2">
                        @(Html.DevExtreme().DateBox()
                        .ID("RFQDate")
						.Value(DateTime.Now)
						.DisplayFormat("dd-MMM-yyyy")
                        .Label(new JS("formatMessage('RFQ Date')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                    </div>
                    <div class="col-md-8" style="  display: flex; align-items: flex-end;">
                    			 @(Html.DevExtreme().DropDownBox()
														.Label(new JS("formatMessage('Supplier Name:')"))
                          .DataSource(d => d.WebApi()
														.Controller("RequestforQuotationList")
														.LoadAction("GetSupplierName")
                                                    .LoadMode(DataSourceLoadMode.Raw)
                                                   .Key("SupplierCode")
                                                )
                                         .LabelMode(EditorLabelMode.Floating)
                                              .ID("GetProjectDropDown")
											  .Option("dataGridId", "GetSupplier-datagrid")

     .Width(900)
     //.ShowClearButton(true)
                 .AcceptCustomValue(true) 
     .OpenOnFieldClick(false)//
     .ValueChangeEvent("input")
     .HoverStateEnabled(true)
	.ValueExpr("SupplierCode")
	.DisplayExpr("SupplierName")
     .OnInput("dropDownBoxOnInput")
     .OnOpened("onOpened")
     .TabIndex(1)
     .Width("40%")
     .OnKeyDown("onKeyDown")
     //.OnValueChanged("dropDownBoxValueChanged")
     .ContentTemplate(new TemplateName("GetSupplierContentTemplate"))
						.ValidationRules(rules =>
						{
						rules.AddRequired()
						.Message(new JS("formatMessage('Supplier Name should be entered')"));
						})
						.Buttons(buttons => {
								// Clear Button
								buttons.Add()
									.Name("clear");

								// Add Client Button
								buttons.Add()
									.Name("AddSupplier")
									.Location(TextEditorButtonLocation.After)
									.Widget(w => w.Button()
										.Type(ButtonType.Default)
										.Icon("plus")
										.ElementAttr(new { @class = "custom-hover-button add-hover" })
										.OnClick("AddNewSupplier")
									);

								// Edit Client Button
								buttons.Add()
									.Name("btnEditClient")
									.Location(TextEditorButtonLocation.After)
									.Widget(w => w.Button()
										.Type(ButtonType.Default)
										.Icon("edit")
										.ElementAttr(new { @class = "custom-hover-button edit-hover" })
											.OnClick(@"function() {
												var dropDownBox = $('#GetProjectDropDown').dxDropDownBox('instance');
												var selectedValue = dropDownBox.option('value');
												if (!selectedValue) {
												DevExpress.ui.notify('Please select a Suppier.', 'warning', 2000);
												return;
												}
												var url = '/' + tenantName + '/IMS/SupplierLeadMaster?supplierCode=' + encodeURIComponent(selectedValue);
												openModal(url, 'Supplier Master');
												}")
									);
									  buttons.Add()
									   .Name("dropDown");
							})
						)
     

                   
						
                        <div style="flex: 1; margin-left: 10px;">
                            @(Html.DevExtreme().TextBox()
                            .ID("RequestNo")
						.Label(new JS("formatMessage('Request / Enquiry No:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .Width("100%"))
                        </div>
                    </div>
                </div>

                <!-- Row 2: 5 Columns -->
                <div class="row ">
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("ProjectRef")
						.Label(new JS("formatMessage('Project Ref:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div class="col-md-3" style="  display: flex; align-items: flex-end;">
                       @(Html.DevExtreme().TextBox()
							.ID("AttentionTo")
							.Label(new JS("formatMessage('Attention To:')"))
							.LabelMode(EditorLabelMode.Floating)
							.Width("100%")
							.Buttons(buttons =>
								{
									buttons.Add()
										.Name("AddAttention")
										.Location(TextEditorButtonLocation.After)
										.Widget(w => w.Button()
											.Type(ButtonType.Default)
											.Icon("plus")
											.ElementAttr(new { @class = "custom-hover-button add-hover" })
											.OnClick("onSupplierContactClick"));
								})
						)
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierEmail")
						.Label(new JS("formatMessage('Supplier Email:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Mode(TextBoxMode.Email)
						.ValidationRules(value => value.AddEmail().Message(new JS("formatMessage('Please Enter the Valid Email Address')")))
                        .Width("100%"))
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierContact")
						.Label(new JS("formatMessage('Supplier Contact No:')"))
                        .LabelMode(EditorLabelMode.Floating)
						.InputAttr(new { onkeypress = "return event.charCode >= 48 && event.charCode <= 57", type = "text", maxlength = "15" })
                        .Width("100%"))
                    </div>
                  
                </div>

                <!-- Row 3: 4 Columns -->
                <div class="row">
                    <div class="col-md-3">
                        @(Html.DevExtreme().TextBox()
                        .ID("SupplierQuoteNo")
						.Label(new JS("formatMessage('Supplier Quote No:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div class="col-md-3">
                        @(Html.DevExtreme().DateBox()
                        .ID("SupplierQuoteDate")
						.DisplayFormat("dd-MMM-yyyy")
						.Label(new JS("formatMessage('Supplier Quote Date:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>
                    <div class="col-md-3">
						
							@(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
														.Label(new JS("formatMessage('Sales Person:')"))
														.DataSource(d => d.WebApi()
														.Controller("AddNewClientRequest")
														.LoadAction("GetSalesPerson")
														.LoadMode(DataSourceLoadMode.Raw)
														.Key("TypeOfRequestId")
														)
														.LabelMode(EditorLabelMode.Floating)
														.ID("ddGetSalesPerson")
														.Width(900)
														// .ShowClearButton(true)
							                           .AcceptCustomValue(true) 
														.OpenOnFieldClick(false)//
														.ValueChangeEvent("input")
														.HoverStateEnabled(true)
														.ValueExpr("SalesPersonCode")
														.DisplayExpr("SalesPersonName")
														.OnInput("dropDownBoxOnInput")
														.OnOpened("onOpened")
														.TabIndex(1)
														.Width("100%")
														.OnKeyDown("onKeyDown")
																				//.OnValueChanged("dropDownBoxValueChanged")
														.ContentTemplate(new TemplateName("GetSalesPersonContentTemplate"))
														)
						
                    </div>
                    <div class="col-md-3">
                       @(Html.DevExtreme().DropDownBox()
														.Label(new JS("formatMessage('Project:')"))
														.DataSource(d => d.WebApi()
														.Controller("AddNewClientRequest")
														.LoadAction("GetProject")
														.LoadMode(DataSourceLoadMode.Raw)
														.Key("ProjectId")
														)
														.LabelMode(EditorLabelMode.Floating)
														.ID("ddProject")
														.Width(900)
														// .ShowClearButton(true)
							                             .AcceptCustomValue(true) 
														.OpenOnFieldClick(false)//
														.ValueChangeEvent("input")
														.HoverStateEnabled(true)
														.ValueExpr("ProjectId")
														.DisplayExpr("ProjectDescription")
														.OnInput("dropDownBoxOnInput")
														.OnOpened("onOpened")
														.TabIndex(1)
														.Width("100%")
														.OnKeyDown("onKeyDown")
														//.OnValueChanged("dropDownBoxValueChanged")
														.ContentTemplate(new TemplateName("GetProjectContentTemplate"))
														)
                    </div>
                </div>
            </div>

        </text>);

						item.Add().Title(new JS("formatMessage('RFQ Sub Details')")).Icon("detailslayout").Text("RFQ Sub Details").Template(@<text>
            <div class="d-flex flex-wrap gap-3">
    <!-- Left Card: Subject + Quote Introduction -->
    <div class="p-3 flex-fill" style="min-width: 300px;">
        <table class=" w-100">
            <tbody>
                <!-- Subject -->
                <tr>
                    <td style="display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                            .ID("Subject")
							.Label(new JS("formatMessage('RFQ Subject:')"))
                            .LabelMode(EditorLabelMode.Floating)
							.Spellcheck(true) 
                            .Width("100%")
                        )
						  @(Html.DevExtreme().Button()
                        .ID("AddSuject")
                          .ElementAttr("class", "custom-btn-size")
                        .Icon("upload")
                       .OnClick("function() { saveField('ReportSubject', 'Subject' ,'Subject'); }")
                        .Hint("Set Default")) 
                        @(Html.DevExtreme().Button()
                        .ID("EditSubject")
                          .ElementAttr("class", "custom-btn-size")
                        .Icon("fa fa-font")
                        .Hint("Reset"))
                    </td>
                </tr>

                <!-- Quote Introduction -->
                <tr>
                    <td style="display:flex; align-items:end;">
						   @(Html.DevExtreme().TextArea()
							.ID("QuoteIntro")
							.Height(80)
							.Label(new JS("formatMessage('RFQ Remarks:')"))
							.LabelMode(EditorLabelMode.Floating)
							.Width("100%")
							.Spellcheck(true) 
							.MaxLength(500))
							@(Html.DevExtreme().Button()
							.ID("AddIntro")
							.ElementAttr("class", "custom-btn-size")
							.Icon("upload")
							.OnClick("function() { saveField('ReportSubject', 'QuoteIntro' ,'Subject'); }")
							.Hint("Set Default")) 
							@(Html.DevExtreme().Button()
							.ID("EditIntro")
							.ElementAttr("class", "custom-btn-size")
							.Icon("fa fa-font")
							.Hint("Reset"))
                      
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Right Card: Quote Summary -->
    <div style="min-width: 300px;flex: 1 1 auto; ">
        <table class="w-100">
            <tbody>
                <tr>
                    <td style="display:flex; align-items:end;">
                        @(Html.DevExtreme().TextArea()
                             .ID("QuoteSummary")
                             .ElementAttr("style", "height: 140px ! important;")
							 .Label(new JS("formatMessage('RFQ Summary:')"))
							 .Spellcheck(true) 
                             .LabelMode(EditorLabelMode.Floating)
                             .Width("100%"))
							  @(Html.DevExtreme().Button()
							 .ID("Addsummary")
							 .ElementAttr("class", "custom-btn-size")
							 .Icon("upload")
							 .OnClick("function() { saveField('ReportSubject', 'QuoteSummary' ,'Subject'); }")
							 .Hint("Set Default")) 
							 @(Html.DevExtreme().Button()
							.ID("EditSummary")
							.ElementAttr("class", "custom-btn-size")
							.Icon("fa fa-font")
						    .Hint("Reset"))
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>



        </text>);
