	$("#btnAddNew").on("click", function (e) {
					const $btn = $("#btnSave");
		$btn.dxButton("instance").option("disabled", false);

			const grid = $("#B2BdataGrid").dxDataGrid("instance");
			const store = grid.getDataSource().store();
			const currentData = grid.getDataSource().items();

			// Calculate next SNo safely based on existing items
			const nextLineOrderNo = currentData.length > 0
				? Math.max(...currentData.map(row => row.LineOrderNo || 0)) + 1
				: 1;

			const newRow = {
				LineOrderNo: nextLineOrderNo,
				//ItemCode: ItemNo || "",  // Ensure this is defined or provide fallback
					GSCode: null,
	Description:null,
	UnitRateMethod:null,
	QuotedQuantity:0,
	UnitPrice:0.00,
	LineTotalBeforeTax:0.00,
	ItemDiscount:0,
	LineTotalAfterDisc:0.00,


	AddlDescription: null,
				QuotationRemarks: null,
				DeliveryPeriod: null,
				PlanNo: null
			};

			// Efficient insert without replacing entire dataSource
			store.insert(newRow)
				.then(() => {
					grid.refresh(); // Ensure the UI updates with the new row
					
				
				})
				.catch(error => {
					DevExpress.ui.notify("Error adding row: " + error.message, "error", 3000);
				});

		});


