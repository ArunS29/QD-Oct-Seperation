		var dataSource = dropDownBox.getDataSource();

		dataSource.load().done(function (data) {
			var selectedItem = data.find(x => x.SupplierCode === selectedValue);

			if (!selectedItem || !selectedItem.SupplierName) {
				DevExpress.ui.notify('supplier details not found.', 'error', 2000);
				return;
			}

			var supplierCode = selectedValue;
			var supplierName = selectedItem.SupplierName;

			var url = '/' + tenantName + '/IMS/SupplierContactDetails?SupplierCode=' +
				encodeURIComponent(supplierCode) + '&SupplierName=' +
				encodeURIComponent(supplierName);

			openModal(url, formatMessage('Supplier Contact List'));
		});
	}
