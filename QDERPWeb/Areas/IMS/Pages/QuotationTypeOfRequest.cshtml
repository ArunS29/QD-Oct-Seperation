@page
@model QD.ERP.Web.Areas.IMS.Pages.QuotationTypeOfRequestModel
@{
}



@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
<style>
    .signatory-form-container {
        padding: 20px;
    }

    .form-row {
        display: flex;
        gap:15px;
        align-items: end;
    }

    .dx-datagrid-save-button,
    .dx-datagrid-cancel-button {
        display: none !important;
    }

    /* Also hide the entire right-aligned toolbar space */
    .dx-toolbar-after {
        display: none !important;
    }

    /* Optionally, remove padding/margin if needed */
    .dx-datagrid-headers .dx-toolbar {
        padding-right: 0 !important;
    }
    .form-row .form-row-btn {
        margin: 2px;
        
        width: 340px;
        padding: 0px;
    }

    .rtl-textbox input {
        text-align: right;
    }
        .form-row input,
        .form-row .dx-textbox,
        .form-row .dx-selectbox {
            flex: 1;
        }

    .dx-fileuploader-input-wrapper .dx-button {
        float: left;
        margin-top: -10px;
    }
    .image-upload-row {
        align-items: center;
        gap: 10px;
    }

    .signature-upload {
        border: 1px solid #ccc;
        background-color: #fff;
    }

    .limited-footer .btn-container:not(:has(#btnUpdate,#btnBack)) {
        display: none !important;
    }
    
  
    .grid{
        padding:20px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: flex-start;
        background-color: var(--background-color);
    }

    .mainContainer {
        margin-top: 1em;
    }

    .playIcon {
        display: none;
    }

</style>
<div class="title">
    <div class="header-container">
        <div id="QuotationTypeofRequest" class="no-border-input"></div>
    </div>
</div>
    <div class="form-row" style="padding:20px;">
        <div class="col-md-6">
        @(Html.DevExtreme().TextBox()
            .ID("txtTypeOfRequest")
            .Label(new JS("formatMessage('Type new Quotation Type of Request & Add to the Existing List:')"))
            .LabelMode(EditorLabelMode.Outside)
            .ValidationRules(rules =>
            {
                rules.AddRequired().Message("Type of Request is required");
            })
            )

     </div>
 </div>

    <div class="form-row" style="padding:20px;">
       <div class="col-md-6">
        @(Html.DevExtreme().TextBox()
            .ID("txtTermsCategory")
            .Label(new JS("formatMessage('Terms Category:')"))
            .LabelMode(EditorLabelMode.Outside)
            .ValidationRules(rules =>
            {
                rules.AddRequired().Message("Signatory Name is required");
            })
            )
            </div>
         <div class="col-md-2">
            @(Html.DevExtreme().Button()
                .ID("btnAddSalesPerson")
                .Text(new JS("formatMessage('ADD')"))
                .Icon("plus")
                .OnClick("function() { addSignatoryToGrid(); }")
                .ElementAttr(new { @class = "dx-button-add" })
                )
        </div>
    </div>

   


<div class="dx-field ledgerResult">
    @(Html.DevExtreme().DataGrid()
            .ID("TypeOfRequestGrid")
            .KeyExpr("TypeOfRequestId")
            .RemoteOperations(false)
            .DataSource(d => d.WebApi()
        .Controller("QuotationTypeOfRequest")
        .LoadAction("GetTypeofRequest")
            .LoadMode(DataSourceLoadMode.Raw)
            )
        .Editing(editing => editing
        .Mode(GridEditMode.Batch)
        .AllowUpdating(true)
        .AllowDeleting(true)
        )
        .Toolbar(toolbar =>
        {
            toolbar.Items(items => { }); // hide default toolbar
        })
        .OnRowUpdating("onSignatoryUpdating")                       // Handles saving
            .Columns(columns =>
            {
            columns.Add().DataField("TypeOfRequestId").Caption(new JS("formatMessage('ID')")).Width(80).AllowEditing(false);
            columns.Add().DataField("TypeOfRequest").Caption(new JS("formatMessage('Type Of Request')")).Width(200);
            columns.Add().DataField("TermsCategory").Caption(new JS("formatMessage('Terms Category')")).Width(200);
            // Add delete button column
            columns.Add()
            .Type(GridCommandColumnType.Buttons)
            .Buttons(buttons =>
            {
                buttons.Add()
            .Name(GridColumnButtonName.Delete)
            .Icon("trash") // Use a trash icon
            .Hint("Delete Row") // Tooltip
            .OnClick("onDeleteButtonClick");
            });
        })
        .Height(500)
        .ColumnAutoWidth(true)
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(f => f.Enabled(true))
        .Paging(p => p.Enabled(true))
        .Scrolling(s => s
        .Mode(GridScrollingMode.Virtual)
        .RowRenderingMode(GridRowRenderingMode.Virtual)
        .PreloadEnabled(true)
        .ScrollByContent(true)
        )
        .ShowBorders(true)
        .ShowRowLines(true)
        .Width("100%")
        )


</div>


<div class="limited-footer">
        @await Html.PartialAsync("InventoryModuleFooter")
</div>
 <script>

    $(document).ready(function () {

            $(".limited-footer .btn-container").each(function () {

              if (!$(this).find("#btnUpdate,#btnBack").length) {

                  $(this).remove();

              }

          });

      });

    $(document).on("click", "#btnBack", function () {
        window.history.back();
    });

      $(function () {
            $("#DatabaseSignatories").dxTextBox({
                text: formatMessage("Database "),
                readOnly: true,
                           

            });
        });

    $(function () {
            $("#QuotationTypeofRequest").dxTextBox({
                text: formatMessage("Quotation Type of Request"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    async function convertToArabic(sourceId, targetId) {
        const sourceBox = $("#" + sourceId).dxTextBox("instance");
        const targetBox = $("#" + targetId).dxTextBox("instance");

        if (!sourceBox || !targetBox) {
            console.error("TextBox not initialized.");
            return;
        }

        const sourceText = sourceBox.option("value");

        if (!sourceText || sourceText.trim() === "") {
            alert("Please enter a value to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(sourceText);
            targetBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    
    //img
    let businessCard1Base64 = "";
    function addSignatoryToGrid() {
        // Validate fields using the Validator components
        // const nameValidationResult = $("#SignatoryName").dxValidator("instance").validate();
        // const positionValidationResult = $("#SignatoryPosition").dxValidator("instance").validate();

        // if (!nameValidationResult.isValid || !positionValidationResult.isValid) {
        //     DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
        //     return;
        // }

        const data = {
            TypeOfRequest: $("#txtTypeOfRequest").dxTextBox("instance").option("value"),
            TermsCategory: $("#txtTermsCategory").dxTextBox("instance").option("value")
                         
           
        };

        $.ajax({
                url: '/api/QuotationTypeOfRequest/SaveOrUpdateSignatory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Quotation Type Of Request saved successfully!", "success", 2000);
                $("#TypeOfRequestGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save signatory.", "error", 2000);
            }
        });
    }


    $("#btnUpdate").on("click", function () {
        const grid = $("#TypeOfRequestGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


    function onSignatoryUpdating(e) {
        const data = {
            TypeOfRequestId: e.oldData.TypeOfRequestId,
            TypeOfRequest: e.newData.TypeOfRequest ?? e.oldData.TypeOfRequest,
            TermsCategory: e.newData.TermsCategory ?? e.oldData.TermsCategory
        };

        e.cancel = true; // prevents grid from doing its own update

        return $.ajax({
            url: '/api/QuotationTypeOfRequest/SaveOrUpdateSignatory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#TypeOfRequestGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }

    function onDeleteButtonClick(e) {
        e.event.preventDefault(); // prevent default delete

        var grid = $("#TypeOfRequestGrid").dxDataGrid("instance");
        var key = e.row.data.TypeOfRequestId; // get the ID of the row

        if (confirm("Are you sure you want to delete this row?")) {
            $.ajax({
                url: '/api/QuotationTypeOfRequest/Delete?key=' + key,
                type: 'DELETE',
                success: function () {
                    // Refresh the grid after delete
                    grid.refresh();
                    DevExpress.ui.notify("Deleted successfully", "success", 2000);
                },
                error: function () {
                    DevExpress.ui.notify("Delete failed", "error", 2000);
                }
            });
        }
    }
    



    </script>