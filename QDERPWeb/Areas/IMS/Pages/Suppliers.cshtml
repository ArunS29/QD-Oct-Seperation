    .mainContainer {
        width: 96%;
        overflow-x: hidden;
    }

    .tile-icon {
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        height: 100%;
        position: absolute;
        left: 360px;
        bottom: 10px;
    }

    .with-sidebar {
        position: relative;
        overflow: hidden;
    }

        .with-sidebar::before {
            content: '';
