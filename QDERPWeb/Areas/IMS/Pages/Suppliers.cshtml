@page
@using QD.ERP.Web.DAL.Entities
@model QD.ERP.Web.Areas.Finance.Pages.SuppliersModel
@{

}

@{
    ViewData["Title"] = "Suppliers";

}

<style>
    .header-box {
        background-color: #3c8dbc;
        color: white;
        padding: 20px;
        font-size: 20px;
        font-weight: bold;
        /* display: flex; */
        align-items: center;
        border-radius: 4px 4px 0 0;
        width: 300px;
        height:200px;
        margin-left:15px;
    }

        .header-box i {
            margin-right: 10px;
            font-size: 24px;
        }
        .header-box h5{
            margin-top: 40px;
        }

    .datagrid{
        height:600px;
        padding:18px;

    }

    .toolbar-buttons {
        /* position: fixed; */
        bottom: 20px; /* Distance from bottom */
        left: 20px; /* Distance from left */
        display: flex;
        gap: 10px; /* Space between buttons */
        /* z-index: 9999; /* Make sure it's on top */ */
        /* background-color: white; /* Optional: background */ */
        padding: 10px; /* Optional: inner spacing */
        border-radius: 6px;
        margin-top:10px;
        /* box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); */
    }

    .limited-footer .btn-container:not(:has(#ddButtonLayout,btnRefresh,#btnPrint,#btnToggleSearch,#btntoggleGroupPanel,#btnColumnChooser,#btnAddSuppliers)) {
        display: none !important;
    }

    .mainContainer {
        width: 96%;
        overflow-x: hidden;
    }
</style>

<!-- Client Header Box -->
<div class="title">
    <div class="header-container">
        <div id="ClientLeads" class="no-border-input"></div>
    </div>
</div>
<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("InventoryModuleFooter")
    </div>
</div>
<div>
    @(
            Html.DevExtreme().DataGrid<Qry30199QrySupplierList>()
            .ID("dataGrid")
            .DataSource(ds => ds.Mvc()
            .Controller("Suppliers")
            .LoadAction("Get"))
            .KeyExpr("SupplierCode")
            .ElementAttr("class", "datagrid")
            .ShowBorders(true)
            .ColumnAutoWidth(true)
            .ShowColumnLines(true)
            .ShowRowLines(true)
            .Width("100%")
            .OnContextMenuPreparing("onSuppliersGridContextMenu")
            .AllowColumnResizing(true) // Enable column resizing
            .ColumnResizingMode(ColumnResizingMode.NextColumn) // Optional: can be "Widget" or "NextColumn"
            .AllowColumnReordering(true) // Optional: allow dragging columns
            .ColumnChooser(chooser => chooser
            .Enabled(true)
            .Mode(GridColumnChooserMode.Select) // You can also use "DragAndDrop"
            )
            .HeaderFilter(filter => filter.Visible(false))
        .FilterRow(filterRow => filterRow.Visible(false).ApplyFilter(GridApplyFilterMode.Auto)) // ✅ Enables inline filter inputs

            .Paging(p => p.Enabled(false))
            .Columns(columns =>
            {
                columns.Add().DataField("SupplierCategory").Caption("Supplier Category").Visible(true).GroupIndex(0);
                columns.Add().DataField("SupplierCode").Caption("Supplier Code").Visible(true);
                columns.Add().DataField("SupplierName").Caption("Supplier Name").Visible(true);
            columns.Add().DataField("SupplierCategory").Caption("Supplier Type").Visible(true);
                columns.Add().DataField("ContactPerson").Caption("Contact Person").Visible(true);
                columns.Add().DataField("ContactMobile1").Caption("Contact Mobile").Visible(true);
                columns.Add().DataField("ContactPhone1").Caption("Contact Phone").Visible(true);
                columns.Add().DataField("ContactPersonTitle").Caption("Contact Person Title").Visible(true);
        columns.Add().DataField("SupplierAccountLedgerNo").Caption("Supplier Ledger No").Visible(true);


            columns.Add().DataField("SupplierCategoryCode").Caption("Supplier Category Code").Visible(false);
            columns.Add().DataField("CategoryCode").Caption("Category Code").Visible(false);
            columns.Add().DataField("SupplierName").Caption("Supplier Name").Visible(false);
            columns.Add().DataField("SupplierNameAr").Caption("Supplier Name (Arabic)").Visible(false);
            columns.Add().DataField("SupplierAddress").Caption("Supplier Address").Visible(false);
            columns.Add().DataField("ContactMobile2").Caption("Contact Mobile 2").Visible(false);
            columns.Add().DataField("ContactPhone2").Caption("Contact Phone 2").Visible(false);
            columns.Add().DataField("ContactEmail").Caption("Contact Email").Visible(false);
            columns.Add().DataField("ContactFaxNo").Caption("Contact Fax No").Visible(false);
            columns.Add().DataField("ContactRemarks").Caption("Contact Remarks").Visible(false);
            columns.Add().DataField("BusinessCard1").Caption("Business Card 1").Visible(false);
            columns.Add().DataField("BusinessCard2").Caption("Business Card 2").Visible(false);
            columns.Add().DataField("IsDiscontinued").Caption("Is Discontinued").Visible(false);
            columns.Add().DataField("ReasonDiscontinued").Caption("Reason Discontinued").Visible(false);
            columns.Add().DataField("CreatedBy").Caption("Created By").Visible(false);
            columns.Add().DataField("CreatedOn").Caption("Created On").Visible(false);
            columns.Add().DataField("ModifiedBy").Caption("Modified By").Visible(false);
            columns.Add().DataField("ModifiedOn").Caption("Modified On").Visible(false);
            columns.Add().DataField("DiscontinuedBy").Caption("Discontinued By").Visible(false);
            columns.Add().DataField("DiscontinuedOn").Caption("Discontinued On").Visible(false);
            columns.Add().DataField("DateVisitedFirst").Caption("Date Visited First").Visible(false);
            columns.Add().DataField("SupplierLedgerName").Caption("Supplier Ledger Name").Visible(false);
            columns.Add().DataField("SupplierVatno").Caption("Supplier VAT No").Visible(false);
            })
        .Summary(summary =>
        {
            summary.GroupItems(items =>
            {
                items.Add().Column("SupplierName")
            .SummaryType(SummaryType.Count)
            .ShowInGroupFooter(true)
            .DisplayFormat(new JS("formatMessage('No of Suppliers: {0}')"));

            });
            summary.TotalItems(items =>
            {

                items.Add().Column("SupplierName")
            .SummaryType(SummaryType.Count)
            .DisplayFormat("Total No of Suppliers: {0}");



            });
        })
        )

</div>

<!-- Bottom Toolbar -->


<script>
    $(document).ready(function () {

          $(".limited-footer .btn-container").each(function () {

            if (!$(this).find("#ddButtonLayout,#btnPrint,#btnToggleSearch,#btntoggleGroupPanel,#btnColumnChooser,#btnRefresh,#btnAddSuppliers").length) {
                  $(this).remove();
              }

          });

          // Handle Back button click
          $(document).on('click', '#btnBack', function () {
              window.history.back();
          });

      });
           function onSuppliersGridContextMenu(e) {
            if (e.target === "content" && e.row) {
                e.items = [{
                    text: "Supplier Edit",
                    onItemClick: function () {
                        let supplierCode = e.row.data.SupplierCode;
                        let tenantName = window.tenantName || "defaultTenant"; // replace with dynamic tenant logic if needed
                            let url = `/${tenantName}/IMS/SupplierLeadMaster?supplierCode=${supplierCode}`;
                            let title = `Edit Client - ${supplierCode}`;
                        openModal(url, title);
                    }
                }];
            }
        }
        $(function () {
        $("#ClientLeads").dxTextBox({
            text: formatMessage("Suppliers"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
</script>


