@page
@model QD.ERP.Web.Areas.IMS.Pages.DetailedDescriptionMReceiptModel
@{
}

<style>
    .container {
        display: none !important;
    }
 
    .frame {
        display: none !important;
    }
 
    .footerContainer {
        display: none !important;
    }
 
    .bodyContainer {
        display: flex;
        justify-content: center;
    }
 
    .imagecontainer {
        border-bottom: 2px;
    }
 
    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }
 
    .playIcon {
        display: none;
    }
 
 
</style>
 
<div style="padding: 10px; border-radius: 5px;">
<div style="display: flex; justify-content: space-between; align-items: center;">
<label style="font-weight: bold;">Detailed Description / Specification:</label>
<div>
            @(Html.DevExtreme().Button()
                        .ID("btnUseDetailedDescription")
                        .Text("Use Detailed Description")
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Contained)
                        .OnClick("getDetailedDescription")
                        .ElementAttr("style", "margin-right: 10px;"))
            @(Html.DevExtreme().Button()
                        .ID("btnUseItemDesc")
                        .Text("Use Item Desc.")
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .OnClick("getItemDescription")
                        .StylingMode(ButtonStylingMode.Contained))
</div>
</div>
 
    <!-- TextArea -->
<div style="margin-top: 10px;">
        @(Html.DevExtreme().TextArea()
                .ID("DetailedDescription")
                .Height(100)
                .Label("Detailed Description / Specification")
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))
</div>
 
    <!-- 3 Column Row: Purpose / Priority / Expected Date -->
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
<div style="margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("Remarks")
                .Label("Remarks")
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))
</div>

        @(Html.DevExtreme().Button()
                .ID("btnApplyAndClose")
                .Text("Apply & Close")
                .Icon("check")
                .OnClick("applyAndClose"))
</div>
    <script>
        let GSCode = null;
        let ReceiptChildSlNo1;

        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
             const ReceiptChildSlNos = urlParams.get("ReceiptChildSlNo");
             ReceiptChildSlNo1 = ReceiptChildSlNos ? ReceiptChildSlNos.split("?")[0] : null;
              if(ReceiptChildSlNo1){
                  loadeditData(ReceiptChildSlNo1);
              }

            const GSCodes = urlParams.get("gsCode");
           GSCode = GSCodes ? GSCodes.split("?")[0] : null;
            console.log("Loaded GSCode:", GSCode);
            if (GSCode) {
                    // If Mprno is present, load client details
                    loadClientDetails(GSCode);
                }

        });


            function loadClientDetails(GSCode) {
           $.ajax({
                url: `/api/MaterialReceipt/GetdataByGSCode?GSCode=${encodeURIComponent(GSCode)}`,
                type: 'GET',
                dataType: 'json',
                success: function (res)  {
                    console.log("ddd",res);
                $("#Size").dxTextBox("instance").option("value",res.ItemSize);
                $("#Manufacturer").dxTextBox("instance").option("value",res.ItemMake);
                $("#Brand").dxTextBox("instance").option("value",res.ItemBrand);
                $("#PartNo").dxTextBox("instance").option("value",res.ItemPartNo);
                },
                error: function (xhr) {
                    console.log("data fetch failed:", xhr.responseText);
                }
            });
        }
          function  loadeditData(ReceiptChildSlNo1) {
           $.ajax({
               url: `/api/MaterialReceipt/GetDetaildescriptiondata?ReceiptChildSlNo=${encodeURIComponent(ReceiptChildSlNo1)}`,
                type: 'GET',
                dataType: 'json',
                success: function (res)  {
                    console.log("ddd111",res);

                  $("#DetailedDescription").dxTextArea("instance").option("value",res.AddlDescription);
                 $("#Remarks").dxTextBox("instance").option("value",res.PoitemRemarks);
           
                },
                error: function (xhr) {
                    console.log("data fetch failed:", xhr.responseText);
                }
            });
        }

        // 🔧 This must be globally accessible
        function getItemDescription() {
            if (!GSCode) {
                DevExpress.ui.notify("GSCode is missing", "error", 2000);
                return;
            }

            $.ajax({

                url: `/api/MaterialReceipt/GetGSCodeDescription?gsCode=${encodeURIComponent(GSCode)}`,
                type: "GET",
                success: function (data) {
                    $("#DetailedDescription").dxTextArea("instance").option("value", data);
                },
                error: function () {
                    DevExpress.ui.notify("Failed to fetch description", "error", 2000);
                }
            });
        }

        function getDetailedDescription() {
            if (!GSCode) {
                DevExpress.ui.notify("GSCode is missing", "error", 2000);
                return;
            }

            $.ajax({
                url: `/api/MaterialReceipt/GetGSCodeDetailedDescription?gsCode=${encodeURIComponent(GSCode)}`,
                type: "GET",
                success: function (data) {
                    $("#DetailedDescription").dxTextArea("instance").option("value", data);
                },
                error: function () {
                    DevExpress.ui.notify("Failed to fetch detailed description", "error", 2000);
                }
            });
        }




            function collectModalFields() {
            return {
                GSCode: GSCode,
                AddlDescription: $("#DetailedDescription").dxTextArea("instance").option("value"),
                PoitemRemarks: $("#Remarks").dxTextBox("instance").option("value"),
              
            };
        }

        // Send data to Page 1 when window is closing
        window.onbeforeunload = function () {
            if (window.opener && typeof window.opener.receiveModalFieldData === "function") {
                const fieldValues = collectModalFields();
                window.opener.receiveModalFieldData(fieldValues);
            }
        };
           function applyAndClose() {
            const modalData = {
                AddlDescription: $("#DetailedDescription").dxTextArea("instance").option("value"),
                PoitemRemarks: $("#Remarks").dxTextBox("instance").option("value"),
            };

            console.log("📤 Sending to parent:", modalData);

            if (window.parent && typeof window.parent.receiveModalFieldData === "function") {
                window.parent.receiveModalFieldData(modalData);
                window.parent.closeModal(); // or your custom modal close logic
            } else {
                alert("Could not send to parent.");
            }
        }




    </script>
