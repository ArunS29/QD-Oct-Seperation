            DevExpress.ui.notify("Please enter or select a Supplier Entry to delete.", "warning", 3000);
            return;
        }
        if (confirm("Are you sure you want to delete this suppiler?")) {

        $.ajax({
            url: "/api/SupplierMaster/DeleteSupplierLeadMaster",
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(SupplierCode), // 👈 plain string
            success: function (response) {
                DevExpress.ui.notify(response.message, 'success', 3000);
                setTimeout(function () {
                    location.reload();
                }, 2000);
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                DevExpress.ui.notify(msg, 'error', 3000);
            }
        });
        }
    }
