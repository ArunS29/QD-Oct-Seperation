    function dataGridSelectionChanged1(e) {
        const selectedRow = e.selectedRowsData[0];
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#GetSupplierCategoryDropDown").dxDropDownBox("instance");

        if (selectedRow && selectedKey) {
            // Get ClientCategoryCode (numeric value) and ClientCode (formatted value)
            const supplierCategoryCode = selectedRow.SupplierCategoryCode;
            const categoryCode = selectedRow.CategoryCode; // Full ClientCode (e.g., "SW-0004")

            // 1. Set value in DropDownBox to ClientCategoryCode (numeric)
            ddbInstance.option("value", supplierCategoryCode);

            // 2. Close the DropDownBox after selecting
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }

            // 3. Call generateNextClientCode with the full ClientCode (e.g., "SW-0004")
            generateNextSupplierCode(categoryCode);
        }
    }
    function generateNextSupplierCode(categoryCode) {

        $.ajax({
            url: `/api/SupplierMaster/GetLatestSupplierCode?categoryCode=${categoryCode}`,
            type: 'GET',
            success: function (latestCode) {
                let nextNumber = 1;

                if (latestCode) {
                    const parts = latestCode.split("-");
                    if (parts.length === 2 && !isNaN(parts[1])) {
                        nextNumber = parseInt(parts[1]) + 1;
                    }
                }

                // ✅ Format with leading zeros (e.g., "0004")
                const formattedNumber = String(nextNumber).padStart(4, '0');
                const newSupplierCode = `${categoryCode}-${formattedNumber}`;

                $("#txtSupplierCode").dxTextBox("instance").option("value", newSupplierCode);
            },
            error: function () {
                DevExpress.ui.notify("Error getting latest Supplier Code", "error", 3000);
            }
        });
    }
