    function DeleteAsset(e) {
        const assetLedgerNo = $("#txtacctledno").dxTextBox("instance").option("value");
      //  alert(assetLedgerNo);
        if (!assetLedgerNo) {
            DevExpress.ui.notify("Please provide an Asset Ledger No.", "error", 2000);
            return;
        }

        DevExpress.ui.dialog.confirm("Are you sure you want to delete this asset?", "Confirm Deletion").done(function (dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: "/api/assetview/DeleteAsset", // Replace with your controller's route
                    type: "POST",
                    data: { assetLedgerNo: assetLedgerNo },
                    success: function (response) {
                        DevExpress.ui.notify(response, "success", 2000);
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify(xhr.responseText || "An error occurred.", "error", 2000);
                    }
                });
            }
        });
    }



    function dataGridSelectionChanged(e) {
        const selectedRow = e.selectedRowsData[0]; // Get the selected row
