<script>
          function onSaveAndClose() {
            onSaveSupplierMasterClick();
            window.parent.location.reload(); // Reload the parent page
            window.parent.closeModal();
        }

        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const supplierCode = urlParams.get("supplierCode");

            const cleanSupplierCode = supplierCode ? supplierCode.split("?")[0] : null;   // Trim off anything after '?' if it's accidentally included in value

            if (cleanSupplierCode) {
                loadSupplierDetails(cleanSupplierCode);
            }else{
                      $.ajax({
                   url: "/api/SupplierMaster/GetNewSupplierNo",
                    method: "GET",
                    success: function (newCode) {
                            $("#txtSupplierCode").dxTextBox("instance").option("value", newCode);
                    },
                    error: function () {
                        DevExpress.ui.notify("Failed to generate Supplier Code", "error", 3000);
                    }
                });

            }
        });
        function loadSupplierDetails(cleanSupplierCode) {

            $.ajax({
                url: `/api/SupplierMaster/GetSupplierByCode?supplierCode=${cleanSupplierCode}`,
                type: 'GET',
                success: function (data) {
                    $("#btnSave").dxButton("instance").option("text", "Update");
                    console.log("Supplier Data Loaded:", data);

                    if (data) {
                        $('#txtSupplierCode').dxTextBox("instance").option("value", data.SupplierCode);
                        $('#txtSupplierName').dxTextBox("instance").option("value", data.SupplierName);
                        $('#GetSupplierCategoryDropDown').dxDropDownBox("instance").option("value", data.SupplierCategory);
                        $('#GetSupplierLedgerNoDropDown').dxDropDownBox("instance").option("value", data.SupplierAccountLedgerNo);
                        $('#SupplierAddress').dxTextArea("instance").option("value", data.SupplierAddress);
                        $('#SupplierPerson').dxTextBox("instance").option("value", data.ContactPerson);
                        $('#Title').dxTextBox("instance").option("value", data.ContactPersonTitle);
                        $('#MobileNumber1').dxTextBox("instance").option("value", data.ContactMobile1);
                        $('#MobileNumber2').dxTextBox("instance").option("value", data.ContactMobile2);
                        $('#PhoneNumber1').dxTextBox("instance").option("value", data.ContactPhone1);
                        $('#PhoneNumber2').dxTextBox("instance").option("value", data.ContactPhone2);
                        $('#FaxNumber').dxTextBox("instance").option("value", data.ContactFaxNo);
                        $('#Email').dxTextBox("instance").option("value", data.ContactEmail);
                        $('#Remarks').dxTextArea("instance").option("value", data.ContactRemarks);

                        // Load business card images if present
                        if (data.BusinessCard1) {
                            let img1 = "data:image/png;base64," + data.BusinessCard1;
                            $('#imgBox1').html(`<img src="${img1}" />`);
                            businessCard1Base64 = img1;
                        }

                        if (data.BusinessCard2) {
                            let img2 = "data:image/png;base64," + data.BusinessCard2;
                            $('#imgBox2').html(`<img src="${img2}" />`);
                            businessCard2Base64 = img2;
                        }
                         loadSupplierContactListGrid(data.SupplierCode);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Error loading supplier details", "error", 3000);
                }
            });
        }
        function loadSupplierContactListGrid(SupplierCode) {
        $.ajax({
            url: `/api/SupplierMaster/GetContactList?SupplierCode=${encodeURIComponent(SupplierCode)}`,
            type: 'GET',
            success: function (statusData) {
                const grid = $("#Contact-dataGrid").dxDataGrid("instance");
                if (grid) {
                    grid.option("dataSource", statusData);
                    grid.refresh();
                }
            },
            error: function () {
                DevExpress.ui.notify("Failed to load status data", "error", 3000);
            }
        });
    }
        function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
