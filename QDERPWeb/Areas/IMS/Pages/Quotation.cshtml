		minimumFractionDigits: 2,
		maximumFractionDigits: 2
		}).format(cellInfo.value);
		$('<span>')
		.text(formattedValue)
		.css({
		display: 'inline-block',
		backgroundColor: '#e6ffe6',
		color: '#1a8f1a',
