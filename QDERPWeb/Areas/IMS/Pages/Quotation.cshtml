		.css({
		display: 'inline-block',
		backgroundColor: '#fff9cc', 
		color: '#b58900',          
		fontWeight: 'bold',
		padding: '4px 10px',
		borderRadius: '20px',
		minWidth: '24px',
		textAlign: 'center'
		})
