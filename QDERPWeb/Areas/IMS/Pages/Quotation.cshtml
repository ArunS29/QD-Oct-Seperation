<script>
		 $(function () {
	$("#Quotation").dxTextBox({
	text: formatMessage("Quotation"),
		readOnly: true,
		onContentReady: function (e) {
		$(e.element).addClass("dx-textbox-heading");
		}
		});
	});
			$(function () {
			var now = new Date();
			var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
			var tillmonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
			$("#frmdateBox").dxDateBox("instance").option("value", firstDay);
			$("#todateBox").dxDateBox("instance").option("value", tillmonth);
			ddBtnShowRecords_click('range');
	});
	function ddBtnShowRecords_click(duration) {
		 var frmDateBox = $("#frmdateBox").dxDateBox("instance");
			var toDateBox = $("#todateBox").dxDateBox("instance");
			var frmDate = new Date(frmDateBox.option("value"));
			var toDate = new Date(toDateBox.option("value"));
			var currentDate = new Date();
			switch (duration) {
				case 'today':
					frmDate = toDate = currentDate;
					break;
				case 'yesterday':
					var dateObj = new Date();
					// Subtract one day from current time
					dateObj.setDate(dateObj.getDate() - 1);
					frmDate = toDate = dateObj;
					break;
				case 'week':
					var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

					// Calculate the start of the week (Saturday)
					var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

					// Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
				frmDate = new Date(currentDate.setDate(startOfWeek)); // 7 days before Saturday
					toDate = new Date(currentDate.setDate(startOfWeek + 6));
					break;
				case 'tillmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = currentDate; //Today
					break;
				case 'fullmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
					break;
				case 'tillyear':
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = currentDate;// Today
					break;
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
					break;
				case 'lastyear':
					// Get the first and last day of the last year
					frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
					break;
				case 'lastmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
					break;
			}
						frmDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		toDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		FromDate = frmDate;
		ToDate = toDate;

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

				$.ajax({
		url: '/api/Quotation/GetQuotation',
		type: 'GET',
		data: {
			fromDate: frmDate,
			toDate: toDate
		},
		success: function (data) {
			console.log("Returned Data: ", data); // debug
			$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
		},
		error: function (xhr) {
			console.log("AJAX Error", xhr.responseText); // debug
			DevExpress.ui.notify("Error while loading data", "error", 2000);
		}
	});



	}
		function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
	function onContextMenuPreparing(e) {
		if (e.target === "content" && e.row && e.row.data) {
			const rowData = e.row.data;
			const QuoteNo = encodeURIComponent(rowData.QuoteNo);
			const tenantName = window.tenantName || "defaultTenant";

			e.items = [
				{
					text: "Edit Quotation",
					icon: "edit",
					onItemClick: function () {
						const url = `/${tenantName}/IMS/AddNewQuotation?QuoteNo=${QuoteNo}`;
						window.location.href = url;
					}
				},
					{
		text: "Duplicate Quotation",
		icon: "copy",
		onItemClick: function () {
			const quoteNo = e.row.data.QuoteNo;

			if (!quoteNo) {
				DevExpress.ui.notify("Quote No not found.", "error", 2000);
				return;
			}

			DevExpress.ui.dialog.confirm(
				"You are about to Duplicate this Quotation. Are you sure you want to continue?",
				"Confirm Duplicate"
			).done(function (result) {
				if (result) {
					$.ajax({
						url: "/api/Quotation/DuplicateQuotation",
						type: "POST",
						contentType: "application/json",
						data: JSON.stringify(quoteNo),
						success: function (response) {
							DevExpress.ui.notify(response.message, "success", 2000);
							$("#dataGrid").dxDataGrid("instance").refresh();
						},
						error: function (xhr) {
							let msg = xhr.responseJSON?.message || "Duplication failed.";
							DevExpress.ui.notify(msg, "error", 2000);
							console.error("Clone error:", xhr.responseJSON);
						}
					});
				}
			});
		}
	},

				{
					text: "Delete Quotation",
					icon: "trash",
					onItemClick: function () {
						DevExpress.ui.dialog.confirm(
							"You are about to delete the Quotation.\nYou cannot revert the changes.\nAre you sure?",
							"Confirm Delete"
						).done(function (dialogResult) {
							if (dialogResult) {
								var QuoteNo=e.row.data.QuoteNo;
								console.log("number", QuoteNo);
								onDeleteRequest(QuoteNo);
							}
						});
					}
				},
				{
		text: "Unlock the Quotation",  // ? Corrected closing quote
		icon: "unlock",
		onItemClick: function () {
			const QuoteNo = e.row.data.QuoteNo;

			$.ajax({
				url: "/api/Quotation/UnlockQuotation",
				type: "POST",
				contentType: "application/json",
				data: JSON.stringify({ QuoteNo: QuoteNo }), // ? sending request data
				success: function (response) {
					DevExpress.ui.notify(response.message, response.success ? "success" : "warning", 2000);
					if (response.success) {
						ddBtnShowRecords_click('range'); // ? refresh or reload the grid
					}
				},
				error: function (xhr) {
					let msg = xhr.responseJSON?.message || "An error occurred while unlocking the Quotation.";
					DevExpress.ui.notify(msg, "error", 2000);
					console.error("Unlock failed:", xhr.responseJSON);
				}
			});
		}
	},
					{
		text: "Revise Quotation",
		icon: "repeat",
		onItemClick: function () {
			const quoteNo = e.row?.data?.QuoteNo;
			if (!quoteNo) {
				DevExpress.ui.notify("Quote No not found.", "error", 2000);
				return;
			}

			DevExpress.ui.dialog.confirm(
				"You are about to revise this Quotation. Are you sure you want to continue adding a new revised Quotation?",
				"Confirm Revision"
			).done(function (result) {
				if (!result) return;

				$.ajax({
					url: "/api/Quotation/ReviseQuotation",  // 🔁 Your new API
					type: "POST",
					contentType: "application/json",
					data: JSON.stringify(quoteNo),
					success: function (response) {
						DevExpress.ui.notify(response.message, "success", 2000);
						$("#dataGrid").dxDataGrid("instance").refresh();

						if (response.newQuoteNo) {
							const tenantName = window.tenantName || "defaultTenant";
							window.location.href = `/${tenantName}/IMS/AddNewQuotation?QuoteNo=${encodeURIComponent(response.newQuoteNo)}`;
						}
					},
					error: function (xhr) {
						let msg = xhr.responseJSON?.message || "Revision failed.";
						DevExpress.ui.notify(msg, "error", 2000);
						console.error("Revision error:", xhr.responseJSON);
					}
				});
			});
		}
	},

					{
		text: "Create Sales Order",
		icon: "add",
		onItemClick: function () {
			const quotationNo = e.row.data.QuoteNo;
			const tenantName = window.tenantName || "defaultTenant";

			if (!quotationNo) {
				DevExpress.ui.notify("Quotation No not available.", "error", 2000);
				return;
			}
				// Step 1: Check approval status
							$.get(`/api/Quotation/CheckIfApproved?QuoteNo=${encodeURIComponent(quotationNo)}`)
						.done(function (isApproved) {
							if (!isApproved) {
								DevExpress.ui.notify("Quotation is not approved.", "error", 3000);
								return;
							}
			// Confirm before proceeding
			DevExpress.ui.dialog.confirm("You are about to create a Sales Order from this Quotation. Continue?", "Confirmation")
				.done(function (confirmResult) {
					if (confirmResult) {
						$.ajax({
							url: "/api/Quotation/CreateSalesOrderFromQuotation", // your backend API
							method: "POST",
							contentType: "application/json",
							data: JSON.stringify(quotationNo),
							success: function (result) {
								if (result.success) {
									DevExpress.ui.notify(result.message, "success", 2000);

									// Navigate to Sales Order creation page
									const url = `/${tenantName}/IMS/AddNewSalesOrder?QuotationNo=${encodeURIComponent(result.quotationNo)}&SalesOrderNo=${encodeURIComponent(result.salesOrderNo)}`;
									window.location.href = url;
								} else {
									DevExpress.ui.notify(result.message || "Failed to create Sales Order.", "error", 3000);
								}
							},
