        ReportedOn: $("#reportedOn").dxDateBox("instance").option("value"),
        StatusRemarks: $("#reportRemarks").dxTextArea("instance").option("value"),
        Status: $("#GetStatusDropDown").dxDropDownBox("instance").option("value"),
        FollowupOn: $("#followUpOn").dxDateBox("instance").option("value")
    };

    // Only include ClientStatusNo if it's an update
    if (clientStatusNo) {
        data.ClientStatusNo = parseInt(clientStatusNo);
    }

    $.ajax({
        url: '/api/ClientStatusUpdate/SaveOrUpdateClientStatusUpdate',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function (res) {
            if (res.success) {
                DevExpress.ui.notify(res.message, "success", 2000);

                // Set the returned ID back to the textbox
                $("#statusId").dxTextBox("instance").option("value", res.lastClientStatusNo);
                    // Refresh parent DataGrid (ensure the correct selector is used)
                    if (window.parent && window.parent.$("#ClientStatusdataGrid").length) {
                        let dataGrid = window.parent.$("#ClientStatusdataGrid").dxDataGrid("instance");
                        if (dataGrid) {
                            dataGrid.refresh();
                        }
                    }
            } else {
                DevExpress.ui.notify(res.message, "error", 3000);
            }
        },
        error: function (err) {
            DevExpress.ui.notify("Save or update failed: " + err.responseText, "error", 3000);
        }
    });
}

        $("#btnDelete").on("click", function (e) {
            e.preventDefault();
            onDeleteButtonClick();
        });
        function onDeleteButtonClick(e) {
            
            var ClientCode = $("#statusId").dxTextBox("instance").option("value");

            if (!ClientCode) {
                DevExpress.ui.notify("Please enter or select a Journal Entry to delete.", "warning", 3000);
                return;
