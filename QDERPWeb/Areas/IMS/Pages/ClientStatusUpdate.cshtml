@page

@model QD.ERP.Web.Areas.IMS.Pages.ClientStatusUpdateModel

@using DevExtreme.AspNet.Mvc

@{
    ViewBag.Title = "Client Status Update";
}

<!-- Styles -->
<style>
    h3 {
        text-align: center;
        padding: 20px;
    }

    .mainContainer {
        width: 100%;
        margin-top: 5%;
        /* border: 1px solid #ccc; */
    }

    .form-group-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .form-container {
        padding: 20px;
    }

    .form-group-row > div {
        flex: 1;
        /* min-width: 50px; */
    }

    .status-with-button {
        align-items: end;
        display: flex;
    }

    .plus-btn-wrapper {
        display: flex;
        align-items: center;
    }

    .inline-plus-button {
        background-color: #b6e265;
        border-radius: 50%;
        height: 32px;
        width: 32px;
        min-width: 32px;
        padding: 0;
