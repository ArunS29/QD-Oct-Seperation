let edit=false;
		$(document).ready(function () {
			const urlParams = new URLSearchParams(window.location.search);
			const mprnos = urlParams.get('Mprno');
			const mprno = mprnos ? mprnos.split("?")[0] : null;
			const value = $('#ddRevNo').dxTextBox("instance").option("value");
			if(value == null || value == "" ){
				const RevisionNo = urlParams.get("RevNo") ?? "";
				rvNo = urlParams.get("RevNo") ?? "";
				$('#ddRevNo').dxTextBox("instance").option("value", RevisionNo);
			}
		   
				
			if (mprno) {
				// If Mprno is present, load client details
				loadClientDetails(mprno);
				edit=true;
			} else  {
		    NewNoGeneration();
			}
		});
		function NewNoGeneration(){
					// If Mprno is not present and IsCurrent is not "true", generate a Autogenerate request number
				$.ajax({
					url: "/api/AddNewClientRequest/GetNewRequestNoApi",
					type: "GET",
					success: function (data) {
						console.log("Success:", data);
						const invoiceBox = $("#txtRequestNo").dxTextBox("instance");
						if (invoiceBox) {
							invoiceBox.option("value", data || "");
						} else {
							console.warn("Invoice TextBox not initialized.");
						}
					},
