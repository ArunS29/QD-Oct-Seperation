						function hideAllButtonsExcept(exceptions) {
			const allButtonIds = [
				"btnAddNew",
				"btnSave",
				"btnSaveAndClose",
				"btnDelete",
				"btnSubmit",
				"btnVerify",
				"btnApprove",
