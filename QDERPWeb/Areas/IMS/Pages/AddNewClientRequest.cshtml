					DevExpress.ui.notify("No rows selected", "warning", 2000);
					return;
				}
				// Collect MprchildSlNo values (used for DB deletion)
				const selectedChildIds = selectedKeys
					.map(key => {
						const rowIndex = dataGridInstance.getRowIndexByKey(key);
						return dataGridInstance.cellValue(rowIndex, "MprchildSlNo");
					})
					.filter(id => id); // Only valid saved rows
				DevExpress.ui.dialog.confirm(`Delete ${selectedKeys.length} selected row(s)?`, "Confirm").done(function (result) {
					if (!result) return;
					// If there are DB rows to delete
					if (selectedChildIds.length > 0) {
						$.ajax({
							url: "/api/AddNewClientRequest/DeleteMultipleChildren",
							type: "DELETE",
							contentType: "application/json",
							data: JSON.stringify(selectedChildIds),
							success: function (res) {
								if (res.success) {
									// ✅ Remove deleted rows from rowData
									rowData = rowData.filter(row => !selectedChildIds.includes(row.MprchildSlNo));
									// ✅ Re-sequence LineOrderNo
									rowData.forEach((row, index) => {
										row.LineOrderNo = index + 1;
									});
									// ✅ Rebind and refresh the grid
									dataGridInstance.option("dataSource", rowData);
									dataGridInstance.refresh();
									DevExpress.ui.notify("Rows deleted successfully", "success", 2000);
								} else {
									DevExpress.ui.notify(res.message, "error", 2000);
								}
							},
							error: function () {
								DevExpress.ui.notify("Failed to delete rows", "error", 3000);
							}
						});
					} else {
						// Only unsaved rows — delete from UI
						selectedKeys.forEach(key => {
							const rowIndex = dataGridInstance.getRowIndexByKey(key);
							if (rowIndex >= 0) dataGridInstance.deleteRow(rowIndex);
						});
						// ✅ Re-sequence and rebind rowData
						rowData = dataGridInstance.option("dataSource");
						rowData.forEach((row, index) => {
							row.LineOrderNo = index + 1;
						});
						dataGridInstance.option("dataSource", rowData);
						dataGridInstance.refresh();
						DevExpress.ui.notify("Unsaved rows removed", "success", 1500);
					}
				});
