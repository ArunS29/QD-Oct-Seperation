					function onVatTransactionSelectionChanged(e) {
				const selectedIds = e.component.option("selectedItemKeys");
				const transactionCode = setInvoiceTransactionCode(selectedIds);
				const ddbInstance = $("#InvoiceTransactionsCode").dxDropDownBox("instance");
				// Get the dataSource and ensure we deal with an array
				let dataSource = ddbInstance.option("dataSource");
				let currentData = [];
				if (Array.isArray(dataSource)) {
					currentData = dataSource;
				} else if (dataSource && typeof dataSource.items === "function") {
					currentData = dataSource.items();
				}
				// Check if transactionCode already exists
				const found = currentData.find(item => item.code === transactionCode);
				// If not, add it
				if (!found) {
					currentData.push({ code: transactionCode });
					// Reassign the updated array as the new data source
					ddbInstance.option("dataSource", currentData);
				}
				// Set the value
				ddbInstance.option("value", transactionCode);
				console.log("Transaction Code: " + transactionCode);
			}
			// Generates the transaction code like "010110"
			function setInvoiceTransactionCode(selectedIds) {
				// Initialize the transaction code with a prefix
				let strTransactionCode = "01";
				// Dynamically generate the binary string based on selections (1 for selected, 0 for unselected)
				for (let i = 1; i <= 5; i++) {
					strTransactionCode += selectedIds.includes(i) ? "1" : "0";
				}
				return strTransactionCode;
			}
