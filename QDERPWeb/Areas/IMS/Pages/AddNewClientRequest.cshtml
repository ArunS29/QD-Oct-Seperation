				function receiveModalFieldData(modalData) {
			console.log("📦 Received from modal:", modalData); // ✅ Step 1: Log
			const grid = $("#B2BdataGrid").dxDataGrid("instance");
			if (!window.currentDescriptionCell) {
				console.warn("❌ No currentDescriptionCell found");
				return;
			}
			const key = window.currentDescriptionCell.key;
			console.log("🔑 Editing key:", key); // ✅ Step 2: Confirm key
			const rowIndex = grid.getRowIndexByKey(key);
			if (rowIndex === -1) {
				console.warn("❌ Could not find rowIndex for key", key);
				return;
			}
			let rowData = grid.getDataSource().items()[rowIndex];
			console.log("📝 Before Update rowData:", rowData); // ✅ Step 3
			for (const [field, value] of Object.entries(modalData)) {
				rowData[field] = value;
				grid.cellValue(rowIndex, field, value);
			}
			console.log("✅ After Update rowData:", rowData); // ✅ Step 4
			grid.repaintRows([rowIndex]);
			DevExpress.ui.notify("Details saved", "success", 1500);
		}


$("#btnSave").on("click", function (e) {
    const $btn = $(this).dxButton("instance");
		// ✅ Step 1: Validate required field
		const clientnameValidator = $("#GetProjectDropDown").dxValidator("instance");
		const clientnameValidation = clientnameValidator.validate();
		if (!clientnameValidation.isValid) {
			DevExpress.ui.dialog.alert(
				"Cannot continue saving with errors, please clear the errors and continue.",
				"Clear Errors"
			);
			return;
		}
		// ✅ Step 2: Disable the button after validation passes
		$btn.option("disabled", true);
    if (edit === false) {
        // 🔹 New entry → check again before saving
        NewNoGeneration1().done(function (data) {
            var mprNoNew = data;
            $("#txtRequestNo").dxTextBox("instance").option("value", mprNoNew);
            saveQuotation(mprNoNew, $btn);
        }).fail(function () {
            $btn.option("disabled", false);
            DevExpress.ui.dialog.alert("Failed to generate new Quotation No.", "Error");
        });
    } else {
        // 🔹 Edit → no need to regenerate
        var mprNoNew = $('#txtRequestNo').dxTextBox("instance").option("value") || null;
        saveQuotation(mprNoNew, $btn);
    }
});
