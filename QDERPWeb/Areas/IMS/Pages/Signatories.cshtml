@page
@model QD.ERP.Web.Areas.IMS.Pages.SignatoriesModel
@{
}


@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
<style>

    .form-row {
        display: flex;
        gap:15px;
        align-items: end;
    }

    .dx-datagrid-save-button,
    .dx-datagrid-cancel-button {
        display: none !important;
    }

    /* Also hide the entire right-aligned toolbar space */
    .dx-toolbar-after {
        display: none !important;
    }

    /* Optionally, remove padding/margin if needed */
    .dx-datagrid-headers .dx-toolbar {
        padding-right: 0 !important;
    }
    .form-row .form-row-btn {
        margin: 2px;
        width: 340px;
        padding: 0px;
    }

    .rtl-textbox input {
        text-align: right;
    }
        .form-row input,
        .form-row .dx-textbox,
        .form-row .dx-selectbox {
            flex: 1;
        }

    .dx-fileuploader-input-wrapper .dx-button {
        float: left;
        margin-top: -10px;
    }
    .image-upload-row {
        align-items: center;
        gap: 10px;
    }

    .signature-upload {
        border: 1px solid #ccc;
        background-color: #fff;
    }

    .limited-footer .btn-container:not(:has(#btnUpdate,#btnBack)) {
        display: none !important;
    }
    
    .upload{
        display: block;
        top: 26px;
        position: relative;
        left: 0px;
    }

    .grid{
        padding:20px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: flex-start;
        background-color: var(--background-color);
    }

    .mainContainer {
        margin-top: 1em;
        overflow-x:hidden;
    }

    .imagecontainer {
        background-color: #fff;
        border: 1px solid #90caf9;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .fieldset{
        margin: 7px 0px;
    }
    .playIcon {
        display: none;
    }
</style>
