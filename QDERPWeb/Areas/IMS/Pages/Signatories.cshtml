<div class="limited-footer">
    @await Html.PartialAsync("VATModuleFooter")
</div>
 <script>

    $(document).ready(function () {

          $(".limited-footer .btn-containerIvoiceEdit").each(function () {

              if (!$(this).find("#btnUpdate,#btnBack").length) {

                  $(this).remove();

              }

          });

      });

    $(document).on("click", "#btnBack", function () {
        window.history.back();
    });

      $(function () {
            $("#DatabaseSignatories").dxTextBox({
                text: formatMessage("Database "),
                readOnly: true,
                           

            });
        });

    $(function () {
        $("#TypeSignatory").dxTextBox({
            text: formatMessage("Database Signatories"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    async function convertToArabic(sourceId, targetId) {
        const sourceBox = $("#" + sourceId).dxTextBox("instance");
        const targetBox = $("#" + targetId).dxTextBox("instance");

        if (!sourceBox || !targetBox) {
            console.error("TextBox not initialized.");
            return;
        }

        const sourceText = sourceBox.option("value");

        if (!sourceText || sourceText.trim() === "") {
            alert("Please enter a value to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(sourceText);
            targetBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    async function translateToArabic(text) {
        try {
            const response = await fetch(
                `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|ar`
            );

            if (!response.ok) {
                throw new Error("Translation API request failed.");
            }

            const data = await response.json();
            return data?.responseData?.translatedText || "Translation not found";
        } catch (error) {
            console.error("Translation failed:", error);
            throw error;
        }
    }
    //img
    let businessCard1Base64 = "";
    function addSignatoryToGrid() {
        // Validate fields using the Validator components
        const nameValidationResult = $("#SignatoryName").dxValidator("instance").validate();
        const positionValidationResult = $("#SignatoryPosition").dxValidator("instance").validate();

        if (!nameValidationResult.isValid || !positionValidationResult.isValid) {
            DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
            return;
        }

        const data = {
            SignatoryName: $("#SignatoryName").dxTextBox("instance").option("value"),
            SignatoryNameArabic: $("#SignatoryNameArabic").dxTextBox("instance").option("value"),
            SignatoryPosition: $("#SignatoryPosition").dxTextBox("instance").option("value"),
            SignatoryPositionArabic: $("#SignatoryPositionArabic").dxTextBox("instance").option("value"),
            SignatoryContact: $("#SignatoryContact").dxTextBox("instance").option("value"),
            SignatoryEmail: $("#SignatoryEmail").dxTextBox("instance").option("value"),
            SignatoryUserId: $("#SignatoryUserId").dxDropDownBox("instance").option("value"),
                 // Add base64 data for images, removing the prefix
                    SignatureImage: businessCard1Base64 ? businessCard1Base64.split(',')[1] : null,
        };

        $.ajax({
            url: '/api/Signatories/SaveOrUpdateSignatory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Signatory saved successfully!", "success", 2000);
                $("#SignatoryGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save signatory.", "error", 2000);
            }
        });
    }


    $("#btnUpdate").on("click", function () {
        const grid = $("#SignatoryGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


    function onSignatoryUpdating(e) {
        const data = {
            SignatoryID: e.oldData.SignatoryID,
            SignatoryName: e.newData.SignatoryName ?? e.oldData.SignatoryName,
            SignatoryPosition: e.newData.SignatoryPosition ?? e.oldData.SignatoryPosition,
            SignatoryContact: e.newData.SignatoryContact ?? e.oldData.SignatoryContact,
            SignatoryEmail: e.newData.SignatoryEmail ?? e.oldData.SignatoryEmail
        };

        e.cancel = true; // prevents grid from doing its own update

        return $.ajax({
            url: '/api/Signatories/SaveOrUpdateSignatory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#SignatoryGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }


    //Imageupload

    let selectedContainer = null;
 

    // Add event listeners after the DOM is ready
    document.addEventListener("DOMContentLoaded", function () {
        const containers = document.querySelectorAll('.imagecontainer');

        containers.forEach(container => {
            container.addEventListener('click', () => {
                selectedContainer = container;
                document.getElementById('imageInput').click();
            });
        });

        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file && selectedContainer) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    const base64Image = e.target.result;

                    selectedContainer.innerHTML = '';
                    const img = document.createElement('img');
                    img.src = base64Image;
                    img.style.maxWidth = '100%';
                    selectedContainer.appendChild(img);

                    businessCard1Base64 = base64Image;
                };

                reader.readAsDataURL(file);
                event.target.value = '';
            }
        });
    });



    </script>