@page
@model QD.ERP.Web.Areas.IMS.Pages.ProjectGroupModel
@{
}


<style>
    .dx-datagrid-column-chooser-button {
        display: none !important;
    }

    .dx-fieldset {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 15px;
        padding: 20px;
        background-color: transparent;
        width: 250px;
        height: 10%;
    }


    .dx-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-left: 10px;
    }

    .field-label {
        font-weight: bold;
    }

    .aligned-input {
        width: 100%;
    }
    .input-group {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .dx-textarea {
        width: 100%;
        height: 60px;
    }

    .dx-card {
        width: 1000px;
    }
  
    .container {
        display: none !important;
    }

    .dx-button-text{
        color:black;
    }
    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }
    .playIcon {
        display: none;
    }
    .maincontainer{
        width:97%;
    }
</style>
@* <div class="title">
    <div class="header-container">
        <div id="Projectsub" class="no-border-input"></div>
    </div>
</div> *@
<div>
<div class="" style="width:100%;">
    <!-- Input Fields -->
    <div class="row">
        <div class="col-md-6">
            @(Html.DevExtreme().TextBox().ID("txtGroup").Label(new JS("formatMessage('Type a New Projects Group & Add to the Existing List:')"))
                .LabelMode(EditorLabelMode.Floating).Width("100%").ValidationRules(rules =>
                {
                    rules.AddRequired().Message("Project Group is required");
                }))
        </div>
        <div class="col-md-6" style="display:flex; align-items:end;">
            @(Html.DevExtreme().TextBox().ID("txtGroupArabic").Label(new JS("formatMessage('Projects Group (In Arabic):')"))
                .LabelMode(EditorLabelMode.Floating).Width("100%")
                .Buttons(buttons =>
                {
                    buttons.Add()
                    .Name("convertToArabic3")
                    .Location(TextEditorButtonLocation.After)
                    .Widget(w => w.Button()
                    .Type(ButtonType.Default)
                    .Icon("fas fa-language")
                    .ElementAttr(new { @class = "custom-hover-button add-hover" })
                    .OnClick("convertToArabic"));
                }))
          
        </div>
    </div>

    <div style="display:flex; align-items:end;gap:10px;" >
            @(Html.DevExtreme().TextBox().ID("txtGroupCode").Label(new JS("formatMessage('Group Code:')"))
            .LabelMode(EditorLabelMode.Floating).Width("30%").ValidationRules(rules =>
            {
                rules.AddRequired().Message("Group Code is required");
            }))


        <div class="form-group">
           
            <div id="CategoryComboBox"></div>
        </div>


          
                @(Html.DevExtreme().Button()
                    .ID("btnAdd")
                    .Text(new JS("formatMessage('Add')"))
                    .Icon("plus")
                    .Type(ButtonType.Success)
                    .Width(150)
                    .ElementAttr(new { @class = "custom-ui-button" })
                    .OnClick("function(){addProjectGroupToGrid();}")
                    )
        
    </div>
    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid()
            .ID("SignatoryGrid")
            .KeyExpr("ProjectGroupCode")
            .RemoteOperations(false)
            .DataSource(d => d.WebApi()
            .Controller("ProjectGroup")
            .LoadAction("GetAllProjectGroupData")
            .LoadMode(DataSourceLoadMode.Raw)
            )
            .Editing(editing => editing
            .Mode(GridEditMode.Batch)
            .AllowUpdating(true)
            .AllowDeleting(true)
            .UseIcons(true)
            )
            .Toolbar(toolbar =>
            {
                toolbar.Items(items =>
                {
                    items.Add()
                    .Name("saveButton")
                    .Location(ToolbarItemLocation.After)
                    .Visible(false);

                    items.Add()
                    .Name("revertButton")
                    .Location(ToolbarItemLocation.After)
                    .Visible(false);
                });
            })


            .OnRowUpdating("onProjectGroupUpdating")                       // Handles saving
            .Columns(columns =>
            {
                columns.Add().DataField("ProjectGroupCode").Caption(new JS("formatMessage('Code')")).AllowEditing(false);
                columns.Add().DataField("ProjectGroup").Caption(new JS("formatMessage('Group')"));
                columns.Add().DataField("ProjectGroupAr").Caption(new JS("formatMessage('Project Group (In Arabic)')"));
                columns.Add().DataField("ProjectCategory").Caption(new JS("formatMessage('Category')"));
                columns.Add().DataField("ProjectGroupId").Caption(new JS("formatMessage('ProjectGroupId')")).Visible(false);
                // Add delete button column
                columns.Add()
                .Type(GridCommandColumnType.Buttons)
                .Buttons(buttons =>
                {
                    buttons.Add()
                .Name(GridColumnButtonName.Delete)
                .Icon("trash") // Use a trash icon
                .Hint("Delete Row") // Tooltip
                .OnClick("onDeleteButtonClick");
                });

            })
            .Height("70vh")
            .ColumnAutoWidth(true)
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnFixing(f => f.Enabled(true))
            .Paging(p => p.Enabled(true))
            .Scrolling(s => s
            .Mode(GridScrollingMode.Virtual)
            .RowRenderingMode(GridRowRenderingMode.Virtual)
            .PreloadEnabled(true)
            .ScrollByContent(true)
            )
            .ShowBorders(true)
            .ShowRowLines(true)
            .Width("100%")
            )


    </div>

    <div style="display: flex;gap:10px;">
        <div class="btn-container">
            @(Html.DevExtreme().Button()
            .ID("btnUpdate")
            .Text(new JS("formatMessage('Update')"))
            .Icon("save")
            .ElementAttr(new { @class = "update-button" })
            )
        </div>
        <div class="btn-container">
            @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text(new JS("formatMessage('Back')"))
            .Icon("arrowleft")
            .OnClick("onBackButtonClick")
            .ElementAttr(new { @class = "bold-button" })
            )
        </div>
    </div>
</div>
</div>
<script>
    function onBackButtonClick() {
        window.parent.closeModal();
    }
    
    $(function () {
        const items = [];

        $("#CategoryComboBox").dxSelectBox({
            dataSource: items,
            acceptCustomValue: true,
            label: formatMessage("Category"),              // ✅ Floating Label
        labelMode: "floating",
            onCustomItemCreating: function (e) {
                const newValue = e.text;
                items.push(newValue);
                e.customItem = newValue;
                $("#CategoryComboBox").dxSelectBox("instance").option("dataSource", items);
            },
            onValueChanged: function (e) {
                console.log("Selected/Entered Value:", e.value);
            },
            placeholder: "Enter or select a Sub Group Code",
            searchEnabled: true,
            width: 400
        });
    });



   

     async function convertToArabic() {
        const textBox1Instance = $("#txtGroup").dxTextBox("instance");
        const textBox2Instance = $("#txtGroupArabic").dxTextBox("instance");
        if (!textBox1Instance || !textBox2Instance) {
            console.error("TextBox instances are not properly initialized.");
            return;
        }
        const englishText = textBox1Instance.option("value");
        if (!englishText || englishText.trim() === "") {
            alert("Please enter text to translate.");
            return;
        }
        const arabicTranslation = await translateToArabic(englishText);
        textBox2Instance.option("value", arabicTranslation);
    }
     
    function addProjectGroupToGrid() {
        // Validate fields using the Validator components
        const nameValidationResult = $("#txtGroup").dxValidator("instance").validate();
        const positionValidationResult = $("#txtGroupCode").dxValidator("instance").validate();

        if (!nameValidationResult.isValid || !positionValidationResult.isValid) {
            DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
            return;
        }

        const data = {
            ProjectGroup: $("#txtGroup").dxTextBox("instance").option("value"),
            ProjectGroupAr: $("#txtGroupArabic").dxTextBox("instance").option("value"),
            ProjectGroupCode: $("#txtGroupCode").dxTextBox("instance").option("value"),
            ProjectCategory: $("#CategoryComboBox").dxSelectBox("instance").option("value"),
           
        };

        $.ajax({
            url: '/api/ProjectGroup/SaveOrUpdateProjectGroup',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("ProjectGroup saved successfully!", "success", 2000);
                $("#SignatoryGrid").dxDataGrid("instance").refresh();
            },
            error: function (xhr) {
      
                 const msg = xhr.responseJSON?.message || "Failed to save Projectgroup.";
                DevExpress.ui.notify(msg, "error", 3000);
            }
        });
    }
    $("#btnUpdate").on("click", function () {
        const grid = $("#SignatoryGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });
    function onProjectGroupUpdating(e) {
      
        const data = {
            ProjectGroupId: e.oldData.ProjectGroupId,
            ProjectGroup: e.newData.ProjectGroup ?? e.oldData.ProjectGroup,
            ProjectGroupAr: e.newData.ProjectGroupAr ?? e.oldData.ProjectGroupAr,
            ProjectGroupCode: e.newData.ProjectGroupCode ?? e.oldData.ProjectGroupCode,
            ProjectCategory: e.newData.ProjectCategory ?? e.oldData.ProjectCategory
           };

        e.cancel = true;

        return $.ajax({
            url: '/api/ProjectGroup/SaveOrUpdateProjectGroup',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#SignatoryGrid").dxDataGrid("instance").refresh();
                $("#txtGroup").dxTextBox("instance").option("value","");
                $("#txtGroupArabic").dxTextBox("instance").option("value","");
                $("#txtGroupCode").dxTextBox("instance").option("value","");
                $("#CategoryComboBox").dxSelectBox("instance").option("value","");
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }
    function onDeleteButtonClick(e) {
        e.event.preventDefault(); // prevent default delete

        var grid = $("#SignatoryGrid").dxDataGrid("instance");
        var key = e.row.data.ProjectGroupId; // get the ID of the row

        if (confirm("Are you sure you want to delete this row?")) {
            $.ajax({
                url: '/api/ProjectGroup/Delete?key=' + key,
                type: 'DELETE',
                success: function () {
                    // Refresh the grid after delete
                    grid.refresh();
                    DevExpress.ui.notify("Deleted successfully", "success", 2000);
                },
                error: function () {
                    DevExpress.ui.notify("Delete failed", "error", 2000);
                }
            });
        }
    }
    $(function () {
        $("#Projectsub").dxTextBox({
            text: formatMessage("Project Group"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
</script>