    function dataGridInitialized(e) {
        dataGrid = e.component;
    }

    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }

    function refreshClientCategorySelectBox() {
        const assetCategorySelectBox = $("#ddassetCategory").dxSelectBox("instance");

        if (assetCategorySelectBox) {
            const dataSource = assetCategorySelectBox.getDataSource();

            // Reload the data source and log success or failure
            if (dataSource) {
                dataSource.reload()
                    .then(() => console.log("SelectBox data refreshed successfully."))
                    .catch(error => console.error("Error refreshing SelectBox data:", error));
            } else {
                console.warn("DataSource is not defined for the SelectBox.");
            }
        } else {
            console.error("SelectBox instance not found.");
        }
    }





    // Function to refresh the Asset Location SelectBox
    function refreshAssetLocationSelectBox() {
        const assetLocationSelectBox = $("#ddlassetlocation").dxSelectBox("instance"); // Ensure ID matches Razor

        if (assetLocationSelectBox) {
            const dataSource = assetLocationSelectBox.getDataSource();

            // Reload the data source and log success or failure
            if (dataSource) {
                dataSource.reload()
                    .then(() => {
                        console.log("Asset Location SelectBox updated successfully.");
                    })
                    .catch(error => {
                        console.error("Error updating Asset Location SelectBox:", error);
                    });
            } else {
                console.warn("DataSource is not defined for the Asset Location SelectBox.");
            }
        } else {
            console.error("Asset Location SelectBox instance not found. Ensure the ID matches.");
        }
    }

    // Function to redirect to the Asset Location master form
    function redirectassetmaintanence() {
        // Open the master form in a popup window
        const masterFormWindow = window.open(
            `/${tenantName}/Finance/AssetMaintanenceMaster`, // URL of the master form
            'popupWindow',
            'width=800,height=600,scrollbars=yes,resizable=yes'



        );

        // Monitor the popup window for closure
        const interval = setInterval(() => {
            if (masterFormWindow.closed) {
                clearInterval(interval); // Stop monitoring when the window is closed
                refreshAssetMaintanenceSelectBox(); // Refresh the Asset Location SelectBox
            }
        }, 500);
    }

    // Function to refresh the Asset Location SelectBox
    function refreshAssetMaintanenceSelectBox() {
