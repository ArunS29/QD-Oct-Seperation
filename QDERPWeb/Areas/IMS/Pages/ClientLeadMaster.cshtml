<script>
    
    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const clientCode = urlParams.get("clientCode");
       
         const cleanClientCode = clientCode ? clientCode.split("?")[0] : null;   // Trim off anything after '?' if it's accidentally included in value
       
        if (cleanClientCode) {
            loadClientDetails(cleanClientCode); 
        }
    });

    function loadClientDetails(cleanClientCode) {
        debugger;
    $.ajax({
        url: `/api/ClientLeadMaster/GetClientByCode?clientCode=${cleanClientCode}`,
        type: 'GET',
        success: function (data) {
              $("#btnSave").dxButton("instance").option("text", "Update");
            console.log("binddata:",data);
            if (data) {
                $('#txtClientCode').dxTextBox("instance").option("value", data.ClientCode);
                $('#txtClientName').dxTextBox("instance").option("value", data.ClientName);
                $('#GetProjectDropDown').dxDropDownBox("instance").option("value", data.ClientCategory);
                $('#ClientVisitedOn').dxDateBox("instance").option("value", data.DateVisitedFirst);
                $('#GetLedgerNoDropDown').dxDropDownBox("instance").option("value", data.ClientAccountLedgerNo);
                $('#ClientAddress').dxTextArea("instance").option("value", data.ClientAddress);
                $('#ContactPerson').dxTextBox("instance").option("value", data.ContactPerson);
                $('#Title').dxTextBox("instance").option("value", data.ContactPersonTitle);
                $('#MobileNumber1').dxTextBox("instance").option("value", data.ContactMobile1);
                $('#MobileNumber2').dxTextBox("instance").option("value", data.ContactMobile2);
                $('#PhoneNumber1').dxTextBox("instance").option("value", data.ContactPhone1);
                $('#PhoneNumber2').dxTextBox("instance").option("value", data.ContactPhone2);
                $('#FaxNumber').dxTextBox("instance").option("value", data.ContactFaxNo);
                $('#Email').dxTextBox("instance").option("value", data.ContactEmail);
                $('#GetSalesPersonDropDown').dxDropDownBox("instance").option("value", data.SalesPersonCode);
                $('#VendorCode').dxTextBox("instance").option("value", data.VendorNo);
                $('#Remarks').dxTextArea("instance").option("value", data.ContactRemarks);

                // Load images if present
                if (data.BusinessCard1) {
                    let img1 = "data:image/png;base64," + data.BusinessCard1;
                    $('#imgBox1').html(`<img src="${img1}" />`);
                    businessCard1Base64 = img1;
                }

                if (data.BusinessCard2) {
                    let img2 = "data:image/png;base64," + data.BusinessCard2;
                    $('#imgBox2').html(`<img src="${img2}" />`);
                    businessCard2Base64 = img2;
                }
            }
        },
        error: function () {
            DevExpress.ui.notify("Error loading client details", "error", 3000);
        }
    });
}


