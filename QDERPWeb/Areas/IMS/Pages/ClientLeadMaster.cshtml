    function updateAsset() {

        var purchaseDate = $("#txtPurchasedDate").dxDateBox("instance").option("value");
      //  alert(purchaseDate);
        if (purchaseDate) {
            var dateParts = purchaseDate.split("/");
            if (dateParts.length === 3) {
                var validDate = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);

                if (!isNaN(validDate.getTime())) {
                    var formattedpurchaseDate = validDate.toLocaleDateString('en-CA');

                } else {
                    console.log("Invalid date");
                }
            } else {
                console.log("Invalid date format");
            }
        } else {
            console.log("No date selected");
        }
        var StartDate = $("#txtStartDate").dxDateBox("instance").option("value");
        console.log(StartDate);
        if (StartDate) {
            // Ensure StartDate is a Date object
            var validDate = new Date(StartDate);

            if (!isNaN(validDate.getTime())) {
                // Format the date as yyyy-mm-dd
                var formattedStartDate = validDate.getFullYear() + '-' +
                    ('0' + (validDate.getMonth() + 1)).slice(-2) + '-' +
                    ('0' + validDate.getDate()).slice(-2);

                console.log(formattedStartDate);  // Example output: 2025-01-02
            } else {
                console.log("Invalid date");
            }
        } else {
            console.log("No date selected");
        }
        var EndDate = $("#txtEndDate").dxDateBox("instance").option("value");

        if (EndDate) {
            // Ensure EndDate is a Date object
            var validEndDate = new Date(EndDate);

            if (!isNaN(validEndDate.getTime())) {
                // Format the date as yyyy-mm-dd
                var formattedEndDate = validEndDate.getFullYear() + '-' +
                    ('0' + (validEndDate.getMonth() + 1)).slice(-2) + '-' +
                    ('0' + validEndDate.getDate()).slice(-2);

                console.log(formattedEndDate);  // Example output: 2025-01-02
            } else {
                console.log("Invalid date");
            }
        } else {
            console.log("No date selected");
        }


        var updatedAsset = {
            "AssetLedgerNo": $("#txtacctledno").dxTextBox("instance").option("value"),
            "AssetCategory": $("#ddassetCategory").dxSelectBox("instance").option("value"),
            "PlateNo": $("#txtplatno").dxTextBox("instance").option("value"),
            "AssetDescription": $("#txtAssetDescription").dxTextBox("instance").option("value"),
            "AssetLocation": $("#ddlassetlocation").dxSelectBox("instance").option("value"),
            "Specifications": $("#txtspecifications").dxTextArea("instance").option("value") || "",
            "ValueOfProperty": $("#PurchasedAssetValue").dxNumberBox("instance").option("value"),
            "PurchaseDate": formattedpurchaseDate,
            "InstallmentStartDate": formattedStartDate,
            "InstallmentEndDate": formattedEndDate,
            "PurchasedFrom": $("#txtPurchasedFrom").dxTextBox("instance").option("value"),
            "PurchasedAs": $("#ddlPurchasedAs").dxSelectBox("instance").option("value"),
            "CurrentCondition": $("#txtCurrentCondition").dxSelectBox("instance").option("value"),
            "AssetType": $("#txtAssetType").dxTextBox("instance").option("value"),
            "Brand": $("#txtBrand").dxTextBox("instance").option("value"),
            "Year": $("#txtYear").dxTextBox("instance").option("value"),
            "Model": $("#txtModel").dxTextBox("instance").option("value"),
            "FMV": $("#txtFMV").dxNumberBox("instance").option("value"),
            "BMV": $("#txtBMV").dxNumberBox("instance").option("value"),
            "NoOfInstallments": $("#txtNoOfInstallments").dxNumberBox("instance")?.option("value") || 0,
            "InitialDownPayment": $("#txtDownpayment").dxNumberBox("instance")?.option("value") || 0,
            "MonthlyInstallment": $("#txtMonthlyInstallment").dxNumberBox("instance")?.option("value") || 0,
            "FinalInstallment": $("#txtFinalPayment").dxNumberBox("instance")?.option("value") || 0,
            "FinancedBy": $("#txtFinanceBy").dxTextBox("instance").option("value"),
            "PropertyNo": $("#ddlpropertyno").dxDropDownBox("instance")?.option("value"),
            "IsFinanced": $("#Ispropertychk").dxCheckBox("instance")?.option("value") || false,
            "ScrapValueOfProperty": $("#txtScarpValue").dxNumberBox("instance")?.option("value") || 0,
            "DepreciationMethod": $("#txtDepreciationMethod").dxSelectBox("instance").option("value"),
            "DepPercentage": $("#txtDepPercentage").dxNumberBox("instance").option("value")
        };

        console.log("Updated Asset Data:", updatedAsset);

        // Perform AJAX request to update asset
        $.ajax({
            url: "/api/assetview/updateAsset",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(updatedAsset),
            success: function (response) {
                alert(response.message || "Asset updated successfully!");
            },
            error: function (xhr) {
                console.error("Error Response:", xhr);
                alert(xhr.responseJSON?.message || "An error occurred during the update process.");
            }
        });
    }

    function formatDate(date) {
        if (date instanceof Date && !isNaN(date)) {
            return date.toISOString().split('T')[0]; // returns the date part in yyyy-MM-dd format
        }
        return null; // If the date is invalid, return null
    }

