function generateNextClientCode(categoryCode) {
 
    $.ajax({
        url: `/api/ClientLeadMaster/GetLatestClientCode?categoryCode=${categoryCode}`,
        type: 'GET',
        success: function (latestCode) {
            let nextNumber = 1;

            if (latestCode) {
                const parts = latestCode.split("-");
                if (parts.length === 2 && !isNaN(parts[1])) {
                    nextNumber = parseInt(parts[1]) + 1;
                }
            }

            // ✅ Format with leading zeros (e.g., "0004")
            const formattedNumber = String(nextNumber).padStart(4, '0');
            const newClientCode = `${categoryCode}-${formattedNumber}`;

            $("#txtClientCode").dxTextBox("instance").option("value", newClientCode);
        },
        error: function () {
            DevExpress.ui.notify("Error getting latest Client Code", "error", 3000);
        }
    });
}



