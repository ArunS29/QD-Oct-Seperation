@page
@model QD.ERP.Web.Areas.IMS.Pages.QuotationGridFormModel
@{
}
<style>
    .calc-container {
        width: 460px;
        padding: 10px;
        margin-left: 35%;
    }

    .calc-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        gap: 8px;
    }

    .calc-label {
        flex: 1;
    }

    .calc-input {
        flex: 1;
    }

    .add-btn {
        margin-top: 2px;
    }

    .light-section {
        padding: 10px;
    }

    .dark-section {
        padding: 10px;
    }

    .highlight-box input {
        font-weight: bold;
    } 

    .loss-box input {
        font-weight: bold;
    }

    .dx-button-text {
        font-weight: 600;
        color:black;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        width: 100%;
    }

    .playIcon {
        display: none;
    }


</style>

<div class="calc-container">
    <!-- Light Section -->
    <div class="light-section">
        <div class="calc-row">
            <div class="calc-input">
                @(Html.DevExtreme().NumberBox()
                    .ID("ItemCost")
                      .Label("Items Cost Price:")
                    .LabelMode(EditorLabelMode.Floating)
                    .Value(1.00)
                    .Format("#,##0.00")
                    .Width("100%"))
            </div>
        </div>
        <div class="calc-row">
            <div class="calc-input">
                @(Html.DevExtreme().TextBox().ID("OtherCharges").Width("100%").Label("All Other Charges:")
                                .LabelMode(EditorLabelMode.Floating))
            </div>
            <div class="add-btn">
                @(Html.DevExtreme().Button().Icon("plus").Text("Add").Type(ButtonType.Default).OnClick("AddOnclick"))
            </div>
        </div>

        <div class="calc-row">
            <div class="calc-input">
                @(Html.DevExtreme().NumberBox()
                        .ID("TotalCostItem").Label("Total Cost of the Item:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Value(1.00)
                        .Format("#,##0.00")
                        .Width("100%")
                        .ElementAttr("class", "highlight-box"))
            </div>
        </div>
    </div>

    <!-- Dark Section -->
    <div class="dark-section">
        <div class="calc-row">
            <div class="calc-label">
                @(Html.DevExtreme().Button()
                        .ID("AddMargin")
                        .Icon("edit") 
                        .Text("Add Profit Margin"))
            </div>
            <div class="calc-input">
                @(Html.DevExtreme().NumberBox()
                        .ID("ProfitMargin")
                        .ShowSpinButtons(true)
                        .Value(25.00)
                                .Format("#0.00' %'")

                                .Width("100%"))
            </div>
           
           
        </div>
        <div class="calc-row">
        <div class="calc-input">
            @(Html.DevExtreme().NumberBox()
                        .ID("UnitPriceProfit")
                        .Label("Unit Price with Profit:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Value(1.00)
                        .Format("#,##0.00")
                        .Width("100%"))
        </div>
        </div>
        <div class="calc-row">
            <div class="calc-input">
                @(Html.DevExtreme().NumberBox()
                        .ID("QuotedPrice")
                        .Label("Quoted Item Total Price:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Value(1.00)
                        .Format("#,##0.00")
                        .Width("100%"))
            </div>
        </div>

        <div class="calc-row">
            <div class="calc-input">
                @(Html.DevExtreme().NumberBox()
                                .ID("Discount")
                                .ShowSpinButtons(true)
                                .Label("Discount on the Items:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Value(0.00)
                                .Format("#,##0.00")
                                .Width("100%"))
            </div>
        </div>

        <div class="calc-row">
            <div class="calc-input">
                @(Html.DevExtreme().NumberBox()
                                .ID("ProfitLoss")
                                .Value(0.00)
                                .Label("Item Profit / Loss:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Format("#,##0.00")
                                .Width("100%")
                                .ElementAttr("class", "loss-box"))
            </div>
        </div>

        <div class="calc-row" style="justify-content: flex-end;">
            @(Html.DevExtreme().Button()
                        .ID("ApplyClose")
                        .Text("Apply&Close")
                        .Type(ButtonType.Success)
                        .OnClick("applyProfitAndClose"))
        </div>
    </div>
</div>
<script>
    let quoteNo = null;let gsCode=null;let costPrice=null;let totalCost=null; let discount=null;let QuotedQuantity=null;let QuoteChildId=null;
       $(function () {
        const params = new URLSearchParams(window.location.search);
          gsCode = params.get("GsCode") || "";
     quoteNo = params.get("QuoteNos") || "";
      QuoteChildId = params.get("quoteChildId") || "";
     gsDesc1 = params.get("GSDesc1") || "";
      QuotedQuantity = params.get("QuotedQuantity") || "";

    console.log("GS Code:", gsCode);
    console.log("Quotation No:", quoteNo);
    console.log("GS Desc1:", gsDesc1);
      console.log("childid:", QuoteChildId);
        const unitPrice = parseFloat(params.get("UnitPrice")) || 0;
         totalCost = parseFloat(params.get("TotalCost")) || 0;
        const profitOrLoss = parseFloat(params.get("ProfitLoss")) || 0;
         discount =params.get("Discount") || 0;
         costPrice = params.get("CostPrice") || 0;
        const total = parseFloat(params.get("Total")) || 0;
        const VAT = parseFloat(params.get("VAT")) || 0;

        const QuotedItemTotalPrice = total - VAT - discount;
   
        $("#ItemCost").dxNumberBox("instance").option("value", costPrice);
        $("#TotalCostItem").dxNumberBox("instance").option("value", costPrice);
        $("#UnitPriceProfit").dxNumberBox("instance").option("value", unitPrice);
        $("#QuotedPrice").dxNumberBox("instance").option("value", unitPrice);
         $("#ProfitLoss").dxNumberBox("instance").option("value", profitOrLoss);
        $("#Discount").dxNumberBox("instance").option("value", discount);
    });
        function AddOnclick() {
      
        const url = `/${tenantName}/IMS/AdditionalCostOnItems`
            + `?CostPrice=${encodeURIComponent(costPrice)}`
            + `&Discount=${encodeURIComponent(discount)}`
            + `&TotalCost=${encodeURIComponent(totalCost)}`
            + `&GsCode=${encodeURIComponent(gsCode)}`
           + `&QuotedQuantity=${encodeURIComponent(QuotedQuantity)}`
            + `&QuoteNos=${encodeURIComponent(quoteNo)}`
             + `&QuoteChildId=${encodeURIComponent(QuoteChildId)}`;

        console.log("🔗 Navigation URL:", url);
        openModal(url, "Quoted:Cost Items","100%","80%");
    }
           $(function () {
        $("#AddMargin").dxButton("instance").option("onClick", function () {
            try {
                const totalCost = $("#TotalCostItem").dxNumberBox("instance").option("value") || 0;
                const qty = parseFloat(QuotedQuantity) || 1;
                const profitPercentage = $("#ProfitMargin").dxNumberBox("instance").option("value") || 0;

                if (qty <= 0) {
                    DevExpress.ui.notify("Quantity must be greater than 0", "error", 3000);
                    return;
                }

                // Convert entered percentage (25) to 0.25
                const profitFactor = profitPercentage / 100;

                // Apply same VB formula
                const unitPriceWtProfit = (totalCost / qty) * (1 + profitFactor);

                // Round to 2 decimals like VB
                const roundedValue = Math.round(unitPriceWtProfit * 100) / 100;

                $("#UnitPriceProfit").dxNumberBox("instance").option("value", roundedValue);

                DevExpress.ui.notify("Unit Price with Profit calculated successfully", "success", 2000);

            } catch (ex) {
                console.error("Calculation error:", ex);
                DevExpress.ui.notify("Error in calculation. Please try again.", "error", 3000);
            }
        });
    });
    // Collect modal fields
    function collectModalFields() {
        return {
            QuotedUnitPrice:  $("#UnitPriceProfit").dxNumberBox("instance").option("value")
        };
    }

    // Send data to parent when modal is closing (optional)
    window.onbeforeunload = function () {
        if (window.opener && typeof window.opener.receiveModalFieldData3 === "function") {
            const fieldValues = collectModalFields();
            window.opener.receiveModalFieldData3(fieldValues);
        }
    };


    // Apply discount and close modal
    function applyProfitAndClose() {
        const modalData3 = {
            QuotedUnitPrice:  $("#UnitPriceProfit").dxNumberBox("instance").option("value")
        };

        console.log("📤 Sending to parent:", modalData3);

        if (window.parent && typeof window.parent.receiveModalFieldData3 === "function") {
            window.parent.receiveModalFieldData3(modalData3);
            window.parent.closeModal(); // your custom modal close logic
        } else {
            alert("❌ Could not send costPrice data to parent.");
        }
    }



</script>

    

