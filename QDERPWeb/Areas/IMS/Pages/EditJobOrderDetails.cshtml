                                                                        .LabelMode(EditorLabelMode.Floating)
                                                                        )

                                </td>
                                <td>
                                    @(Html.DevExtreme().SelectBox()
                                                                        .ID("cbMaterialValue")
                                                                        .Items(new[] {
                                                                        "WCB", "WCC", "WC6", "CF8", "CF8M", "CF8C", "CF3M",
                                                                        "LCB", "LF2", "DI", "CI", "CARBON STEEL", "STAINLESS STEEL",
                                                                        "MILD STEEL", "A105", "A105N", "A516 GR.70", "ALUMINIUM",
                                                                        "BRONZE", "C5", "C12", "CD4MCU", "CD4MCUN", "CD3MN",
                                                                        "CF3M", "CN7M", "316", "GGG 25", "LCC", "HCPH2",
                                                                        "WC1", "WC9"
                                                                        })
                                                                        .Placeholder("Select or type material")
                                                                        .SearchEnabled(true)
                                                                        .ShowClearButton(true)
                                                                        .AcceptCustomValue(true)
                                                                        .OnCustomItemCreating("onComboMaterial_CustomItemCreating")
                                                                        .Label(new JS("formatMessage('Material:')"))
                                                                        .LabelMode(EditorLabelMode.Floating)
                                                                        )

                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("TagNo").Width("100%").Label(new JS("formatMessage('Tag No:')"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        )
                                </td>
                                <td>
                                    @(Html.DevExtreme().TextBox().ID("ClientProject").Width("100%").Label(new JS("formatMessage('Client Project:')"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        )
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    @(Html.DevExtreme().SelectBox()
                                                                        .ID("cbClassValue")
                                                                        .Items(new[] {
                                                                        "125", "150", "300", "600", "800",
                                                                        "900", "1500", "2500"
                                                                        })
                                                                        .Placeholder("Select or type class")
