                                 DevExpress.ui.notify("Please enter or select a JobOrderNo Entry to delete.", "warning", 3000);
                     return;
                 }

                 $.ajax({
                  url: "/api/EditJobOrderDetails/DeleteJobOrder",
                     type: 'POST',
                     contentType: 'application/json',
                                 data: JSON.stringify(JobOrderNo), // 👈 plain string
                     success: function (response) {
                         DevExpress.ui.notify(response.message, 'success', 3000);
                         setTimeout(function () {
                             location.reload();
                         }, 2000);
                     },
                     error: function (xhr) {
                         const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                         DevExpress.ui.notify(msg, 'error', 3000);
                     }
                 });
