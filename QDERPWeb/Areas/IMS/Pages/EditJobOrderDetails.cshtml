                            @(Html.DevExtreme().Button()
                            .ID("btnAddletter")
                            .Icon("Aa")
                            .ElementAttr("class", "button-alignment-down button-group")
                            )
                     <div>
                    </div>
                        </div>  
                </div>
            </div>

        </text>);
             item.Add().Text("Branch / Division").Icon("home").Title("Branch / Division").Template(@<text>
