                    </div>
                    <div class="col-md-3" style="display:flex;align-items:end;">
                            @(Html.DevExtreme().DropDownBox()
                                                    .Label(new JS("formatMessage('Job Order Status')"))
                                                    .AcceptCustomValue(true)
                                                    .DataSource(d => d.WebApi()
                                                    .Controller("EditJobOrderDetails")
                                                    .LoadAction("GetJobOrderStatus")
                                                    .LoadMode(DataSourceLoadMode.Raw)
                                                    .Key("JobOrderStatusId")
                                                    )
                                                    .LabelMode(EditorLabelMode.Floating)
                                                    .ID("ddJobOrderStatus")
                                                    .Width(900)
                                                    .OpenOnFieldClick(false)
                                                    .ValueChangeEvent("input")
                                                    .HoverStateEnabled(true)
                                                    .ValueExpr("JobOrderStatusId")
                                                    .DisplayExpr("JobOrderStatus")
                                                    .OnInput("dropDownBoxOnInput")
                                                    .OnOpened("onOpened")
                                                    .TabIndex(1)
                                                    .Width("100%")
                                                    .OnKeyDown("onKeyDown")
                                                    .ContentTemplate(new TemplateName("GetJobOrderStatusContentTemplate"))
                                                    )
                        @(Html.DevExtreme().Button()
                        .ID("btnAddSalesperson")
                        .Icon("plus")
                        .ElementAttr("class", "button-alignment-down button-group")
                        .OnClick("redirecttosalespersonmaster")
                        )
                    </div>
                    <div class="col-md-2" style="display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("txtJobDescription")
                         .Label("Job Description:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        )
                        @(Html.DevExtreme().Button()
                        .ID("btnAddletter")
                        .Icon("fa fa-text-height")
                        .ElementAttr("class", "button-alignment-down button-group")
                        )
                     <div>
                    </div>
                    </div>  
                </div>
            </div>
        </text>);
             item.Add().Text("Branch / Division").Icon("home").Title("Branch / Division").Template(@<text>
            <div class="dx-card p-3">
                <div class="row g-3">
                                                                                                                       <!-- Row 1: Branch / Delivery Type / Inventory Group -->  
                    <div class="col-md-4" style="display:flex;">
