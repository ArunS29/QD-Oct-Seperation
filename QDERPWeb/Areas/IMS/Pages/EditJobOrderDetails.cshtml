                        .Width("40%")
                        )   

                    </div>
                </div>
            </div>
        </text>);

                    })
                )
                <style>
                    .joborder-container {
                        display: flex;
                        height: 90vh;
                    }

                    .joborder-tabs {
                        width: 220px;
                        padding-top: 10px;
                        min-height: 100%;
                        border: 1px solid #ddd;
                    }

                    .joborder-content {
                        flex: 1;
                        padding: 18px 18px 0 18px;
                    }

                    .joborder-form-table {
                        width: 100%;
                        border-collapse: separate;
                        border-spacing: 10px 8px;
                    }

                        .joborder-form-table td {
                            padding: 0;
                            vertical-align: middle;
                        }

                    .manual-valves-cell {
                        background: #d3d3d3;
                        font-weight: bold;
                        padding: 4px 8px;
                        color: #222;
                        border-radius: 2px;
                    }

                    .joborder-desc-label {
                        font-weight: bold;
                        font-size: 13px;
                        margin-bottom: 4px;
                        display: block;
                    }

                    .joborder-footer {
                        display: flex;
                        justify-content: space-between;
                        font-size: 12px;
                        margin-top: 4px;
                        padding: 0 2px;
                    }
                </style>
        <div class="joborder-container">
            <!-- Left Vertical Tabs -->
