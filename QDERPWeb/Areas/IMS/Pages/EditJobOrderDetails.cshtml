                new { id = 3, text = "Visual Inspection", icon = "find" },
                new { id = 4, text = "Repair Report", icon = "preferences" },
                new { id = 5, text = "Dispatch Report", icon = "car" }
                })
                    .DisplayExpr("text")
                    .KeyExpr("id")
                    .SelectionMode(ListSelectionMode.Single)
                    .SelectedItemKeys(new[] { 1 })
                    .OnItemClick("onJobOrderTabClick")
