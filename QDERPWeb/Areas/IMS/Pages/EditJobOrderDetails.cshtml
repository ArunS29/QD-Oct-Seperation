            // Fetch updated min/max dynamically
            let rowIndex = cellInfo.row.rowIndex;
            let updatedRow = dataGrid.getDataSource().items()[rowIndex] || {};
            let maxQty = updatedRow.MaxQty || 0;
            let minQty = updatedRow.MinQty || 0;

            console.log("Validation Check -> MinQty:", minQty, "MaxQty:", maxQty, "NewQty:", newQty);

            if (newQty > maxQty) {
                console.warn(`Qty ${newQty} exceeds MaxQty ${maxQty}`);

                DevExpress.ui.dialog.confirm(
                    `The quantity you entered (${newQty}) exceeds the allowed maximum (${maxQty}).`,
                    "Quantity Limit Exceeded"
                ).done(function () {
                    // Optional: you can add confirmation handling here if needed
                });

                setTimeout(() => {
                    DevExpress.ui.notify(`The maximum allowed quantity is ${maxQty}.`, "error", 3000);
                }, 100); // Give it slight delay to ensure render

                e.component.option("value", maxQty);
                cellInfo.setValue(maxQty);
