       $(document).ready(function () {
              const params = new URLSearchParams(window.location.search);
              const jobOrderNos = params.get('JobOrderNo') || null;
              const jobOrderNo = jobOrderNos ? jobOrderNos.split("?")[0] : null;

              if (jobOrderNo) {
                console.log('Got JobOrderNo:', jobOrderNo);
                loadJobOrderDetails(jobOrderNo);
              } else {
                console.warn('No JobOrderNo in URL');
              }
            });

