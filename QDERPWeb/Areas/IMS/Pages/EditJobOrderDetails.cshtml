                                                                        "DE-SUPER HEATER VALVE", "HALF BALL VALVE", "ORBIT VALVE", "DAMPER VALVE", "SNAP VALVE",
                                                                        "GEAR BOX ONLY", "ACTUATOR ONLY", "MOV ONLY"
                                                                        })
                                                                        .Placeholder("Select or type valve type")
                                                                        .SearchEnabled(true)
                                                                        .ShowClearButton(true)
                                                                        .AcceptCustomValue(true)                            // Enables typing new values :contentReference[oaicite:1]{index=1}
                                                                        .OnCustomItemCreating("onComboValve_CustomItemCreating")
                                                                        .Label(new JS("formatMessage('Type:')"))
                                                                        .LabelMode(EditorLabelMode.Floating)
