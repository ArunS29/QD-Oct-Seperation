<style>

    /* Ensure tab text is styled properly */
    .dx-tabpanel .dx-tab {
        color: black !important; /* Set the tab text color to black */
        font-weight: bold; /* Optionally make the text bold */
        font-size: 14px; /* Adjust font size for better visibility */
        padding: 10px 15px; /* Increase padding for better appearance */
    }

        /* Optional: Adjust the selected tab styling */
        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue; /* Highlight selected tab with a background */
            color: white !important; /* Set selected tab text color */
        }

    /* Add a gray border around the tab panel */
    .dx-tabpanel {
        /*  border: 2px solid gray;  Set the border color to gray */
        /* border-radius: 5px;  Optionally, add rounded corners to the border */
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        margin: 15px;
        width: 99%;
        padding: 5px; /* Optional: Add some padding inside the border */
        border-radius: 1px; /* Optional: Rounded corners */
    }

    .form-container {
        width: 100%;
        border-radius: 1px; /* Optional: Rounded corners */
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 97%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }
 
    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
        /*  background-color: white; */
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px; /* Add some space between the form and footer */
    }

    .footer-buttons .col-md-1 {
        /*  padding-left: 10px;
                                            padding-right: 10px; */
    }

    /* Adds border to form control elements */
    .form-control-with-border {
        /* border: 1px solid gray; */
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }
    /* Optional: Adds a border to the form-row as a whole */
    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }


   
    .select-box {
        width: 20vh;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .flex-row {
        display: flex;
        align-items: end;
    }

</style>
