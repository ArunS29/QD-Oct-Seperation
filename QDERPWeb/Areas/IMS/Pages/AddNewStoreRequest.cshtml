                        valueExpr: "UnitCode",  // Binds the dropdown value to UnitDesc
                    displayExpr: "UnitDesc", // Shows UnitDesc in the dropdown
                    value: cellInfo.value,   // Set initial value

                    dropDownOptions: { width: 600 },

                    contentTemplate: function (e) {
                        return $("<div>").dxDataGrid({
                            dataSource: dropdownData,
                            selection: { mode: "single" },
                            keyExpr: "UnitCode",
                            height: 300,
                            scrolling: { mode: "virtual" },
                            columns: [
                                { dataField: "UnitCode", caption: "Unit Code", width: 150 },
                                { dataField: "UnitDesc", caption: "Unit Description", width: 150 }
                            ],
                            onSelectionChanged: function (selectedItems) {
                                let selectedItem = selectedItems.selectedRowsData[0];

                                if (selectedItem) {
                                    // 1️⃣ Set the selected value in PropertyOrEquipment
                                    cellInfo.setValue(selectedItem.UnitDesc);

                                    // 2️⃣ Get the parent DataGrid instance and row index
                                    let dataGrid = $("#itemGrid").dxDataGrid("instance");
                                    let rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);

                                    // 3️⃣ Set UnitRateMethod column in the same row
                                    if (rowIndex !== -1) {
                                            dataGrid.cellValue(rowIndex, "UnitRateMethod", selectedItem.UnitCode || "");
                                    }
                                }
                            }
                        });
                    }
                });
            });
        }
    },
                ],

                editing: {

                    mode: "cell"

                     // allowUpdating: true,
                     // allowAdding: false, // We'll add manually
                     // allowDeleting: true

                },

                onInitNewRow: function (e) {

                    e.data.SNo = rowData.length + 1; // Auto-generate SNo

                },

                columnAutoWidth: true,

                showBorders: true,

            }).dxDataGrid("instance");

        });

            $("#btnAddNewPayment").on("click", function (e) {
                var newRow = {
                    SNo: rowData.length + 1, // Auto-generate SNo
                        ItemCode: "",
                        StockDescription: "",
                        UnitRateMethod: 0,
                        Qty: 0.00,
                        UnitCostPrice:0.00,
                        EmployeeName:"",
                        PropertyOrEquipment:"",

                };

                rowData.push(newRow);
                dataGridInstance.option("dataSource", rowData);
                dataGridInstance.refresh();
            });
