    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("600px")
        .ShowBorders(true)
        .AllowColumnReordering(true) 
        .AllowColumnResizing(true)
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )
        .Columns(columns =>
        {
            // No need to add a column for checkboxes — it appears automatically with selection config

            columns.Add().Caption("#").CellTemplate(@<text>
        @(ViewData["rowIndex"] = ((int)(ViewData["rowIndex"] ?? 0)) + 1)
        @ViewData["rowIndex"]
    </text>).Width(30);

            columns.Add().DataField("SubGroup").Caption("SubGroup");
            columns.Add().DataField("ItemCode").Caption("Item Code");
            columns.Add().DataField("Description").Caption("Description");
            columns.Add().DataField("...").Caption("...");
            columns.Add().DataField("UnitRateMethod").Caption("Unit Rate Method");
            columns.Add().DataField("Qty").Caption("Qty");
            columns.Add().DataField("ExpectedPrice").Caption("Expected Price").Format("currency");
            columns.Add().DataField("LineTotal").Caption("Line Total").Format("currency");
        })
