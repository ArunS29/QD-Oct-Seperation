    @(Html.DevExtreme().DataGrid()
            .ID("itemGrid")
            .Height("600px")
            .DataSource(new JS("[]")) // using global JS array
            .KeyExpr("ItemCode")
            .Selection(s => s
            .Mode(SelectionMode.Multiple)
            .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
            )
            .Editing(editing => editing
            .Mode(GridEditMode.Row)
            .AllowAdding(true)
            .AllowUpdating(true)
            .AllowDeleting(true)
            )
            .Columns(columns =>
            {
                columns.Add().DataField("SNo").Caption("#").Width(50).AllowEditing(false);
                columns.Add().DataField("ItemCode").Caption("Item Code").Width(120);
                columns.Add().DataField("StockDescription").Caption("Stock Description").Width(180);
                columns.Add().DataField("UnitRateMethod").Caption("Unit Rate Method").Width(120);
                columns.Add().DataField("Qty").Caption("Qty").Width(80).DataType(GridColumnDataType.Number);
                columns.Add().DataField("UnitCostPrice").Caption("Unit Cost Price").Format("currency").Width(120);
                columns.Add().DataField("EmployeeName").Caption("Employee Name").Width(160);
                columns.Add().DataField("PropertyOrEquipment").Caption("Property/Equipment").Width(180);
                columns.Add().DataField("MaxQty").Caption("MaxQty").Width(180).Visible(false);
                columns.Add().DataField("MinQty").Caption("MinQty").Width(180).Visible(false);


            })
            .ColumnAutoWidth(true)
            .Width("100%")
            .WordWrapEnabled(true)

            .ColumnChooser(cc => cc
            .Enabled(true)
            .Title("Show/Hide Column")
            .Mode(GridColumnChooserMode.Select)
            )
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnFixing(fixing => fixing.Enabled(true))
            .HeaderFilter(filter => filter.Visible(false))
            .Paging(p => p.Enabled(false))
            .Pager(pager => pager.Visible(false))
            .Grouping(grouping => grouping.AutoExpandAll(true))
            .FilterRow(filterRow => filterRow.Visible(false))
            .GroupPanel(groupPanel => groupPanel.Visible(false))
            .ShowBorders(true)
            .ShowRowLines(true)
            )
</div>
@using (Html.DevExtreme().NamedTemplate("PreparedByTemplate"))
{
    @(Html.DevExtreme().DataGrid()
                .ID("preparedby-datagrid")
                .DataSource(d => d.WebApi()
                    .Controller("AddNewClientRequest")
                    .LoadAction("GetSignatory")
                    .LoadMode(DataSourceLoadMode.Raw)
                    .Key("SignatoryID")
                )
                .WordWrapEnabled(true)
                .ShowBorders(true)
                .SearchPanel(sp => sp.HighlightSearchText(true))
                .Selection(sl => sl.Mode(SelectionMode.Single))
                .OnSelectionChanged("dataGridPreparedByHeadSelectionChanged")
                .OnInitialized("dataGridPreparedByHeadInitialized")
                .Paging(p => p.PageSize(15))
                .FilterRow(f => f.Visible(true))
                .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
                .Height(345)
                .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
                .Columns(columns =>
