<script>
        function openEntityModal(entity) {
        const url = `/${tenantName}/IMS/${entity}`;
        const title = "";
        openModal(url, title);
    }

    function PreparedBy() {
        openEntityModal("Signatories");
    }

    function AddReqUnit1() {
        openEntityModal("ProjectSubUnits");
    }

    function ModeOfRequest() {
        openEntityModal("QuotationModeOfRequest");
    }

    function TypeOfRequest() {
        openEntityModal("QuotationTypeOfRequest");
    }
