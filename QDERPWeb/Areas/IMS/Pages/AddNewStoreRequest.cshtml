        /*  background-color: white; */
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px; /* Add some space between the form and footer */
    }

    .footer-buttons .col-md-1 {
        /*  padding-left: 10px;
                                            padding-right: 10px; */
