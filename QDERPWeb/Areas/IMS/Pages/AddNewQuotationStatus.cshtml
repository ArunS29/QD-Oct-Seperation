@* <div class="title">
    <div class="header-container">
        <div id="QuotationStatus" class="no-border-input"></div>
    </div>
</div> *@
<div class="dx-card-header minimal-header">
    <div class="card-title-icon">
        <i class="fas fa-file-invoice-dollar"></i>
    </div>
    <h3 class="card-title-text">Quotation Status</h3>
</div>
<div class="quotation-form-container">
    <div id="DatabaseSignatories" class="no-border-title"></div>

    <div class="form-row">
        <div class="col-md-6">
            @(Html.DevExtreme().TextBox()
                .ID("txtQuotationStatus")
                .Label(new JS("formatMessage('Type new Quotation Status & Add to the Existing List:')"))
                .LabelMode(EditorLabelMode.Floating)
                .ValidationRules(rules =>
                {
                    rules.AddRequired().Message("Status is required");
                })
                )

        </div>
  

   
        <div class="col-md-2">
            @(Html.DevExtreme().Button()
                .ID("btnAddQuotationStatus")
                .Text(new JS("formatMessage('ADD')"))
                .Icon("plus")
                .OnClick("function() { addQuotationStatus(); }")
                .ElementAttr(new { @class = "dx-button-add" })
                )
        </div>
    </div>
    </div>




    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid()
            .ID("QuotationStatusGrid")
        .KeyExpr("QuotationStatusId")
            .RemoteOperations(false)
            .DataSource(d => d.WebApi()
        .Controller("AddNewQuotationStatus")
        .LoadAction("GetQuotationStatus")
            .LoadMode(DataSourceLoadMode.Raw)
            )
            .Editing(editing => editing
            .Mode(GridEditMode.Batch)
            .AllowUpdating(true)
            .AllowDeleting(true)
            )
            .Toolbar(toolbar =>
            {
                toolbar.Items(items => { }); // hide default toolbar
            })
            .OnRowUpdating("onQuotationStatusUpdating")                       // Handles saving
            .Columns(columns =>
            {
            columns.Add().DataField("QuoteStatusId").Caption(new JS("formatMessage('ID')")).Width(80).AllowEditing(false);
            columns.Add().DataField("QuoteStatus").Caption(new JS("formatMessage('Status')")).Width(200);
            columns.Add()
            .Caption(new JS("formatMessage('Action')")).Width(100)
            .Type(GridCommandColumnType.Buttons)
            .Buttons(buttons =>
            {
                buttons.Add()
                .Name(GridColumnButtonName.Delete)
                .Icon("trash") // Use a trash icon
                .Hint("Delete Row") // Tooltip
                .OnClick("onDeleteButtonClick");
                });
            })
            .Height(500)
            .ColumnAutoWidth(true)
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnFixing(f => f.Enabled(true))
            .Paging(p => p.Enabled(true))
            .Scrolling(s => s
            .Mode(GridScrollingMode.Virtual)
            .RowRenderingMode(GridRowRenderingMode.Virtual)
            .PreloadEnabled(true)
            .ScrollByContent(true)
            )
            .ShowBorders(true)
            .ShowRowLines(true)
            .Width("100%")
            )


    </div>


    <div class="footer-fixed">
    @await Html.PartialAsync("InventoryModuleFooter")
    </div>
    <script>

        $(document).ready(function () {

              $(".limited-footer .btn-containerIvoiceEdit").each(function () {

                  if (!$(this).find("#btnUpdate,#btnBack").length) {

                      $(this).remove();

                  }

              });

          });

        $(document).on("click", "#btnBack", function () {
            window.history.back();
        });

        
          $(function () {
                $("#DatabaseSignatories").dxTextBox({
                    text: formatMessage("Database "),
                    readOnly: true,


                });
            });

        $(function () {
        $("#QuotationStatus").dxTextBox({
            text: formatMessage("Quotation Status"),
                readOnly: true,
                onContentReady: function (e) {
                    $(e.element).addClass("dx-textbox-heading");
                }
            });
        });
        async function convertToArabic(sourceId, targetId) {
            const sourceBox = $("#" + sourceId).dxTextBox("instance");
            const targetBox = $("#" + targetId).dxTextBox("instance");

            if (!sourceBox || !targetBox) {
                console.error("TextBox not initialized.");
                return;
            }

            const sourceText = sourceBox.option("value");

            if (!sourceText || sourceText.trim() === "") {
                alert("Please enter a value to translate.");
                return;
            }

            try {
                const translatedText = await translateToArabic(sourceText);
                targetBox.option("value", translatedText);
            } catch (error) {
                console.error("Translation failed", error);
                alert("Translation failed. Please try again.");
            }
        }

        

    function addQuotationStatus() {
            
            const nameValidationResult = $("#txtQuotationStatus").dxValidator("instance").validate();
            

            if (!nameValidationResult.isValid) {
                DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
                return;
            }

            const data = {
            QuoteStatus: $("#txtQuotationStatus").dxTextBox("instance").option("value"),
            };

            $.ajax({
                url: '/api/AddNewQuotationStatus/SaveOrUpdateStatus',
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function () {
                DevExpress.ui.notify("Quotation Status saved successfully!", "success", 2000);
                    $("#QuotationStatusGrid").dxDataGrid("instance").refresh();
                },
                error: function (xhr) {
            const errorMsg = xhr.responseJSON?.message || "Failed to save quotation.";
            DevExpress.ui.notify(errorMsg, "error", 3000); // 👉 Shows "Quotation Status is already present"
        }
            });
        }


        $("#btnUpdate").on("click", function () {
            const grid = $("#QuotationStatusGrid").dxDataGrid("instance");
            grid.saveEditData(); // 🔥 only triggers on manual click
        });


        function onQuotationStatusUpdating(e) {
            const data = {
            QuoteStatusId: e.oldData.QuoteStatusId,
            QuoteStatus: e.newData.QuoteStatus ?? e.oldData.QuoteStatus
               
            };

            e.cancel = true; // prevents grid from doing its own update

            return $.ajax({
        url: '/api/AddNewQuotationStatus/SaveOrUpdateStatus',
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function () {
                    DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                    $("#QuotationStatusGrid").dxDataGrid("instance").refresh();
                },
                error: function () {
                    DevExpress.ui.notify("Failed to save.", "error", 1500);
                }
            });
        }
        function onDeleteButtonClick(e) {
            
            e.event.preventDefault();
            var grid = $("#QuotationStatusGrid").dxDataGrid("instance");
            var key = e.row.data.QuoteStatusId;
            if (confirm("Are you sure you want to delete this row?")) {
                $.ajax({
                    url: '/api/AddNewQuotationStatus/DeleteQuotationStatus/' + key,
                    type: 'DELETE',
                    success: function () {
                        grid.refresh();
                        DevExpress.ui.notify("Deleted successfully", "success", 2000);
                    },
                    error: function () {
                        DevExpress.ui.notify("Delete failed", "error", 2000);
                    }
                });
            }
        }
    </script>
