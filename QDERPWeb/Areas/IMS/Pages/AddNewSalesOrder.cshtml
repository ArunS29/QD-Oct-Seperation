                            .Label("Sales Order Date")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            <div style="display: flex; align-items: flex-end;">
                                <div style="flex: 1;">
                                    @(Html.DevExtreme().DropDownBox()
                                    .ID("ClientNames")
                                    .ValueExpr("ClientCode")
                                    .DisplayExpr("ClientName")
                                    .DataSource(ds => ds
                                    .Mvc()
                                    .Controller("SalesOrders")
                                    .LoadAction("GetClientNames")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("ClientCode")
                                    )
                                    .Label("Client Name")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .Width("100%")
                                    .ContentTemplate(new TemplateName("ClientDropDownTemplate"))
                                    )


                                </div>
                                <div style="margin-left: 5px;">
                                    @(Html.DevExtreme().Button()
                                    .ID("AddClient")
                                    .Icon("plus")
                                    .Hint("Add Client")
                                    .OnClick("AddClients")
                                   )
                                </div>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("QuotationNo")
                            .Label("Quotation No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("QuotationDate")
                            .Label("Quotation Date:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("ClientRefName")
                                    .Label("Client Ref. Name:")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%"))
                                </div>
                                <div class="col-md-4">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("ClientEmail")
                                    .Label("Client Email:")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .Mode(TextBoxMode.Email)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%"))
                                </div>
                                <div class="col-md-4">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("ClientContact")
                                    .Label("Client Contact No:")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%"))
                                </div>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 3 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("ClientPoNo")
                            .Label("Client PO No:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            @(Html.DevExtreme().DateBox()
                            .ID("ClientPoDate")
                            .Label("Client PO Date:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </td>
                        <td>
                            <div class="row g-2">
                                <div class="col-md-4" style="display: flex; align-items: flex-end;">
                                    @(Html.DevExtreme().DropDownBox()
                                    .ID("Project")
                                    .Label("Project:")
                                    .ValueExpr("ProjectId")
                                    .DisplayExpr("ProjectDescription")
                                    .DataSource(ds => ds
                                    .Mvc()
                                    .Controller("SalesOrders")
                                    .LoadAction("GetProject")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("ProjectId")
                                    )
                                    .LabelMode(EditorLabelMode.Outside)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%")
                                    .ContentTemplate(new TemplateName("ProjectDropDownTemplate"))
                                    )

                                    <div style="margin-left: 5px;">
                                        @(Html.DevExtreme().Button()
                                        .ID("AddProject")
                                        .Icon("plus")
                                        .Hint("Add Project")
                                        .OnClick("AddProject")
                                        )
                                    </div>
                                </div>
                                <div class="col-md-4" style="display: flex; align-items: flex-end;">
                                    @(Html.DevExtreme().DropDownBox()
                                    .ID("TypeOFSalesOrder")
                                    .ValueExpr("TypeOfRequestId")
                                    .DisplayExpr("TypeOfRequest")
                                    .DataSource(ds => ds
                                    .Mvc()
                                    .Controller("SalesOrders")
                                    .LoadAction("GetTypeOfSalesOrder")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("TypeOfRequestId")
                                    )
                                    .Label("Type of Sales Order:")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%")
                                    .ContentTemplate(new TemplateName("typeofSalesOrderDropDownTemplate")))
                                    <div style="margin-left: 5px;">
                                        @(Html.DevExtreme().Button()
                                        .ID("AddSalesOrder")
                                        .Icon("plus")
                                        .Hint("Add Sales Order")
                                    )
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("ReferenceNo")
                                    .Label("Reference No:")
                                    .LabelMode(EditorLabelMode.Outside)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%"))
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>



        </text>);
                    item.Add().Title("Signatories").Icon("detailslayout").Text("Signatories").Template(@<text>
            <div class="dx-card p-3">
                <table style="width: 100%; vertical-align: top;">
                    <tr>
                        <!-- Left: Signatories -->
                        <td style="width: 50%; vertical-align: top;">
                            <div style="font-weight: bold;">Signatories:</div>
                            <div class="mb-3">
                                @(Html.DevExtreme().DropDownBox()
                                .ID("preparedBy")
                                .ValueExpr("SignatoryId")
                                .DisplayExpr("SignatoryName")
                                .DataSource(ds => ds
                                .Mvc()
                                .Controller("SalesOrders")
                                .LoadAction("GetSignatory")
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("SignatoryId")
                                )
                                .ShowClearButton(true)
                                .ShowDropDownButton(true)
                                .StylingMode(EditorStylingMode.Outlined)
                                .Width("100%")
                                .ContentTemplate(new TemplateName("SignatoriesDropDownTemplate")))
                                @(Html.DevExtreme().Button()
                                .ID("Signatories")
                                .Icon("plus")
                                .Hint("Add Sales Order")
                                .OnClick("Signatorynew")
                                )
                            </div>
                            <div>
                                @(Html.DevExtreme().CheckBox().ID("showSeal").Value(true).Text("Show Company Seal"))<br />
                                @(Html.DevExtreme().CheckBox().ID("showSignature").Value(true).Text("Show Signature"))<br />
                                @(Html.DevExtreme().CheckBox().ID("printLetterhead").Value(true).Text("Print in Letter Head"))
                            </div>
                        </td>

                        <!-- Right: Additions & Deductions -->
                        <td style="width: 50%; padding: 10px;">
                            <div style="font-weight: bold;">Shipment & Discounts:</div>

                            <!-- Additions -->
                            <div style="margin-top: 10px; margin-bottom: 15px;">
                                <div>Additions:</div>
                                <div class="d-flex gap-2 mt-1">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("AdditionsText")
                                    .Placeholder("Add: Additions (SAR)")
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("70%"))
                                    @(Html.DevExtreme().NumberBox()
                                    .ID("AdditionsAmount")
                                    .Value(0.00)
                                    .Format("#,##0.00")
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .ShowSpinButtons(true)
                                    .Width("30%"))
                                </div>
                            </div>

                            <!-- Deductions -->
                            <div>
                                <div>Deductions:</div>
                                <div class="d-flex gap-2 mt-1">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("DeductionsText")
                                    .Placeholder("Less: Deductions (SAR)")
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("70%"))
                                    @(Html.DevExtreme().NumberBox()
                                    .ID("DeductionsAmount")
                                    .Value(0.00)
                                    .Format("#,##0.00")
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .ShowSpinButtons(true)
                                    .Width("30%"))
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>




        </text>);
                    item.Add().Text("Branch / Divisions").Icon("user").Title("Branch / Divisions").Template(@<text>

            <div class="dx-card p-3" style="padding:10px;">
                <table style="width: 100%; vertical-align: top;">
                    <tr>
                        <!-- LEFT SIDE -->
                        <td class="pe-2" style="width: 50%; vertical-align: top;">
                            <!-- Company Branch -->
                            @(Html.DevExtreme().DropDownBox()
                            .ID("CompanyBranch")
                            .ValueExpr("BranchCode")
                            .DisplayExpr("BranchName")
                            .DataSource(ds => ds
                            .Mvc()
                            .Controller("SalesOrders")
                            .LoadAction("GetCompanyBranch")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("BranchCode")
                            )                            .StylingMode(EditorStylingMode.Outlined)
                            .Label("Company Branch / Division")
