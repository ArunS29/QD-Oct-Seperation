      function receiveModalFieldData(modalData) {
    console.log("📥 Received from modal:", modalData);

    const dataGridInstance = $("#itemGrid").dxDataGrid("instance"); // ✅ add this line

    if (!dataGridInstance) {
        console.error("❌ dataGridInstance is not initialized.");
        return;
    }

    if (!window.currentDescriptionCell || !window.currentDescriptionCell.key) {
        console.error("❌ currentDescriptionCell is missing or invalid.");
        return;
    }

    const rowKey = window.currentDescriptionCell.key;
    console.log("🔑 Editing key:", rowKey);

    const rowIndex = dataGridInstance.getRowIndexByKey(rowKey);

    if (rowIndex === -1) {
        console.warn("⚠️ Row not found in grid for key:", rowKey);
        return;
    }

    // ✅ Set the new values from modal
    dataGridInstance.cellValue(rowIndex, "AddlDescription", modalData.AddlDescription || "");
    dataGridInstance.cellValue(rowIndex, "QuoteRemarks", modalData.QuoteRemarks || "");
    dataGridInstance.cellValue(rowIndex, "DeliveryPeriod", modalData.DeliveryPeriod || "");
    dataGridInstance.cellValue(rowIndex, "PlanNo", modalData.PlanNo || "");
}


