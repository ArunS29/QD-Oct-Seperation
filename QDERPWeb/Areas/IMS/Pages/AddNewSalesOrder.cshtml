                                    .Label("Client Name")
                                    .LabelMode(EditorLabelMode.Floating)
                                    .Width("100%")
                                    .ValidationRules(rules =>
                                    {
                                    rules.AddRequired()
                                    .Message("Client Name is required");
                                    })
