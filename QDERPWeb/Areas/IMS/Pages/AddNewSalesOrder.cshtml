                            .Controller("SalesOrders")
                            .LoadAction("GetCostCenterMaster")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .Key("CostAllocationUnitId")
                            )
                            .StylingMode(EditorStylingMode.Outlined)
                            .Label("Cost Center Master *")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                           .ContentTemplate(new TemplateName("CostCenterMasterDropDownTemplate")))

                        </td>

                        <!-- RIGHT SIDE -->
                        <td class="ps-2" style="width: 50%; vertical-align: top;">
                            <!-- Order Expiry Date -->
                            @(Html.DevExtreme().DateBox()
                            .ID("OrderExpiryDate")
                            .StylingMode(EditorStylingMode.Outlined)
                            .Label("Order Expiry Date")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))

                            <!-- Sales Order Remarks -->
                            @(Html.DevExtreme().TextArea()
                            .ID("SalesOrderRemarks")
                            .MinHeight(80)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Label("Sales Order Remarks")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                           )

                            <!-- Delivery Fields -->
                            <div style="display: flex; justify-content: space-between; margin-top: 1rem;">
                                @(Html.DevExtreme().DateBox()
                                .ID("ExpectedDeliveryDate")
                                .StylingMode(EditorStylingMode.Outlined)
                                .Label("Expected Delivery Date")
                                .LabelMode(EditorLabelMode.Outside)
                                .Width("100%")
                                .ElementAttr("style", "width: 33%;"))

                                @(Html.DevExtreme().TextBox()
                                .ID("DeliveryPeriod")
                                .StylingMode(EditorStylingMode.Outlined)
                                .Label("Delivery Period")
