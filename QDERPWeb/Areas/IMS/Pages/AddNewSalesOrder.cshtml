@using (Html.DevExtreme().NamedTemplate("ClientDropDownTemplate"))
{
    @(Html.DevExtreme().DataGrid()
            .ID("clientGrid")
            .DataSource(ds => ds
                .Mvc()
                .Controller("ClientLeads")
                .LoadAction("Get")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("ClientCode")
            )
            .Height(300)
            .ShowBorders(true)
            .FilterRow(f => f.Visible(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Selection(s => s.Mode(SelectionMode.Single))  // Single selection
            .Columns(columns =>
            {
                columns.Add().DataField("ClientCode").Caption(new JS("formatMessage('Client Code')"));
                columns.Add().DataField("ClientName").Caption(new JS("formatMessage('Client Name')"));
            })
            .OnSelectionChanged("onClientSelected")  // Trigger onClientSelected on row selection
        )
}


<script>
             function onClientSelected(e) {
        const selected = e.selectedRowsData[0];
        if (selected) {
            const dropDownBox = $("#ClientNames").dxDropDownBox("instance");
            if (dropDownBox) {
                // Set the value to ClientCode, not ClientName
                dropDownBox.option("value", selected.ClientCode);
                dropDownBox.close();
            } else {
                console.error("DropDownBox instance not found.");
            }
        }
    }


