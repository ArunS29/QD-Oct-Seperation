            function descriptionDropDownTemplate(cellElement, cellInfo) {
        const wrapper = $("<div>").css({
            display: "flex",
            alignItems: "center",
            width: "100%",
            minWidth: "600px",
            boxSizing: "border-box",
            gap: "1px"
        });

        const dropDown = $("<div>").dxDropDownBox({
            value: cellInfo.value,
            valueExpr: "Gscode",
            displayExpr: "Gsdescrpition",
            dataSource: descriptionList,
            showClearButton: true,
            showDropDownButton: true,
            deferRendering: false,
            width: 250,
            dropDownOptions: { width: 900 },
            contentTemplate: function (e) {
                const dataGrid = $("<div>").dxDataGrid({
                    dataSource: descriptionList,
                    keyExpr: "Gscode",
                    selection: { mode: "single" },
                    columns: [
                        { dataField: "Gscode", caption: "Code" },
                        { dataField: "ItemPartNo", caption: "Item Part No" },
                        { dataField: "Gsdescrpition", caption: "Description" },
                        { dataField: "GsdescriptionAr", caption: "Arabic Description" },
                        { dataField: "GspackingUnit", caption: "Unit Desc" },
                        {
                            dataField: "IsDiscontinued",
                            caption: "Discontinued?",
                            dataType: "boolean",
                            width: 120
                        }
                    ],
                    searchPanel: {
                        visible: true,
                        width: 240,
                        placeholder: "Search..."
                    },
                    onSelectionChanged: function (selectedItems) {
                        const selected = selectedItems.selectedRowsData[0];
                        if (selected) {
                            // Update the field in the data grid
                            cellInfo.setValue(selected.Gscode); // ✅ sets value in underlying row

                            // Optional: update other columns in the same row
                            const grid = $("#itemGrid").dxDataGrid("instance");
                            const rowIndex = grid.getRowIndexByKey(cellInfo.key);
                            grid.cellValue(rowIndex, "Gscode", selected.Gscode);
                            grid.cellValue(rowIndex, "Gsdescrpition", selected.Gsdescrpition);           
                            grid.cellValue(rowIndex, "CostPrice", selected.CostPrice);
                            grid.cellValue(rowIndex, "UnitRateMethod", selected.GsuoM);
                            grid.cellValue(rowIndex, "Qty", 1);

                            e.component.close();
                        }
                    },
                    hoverStateEnabled: true,
                    height: 200,
                    paging: { enabled: false },
                    scrolling: {
                        mode: "virtual",
                        useNative: true
                    }
                });

                return $("<div>").append(dataGrid);
            }
        });

        // Edit Button
        const editButton = $("<div>").dxButton({
            icon: "edit",
            hint: "Edit item",
