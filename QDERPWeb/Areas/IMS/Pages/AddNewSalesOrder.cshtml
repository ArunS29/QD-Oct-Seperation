                        <col style="width: 20%;" />
                        <col style="width: 60%;" />
                    </colgroup>

                    <!-- Row 1 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SalesOrderNO")
                            .Label("Sales Order NO:")
