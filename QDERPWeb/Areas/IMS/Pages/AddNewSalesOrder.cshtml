           function onGridRightClick(e) {
            if (e.row && e.row.rowType === "data") {
                e.event.preventDefault(); // disable browser context menu

                // Select the row that was right-clicked
                const grid = $("#itemGrid").dxDataGrid("instance");
                grid.selectRowsByIndexes([e.rowIndex]);

                // Position and show the custom menu
                const menu = document.getElementById("lineItemContextMenu");
                menu.style.left = e.event.pageX + "px";
                menu.style.top = e.event.pageY + "px";
                menu.style.display = "block";
            }
        }

        // Hide the menu when clicking anywhere else
        document.addEventListener("click", function (e) {
            const menu = document.getElementById("lineItemContextMenu");
            if (!e.target.closest("#lineItemContextMenu")) {
                menu.style.display = "none";
            }
        });

        // Menu action handling
        $(document).on("click", ".ctx-menu-item", function () {
            const action = $(this).data("action");
            const grid = $("#itemGrid").dxDataGrid("instance");
            switch (action) {
                case "delete-line":
                    const selected = grid.getSelectedRowsData();
                    if (selected.length > 0) {
                        grid.deleteRow(grid.getRowIndexByKey(selected[0].id)); // Use correct key field
                    }
                    break;

                case "delete-selected":
                    const selectedKeys = grid.getSelectedRowKeys();
                    selectedKeys.forEach(key => {
                        const rowIndex = grid.getRowIndexByKey(key);
                        if (rowIndex >= 0) grid.deleteRow(rowIndex);
                    });
                    break;

                case "add-line":
                    grid.addRow();
                    break;

               case "generate-jo":
                     $("#generateJobOrderModal").fadeIn(200);
        break;

            }

            $("#lineItemContextMenu").hide();
        });


        // Handle Generate JO Button
        // $("#btnGenerateJO").on("click", function () {
        //     const selectedType = $("input[name='joType']:checked").val();
        //     DevExpress.ui.notify(`Generating JO for ${selectedType}`, "success", 2000);
        //     closeGenerateJobOrderModal();
        // });

        $("#btnCloseJO").on("click", function () {
            closeGenerateJobOrderModal();
        });

        function showGenerateJobOrderModal(event) {
        const modal = $("#generateJobOrderModal");

        if (event) {
            // Position modal at the mouse click
            modal.css({
                left: event.pageX + "px",
                top: event.pageY + "px",
                transform: "translate(0, 0)"
            });
        }

        modal.fadeIn(200);

        // Delay to prevent immediate closure
        setTimeout(() => {
            $(document).on("click.generateJO", function (e) {
                if (!$(e.target).closest("#generateJobOrderModal").length) {
                    closeGenerateJobOrderModal();
                }
            });
        }, 100);
    }


        function closeGenerateJobOrderModal() {
            $("#generateJobOrderModal").fadeOut(200);
            $(document).off("click.generateJO");
        }

            document.getElementById("btnCloseJO").addEventListener("click", function () {
                $("#generateJobOrderModal").hide();
            });


        //description DropDownTemplate DropDown
