        const addButton = $("<div>").dxButton({
            icon: "plus",
            hint: "Add new item",
            stylingMode: "text",
            onClick: function () {
                const url = `/${tenantName}/IMS/GoodsAndService`;
                openModal(url, "");
            },
            width: 50
        });

        wrapper.append(dropDown, addButton, editButton);
        cellElement.append(wrapper);
    }



