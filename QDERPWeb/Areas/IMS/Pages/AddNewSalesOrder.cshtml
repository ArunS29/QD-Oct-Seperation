@page
@model QD.ERP.Web.Areas.IMS.Pages.AddNewSalesOrderModel
@{
}

<style>

    .titleCard-toggle1 {
        display: none;
    }
    

    .ledgerResult {
        overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
        width: 100%;
    }

    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        width: 100%;
        padding: 5px;
        border-radius: 1px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
            background: var(--background-color);
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .select-box {
        width: 20vh;
    }

    #lineItemContextMenu {
        background: #fff;
        border: 1px solid #bbb;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        border-radius: 4px;
        min-width: 220px;
        position: absolute;
        z-index: 9999;
        display: none;
    }

        #lineItemContextMenu .ctx-menu-item:hover {
            background: #f0f0f0;
        }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .containers {
        display: flex;
    }

    .dx-dropDownBox.dx-invalid .dx-texteditor-input {
        border-color: red !important;
        border-width: 2px;
    }
</style>


<meta charset="UTF-8">
@* 
<div class="title">
    <div class="header-container">
        <div id="EditsalesOrders" class="no-border-title"></div>
    </div>
</div> *@
<div class="dx-card-container">
    <div class="dx-card-header minimal-header">
        <div class="card-title-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div id="EditsalesOrders" class="titleText no-border-title"></div>
    </div>
</div>

<div class="form-container1">
    <div class="form-container">
        <!-- Tab Menu -->

        @(Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%").Height(270)
                .Items(item =>
                {
                    item.Add()
                .Title("Sales Order Details")
                .Icon("folder")
                .Text("Sales Order Details")
                .Template(@<text>
            <div class="p-3">
                <table style="table-layout: fixed; width:100%;">
                    <colgroup>
                        <col style="width: 20%;" />
                        <col style="width: 20%;" />
                        <col style="width: 60%;" />
                    </colgroup>

                    <!-- Row 1 -->
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextBox()
                            .ID("SalesOrderNO")
