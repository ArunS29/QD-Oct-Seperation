          // Inject the logged-in user name from Razor server-side to JS variable
    var currentUserName = '@User.Identity.Name';

    $("#btnSave").on("click", function (e) {
        var SalesOrderNo = $("#SalesOrderNO").dxTextBox("instance").option("value");
        var QuotationNo = $("#QuotationNo").dxTextBox("instance").option("value");
        var DefaultCostCenterMasterFromSalesOrder = $("#CostCenter").dxDropDownBox("instance").option("value");

        const isCreateCostCenter = true;

        const data = {
            SalesOrderNo,
            QuotationNo,
            DefaultCostCenterMasterFromSalesOrder,
            IsCreateCostCenterFromSalesOrder: isCreateCostCenter,
            AddedBy: currentUserName  // pass actual username here
        };

        $.ajax({
            url: "/api/SalesOrders/InsertSalesOrderFromQuotation",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function (res) {
                DevExpress.ui.notify("Sales Order Created Successfully", "success", 3000);
            },
            error: function (xhr) {
                const message = xhr.responseJSON?.message || "Failed to create Sales Order";
                DevExpress.ui.notify(message, "error", 3000);
                console.error("❌ AJAX Error:", xhr.responseJSON || xhr);
            }
        });
    });





