            )

    </div>
    @(Html.DevExtreme().DataGrid()
        .ID("itemGrid")
        .Height("40vh")
        .DataSource(new JS("window.itemGridDataSource"))
        .Selection(s => s
        .Mode(SelectionMode.Multiple)
        .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always)
        )   
        .Columns(columns =>
        {
            columns.Add().DataField("SalesOrderChildId").Visible(false).AllowEditing(false);
            columns.Add().Caption("#").Width(60).CellTemplate(new JS("serialTemplate"));

            columns.Add()
            .Caption("Item Code")
            .Width(150)
            .AllowEditing(false)
            .CellTemplate(new JS(@"
    function(container, options) {
    container.text(options.data?.Gscode || '');
    }
    "));

            columns.Add()
            .DataField("Gscode") // ✅ this is the field stored in DB or model
            .Caption("Description")
            .Width(400)
            .EditCellTemplate(new JS("descriptionDropDownTemplate")) // ✅ editor for editing
            .CellTemplate(new JS(@"
    function(container, options) {
    const item = descriptionList.find(d => d.Gscode === options.value);
    container.text(item ? item.Gsdescrpition : options.value);
    }
    ")); 
            columns.Add()
            .DataField("Descriptions") // this is modal field
            .Caption("...")
            .CssClass("center-header")
            .Width(90)
            .AllowEditing(true)
            .CellTemplate(new JS(@"
                function(container, options) {
                    const gsCode = options.data.Gscode;
                    const salesOrderChildId = options.data.SalesOrderChildId;

                    $('<div>').dxButton({
                        icon: 'user',
                        hint: 'Edit IMS Details Description',
                        stylingMode: 'text',
                        width: 60,
                        onClick: function () {
                            window.currentDescriptionCell = options;
                            const queryParams = [];
                            if (gsCode) queryParams.push(`gsCode=${encodeURIComponent(gsCode)}`);
                            if (salesOrderChildId) queryParams.push(`salesOrderChildId=${encodeURIComponent(salesOrderChildId)}`);
                            const url = `/${tenantName}/IMS/DetailedDescriptionSO?${queryParams.join('&')}`;
                            openModal(url, 'Details Description');
                        }
                    }).appendTo(container);
                }
