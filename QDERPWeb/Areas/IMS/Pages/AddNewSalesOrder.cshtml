                            .DateSerializationFormat("dd-MMM-yyyy")  // ✅ Ensure consistent format
                            .Label("Sales Order Date")
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))


                        </td>
                        <td>
                                <div style="flex: 1;">
                                    @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                                    .ID("ClientNames")
