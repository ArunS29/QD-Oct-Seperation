                        $("#btnSubmit").attr("disabled", true);
                    }
                } else {
                    DevExpress.ui.notify(response.message, "error", 2000);
                }
            },
            error: function (xhr) {
                const errMsg = xhr.responseJSON?.message || "Unexpected error.";
                DevExpress.ui.notify(errMsg, "error", 2000);
            }
        });
    });
    //verify button
    $("#btnVerify").on("click", function () {
        const salesOrderNo = $("#SalesOrderNO").dxTextBox("instance").option("value")?.trim();

        if (!salesOrderNo) {
            DevExpress.ui.notify("Enter Sales Order No first.", "error", 2000);
            return;
        }

        $.ajax({
            url: '/api/SalesOrders/VerifySalesOrder',
            type: 'POST',
            data: JSON.stringify(salesOrderNo),
            contentType: 'application/json',
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 2000);
                    $("#btnVerify").dxButton("instance").option("disabled", true);
                } else {
                    DevExpress.ui.notify(response.message, "error", 2000);
                }
            },
            error: function (xhr) {
                const errMsg = xhr.responseJSON?.message || "Unexpected error.";
                DevExpress.ui.notify(errMsg, "error", 2000);
            }
        });
    });
    //Approve
    $("#btnApprove").on("click", function () {
        const salesOrderNo = $("#SalesOrderNO").dxTextBox("instance").option("value")?.trim();

        if (!salesOrderNo) {
            DevExpress.ui.notify("Enter Sales Order No first.", "error", 2000);
            return;
        }

        $.ajax({
            url: '/api/SalesOrders/ApproveSalesOrder',
            type: 'POST',
            data: JSON.stringify(salesOrderNo),
            contentType: 'application/json',
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 2000);
                    disableAllControls(); // disable fields/buttons
                } else {
                    DevExpress.ui.notify(response.message, "error", 2000);
                }
            },
            error: function (xhr) {
                const errMsg = xhr.responseJSON?.message || "Unexpected error.";
                DevExpress.ui.notify(errMsg, "error", 2000);
            }
        });
    });
  
        function disableAllControls() {
        const componentTypes = [
            { selector: "#SalesOrderNO", type: "dxTextBox" },
            { selector: "#SalesOrderDate", type: "dxDateBox" },
            { selector: "#ClientNames", type: "dxDropDownBox" },
            { selector: "#QuotationNo", type: "dxTextBox" },
            { selector: "#QuotationDate", type: "dxDateBox" },
            { selector: "#ClientPoNo", type: "dxTextBox" },
            { selector: "#ClientPoDate", type: "dxDateBox" },
            { selector: "#Project", type: "dxDropDownBox" },
            { selector: "#TypeOFSalesOrder", type: "dxDropDownBox" },
            { selector: "#ReferenceNo", type: "dxTextBox" },
            { selector: "#ClientRefName", type: "dxTextBox" },
            { selector: "#ClientEmail", type: "dxTextBox" },
            { selector: "#ClientContact", type: "dxTextBox" }
        ];

        // Disable fields
        componentTypes.forEach(item => {
            const instance = $(item.selector)[item.type]("instance");
            if (instance) {
                instance.option("disabled", true);
            }
        });

        // Disable buttons
        const buttonIds = [
            "#ddButtonLayout", "#btnMoveDown", "#btnMoveUp", "#btnSave",
            "#btnSaveAndClose", "#btnAddNew", "#btnDelete",
            "#btnSubmit", "#btnVerify", "#btnApprove"
        ];
        $('li.ctx-menu-item[data-action="add-line"]').addClass("dx-state-disabled").css("pointer-events", "none").css("opacity", "0.5");

        buttonIds.forEach(id => {
            const $btn = $(id);
            if ($btn.data("dxButton")) {
                $btn.dxButton("instance").option("disabled", true);
            } else {
                $btn.prop("disabled", true).addClass("dx-state-disabled");
            }
        });
    }
$(document).ready(function () {
		console.log('Start permission handling AccountingLedgers');
		// Form ID
		var formId = "frm60103SalesOrderEdit";

		// Call the API to get permissions
		$.ajax({	
			url: '/api/Permissions/GetAccessDetails?formId=' + formId,
			type: 'GET',
			contentType: 'application/json',
			success: function (response) {
				console.log("API Response:", response); // Log the API response

				if (response.success && response.permissions) {
					// Default visibility and enable status for buttons
					var controlStates = {
                        "ddButtonLayout": { "Visible": false, "Enabled": false },
                        "btnMoveUp": { "Visible": false, "Enabled": false },
                        "btnMoveDown": { "Visible": false, "Enabled": false },
                        "btnPrint": { "Visible": false, "Enabled": false },
                        "btnToggleSearch": { "Visible": false, "Enabled": false },
                        "btntoggleGroupPanel": { "Visible": false, "Enabled": false },
                        "btnColumnChooser": { "Visible": false, "Enabled": false },
                        "btnSave": { "Visible": false, "Enabled": false },
                        "btnSaveAndClose": { "Visible": false, "Enabled": false },
                        "btnAddNew": { "Visible": false, "Enabled": false },
                        "btnDelete": { "Visible": false, "Enabled": false },
                        "btnBack": { "Visible": false, "Enabled": false },
                        "btnSubmit": { "Visible": false, "Enabled": false },
                        "btnVerify": { "Visible": false, "Enabled": false },
                        "btnApprove": { "Visible": false, "Enabled": false },
                        "btnSoreStock": { "Visible": false, "Enabled": false },
                    };


					// Check for full access
					var fullAccess = response.permissions.find(p =>
						p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
					);

					if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
						// Grant full access: make all controls visible and enabled
						Object.keys(controlStates).forEach(key => {
							controlStates[key] = { "Visible": true, "Enabled": true };
						});
					} else {
						// Update states based on specific permissions for each control
						Object.keys(controlStates).forEach(key => {
							var controlPermission = response.permissions.find(p =>
								p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
							);
							if (controlPermission) {
								controlStates[key] = {
									"Visible": controlPermission.ItemVisible || false,
									"Enabled": controlPermission.ItemEnabled || false
								};
							}
						});
					}

					console.log("Control States:", controlStates);
					Object.keys(controlStates).forEach(key => {
						var button = document.getElementById(key);
						if (button) {
							// Handle visibility
							button.style.display = controlStates[key].Visible ? "inline-block" : "none";
							// Handle enable/disable state
							button.disabled = !controlStates[key].Enabled;
							console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
						} else {
							console.warn(`Button with ID "${key}" not found in the DOM.`);
						}
					});
				} else {
					console.warn("Failed to fetch permissions or no permissions available.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching permissions:", error);
				alert('An error occurred while fetching permissions. Please try again.');
			}
		});

		console.log('End permission handling');
	});
    
