                                .Label("Delivery Terms")
                                .LabelMode(EditorLabelMode.Outside)
                                .Width("100%")
                                .ElementAttr("style", "width: 33%; margin-left: 10px;"))
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </text>);
                })
            )

    </div>
