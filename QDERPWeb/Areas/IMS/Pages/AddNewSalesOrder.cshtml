								// Edit Client Button
								buttons.Add()
									.Name("EditClient")
									.Location(TextEditorButtonLocation.After)
									.Widget(w => w.Button()
										.Type(ButtonType.Default)
										.Icon("edit")
										.ElementAttr(new { @class = "custom-hover-button edit-hover" })
											.OnClick("EditClients")
									);
									  buttons.Add()
									   .Name("dropDown");
							})
						)
                            </div>
                        </td>
                    </tr>

                    <!-- Row 2 -->
