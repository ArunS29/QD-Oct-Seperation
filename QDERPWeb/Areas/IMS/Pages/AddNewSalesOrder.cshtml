                                    .Key("TypeOfRequestId")
                                    )
                                    .Label("Type of Sales Order:")
                                    .LabelMode(EditorLabelMode.Floating)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%")
                                    .ContentTemplate(new TemplateName("typeofSalesOrderDropDownTemplate"))
                                     .Buttons(buttons =>
                                        {
                                            buttons.Add()
                                            .Name("AddSalesOrder")
                                            .Location(TextEditorButtonLocation.After)
                                            .Widget(w => w.Button()
                                            .Type(ButtonType.Default)
                                            .Icon("plus")
                                            .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                              );
                                            buttons.Add()
                                            .Name("dropDown");
                                        }))
                                   
                                </div>
                                <div class="col-md-4">
                                    @(Html.DevExtreme().TextBox()
                                    .ID("ReferenceNo")
                                    .Label("Reference No:")
                                    .LabelMode(EditorLabelMode.Floating)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%"))
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>



        </text>);
                    item.Add().Title("Signatories").Icon("detailslayout").Text("Signatories").Template(@<text>
