                                    .LabelMode(EditorLabelMode.Floating)
                                    .StylingMode(EditorStylingMode.Outlined)
                                    .Width("100%")
                                    .ContentTemplate(new TemplateName("ProjectDropDownTemplate"))
                                    .Buttons(buttons =>
                                    {
                                        buttons.Add()
                                        .Name("AddProject")
                                        .Location(TextEditorButtonLocation.After)
                                        .Widget(w => w.Button()
                                        .Type(ButtonType.Default)
                                        .Icon("plus")
                                        .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                            .OnClick("AddProject"));
                                        buttons.Add()
                                        .Name("dropDown");
                                    }))
                                   
                                </div>
                                <div class="col-md-4" style="display: flex; align-items: flex-end;">
                                    @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
                                    .ID("TypeOFSalesOrder")
                                    .ValueChangeEvent("input")
							.HoverStateEnabled(true)
                           .OnInput("dropDownBoxOnInput")
                        .OnOpened("onOpened")
                                    .ValueExpr("TypeOfRequestId")
                                    .DisplayExpr("TypeOfRequest")
                                    .DataSource(ds => ds
                                    .Mvc()
                                    .Controller("SalesOrders")
                                    .LoadAction("GetTypeOfSalesOrder")
