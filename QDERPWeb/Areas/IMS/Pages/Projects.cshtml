<div>
<div class="dx-card" style="margin: auto; width:100%; ">
    <!-- Input Fields -->
    <div class="row mb-2" style="display: flex; gap: 10px; align-items: flex-end; flex-direction: row; flex-wrap: nowrap;">
        <div style="width: 21%;">
            @(Html.DevExtreme().TextBox()
                .ID("txtPrjCode")
                .Label(new JS("formatMessage('Project Code:')"))
                .LabelMode(EditorLabelMode.Floating)
                .Width("100%")
                .ValidationRules(rules =>
                {
                    rules.AddRequired().Message("Project Code is required");
                }))

        </div>

        <div style="width: 60%; display:flex; align-items:end;">

            @(Html.DevExtreme().DropDownBox()
                .DataSource(d => d.WebApi()
                .Controller("ProjectGroup")
                .LoadAction("GetAllProjectGroupData")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("ProjectGroupCode")
                )
                .Label(new JS("formatMessage('Project Group')"))
                .LabelMode(EditorLabelMode.Floating)
                .ID("GetProjectDropDown")
                .Width(400)
                @*  .ShowClearButton(true)
                .AcceptCustomValue(true) *@
                .OpenOnFieldClick(false)//
                .ValueChangeEvent("input")
                .HoverStateEnabled(true)
                .ValueExpr("ProjectGroupId")
                .DisplayExpr("ProjectGroup")
                .OnInput("dropDownBoxOnInput")
                .OnOpened("onOpened")
                .TabIndex(1)
                .Width("100%")
                .OnKeyDown("onKeyDown")
                .ValidationRules(rules =>
                {
                    rules.AddRequired().Message("Project Group is required");
                })
                //.OnValueChanged("dropDownBoxValueChanged")
                .ContentTemplate(new TemplateName("GetProjectContentTemplate"))
                   .Buttons(buttons =>
                       {
                           buttons.Add()
                             .Name("btnAdd1")
                           .Location(TextEditorButtonLocation.After)
                           .Widget(w => w.Button()
                           .Type(ButtonType.Default)
                           .Icon("plus")
                           .ElementAttr(new { @class = "custom-hover-button add-hover" })
                           .OnClick("AddProjectgroup"));
                           buttons.Add()
                           .Name("dropDown");
                       }))
        </div>
    </div>


    <div class="row mb-3">
        <div class="col-md-6" style="display:flex; align-items:end;">
            @(Html.DevExtreme().TextBox().ID("txtProjectDescription").Label(new JS("formatMessage('Project Description:')"))
                .LabelMode(EditorLabelMode.Floating).Width("100%").ValidationRules(rules =>
                {
                    rules.AddRequired().Message("Project Description is required");
                })
                   .Buttons(buttons =>
                   {
                       buttons.Add()
                        .Name("convertToCaptialORSmall3")
                       .Location(TextEditorButtonLocation.After)
                       .Widget(w => w.Button()
                       .Type(ButtonType.Default)
                                    .Icon("fas fa-language")
                       .ElementAttr(new { @class = "custom-hover-button add-hover" })
                       .OnClick("toggleCase"));
                   }))
            </div>  
        </div>
    </div>
    <div style="display:flex; align-items:end; gap:450px;">
        @(Html.DevExtreme().DropDownBox()
            .ID("ddCostAllocation")
            .Label("Signatory User ID:")
            .LabelMode(EditorLabelMode.Floating)
            .ShowClearButton(true)
            .OpenOnFieldClick(true)
            .AcceptCustomValue(false)
            .DataSource(d => d.WebApi()
            .Controller("ProjectGroup")
            .LoadAction("GetAllCostAllocationData")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("CostAllocationUnitId"))
            .ValueExpr("CostAllocationUnitId")
            .DisplayExpr("CostAllocationUnit")
            .Width(800)
            .ValidationRules(rules =>
            {
                rules.AddRequired().Message("Cost Center Code is required");
            })

            .ContentTemplate(@<text>
            <div id="SignatoryGridContainer"></div>
            <script>
                $(function () {
                    $("#SignatoryGridContainer").dxDataGrid({
                        dataSource: DevExpress.data.AspNet.createStore({
                            key: "CostAllocationUnitId",
                            loadUrl: "/api/ProjectGroup/GetAllCostAllocationData"
                        }),
                        height: 250,
                        width:600,
                        selection: { mode: "single" },
                        hoverStateEnabled: true,
                        paging: { pageSize: 10 },
                        pager: {
                            showPageSizeSelector: true,
                            allowedPageSizes: [5, 10, 20]
                        },
                        columns: [
                            { dataField: "CostAllocationUnitId", width: 60 },
                            { dataField: "CostAllocationUnit",  width: 200 }
                        ],
                        onSelectionChanged: function (e) {
                            var selected = e.selectedRowsData[0];
                            if (selected) {
                                $("#ddCostAllocation").dxDropDownBox("instance").option("value", selected.CostAllocationUnitId);
                            }
                        }
                    });
                });
            </script>
        </text>)

            )


        @(Html.DevExtreme().Button()
            .ID("btnAdd")
            .Text("Add")
            .Icon("plus")
            .Type(ButtonType.Success)
            .OnClick("function(){addProjectToGrid();}")
            .Width(120))

    </div>

<!-- DataGrid -->

        <div class="dx-field ledgerResult">
            @(Html.DevExtreme().DataGrid()
                .ID("SignatoryGrid")
            .KeyExpr("ProjectId")
                .RemoteOperations(false)
                .DataSource(d => d.WebApi()
                .Controller("ProjectGroup")
            .LoadAction("GetProjectAllData")
                .LoadMode(DataSourceLoadMode.Raw)
                )
                .Editing(editing => editing
                .Mode(GridEditMode.Batch)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)
                )
                .Toolbar(toolbar =>
                {
                    toolbar.Items(items =>
                    {
                        items.Add()
                    .Name("saveButton")
                    .Location(ToolbarItemLocation.After)
                    .Visible(false);

                        items.Add()
                    .Name("revertButton")
                    .Location(ToolbarItemLocation.After)
                    .Visible(false);
                    });
                })


                .OnRowUpdating("onProjectUpdating")                       // Handles saving
                .Columns(columns =>
                {
                columns.Add().DataField("ProjectId").Caption("Project ID").AllowEditing(false);
                columns.Add().DataField("ProjectDescription").Caption("Project Description");

                columns.Add().DataField("CostAllocationUnitId").Caption("Cost Center Code").Width(200)
                .Lookup(lookup => lookup
                .DataSource(d => d.WebApi()
                .Controller("StoreCode")
                .LoadAction("GetCostCenter")
                .LoadMode(DataSourceLoadMode.Raw)
                .Key("CostAllocationUnitId")
                )
                .ValueExpr("CostAllocationUnitId")    // This must match your model's field if it's storing the ID
                .DisplayExpr("CostAllocationUnit")
                );
                // Add delete button column
                    columns.Add()
                    .Type(GridCommandColumnType.Buttons)
                    .Buttons(buttons =>
                    {
                        buttons.Add()
                    .Name(GridColumnButtonName.Delete)
                    .Icon("trash") // Use a trash icon
                    .Hint("Delete Row") // Tooltip
                  .OnClick("onDeleteButtonClicks");
                    });
                })
                .Height("60vh")
                .ColumnAutoWidth(true)
                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(f => f.Enabled(true))
                .Paging(p => p.Enabled(true))
                .Scrolling(s => s
                .Mode(GridScrollingMode.Virtual)
                .RowRenderingMode(GridRowRenderingMode.Virtual)
                .PreloadEnabled(true)
                .ScrollByContent(true)
                )
                .ShowBorders(true)
                .ShowRowLines(true)
                .Width("100%")
                )
        </div>
    </div>
    <div class="limited-footer">
        @await Html.PartialAsync("InventoryModuleFooter")
    </div>
    @using (Html.DevExtreme().NamedTemplate("GetProjectContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("GetProject-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("ProjectGroup")
            .LoadAction("GetAllProjectGroupData")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("ProjectGroupCode")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            @* .SearchPanel(sp => sp.HighlightSearchText(true)) *@
            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
            .OnSelectionChanged("dataGridSelectionChanged1")
            .OnInitialized("dataGridInitialized1")
            .HeaderFilter(p => p.Visible(true))
            .ShowBorders(true)
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .FilterRow(f => f.Visible(false))//
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Columns(columns =>
            {
                columns.Add().Caption(new JS("formatMessage('Code')")).DataField("ProjectGroupCode");
                columns.Add().DataField("ProjectGroup");
                columns.Add().DataField("ProjectGroupId");
            })
            )
    }


 <script>
    
        //addProjectGroup
    function AddProjectgroup(){
           const url = `/${tenantName}/IMS/ProjectGroup`;
           const title = "Project Group";
               openModal(url, title,"","90%");
       }
    $(document).ready(function () {

        $(".limited-footer .btn-container").each(function () {

            if (!$(this).find("#btnUpdate,#btnBack").length) {

                $(this).remove();

            }

        });

    });

    $(document).on("click", "#btnBack", function () {
      window.parent.closeModal();
    });
    
     let isUppercase = false;

    function toggleCase() {
        const textBox = $("#ProjectGrpArabic").dxTextBox("instance");

        if (!textBox) {
            console.warn("TextBox instance not found");
            return;
        }

        let value = textBox.option("value") || "";

        if (!value) return;

        if (isUppercase) {
            textBox.option("value", value.toLowerCase());
        } else {
            textBox.option("value", value.toUpperCase());
        }

        isUppercase = !isUppercase;
    }
    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }

    function onKeyDown(e) {
        const ddbInstance = e.component;
        if (e.event.keyCode !== 40) return;
        if (!ddbInstance.option("opened")) {
            ddbInstance.open();
        } else {
            let focusedIndex = dataGrid.option("focusedRowIndex");
            let visibleRows = dataGrid.getVisibleRows().length - 1;
            if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
            dataGrid.focus(dataGrid.getRowElement(focusedIndex));
        }
    }

    function dropDownBoxOnInput(e) {
        const ddbInstance = e.component;
        if (!ddbInstance.option("opened")) ddbInstance.open();


        const text = ddbInstance.option("text");
        if (dataGrid) {
            dataGrid.option("searchPanel.text", text);
        }
    }
    function dataGridInitialized1(e) {
        dataGrid = e.component;
    }
    function dataGridSelectionChanged1(e) {
        const selectedRow = e.selectedRowsData[0];
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#GetProjectDropDown").dxDropDownBox("instance");

        if (selectedRow && selectedKey) {
            // Get ClientCategoryCode (numeric value) and ClientCode (formatted value)
            const ProjectGroupId = selectedRow.ProjectGroupId;
            const ProjectGroupCode = selectedRow.ProjectGroupCode; // Full ClientCode (e.g., "SW-0004")

            // 1. Set value in DropDownBox to ClientCategoryCode (numeric)
            ddbInstance.option("value", ProjectGroupId);

            // 2. Close the DropDownBox after selecting
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }

            // 3. Call generateNextClientCode with the full ClientCode (e.g., "SW-0004")
            generateNextClientCode(ProjectGroupCode);
        }
    }
    function generateNextClientCode(ProjectGroupCode) {

        $.ajax({
            url: `/api/ProjectGroup/GetLatestProjectCode?projectCode=${ProjectGroupCode}`,
            type: 'GET',
            success: function (latestCode) {
                let nextNumber = 1;

                if (latestCode) {
                    const parts = latestCode.split("-");
                    if (parts.length === 2 && !isNaN(parts[1])) {
                        nextNumber = parseInt(parts[1]) + 1;
                    }
                }

                // ✅ Format with leading zeros (e.g., "0004")
                const formattedNumber = String(nextNumber).padStart(5, '0');
                const newClientCode = `${ProjectGroupCode}-${formattedNumber}`;

                $("#txtPrjCode").dxTextBox("instance").option("value", newClientCode);
            },
            error: function () {
                DevExpress.ui.notify("Error getting latest Client Code", "error", 3000);
            }
        });
    }
    function addProjectToGrid() {
        // Validate fields using the Validator components
        const nameValidationResult = $("#txtPrjCode").dxValidator("instance").validate();
        const positionValidationResult = $("#GetProjectDropDown").dxValidator("instance").validate();
        const nameValidationResults = $("#txtProjectDescription").dxValidator("instance").validate();
        const positionValidationResults = $("#GetProjectDropDown").dxValidator("instance").validate();

        if (!nameValidationResult.isValid || !positionValidationResult.isValid || !nameValidationResults.isValid || !positionValidationResults.isValid) {
            DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
            return;
        }

        const data = {
            ProjectId: $("#txtPrjCode").dxTextBox("instance").option("value"),
            ProjectGroupId: $("#GetProjectDropDown").dxDropDownBox("instance").option("value"),
            ProjectDescription: $("#txtProjectDescription").dxTextBox("instance").option("value"),
            CostAllocationUnitId: $("#ddCostAllocation").dxDropDownBox("instance").option("value"),

        };

        $.ajax({
            url: '/api/ProjectGroup/SaveOrUpdateProject',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("ProjectGroup saved successfully!", "success", 2000);
                $("#SignatoryGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save Projectgroup.", "error", 2000);
            }
        });
    }

    $("#btnUpdate").on("click", function () {
        const grid = $("#SignatoryGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });
    function onProjectUpdating(e) {
        
        const data = {
            ProjectId: e.oldData.ProjectId,
            ProjectGroupId: e.newData.ProjectGroupId ?? e.oldData.ProjectGroupId,
            ProjectDescription: e.newData.ProjectDescription ?? e.oldData.ProjectDescription,
            CostAllocationUnitId: e.newData.CostAllocationUnitId ?? e.oldData.CostAllocationUnitId
           };

        e.cancel = true;

        return $.ajax({
            url: '/api/ProjectGroup/SaveOrUpdateProject',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#SignatoryGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }
    function onDeleteButtonClicks(e) {
        e.event.preventDefault(); // prevent default delete

        var grid = $("#SignatoryGrid").dxDataGrid("instance");
        var key = e.row.data.ProjectId; // get the ID of the row


        if (confirm("Are you sure you want to delete this row?")) {
            $.ajax({
                url: '/api/ProjectGroup/Delete1?key=' + key,
                type: 'DELETE',
                success: function () {
                    // Refresh the grid after delete
                    grid.refresh();
                    DevExpress.ui.notify("Deleted successfully", "success", 2000);
                },
                error: function () {
                    DevExpress.ui.notify("Delete failed", "error", 2000);
                }
            });
        }
    }
    $(function () {
        $("#Project").dxTextBox({
            text: formatMessage("Project"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });

 </script>