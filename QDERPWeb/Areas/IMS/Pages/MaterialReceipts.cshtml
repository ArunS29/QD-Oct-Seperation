<script>
		 $(function () {
	$("#MaterialReceipts").dxTextBox({
	text: formatMessage("Material Receipts"),
		readOnly: true,
		onContentReady: function (e) {
		$(e.element).addClass("dx-textbox-heading");
		}
		});
	});
	$(function () {
			var now = new Date();
			var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
			var tillmonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
			$("#frmdateBox").dxDateBox("instance").option("value", firstDay);
			$("#todateBox").dxDateBox("instance").option("value", tillmonth);
			ddBtnShowRecords_click('range');
	});
	function ddBtnShowRecords_click(duration) {
		 var frmDateBox = $("#frmdateBox").dxDateBox("instance");
			var toDateBox = $("#todateBox").dxDateBox("instance");
			var frmDate = new Date(frmDateBox.option("value"));
			var toDate = new Date(toDateBox.option("value"));
			var currentDate = new Date();
			switch (duration) {
				case 'today':
					frmDate = toDate = currentDate;
					break;
				case 'yesterday':
					var dateObj = new Date();
					// Subtract one day from current time
					dateObj.setDate(dateObj.getDate() - 1);
					frmDate = toDate = dateObj;
					break;
				case 'week':
					var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

					// Calculate the start of the week (Saturday)
					var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

					// Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
				frmDate = new Date(currentDate.setDate(startOfWeek)); // 7 days before Saturday
					toDate = new Date(currentDate.setDate(startOfWeek + 6));
					break;
				case 'tillmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = currentDate; //Today
					break;
				case 'fullmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
					break;
				case 'tillyear':
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = currentDate;// Today
					break;
				case 'fullyear':
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
					break;
				case 'lastyear':
					// Get the first and last day of the last year
					frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
					break;
				case 'lastmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
					break;
			}
				frmDate = frmDate.toISOString().split('T')[0];
	toDate = toDate.toISOString().split('T')[0];

				$.ajax({
		url: '/api/MaterialReceipts/GetMaterialReceipt	',
		type: 'GET',
		data: {
			fromDate: frmDate,
			toDate: toDate
		},
		success: function (data) {
			console.log("Returned Data: ", data); // debug
			$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
		},
		error: function (xhr) {
			console.log("AJAX Error", xhr.responseText); // debug
			DevExpress.ui.notify("Error while loading data", "error", 2000);
		}
	});



	}
		function onContextMenuPreparing(e) {
			if (e.target === "content" && e.row && e.row.data) {
				const rowData = e.row.data;
						const ReceiptNo = encodeURIComponent(rowData.ReceiptNo);
				const tenantName = window.tenantName || "defaultTenant";

				e.items = [
					{
							text: "Edit Material Receipt",
						icon: "edit",
						onItemClick: function () {
										const url = `/${tenantName}/IMS/MaterialReceiptFromSupplier?ReceiptNo=${ReceiptNo}`;
							window.location.href = url;
						}
					},
					{
							text: "Preview Material Receipt",
						icon: "doc",
						onItemClick: function () {
							const url = `/${tenantName}/IMS/CreatePurchaseOrder?Rfqno=${Rfqno}`;
							window.location.href = url;
						}
					},
					{
					text: "Delete Material Receipt",
					icon: "trash",
					onItemClick: function () {
						DevExpress.ui.dialog.confirm(
							"You are about to delete the Material Receipt.\nYou cannot revert the changes.\nAre you sure?",
							"Confirm Delete"
						).done(function (dialogResult) {
							if (dialogResult) {
								var ReceiptNo=e.row.data.ReceiptNo;
								console.log("number", ReceiptNo);
								onDeleteReceipt(ReceiptNo);
							}
						});
					}
				},
					
					{
		text: "Unlock the Material Receipt",  // ? Corrected closing quote
		icon: "unlock",
		onItemClick: function () {
			const ReceiptNo = e.row.data.ReceiptNo;

			$.ajax({
				url: "/api/MaterialReceipts/UnlockMaterialReceipt",
				type: "POST",
				contentType: "application/json",
				data: JSON.stringify({ ReceiptNo: ReceiptNo }), // ? sending request data
				success: function (response) {
					DevExpress.ui.notify(response.message, response.success ? "success" : "warning", 2000);
					if (response.success) {
						ddBtnShowRecords_click('range'); // ? refresh or reload the grid
					}
				},
				error: function (xhr) {
					let msg = xhr.responseJSON?.message || "An error occurred while unlocking the Material Receipt.";
					DevExpress.ui.notify(msg, "error", 2000);
					console.error("Unlock failed:", xhr.responseJSON);
				}
			});
		}
	},
					{
							text: "Create a VAT Purchase Voucher",
						icon: "add",
						onItemClick: function () {
							const url = `/${tenantName}/IMS/CreatePurchaseOrder?Rfqno=${Rfqno}`;
							window.location.href = url;
						}
					}
				];
			}
		}
		function onDeleteReceipt(ReceiptNo) {
		if (!ReceiptNo) {
			DevExpress.ui.notify('ReceiptNo is missing.', 'error', 3000);
			return;
		}

		$.ajax({
			url: `/api/MaterialReceipts/DeleteMaterialReceiptView?ReceiptNo=${ReceiptNo}`,
			method: 'POST',
			success: function (response) {
				if (response.success) {
					DevExpress.ui.notify(response.message, 'success', 2000);
					$("#dataGrid").dxDataGrid("instance").refresh();
				} else {
					DevExpress.ui.notify(response.message, 'error', 3000);
				}
			},
			error: function () {
				DevExpress.ui.notify('An error occurred while attempting to delete the receipt.', 'error', 3000);
			}
		});
	}
	$(document).ready(function () {
		console.log('Start permission handling AccountingLedgers');
		// Form ID
		var formId = "frm60110MaterialReceiptView";

		// Call the API to get permissions
		$.ajax({	
			url: '/api/Permissions/GetAccessDetails?formId=' + formId,
			type: 'GET',
			contentType: 'application/json',
			success: function (response) {
				console.log("API Response:", response); // Log the API response

				if (response.success && response.permissions) {
					// Default visibility and enable status for buttons
					var controlStates = {
						"ddButtonLayout": { "Visible": false, "Enabled": false },
						"rowHeightProperties": { "Visible": false, "Enabled": false },
						"btnPrint": { "Visible": false, "Enabled": false },
						"btnToggleSearch": { "Visible": false, "Enabled": false },
						"btntoggleGroupPanel": { "Visible": false, "Enabled": false },
						"btnColumnChooser": { "Visible": false, "Enabled": false },
						"btnMaterialReceiptDetails": { "Visible": false, "Enabled": false },
						"btnAddNewReceipt": { "Visible": false, "Enabled": false },
						"ddBtnShowRecords": { "Visible": false, "Enabled": false },
					};

					// Check for full access
					var fullAccess = response.permissions.find(p =>
						p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
					);

					if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
						// Grant full access: make all controls visible and enabled
						Object.keys(controlStates).forEach(key => {
							controlStates[key] = { "Visible": true, "Enabled": true };
						});
					} else {
						// Update states based on specific permissions for each control
						Object.keys(controlStates).forEach(key => {
							var controlPermission = response.permissions.find(p =>
								p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
							);
							if (controlPermission) {
								controlStates[key] = {
									"Visible": controlPermission.ItemVisible || false,
									"Enabled": controlPermission.ItemEnabled || false
								};
							}
						});
					}

					console.log("Control States:", controlStates);
					Object.keys(controlStates).forEach(key => {
						var button = document.getElementById(key);
						if (button) {
							// Handle visibility
							button.style.display = controlStates[key].Visible ? "inline-block" : "none";
							// Handle enable/disable state
							button.disabled = !controlStates[key].Enabled;
							console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
						} else {
							console.warn(`Button with ID "${key}" not found in the DOM.`);
						}
					});
				} else {
					console.warn("Failed to fetch permissions or no permissions available.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching permissions:", error);
				alert('An error occurred while fetching permissions. Please try again.');
