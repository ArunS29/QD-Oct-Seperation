<script>
		
	function onStatusCardReady(e) {
			const gridInstance = e.component;
			const dataSource = gridInstance.getDataSource();
			const gridId = e.element.attr("id");

			if (!dataSource || !gridId) return;

			const items = gridInstance.option("dataSource");

			const handleData = (data) => {
					if (gridId === "dataGrid") {
					updateStatusTabCounts(data); // For tabs
				} else {
					updatewithtaxAmount(data); // Card 1
					updateTaxAmounts(data);    // Card 2
					updateVoucherCounts(data); // Count-based logic
				}
			};

			if (Array.isArray(items)) {
				handleData(items);
			} else {
				dataSource.load().done(handleData);
			}
		}

		const card = document.getElementById('mainCard');

		const countEls = [
				document.getElementById("verifiedcounttotals"),
				document.getElementById("approvedcounttotals"),
				document.getElementById("submittedcounttotals")
		];

		const tabs = document.querySelectorAll(".tab-text");
		const contents = document.querySelectorAll(".tab-content");

		let counts = [0, 0, 0]; // Verified, Approved, Submitted

		function animateCount(el, target) {
			let i = 0;
			el.innerText = i;
			el.classList.remove('bounce');

			const interval = setInterval(() => {
				if (i >= target) {
					el.innerText = target;
					el.classList.add('bounce');
					clearInterval(interval);
				} else {
					el.innerText = i++;
				}
			}, 20);
		}

		function switchTab(index) {
			tabs.forEach((tab, i) => {
				tab.classList.toggle('active', i === index);
				contents[i].classList.toggle('active', i === index);
			});

			card.className = "card";
			if (index === 0) card.classList.add("today-bg");
			if (index === 1) card.classList.add("week-bg");
			if (index === 2) card.classList.add("month-bg");

			animateCount(countEls[index], counts[index]);
		}



		function updateStatusTabCounts(data) {
			let verified = 0, approved = 0, submitted = 0;

			data.forEach(row => {
				if (row.IsVerified) verified++;
				if (row.IsApproved) approved++;
				if (row.IsSubmitted) submitted++;
			});

			counts = [verified, approved, submitted];

			const activeIndex = [...tabs].findIndex(tab => tab.classList.contains('active'));
			animateCount(countEls[activeIndex], counts[activeIndex]);
		}

		window.addEventListener("DOMContentLoaded", () => {
			switchTab(0);
			// Default: Verified
		});

			let currentSlideIndex = 0;
				const slides = document.querySelectorAll('.voucher-slide');

				setInterval(() => {
					slides[currentSlideIndex].classList.remove('active');

					currentSlideIndex = (currentSlideIndex + 1) % slides.length;

					slides[currentSlideIndex].classList.add('active');
				}, 2000);
					function updatewithtaxAmount(data) {
					let totalCredit = 0;

					if (Array.isArray(data)) {
						totalCredit = data.reduce((sum, item) => {
										const value = parseFloat(item.TotalWithTax || 0);
							return sum + (isNaN(value) ? 0 : value);
						}, 0);
					}

					const formatted = totalCredit.toLocaleString(undefined, {
						minimumFractionDigits: 2,
						maximumFractionDigits: 2
					});

					const svg = `
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="16" height="16" fill="white" style="vertical-align: middle; margin-right: 5px;">
							<path d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z" />
							<path d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z" />
						</svg>`;

					// ✅ Set the content with SVG and value
						const element = document.getElementById('materialtotalwith');
		if (element) {
			element.innerHTML = svg + formatted;
		}
		}
					function updateTaxAmounts(data) {
			let totalCredit = 0;

			if (Array.isArray(data)) {
				totalCredit = data.reduce((sum, item) => {
						const value = parseFloat(item.TotalTaxAmount || 0);
					return sum + (isNaN(value) ? 0 : value);
				}, 0);
			}

			const formatted = totalCredit.toLocaleString(undefined, {
				minimumFractionDigits: 2,
				maximumFractionDigits: 2
			});

				const svg = `
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="16" height="16" fill="white" style="vertical-align: middle; margin-right: 5px;">
								<path d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z" />
								<path d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z" />
							</svg>`;
			const element = document.getElementById('materialamounts');
			if (element) {
				element.innerHTML = svg + formatted;
			}
		}
			function startVoucherSlide() {
				let currentSlide = 0;
				const slides = document.querySelectorAll('.voucher-slide');

				setInterval(() => {
					slides[currentSlide].classList.remove('active');
					currentSlide = (currentSlide + 1) % slides.length;
					slides[currentSlide].classList.add('active');
				}, 2000);
			}

		 $(function () {
	$("#MaterialReceipts").dxTextBox({
	text: formatMessage("Material Receipts"),
		readOnly: true,
		onContentReady: function (e) {
		$(e.element).addClass("dx-textbox-heading");
		}
		});
	});
		 $(function () {
					const dateBox = $("#frmdateBox").dxDateBox("instance");

					// When focus/typing starts, change to dd-MM-yyyy
					$("#frmdateBox").on("focusin", function () {
						dateBox.option("displayFormat", "dd-MM-yyyy");
					});

					// When focus/typing ends, change back to dd-MMM-yyyy
					$("#frmdateBox").on("focusout", function () {
						dateBox.option("displayFormat", "dd-MMM-yyyy");
					});
				});
				 $(function () {
					const dateBox = $("#todateBox").dxDateBox("instance");

					// When focus/typing starts, change to dd-MM-yyyy
					$("#todateBox").on("focusin", function () {
						dateBox.option("displayFormat", "dd-MM-yyyy");
					});

					// When focus/typing ends, change back to dd-MMM-yyyy
					$("#todateBox").on("focusout", function () {
						dateBox.option("displayFormat", "dd-MMM-yyyy");
					});
				});
	$(function () {
			var now = new Date();
			var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
			var tillmonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
			$("#frmdateBox").dxDateBox("instance").option("value", firstDay);
			$("#todateBox").dxDateBox("instance").option("value", tillmonth);
			ddBtnShowRecords_click('range');
	});
	function ddBtnShowRecords_click(duration) {
		 var frmDateBox = $("#frmdateBox").dxDateBox("instance");
			var toDateBox = $("#todateBox").dxDateBox("instance");
			var frmDate = new Date(frmDateBox.option("value"));
			var toDate = new Date(toDateBox.option("value"));
			var currentDate = new Date();
			switch (duration) {
				case 'today':
					frmDate = toDate = currentDate;
					break;
				case 'yesterday':
					var dateObj = new Date();
					// Subtract one day from current time
					dateObj.setDate(dateObj.getDate() - 1);
					frmDate = toDate = dateObj;
					break;
				case 'week':
					var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

					// Calculate the start of the week (Saturday)
					var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

					// Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
				frmDate = new Date(currentDate.setDate(startOfWeek)); // 7 days before Saturday
					toDate = new Date(currentDate.setDate(startOfWeek + 6));
					break;
				case 'tillmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = currentDate; //Today
					break;
				case 'fullmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
					break;
				case 'tillyear':
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = currentDate;// Today
					break;
				case 'fullyear':
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
					break;
				case 'lastyear':
					// Get the first and last day of the last year
					frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
					break;
				case 'lastmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
					break;
			}
				frmDateBox.option("value", frmDate);
				toDateBox.option("value", toDate);
				frmDate.setMinutes(frmDate.getMinutes() - frmDate.getTimezoneOffset());
				toDate.setMinutes(toDate.getMinutes() - toDate.getTimezoneOffset());
				frmDate = frmDate.toISOString().split('T')[0];
				toDate = toDate.toISOString().split('T')[0];

				$.ajax({
					url: '/api/MaterialReceipts/GetMaterialReceipt	',
					type: 'GET',
					data: {
						fromDate: frmDate,
						toDate: toDate
					},
					success: function (data) {
						console.log("Returned Data: ", data); // debug
						$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
					},
					error: function (xhr) {
						console.log("AJAX Error", xhr.responseText); // debug
						DevExpress.ui.notify("Error while loading data", "error", 2000);
					}
				});
	}
		function onContextMenuPreparing(e) {
			if (e.target === "content" && e.row && e.row.data) {
				const rowData = e.row.data;
						const ReceiptNo = encodeURIComponent(rowData.ReceiptNo);
				const tenantName = window.tenantName || "defaultTenant";

				e.items = [
					{
							text: "Edit Material Receipt",
						icon: "edit",
						onItemClick: function () {
										const url = `/${tenantName}/IMS/MaterialReceiptFromSupplier?ReceiptNo=${ReceiptNo}`;
							window.location.href = url;
						}
					},
					
					{
					text: "Delete Material Receipt",
					icon: "trash",
					onItemClick: function () {
						DevExpress.ui.dialog.confirm(
							"You are about to delete the Material Receipt.\nYou cannot revert the changes.\nAre you sure?",
							"Confirm Delete"
						).done(function (dialogResult) {
							if (dialogResult) {
								var ReceiptNo=e.row.data.ReceiptNo;
								console.log("number", ReceiptNo);
								onDeleteReceipt(ReceiptNo);
							}
						});
					}
				},
					
					{
		text: "Unlock the Material Receipt",  // ? Corrected closing quote
		icon: "unlock",
		onItemClick: function () {
			const ReceiptNo = e.row.data.ReceiptNo;

			$.ajax({
				url: "/api/MaterialReceipts/UnlockMaterialReceipt",
				type: "POST",
				contentType: "application/json",
				data: JSON.stringify({ ReceiptNo: ReceiptNo }), // ? sending request data
				success: function (response) {
					DevExpress.ui.notify(response.message, response.success ? "success" : "warning", 2000);
					if (response.success) {
						ddBtnShowRecords_click('range'); // ? refresh or reload the grid
					}
				},
				error: function (xhr) {
					let msg = xhr.responseJSON?.message || "An error occurred while unlocking the Material Receipt.";
					DevExpress.ui.notify(msg, "error", 2000);
					console.error("Unlock failed:", xhr.responseJSON);
				}
			});
		}
	},
	{
    text: "Create VAT Purchase",
    icon: "cart",
    onItemClick: function () {
		debugger;
        const receiptNo = e.row?.data?.ReceiptNo;
        const supplierCode = e.row?.data?.SupplierCode;
        const tenantName = window.tenantName || "defaultTenant";

        if (!receiptNo) {
            DevExpress.ui.notify("Receipt No not available.", "error", 2000);
            return;
        }

        // 1. Check if Purchase Bill already exists
			$.get(`/api/MaterialReceipts/CheckIfPurchaseBillExists?receiptNo=${encodeURIComponent(receiptNo)}`)
            .done(function (exists) {
                if (exists) {
                    DevExpress.ui.notify("Purchase Bill already created for this Receipt.", "error", 3000);
                    return;
                }

                // 2. Optional: check supplier ledger mapping from backend (not required if backend does it)
					$.get(`/api/MaterialReceipts/GetLedgerNo?supplierCode=${encodeURIComponent(supplierCode)}`)
                    .done(function (ledgerNo) {
                        if (!ledgerNo) {
                            DevExpress.ui.notify(
                                "This Supplier is not linked to an Accounting Ledger. Please link before creating VAT Purchase Bill.",
                                "error",
                                4000
                            );
                            return;
                        }

                        // 3. Ask confirmation
                        DevExpress.ui.dialog.confirm(
                            "You are about to create a new VAT Purchase Bill.\nDo you want to continue?",
                            "Confirm"
                        ).done(function (confirmed) {
                            if (!confirmed) return;

                            // 4. Call API - send as object with ReceiptNo (backend expects ReceiptRequest)
                            var payload = { receiptNo: receiptNo };
									 var IsEdit = true;

                            $.ajax({
									url: "/api/MaterialReceipts/CreateVatPurchaseFromReceipt",
                                method: "POST",
                                contentType: "application/json",
                                data: JSON.stringify(payload),
                                success: function (result) {
                                    if (result && result.success) {
                                        DevExpress.ui.notify(result.message, "success", 2000);
                                        // Redirect to edit page (adjust route as needed)
															window.location.href = `/${tenantName}/VAT/VATPurchaseEdit?InvoiceNo=${encodeURIComponent(result.purchaseVoucherNo)}&IsEditflag=${encodeURIComponent(IsEdit)}`;
                                    } else {
                                        DevExpress.ui.notify(result.message || "Failed to create VAT Purchase Bill.", "error", 3000);
                                    }
                                },
                                error: function (xhr) {
                                    var msg = "Server error while creating VAT Purchase Bill.";
                                    if (xhr && xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                                    DevExpress.ui.notify(msg, "error", 3000);
                                }
                            });
                        });
                    })
                    .fail(function () {
                        DevExpress.ui.notify("Error checking supplier ledger mapping.", "error", 3000);
                    });
            })
            .fail(function () {
                DevExpress.ui.notify("Error checking Purchase Bill existence.", "error", 3000);
            });
    }
}



				];
			}
		}
		function onDeleteReceipt(ReceiptNo) {
		if (!ReceiptNo) {
			DevExpress.ui.notify('ReceiptNo is missing.', 'error', 3000);
			return;
		}

		$.ajax({
			url: `/api/MaterialReceipts/DeleteMaterialReceiptView?ReceiptNo=${ReceiptNo}`,
			method: 'POST',
			success: function (response) {
				if (response.success) {
					DevExpress.ui.notify(response.message, 'success', 2000);
						ddBtnShowRecords_click('range');
				} else {
					DevExpress.ui.notify(response.message, 'error', 3000);
				}
			},
			error: function () {
				DevExpress.ui.notify('An error occurred while attempting to delete the receipt.', 'error', 3000);
			}
		});
	}
	$(document).ready(function () {
		console.log('Start permission handling AccountingLedgers');
		// Form ID
		var formId = "frm60110MaterialReceiptView";

		// Call the API to get permissions
		$.ajax({	
			url: '/api/Permissions/GetAccessDetails?formId=' + formId,
			type: 'GET',
			contentType: 'application/json',
			success: function (response) {
				console.log("API Response:", response); // Log the API response

				if (response.success && response.permissions) {
					// Default visibility and enable status for buttons
					var controlStates = {
						"ddButtonLayout": { "Visible": false, "Enabled": false },
						"rowHeightProperties": { "Visible": false, "Enabled": false },
						"btnPrint": { "Visible": false, "Enabled": false },
						"btnToggleSearch": { "Visible": false, "Enabled": false },
						"btntoggleGroupPanel": { "Visible": false, "Enabled": false },
						"btnToggleHeaderFilter": { "Visible": false, "Enabled": false },
						"btnColumnChooser": { "Visible": false, "Enabled": false },
						"btnMaterialReceiptDetails": { "Visible": false, "Enabled": false },
						"btnAddNewReceipt": { "Visible": false, "Enabled": false },
						"ddBtnShowRecords": { "Visible": false, "Enabled": false },
					};

					// Check for full access
					var fullAccess = response.permissions.find(p =>
						p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
					);

					if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
						// Grant full access: make all controls visible and enabled
						Object.keys(controlStates).forEach(key => {
							controlStates[key] = { "Visible": true, "Enabled": true };
						});
					} else {
						// Update states based on specific permissions for each control
						Object.keys(controlStates).forEach(key => {
							var controlPermission = response.permissions.find(p =>
								p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
							);
							if (controlPermission) {
								controlStates[key] = {
									"Visible": controlPermission.ItemVisible || false,
									"Enabled": controlPermission.ItemEnabled || false
								};
							}
						});
					}

					console.log("Control States:", controlStates);
					Object.keys(controlStates).forEach(key => {
						var button = document.getElementById(key);
						if (button) {
							// Handle visibility
							button.style.display = controlStates[key].Visible ? "inline-block" : "none";
							// Handle enable/disable state
							button.disabled = !controlStates[key].Enabled;
							console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
						} else {
							console.warn(`Button with ID "${key}" not found in the DOM.`);
						}
					});
				} else {
					console.warn("Failed to fetch permissions or no permissions available.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching permissions:", error);
				alert('An error occurred while fetching permissions. Please try again.');
			}
		});

		console.log('End permission handling');
	});
		
</script>