@* <div class="title">
    <div class="header-container">
        <div id="JournalVoucherEntry" class="no-border-input"></div>
    </div>
</div> *@

<div>
    <div style="display:flex; align-items:end;">
        @(Html.DevExtreme().TextBox()
            .Label(new JS("formatMessage('Type a New Status & Add  to the Existing List:')"))
            .LabelMode(EditorLabelMode.Floating)
            .ID("Status")
            .Value("")
            .Width("60%")
            )
       
        @(Html.DevExtreme().Button()
            .ID("btnVoucherEntry")
            .Text(new JS("formatMessage('Add')"))
            .Height(60)
            .Icon("plus")
            .OnClick("function() { addVoucherEntry(); }")
            .ElementAttr("style", "width: 170; margin-top: 20px; padding: 2px;")
            )

    </div>



</div>



<div class="dx-field ledgerResult">
    @(
        Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl30103ClientStatusCode>()
        .ID("dataGrid")
        .DataSource(ds => ds.Mvc()
        .Controller("ClientStatusCode")
        .LoadAction("Get"))
        .KeyExpr("StatusCode")
        .RemoteOperations(false)
       
        .Columns(columns =>
        {
            columns.AddFor(m => m.StatusCode).Caption(new JS("formatMessage('Status Code')")).AllowEditing(false).Alignment(HorizontalAlignment.Center);
            columns.AddFor(m => m.Status).Caption(new JS("formatMessage('Status')")).AllowEditing(true).Alignment(HorizontalAlignment.Left);
           
        }
        )
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnChooser(c => c.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))

        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(true))
        .Height("60vh")
        .ColumnAutoWidth(true)
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)

        .Editing(editing => editing
        .Mode(GridEditMode.Batch)
        .AllowUpdating(true))

        .Toolbar(toolbar =>
        {
            toolbar.Items(items =>
            {
                items.Add()
            .Name("saveButton")
            .Location(ToolbarItemLocation.After)
            .Visible(false);

                items.Add()
            .Name("revertButton")
            .Location(ToolbarItemLocation.After)
            .Visible(false);
            });
        })
        .OnRowUpdating("onUnitRowUpdating")
        )
</div>
    

<div class="footer-fixed" style="display:flex; gap:10px:">
            <div>
                @(Html.DevExtreme().Button()
                                .ID("btnUpdate")
                                .Text(new JS("formatMessage('Update')"))
                                .Icon("arrowleft")
                                .OnClick("saveGridChanges")
                                 .ElementAttr(new { @class = "dx-button-custom btn-save" })
                               )
            </div>
            <div>
               
                @(Html.DevExtreme().Button()
                .ID("btnBack")
                .Text(new JS("formatMessage('Back')"))
                .Icon("back")
                .ElementAttr(new { @class = "dx-button-custom btn-back" })
                .OnClick("GoBack"))
    </div>
</div>

<script>
    $("#btnUpdate").on("click", function () {

        const grid = $("#dataGrid").dxDataGrid("instance");

        grid.saveEditData(); // Triggers onUnitRowUpdating

    });


    function onUnitRowUpdating(e) {
        e.cancel = true;
        const data = {

            StatusCode: e.oldData.StatusCode, // Include when updating

      
            Status: e.newData.Status ?? e.oldData.Status

        };

        return $.ajax({

            url: '/api/ClientStatusCode/UpdateClientCategories',

            method: "POST",
            contentType: "application/json", // ✅ Tells the server this is JSON
            data: JSON.stringify([data]),

            success: function (response) {

                DevExpress.ui.notify(response.message, "success", 1500); // ✅ Green message

                $("#dataGrid").dxDataGrid("instance").refresh();
            },

            error: function () {

                DevExpress.ui.notify("Server error", "error", 1500);

            }

        });

    }
    function GoBack() {
          window.parent.closeModal(); // This closes the current window/tab
      }
   

    function addVoucherEntry() {
        
        // Get values from the fields
        var Status = $("#Status").dxTextBox("instance").option("value");
        //var StatusCode = $("#StatusCode").dxTextBox("instance").option("value");


        // Prepare the object to send
        var VE = {
            "Status": Status,
           // "StatusCode": StatusCode,
        };

        // AJAX request to add voucher entry
        $.ajax({
            type: "POST",
            url: "/api/ClientStatusCode/CreateClientCategory",
            contentType: "application/json",
            data: JSON.stringify(VE),
            dataType: "json",
            success: function (response) {
                console.log(response.data);
                // Update the data grid with the new data
                $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);

                $("#Status").dxTextBox("instance").option("value", "");
                $("#StatusCode").dxTextBox("instance").option("value", "");
            },
            error: function (xhr, status, error) {
                DevExpress.ui.notify("Error occurred while updating data: " + error, "error", 3000);
            }
        });
    }


    $(function () {
                       $("#Clientstatus1").text(
                            formatMessage("Client Status"));
      });
          function saveGridChanges() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        const changes = grid.option("editing.changes");

        if (!changes || changes.length === 0) {
            DevExpress.ui.notify("No changes to save.", "info", 2000);
            return;
        }

        const updatePayload = changes.map(change => {
            return {
                key: change.key,
                values: change.data
            };
        });

        $.ajax({
            url: "/ClientStatusCode/BatchUpdate",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(updatePayload),
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 2000);
                    grid.refresh(); // refresh to reflect changes
                } else {
                    DevExpress.ui.notify(response.message || "Save failed.", "error", 3000);
                }
            },
            error: function (xhr) {
                console.error("❌ Batch update error:", xhr);
                DevExpress.ui.notify("Something went wrong while saving.", "error", 3000);
            }
        });
    }

</script>