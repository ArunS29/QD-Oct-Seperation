@page
@model QD.ERP.Web.Areas.IMS.Pages.ClientStatusCodeModel
@{
}
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>

    .form-group {
        display: grid;
        width: 100%;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }

    .select-box {
        width: 20vh;
    }


    .dx-field-label {
        font-weight: bold !important;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="JournalVoucherEntry" class="no-border-input"></div>
    </div>
</div>

<div id="costAllocationPopup" style="display:none;">
    <div style="margin-bottom:10px">
        @(Html.DevExtreme().Button()
            .ID("btnSaveCostAllocation")
            .Icon("save")
            .Text(new JS("formatMessage('Save')"))
            .OnClick("function() { saveCostAllocation(); }")
            )
    </div>
</div>



<div>
    <h2 style="text-align: center;">Client Status</h2>
    <div class="dx-fieldset horizontal-container">

        @(Html.DevExtreme().TextBox()
            .Label(new JS("formatMessage('Type a New Status & Add  to the Existing List:')"))
            .LabelMode(EditorLabelMode.Outside)
            .ID("Status")
            .Value("")
            .Width("60%")
            )
   

       
        @(Html.DevExtreme().Button()
            .ID("btnVoucherEntry")
            .Text(new JS("formatMessage('Add')"))
            .Height(60)
            .Icon("plus")
            .OnClick("function() { addVoucherEntry(); }")
            .ElementAttr("style", "width: 170; margin-top: 20px; padding: 2px;")
            )

    </div>



</div>



<div class="dx-field ledgerResult">
    @(
        Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl30103ClientStatusCode>()
        .ID("dataGrid")
        .DataSource(ds => ds.Mvc()
        .Controller("ClientStatusCode")
        .LoadAction("Get"))
        .KeyExpr("StatusCode")
        .RemoteOperations(false)
        // .OnRowRemoved("onRowRemoved")

        .Columns(columns =>
        {
            columns.AddFor(m => m.StatusCode).Caption(new JS("formatMessage('Status Code')")).AllowEditing(false).Alignment(HorizontalAlignment.Center);
            columns.AddFor(m => m.Status).Caption(new JS("formatMessage('Status')")).AllowEditing(true).Alignment(HorizontalAlignment.Left);
           
        }
        )
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnChooser(c => c.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.Select))

        .ColumnFixing(fixing => fixing.Enabled(true))
        .HeaderFilter(filter => filter.Visible(true))
        .Height(500)
        .ColumnAutoWidth(true)
        .FilterRow(filterRow => filterRow.Visible(false))
        .GroupPanel(groupPanel => groupPanel.Visible(false))
        .ShowBorders(true)

        .Editing(editing => editing
        .Mode(GridEditMode.Cell)
        .AllowUpdating(true)

        )
        .OnRowUpdating("onUnitRowUpdating")

        )
</div>








<div class="container1">
    <div class="card-footer">
        <div class="dx-fieldset horizontal-container1 mt-2" style="display: flex; justify-content: space-between; width:100%; ">
            <div>
                @(Html.DevExtreme().Button()
                    .ID("btnUpdate")
                    .Text(new JS("formatMessage('Update')"))
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    .Icon("Update")

                    )
            </div>
            <div>
                @(Html.DevExtreme().Button()
                    .ID("btnBack")
                    .Text(new JS("formatMessage('Back')"))
                    .Icon("arrowleft")
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    //.OnClick("navigateToHome")

                    )
            </div>
        </div>

    </div>
</div>







<script>
    $("#btnUpdate").on("click", function () {

        const grid = $("#dataGrid").dxDataGrid("instance");

        grid.saveEditData(); // Triggers onUnitRowUpdating

    });


    function onUnitRowUpdating(e) {

        const data = {

            StatusCode: e.oldData.StatusCode, // Include when updating

      
            Status: e.newData.Status ?? e.oldData.Status

        };

        return $.ajax({

            url: '/api/ClientStatusCode/UpdateClientCategories',

            method: "POST",
            contentType: "application/json", // ✅ Tells the server this is JSON
            data: JSON.stringify([data]),

            success: function (response) {

                DevExpress.ui.notify(response.message, "success", 1500); // ✅ Green message

                $("#dataGrid").dxDataGrid("instance").refresh();
            },

            error: function () {

                DevExpress.ui.notify("Server error", "error", 1500);

            }

        });

    }


