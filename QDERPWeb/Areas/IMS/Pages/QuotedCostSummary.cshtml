                .KeyExpr("QuoteChildId")
                .Columns(columns =>
                {
                  @*   columns.AddFor(m => m.)..Caption(new JS("formatMessage('"); *@
                    columns.AddFor(m => m.Gsdescrpition).Caption(new JS("formatMessage('Item Description')"));
                    columns.AddFor(m => m.Gscode).Caption(new JS("formatMessage('GS Code')")).Visible(false);
                    columns.AddFor(m => m.QuoteNo).Caption(new JS("formatMessage('Quotation No')")).Visible(false);
                    columns.AddFor(m => m.QuoteChildId).Caption(new JS("formatMessage('Quote Child ID')")).Visible(false);
