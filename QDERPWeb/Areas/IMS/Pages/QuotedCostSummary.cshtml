</div>
<script>
      let pivotGridInstance;

    $(function() {
      pivotGridInstance = $("#pivotGridContainer").dxPivotGrid({
        dataSource: {
          fields: [
            { dataField: "Gscode", area: "row", caption: formatMessage("Stock Code") },
            { dataField: "Gsdescrpition", area: "row", caption: formatMessage("Stock Description") },
            { dataField: "Group1", area: "column", caption: formatMessage("Cost Group") },
            { dataField: "CostItem", area: "column", caption: formatMessage("Cost Item") },
                { dataField: "UnitCostPriceTotal", area: "data", caption: formatMessage("Cost Total"), summaryType: "sum",format: {
            type: "fixedPoint",
            precision: 2,
            useGrouping: true // adds the comma separator
          }}
          ],
          store: {
            type: "array",
            data: []  // empty on init
          }
        },
        allowSorting: true,
        allowFiltering: true,
        allowExpandAll: true,
        showBorders: true,
        fieldChooser: { enabled: true, allowSearch: true },
        fieldPanel: { visible: true, allowFieldDragging: true },
        loadPanel: { enabled: true },
        height: 500
      }).dxPivotGrid("instance");

      const QuoteNos = new URLSearchParams(window.location.search).get("quotationNo");


        const QuoteNo = QuoteNos ? QuoteNos.split("?")[0] : null;

      if (QuoteNo) {
        loadClientDetails(QuoteNo);
        loadPivotGridData(QuoteNo);
      }
    });

    function loadClientDetails(QuoteNo) {
      $.get(`/api/QuotedCostSummary/GetQuotedCostSummary?QuoteNo=${encodeURIComponent(QuoteNo)}`)
        .done(statusData => {
          const grid = $("#quotedItemsGrid").dxDataGrid("instance");
          if (grid) {
            grid.option("dataSource", statusData);
            grid.refresh();
          }
        })
        .fail(() => DevExpress.ui.notify("Failed to load status data", "error", 3000));
    }

    function loadPivotGridData(QuoteNo) {
      $.get(`/api/QuotedCostSummary/GetquotationCostList?QuoteNo=${encodeURIComponent(QuoteNo)}`)
        .done(data => {
          pivotGridInstance.option('dataSource', {
            fields: pivotGridInstance.option('dataSource').fields,
            store: {
              type: 'array',
              data: data
            }
          });
          pivotGridInstance.getDataSource().reload();
        })
        .fail(xhr => console.error("Error fetching pivot data:", xhr));
    }


     function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }

        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }
        function dataGridInitialized1(e) {
            dataGrid = e.component;
        }
        function dataGridSelectionChanged1(e) {
            const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
            const ddbInstance = $("#ddCostItemDropDown").dxDropDownBox("instance");

            if (selectedKey) {
                ddbInstance.option("value", selectedKey);
                if (ddbInstance.option("opened")) {
                    ddbInstance.close();
                }
            }
        }
         function AddCostItem(){
                        const url = `/${tenantName}/IMS/QuotationCostItems`;
                     const title = formatMessage("Quotation Cost Items");
                      openModal(url, title);
              }



//Footer button click event
                     
 function onDistributeCostClick(distributionMethod) {
     
        const grid = $("#quotedItemsGrid").dxDataGrid("instance");
        const selectedRows = grid.getSelectedRowsData();
     console.log("Selected count:", selectedRows.length); // Should be > 1
    console.table(selectedRows);
        
   

            const costItemCode = $("#ddCostItemDropDown").dxDropDownBox("instance").option("value");
        const postingAmount = $(".dx-numberbox").eq(1).dxNumberBox("instance").option("value");
        const postingPercentage = $(".dx-numberbox").eq(0).dxNumberBox("instance").option("value");

        const quotationNo = new URLSearchParams(window.location.search).get("quotationNo");

        if (!selectedRows.length) {
            DevExpress.ui.notify("No Items are selected for Posting, Please Check again.", "warning", 3000);
            return;
        }

        // Build model array
        const models = selectedRows.map(row => ({
            QuotationNo: quotationNo,
            QuoteChildID: row.QuoteChildId,
            GSCode: row.Gscode,
            QuotedQuantity: row.QuotedQuantity,
            QuotedCostPrice: row.CostPrice,
            PostingAmount: postingAmount,
            PostingPercentage: postingPercentage,
            PostingCostItemCode: costItemCode,
            TotalCostOfItemInclAll: row.TotalCostOfItem
        }));

        // Single AJAX call with all rows
        $.ajax({
            url: `/api/QuotedCostSummary/InsertCostDistribution`,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(models)
        }).done(() => {
            // Run distribution after successful insert/update
            let endpoint = "";

            if (costItemCode === "PM-001") {
                endpoint = distributionMethod === 1 ? "ProfitMarginByEqual"
                    : distributionMethod === 2 ? "ProfitMarginByProportion"
                    : "ProfitMarginByPercentage";
            } else if (costItemCode === "DIS-001") {
                endpoint = distributionMethod === 1 ? "DiscountByEqual"
                    : distributionMethod === 2 ? "DiscountByProportion"
                    : "DiscountByPercentage";
            } else {
                endpoint = distributionMethod === 1 ? "DistributeEqually"
                    : distributionMethod === 2 ? "DistributeByProportion"
                    : "DistributeByPercentage";
            }

            $.ajax({
                url: `/api/QuotedCostSummary/${endpoint}`,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(quotationNo)
            }).done(() => {
                DevExpress.ui.notify("Cost distributed successfully", "success", 3000);
                loadPivotGridData(quotationNo);
            }).fail(err => {
                DevExpress.ui.notify("Distribution failed: " + err.responseText, "error", 3000);
            });

        }).fail(err => {
            DevExpress.ui.notify("Insert failed: " + err.responseText, "error", 3000);
        });
    }
         $(function () {
            $("#selecteditemsfordistribute").text(formatMessage("Select Items for Distribution"));
         });
         $(function () {
            $("#costdiscriptions").text(formatMessage("$ Cost Discription"));
         });
</script>






