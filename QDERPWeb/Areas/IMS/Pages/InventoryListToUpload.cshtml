<input style="display:none;" type="file" id="excel-file" accept=".xlsx, .xls" />

<script>

function preparePayload(items) {
    return items.map((item, index) => ({
        ...item,
     //   GSCode: item.GSCode || `AUTO-GS-${index + 1}`, // Generate GSCode if missing
	   SlNo: index + 1, // Assign a unique SlNo value
       
		 GSCode: item.GSCode && item.GSCode.trim(),
        ItemSize: item.ItemSize ? String(item.ItemSize) : null // Convert ItemSize to string
    }));
}

function uploadItemsToMaterialRequests() {
    const grid = $("#Datagrid").dxDataGrid("instance");
    const dataSource = grid?.getDataSource();
    const items = dataSource?.items() ?? [];

    const preparedItems = preparePayload(items);

    const requestBody = {
        GSGroupCode: "MTRL",
        RequestNo: $("#txtRequestNo").dxTextBox("instance").option("value"),
        Items: preparedItems,
        GSGroupID: 1
    };

    console.log("📦 Final Payload to UploadStock:", requestBody);

    $.ajax({
        url: "/api/InventoryUpload/UploadStock",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(requestBody),
        success: function (result) {
            DevExpress.ui.notify("Stock uploaded successfully.", "success", 3000);
			onUploadButtonClick();
        },
        error: function (xhr) {
            console.error("UploadStock error:", xhr);
            DevExpress.ui.notify("Failed to upload stock.", "error", 3000);
        }
    });
}


			$(document).ready(function () {
			// Get requestNo from query string
			const params = new URLSearchParams(window.location.search);
			const requestNo = params.get("requestNo");

			if (requestNo) {
				// Set the value in the DevExtreme TextBox
				$("#txtRequestNo").dxTextBox("instance").option("value", requestNo);
				// Optionally, make it read-only
				$("#txtRequestNo").dxTextBox("instance").option("readOnly", true);
			}
		});
		function dataGridSelectionChanged1(e) {
			const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
			const ddbInstance = $("#StockGroup").dxDropDownBox("instance");

			if (selectedKey) {
				ddbInstance.option("value", selectedKey);
				if (ddbInstance.option("opened")) {
					ddbInstance.close();
				}
			}
		}
		function dataGridInitialized1(e) {
			dataGrid = e.component;
		}


	function Goback(){
		parent.history.back();
	}

	$(function () {
		 $("#InventoryListsToUpload").dxTextBox({
			text:formatMessage("Inventory List To Upload"),
			readOnly: true,
			onContentReady: function(e) {
			$(e.element).addClass("dx-textcolor-heading");
			}
		 });
	});

       function PastefromExcel() {
        document.getElementById('excel-file').click();
    }

    document.getElementById('excel-file').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();

        reader.onload = function (e) {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });

            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const jsonData = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

            // Validate the data
            const validatedData = jsonData.filter((row, index) => {
                const errors = [];

                // Validate GSDescription
                if (!row.GSDescription || row.GSDescription.trim() === "") {
                    errors.push(`Row ${index + 1}: GSDescription is required.`);
                }

                // Validate RequestQty
                if (!row.RequestQty || isNaN(row.RequestQty) || row.RequestQty <= 0) {
                    errors.push(`Row ${index + 1}: RequestQty must be a positive number.`);
                }

                // Validate UnitPrice
                if (row.UnitPrice !== undefined && (isNaN(row.UnitPrice) || row.UnitPrice < 0)) {
                    errors.push(`Row ${index + 1}: UnitPrice cannot be negative.`);
                }

                // Log errors if any
                if (errors.length > 0) {
                    console.error(errors.join("\n"));
                    DevExpress.ui.notify(errors.join("<br>"), "error", 5000);
                    return false; // Exclude invalid rows
                }

                return true; // Include valid rows
            });

            if (validatedData.length === 0) {
                DevExpress.ui.notify("No valid data found in the uploaded file.", "error", 3000);
                return;
            }

            // Populate the grid with validated data
            const dataGrid = $("#Datagrid").dxDataGrid("instance");
            if (dataGrid) {
                dataGrid.option("dataSource", validatedData);
                DevExpress.ui.notify("Data successfully loaded into the grid.", "success", 3000);
            } else {
                DevExpress.ui.notify("Grid not found", "error", 3000);
            }
        };

        reader.readAsArrayBuffer(file);
    });
	function onUploadButtonClick() {
    const requestNo = $('#txtRequestNo').dxTextBox("instance").option("value");
    if (!requestNo) {
        DevExpress.ui.notify("Request No is required.", "error", 2000);
        return;
    }
    window.location.href = `/${tenantName}/IMS/AddNewClientRequest?Mprno=${encodeURIComponent(requestNo)}`;
}

	function validateGridData() {
    const grid = $("#Datagrid").dxDataGrid("instance");
    const dataSource = grid?.getDataSource();
    const items = dataSource?.items() ?? [];

    const stockGroupCode = $("#StockGroup").dxDropDownBox("instance").option("value");
    const lastNoInStockGroup = 1000; // Replace with the actual value from the server
    const lastNoInUnit = 10; // Replace with the actual value from the server

    return items.map((item, index) => {
        // Generate GSCode if missing
        if (!item.GSCode) {
            item.GSCode = `${stockGroupCode}-${String(lastNoInStockGroup + index + 1).padStart(5, "0")}`;
        }

        // Generate UnitCode if missing
        if (!item.UnitCode) {
            item.UnitCode = `UNIT-${lastNoInUnit + index + 1}`;
        }

        // Ensure ItemSize is a string
        if (item.ItemSize && typeof item.ItemSize !== "string") {
            item.ItemSize = String(item.ItemSize);
        }

        return item; // Include all rows without validation
    });
}

</script>
