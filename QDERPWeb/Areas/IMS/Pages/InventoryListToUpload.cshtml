						}

<input style="display:none;" type="file" id="excel-file" accept=".xlsx, .xls" />

<script>

function uploadItemsToMaterialRequests() {
    debugger;

    const selectedGSGroupId = $("#StockGroup").dxDropDownBox("instance").option("value");
    const requestNo = $("#txtRequestNo").dxTextBox("instance").option("value");
    const grid = $("#Datagrid").dxDataGrid("instance");
    const dataSource = grid?.getDataSource();
    const items = dataSource?.items() ?? [];

    if (!selectedGSGroupId) {
        DevExpress.ui.notify("Please select a Stock Group.", "error", 3000);
        return;
    }

    if (!requestNo) {
        DevExpress.ui.notify("Request No is required.", "error", 3000);
        return;
    }

    if (items.length === 0) {
        DevExpress.ui.notify("No items to upload.", "error", 3000);
        return;
    }

    getGSGroupCode(selectedGSGroupId)
        .then(GSGroupCode => {
            if (!GSGroupCode) {
                DevExpress.ui.notify("GSGroupCode not found.", "error", 3000);
                return;
            }

            const cleanedItems = items.map(item => ({
                GSDescription: item.GSDescription,
                GsdescriptionAr: item.GsdescriptionAr,
                GsuomDesc: item.GsuomDesc || item.GSUoM,
                RequestQty: item.RequestQty,
                UnitPrice: item.UnitPrice,
                PlanNo: item.PlanNo,
                Manufacturer: item.Manufacturer,
                DeliveryPeriod: item.DeliveryPeriod,
                Remarks: item.Remarks,
                ItemSize: item.ItemSize,
                ItemPartNo: item.ItemPartNo,
                ItemBrand: item.ItemBrand,
                ItemColor: item.ItemColor,
                ItemDimension: item.ItemDimension,
                ItemThickness: item.ItemThickness
            }));

            const requestBody = {
                GSGroupCode: selectedGSGroupId,
                RequestNo: requestNo,
                Items: cleanedItems
            };

            uploadStockData(requestBody, grid, requestNo);
        })
        .catch(error => {
            console.error("❌ GetGSGroupCode error:", error);
            DevExpress.ui.notify("Failed to get GSGroupCode: " + error, "error", 3000);
        });
}

// 🔹 Reusable Function to get GSGroupCode
function getGSGroupCode(gsgroupId) {
    return new Promise((resolve, reject) => {
        $.ajax({
            url: `/api/InventoryUpload/GetGSGroupCode?gsgroupId=${gsgroupId}`,
            method: "GET",
            success: resolve,
            error: function (xhr) {
                const msg = xhr.responseText || xhr.statusText || "Unknown error";
                reject(msg);
            }
        });
    });
}

// 🔹 Reusable Function to upload stock
function uploadStockData(requestBody, grid, requestNo) {
    $.ajax({
        url: "/api/InventoryUpload/UploadStock",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(requestBody),
        success: function (result) {
            if (result.success) {
                DevExpress.ui.notify("Stock uploaded and GSCode generated successfully ✅", "success", 3000);
                grid.refresh();

                const tenantName = window.location.pathname.split("/")[1];
                setTimeout(() => {
                    window.location.href = `/${tenantName}/IMS/AddNewClientRequest?requestNo=${encodeURIComponent(requestNo)}`;
                }, 1000);
            } else {
                DevExpress.ui.notify(result.message || "Upload failed", "error", 3000);
            }
        },
        error: function (xhr) {
            let errorMessage = "Unknown error";
            try {
                const response = JSON.parse(xhr.responseText);
                errorMessage = response.message || errorMessage;
            } catch {
                errorMessage = xhr.statusText || errorMessage;
            }
            console.error("❌ UploadStock error:", xhr);
            DevExpress.ui.notify("Upload failed: " + errorMessage, "error", 3000);
        }
    });
}


			$(document).ready(function () {
			// Get requestNo from query string
			const params = new URLSearchParams(window.location.search);
			const requestNo = params.get("requestNo");

			if (requestNo) {
				// Set the value in the DevExtreme TextBox
				$("#txtRequestNo").dxTextBox("instance").option("value", requestNo);
				// Optionally, make it read-only
				$("#txtRequestNo").dxTextBox("instance").option("readOnly", true);
			}
		});
		function dataGridSelectionChanged1(e) {
			const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
			const ddbInstance = $("#StockGroup").dxDropDownBox("instance");

			if (selectedKey) {
				ddbInstance.option("value", selectedKey);
				if (ddbInstance.option("opened")) {
					ddbInstance.close();
				}
			}
		}
		function dataGridInitialized1(e) {
			dataGrid = e.component;
		}


	function Goback(){
		parent.history.back();
	}

	$(function () {
		 $("#InventoryListsToUpload").dxTextBox({
			text:formatMessage("Inventory List To Upload"),
			readOnly: true,
			onContentReady: function(e) {
			$(e.element).addClass("dx-textbox-heading");
			}
		 });
	});

       function PastefromExcel() {
        document.getElementById('excel-file').click();
    }

    document.getElementById('excel-file').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();

        reader.onload = function (e) {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });

            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const jsonData = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

            const dataGrid = $("#Datagrid").dxDataGrid("instance");
            if (dataGrid) {
                dataGrid.option("dataSource", jsonData);
            } else {
                DevExpress.ui.notify("Grid not found", "error", 3000);
            }
        };

        reader.readAsArrayBuffer(file);
    });
	
</script>
