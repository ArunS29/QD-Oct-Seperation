<style type="text/css">
	.overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5); /* Transparent background */
		z-index: 1000;
	}

	.titleCard-toggle1{
		display:none;
	}
	.overlay-content {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100%;
		height: 80%;
		background: #909ead00;
		box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
		border-radius: 8px;
		overflow: hidden;
	}

	#overlay-frame {
		width: 100%;
		height: 100%;
	}

	.mainContainer {
		margin-top: 5em;
		width: 99%;
		padding: 20px; 
	}

	.close-btn {
		position: absolute;
		top: 10px;
		right: 20px;
		font-size: 30px;
		cursor: pointer;
	}




	.footer {
		display: flex;
		align-items: center;
		height: 0px;
		margin-left: auto; /* Pushes it fully to the right */
