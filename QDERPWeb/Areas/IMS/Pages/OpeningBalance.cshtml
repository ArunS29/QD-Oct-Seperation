    <!-- FORM LAYOUT -->
    <div style="display:flex;gap:100px;">
        <div style="display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap; width:100%;">
            <!-- Stock Code -->
            <div style="flex: 1;">
                @(Html.DevExtreme().SelectBox()
                    .ID("txtStockCode")
                    .Label("Stock Code")
                    .LabelMode(EditorLabelMode.Floating)
                    .ReadOnly(true)
                    .StylingMode(EditorStylingMode.Outlined)
                    )
            </div>

            <!-- Description -->
            <div style="flex: 2;">
                @(Html.DevExtreme().TextBox()
                    .ID("txtStockDescription")
                    .Label("Stock Item Description")
                    .LabelMode(EditorLabelMode.Floating)
                    .StylingMode(EditorStylingMode.Outlined)
                    )
            </div>

            <!-- Opening Balance -->
            <div style="flex: 1;">
                @(Html.DevExtreme().NumberBox()
                    .ID("txtOpeningBalance")
                    .Format("#,##0.00")
                    .Label("Opening Balance")
                    .LabelMode(EditorLabelMode.Floating)
                    .StylingMode(EditorStylingMode.Outlined)
                    )
            </div>
        </div>
        <div>
            <div style="gap: 10px;display: flex;flex-direction: column;padding: 10px;">
                @(Html.DevExtreme().NumberBox()
                    .ID("txtOpeningQty")
                    .ReadOnly(true)
                    .ShowSpinButtons(true)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Placeholder("Qty")
                    )
                @(Html.DevExtreme().NumberBox()
                    .ID("txtOpeningRate")
                    .ReadOnly(true)
                    .Format("#,##0.0000")
                    .ShowSpinButtons(true)
                    )
            </div>
        </div>
    </div>

    <!-- GRID -->
    <div>
        @(Html.DevExtreme().DataGrid()
            .ID("gridOpeningBalance")
            .DataSource(new object[] { }) // You can bind actual data here
            .Columns(columns =>
            {
                columns.Add().DataField("StockCode").Caption("Stock Code");
                columns.Add().DataField("Unit").Caption("Unit")
                    .Lookup(lookup => lookup
                    .DataSource(d => d.WebApi()
                    .Controller("StockInventory")
                    .LoadAction("GetUnitCodes")
                    .Key("UnitCode") // Assuming this is the key
                    )
                    .ValueExpr("UnitCode")       // The value from your grid's data
                    .DisplayExpr("UnitType")     // The text you want to show
                    );
                columns.Add().DataField("UnitPrice").Caption("Unit Price");
                columns.Add().DataField("Quantity").Caption("Quantity");
                columns.Add().DataField("ExpiryDate").Caption("Expiry Date").DataType(GridColumnDataType.Date);
                columns.Add().DataField("BatchNo").Caption("Batch No");
            })
            .ShowBorders(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ColumnAutoWidth(true)
            .Height(450)
            .Width("100%")
            .OnCellPrepared("onOpeningBalanceCellPrepared")
            )
    </div>

    <!-- BUTTON FOOTER -->
    <div class="footer-fixed" style="display:flex; gap:10px;">
    @(Html.DevExtreme().Button().ID("btnUpdate").Text("Save & Close").Type(ButtonType.Success).ElementAttr(new { @class = "dx-button-custom btn-save" }).Icon("save"))
    @(Html.DevExtreme().Button().ID("btnPrint").Text("Print").Icon("print"))
    @(Html.DevExtreme().Button().ID("btnDelete").Text("Delete").Icon("trash").ElementAttr(new { @class = "dx-button-custom btn-delete" }).Type(ButtonType.Danger))
    @(Html.DevExtreme().Button().ID("btnBack").Text("Back").Icon("arrowleft").ElementAttr(new { @class = "dx-button-custom btn-back" }).Type(ButtonType.Normal))
    </div>

 <script>

    $(document).ready(function () {

          $(".limited-footer .btn-container").each(function () {

              if (!$(this).find("#btnUpdate,#btnBack").length) {

                  $(this).remove();

              }

          });
      });

    $(document).on("click", "#btnBack", function () {
        window.parent.closeModal();
    });

      $(function () {
            $("#DatabaseSignatories").dxTextBox({
                text: formatMessage("Database "),
                readOnly: true,
                           

            });
        });

    $(function () {
        $("#Openingbalance").dxTextBox({
            text: formatMessage("Opening Balance Entries"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    async function convertToArabic(sourceId, targetId) {
        const sourceBox = $("#" + sourceId).dxTextBox("instance");
        const targetBox = $("#" + targetId).dxTextBox("instance");

        if (!sourceBox || !targetBox) {
            console.error("TextBox not initialized.");
            return;
        }

        const sourceText = sourceBox.option("value");

        if (!sourceText || sourceText.trim() === "") {
            alert("Please enter a value to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(sourceText);
            targetBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    
  
    function addStoreToGrid() {
        // Validate fields using the Validator components
        //const nameValidationResult = $("#SignatoryName").dxValidator("instance").validate();
        //const positionValidationResult = $("#SignatoryPosition").dxValidator("instance").validate();

        // if (!nameValidationResult.isValid || !positionValidationResult.isValid) {
        //     DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
        //     return;
        // }

        const data = {
            StoreId: $("#txtStoreCode").dxTextBox("instance").option("value"),
            StoreName: $("#txtStoreName").dxTextBox("instance").option("value"),
          
            CostAllocationUnitId: $("#ddCostcenter").dxDropDownBox("instance").option("value")
           
        };

        $.ajax({
            url: '/api/StoreCode/SaveOrUpdateStory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Story saved successfully!", "success", 2000);
                $("#gridOpeningBalance").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save Story.", "error", 2000);
            }
        });
    }


    $("#btnUpdate").on("click", function () {
        const grid = $("#gridOpeningBalance").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


    function onStoryUpdating(e) {
        
        const data = {
            StoreId: e.oldData.StoreId,
            StoreName: e.newData.StoreName ?? e.oldData.StoreName,
            CostAllocationUnitId: e.newData.CostAllocationUnitId ?? e.oldData.CostAllocationUnitId
          
        };

        e.cancel = true; // prevents grid from doing its own update

        return $.ajax({
            url: '/api/StoreCode/SaveOrUpdateStory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#gridOpeningBalance").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }
          $(function () {
        setTimeout(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const gscode = urlParams.get('gscode');
            const description = urlParams.get('description');
            const openingbal = urlParams.get('OpeningBalance');
            const costPrice = urlParams.get('CostPrice');

            console.log("URL Params - gscode:", gscode, "description:", description);

            const stockBox = $("#txtStockCode").dxSelectBox("instance");
            const descBox = $("#txtStockDescription").dxTextBox("instance");
            const openingBalBox = $("#txtOpeningBalance").dxNumberBox("instance");
            const costPriceBox = $("#txtOpeningRate").dxNumberBox("instance");
            if (gscode) {
                stockBox.option("acceptCustomValue", true); // This is important
                stockBox.option("value", gscode);
            }

            if (description) {
                descBox.option("value", description);
            }

            if (openingbal) {
                openingBalBox.option("value", openingbal);
            }

            if (costPrice) {
                costPriceBox.option("value", costPrice);
            }

            loadOpeningBalanceGrid(gscode);
        }, 300);
    });

    function loadOpeningBalanceGrid(gscode) {
        if (!gscode) return;

        $.ajax({
            url: `/api/StockInventory/GetOpeningBalanceByGscode`,  // Your API endpoint
            data: { gscode: gscode },
            method: "GET",
            success: function(data) {
                // Assuming data is an array of records matching your grid columns
                $("#gridOpeningBalance").dxDataGrid("instance").option("dataSource", data);
            },
            error: function(err) {
                console.error("Error loading opening balance data", err);
            }
        });
    }
    function onOpeningBalanceCellPrepared(e) {
        if (e.rowType === "data") {
            const greenColumns = ["Quantity", "ExpiryDate", "BatchNo"];
            if (greenColumns.includes(e.column.dataField)) {
                e.cellElement.css("background-color", "#d4edda"); // light green
            }
        }
    }

   


    </script>