				subColumns.AddFor(m => m.QuotedQuantity).Caption("QuotedQuantity").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.DeliveryTerms).Caption("DeliveryTerms").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.QuoteRemarks).Caption("QuoteRemarks").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.QuotedUnitPrice).Caption("QuotedUnitPrice").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.LineTotalBeforeDiscount).Caption("LineTotalBeforeDiscount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.QuotedDiscount).Caption("QuotedDiscount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.LineTotalAfterDiscount).Caption("LineTotalAfterDiscount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.LineTaxAmount).Caption("LineTaxAmount").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.LineTotalWithTax).Caption("LineTotalWithTax").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.BalanceToDeliver).Caption("BalanceToDeliver").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.TotalOrderedQty).Caption("TotalOrderedQty").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.TotalIssdQty).Caption("TotalIssdQty").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.DeliveryPeriod).Caption("DeliveryPeriod").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.CostPrice).Caption("CostPrice").Alignment(HorizontalAlignment.Center).Visible(true);

			});
		})
		.Height(680) // Fixed height for the grid
		.ColumnAutoWidth(true)
		.Width("98%")
		.WordWrapEnabled(true)
		.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.Paging(p => p.Enabled(false))
		.Pager(pager => pager.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.ShowRowLines(true)


		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.StateStoring(stateStoring =>
		{
			stateStoring
			.Enabled(true)
			.Type(StateStoringType.LocalStorage)
			.StorageKey("gridContainerState");
		})
		.OnInitialized("function(e) { loadGridState(); }")
		)


