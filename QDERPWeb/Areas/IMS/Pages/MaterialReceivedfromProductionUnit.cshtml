    </div>
</div>

<table class="dx-field-table" style="padding:20px;">
    <tr>
        <td>
            @(Html.DevExtreme().TextBox()
                .ID("DeliveryNoteNo")
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Delivery Note No:')")))
        </td>

        <td>
            @(Html.DevExtreme().DateBox()
            .Label(new JS("formatMessage('Date:')"))
            .ID("DeliveryDate")
            .Type(DateBoxType.Date)
            .DisplayFormat("dd-MMM-yyyy")
            .Value(DateTime.Now)
            .LabelMode(EditorLabelMode.Floating)
            .Width("100%")
            )
        </td>

        <td>
            @(Html.DevExtreme().TextBox()
                .ID("ReceivedFrom")
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Received From:')")))
        </td>
        <td >
            @(Html.DevExtreme().NumberBox()
                        .ID("Amount")
                        .Min(1)
                        .ShowSpinButtons(true)
                        .LabelMode(EditorLabelMode.Floating)
                        .Label(new JS("formatMessage('Amount')")))
        </td>
       
    </tr>
</table>

<table class="dx-field-table" style="padding:20px;"  >
    <tr>
        <td colspan="3">
          
       
        @(Html.DevExtreme().DropDownBox()
							.ID("ddItemDescription")
                .Label(new JS("formatMessage('Item Description:')"))
							.LabelMode(EditorLabelMode.Floating)
							.DataSource(d => d.WebApi()
								.Controller("DeliveryNote")
                            .LoadAction("GetDescription")
								.LoadMode(DataSourceLoadMode.Raw)
                .Key("Gscode")
							)
                .ValueExpr("Gscode")
                .DisplayExpr("Gsdescrpition")
							.AcceptCustomValue(true)
							.ValueChangeEvent("input")
							.HoverStateEnabled(true)
							.OpenOnFieldClick(false)
							.TabIndex(1)
							.Width("100%")
							.OnInput("dropDownBoxOnInput")
							.OnOpened("onOpened")
							.OnKeyDown("onKeyDown")
							.ContentTemplate(new TemplateName("GetProjectContentTemplate"))
							
					
						)
                         </td>
        <td>
         
              
              
                @(Html.DevExtreme().DropDownBox()
							.ID("ddUOM")
                .Label(new JS("formatMessage('UOM:')"))
							.LabelMode(EditorLabelMode.Floating)
							.DataSource(d => d.WebApi()
								.Controller("DeliveryNote")
                            .LoadAction("GetUOM")
								.LoadMode(DataSourceLoadMode.Raw)
                        .Key("UnitCode")
							)
                .ValueExpr("UnitCode")
                .DisplayExpr("UnitType")
							.AcceptCustomValue(true)
							.ValueChangeEvent("input")
							.HoverStateEnabled(true)
							.OpenOnFieldClick(false)
							.TabIndex(1)
							.Width("100%")
							.OnInput("dropDownBoxOnInput")
							.OnOpened("onOpened")
							.OnKeyDown("onKeyDown")
							.ContentTemplate(new TemplateName("GetProjectContentTemplate1"))
							
					
						)
        </td>

        <td>
            @(Html.DevExtreme().NumberBox()
                .ID("Qty")
                .Min(1)
                .ShowSpinButtons(true)
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Quantity')")))
        </td>
        <td>
            @(Html.DevExtreme().NumberBox()
                .ID("UnitPrice")
                .Format("#,##0.00")
                .LabelMode(EditorLabelMode.Floating)
                .Label(new JS("formatMessage('Unit Price')")))
        </td>

        <td style="display:flex; align-items:end;">
            @(Html.DevExtreme().NumberBox()
                .ID("TotalAmount")
                .Format("#,##0.00")
                .Width("70%")
                .LabelMode(EditorLabelMode.Floating)
                .ReadOnly(true)
                .Label(new JS("formatMessage('Amount')")))
     
            @(Html.DevExtreme().Button()
                .ID("btnAdd")
                .Text("Add")
                .Type(ButtonType.Success)
                .Icon("plus")
                .OnClick("addCostItem"))
        </td>
    </tr>
</table>

