<style>

    .dx-datagrid-column-chooser-button {
        display: none !important;
    }

    .dx-fieldset {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 15px;
        padding: 20px;
        background-color: transparent;
        width: 250px;
        height: 10%;
    }


    .dx-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-left: 10px;
    }

    .field-label {
        font-weight: bold;
    }

    .aligned-input {
        width: 100%;
    }

    .input-group {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .dx-textarea {
        width: 100%;
        height: 60px;
    }

    .dx-card {
        width: 1000px;
        background: var(--background-color);
    }

    .limited-footer .btn-container:not(:has(#btnUpdate,#btnBack)) {
        display: none !important;
    }

    .container {
        display: none !important;
    }

    .dx-button-text {
        color: black;
    }

    .input-button {
        color: black;
    }

    .dx-button-mode-contained.dx-button-success .dx-icon {
        color: black;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .playIcon {
        display: none;
    }

    .dx-label-cell {
        text-align: right;
        font-weight: bold;
        padding-right: 8px;
        white-space: nowrap;
    }

    .dx-field-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 10px 6px;
    }

        .dx-field-table td {
            vertical-align: middle;
        }

    .form-header {
        color: white;
        padding: 10px;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
    }
</style>

<div class="title">
