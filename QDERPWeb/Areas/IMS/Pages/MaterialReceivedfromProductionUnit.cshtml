<script>
          $(function () {
            const urlParams = new URLSearchParams(window.location.search);
    const deliveryNoteNo = urlParams.get("DeliveryNoteNo");
    const deliveryDate = urlParams.get("DeliveryDate");
  

             $("#DeliveryNoteNo").dxTextBox("instance").option("value",deliveryNoteNo);
             $("#DeliveryDate").dxDateBox("instance").option("value",deliveryDate);
    if (deliveryNoteNo) {
        $.ajax({
            url: `/api/DeliveryNote/GetDeliveryAmount?deliveryNoteNo=${encodeURIComponent(deliveryNoteNo)}`,

            type: "GET",
            dataType: "json",
            success: function (response) {
                if (response && response.TotalAfterDiscount !== undefined) {
                    // Assign value to your DevExtreme field
                    $("#Amount").dxNumberBox("instance").option("value", response.TotalAfterDiscount);
                }
            },
            error: function () {
                DevExpress.ui.notify("Failed to load delivery amount", "error", 3000);
            }
        });
    }

   
          });

   // initially load grid
    $(document).ready(function () {
    var deliveryNo = $("#DeliveryNoteNo").dxTextBox("instance").option("value");

    if (!deliveryNo) return;

    $.ajax({
        url: `/api/DeliveryNote/GetMaterialReceiptByDeliveryNo?deliveryNo=${encodeURIComponent(deliveryNo)}`,
        type: 'GET',
        success: function (statusData) {
            const grid = $("#MaterialReceiptdataGrid").dxDataGrid("instance");
            if (grid) {
                grid.option("dataSource", statusData);
                grid.refresh();
            }
        },
        error: function () {
            DevExpress.ui.notify("Failed to load material receipt data", "error", 3000);
        }
    });
});


   

    function formatMessage(labelText) {
        return labelText;
    }

        $(function () {
        $("#AddQuotationCostItem").dxTextBox({
            text: formatMessage("Additional Cost On Items"),
                readOnly: true,
                onContentReady: function (e) {
                    $(e.element).addClass("dx-textbox-heading");
                }
            });
        });
            function Goback() {
        window.parent.closeModal(); // This closes the current window/tab
    }

          function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }
        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }
        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();
            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }
        function dataGridInitialized1(e) {
            dataGrid = e.component;
        }
        function dataGridSelectionChanged2(e) {
            const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
            const ddbInstance = $("#ddUOM").dxDropDownBox("instance");
            if (selectedKey) {
                ddbInstance.option("value", selectedKey);
                if (ddbInstance.option("opened")) {
                    ddbInstance.close();
                }
            }
         }
        function dataGridInitialized2(e) {
            dataGrid = e.component;
        }
        function dataGridSelectionChanged1(e) {
    const selectedRow = e.selectedRowsData[0]; // Get the full row data
    const ddbInstance = $("#ddItemDescription").dxDropDownBox("instance");

    if (selectedRow) {
        // ✅ Set description DropDown value
        ddbInstance.option("value", selectedRow.Gscode);

        // ✅ Bind UOM
        if (selectedRow.GsuoM) {
            $("#ddUOM").dxDropDownBox("instance").option("value", selectedRow.GsuoM);
        }

        // ✅ Bind Cost Price (as Unit Price)
        if (selectedRow.CostPrice) {
            $("#UnitPrice").dxNumberBox("instance").option("value", selectedRow.CostPrice);
        }

        // ✅ Default quantity = 1
        $("#Qty").dxNumberBox("instance").option("value", 1);

        // Close the dropdown after selection
        if (ddbInstance.option("opened")) {
            ddbInstance.close();
        }
    }
}

function calculateTotal(){
     const qty = $("#Qty").dxNumberBox("instance").option("value") || 0;
    const unitPrice = $("#UnitPrice").dxNumberBox("instance").option("value") ||0;
    Total = qty * unitPrice;

    $("#TotalAmount").dxNumberBox("instance").option("value",Total);
}
     
$(document).ready(function () {
    $("#Qty").dxNumberBox("instance").on("valueChanged", calculateTotal);
    $("#UnitPrice").dxNumberBox("instance").on("valueChanged", calculateTotal);
});
function addCostItem() {
    var deliveryNo = $("#DeliveryNoteNo").dxTextBox("instance").option("value");
    if (!deliveryNo) {
        DevExpress.ui.notify("Delivery Note No is required", "error", 3000);
        return;
    }

    // Step 1: check if a ReceiptNo already exists for this DeliveryNoteNo
    $.ajax({
        url: `/api/DeliveryNote/GetReceiptNoByDeliveryNo?deliveryNo=${encodeURIComponent(deliveryNo)}`,
        type: "GET",
        success: function (res) {
            if (!res.success) {
                DevExpress.ui.notify("Failed to check existing receipt", "error", 3000);
                return;
            }

            if (res.isNew) {
                // Step 2: No existing ReceiptNo, generate new
                $.ajax({
                    url: "/api/DeliveryNote/GetNewReceiptNo",
                    type: "GET",
                    success: function (res2) {
                        saveMaterialReceipt(res2.receiptNo); // call function to save
                    },
                    error: function () {
                        DevExpress.ui.notify("Failed to generate new Receipt No", "error", 3000);
                    }
                });
            } else {
                // Use existing ReceiptNo
                saveMaterialReceipt(res.receiptNo);
            }
        },
        error: function () {
            DevExpress.ui.notify("Failed to check existing receipt", "error", 3000);
        }
    });
}

// Step 3: Function to read fields and save
function saveMaterialReceipt(receiptNo) {
    const dto = {
        ReceiptNo: receiptNo,
        DeliveryNoteNo: $("#DeliveryNoteNo").dxTextBox("instance").option("value"),
        DeliveryDate: $("#DeliveryDate").dxDateBox("instance").option("value"),
        ReceivedFrom: $("#ReceivedFrom").dxTextBox("instance").option("value"),
        Amount: $("#Amount").dxNumberBox("instance").option("value"),
        Items: []
    };

    const itemCode = $("#ddItemDescription").dxDropDownBox("instance").option("value");
    const uom = $("#ddUOM").dxDropDownBox("instance").option("value");
    const qty = $("#Qty").dxNumberBox("instance").option("value");
    const unitPrice = $("#UnitPrice").dxNumberBox("instance").option("value");
    const totalAmount = $("#TotalAmount").dxNumberBox("instance").option("value");

    if (!itemCode || !uom || !qty || !unitPrice) {
        DevExpress.ui.notify("Please fill all mandatory item fields", "error", 3000);
        return;
    }

    dto.Items.push({
        ItemCode: itemCode,
        UnitRateMethod: uom,
        QtyReceived: qty,
        UnitPrice: unitPrice,
        TotalAmount: totalAmount
    });

    $.ajax({
        url: "/api/DeliveryNote/SaveMaterialReceipt",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(dto),
        success: function (res) {
            if (res.success) {
                DevExpress.ui.notify(res.message, "success", 3000);
                loadMaterialReceiptGrid(res.ReceiptNo); // reload grid for this ReceiptNo
            } else {
                DevExpress.ui.notify(res.message, "error", 3000);
            }
        },
        error: function () {
            DevExpress.ui.notify("Error saving material receipt", "error", 3000);
        }
    });
}
function loadMaterialReceiptGrid(ReceiptNo) {
    $.ajax({
        url: `/api/DeliveryNote/GetMaterialReceipt?ReceiptNo=${encodeURIComponent(ReceiptNo)}`,
        type: 'GET',
        success: function (statusData) {
            const grid = $("#MaterialReceiptdataGrid").dxDataGrid("instance");
            if (grid) {
                grid.option("dataSource", statusData);
                grid.refresh();
            }
        },
        error: function () {
            DevExpress.ui.notify("Failed to load status data", "error", 3000);
        }
    });
}



  $("#Update").on("click", function () {
        const grid = $("#MaterialReceiptdataGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


    function onStoryUpdating(e) {
    const data = {
        ReceiptChildSlNo: e.oldData.ReceiptChildSlNo,
        QtyReceived: e.newData.QtyReceived ?? e.oldData.QtyReceived,
        UnitRateMethod: e.newData.UnitRateMethod ?? e.oldData.UnitRateMethod,
        UnitPrice: e.newData.UnitPrice ?? e.oldData.UnitPrice
    };

    e.cancel = true; 

    return $.ajax({
        url: '/api/DeliveryNote/UpdateMaterialReceipt',
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(data),
        success: function (res) {
            if (res.success) {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);

                // ✅ Use ReceiptNo from API response
                const receiptNo = res.ReceiptNo;
                if (receiptNo) {
                    loadMaterialReceiptGrid(receiptNo);
                }
            } else {
                DevExpress.ui.notify(res.message, "error", 1500);
            }
        },
        error: function () {
            DevExpress.ui.notify("Failed to save.", "error", 1500);
        }
    });
}


    function deleteMaterialReceipt() {
    const deliveryNoteNo = $("#DeliveryNoteNo").dxTextBox("instance").option("value");

    if (!deliveryNoteNo) {
        DevExpress.ui.notify("Delivery Note No is required.", "error", 2000);
        return;
    }

    DevExpress.ui.dialog.confirm("Are you sure you want to delete all receipts under this Delivery Note?", "Confirm")
        .done(function (dialogResult) {
            if (!dialogResult) return;

            $.ajax({
                url: `/api/DeliveryNote/DeleteMaterialReceipt?deliveryNoteNo=${encodeURIComponent(deliveryNoteNo)}`,
                type: "DELETE",
                success: function (res) {
                    if (res.success) {
                        DevExpress.ui.notify(res.message, "success", 3000);
                        $("#MaterialReceiptdataGrid").dxDataGrid("instance").option("dataSource", []); // clear grid
                    } else {
                        DevExpress.ui.notify(res.message, "error", 3000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Failed to delete material receipt.", "error", 3000);
                }
            });
        });
}

$("#PostJournal").on("click", function () {
    
    const deliveryNoteNo = $("#DeliveryNoteNo").dxTextBox("instance").option("value");

    if (!deliveryNoteNo) {
        DevExpress.ui.notify("Delivery Note No are required.", "error", 3000);
        return;
    }

    DevExpress.ui.dialog.confirm("Are you sure you want to post this Material Receipt to Journal?", "Confirm")
        .done(function (dialogResult) {
            if (!dialogResult) return;

     $.ajax({
    url: "/api/DeliveryNote/PostJournal",
    type: "POST",
     contentType: "application/json",
    data: JSON.stringify({ DeliveryNoteNo: deliveryNoteNo }),
    success: function (res) {
        if (res.success) {
            DevExpress.ui.notify(res.message, "success", 3000);
            $("#MaterialReceiptdataGrid").dxDataGrid("instance").refresh();
        } else {
            DevExpress.ui.notify(res.message, "error", 3000);
        }
    },
   error: function (xhr) {
    try {
        const res = JSON.parse(xhr.responseText);
        DevExpress.ui.notify(res.message || "Error while posting receipt.", "error", 3000);
    } catch {
        DevExpress.ui.notify("Error while posting receipt.", "error", 3000);
    }
}

});

        });
});




