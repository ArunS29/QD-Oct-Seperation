	const card = document.getElementById('mainCard');

	// Count elements for each tab
	const countEls = [
		document.getElementById("count0"),
		document.getElementById("count1"),
		document.getElementById("count2"),
		document.getElementById("count3"),
	];

	const tabs = document.querySelectorAll(".tab-text");
	const contents = document.querySelectorAll(".tab-content");

	// Hold dynamic count values here
	let counts = [0, 0, 0, 0];

	function animateCount(el, target) {
		let i = 0;
		el.innerText = i;
		el.classList.remove('bounce');

		const interval = setInterval(() => {
			if (i >= target) {
				el.innerText = target;
				el.classList.add('bounce');
				clearInterval(interval);
			} else {
				el.innerText = i++;
			}
		}, 20);
	}

	function switchTab(index) {
		tabs.forEach((tab, i) => {
			tab.classList.toggle('active', i === index);
			contents[i].classList.toggle('active', i === index);
		});

		card.className = "card"; // Reset all card styles
		if (index === 0) card.classList.add("verified-bg");
		if (index === 1) card.classList.add("approved-bg");
		if (index === 2) card.classList.add("submitted-bg");
		if (index === 3) card.classList.add("cancelled-bg");

		animateCount(countEls[index], counts[index]);
	}

	// 🔄 Update count values dynamically from DevExtreme grid data
	function updateStatusTabCounts(data) {
		let verified = 0, approved = 0, submitted = 0, cancelled = 0;

		data.forEach(row => {
			if (row.IsVerified) verified++;
			if (row.IsApproved) approved++;
			if (row.IsSubmitted) submitted++;
			if (row.IsCancelled) cancelled++;
		});

		counts = [verified, approved, submitted, cancelled];

		// Optionally animate the active tab again
		const activeIndex = [...tabs].findIndex(tab => tab.classList.contains('active'));
		animateCount(countEls[activeIndex], counts[activeIndex]);
	}

	// ✅ Auto-run Verified count on load
	window.addEventListener("DOMContentLoaded", () => {
		switchTab(0); // Default tab
	});



	  

