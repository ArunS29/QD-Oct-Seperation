			if (!mprNo) {
				DevExpress.ui.notify("MPR No not found.", "error", 2000);
				return;
			}

			DevExpress.ui.dialog.confirm(
				"You are about to revise this Purchase Request. Are you sure you want to continue adding a new revised Purchase Request?",
				"Confirm Revision"
			).done(function (result) {
				if (!result) return;

				$.ajax({
					url: "/api/MaterialRequestEnquiriesDetails/ReviseRequest",
					type: "POST",
					contentType: "application/json",
					data: JSON.stringify(mprNo),
					success: function (response) {
						DevExpress.ui.notify(response.message, "success", 2000);
						$("#dataGrid").dxDataGrid("instance").refresh();

						// ✅ Navigate to new page based on RequestEnquiry
						if (response.newMprNo) {
							const tenantName = window.tenantName || "defaultTenant";
							let url = "";
							let title = "";

							switch (requestEnquiry) {
								case "Client Request":
									url = `/${tenantName}/IMS/AddNewClientRequest?Mprno=${encodeURIComponent(response.newMprNo)}`;
									title = "Edit Client Request";
									break;
								case "Project Request":
									url = `/${tenantName}/IMS/MRAddNewProjectRequest?Mprno=${encodeURIComponent(response.newMprNo)}`;
									title = "Edit Project Request";
									break;
								case "Store Request":
									url = `/${tenantName}/IMS/MRAddNewStoreRequest?Mprno=${encodeURIComponent(response.newMprNo)}`;
									title = "Edit Store Request";
									break;
								default:
									console.warn("Unknown RequestEnquiry type:", requestEnquiry);
									return;
							}

							// 👇 Navigate to the target page
							window.location.href = url;
						}
					},
					error: function (xhr) {
						let msg = xhr.responseJSON?.message || "Revision failed.";
						DevExpress.ui.notify(msg, "error", 2000);
						console.error("Revision error:", xhr.responseJSON);
					}
				});
			});
