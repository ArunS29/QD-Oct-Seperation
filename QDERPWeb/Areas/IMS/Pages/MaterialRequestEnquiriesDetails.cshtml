	function ddBtnShowRecords_click(duration) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var frmDate = new Date(frmDateBox.option("value"));
		var toDate = new Date(toDateBox.option("value"));
		var currentDate = new Date();

		switch (duration) {
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
					 case 'q1': // Jan - Mar
					startDate = new Date(today.getFullYear(), 0, 1);
					endDate = new Date(today.getFullYear(), 2, 31);
					break;

				case 'q2': // Apr - Jun
					startDate = new Date(today.getFullYear(), 3, 1);
					endDate = new Date(today.getFullYear(), 5, 30);
					break;

				case 'q3': // Jul - Sep
					startDate = new Date(today.getFullYear(), 6, 1);
					endDate = new Date(today.getFullYear(), 8, 30);
					break;

				case 'q4': // Oct - Dec
					startDate = new Date(today.getFullYear(), 9, 1);
					endDate = new Date(today.getFullYear(), 11, 31);
					break;
		}

		frmDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		toDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		FromDate = frmDate;
		ToDate = toDate;

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		$.ajax({
			url: '/api/MaterialRequestEnquiriesDetails/GetVatCreditNoteDetails',
			type: 'GET',
			data: {
				frmDate: frmDate,
				toDate: toDate
			},
			success: function (data) {
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
				var dataGrid = $("#dataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.option("dataSource");
				if (dataSource && dataSource.length > 0) {
					var lastRow = dataSource[dataSource.length - 1];
					VoucherAmountFormatted = lastRow.VoucherAmountFormatted;
					var firstRow = dataSource[0];
					firstrowVoucherAmountFormatted = firstRow.VoucherAmountFormatted;
				}
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}
	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
			function quarterSubMenu(e) {
			e.event.stopPropagation();
			hideAllSubmenus(); // Hide all submenus before showing the selected one
			var $submenu = $('#quarterSubMenu');
			var $target = $(e.event.target).closest('.dx-item-content');
			var offset = $target.offset();
			var submenuWidth = $submenu.outerWidth();

			// Calculate left-side positioning
			var leftPos = offset.left - submenuWidth + 533;

			// Prevent submenu from going off-screen on the left
			if (leftPos < 0) {
				leftPos = offset.left + $target.outerWidth() + 5; // Move it to the right if not enough space
			}

			// Position submenu
			$submenu.css({
				'width': 250,
				'position': 'absolute',
				'top': offset.top,
				'left': leftPos,
				'display': 'block',
				'background': '#fff',
				'border': '1px solid #ccc',
				'box-shadow': '2px 2px 5px rgba(0,0,0,0.2)',
				'padding': '5px'
			});

			// Click outside to close
			$(document).on("click", function (event) {
				if (!$(event.target).closest('#submenuContainer5, .dx-item-content').length) {
					$submenu.hide();
					$(document).off("click");
				}
			});
		}
