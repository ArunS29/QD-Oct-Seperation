		function animateCount(el, target) {
		  let i = 0;
		  el.innerText = i;
		  el.classList.remove('bounce');
		  const interval = setInterval(() => {
			if (i >= target) {
			  el.innerText = target;
			  el.classList.add('bounce');
			  clearInterval(interval);
			} else {
			  el.innerText = i++;
			}
		  }, 30);
		}

