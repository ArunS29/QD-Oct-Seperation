}

.custom-submenu li a {
  text-decoration: none;
  color: #333;
  font-size: 14px;
  display: block;
}

.custom-submenu li:hover {
  background-color: #f0f0f0;
  cursor: pointer;
}


	.overlay-content {
		position: absolute;
		top: 50%;
		left: 50%;
