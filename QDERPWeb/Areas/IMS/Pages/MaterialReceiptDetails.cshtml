<div class="dx-fieldset horizontal-container">
	@(Html.DevExtreme().DateBox()
		.ID("frmdateBox")
		.Label(new JS("formatMessage('Start Date')"))
		.LabelMode(EditorLabelMode.Outside)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) // First day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(2)
		)

	@(Html.DevExtreme().DateBox()
		.ID("todateBox")
		.Label(new JS("formatMessage('End Date')"))
		.LabelMode(EditorLabelMode.Outside)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(3)
		)


	@(Html.DevExtreme().DropDownButton()
		.ID("ddBtnShowRecords")
		.Text(new JS("formatMessage('Show Records')"))
		.Icon("smalliconslayout")
		.Width(180)
		.ElementAttr("class", "button-alignment-down")
		.TabIndex(4)
		.DropDownOptions(options => options.Width(230))
		.Items(items =>
		{
			items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
			items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
			items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
			items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
			items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
			items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
			items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
			items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
			items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
			items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
		})
		)

</div>
<div class="dx-field ledgerResult" >
	@(
		Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry60506materailReceiptDetail>()
				.ID("dataGrid")
				.RemoteOperations(false)
				.DataSource(new JS("[]"))
				.Columns(columns =>
				{
			// Grid Band: Bills Receivable
			columns.Add().Caption(new JS("formatMessage('Material Receipt Details')")).Columns(band =>
			{
				band.AddFor(m => m.ReceiptNo).Caption(new JS("formatMessage('Receipt No')")).Alignment(HorizontalAlignment.Left).Width(250);
				band.AddFor(m => m.ReceiptNo).Caption(new JS("formatMessage('Receipt No')")).Alignment(HorizontalAlignment.Left).Width(250).GroupIndex(0);
				band.AddFor(m => m.ReceiptDate).Caption(new JS("formatMessage('Receipt Date')")).Alignment(HorizontalAlignment.Left); 
				band.AddFor(m => m.SupplierName).Caption(new JS("formatMessage('Supplier Name')")).Alignment(HorizontalAlignment.Center);
				band.AddFor(m => m.Gscode).Caption(new JS("formatMessage('GS Code')")).Alignment(HorizontalAlignment.Center);
				band.AddFor(m => m.Gsdescrpition).Caption(new JS("formatMessage('GS Description')")).Alignment(HorizontalAlignment.Right);
				band.AddFor(m => m.QtyReceived).Caption(new JS("formatMessage('Qty Received')")).Alignment(HorizontalAlignment.Center);
				band.AddFor(m => m.UnitDesc).Caption(new JS("formatMessage('Unit Desc')")).Alignment(HorizontalAlignment.Center);
				band.AddFor(m => m.UnitPrice).Caption(new JS("formatMessage('Unit Price')")).Alignment(HorizontalAlignment.Center);
				band.AddFor(m => m.LineTotalWithTax).Caption(new JS("formatMessage('LineTotal With Tax')")).Alignment(HorizontalAlignment.Center);
	
				});
		

			})
		.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.DragAndDrop))
		.OnToolbarPreparing("onToolbarPreparing")
		.ColumnChooser(cc => cc.Enabled(true).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.DragAndDrop))
		.Height(680) // <<< fixed height
		.ColumnAutoWidth(true)
		.Width("99%")
		.WordWrapEnabled(true)
		//.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.Paging(p => p.Enabled(false))
		.Pager(pager => pager.Visible(false))
		.Grouping(grouping => grouping.AutoExpandAll(true))
		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.ShowRowLines(true)
		.OnContextMenuPreparing("onContextMenuPreparing")
		.Summary(summary =>
		{
			summary.GroupItems(items =>
			{
				items.Add().Column("Gscode")
			.SummaryType(SummaryType.Count)
			.ShowInGroupFooter(true)
			.DisplayFormat(new JS("formatMessage('No of Items: {0}')"));
				
			});
			summary.TotalItems(items =>
			{
			
			items.Add().Column("QtyReceived")
			.SummaryType(SummaryType.Sum)
			.CustomizeText(@"
	function(e) {
	if (e.value === null || e.value === undefined) {
	return '';
	}
	return e.value.toLocaleString(undefined, {
	minimumFractionDigits: 2,
	maximumFractionDigits: 2
	});
	}
	");
				items.Add().Column("LineTotalWithTax")
			.SummaryType(SummaryType.Sum)
			.CustomizeText(@"
	function(e) {
	if (e.value === null || e.value === undefined) {
	return '';
	}
	return e.value.toLocaleString(undefined, {
	minimumFractionDigits: 2,
	maximumFractionDigits: 2
	});
	}
	");
				
			});
		})
		)
</div>

