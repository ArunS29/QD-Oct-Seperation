    </div>
</div> *@
<input id="formId" value="frmIMSStockInventory" type="hidden" />
<div class="Footer">
    
    @await Html.PartialAsync("/Pages/Shared/IMS/StockInventoryFooter.cshtml")
</div>
<div class="context-menuInvoice" id="contextMenu">
    <div class="context-menu-itemInvoice" onclick="viewRecord()">
        <i class="dx-icon-search"></i> View Stock Item Details
    </div>
    <div class="context-menu-itemInvoice" onclick="editRecord()">
        <i class="dx-icon-edit"></i> Edit Stock Item
    </div>
    <div class="context-menu-itemInvoice" onclick="deleteRecord()">
        <i class="dx-icon-trash"></i> Delete Stock Item
    </div>
</div>

<div class="dx-fieldset horizontal-container">
    @(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
        .ID("stockGroupDropDownBox")
        .DataSource(d => d.WebApi()
        .Controller("StockInventory")
        .LoadAction("GetStockGroupNames")
        .LoadMode(DataSourceLoadMode.Raw)
        .Key("GsgroupId")
        )
        .ValueExpr("GsgroupId")
        .DisplayExpr("GsgroupName")
        .Label("Select Stock Group")
        .LabelMode(EditorLabelMode.Floating)
        .ShowClearButton(true)
        .Width(400)
        .ContentTemplate(new TemplateName("StockGroupDropDownContentTemplate"))
        )


    @(Html.DevExtreme().Button()
        .ID("btnFilterByStockGroup")
        .Text("Show Records")
        .Icon("search")
        .OnClick("onFilterStockGroup")
        .ElementAttr(new { style = "margin-left: 10px;" })
        )

    @(Html.DevExtreme().Button()
        .ID("btnClearStockGroupFilter")
        .Text("Show All Records")
        .Icon("clear")
       .OnClick("onClearStockGroupFilter")
        .ElementAttr(new { style = "margin-left: 10px;" })
        )
</div>

    <div class="dx-field ledgerResult" >
      @(Html.DevExtreme().DataGrid<Qry60001inventoryStockView>()
    .ID("dataGrid")
        .DataSource(new JS("[]")) // using global JS array
       .OnContentReady("onGridContentReady")
    .RemoteOperations(false)
    .Columns(columns =>
    {
            columns.AddFor(m => m.GsgroupName).Caption(new JS("formatMessage('Stock Group')")).Width(180).Visible(true);
        columns.AddFor(m => m.Gscode)
                .Caption(new JS("formatMessage('Stock Code')"))
            .Width(120);
        columns.AddFor(m => m.Gsdescrpition)
                .Caption(new JS("formatMessage('Description')"))
            .Width(280);
            columns.AddFor(m => m.GsgroupName).Caption(new JS("formatMessage('Stock Group')")).Width(180).Visible(true).GroupIndex(0);
        columns.AddFor(m => m.ItemPartNo)
                .Caption(new JS("formatMessage('Item Part No')"))
            .Width(150).CellTemplate(new JS(@"
        function(cellElement, cellInfo) {
        if (cellInfo.value != null && cellInfo.value !== '') {
        $('<span>')
        .text(cellInfo.value)
        .css({
        display: 'inline-block',
        backgroundColor: '#fff9cc', // Light yellow
        color: '#b58900',            // Amber text
        fontWeight: 'bold',
        padding: '4px 10px',
        borderRadius: '20px',
        minWidth: '24px',
        textAlign: 'center'
        })
        .appendTo(cellElement);
        }
        // else: do nothing (no span rendered)
        }
        "));    
 columns.AddFor(m => m.UnitType)
                .Caption(new JS("formatMessage('Unit')"))
            .Width(100);
        columns.AddFor(m => m.GssellingRate)
                .Caption(new JS("formatMessage('Selling Price')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120).CellTemplate(new JS(@"
        function(cellElement, cellInfo) {
        if (cellInfo.value != null) {
        const formattedValue = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        }).format(cellInfo.value);
        $('<span>')
        .text(formattedValue)
        .css({
        display: 'inline-block',
        backgroundColor: '#e6ffe6',
        color: '#1a8f1a',
        fontWeight: 'bold',
        padding: '4px 10px',
        borderRadius: '20px'
        })
        .appendTo(cellElement);
        }
        }
        "));
        columns.AddFor(m => m.CostPrice)
                .Caption(new JS("formatMessage('Cost Price')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120).CustomizeText(@"
        function(e) {
        if (e.value === null || e.value === undefined) {
        return ''; // Return empty string for null/undefined
        }
        return Number(e.value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });
        }
        "); 
        columns.AddFor(m => m.OpeningBalance)
                .Caption(new JS("formatMessage('Opening Balance')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120).CellTemplate(new JS(@"
        function(cellElement, cellInfo) {
        if (cellInfo.value != null) {
        const formattedValue = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        }).format(cellInfo.value);
        $('<span>')
        .text(formattedValue)
        .css({
        display: 'inline-block',
        backgroundColor: '#ffe6e6',
        color: '#d93025',
        fontWeight: 'bold',
        padding: '4px 10px',
        borderRadius: '20px'
        })
        .appendTo(cellElement);
        }
        }
        "));
        columns.AddFor(m => m.TotalReceived)
                .Caption(new JS("formatMessage('Received')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120).CellTemplate(new JS(@"
        function(cellElement, cellInfo) {
        if (cellInfo.value != null) {
        const formattedValue = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        }).format(cellInfo.value);
        $('<span>')
        .text(formattedValue)
        .css({
        display: 'inline-block',
        backgroundColor: '#ffe6e6',
        color: '#d93025',
        fontWeight: 'bold',
        padding: '4px 10px',
        borderRadius: '20px'
        })
        .appendTo(cellElement);
        }
        }
        "));
        columns.AddFor(m => m.TotalIssues)
                .Caption(new JS("formatMessage('Issues')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120).CellTemplate(new JS(@"
        function(cellElement, cellInfo) {
        if (cellInfo.value != null) {
        const formattedValue = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        }).format(cellInfo.value);
        $('<span>')
        .text(formattedValue)
        .css({
        display: 'inline-block',
        backgroundColor: '#e6ffe6',
        color: '#1a8f1a',
        fontWeight: 'bold',
        padding: '4px 10px',
        borderRadius: '20px'
        })
        .appendTo(cellElement);
        }
        }
        "));
        columns.AddFor(m => m.ClosingBalance)
                .Caption(new JS("formatMessage('Closing Balance')"))
            .Format("fixedPoint")
            .Alignment(HorizontalAlignment.Right)
            .Width(120).CellTemplate(new JS(@"
        function(cellElement, cellInfo) {
        if (cellInfo.value === null || cellInfo.value === undefined) {
        cellElement.text('');
        return;
        }

        const formatted = Number(cellInfo.value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        });

        cellElement
        .text(formatted)
        .css({
        backgroundColor: '#e6ffe6',
        display: 'inline-block',
        fontWeight: 'bold',
        margin: '10px 35px',
        padding: '4px 10px',
