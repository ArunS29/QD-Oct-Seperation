<style>
    .custom-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-end;
        margin-bottom: 25px;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .toolbar-item {
        min-width: 260px;
        flex: 1;
    }

    .dx-field-label,
    .dx-texteditor-label {
        font-weight: 600 !important;
        font-size: 14px;
        color: #34495e;
        margin-bottom: 5px;
    }

    .dx-texteditor,
    .dx-dropdownbutton {
        border-radius: 8px !important;
    }


    .dx-button {
        font-weight: 500;
        border-radius: 8px !important;
        transition: background-color 0.3s ease;
    }
    .button-alignment-down {
        margin-top: 8px;
    }

    .limited-footer {
        margin-top: 20px;
        padding: 15px;
        background-color: #ffffff;
        border-top: 1px solid #e0e0e0;
        border-radius: 0 0 12px 12px;
    }

    .context-menuInvoice {
        position: absolute;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        width: 210px;
        display: none;
        flex-direction: column;
        padding: 5px 0;
        z-index: 1000;
    }

    .context-menu-itemInvoice {
        display: flex;
        align-items: center;
        padding: 10px 15px;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s ease-in-out;
        color: #333;
    }

        .context-menu-itemInvoice i {
            margin-right: 10px;
            font-size: 16px;
            color: #007bff;
        }

        .context-menu-itemInvoice:hover {
            background: #f0f0f0;
        }

        .context-menu-itemInvoice:not(:last-child) {
            border-bottom: 1px solid #e0e0e0;
        }

    /* Responsive Tweaks */
    @@media screen and (max-width: 768px) {
        .toolbar-item {
            min-width: 100%;
        }

        h2 {
            font-size: 22px;
        }

        #dataGrid {
            padding: 10px;
        }
    }
</style>
<div class="title">

    <div class="card blue shine compact">
        <h2 class="title-slide">Stock Inventory</h2>
        <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.3); margin: 6px 0;">
        <h6 class="fade-in">QuickDice ERP Solutions</h6>

    </div>

    <div id="mainCard" class="card today-bg">
        <div class="tabs">
            <div class="tab-text active" onclick="switchTab(0)">Today</div>
            <div class="tab-text" onclick="switchTab(1)">Week</div>
            <div class="tab-text" onclick="switchTab(2)">Month</div>
        </div>

        <div class="tab-content active">
            <h4>&#128276; Pending Verifications</h4>
            <div class="count" id="count0">0</div>
            @* <div class="trend">🔺 12% more than yesterday</div> *@
            @* <div class="message">You're getting things moving!</div> *@
        </div>

        <div class="tab-content">
            <h4>&#9989; Vouchers Verified</h4>
            <div class="count" id="count1">0</div>
            @* <div class="trend">🔼 25% higher than last week</div> *@
            @* <div class="message">Awesome pace — keep it up!</div> *@
        </div>

        <div class="tab-content">
            <h4>&#128229; New Vouchers</h4>
            <div class="count" id="count2">0</div>
            @* <div class="trend">🔽 10% drop this month</div> *@
            @* <div class="message">Fewer vouchers — time to catch up?</div> *@
        </div>
    </div>

    <div class="card purple sparkle">
        <p>&#10024;</p>
        <h4>No of Items</h4>
        <h1 id="turnover">0</h1>
        <h3>for this period</h3>
    </div>
</div>
