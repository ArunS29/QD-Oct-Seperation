@using DevExtreme.AspNet.Mvc
@using QD.ERP.Web.DAL.Entities;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="~/js/global/print.js"></script>
<link rel="stylesheet" href="~/css/animationCard.css" />


<style>
    .custom-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-end;
        margin-bottom: 25px;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .toolbar-item {
        min-width: 260px;
        flex: 1;
    }

    .dx-field-label,
    .dx-texteditor-label {
        font-weight: 600 !important;
        font-size: 14px;
        color: #34495e;
    }

    .dx-texteditor,
    .dx-dropdownbutton {
        border-radius: 8px !important;
    }


    .dx-button {
        font-weight: 500;
        border-radius: 8px !important;
        transition: background-color 0.3s ease;
    }
    .button-alignment-down {
        margin-top: 8px;
    }

    .context-menuInvoice {
        position: absolute;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        width: 210px;
        display: none;
        flex-direction: column;
        padding: 5px 0;
        z-index: 1000;
    }

    .context-menu-itemInvoice {
        display: flex;
        align-items: center;
        padding: 10px 15px;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s ease-in-out;
        color: #333;
    }

        .context-menu-itemInvoice i {
            margin-right: 10px;
            font-size: 16px;
            color: #007bff;
        }

        .context-menu-itemInvoice:hover {
            background: #f0f0f0;
        }

        .context-menu-itemInvoice:not(:last-child) {
            border-bottom: 1px solid #e0e0e0;
        }

    /* Responsive Tweaks */
    @@media screen and (max-width: 768px) {
        .toolbar-item {
            min-width: 100%;
        }

        h2 {
            font-size: 22px;
        }
    }

    .voucher-slider {
        position: relative;
        height: 120px;
        overflow: hidden;
    }

    .voucher-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        opacity: 0;
        transform: translateY(100%);
        transition: opacity 0.6s ease, transform 0.6s ease;
        text-align: center;
    }


        .voucher-slide.active {
            opacity: 1;
            transform: translateY(0);
            z-index: 2;
        }

        .voucher-slide.slide-up {
            transform: translateY(-100%);
        }
    .voucher-slide1 {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        opacity: 0;
        transform: translateY(100%);
        transition: opacity 0.6s ease, transform 0.6s ease;
        text-align: center;
    }


        .voucher-slide1.active {
            opacity: 1;
            transform: translateY(0);
            z-index: 2;
        }

        .voucher-slide1.slide-up {
            transform: translateY(-100%);
        }



      
</style>
<div class="title">

    <div class="card blue shine compact">
        <h2 class="title-slide">Stock Inventory</h2>
        <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.3); margin: 6px 0;">
        <h6 class="fade-in">QuickDice ERP Solutions</h6>

    </div>

    <div class="card today-bg">
      
            <h3 style="margin-bottom: 10px; color: white;font-weight:bold;">Balance</h3>
            <div class="voucher-slider">
            <div class="voucher-slide active">
                <h3 style="color: white; margin: 0;">Opening Balance</h3>
                <h4 style="color: white; margin: 0; display: flex; align-items: center; gap: 5px;">
                   
                    <span id="openingbalanceCount">0</span>
                </h4>
            </div>


                <div class="voucher-slide">
                <h3 style="color: white; margin: 0;">Closing Balance</h3>
                <h4 style="color: white; margin: 0; display: flex; align-items: center; gap: 5px;">
                    
                    <span id="closingbalanceCount">0</span>
                        </h4>
                </div>
            </div>
        </div>
    <div class="card green shine">
            <h3 style="margin-bottom: 10px; color: white;font-weight:bold;">Aount</h3>
            <div class="voucher-slider">
            <div class="voucher-slide1 active">
                <h3 style="color: white; margin: 0;">No of Received Amount</h3>
                <h4 style="color: white; margin: 0; display: flex; align-items: center; gap: 5px;">
                    <span id="receivedamount">0</span>
                </h4>
            </div>


                <div class="voucher-slide1">
                <h3 style="color: white; margin: 0;">Issuse</h3>
                <h4 style="color: white; margin: 0; display: flex; align-items: center; gap: 5px;">
                    <span id="issuseCount">0</span>
                        </h4>
                </div>
            </div>
        </div>
    

    
</div>
