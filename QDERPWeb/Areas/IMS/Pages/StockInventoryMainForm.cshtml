      });

      // Change background class
      card.className = "card";
      if (index === 0) card.classList.add("today-bg");
      if (index === 1) card.classList.add("week-bg");
      if (index === 2) card.classList.add("month-bg");

      // Animate count
      animateCount(countEls[index], counts[index]);
    }

    // Auto-start animation for "Today"
    animateCount(countEls[0], counts[0]);

      function onFilterStockGroup() {
        const groupValue = $("#stockGroupDropDownBox").dxDropDownBox("instance").option("value");

        if (!groupValue) {
            DevExpress.ui.notify("Please select a Stock Group", "warning", 2000);
            return;
        }

        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        dataGrid.option("dataSource", DevExpress.data.AspNet.createStore({
            key: "Gscode",
            loadUrl: '/api/StockInventory/GetInventory',
            loadParams: { gsgroupId: groupValue } // ✅ Preferred approach
        }));
    }


    function onClearStockGroupFilter() {
        $("#stockGroupDropDownBox").dxDropDownBox("instance").option("value", null);

        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        dataGrid.option("dataSource", DevExpress.data.AspNet.createStore({
            key: "Gscode",
            loadUrl: "/api/StockInventory/GetInventory"
        }));
    }
