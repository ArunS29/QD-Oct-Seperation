    .card {
        flex: 1;
        padding: 15px;
        border-radius: 12px;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        height: 110px;
    }

        .card h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

        .card p {
            margin: 4px 0;
            font-size: 14px;
        }

        .card .amount {
            font-size: 26px;
            margin: 5px 0;
            font-weight: bold;
        }

        .card .percent {
            font-size: 14px;
            display: flex;
            align-items: center;
        }


    .tabs {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .tab-text {
        flex: 1;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        padding: 2px 0;
        border-radius: 6px;
        transition: background 0.3s ease;
    }

        .tab-text.active {
            background: rgba(255, 255, 255, 0.9);
            color: #333;
        }

    .tab-content {
        display: none;
        text-align: center;
        animation: fadeSlideIn 0.4s ease;
    }

        .tab-content.active {
            display: block;
        }

    h4 {
        margin-bottom: 4px;
        font-size: 16px;
    }

    .count {
        font-size: 28px;
        font-weight: bold;
        margin: 4px 0;
    }

        .count.bounce {
            animation: bounceIn 0.4s ease;
        }

    .trend {
        font-size: 14px;
        margin-bottom: 8px;
    }

    .message {
        font-size: 14px;
        font-weight: 500;
        margin-top: 6px;
    }

    /* Backgrounds per tab */
    .today-bg {
        background: linear-gradient(270deg, #fb8c00, #ffe0b2); /* deep orange to light peach-orange */
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }


    .week-bg {
        background: linear-gradient(270deg, #009688, #4db6ac);
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }

    .month-bg {
        background: linear-gradient(270deg, #ad1457, #f8bbd0); /* dark pink to light pink */
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }


    /* Keyframes */
    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes bounceIn {
        0% {
            transform: scale(0.9);
            opacity: 0;
        }

        50% {
            transform: scale(1.05);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes gradientPulse {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

