<script>

    let dataGrid;

          function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }

        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }
            function dataGridSelectionChanged(e) {
            const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
            const ddbInstance = $("#stockGroupDropDownBox").dxDropDownBox("instance");

            if (selectedKey) {
                ddbInstance.option("value", selectedKey);
                if (ddbInstance.option("opened")) {
                    ddbInstance.close();
                }
            }
        }
        function dataGridInitialized(e) {
            dataGrid = e.component;
        }




    let selectedRowData = null;

    $(function () {
        const contextMenu = $("#contextMenu");

        $(document).on("click", function () {
            contextMenu.hide();
        });

       $("#dataGrid").customizeGridContextMenu();
          $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault();
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowIndex = $(this).index();
        selectedRowData = dataGrid.getVisibleRows()[rowIndex].data;

        $("#contextMenu").css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
    });

    });
    function viewRecord() {
        if (selectedRowData) {
            const code = selectedRowData.Gscode;
            window.location.href = `/${tenantName}/IMS/InventoryStockDetails?code=${encodeURIComponent(code)}&mode=view`;
        }
    }

    function editRecord() {
        if (selectedRowData) {
            const code = selectedRowData.Gscode;
            window.location.href = `/${tenantName}/IMS/InventoryStockDetails?code=${encodeURIComponent(code)}&mode=edit`;
        }
    }


          function deleteRecord() {
        if (!selectedRowData) {
            DevExpress.ui.notify("Please select a row to delete.", "warning", 2000);
            return;
        }

        const code = selectedRowData.Gscode;

        DevExpress.ui.dialog.confirm(
            `Are you sure you want to delete stock item: <b>${code}</b>?`,
            "Confirm Deletion"
        ).done(function (dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: "/api/StockInventory/DeleteStockItem",
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(code),
                    success: function (result) {
                        const messageType = result.success ? "Success" : "Error";
                        const messageColor = result.success ? "green" : "red";

                        DevExpress.ui.dialog.alert(
                            `<div style="color: ${messageColor}; font-weight: bold;">
                                ${result.message}
                            </div>`,
                            messageType
                        );

                        if (result.success) {
                            const grid = $("#dataGrid").dxDataGrid("instance");
                            grid.refresh();
                        }
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("Error deleting stock item", "error", 2000);
                        console.error(xhr);
                    }
                });
            }
        });
    }
    $(function () {
        $("#StockInventoryMainForm").dxTextBox({
            text: formatMessage("Stock Inventory"),
                readOnly: true,
                onContentReady: function (e) {
                    $(e.element).addClass("dx-textbox-heading");
                }
            });
        });

    function printFun() {
        exportDataGridToPDF('dataGrid');
    }

    $(document).ready(function () {
            console.log('Start permission handling AccountingLedgers');
            // Form ID
            var formId = "frmIMSStockInventory";

            // Call the API to get permissions
            $.ajax({
                url: '/api/Permissions/GetAccessDetails?formId=' + formId,
                type: 'GET',
                contentType: 'application/json',
                success: function (response) {
                    console.log("API Response:", response); // Log the API response

                    if (response.success && response.permissions) {
                        // Default visibility and enable status for buttons
                        var controlStates = {
                            "btnRefresh": { "Visible": false, "Enabled": false },
                            "ddButtonLayout": { "Visible": false, "Enabled": false },
                            "rowHeightProperties": { "Visible": false, "Enabled": false },
                            "btnPrint": { "Visible": false, "Enabled": false },
                            "btnToggleSearch": { "Visible": false, "Enabled": false },
                            "btntoggleGroupPanel": { "Visible": false, "Enabled": false },
                            "ddButtonShow": { "Visible": false, "Enabled": false },
                            "ddReports": { "Visible": false, "Enabled": false },
                            "btnAddNewPayment": { "Visible": false, "Enabled": false },
                            "btnColumnChooser": { "Visible": false, "Enabled": false },
                        };

                        // Check for full access
                        var fullAccess = response.permissions.find(p =>
                            p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
                        );

                        if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
                            // Grant full access: make all controls visible and enabled
                            Object.keys(controlStates).forEach(key => {
                                controlStates[key] = { "Visible": true, "Enabled": true };
                            });
                        } else {
                            // Update states based on specific permissions for each control
                            Object.keys(controlStates).forEach(key => {
                                var controlPermission = response.permissions.find(p =>
                                    p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
                                );
                                if (controlPermission) {
                                    controlStates[key] = {
                                        "Visible": controlPermission.ItemVisible || false,
                                        "Enabled": controlPermission.ItemEnabled || false
                                    };
                                }
                            });
                        }

                        console.log("Control States:", controlStates);
                        Object.keys(controlStates).forEach(key => {
                            var button = document.getElementById(key);
                            if (button) {
                                // Handle visibility
                                button.style.display = controlStates[key].Visible ? "inline-block" : "none";
                                // Handle enable/disable state
                                button.disabled = !controlStates[key].Enabled;
                                console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
                            } else {
                                console.warn(`Button with ID "${key}" not found in the DOM.`);
                            }
                        });
                    } else {
                        console.warn("Failed to fetch permissions or no permissions available.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching permissions:", error);
                    alert('An error occurred while fetching permissions. Please try again.');
                }
            });

            console.log('End permission handling');
        });
        function countUpTurnover(targetStr) {
      const el = document.getElementById("turnover");
      const target = parseFloat(targetStr);
      let current = 0.0;

      const interval = setInterval(() => {
        current += 0.5;
        if (current >= target) {
          el.textContent = targetStr + " K";
          clearInterval(interval);
        } else {
          el.textContent = current.toFixed(1) + " K";
        }
      }, 30);
    }

    // Animate to 46.2 K
    countUpTurnover("46.2");

      const card = document.getElementById('mainCard');
    const counts = [8, 15, 5];
    const countEls = [
      document.getElementById("count0"),
      document.getElementById("count1"),
      document.getElementById("count2"),
    ];
    const tabs = document.querySelectorAll(".tab-text");
    const contents = document.querySelectorAll(".tab-content");

    function animateCount(el, target) {
      let i = 0;
      el.innerText = i;
      el.classList.remove('bounce');
      const interval = setInterval(() => {
        if (i >= target) {
          el.innerText = target;
          el.classList.add('bounce');
          clearInterval(interval);
        } else {
          el.innerText = i++;
        }
      }, 30);
    }

    function switchTab(index) {
      tabs.forEach((tab, i) => {
        tab.classList.toggle('active', i === index);
        contents[i].classList.toggle('active', i === index);
      });

      // Change background class
      card.className = "card";
      if (index === 0) card.classList.add("today-bg");
      if (index === 1) card.classList.add("week-bg");
      if (index === 2) card.classList.add("month-bg");

      // Animate count
      animateCount(countEls[index], counts[index]);
    }

    // Start "Today" count immediately
    animateCount(countEls[0], counts[0]);

    function switchTab(index) {
      tabs.forEach((tab, i) => {
        tab.classList.toggle('active', i === index);
