<script>
         function setupAutoSlider(className, interval = 2000) {
        let currentIndex = 0;
        setInterval(() => {
            const slides = document.querySelectorAll(`.${className}`);
            if (slides.length === 0) return;

            slides.forEach(slide => slide.classList.remove('active'));
            currentIndex = (currentIndex + 1) % slides.length;
            slides[currentIndex].classList.add('active');
        }, interval);
    }

    // ✅ Initialize both sliders
    setupAutoSlider('voucher-slide');
    setupAutoSlider('voucher-slide1');

  
     function onGridContentReady(e) {
         updateSummaryCounts(e);
     }

    
        function updateSummaryCounts(e) {
        const svgIcon = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="16" height="16" fill="white" style="vertical-align: middle;">
                <path d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z" />
                <path d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z" />
            </svg>
        `;

        function setValueWithIcon(id, value) {
            const formatted = Number(value).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            document.getElementById(id).innerHTML = `${svgIcon} <span style="margin-left: 5px;">${formatted}</span>`;
        }

        setValueWithIcon("openingbalanceCount", e.component.getTotalSummaryValue("OpeningBalance") || 0);
        setValueWithIcon("closingbalanceCount", e.component.getTotalSummaryValue("ClosingBalance") || 0);
        setValueWithIcon("receivedamount", e.component.getTotalSummaryValue("TotalReceived") || 0);
        setValueWithIcon("issuseCount", e.component.getTotalSummaryValue("TotalIssues") || 0);
    }


    let dataGrid;

          function onOpened(e) {
            setTimeout(() => {
                e.component.focus();
            });
        }

        function onKeyDown(e) {
            const ddbInstance = e.component;
            if (e.event.keyCode !== 40) return;
            if (!ddbInstance.option("opened")) {
                ddbInstance.open();
            } else {
                let focusedIndex = dataGrid.option("focusedRowIndex");
                let visibleRows = dataGrid.getVisibleRows().length - 1;
                if (focusedIndex === -1 || visibleRows < focusedIndex) focusedIndex = 0;
                dataGrid.focus(dataGrid.getRowElement(focusedIndex));
            }
        }

        function dropDownBoxOnInput(e) {
            const ddbInstance = e.component;
            if (!ddbInstance.option("opened")) ddbInstance.open();


            const text = ddbInstance.option("text");
            if (dataGrid) {
                dataGrid.option("searchPanel.text", text);
            }
        }
            function dataGridSelectionChanged(e) {
            const selectedKey = e.selectedRowKeys[0]; // Get the first selected key, if any
            const ddbInstance = $("#stockGroupDropDownBox").dxDropDownBox("instance");

            if (selectedKey) {
                ddbInstance.option("value", selectedKey);
                if (ddbInstance.option("opened")) {
                    ddbInstance.close();
                }
            }
        }
        function dataGridInitialized(e) {
            dataGrid = e.component;
        }

            function dataGridRowClicked(e) {
        const selectedKey = e.key;
        const ddbInstance = $("#stockGroupDropDownBox").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            ddbInstance.close();
        }
    }




    let selectedRowData = null;

    $(function () {
        const contextMenu = $("#contextMenu");

        $(document).on("click", function () {
            contextMenu.hide();
        });

       $("#dataGrid").customizeGridContextMenu();
          $("#dataGrid").on("contextmenu", ".dx-data-row", function (e) {
        e.preventDefault();
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowIndex = $(this).index();
        selectedRowData = dataGrid.getVisibleRows()[rowIndex].data;

        $("#contextMenu").css({ top: e.pageY + "px", left: e.pageX + "px" }).show();
    });

    });
    function viewRecord() {
        if (selectedRowData) {
            const code = selectedRowData.Gscode;
            window.location.href = `/${tenantName}/IMS/InventoryStockDetails?code=${encodeURIComponent(code)}&mode=view`;
        }
    }

    function editRecord() {
        if (selectedRowData) {
            const code = selectedRowData.Gscode;
            window.location.href = `/${tenantName}/IMS/InventoryStockDetails?code=${encodeURIComponent(code)}&mode=edit`;
        }
    }


          function deleteRecord() {
        if (!selectedRowData) {
            DevExpress.ui.notify("Please select a row to delete.", "warning", 2000);
            return;
        }

        const code = selectedRowData.Gscode;

        DevExpress.ui.dialog.confirm(
            `Are you sure you want to delete stock item: <b>${code}</b>?`,
            "Confirm Deletion"
        ).done(function (dialogResult) {
            if (dialogResult) {
                $.ajax({
                    url: "/api/StockInventory/DeleteStockItem",
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(code),
                    success: function (result) {
                        const messageType = result.success ? "Success" : "Error";
                        const messageColor = result.success ? "green" : "red";

                        DevExpress.ui.dialog.alert(
                            `<div style="color: ${messageColor}; font-weight: bold;">
                                ${result.message}
                            </div>`,
                            messageType
                        );

                        if (result.success) {
                            const grid = $("#dataGrid").dxDataGrid("instance");
                            grid.refresh();
                        }
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("Error deleting stock item", "error", 2000);
                        console.error(xhr);
                    }
                });
            }
        });
    }
