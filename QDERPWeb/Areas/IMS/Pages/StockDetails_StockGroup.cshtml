@page
@using QD.ERP.Web.DAL.Entities;
@using System.ComponentModel.DataAnnotations;
@using DevExtreme.AspNet.Mvc

@model QD.ERP.Web.Areas.IMS.Pages.StockDetails_StockGroupModel
@{
}



<style>
    .form-table {
        width: 100%;
        margin:30px;

        border-spacing: 10px;
        font-family: Segoe UI, sans-serif;
    }

        .form-table th {
            text-align: left;
            font-weight: bold;
            padding-top: 10px;
        }

        .form-table td {
            vertical-align: top;
            width: 100%;
        }

    .highlight-red {
        color: red;
        font-weight: bold;
    }

    .muted-text {
        color: gray;
        font-size: 12px;
        padding-top: 10px;
    }

    .flex-row {
        display: flex;
        align-items: center;
    }

    .mainContainer {
        width: 100%;
    }


    .maindiv {
        display: flex;
    }

    .audit-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .audit-label {
        width: 90px;
        text-align: right;
        font-style: italic;
        font-size: 12px;
    }

    .audit-field {
        flex: 1;
        width: 40vh;
    }

    .audit-box {
        padding: 8px;
        font-size: 12px;
    }

    .audit-left,
    .audit-right {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .audit {
        gap: 50px;
        display: flex;
    }

    .avg-cost-container {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-left: 50px
    }


    .item-discontinued-label {
        font-weight: bold;
        margin: 10px;
        padding: 10px 10px 10px 0px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }
    </style>

<div class="title">
    <div class="header-container">
        <div id="Stockgroup" class="no-border-title"></div>
    </div>
</div>
<div class="maindiv">
    <table class="form-table">
       
        <tr>
            <td>
                @(Html.DevExtreme().TextArea()
                    .ID("NewStockServicesGroups")
                    .Label(new JS("formatMessage('Type a New Stock or Services Group & Add to the Eisting List:')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message(new JS("formatMessage('It should be entered')"));
                    }))

            </td>

        </tr>

        <tr>
            <td style="display: flex;">
                @(Html.DevExtreme().TextArea()
                    .ID("StockServicesGroups")
                    .Label(new JS("formatMessage('Stock / Service Group (In Arabic):')"))
                    .Width("100%")
                    .LabelMode(EditorLabelMode.Floating)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message(new JS("formatMessage('It should be entered')"));
                    })
                    )
                @(Html.DevExtreme().Button()
                    .ID("convertToArabic1")
                    .Width(50)
                    .Icon("fas fa-language")
                    .ElementAttr("style", "margin-top: 25px;")
                    .OnClick("convertToArabic")

                    )
            </td>
        </tr>

        
        <tr class="flex-row" style="width:100%;">

            <td>
                @(Html.DevExtreme().TextBox()
                    .ID("GroupCode")
                    .LabelMode(EditorLabelMode.Floating)
                    .Label(new JS("formatMessage('Group Code *')"))
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message(new JS("formatMessage('Group Code should be entered')"));
                    })
                    )
            </td>
            <td>
                @(Html.DevExtreme().TextBox()
                    .ID("Category")
                    .LabelMode(EditorLabelMode.Floating)
                    .Label(new JS("formatMessage('Category')"))
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message(new JS("formatMessage('It should be entered')"));
                    })
                    )
            </td>
            <td>
                @(Html.DevExtreme().SelectBox()
                    .ID("InventoryMasterGroups")
                    .DataSource(ds => ds.WebApi()
                    .Controller("StockInventory")
                    .LoadAction("GetInventoryMasterGroups")
                    )
                    .ValueExpr("InventoryMasterGroupId")
                    .DisplayExpr("InventoryMasterGroup") // selected item shows only the name
                    
                    .LabelMode(EditorLabelMode.Floating)
                    .Label(new JS("formatMessage('Inventory Master Groups')"))

                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message(new JS("formatMessage('Master Groups  should be entered')"));
                    })
                    )
            </td>





        </tr>
        <tr class="flex-row" style="width:100%;">
            <td>
                @(Html.DevExtreme().SelectBox()
                    .ID("InventoryLedgerAccount")
                    .LabelMode(EditorLabelMode.Floating)
                    .Label(new JS("formatMessage('Inventory Ledger Account')"))
                    .DataSource(d => d.Mvc()
                    .Controller("StockInventory")
                    .LoadAction("GetInventoryLedgerAccounts")
                    )
                    .DisplayExpr("DisplayText") 
                    .ValueExpr("AccountId")   
                    .Width(370)
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message(new JS("formatMessage('It should be entered')"));
                    })
                    )
            </td>


            <td>
                @(Html.DevExtreme().SelectBox()
                    .ID("CostLedgerAccount")
                    .LabelMode(EditorLabelMode.Floating)
                    .Label(new JS("formatMessage('Cost Ledger Account')"))
                    .DataSource(d => d.Mvc()
                    .Controller("StockInventory") // Replace with your actual controller name
                    .LoadAction("GetCostLedgerAccounts")
                    )
                    .DisplayExpr("DisplayText") // Shows "AccountHead | AccountGroup"
                    .ValueExpr("AccountId")     // Submits AccountId
                    .ValidationRules(rules =>
                    {
                        rules.AddRequired()
                        .Message(new JS("formatMessage('It should be entered')"));
                    })
                    )
            </td>

            <td style="padding: 10px; margin-top: 20px;">
                <div  style="display: flex; width:400px;">
                   

                    @(Html.DevExtreme().CheckBox()
                        .ID("ServicesGroup")
                        .Value(false))
                    <label id="ChoosetheGroupisServicesGroup" class="item-discontinued-label">Choose the Group is Services Group ?</label>
                </div>

            </td>

            <td>
                @(Html.DevExtreme().Button()
                    .ID("btnAdd")
                    .Icon("plus")
                    .Text(new JS("formatMessage('Add')"))
                    .Width(60)
                    .ElementAttr("style", "margin-top:23px")
                    )
            </td>
            

        </tr>


    </table>


    

</div>



<div class="dx-field ledgerResult" style="margin-bottom: 100px">
    <table style="width:100%; margin-top: 15px;">
        <tr>
            <td>
                @(Html.DevExtreme().DataGrid<Tbl20165GoodsAndServicesGroup>()
                    .ID("dataGrid")
                    .DataSource(ds => ds.Mvc()
                    .Controller("StockInventory")
                    .LoadAction("GoodsServicesData")
                    .UpdateAction("UpdateGoodsService")
                    .Key("GsgroupId")
                    )
                    .RemoteOperations(false)
                    .Height(400)
                    .Editing(editing =>
                    {
                        editing.Mode(GridEditMode.Row);
                        editing.AllowUpdating(true);
                        editing.UseIcons(true);
                    })
                    .Columns(columns =>
                    {
                        columns.AddFor(m => m.GsgroupId)
                        .Caption(new JS("formatMessage('Code')"))
                        .Visible(false)
                        .Alignment(HorizontalAlignment.Center)
                        .AllowEditing(false); // Optional
                        columns.AddFor(m => m.GsgroupCode)
                        .Caption(new JS("formatMessage('Code')"))
                        .Alignment(HorizontalAlignment.Center)
                        .AllowEditing(false); // Optional

                        columns.AddFor(m => m.GsgroupName)
                        .Caption(new JS("formatMessage('GS Group')"))
                        .Alignment(HorizontalAlignment.Center);

                        columns.AddFor(m => m.GsgroupNameAr)
                        .Caption(new JS("formatMessage('GS Group (In Arabic)')"))
                        .Alignment(HorizontalAlignment.Center);

                        columns.AddFor(m => m.Gscategory)
                        .Caption(new JS("formatMessage('Category')"))
                        .Alignment(HorizontalAlignment.Center);

                        columns.AddFor(m => m.InventoryMasterGroupId)
                        .Caption(new JS("formatMessage('Inventory Master Groups')"))
                        .Alignment(HorizontalAlignment.Center);

                        columns.AddFor(m => m.IsServicesGroup)
                        .Caption(new JS("formatMessage('Is Services?')"))
                        .Alignment(HorizontalAlignment.Center)
                        .DataType(GridColumnDataType.Boolean)
                        .CellTemplate(new JS(
                    @"function(container, options) {
                var data = options.data;
                $('<input>', {
                type: 'checkbox',
                checked: data.IsServicesGroup,
                change: function(e) {
                onIsServicesChanged(data.GsgroupId, e.target.checked);
                }
                }).appendTo(container);
                }"));
                    })
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .RowAlternationEnabled(true)
                    .ShowColumnHeaders(true)
                    .ColumnAutoWidth(true)
                    .AllowColumnReordering(true)
                    .AllowColumnResizing(true)
                    .ColumnFixing(fixing => fixing.Enabled(true))
                    .GroupPanel(groupPanel => groupPanel.Visible(false))
                    .ShowBorders(true)
                    )

            </td>
        </tr>
    </table>
</div>


<script>
    function printReport() {
        alert("Print report clicked");
    }

    function viewStockMovement() {
        alert("View stock movement clicked");
    }
    $(function () {
        $("#ChoosetheGroupisServicesGroup").text(
             formatMessage("Choose the Group is Services Group ?"));
    });

    function onIsServicesChanged(gsgroupId, isChecked) {
        alert(isChecked)
        $.ajax({
            url: '/api/StockInventory/UpdateIsServices',
            method: 'POST',
            data: JSON.stringify({ GsgroupId: gsgroupId, IsServicesGroup: isChecked }),
            contentType: 'application/json',
            success: function () {
                DevExpress.ui.notify('Updated successfully', 'success', 2000);
                // optionally refresh grid here
                $('#dataGrid').dxDataGrid('instance').refresh();
            },
            error: function () {
                DevExpress.ui.notify('Update failed', 'error', 2000);
            }
        });
    }
    $(function () {
        $("#btnAdd").dxButton("instance").option("onClick", function () {
            // Get validator instances for each field
            var groupCodeValidator = $("#GroupCode").dxValidator("instance");
            var categoryValidator = $("#Category").dxValidator("instance");
            var inventoryGroupValidator = $("#InventoryMasterGroups").dxValidator("instance");
            var inventoryLedgerValidator = $("#InventoryLedgerAccount").dxValidator("instance");
            var costLedgerValidator = $("#CostLedgerAccount").dxValidator("instance");
            var gsgroupNameValidator = $("#NewStockServicesGroups").dxValidator("instance");
            var gsgroupNameArValidator = $("#StockServicesGroups").dxValidator("instance");

            // Validate all fields
            var groupCodeValid = groupCodeValidator.validate().isValid;
            var categoryValid = categoryValidator.validate().isValid;
            var inventoryGroupValid = inventoryGroupValidator.validate().isValid;
            var inventoryLedgerValid = inventoryLedgerValidator.validate().isValid;
            var costLedgerValid = costLedgerValidator.validate().isValid;
            var gsgroupNameValid = gsgroupNameValidator.validate().isValid;
            var gsgroupNameArValid = gsgroupNameArValidator.validate().isValid;

            // Check if all fields are valid
            if (
                groupCodeValid &&
                categoryValid &&
                inventoryGroupValid &&
                inventoryLedgerValid &&
                costLedgerValid &&
                gsgroupNameValid &&
                gsgroupNameArValid
            ) {
                // If all valid, collect values and send ajax
                const groupCode = $("#GroupCode").dxTextBox("instance").option("value");
                const category = $("#Category").dxTextBox("instance").option("value");
                const inventoryGroupId = $("#InventoryMasterGroups").dxSelectBox("instance").option("value");
                const inventoryLedger = $("#InventoryLedgerAccount").dxSelectBox("instance").option("value");
                const costLedger = $("#CostLedgerAccount").dxSelectBox("instance").option("value");
                const isServiceGroup = $("#ServicesGroup").dxCheckBox("instance").option("value");
                const gsgroupName = $("#NewStockServicesGroups").dxTextArea("instance").option("value");
                const gsgroupNameAr = $("#StockServicesGroups").dxTextArea("instance").option("value");

                const data = {
                    GsgroupCode: groupCode,
                    Gscategory: category,
                    InventoryMasterGroupId: inventoryGroupId,
                    GsgroupInventoryLedger: inventoryLedger,
                    GsgroupExpenseLedger: costLedger,
                    IsServicesGroup: isServiceGroup,
                    GsgroupName: gsgroupName,
                    GsgroupNameAr: gsgroupNameAr
                };

                $.ajax({
                    url: '/api/StockInventory/AddGoodsServiceGroup',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function () {
                        DevExpress.ui.notify('Saved successfully', 'success', 2000);
                        $("#dataGrid").dxDataGrid("instance").refresh();
                    },
                         error: function (xhr) {
            let message = "Save failed";
            if (xhr.responseJSON && xhr.responseJSON.message) {
                message = xhr.responseJSON.message;
            } else if (xhr.responseText) {
                try {
                    const resp = JSON.parse(xhr.responseText);
                    if (resp.message) message = resp.message;
                } catch {}
            }
            DevExpress.ui.notify(message, 'error', 3000);
        }
    });
            } else {
                // If validation failed, notify user
                DevExpress.ui.notify('Please fill all required fields correctly.', 'error', 3000);
            }
        });
    });

    $(function () {
        var grid = $("#dataGrid").dxDataGrid("instance");
        if (grid) {
            grid.option("onRowUpdated", function (e) {
                DevExpress.ui.notify(" updated successfully.", "success", 2000);
            });
        }
    });
      $(function () {
    $("#Stockgroup").dxTextBox({
    text: formatMessage("Stock Group"),
        readOnly: true,
        onContentReady: function (e) {
        $(e.element).addClass("dx-textbox-heading");
        }
        });
    });

    async function convertToArabic() {

         // Get the TextBox1 (input) instance

         const textBox1Instance = $("#NewStockServicesGroups").dxTextArea("instance");

         // Get the TextBox2 (output) instance

         const textBox2Instance = $("#StockServicesGroups").dxTextArea("instance");

         // Ensure both instances are initialized

         if (!textBox1Instance || !textBox2Instance) {

             console.error("TextBox instances are not properly initialized.");

             return;

         }


         // Get the value from TextBox1

         const englishText = textBox1Instance.option("value");

         // Validate input

         if (!englishText || englishText.trim() === "") {

             alert("Please enter text to translate.");

             return;

         }

         // Perform translation

         const arabicTranslation = await translateToArabic(englishText);

         // Update TextBox2 with the Arabic translation

         textBox2Instance.option("value", arabicTranslation);

    }
</script>