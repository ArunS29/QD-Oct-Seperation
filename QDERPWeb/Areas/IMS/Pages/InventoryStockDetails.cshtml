                <div class="dx-card " style="background-color:transparent; border:none;padding:10px;">

                @(Html.DevExtreme().DataGrid()
                    .ID("UnitConversionGrid")
                    .Height(390)
                    .ShowBorders(true)
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .RowAlternationEnabled(true)
                    .ColumnAutoWidth(true)
                    .DataSource(new JS("[]")) // Empty at start
                    .OnInitialized("onUnitConversionGridInitialized")
                    .Editing(editing =>
                    {
                        editing.Mode(GridEditMode.Row);
                        editing.AllowAdding(false);
                        editing.AllowUpdating(true);
                        editing.UseIcons(true);
                    })
                    .Columns(columns =>
                    {
                        columns.Add()
                        .DataField("UnitCodeOfConversion")
                        .Width(300)
                        .Caption(new JS("formatMessage('Unit Code Of Conversion')"))
                        .EditCellTemplate(new JS("unitCodeDropDownEditor")); // ✅ Use as editor

                        columns.Add()
                        .DataField("UnitConverted")
                        .Caption(new JS("formatMessage('Unit Converted')"))
                        .DataType(GridColumnDataType.Number);

                        columns.Add()
                        .DataField("UnitConversionRemarks")
                        .Caption(new JS("formatMessage('Unit Conversion Remarks')"));
                    })
                    )




                </div>
                <script>
                    let UnitConversionGridInstance = null;
                    let unitCodeLookupData = [];

                    // ✅ Single correct version of unitCodeDropdown loader
                    function loadUnitCodeDropdown() {
                        return $.ajax({
                            url: "/api/StockInventory/GetUnitCodeOptions", // Update as per your API
                            method: "GET",
                            dataType: "json"
                        }).then(function (response) {
                            unitCodeLookupData = response;
                        });
                    }

                    function onUnitConversionGridInitialized(e) {
                        UnitConversionGridInstance = e.component;
                        console.log("Grid initialized");
                    }

                    function loadUnitConversionGrid(gscode) {
                        if (!UnitConversionGridInstance) return;

                        const dataStore = new DevExpress.data.CustomStore({
                            key: "UnitConversionId",
                            load: () => $.getJSON("/api/StockInventory/GetUnitConversionGridData", { gscode })
                        });

                        UnitConversionGridInstance.option("dataSource", dataStore);
                    }

                    function addNewUnitRow() {
                        if (UnitConversionGridInstance) {
                            const currentData = UnitConversionGridInstance.getDataSource().items();

                            const newRow = {
                                UnitCodeOfConversion: null,
                                UnitConverted: null,
                                UnitConversionRemarks: null
                            };

                            currentData.push(newRow);
                            UnitConversionGridInstance.option("dataSource", [...currentData]);
                        }
                    }
                     $(function () {
                        loadUnitCodeDropdown().then(() => {
                            $("#addButton").dxButton({
                                text: formatMessage("Add New Row"),
                                type: "success",
                                onClick: addNewUnitRow
                            });
                        });
                    });
                   

                    // ✅ Dropdown Editor Template
                    function unitCodeDropDownEditor(cellElement, cellInfo) {
                        $("<div>").appendTo(cellElement).dxDropDownBox({
                            value: cellInfo.value,
                            valueExpr: "UnitCode",
                            displayExpr: function (item) {
                                return item ? `${item.UnitType}` : "";
                            },
                            dataSource: unitCodeLookupData,
                            showClearButton: true,
                            dropDownOptions: { width: 600 },
                            onValueChanged: function (e) {
                                const selected = unitCodeLookupData.find(x => x.UnitCode === e.value);
                                if (selected) {
                                    cellInfo.setValue(selected.UnitCode);
                                }
                            },
                            contentTemplate: function (e) {
                                return $("<div>").dxDataGrid({
                                    dataSource: unitCodeLookupData,
                                    keyExpr: "UnitCode",
                                    height: 300,
                                    selection: { mode: "single" },
                                    selectedRowKeys: e.component.option("value") ? [e.component.option("value")] : [],
                                            filterRow: { visible: false },
                headerFilter: { visible: true },
                                             searchPanel: {
                    visible: true,
                    highlightCaseSensitive: true,
                    width: 300,
                    placeholder: "Search..."
                },
                                    onSelectionChanged: function (selectedItems) {
                                        const selected = selectedItems.selectedRowsData[0];
                                        if (selected) {
                                            e.component.option("value", selected.UnitCode);
                                            cellInfo.setValue(selected.UnitCode);
                                            e.component.close();
                                        }
                                    },
                                    columns: [
                                        { dataField: "UnitCode", caption: "Unit Code" },
                                        { dataField: "UnitType", caption: "Unit Type" },
                                        { dataField: "UnitDesc", caption: "Unit Description" }
                                    ]
                                });
                            }
                        });
                    }

                    

                </script>
            </div>
        </div>
