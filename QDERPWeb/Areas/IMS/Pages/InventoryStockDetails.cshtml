                <div class="dx-field ledgerResult" style="margin-bottom: 100px">
                    <table style="width:100%; margin-top: 15px;">
                        <tr>
                            <td>
                            @(Html.DevExtreme().DataGrid()
                                .ID("stockCardGrid")
                                .OnInitialized("onStockGridInitialized")
                                .Height(400)
                                .Columns(columns =>
                                {
                                    columns.Add().DataField("ReceiptNo").Caption("Document No").Alignment(HorizontalAlignment.Center);
                                    columns.Add().DataField("TypeOfEntry").Caption("Transaction Type").Alignment(HorizontalAlignment.Center);
                                    columns.Add().DataField("TransactionDate").Caption("Transaction Date").Alignment(HorizontalAlignment.Center)
                                    .DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy");
                                    columns.Add().DataField("InventoryEffectiveDate").Caption("Inventory Effective Date")
                                    .Alignment(HorizontalAlignment.Center).DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy");
                                    columns.Add().DataField("OpeningBalanceQty").Caption("Opening Balance").Alignment(HorizontalAlignment.Center).Format("fixedPoint");
                                    columns.Add().DataField("ReceivedQty").Caption("Received").Alignment(HorizontalAlignment.Center).Format("fixedPoint");
                                    columns.Add().DataField("IssuedQty").Caption("Issued").Alignment(HorizontalAlignment.Center).Format("fixedPoint");
                                    columns.Add().DataField("StockReceiptAndOpnBalQty").Caption("Balance").Alignment(HorizontalAlignment.Center).Format("fixedPoint");
                                })
                                .Summary(summary =>
                                {
                                    summary.TotalItems(totalItems =>
                                    {
                                        totalItems.Add().Column("OpeningBalanceQty").SummaryType(SummaryType.Sum).CustomizeText("function(e) { return e.value.toFixed(2); }");
                                        totalItems.Add().Column("ReceivedQty").SummaryType(SummaryType.Sum).CustomizeText("function(e) { return e.value.toFixed(2); }");
                                        totalItems.Add().Column("IssuedQty").SummaryType(SummaryType.Sum).CustomizeText("function(e) { return e.value.toFixed(2); }");
                                        totalItems.Add().Column("StockReceiptAndOpnBalQty").SummaryType(SummaryType.Sum).CustomizeText("function(e) { return e.value.toFixed(2); }");
                                    });
                                })
                                .ShowColumnLines(true)
                                .ShowRowLines(true)
                                .RowAlternationEnabled(true)
                                .ShowColumnHeaders(true)
                                .ColumnAutoWidth(true)
                                .AllowColumnReordering(true)
                                .AllowColumnResizing(true)
                                .ColumnFixing(fixing => fixing.Enabled(true))
                                .GroupPanel(panel => panel.Visible(false))
                                .ShowBorders(true)
                                )



                            </td>
                        </tr>
