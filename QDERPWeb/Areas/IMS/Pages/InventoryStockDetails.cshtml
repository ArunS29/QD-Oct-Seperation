@page
@model QD.ERP.Web.Areas.IMS.Pages.InventoryStockDetailsModel

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using QD.ERP.Web.Areas.IMS.Pages
@using QD.ERP.Web.Pages.Shared.IMS
@{
}

<style>
    .form-tablee {
        width: 100%;
        border-collapse: separate;
        border-spacing: 6px;
    }

    .inline-icon {
        vertical-align: bottom;
        align-items: center;
        justify-content: center;    
    }

    .body {
        padding-top: 0px;
    }

    .content {
        margin: 0px;
    }

    .content-container-top {
        width: 100%;
    }
    /* Custom CSS to adjust the height of tab headers */
    .dx-tabpanel .dx-tab {
        padding: 10px 15px; /* Adjust padding to change height */
        font-size: 16px; /* Adjust font size to change header height */
    }

    /* Ensuring the content area also adjusts in height */
    .dx-tabpanel .dx-tab-content {
        padding: 20px;
        min-height: 200px; /* Minimum height for the tab content */
    }

    .dx-fieldset {
        margin: 3px 3px !important;
        padding: 0px;
    }

    .dx-datagrid-headers th {
        text-align: center; /* Centers the text */
    }

    .columnheader {
        text-align: center;
    }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

        .tab-content h3 {
            color: #333;
        }

        .tab-content p {
            line-height: 1.6;
            color: #555;
        }

    .dx-dropdownbox .dx-dropdownbox-wrapper .dx-dropdownbox-header {
        display: none;
    }

    .button-group {
        margin-left: 1px !important;
    }

    .button-alignment-up {
        margin-top: 25px !important;
    }

    .button-alignment-down {
        margin-top: 0px !important;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 300px;
        width:40%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

   
    .containerInventoryStock {
       
        align-items: center;
        justify-content: center;
    }

    .no-border-input {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        font-weight: bold;
        font-size: 16px;
        color: black;
        pointer-events: none; /* Prevents hover and click effects */
    }


   
</style>
<link rel="stylesheet" href="~/css/Site.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
<input id="formId" value="frm201LedgerAccount" type="hidden" />
<div class="title">
    <div class="header-container">
        <div id="InventoryStockDetails" class="no-border-title" style="
    border: none !important;
    box-shadow: none !important;
"></div>
    </div>
</div>
<div class="containerInventoryStock">

    <div class="content-container-top">
        <div class="dx-fieldset horizontal-container">
            <table class="form-tablee">
                <tr>
                    <td>
                        @(Html.DevExtreme().TextBox()
                            .ID("StockNoItemCode")
                            .Label(new JS("formatMessage('Stock No / Item Code')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                    </td>
                    <td>
                        <div style="display:flex;align-items:end;">
                        @(Html.DevExtreme().SelectBox()
                            .ID("StockGroup")
                            .Label(new JS("formatMessage('Stock Group')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                        @(Html.DevExtreme().Button()
                            .ID("btnAddStockGroup")
                            .Icon("plus")
                            .Width(32)
                            .ElementAttr("class", "inline-icon")
                                .OnClick("StockGroup")
                            )
                        </div>
                    </td>
                    <td colspan="2">
                        @(Html.DevExtreme().TextBox()
                            .ID("ItemName")
                            .Label(new JS("formatMessage('Item Name / Description')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))
                    </td>
                </tr>
                <tr>
                    <td>
                        <div style="display:flex;align-items:end;" ;>
                        @(Html.DevExtreme().SelectBox()
                            .ID("ItemStore")
                            .Label(new JS("formatMessage('Item Store')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                        @(Html.DevExtreme().Button()
                            .ID("btnAddStore")
                            .Icon("plus")
                            .Width(32)
                            .ElementAttr("class", "inline-icon")
                                .OnClick("ItemStore")
                                )
                        </div>
                    </td>
                    <td>
                        <div style="display:flex;align-items:end;">
                        @(Html.DevExtreme().SelectBox()
                            .ID("ItemClassification")
                            .Label(new JS("formatMessage('Item Classification')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                        @(Html.DevExtreme().Button()
                            .ID("btnAddClassification")
                            .Icon("plus")
                            .Width(32)
                            .ElementAttr("class", "inline-icon")
                             .OnClick("ItemClassification")
                                )
                        </div>
                    </td>
                    <td colspan="2">
                        @(Html.DevExtreme().TextBox()
                            .ID("ItemNameArabic")
                            .Label(new JS("formatMessage('Item Name / Description (In Arabic)')"))
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))
                    </td>
                </tr>
            </table>


            </div>

        </div>
     

        <div class="dx-fieldset horizontal-container">
            @(
                Html.DevExtreme().Tabs()
                .Items(items =>
                {
                // tab-content-1
                items.Add()
                .Icon("preferences") // better match for "Item Attributes"
                .Text(new JS("formatMessage('Item Attributes')"));

                // tab-content-2
                items.Add()
                .Icon("chart") // "Stock Control"
                .Text(new JS("formatMessage('Stock Control')"));

                // tab-content-3
                items.Add()
                .Icon("image") // "Stock Images"
                .Text(new JS("formatMessage('Stock Images')"));

                // tab-content-4
                items.Add()
                .Icon("money") // "Invoices"
                .Text(new JS("formatMessage('Invoices')"));

                // tab-content-5
                items.Add()
                .Icon("tags") // "Quotations"
                .Text(new JS("formatMessage('Quotations')"));

                // tab-content-6
                items.Add()
                .Icon("cart") // "Purchase Order"
                .Text(new JS("formatMessage('Purchase Order')"));

                // tab-content-7
                items.Add()
                .Icon("runner") // "Item Deliveries"
                .Text(new JS("formatMessage('Item Deliveries')"));

                // tab-content-8
                items.Add()
                .Icon("check") // "Item Received"
                .Text(new JS("formatMessage('Item Received')"));

                // tab-content-9
                items.Add()
                .Icon("repeat") // "Unit Conversion"
                .Text(new JS("formatMessage('Unit Conversion')"));

                // tab-content-10
                items.Add()
                .Icon("doc") // "Document"
                .Text(new JS("formatMessage('Document')"));

                // tab-content-11
                items.Add()
                .Icon("money") // "Purchases"
                .Text(new JS("formatMessage('Purchases')"));

                // tab-content-12
                items.Add()
                .Icon("bookmark") // "Matl.Requests"
                .Text(new JS("formatMessage('Matl. Requests')"));
            })
                .SelectedIndex(0) // Default selected tab is the first one
                .OnSelectionChanged("onTabSelectionChanged") // Event handler for tab selection changes
                )
        </div>


        <!-- Tab Content -->
        <div class="dx-fieldset">
            <div id="tab-content-1" class="tab-content" ">


            <div id="tab1-content">
                @* @await Html.PartialAsync("StockDetails_StockControl") *@
             
                @* @await Html.PartialAsync("~/Pages/Shared/IMS/MusFooter1.cshtml") *@
                @await Html.PartialAsync("~/Pages/Shared/IMS/ItemAttributes.cshtml")
            </div>
            </div>

            <div id="tab-content-2" class="tab-content" style="display: none;">
                <div>
                  
                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_StockControl.cshtml")
                </div>
            </div>

            <div id="tab-content-3" class="tab-content" style="display: none;">
                <div class="background">
                <div class="imagecontainer" id="imgBox1">
                    <span>No image data</span>
                </div>
                </div>
            </div>

            <div id="tab-content-4" class="tab-content">
                <div class="background">
                <div>

                    @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_Invoices.cshtml")
                </div>
                </div>
            </div>
            <div id="tab-content-5" class="tab-content">
                <div class="background">

                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_Quotations.cshtml")

                </div>
            </div>
           

            <div id="tab-content-6" class="tab-content">
                <div class="background">
               
                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_PurchaseOrders.cshtml")
                </div>
            </div>
        <div id="tab-content-7" class="tab-content">
            <div class="background">

                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_ItemDelivers.cshtml")
            </div>
        </div>

            <div id="tab-content-8" class="tab-content">
                <div class="background">

                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_ItemReceived.cshtml")

                </div>
            </div>
        <div id="tab-content-9" class="tab-content">
            <div class="background">

                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_UnitConversion.cshtml")

            </div>
        </div>
        <div id="tab-content-10" class="tab-content">
            <div class="background">

                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_Document.cshtml")

            </div>
        </div>
        <div id="tab-content-11" class="tab-content">
            <div class="background">

                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_purchases.cshtml")

            </div>
        </div>
        <div id="tab-content-12" class="tab-content">
            <div class="background">

                @await Html.PartialAsync("~/Pages/Shared/IMS/StockDetails_MaterialRequest.cshtml")

            </div>
        </div>
        
        </div>

        

       
    </div>

    
<script>


  function onTabSelectionChanged(e) {
        // Hide all tab content
        $(".tab-content").hide();

        // Show the content of the selected tab
        var selectedTabIndex = e.component.option("selectedIndex");
        $("#tab-content-" + (selectedTabIndex + 1)).show();
    }
      function ItemStore(){
                const url = `/${tenantName}/IMS/StockDetails_ItemStore`;
              const title = "";
                  openModal(url, title);
          }
            function StockGroup(){
                const url = `/${tenantName}/IMS/StockDetails_StockGroup`;
              const title = "";
                  openModal(url, title);
          }
            function ItemClassification(){
                const url = `/${tenantName}/IMS/StockDetails_ItemClassification`;
              const title = "";
                  openModal(url, title);
          }
            $(document).ready(function () {
          // Ensure dxTabs has loaded, then get the selected index
          const tabsInstance = DevExpress.ui.dxTabs.getInstance($(".dx-tabs")[0]);
          const selectedTabIndex = tabsInstance.option("selectedIndex");

          // Show the corresponding content
          $("#tab-content-" + (selectedTabIndex + 1)).show();
      });

        
         $(function () {
            $("#InventoryStockDetails").dxTextBox({
                text: formatMessage("Inventory Stock Details"),
              readOnly: true,
              onContentReady: function(e) {
                          $(e.element).addClass("dx-textbox-heading");
                  }

          });
      });

      
</script>