    <div class="content-container-top">
        <div class="dx-fieldset horizontal-container">
            <table class="form-tablee">
                <tr>
                    <td>
                        @(Html.DevExtreme().TextBox()
                            .ID("StockNo")
                            .Label("Stock No / Item Code:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                    </td>
                    <td>
                        <div style="display:flex;align-items:end;">
                        @(Html.DevExtreme().SelectBox()
                            .ID("StockGroup")
                            .Label("Stock Group")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                        @(Html.DevExtreme().Button()
                            .ID("btnAddStockGroup")
                            .Icon("plus")
                            .Width(32)
                            .ElementAttr("class", "inline-icon")
                                .OnClick("StockGroup")
                            )
                        </div>
                    </td>
                    <td colspan="2">
                        @(Html.DevExtreme().TextBox()
                            .ID("ItemName")
                            .Label("Item Name / Description")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%"))
                    </td>
                </tr>
                <tr>
                    <td>
                        <div style="display:flex;align-items:end;" ;>
                        @(Html.DevExtreme().SelectBox()
                            .ID("ItemStore")
                            .Label("Item Store:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                        @(Html.DevExtreme().Button()
                            .ID("btnAddStore")
                            .Icon("plus")
                            .Width(32)
                            .ElementAttr("class", "inline-icon")
                                .OnClick("ItemStore")
                                )
                        </div>
                    </td>
                    <td>
                        <div style="display:flex;align-items:end;">
                        @(Html.DevExtreme().SelectBox()
                            .ID("ItemClassification")
                            .Label("Item Classification:")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("90%"))
                        @(Html.DevExtreme().Button()
                            .ID("btnAddClassification")
                            .Icon("plus")
                            .Width(32)
                            .ElementAttr("class", "inline-icon")
                             .OnClick("ItemClassification")
                                )
                        </div>
                    </td>
                    <td colspan="2">
