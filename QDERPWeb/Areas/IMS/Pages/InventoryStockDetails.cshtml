                <script>
                 let stockGridInstance = null;

                    function onStockGridInitialized(e) {
                      stockGridInstance = e.component;
                      console.log("Grid initialized", stockGridInstance);
                    }

                    function onGscodeChanged(e) {
                      const gscode = e.value;
                      if (stockGridInstance && gscode) {
                        loadStockCardGrid(gscode);
                      } else {
                        console.warn("Grid not initialized or invalid GsCode", gscode);
                      }
                    }

                    function loadStockCardGrid(gscode) {
                      console.log("Preparing to load grid for GsCode:", gscode);

                      if (!stockGridInstance) {
                        console.error("Grid not initialized");
                        return;
                      }

                      const dataStore = new DevExpress.data.CustomStore({
                        load: function () {
                          console.log("Calling API for GsCode:", gscode);

                          return $.getJSON(`/api/StockInventory/GetStockCardData`, { gscode })
                            .then(data => {
                              console.log(" Data loaded", data);
                              return data;
                            })
                            .fail((jqXHR, textStatus, errorThrown) => {
                              console.error("API call failed:", textStatus, errorThrown);
                              
                              alert("API call failed: " + textStatus + ", " + errorThrown);
                              
                              throw new Error(`API call failed: ${textStatus}`);
                            });
                        }
                      });

                      stockGridInstance.option("dataSource", dataStore);
                    }



                    function printReport() {
                        alert("Print report clicked");
                    }


                </script>
