<style>
    .form-tablee {
        width: 100%;
        border-collapse: separate;
        border-spacing: 6px;
    }

    .inline-icon {
        vertical-align: bottom;
        align-items: center;
        justify-content: center;    
    }

    .body {
        padding-top: 0px;
    }

    .content {
        margin: 0px;
    }

    .content-container-top {
        width: 100%;
    }
    /* Custom CSS to adjust the height of tab headers */
    .dx-tabpanel .dx-tab {
        padding: 10px 15px; /* Adjust padding to change height */
        font-size: 16px; /* Adjust font size to change header height */
    }

    /* Ensuring the content area also adjusts in height */
    .dx-tabpanel .dx-tab-content {
        padding: 20px;
        min-height: 200px; /* Minimum height for the tab content */
    }

    .dx-fieldset {
        margin: 3px 3px !important;
        padding: 0px;
    }

    .dx-datagrid-headers th {
        text-align: center; /* Centers the text */
    }

    .columnheader {
        text-align: center;
    }
    /* Remove the extra blue focus border from DevExtreme search panel input */
    .dx-datagrid-search-panel input:focus {
        outline: none !important;
        box-shadow: none !important;
    }


    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

        .tab-content h3 {
            color: #333;
        }

        .tab-content p {
            line-height: 1.6;
            color: #555;
        }

    .dx-dropdownbox .dx-dropdownbox-wrapper .dx-dropdownbox-header {
        display: none;
    }

    .button-group {
        margin-left: 1px !important;
    }

    .button-alignment-up {
        margin-top: 25px !important;
    }

    .button-alignment-down {
        margin-top: 0px !important;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 300px;
        width:40%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

   
    .containerInventoryStock {
       
        align-items: center;
        justify-content: center;
    }

    .no-border-input {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        font-weight: bold;
        font-size: 16px;
        color: black;
        pointer-events: none; /* Prevents hover and click effects */
    }

    .dx-dropdownlist-popup-wrapper .dx-list .dx-list-item {
        color: #000 !important;
        background-color: #fff !important;
    }

    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 2px 2px 6px rgba(0,0,0,0.2);
        z-index: 1000;
        list-style-type: none;
        padding: 0;
        margin: 0;
        min-width: 120px;
    }

        .context-menu li {
            padding: 8px 12px;
            cursor: pointer;
        }

            .context-menu li:hover {
                background-color: #eee;
            }


    .titleCard-toggle1 {
        display: none;
    }
   
</style>
<link rel="stylesheet" href="~/css/Site.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
<input id="formId" value="frm201LedgerAccount" type="hidden" />
<div class="containerInventoryStock">

        <div class="dx-fieldset horizontal-container">
            <table class="form-tablee">
