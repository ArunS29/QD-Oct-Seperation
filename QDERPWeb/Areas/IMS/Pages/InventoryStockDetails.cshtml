                <div>
                <div class="imagecontainer" id="imgBox1">
                    <span>No image data</span>
                </div>
                </div>
            <!-- Custom Context Menu -->
            <!-- Add this in your body -->
            <ul id="customMenu" class="context-menu">
                <li onclick="handleAction('cut')">Cut</li>
                <li onclick="handleAction('copy')">Copy</li>
                <li onclick="handleAction('load')">Load</li>
                <li onclick="handleAction('paste')">Paste</li>
                <li onclick="handleAction('delete')">Delete</li>
            </ul>
             
            <script>
                let imageBase64 = null;

                let copiedImageData = null;
                const imgBox = document.getElementById("imgBox1");
                const menu = document.getElementById("customMenu");

                // Right-click to show custom menu
                imgBox.addEventListener("contextmenu", function (e) {
                  e.preventDefault();
                  menu.style.top = `${e.pageY}px`;
                  menu.style.left = `${e.pageX}px`;
                  menu.style.display = "block";
                });

                // Hide menu on click
                document.addEventListener("click", function () {
                  menu.style.display = "none";
                });

                // Handle context menu actions
                function handleAction(action) {
                  switch (action) {
                    case 'cut':
                      cutImage();
                      break;
                    case 'copy':
                      copyImage();
                      break;
                    case 'load':
                      loadImage();
                      break;
                    case 'paste':
                      pasteImage();
                      break;
                    case 'delete':
                deleteImage(); 
                break;
                  }
                  menu.style.display = "none";
                }

                // CUT: Remove image and store
                function cutImage() {
                  const img = imgBox.querySelector("img");
                  if (img) {
                    copiedImageData = img.src;
                    img.remove();
                  } else {
                    alert("No image to cut.");
                  }
                }

                // COPY: Store image src
                function copyImage() {
                  const img = imgBox.querySelector("img");
                  if (img) {
                    copiedImageData = img.src;
                    alert("Image copied.");
                  } else {
                    alert("No image to copy.");
                  }
                }

                function loadImage() {
                    const input = document.createElement("input");
                    input.type = "file";
                    input.accept = "image/*";
                    input.onchange = function (event) {
                        const file = event.target.files[0];
                        if (file) {
                            const reader = new FileReader();
                            reader.onload = function (e) {
                                imageBase64 = e.target.result.split(',')[1]; 

                                const img = document.createElement("img");
                                img.src = e.target.result;
                                img.style.maxWidth = "100%";
                                img.style.maxHeight = "100%";
                                imgBox.innerHTML = '';
                                imgBox.appendChild(img);
                            };
                            reader.readAsDataURL(file);
                        }
                    };
                    input.click();
                }



                function pasteImage() {
                    if (copiedImageData) {
                        imageBase64 = copiedImageData.split(',')[1]; 

                        const img = document.createElement("img");
                        img.src = copiedImageData;
                        img.style.maxWidth = "100%";
                        img.style.maxHeight = "100%";
                        imgBox.innerHTML = '';
                        imgBox.appendChild(img);
                    } else {
                        alert("Nothing to paste.");
                    }
                }


                function deleteImage() {
                  const img = imgBox.querySelector("img");
                  if (img) {
                    img.remove();
                    alert("Image deleted.");
                  } else {
                    alert("No image to delete.");
                  }
                }
            </script>

            </div>

