                    <script>
                        let DocumentGridInstance = null;

                        function onDocumentGridInitialized(e) {
                            DocumentGridInstance = e.component;
                        }

                        function loadDocumentGrid(gscode) {
                            if (!DocumentGridInstance) return;

                            const dataStore = new DevExpress.data.CustomStore({
                                key: "DocumentRefNo",
                                load: () => $.getJSON("/api/StockInventory/GetDocumentGridData", { gscode })
                                    .then(data => data)
                                    .catch(err => {
                                        alert("Failed to load data.");
                                        throw err;
                                    })
                            });

                            DocumentGridInstance.option("dataSource", dataStore);
                        }

                        function getSelectedDocumentNos() {
                            const selected = DocumentGridInstance.getSelectedRowsData();
                            if (!selected.length) {
                                alert("Please select at least one document.");
                                return [];
                            }
                            return selected.map(r => r.DocumentRefNo);
                        }

                        function mergeSelectedFiles() {
                            const selectedDocs = getSelectedDocumentNos();
                            if (!selectedDocs.length) return;

                            fetch("/api/StockInventory/MergeSelectedDocuments", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(selectedDocs)
                            })
                            .then(response => {
                                if (!response.ok) throw new Error("Failed to merge files.");
                                return response.blob();
                            })
                            .then(blob => {
                                const url = window.URL.createObjectURL(blob);
                                const link = document.createElement("a");
                                link.href = url;
                                link.download = "MergedDocument.pdf";
                                link.click();
                            })
                            .catch(err => alert("Merging failed."));
                        }

                        function saveSeparatedFiles() {
                            const selectedDocs = getSelectedDocumentNos();
                            if (!selectedDocs.length) return;

                            fetch("/api/StockInventory/DownloadMultipleDocuments", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(selectedDocs)
                            })
                            .then(response => {
                                if (!response.ok) throw new Error("Failed to download files.");
                                return response.blob();
                            })
                            .then(blob => {
                                const url = window.URL.createObjectURL(blob);
                                const link = document.createElement("a");
                                link.href = url;
                                link.download = "Documents.zip";
                                link.click();
                            })
                            .catch(err => alert("Download failed."));
                        }

