        </div>
<script>

            function onTabSelectionChanged(e) {
        console.log("TAB CHANGED", e);

        $(".tab-content").hide();

        var selectedTabIndex = e.component.option("selectedIndex");
        console.log("Selected tab index:", selectedTabIndex);

        // Show the corresponding content
        $("#tab-content-" + (selectedTabIndex + 1)).show();

        const gscode = $("#StockNoItemCode").dxTextBox("instance").option("value");
        console.log("GsCode:", gscode);

        if (!gscode) {
            console.warn("GsCode is empty.");
            return;
        }

        // Load the correct grid based on selected tab
        switch (selectedTabIndex) {
            case 1: // Stock Control
                loadStockCardGrid(gscode);
                break;
            case 3: 
                loadInvoiceGrid(gscode);
                break;
            case 4:
            loadQuotationGrid(gscode);
            break;
              case 5:
            loadPurchaseOrderGrid(gscode); 
            break;
             break;
              case 6:
            loadItemDeliversGrid(gscode); 
            break;
              case 7:
            loadItemReceivedGrid(gscode);
            break;
              case 8:
            loadUnitConversionGrid(gscode);
            break;
            case 9:
            loadDocumentGrid(gscode);
            break;
            case 10:
            loadPurchaseGrid(gscode);
            break;
            // case 2 or 0 can be used similarly for Stock Images, Item Attributes if needed
            default:
                console.log("No grid loading required for this tab.");
        }
    }

