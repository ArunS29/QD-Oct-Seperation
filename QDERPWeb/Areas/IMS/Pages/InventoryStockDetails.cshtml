         $(function () {
            $("#InventoryStockDetails").dxTextBox({
                text: formatMessage("Inventory Stock Details"),
              readOnly: true,
              onContentReady: function(e) {
                          $(e.element).addClass("dx-textbox-heading");
                  }

          });
      });

      //////
    let isEditMode = false;
    let isViewMode = false;

    function onStockGroupChange(e) {
        var GsgroupId = e.value;

        if (!isViewMode && !isEditMode && GsgroupId) {
            $.get('/api/StockInventory/GetNextStockNumber', { GsgroupId: GsgroupId }, function (data) {
                $("#StockNoItemCode").dxTextBox("instance").option("value", data);
            });
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const urlParams = new URLSearchParams(window.location.search);
        const code = urlParams.get('code');
        const mode = urlParams.get('mode');

        if (code) {
            isEditMode = mode === "edit";
            isViewMode = mode === "view";

            setTimeout(() => {
                fetch(`/api/StockInventory/GetByCode?code=${encodeURIComponent(code)}`)
                    .then(response => {
                        if (!response.ok) throw new Error("Failed to load");
                        return response.json();
                    })
                    .then(data => {
                        if (data) {
                            $("#StockNoItemCode").dxTextBox("instance").option("value", data.Gscode);
                            $("#ItemName").dxTextBox("instance").option("value", data.Gsdescrpition);
                            $("#ItemNameArabic").dxTextBox("instance").option("value", data.GsdescriptionAr);
                            $("#StockGroup").dxSelectBox("instance").option("value", data.GsgroupId);
                            $("#ItemStore").dxSelectBox("instance").option("value", data.StoreId);
                            $("#ItemClassification").dxSelectBox("instance").option("value", data.ItemClassificationId);
                            $("#DetailedDescription").dxTextArea("instance").option("value", data.GsdetailedDesc);
                            $("#ArabicDescription").dxTextArea("instance").option("value", data.GsdetailedDescAr);
                            $("#UnitOfMeasure").dxSelectBox("instance").option("value", data.GsuoM);
                            $("#PackingUnit").dxNumberBox("instance").option("value", data.GspackingUnit);
                            $("#ItemSize").dxSelectBox("instance").option("value", data.ItemSize);
                            $("#ItemThickness").dxSelectBox("instance").option("value", data.ItemThickness);
                            $("#ItemDimension").dxSelectBox("instance").option("value", data.ItemDimension);
                            $("#ActualSize").dxTextBox("instance").option("value", data.ActualSize);
                            $("#OpeningBalance").dxNumberBox("instance").option("value", data.OpeningBalance);
                            $("#CostPrice").dxNumberBox("instance").option("value", data.CostPrice);
                            $("#ExFactoryPrice").dxNumberBox("instance").option("value", data.ExFactoryCostPrice);
                            $("#SellingPrice").dxNumberBox("instance").option("value", data.GssellingRate);
                            $("#MinSellingPrice").dxNumberBox("instance").option("value", data.MinSellingPrice);
                            $("#MaxSellingPrice").dxNumberBox("instance").option("value", data.MaxSellingPrice);
                            $("#ItemPartNo").dxTextBox("instance").option("value", data.ItemPartNo);
                            $("#ItemHSCode").dxTextBox("instance").option("value", data.Hscode);
                            $("#ItemColor").dxColorBox("instance").option("value", data.ItemColor);
                            $("#ItemBrand").dxSelectBox("instance").option("value", data.ItemBrand);
                            $("#ItemManufacturer").dxSelectBox("instance").option("value", data.ItemMake);
                            $("#CountryOfOrigin").dxTextBox("instance").option("value", data.CountryOfOrigin);
                            $("#EnteredBy").dxTextArea("instance").option("value", data.CreatedBy);
                            $("#ModifiedBy").dxTextArea("instance").option("value", data.ModifiedBy);
                            $("#ItemDiscontinued").dxCheckBox("instance").option("value", data.IsDiscontinued);
                                // Load Item Image (Base64)
                            if (data.ItemImage) {
                                const imgHtml = `<img src="data:image/png;base64,${data.ItemImage}" alt="Item Image" style="max-width: 100%; height: auto;" />`;
                                document.getElementById("imgBox1").innerHTML = imgHtml;
                            } else {
                                document.getElementById("imgBox1").innerHTML = "<span>No image data</span>";
                            }

                            $("#MinQty").dxNumberBox("instance").option("value", data.MinQty);
                            $("#MaxQty").dxNumberBox("instance").option("value", data.MaxQty);
                            $("#ReorderLevel").dxNumberBox("instance").option("value", data.ReorderLevel);
                            $("#ReorderQty").dxNumberBox("instance").option("value", data.ReorderQty);
                            $("#ReorderLeadTime").dxNumberBox("instance").option("value", data.ReorderLeadTime);

                            if (isViewMode) {
                                setTimeout(setReadOnlyMode, 500); 
                            }
                        }
                    })
                    .catch(error => {
                        console.error("Error loading record:", error);
                        alert("Failed to load item details.");
                    });
            }, 100);
        }
    });

        function setReadOnlyMode() {
        const ids = [
            "StockNoItemCode", "ItemName", "ItemNameArabic", "StockGroup", "ItemStore", "ItemClassification",
            "DetailedDescription", "ArabicDescription", "UnitOfMeasure", "PackingUnit", "ItemSize",
            "ItemThickness", "ItemDimension", "ActualSize", "OpeningBalance", "CostPrice", "ExFactoryPrice",
            "SellingPrice", "MinSellingPrice", "MaxSellingPrice", "ItemPartNo", "ItemHSCode", "ItemColor",
            "ItemBrand", "ItemManufacturer", "CountryOfOrigin", "EnteredBy", "ModifiedBy", "ItemDiscontinued",
            "MinQty", "MaxQty", "ReorderLevel", "ReorderQty", "ReorderLeadTime"
        ];

        ids.forEach(id => {
            const $el = $(`#${id}`);
            if (!$el.length) return;

            const types = [
                "dxTextBox",
                "dxNumberBox",
                "dxTextArea",
                "dxSelectBox",
                "dxCheckBox",
                "dxColorBox"
            ];

            for (const type of types) {
                try {
                    if ($el[type]) {
                        const instance = $el[type]("instance");
                        if (instance) {
                            instance.option("disabled", true);
                            break;
                        }
                    }
                } catch (e) {
                    // Ignore errors if component not initialized
                }
            }
        });
    }


        let selectedGsCode = "";

      $(() => {
          const stockNoBox = $("#StockNoItemCode").dxTextBox("instance");

          // Set initial value to the global variable
          selectedGsCode = stockNoBox.option("value");

          // Update global variable when value changes
          stockNoBox.option("onValueChanged", function(e) {
              selectedGsCode = e.value;
          });
      });

    function OpeningBalanceOPB() {
        // Get instances safely
        const gscodeInstance = $("#StockNoItemCode").dxTextBox("instance");
        const descriptionInstance = $("#DetailedDescription").dxTextArea("instance");

        // Check if both controls exist
        if (!gscodeInstance || !descriptionInstance) {
            console.warn("DevExtreme controls not initialized.");
            return;
        }

        // Safely get values
        const gscode = gscodeInstance.option("value") || '';
        const description = descriptionInstance.option("value") || '';

        // Encode the parameters to ensure URL safety
        const url = `/${tenantName}/IMS/OpeningBalance?gscode=${encodeURIComponent(gscode)}&description=${encodeURIComponent(description)}&modal=true`;
        openModal(url, "Opening Balance");
    }

    async function convertToArabic() {

         // Get the TextBox1 (input) instance

         const textBox1Instance = $("#DetailedDescription").dxTextArea("instance");

         // Get the TextBox2 (output) instance

         const textBox2Instance = $("#ArabicDescription").dxTextArea("instance");

         // Ensure both instances are initialized

         if (!textBox1Instance || !textBox2Instance) {

             console.error("TextBox instances are not properly initialized.");

             return;

         }


         // Get the value from TextBox1

         const englishText = textBox1Instance.option("value");

         // Validate input

         if (!englishText || englishText.trim() === "") {

             alert("Please enter text to translate.");

             return;

         }

         // Perform translation

         const arabicTranslation = await translateToArabic(englishText);

         // Update TextBox2 with the Arabic translation

         textBox2Instance.option("value", arabicTranslation);

    }
