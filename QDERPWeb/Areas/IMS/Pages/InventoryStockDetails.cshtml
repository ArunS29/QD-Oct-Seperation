          }
            $(document).ready(function () {
          // Ensure dxTabs has loaded, then get the selected index
          const tabsInstance = DevExpress.ui.dxTabs.getInstance($(".dx-tabs")[0]);
          const selectedTabIndex = tabsInstance.option("selectedIndex");

          // Show the corresponding content
