                <div class="dx-card " style="background-color:transparent; border:none;padding:10px;">


                @(Html.DevExtreme().DataGrid()
                    .ID("PurchaseGrid")
                    .Height(390)
                    .DataSource(Enumerable.Empty<object>()) 
                    .ShowBorders(true)
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .RowAlternationEnabled(true)
                    .ColumnAutoWidth(true)
                    .ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))

                    .OnInitialized("onPurchaseGridInitialized")
                    .Columns(columns =>
                    {
                        columns.Add().DataField("Gscode").Caption(new JS("formatMessage('Item Code')"));
                        columns.Add().DataField("Pono").Caption(new JS("formatMessage('Purchase Voucher No')"));
                         columns.Add().DataField("Podate").Caption(new JS("formatMessage('Purchase Voucher Date')")).DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy");
                        columns.Add().DataField("QuotedQuantity").Caption(new JS("formatMessage('Quantity Invoiced')")).Alignment(HorizontalAlignment.Center);
                        columns.Add().DataField("UnitDesc").Caption(new JS("formatMessage('Unit Desc')"));
                        columns.Add().DataField("UnitPrice").Caption(new JS("formatMessage('Unit Rate')"));
                        columns.Add().DataField("ItemDiscount").Caption(new JS("formatMessage('Discount')")).Format("##,##0.00");
                        columns.Add().DataField("LineTotalAfterDisc").Caption(new JS("formatMessage('Total After Disc')")).Format("##,##0.00");
                        columns.Add().DataField("LineTaxAmount").Caption(new JS("formatMessage('Tax Amount')")).Format("##,##0.00");
                        columns.Add().DataField("LineTotalWithTax").Caption(new JS("formatMessage('Total With Tax')")).Format("##,##0.00");

                                    columns.Add().DataField("AccountHead")
                                    .Caption(new JS("formatMessage('Account Head')"))
                                    .Visible(false);

                                    columns.Add().DataField("CostAllocationGroup")
                                    .Caption(new JS("formatMessage('Cost Allocation Group')"))
                                    .Visible(false);

                                    columns.Add().DataField("Gsdescrpition")
                                    .Caption(new JS("formatMessage('GS Description')"))
                                    .Visible(false);

                                    columns.Add().DataField("Gscode")
                                    .Caption(new JS("formatMessage('Item Code')"))
                                    .Visible(false);

                                    columns.Add().DataField("LineTotalBeforeTax")
                                    .Caption(new JS("formatMessage('Line Amount Before Discount')"))
                                    .Visible(false);

                                    columns.Add().DataField("MaterialReceiptDate")
                                    .Caption(new JS("formatMessage('Material Receipt Date')"))
                                    .Visible(false);

                                    columns.Add().DataField("MaterialReceiptNo")
                                    .Caption(new JS("formatMessage('Material Receipt No')"))
                                    .Visible(false);

                                    columns.Add().DataField("PurchaseBillDate")
                                    .Caption(new JS("formatMessage('Purchase Bill Date')"))
                                    .Visible(false);

                                    columns.Add().DataField("PurchaseBillNo")
                                    .Caption(new JS("formatMessage('Purchase Bill No')"))
                                    .Visible(false);

                                    columns.Add().DataField("PurchaseDeliveryDate")
                                    .Caption(new JS("formatMessage('Purchase Delivery Date')"))
                                    .Visible(false);

                                    columns.Add().DataField("Podate")
                                    .Caption(new JS("formatMessage('Purchase Order Date')"))
                                    .Visible(false);

                                    columns.Add().DataField("Pono")
                                    .Caption(new JS("formatMessage('Purchase Order No')"))
                                    .Visible(false);

                                    columns.Add().DataField("SupplierCode")
                                    .Caption(new JS("formatMessage('Supplier Code')"))
                                    .Visible(false);

                                    columns.Add().DataField("LineTaxAmount")
                                    .Caption(new JS("formatMessage('Tax Amount')"))
                                    .Visible(false);

                                    columns.Add().DataField("LineTotalAfterDisc")
                                    .Caption(new JS("formatMessage('Total After Disc.')"))
                                    .Visible(false);

                                    columns.Add().DataField("LineTotalWithTax")
                                    .Caption(new JS("formatMessage('Total With Tax')"))
                                    .Visible(false);

                    })
                    .Summary(summary =>
                    {
                        summary.TotalItems(items =>
                        {
                                        items.Add().Column("LineTaxAmount").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00").DisplayFormat("{0}");
                                        items.Add().Column("LineTotalAfterDisc").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00").DisplayFormat("{0}");
                                        items.Add().Column("ItemDiscount").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00").DisplayFormat("{0}");
                                        items.Add().Column("LineTotalWithTax").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00").DisplayFormat("{0}");
                        });
                    })
                    )

                </div>
                <script>
                    let PurchaseGridInstance = null;

                    function onPurchaseGridInitialized(e) {
                        PurchaseGridInstance = e.component;
                        console.log("PurchaseGrid initialized", PurchaseGridInstance);
                    }

                    function loadPurchaseGrid(gscode) {
                        if (!PurchaseGridInstance) {
                            console.error("PurchaseGrid not initialized");
                            return;
                        }

                        const dataStore = new DevExpress.data.CustomStore({
                            key: "Pono", // Ensure this key is unique
                            load: function () {
                                console.log("Fetching Purchase Grid Data for GsCode:", gscode);
                                return $.getJSON("/api/StockInventory/GetPurchaseGridData", { gscode: gscode })
                                    .then(data => {
                                        console.log("Purchase Grid Data Loaded", data);
                                        return data;
                                    })
                                             .fail(() => {
                        alert("Failed to load purchase grid data.");
                    });
                                  
                            }
                        });

                        PurchaseGridInstance.option("dataSource", dataStore);
                    }
                </script>


            </div>
        </div>


