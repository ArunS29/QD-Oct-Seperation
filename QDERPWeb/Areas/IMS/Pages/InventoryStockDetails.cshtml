                <script>

                    $(function () {
                        $("#DetailedDescriptionLabel").text(formatMessage("Detailed Description : "));
                        $("#ItemSizeMeasurements").text(formatMessage("Item Size & Measurements : "));
                        $("#ItemCostPriceDetails").text(formatMessage("Item Cost & Price Details : "));
                        $("#DetailedDescriptionInArabic").text(formatMessage("Detailed Description: (in Arabic) "));
                        $("#EnteredByLabel").text(formatMessage("Entered By : "));
                        $("#ModifiedByLabel").text(formatMessage("Modified By : "));
                        $("#ModifiedOnLabel").text(formatMessage("Modified On : "));
                        $("#AvgCostPriceLabel").text(formatMessage("Avg Cost Price :"));
                        $("#EnteredOnLabel").text(formatMessage("Entered On : "));
                        $("#ItemDiscontinuedLabel").text(formatMessage("Item Discontinued : "));
                    });

                    $(function () {
                        $("#ItemAttributes").dxTextBox({
                            text: formatMessage("Item Attributes"),
                            readOnly: true,
                            onContentReady: function (e) {
                                $(e.element).addClass("dx-textbox-heading");
                            }
                        });
                    });
                    function UnitOfMeasure() {
                        const url = `/${tenantName}/IMS/UnitOfMeasure`;
                        const title = "";
                        openModal(url, title);
                    }


