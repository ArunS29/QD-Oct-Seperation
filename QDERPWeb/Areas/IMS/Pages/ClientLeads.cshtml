<script>
        function updateClientEntryCounts(data) {
        let totalClients = 0;
        let todayClients = 0;

        const today = new Date().toISOString().split('T')[0]; // Format: YYYY-MM-DD

        if (Array.isArray(data)) {
            totalClients = data.length;

            todayClients = data.filter(item => {
                if (!item.CreatedDate) return false;

                const itemDate = new Date(item.CreatedDate).toISOString().split('T')[0];
                return itemDate === today;
            }).length;
        }

        // Update the DOM
        const todayEl = document.getElementById("creditToday");
        const totalEl = document.getElementById("creditTotal");

        if (todayEl) todayEl.textContent = todayClients.toLocaleString();
        if (totalEl) totalEl.textContent = totalClients.toLocaleString();
    }

        function onStatusCardReady(e) {
        const gridInstance = e.component;
        const dataSource = gridInstance.getDataSource();
        const gridId = e.element.attr("id");

        if (!dataSource || !gridId) return;

        const items = gridInstance.option("dataSource");

        const handleData = (data) => {
            if (gridId === "dataGrid") {
                updateStatusTabCounts(data);     // For tab counters
                updateClientEntryCounts(data);   // ✅ For total & today client count
            } else {
                updatewithtaxAmount(data);       // For amount card
                updateTaxAmounts(data);          // For tax card
                updateVoucherCounts(data);       // (if any)
            }
        };

        if (Array.isArray(items)) {
            handleData(items);
        } else {
            dataSource.load().done(handleData);
        }
    }
    function startVoucherSlide() {
                    let currentSlide = 0;
                    const slides = document.querySelectorAll('.voucher-slide1');

                    setInterval(() => {
                        slides[currentSlide].classList.remove('active');
                        currentSlide = (currentSlide + 1) % slides.length;
                        slides[currentSlide].classList.add('active');
                    }, 2000);
                }
                let currentSlideIndex = 0;
                const slides = document.querySelectorAll('.voucher-slide1');

                setInterval(() => {
                    slides[currentSlideIndex].classList.remove('active');

                    currentSlideIndex = (currentSlideIndex + 1) % slides.length;

                    slides[currentSlideIndex].classList.add('active');
                }, 2000);
