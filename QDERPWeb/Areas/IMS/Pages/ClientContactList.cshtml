<div class="formContainer">
    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("clientCode")
                .Value("")
                .Label(new JS("formatMessage('Client Code')"))
                .Width("100%")
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg")
                .ReadOnly(true))

        </div>
        <div class="form-field" style="margin:7px;">
                @(Html.DevExtreme().TextBox()
                                .ID("clientHidden")
                                .Width("91%")
                                .Value("-1")
                                .ReadOnly(true)
                                .Label("")
                                .LabelMode(EditorLabelMode.Floating)
                                .ElementAttr(new { @class = "white-bg" }))
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("txtclientName")
                .Value("")
                .Width("100%")
                .Label(new JS("formatMessage('Client Name')"))
                .LabelMode(EditorLabelMode.Floating)

                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("font") // built-in person icon

                .Type(ButtonType.Normal)
                )


        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("contactPerson")
                .Value("")
                 .Label(new JS("formatMessage('Contact Person')"))
                .LabelMode(EditorLabelMode.Floating)
                .Width("100%")
                .ElementAttr("class", "white-bg")
                        .ValidationRules(r => r.AddRequired().Message("Contact Person is required.")))
            @(Html.DevExtreme().Button()
                .Icon("user") // built-in person icon

                .Type(ButtonType.Normal)
                )

        </div>
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("title")
                .Value("")
                .Width("100%")
               .Label(new JS("formatMessage('Title')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("card") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("division")
                .Value("")
                .Width("100%")
               .Label(new JS("formatMessage('Division / Branch')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("folder") // built-in person icon

                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("location")
                .Value("")
                .Width("100%")
                .Label(new JS("formatMessage('Location')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("map") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("mobile1")
                .Value("")
                .Width("100%")
                .Label(new JS("formatMessage('Mobile Number (1)')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg")
                        .InputAttr(new { onkeypress = "return event.charCode >= 48 && event.charCode <= 57", type = "text", maxlength = "15" }))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("phone1")
                .Value("")
                .Width("100%")
                  .Label(new JS("formatMessage('Phone No. (1)')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg")
                        .InputAttr(new { onkeypress = "return event.charCode >= 48 && event.charCode <= 57", type = "text", maxlength = "15" }))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("mobile2")
                .Width("100%")
                 .Label(new JS("formatMessage('Mobile Number (2)')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg")
                        .InputAttr(new { onkeypress = "return event.charCode >= 48 && event.charCode <= 57", type = "text", maxlength = "15" }))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("phone2")
                .Value("")
                .Width("100%")
                .Label(new JS("formatMessage('Phone No. (2)')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg")
                        .InputAttr(new { onkeypress = "return event.charCode >= 48 && event.charCode <= 57", type = "text", maxlength = "15" }))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("fax")
                .Value("")
                .Label("Fax No")
                        .Label(new JS("formatMessage('Fax No')"))
                .Width("100%")
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("print") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("email")
                .Value("")
                .Width("100%")
                        .ValidationRules(value => value.AddEmail().Message(new JS("formatMessage('Please Enter the Valid Email Address')")))
                        .Label(new JS("formatMessage('Email')"))
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("email") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>
    <div class="footer-fixed">
        @(Html.DevExtreme().Button()
            .ID("btnSave")
             .Text(new JS("formatMessage('Save')"))
            .Icon("save")
            .Type(ButtonType.Success)
            .OnClick("saveOrUpdateClientList")
                .ElementAttr(new { @class = "dx-button-custom btn-save" })
            )

        @(Html.DevExtreme().Button()
            .ID("btnDelete")
            .Text(new JS("formatMessage('Delete')"))
            .Type(ButtonType.Danger)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("trash")
                .ElementAttr(new { @class = "dx-button-custom btn-delete" })
            )

        @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text(new JS("formatMessage('Back')"))
            .Icon("arrowleft")
            .Type(ButtonType.Default)
            .OnClick("Goback")
            .StylingMode(ButtonStylingMode.Outlined)
                .ElementAttr(new { @class = "dx-button-custom btn-back" })
                )
    </div>



</div>


<script>
    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);

        // Extract and clean parameters safely
        const clientContactSlNo = (urlParams.get("ClientContactSlNo") || "").split(/[?&]/)[0];
        const clientCode = (urlParams.get("clientCode") || "").split(/[?&]/)[0];
        const clientName = (urlParams.get("clientName") || "").split(/[?&]/)[0];
        // alert("clientContactSlNo"+clientContactSlNo);
        //alert("clientCode"+clientCode);
        // alert("clientName"+clientName);


        // Bind hidden and visible values
        $("#clientHidden").dxTextBox("instance").option("value", clientContactSlNo);
        $("#clientCode").dxTextBox("instance").option("value", clientCode);
        $("#txtclientName").dxTextBox("instance").option("value", clientName);

        // If editing existing contact
        if (clientContactSlNo) {
            bindClientContactData(clientContactSlNo);
            $("#btnSave").dxButton("instance").option("text", "Update");
        }
    });

    function bindClientContactData(clientContactSlNo) {

        $.ajax({
            url: `/api/ClientContactList/GetContactBySlNo?clientContactSlNo=${clientContactSlNo}`,
            type: 'GET',
            success: function (data) {
                console.log("getdatasss:", data);
                if (data) {
                    $("#clientHidden").dxTextBox("instance").option("value", data.ClientContactSlNo); // hidden field
                    $("#clientCode").dxTextBox("instance").option("value", data.ClientCode);
                    $("#contactPerson").dxTextBox("instance").option("value", data.ContactPerson);
                    $("#title").dxTextBox("instance").option("value", data.ContactPersonTitle);
                    $("#division").dxTextBox("instance").option("value", data.ContactDivision);
                    $("#location").dxTextBox("instance").option("value", data.ContactLocation);
                    $("#mobile1").dxTextBox("instance").option("value", data.ContactMobile1);
                    $("#phone1").dxTextBox("instance").option("value", data.ContactPhone1);
                    $("#mobile2").dxTextBox("instance").option("value", data.ContactMobile2);
                    $("#phone2").dxTextBox("instance").option("value", data.ContactPhone2);
                    $("#fax").dxTextBox("instance").option("value", data.ContactFaxNo);
                    $("#email").dxTextBox("instance").option("value", data.ContactEmail);
                }
            },
            error: function (xhr, status, error) {
                DevExpress.ui.notify("Error loading contact data", "error", 3000);
            }
        });
    }


    $(function () {
        $("#ClientContactList").dxTextBox({
            text: formatMessage("Client Contact List"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    function saveOrUpdateClientList() {
    const contactPersonInstance = $("#contactPerson").dxTextBox("instance");
    const validator = $("#contactPerson").dxValidator("instance");

    const validationResult = validator.validate();

    if (!validationResult.isValid) {
        return; // stop execution if validation fails
    }

    const clientContactSlNo = $("#clientHidden").dxTextBox("instance").option("value");
    const data = {
        ClientCode: $("#clientCode").dxTextBox("instance").option("value"),
        ClientName: $("#txtclientName").dxTextBox("instance").option("value"),
        ContactPerson: contactPersonInstance.option("value"),
        ContactPersonTitle: $("#title").dxTextBox("instance").option("value"),
        ContactDivision: $("#division").dxTextBox("instance").option("value"),
        ContactLocation: $("#location").dxTextBox("instance").option("value"),
        ContactMobile1: $("#mobile1").dxTextBox("instance").option("value"),
        ContactPhone1: $("#phone1").dxTextBox("instance").option("value"),
        ContactMobile2: $("#mobile2").dxTextBox("instance").option("value"),
        ContactPhone2: $("#phone2").dxTextBox("instance").option("value"),
        ContactFaxNo: $("#fax").dxTextBox("instance").option("value"),
        ContactEmail: $("#email").dxTextBox("instance").option("value")
    };

    if (clientContactSlNo) {
        data.ClientContactSlNo = clientContactSlNo;
    }

        $.ajax({
            url: '/api/ClientContactList/SaveOrUpdateClientContact', // use the API endpoint for save or update
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                if (res.success) {
                    DevExpress.ui.notify(res.message, "success", 3000);
                    // Set new or updated ID back to the hidden field
                    $("#clientHidden").dxTextBox("instance").option("value", res.lastClientContactSlNo);

                    // Refresh parent DataGrid with fresh data
                    if (window.parent && typeof window.parent.loadContactListGrid === "function") {
                        const clientCode = $("#clientCode").dxTextBox("instance").option("value");
                        if (clientCode) {
                            window.parent.loadContactListGrid(clientCode);
                        }
                    }



                    // Change button text to "Update" if needed
                    $("#saveClientListButton").dxButton("instance").option("text", "Update");

                } else {
                    DevExpress.ui.notify(res.message, "error", 3000);
                }
            },
            error: function (err) {
                DevExpress.ui.notify("Save or update failed: " + err.responseText, "error", 3000);
            }
        });
    }


    $("#btnDelete").on("click", function (e) {
        e.preventDefault();
        onDeleteButtonClick();
    });
    function onDeleteButtonClick(e) {
        var ClientContactSlNo = $("#clientHidden").dxTextBox("instance").option("value");

        if (!ClientContactSlNo) {
            DevExpress.ui.notify("Please enter or select a Journal Entry to delete.", "warning", 3000);
            return;
        }

        $.ajax({
            url: "/api/ClientContactList/DeleteClientCategory",
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(ClientContactSlNo), // 👈 plain string
            success: function (response) {
                DevExpress.ui.notify(response.message, 'success', 3000);
                setTimeout(function () {
                    location.reload();
                }, 1000);
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                DevExpress.ui.notify(msg, 'error', 3000);
            }
        });
    }
    function Goback() {
        window.parent.closeModal();
    }

</script>