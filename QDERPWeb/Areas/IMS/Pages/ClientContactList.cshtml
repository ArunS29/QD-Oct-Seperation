@page
@model QD.ERP.Web.Areas.IMS.Pages.ClientContactListModel
@{
    ViewData["Title"] = "Client Contact List";
}

<style>

    .mainContainer {
        width: 100%;
        color: black;
        padding: 10px;
        border-radius: 6px;
    }


    .form-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 10px;
    }

    .form-field {
        flex: 1;
        margin-top: 20px;
        margin-left: 10px;
    }

    .form-header {
        padding: 10px;
        text-align: center;
        margin-top: 50px;
    }

    .white-bg .dx-icon {
        font-size: 20px; /* Adjust the icon size */
        color: #007bff; /* Change the icon color */
    }

    .dx-field-item-label-text > {
        color: black !important;
    }


    .white-bg .dx-texteditor-input {
        background-color: white !important;
    }

    .toolbar-buttons {
        margin: 50px;
        display: flex;
        justify-content: flex-start; /* or center, or space-between */
        gap: 20px; /* space between buttons */
        margin-top: 20px;
        padding: 10px 0;
    }

    .dx-button {
        font-weight: bold;
        font-size: 10px;
    }\
    .black-text .dx-button-text {
        color: black !important;
    }

</style>

<div class="formContainer">
    <div class="form-header"> <i class="dx-icon dx-icon-user" style=" font-size: 40px; "></i>Client Contact List</div>

    <div class="form-row">
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("clientCode")
                .Value("")
                .Label("Client Code")
                .Width("100%")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))

        </div>
        <div class="form-field">
            @(Html.DevExtreme().TextBox()
                .ID("clientHidden")
                .Width("100%")
                .Value("-1")
                .ReadOnly(true)
                .Label(" ")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("clientName")
                .Value("")
                .Width("100%")
                .Label("Client Name")
                .LabelMode(EditorLabelMode.Outside)

                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("font") // built-in person icon

                .Type(ButtonType.Normal)
                )


        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("contactPerson")
                .Value("")
                .Label("Contact Person")
                .LabelMode(EditorLabelMode.Outside)
                .Width("100%")
                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("user") // built-in person icon

                .Type(ButtonType.Normal)
                )

        </div>
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("title")
                .Value("")
                .Width("100%")
                .Label("Title")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("card") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("division")
                .Value("")
                .Width("100%")
                .Label("Division / Branch")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("folder") // built-in person icon

                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("location")
                .Value("")
                .Width("100%")
                .Label("Location")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg")
                )
            @(Html.DevExtreme().Button()
                .Icon("map") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("mobile1")
                .Value("")
                .Width("100%")
                .Label("Mobile Number (1)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("phone1")
                .Value("")
                .Width("100%")
                .Label("Phone No. (1)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("mobile2")
                .Width("100%")
                .Label("Mobile Number (2)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex; align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("phone2")
                .Value("")
                .Width("100%")
                .Label("Phone No. (2)")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("tel") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>

    <div class="form-row">
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("fax")
                .Value("")
                .Label("Fax No")
                .Width("100%")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("print") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
        <div class="form-field" style="display: flex;  align-items: end;">
            @(Html.DevExtreme().TextBox()
                .ID("email")
                .Value("")
                .Width("100%")
                .Label("Email")
                .LabelMode(EditorLabelMode.Outside)
                .ElementAttr("class", "white-bg"))
            @(Html.DevExtreme().Button()
                .Icon("email") // built-in person icon
                .Type(ButtonType.Normal)
                )
        </div>
    </div>
    <div class="d-flex justify-content-start" style="gap: 10px; margin-bottom: 20px;">
        @(Html.DevExtreme().Button()
            .ID("btnSave")
            .Text("Save")
            .Icon("save")
            .Type(ButtonType.Success)
            .OnClick("saveClientList")
            .ElementAttr("class", "black-text")
            )

        @(Html.DevExtreme().Button()
            .ID("btnDelete")
            .Text(new JS("formatMessage('Delete')"))
            .Type(ButtonType.Danger)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("trash")
            .ElementAttr("class", "black-text")
            )

        @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text(new JS("formatMessage('Back')"))
            .Icon("arrowleft")
            .Type(ButtonType.Default)
            .StylingMode(ButtonStylingMode.Outlined)
            .ElementAttr("class", "black-text")
            )
    </div>



</div>


<script>
    function saveClientList() {
        const data = {
            ClientCode: $("#clientCode").dxTextBox("instance").option("value"),
           // ClientContactSlNo: $("#clientHidden").dxTextBox("instance").option("value"),
            ClientName: $("#clientName").dxTextBox("instance").option("value"),
            ContactPerson: $("#contactPerson").dxTextBox("instance").option("value"),
            ContactPersonTitle: $("#title").dxTextBox("instance").option("value"),
              ContactDivision: $("#division").dxTextBox("instance").option("value"),
              ContactLocation: $("#location").dxTextBox("instance").option("value"),
            ContactMobile1: $("#mobile1").dxTextBox("instance").option("value"),
            ContactPhone1: $("#phone1").dxTextBox("instance").option("value"),
            ContactMobile2: $("#mobile2").dxTextBox("instance").option("value"),
            ContactPhone2: $("#phone2").dxTextBox("instance").option("value"),
            ContactFaxNo: $("#fax").dxTextBox("instance").option("value"),
            ContactEmail: $("#email").dxTextBox("instance").option("value"),

        };

        $.ajax({
            url: '/api/ClientContactList/SaveClientCategory',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (res) {
                DevExpress.ui.notify(res.message, "success", 2000);
                // setTimeout(() => window.location.reload(), 2000);
            },
            error: function (err) {
                DevExpress.ui.notify("Save failed: " + err.responseText, "error", 3000);
            }
        });
    }
    $("#btnDelete").on("click", function (e) {
        e.preventDefault();
        onDeleteButtonClick();
    });
    function onDeleteButtonClick(e) {
        var ClientCode = $("#clientCode").dxTextBox("instance").option("value");

        if (!ClientCode) {
            DevExpress.ui.notify("Please enter or select a Journal Entry to delete.", "warning", 3000);
            return;
        }

        $.ajax({
            url: "/api/ClientContactList/DeleteClientCategory",
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(ClientCode), // 👈 plain string
            success: function (response) {
                DevExpress.ui.notify(response.message, 'success', 3000);
                setTimeout(function () {
                    location.reload();
                }, 1000);
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || xhr.responseText || 'Error occurred while deleting.';
                DevExpress.ui.notify(msg, 'error', 3000);
            }
        });
    }

</script>