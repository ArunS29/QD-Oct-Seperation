@page
@model QD.ERP.Web.Areas.IMS.Pages.ClientContactListModel
@{
    ViewData["Title"] = "Client Contact List";
}

<style>

    .mainContainer {
        width: 100%;
        color: black;
        border-radius: 6px;
    }


    .form-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }

    .form-field {
        flex: 1;
        margin-top: 1px;
        margin-left: 5px;
    }

    .form-header {
        padding: 10px;
        text-align: center;
        margin-top: 50px;
    }

    .white-bg .dx-icon {
        font-size: 20px; /* Adjust the icon size */
        color: #007bff; /* Change the icon color */
    }

    .dx-field-item-label-text > {
        color: black !important;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }


    .white-bg .dx-texteditor-input {
        background-color: white !important;
    }

    .toolbar-buttons {
        margin: 50px;
        display: flex;
        justify-content: flex-start; /* or center, or space-between */
        gap: 20px; /* space between buttons */
        margin-top: 20px;
        padding: 10px 0;
    }

    .dx-button {
        font-weight: bold;
        font-size: 10px;
    }

    .black-text .dx-button-text {
        color: black !important;
    }


</style>

