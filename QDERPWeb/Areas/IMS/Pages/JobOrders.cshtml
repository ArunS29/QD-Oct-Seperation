				subColumns.AddFor(m => m.JobOrderDate).Caption(" Job Order Date").Alignment(HorizontalAlignment.Center).Format("dd-MMM-yyyy").Visible(true);
				subColumns.AddFor(m => m.JobOrderDescription).Caption(" Job Order Description").Alignment(HorizontalAlignment.Center).Visible(true);
				
				subColumns.AddFor(m => m.JobOrderStatus).Caption("Job Order Status Name ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.JobOrderType).Caption("Job Order Type ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.TagNo).Caption("TagNo ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Size).Caption("Size ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Class).Caption("Class ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Operator).Caption("Operator ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Materials).Caption("Materials ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Qty).Caption("Qty ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Make).Caption("Make ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.ModelNo).Caption("Model No ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.ItemSlNo).Caption("Item Sl No ").Alignment(HorizontalAlignment.Center).Visible(true);
				@* subColumns.AddFor(m => m.ItemSlNo).Caption("Item Sl No ").Alignment(HorizontalAlignment.Center).Visible(true); *@
				subColumns.AddFor(m => m.WorkOrderNo).Caption("  Work Order No ").Alignment(HorizontalAlignment.Center).Visible(true);




			});
		})
		.Height("60vh") // Fixed height for the grid
		.ColumnAutoWidth(true)
		.Width("98%")
		.WordWrapEnabled(true)
		.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.Paging(p => p.PageSize(10)) // Set desired page size (e.g., 10 rows per page)
		.Pager(pager =>
		{
			pager.ShowPageSizeSelector(true);
			pager.AllowedPageSizes(new[] { 5, 10, 20, 50 });
			pager.ShowNavigationButtons(true);
			pager.Visible(true);
		})

		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.ShowRowLines(true)
		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.OnContextMenuPreparing("onContextMenuPreparing")
		.StateStoring(stateStoring =>
		{
			stateStoring
			.Enabled(true)
			.Type(StateStoringType.LocalStorage)
			.StorageKey("gridContainerState");
		})
		.OnInitialized("function(e) { loadGridState(); }")
		)
</div>
