	function receiveItemPartially() {
		if (!selectedRowData) {
			DevExpress.ui.notify("Please select a row to receive.", "warning", 2000);
			return;
		}

		const Pono = selectedRowData.Pono;

		// Step 1: Check if PO is approved
		$.get(`/api/PurchaseOrders/CheckIfApproved?pono=${encodeURIComponent(Pono)}`, function (approvalResult) {
			if (!approvalResult.success) {
				DevExpress.ui.notify(approvalResult.message || "Could not check approval status.", "error", 2000);
				return;
			}

			if (!approvalResult.isApproved) {
				DevExpress.ui.notify("Please approve the Purchase Order before receiving.", "warning", 3000);
				return;
			}

			// Step 2: Check PO status
			$.get(`/api/PurchaseOrders/GetOrderStatus?pono=${encodeURIComponent(Pono)}`, function (result) {
				if (!result.success) {
					DevExpress.ui.notify(result.message || "Could not check order status.", "error", 2000);
					return;
				}

				const status = (result.orderStatus || "").toLowerCase();

				if (status === "fully received") {
					DevExpress.ui.dialog.alert(
						"This PO is already fully received. You cannot receive anymore.",
						"Information"
					);
					return;
				}

				// Step 3: Proceed with partial receipt
				$.ajax({
					url: "/api/PurchaseOrders/ReceiveItemPartially",
					method: "POST",
					contentType: "application/json",
					data: JSON.stringify({ Pono: Pono }),
					success: function (result) {
						if (result.success) {
							DevExpress.ui.notify(result.message, "success", 2000);
							window.location.href = `/${tenantName}/IMS/MaterialReceiptFromSupplier?ReceiptNo=${encodeURIComponent(result.receiptNoteNo)}&PurchaseOrderNo=${encodeURIComponent(Pono)}&mode=edit`;
						} else {
							DevExpress.ui.notify(result.message, "error", 2000);
						}

						const grid = $("#dataGrid").dxDataGrid("instance");
						if (grid) grid.refresh();
					},
					error: function (xhr) {
						DevExpress.ui.notify("Error creating material receipt", "error", 2000);
						console.error(xhr);
					}
				});
			});
		});
	}


	function receiveItemFully() {

		if (!selectedRowData) {
			DevExpress.ui.notify("Please select a row to receive.", "warning", 2000);
			return;
		}

		const Pono = selectedRowData.Pono;

		// Step 1: Check if PO is approved
		$.get(`/api/PurchaseOrders/CheckIfApproved?pono=${encodeURIComponent(Pono)}`, function (approvalResult) {
			if (!approvalResult.success) {
				DevExpress.ui.notify(approvalResult.message || "Could not check approval status.", "error", 2000);
				return;
			}

			if (!approvalResult.isApproved) {
				DevExpress.ui.notify("Please approve the Purchase Order before receiving.", "warning", 3000);
				return;
			}

			// Step 2: Check Order Status if approved
			$.get(`/api/PurchaseOrders/GetOrderStatus?pono=${encodeURIComponent(Pono)}`, function (statusResult) {
				if (!statusResult.success) {
					DevExpress.ui.notify(statusResult.message || "Could not check order status.", "error", 2000);
					return;
				}

				const status = (statusResult.orderStatus || "").toLowerCase();

				if (status === "partially received") {
					DevExpress.ui.notify("This PO is already partially received. You cannot create a full PO.", "warning", 3000);
					return;
				}

				if (status === "fully received") {
					DevExpress.ui.notify("This PO is already fully received. You cannot receive again.", "warning", 3000);
					return;
				}

				// Step 3: Confirm and proceed to receive
				DevExpress.ui.dialog.confirm(
					`Are you sure you want to create a Material Receipt for PO: <b>${Pono}</b>?`,
					"Confirm Material Receipt"
				).done(function (dialogResult) {
					if (dialogResult) {
						$.ajax({
							url: "/api/PurchaseOrders/ReceiveItemFully",
							method: "POST",
							contentType: "application/json",
							data: JSON.stringify({ Pono: Pono }),
