        const rowIndex = $(this).index();
        selectedRowData = dataGrid.getVisibleRows()[rowIndex].data;

        // Calculate menu position
        const menuHeight = contextMenu.outerHeight() || 220; // fallback height
        const menuWidth = contextMenu.outerWidth() || 200;   // fallback width
        const pageY = e.pageY;
        const pageX = e.pageX;
        const windowHeight = $(window).height();
        const windowWidth = $(window).width();

        let top = pageY;
        let left = pageX;

        // If not enough space below, show above
        if (pageY + menuHeight > windowHeight) {
            top = pageY - menuHeight;
            if (top < 0) top = 0; // Don't go off the top
        }

        // If not enough space to the right, shift left
        if (pageX + menuWidth > windowWidth) {
            left = windowWidth - menuWidth - 10;
            if (left < 0) left = 0;
        }

        contextMenu.css({ top: top + "px", left: left + "px" }).show();
    });

