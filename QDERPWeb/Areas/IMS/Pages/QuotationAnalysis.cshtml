<script>
      

    function onGridRowClick(e) {
        var selectedData = e.data;
        if (selectedData) {
            var dropDownBox = $("#requestSelectBox").dxDropDownBox("instance");
            dropDownBox.option("value", selectedData.Mprno); // Set value
            dropDownBox.close(); // Close the popup
        }
    }

    function onViewAnalysisClick() {
        const mprno = $("#requestSelectBox").dxDropDownBox("instance").option("value");
        if (!mprno) {
            DevExpress.ui.notify("Please select a request/enquiry first.", "warning", 2000);
            return;
        }

        loadPivotGridData(mprno);
    }

    let pivotGridInstance = null;
    window._lastClickedCheckboxCell = null;
    let currentPivotRawData = [];


        function loadPivotGridData(mprno) {
        $.ajax({
            url: '/api/QuotationAnalysis/GetQuotationAnalysisPvg?mprno=' + mprno,
            type: 'GET',
            success: function (data) {
                console.log("API Data: ", data);

                currentPivotRawData = data; // Save raw data for export

                pivotGridInstance = $("#pivotGridContainerId").dxPivotGrid({
                    dataSource: {
                        fields: [
                            { dataField: "Gsdescrpition", area: "row", caption: formatMessage("Item Description") },
                            { dataField: "QuotedQuantity", area: "row", caption: formatMessage("Quantity") },
                            { dataField: "SupplierName", area: "column", caption: formatMessage("Supplier Name") },
                            { dataField: "UnitPrice", area: "data", caption: formatMessage("Unit Price"), summaryType: "avg", format: { type: "fixedPoint", precision: 2 } },
                            { dataField: "ItemDiscount", area: "data", caption: formatMessage("Discount"), summaryType: "sum", format: "fixedPoint" },
                            { dataField: "LineTotalBeforeTax", area: "data", caption: formatMessage("Net Total"), summaryType: "sum", format: { type: "fixedPoint", precision: 2 } },
                            { dataField: "IsWonForPo", area: "data", caption: formatMessage("IsWonForPo"), summaryType: "max", dataType: "boolean" },
                             { dataField: "Mprno", visible: false },
{ dataField: "Gscode", visible: false },
{ dataField: "RfqchildSlNo", visible: false }


                        ],
                        store: {
                            type: "array",
                            data: data
                        }
                    },
                    allowSortingBySummary: true,
                    allowSorting: true,
                    allowFiltering: true,
                    allowExpandAll: true,
                    showBorders: true,
                    showColumnHeaders: true,
                    showColumnTotals: false,
                    showRowTotals: false,
                    showColumnGrandTotals: false,
                    showRowGrandTotals: false,
                    wordWrapEnabled: true,
                    height: 500,
                    fieldChooser: {
                        enabled: true,
                        allowSearch: true,
                        layout: 0
                    },
                    fieldPanel: {
                        visible: true,
                        allowFieldDragging: true,
                        showColumnFields: true,
                        showDataFields: true,
                        showFilterFields: true,
                        showRowFields: true
                    },
                    loadPanel: { enabled: true },
onCellPrepared: function (e) {
    // Apply background color condition (optional)
    if (e.area === "data" && e.cell?.dataType !== "boolean") {
        if (e.cell.value > 10000) {
            $(e.cellElement).css("background-color", "#e6ffe6"); // light green
        }
    }

    // Render checkbox only for boolean field
    if (e.area === "data" && e.cell?.dataType === "boolean") {
        const $cell = $(e.cellElement);
        $cell.empty(); // clear existing content

        const isChecked = !!e.cell.value;

        const checkbox = $("<input>")
            .attr("type", "checkbox")
            .prop("checked", isChecked)
      .on("change", function () {
    if ($(this).prop("checked")) {
        const $row = $cell.closest("tr");
        $row.find('input[type="checkbox"]').not(this).prop("checked", false);
    }

    const rowPath = e.cell?.rowPath || [];
    const columnPath = e.cell?.columnPath || [];

    console.log("RowPath:", rowPath);
    console.log("ColumnPath:", columnPath);

    const match = currentPivotRawData.find(item =>
        item.Gsdescrpition === rowPath[0] &&
        item.SupplierName === columnPath[0] &&
        (rowPath.length === 1 || item.QuotedQuantity == rowPath[1])
    );

    if (match) {
        console.log("✅ MATCH FOUND");
        console.log("MPR No:", match.Mprno);
        console.log("RFQChildSlNo:", match.RfqchildSlNo);
        console.log("GSCode:", match.Gscode);
        openSelectionDetailsPopup(match.Mprno, match.RfqchildSlNo, match.Gscode);
    } else {
        DevExpress.ui.notify("Required data not found for selection.", "error", 2000);
        console.warn("❌ No match for row/column path", rowPath, columnPath);
    }
});


        $cell.append(checkbox);
    }
}


}).dxPivotGrid("instance");
            },
            error: function (xhr, status, error) {
                console.error("Error fetching data: ", error);
            }
        });
    }





     $(function () {
                    $("#SelectRequest").text(
                         formatMessage("Select a Request / Enquiry:"));
            });

    

    function printFun(){
        console.log("Pivot");
        exportPivotToPdf(pivotGridInstance,currentPivotRawData);
    }

    $(document).ready(function () {
		console.log('Start permission handling AccountingLedgers');
		// Form ID
		var formId = "frm60115QuotationAnalysis";

		// Call the API to get permissions
		$.ajax({	
			url: '/api/Permissions/GetAccessDetails?formId=' + formId,
			type: 'GET',
			contentType: 'application/json',
			success: function (response) {
				console.log("API Response:", response); // Log the API response

				if (response.success && response.permissions) {
					// Default visibility and enable status for buttons
					var controlStates = {
						"ddButtonLayout": { "Visible": false, "Enabled": false },
						"rowHeightProperties": { "Visible": false, "Enabled": false },
						"btnPrint": { "Visible": false, "Enabled": false },
						"btnToggleSearch": { "Visible": false, "Enabled": false },
						"btntoggleGroupPanel": { "Visible": false, "Enabled": false },
                        "btnToggleHeaderFilter": { "Visible": false, "Enabled": false },
						"btnColumnChooser": { "Visible": false, "Enabled": false },
						"btnCreateQuotations": { "Visible": false, "Enabled": false },
						"viewAnalysisButton": { "Visible": false, "Enabled": false },
					};

					// Check for full access
					var fullAccess = response.permissions.find(p =>
						p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
					);

					if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
						// Grant full access: make all controls visible and enabled
						Object.keys(controlStates).forEach(key => {
							controlStates[key] = { "Visible": true, "Enabled": true };
						});
					} else {
						// Update states based on specific permissions for each control
						Object.keys(controlStates).forEach(key => {
							var controlPermission = response.permissions.find(p =>
								p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
							);
							if (controlPermission) {
								controlStates[key] = {
									"Visible": controlPermission.ItemVisible || false,
									"Enabled": controlPermission.ItemEnabled || false
								};
							}
						});
					}

					console.log("Control States:", controlStates);
					Object.keys(controlStates).forEach(key => {
						var button = document.getElementById(key);
						if (button) {
							// Handle visibility
							button.style.display = controlStates[key].Visible ? "inline-block" : "none";
							// Handle enable/disable state
							button.disabled = !controlStates[key].Enabled;
							console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
						} else {
							console.warn(`Button with ID "${key}" not found in the DOM.`);
						}
					});
				} else {
					console.warn("Failed to fetch permissions or no permissions available.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching permissions:", error);
				alert('An error occurred while fetching permissions. Please try again.');
			}
		});

		console.log('End permission handling');
	});


function openSelectionDetailsPopup(mprno, rfqchildSlNo, gsCode, $cellToUpdate) {
    const tenantName = window.tenantName || "defaultTenant";
    
    // Construct the modal URL with query parameters
    const url = `/${tenantName}/IMS/ReasonForQA?mprno=${encodeURIComponent(mprno)}&rfqchildSlNo=${encodeURIComponent(rfqchildSlNo)}&gsCode=${encodeURIComponent(gsCode)}`;

    // Save the cell reference in a global variable if needed for later updates
    window._cellToUpdate = $cellToUpdate;

    // Open the modal using a custom openModal function (you should have this implemented elsewhere)
    openModal(url,"Selection Details", "70%","33%");
}

//layout for pivot grid
    // Save as default layout
    function setDefaultLayoutClick() {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        const form = $('#formId').val();

        if (!pivotGrid) {
            DevExpress.ui.notify("Grid not found", "error", 2000);
            return;
        }

        // Include expanded paths in state
        const state = pivotGrid.getDataSource().state();
        state.rowExpandedPaths = pivotGrid.getDataSource()._descriptions.rows.expandedPaths || [];
        state.columnExpandedPaths = pivotGrid.getDataSource()._descriptions.columns.expandedPaths || [];

        const layoutXml = objectToXml(state, "Layout");

        $.ajax({
            url: '/api/Utility/SaveLayout',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                layout: layoutXml,
                form: form
            }),
            success: function () {
                DevExpress.ui.notify("Default layout saved", "success", 2000);
            },
            error: function (xhr) {
                console.error("SaveLayout error:", xhr.responseText);
                DevExpress.ui.notify("Error while saving layout", "error", 2000);
            }
        });
    }

    // Reset layout
    function resetLayoutClick() {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        const form = $('#formId').val();

        $.ajax({
            url: '/api/Utility/SaveLayout',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                layout: null,
                form: form
            }),
            success: function () {
                DevExpress.ui.notify("Layout reset successful", "success", 2000);
                pivotGrid.getDataSource().state({});
            },
            error: function (xhr) {
                console.error(xhr.responseText);
                DevExpress.ui.notify("Error while resetting layout", "error", 2000);
            }
        });
    }

    // Download layout
    function saveLayoutClick() {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        const state = pivotGrid.getDataSource().state();
        state.rowExpandedPaths = pivotGrid.getDataSource()._descriptions.rows.expandedPaths || [];
        state.columnExpandedPaths = pivotGrid.getDataSource()._descriptions.columns.expandedPaths || [];

        const layoutXml = objectToXml(state, "Layout");

        const blob = new Blob([layoutXml], { type: "application/xml" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "pivotgrid-layout.xml";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    // Open layout from file
    function openLayoutClick() {
        const input = document.createElement("input");
        input.type = "file";
        input.accept = "application/xml";

        input.addEventListener("change", function (event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const parser = new DOMParser();
                    const xmlDoc = parser.parseFromString(e.target.result, "application/xml");
                    let layoutObj = xmlToObject(xmlDoc.documentElement);
                    layoutObj = JSON.parse(JSON.stringify(layoutObj));
                    const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
                    pivotGrid.getDataSource().state(layoutObj);
                } catch (error) {
                    DevExpress.ui.notify("Invalid layout file!", "error", 600);
                }
            };

            reader.readAsText(file);
        });

        input.click();
    }

    // Load default layout on page ready
    $(document).ready(function () {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid({
            // ... your pivot grid config
            onContentReady: function (e) {
                // Load layout only once on first render
                if (!e.component.__layoutLoaded) {
                    loadGridState();
                    e.component.__layoutLoaded = true;
                }
            }
        }).dxPivotGrid("instance");
    });

    function loadGridState() {
        const form = $('#formId').val();

        $.ajax({
            url: `/api/Utility/LoadLayout`,
            method: 'GET',
            data: { form: form },
            success: function (response) {
                const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");

                if (response) {
                    try {
                        const parser = new DOMParser();
                        const xmlDoc = parser.parseFromString(response, "application/xml");
                        let layoutObj = xmlToObject(xmlDoc.documentElement);

                        if (layoutObj.fields && Array.isArray(layoutObj.fields)) {
                            layoutObj.fields.sort((a, b) => {
                                const aIndex = Number(a.areaIndex ?? 0);
                                const bIndex = Number(b.areaIndex ?? 0);
                                return aIndex - bIndex;
                            });
                        }

                        pivotGrid.getDataSource().state(layoutObj);
                    } catch (error) {
                        console.error("Error parsing layout XML:", error);
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading grid layout:", error);
            }
        });
    }


$("#btnCreateQuotations").dxButton({
    text: "Create Quotation",
    type: "success",
    onClick: function () {

        const tenantName = window.tenantName || "defaultTenant";

        // 1️⃣ Safely get pivot grid data from the raw array you saved
        if (!currentPivotRawData || currentPivotRawData.length === 0) {
            DevExpress.ui.notify("No data loaded in PivotGrid.", "error", 3000);
            return;
        }

        // 2️⃣ Instead of ds.items(), use the raw array
        // Filter the ones that are actually 'selected' if you have a flag for that
        const mprNos = currentPivotRawData
            .map(row => row.Mprno) // field name must match backend data
            .filter(Boolean);

        if (!mprNos.length) {
            DevExpress.ui.notify("No MPR numbers selected.", "error", 3000);
            return;
        }

        // 3️⃣ Confirmation dialog
        DevExpress.ui.dialog.confirm(
            "You are about to create new Quotation. Are you sure you want to continue?",
            "Confirm"
        ).done(function (confirmed) {
            if (!confirmed) return;

            // 4️⃣ Call backend API
            $.ajax({
                url: "/api/QuotationAnalysis/CreateQuotationsFromMprList",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify({ mprNos: mprNos }),
                success: function (result) {
                    if (result.success) {
                        DevExpress.ui.notify(result.message, "success", 2000);
                       window.location.href = `/${tenantName}/IMS/AddNewQuotation?QuoteNo=${encodeURIComponent(result.quotationNo)}`;
                    } else {
                        DevExpress.ui.notify(result.message || "Failed to create Quotation.", "error", 3000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Server error while creating Quotation.", "error", 3000);
                }
            });
        });
    }
});


