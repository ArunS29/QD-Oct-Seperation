<div id="pivotGridContainer" style="margin-top: 20px;"></div>

<script>
      

     function onGridRowClick(e) {
        var selectedData = e.data;
        if (selectedData) {
            var dropDownBox = $("#requestSelectBox").dxDropDownBox("instance");
            dropDownBox.option("value", selectedData.Mprno); // Set value
            dropDownBox.close(); // Close the popup
        }
    }

    const emptyData = []; // No data initially
    $(function () {
        $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                store: {
                    type: "array",
                    data: emptyData
                },
                fields: [
                    // area: null → enables drag/drop via field panel
                    { dataField: "SupplierName", caption: "Supplier Name", area: "row" },
                    { dataField: "ItemDescription", caption: "Item Description", area: "column" },
                    { dataField: "Quantity", caption: "Quantity", area: "data", dataType: "number", summaryType: "sum" }
                ]
            },

            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            showColumnTotals: true,
            showRowTotals: true,
            showColumnGrandTotals: true,
            showRowGrandTotals: true,
            wordWrapEnabled: true,
            height: 500,

            // Same fieldChooser settings
            fieldChooser: {
                enabled: true,
                allowSearch: true,
                layout: 0, // Tree layout like your second example
                applyChangesMode: "instantly"
            },

            // Enable the drag-and-drop panel
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true,
                showRowFields: true
            },

            loadPanel: { enabled: true }
        }).dxPivotGrid("instance");
    });





</script>