@page
@model QD.ERP.Web.Areas.IMS.Pages.QuotationAnalysisModel
@{
}
<style>
    .mainContainer{
        width:100%;

    }

    .limited-footer .btn-container:not(:has(#ddButtonLayout,#btnToggleSearch,#btnPrint,#btntoggleGroupPanel,#btnColumnChooser,#btnCreateQuotations)) {
        display: none !important
    }

</style>
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("InventoryModuleFooter")
    </div>
</div>
<div style="padding: 10px; background-color: #c7cfdd;">
    <div style="display: flex; align-items: center; gap: 10px;">
        <label style="font-weight: bold;">Select a Request / Enquiry:</label>

        @(Html.DevExtreme().DropDownBox()
            .ID("requestSelectBox")
            .DataSource(d => d.WebApi()
            .Controller("QuotationAnalysis")
            .LoadAction("GetQuotationAnalysis")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("Mprno")
            )
            .ValueExpr("Mprno")        // <--- This will be used as value
            .DisplayExpr("Mprno")      // <--- This will be shown in the DropDownBox input
            .Placeholder("Select request")
            .ShowClearButton(true)
            .Width(300)
            .DropDownOptions(o => o.Width(1000)) // ✅ Width of the popup dropdown
    
            .ContentTemplate(@<text>
            @(Html.DevExtreme().DataGrid()
            .ID("dropDownGrid")
            .DataSource(d => d.WebApi()
            .Controller("QuotationAnalysis")
            .LoadAction("GetQuotationAnalysis")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("Mprno")
            )      
            .HoverStateEnabled(true)
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual)) // or "standard"
            .Height(250)
            .Selection(s => s.Mode(SelectionMode.Single))
            .RowAlternationEnabled(true)
            .OnRowClick("onGridRowClick")

            .FilterRow(f => f.Visible(true))
            .AllowColumnResizing(true)
            .AllowColumnReordering(true)
            @* .GroupPanel(g => g.Visible(true)) *@///COLUMN GROUP IN TOP OF THE GRID

            .Columns(columns => {
            columns.Add().DataField("Mprno").Caption("Request/Enquiry.No");
            columns.Add().DataField("NoOfRfqissued").Caption("No of RFQ Issued");
            columns.Add().DataField("ClientName").Caption("Client Name or Store Name");
            columns.Add().DataField("Mprdate").Caption("MPR Date").DataType(GridColumnDataType.Date). Format("dd-MMM-yyyy");
            columns.Add().DataField("RequestedBy").Caption("Requested By");

            })

            )

        </text>)
            )

        @(Html.DevExtreme().Button()
            .ID("viewAnalysisButton")
            .Text("View Analysis")
            .Icon("chart")
            .Type(ButtonType.Normal)
            .OnClick("onViewAnalysisClick")
            )
    </div>

    <div id="pivotGridContainerId" style="margin-top: 20px;"></div>
</div>

<script>
      

    function onGridRowClick(e) {
        var selectedData = e.data;
        if (selectedData) {
            var dropDownBox = $("#requestSelectBox").dxDropDownBox("instance");
            dropDownBox.option("value", selectedData.Mprno); // Set value
            dropDownBox.close(); // Close the popup
        }
    }

    function onViewAnalysisClick() {
        const mprno = $("#requestSelectBox").dxDropDownBox("instance").option("value");
        if (!mprno) {
            DevExpress.ui.notify("Please select a request/enquiry first.", "warning", 2000);
            return;
        }

        loadPivotGridData(mprno);
    }


    function loadPivotGridData(mprno) {
        $.ajax({
            url: '/api/QuotationAnalysis/GetQuotationAnalysisPvg?mprno='+mprno,
            type: 'GET',
            success: function (data) {
                console.log("API Data: ", data);
        $("#pivotGridContainerId").dxPivotGrid({
        dataSource: {
            fields: [
                { dataField: "Gsdescrpition", area: "row", caption: "Item Description" }, // ← rows
                { dataField: "QuotedQuantity", area: "row", caption: "Quantity"},
                { dataField: "SupplierName", area: "column", caption: "Supplier Name" }, // ← columns
                { dataField: "UnitPrice", area: "data", caption: "Unit Price", summaryType: "avg", format: "currency" },
                { dataField: "ItemDiscount", area: "data", caption: "Discount", summaryType: "sum", format: "fixedPoint" },
                { dataField: "LineTotalBeforeTax", area: "data", caption: "Net Total", summaryType: "sum", format: "currency" },
                { dataField: "IsWonForPo", area: "data", caption: "Won", summaryType: "max", dataType: "boolean" }
            ],
            store: {
                type: "array",
                data: data
            }
        },
        allowSortingBySummary: true,
        allowSorting: true,
        allowFiltering: true,
        allowExpandAll: true,
        showBorders: true,
        showColumnHeaders: true,
        showColumnTotals: false,
        showRowTotals: false,
        showColumnGrandTotals: false,
        showRowGrandTotals: false,
        wordWrapEnabled: true,
        height: 500,
        fieldChooser: {
            enabled: true,
            allowSearch: true,
            layout: 0
        },
        fieldPanel: {
            visible: true,
            allowFieldDragging: true,
            showColumnFields: true,
            showDataFields: true,
            showFilterFields: true,
            showRowFields: true
        },
        loadPanel: { enabled: true },
        onCellPrepared: function (e) {
            if (e.area === "data" && e.cell?.dataType === "boolean") {
                const $cell = $(e.cellElement);
                $cell.empty();

                const isChecked = !!e.cell.value;
                const checkbox = $("<input>")
                    .attr("type", "checkbox")
                    .prop("checked", isChecked)
                    .on("change", function () {
                        // If this checkbox was checked
                        if ($(this).prop("checked")) {
                            // Uncheck all other checkboxes in the same row
                            const rowIndex = e.rowIndex;
                            const $row = $cell.closest("tr");

                            $row.find('input[type="checkbox"]').not(this).prop("checked", false);
                        }
                    });
                    $cell.append(checkbox);
                }
            }


        });
    },

    error: function (xhr, status, error) {
        console.error("Error fetching data: ", error);
    }
    });
    }


</script>