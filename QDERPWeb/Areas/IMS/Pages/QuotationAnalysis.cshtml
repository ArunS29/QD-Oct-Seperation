@page
@model QD.ERP.Web.Areas.IMS.Pages.QuotationAnalysisModel
@{
}
@{
    var dropDownData = new[] {
        new { ID = 1, Request = "Req001", Enquiry = "ENQ001", Client = "Client A", Supplier = "Supplier X" },
        new { ID = 2, Request = "Req002", Enquiry = "ENQ002", Client = "Client B", Supplier = "Supplier Y" },
        new { ID = 3, Request = "Req003", Enquiry = "ENQ003", Client = "Client C", Supplier = "Supplier Z" }
    };
}

<style>
    .mainContainer{
        width:100%;

    }

    .limited-footer .btn-container:not(:has(#ddButtonLayout,#btnToggleSearch,#btnPrint,#btntoggleGroupPanel,#btnColumnChooser,#btnCreateQuotations)) {
        display: none !important
    }

</style>
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("InventoryModuleFooter")
    </div>
</div>
<div style="padding: 10px; background-color: #c7cfdd;">
    <div style="display: flex; align-items: center; gap: 10px;">
        <label style="font-weight: bold;">Select a Request / Enquiry:</label>

        @(Html.DevExtreme().DropDownBox()
            .ID("requestSelectBox")
            .DataSource(d => d.WebApi()
            .Controller("QuotationAnalysis")
            .LoadAction("GetQuotationAnalysis")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("Mprno")
            )
            .ValueExpr("Mprno")        // <--- This will be used as value
            .DisplayExpr("Mprno")      // <--- This will be shown in the DropDownBox input
            .Placeholder("Select request")
            .ShowClearButton(true)
            .Width(300)
            .DropDownOptions(o => o.Width(1000)) // ✅ Width of the popup dropdown
    
            .ContentTemplate(@<text>
            @(Html.DevExtreme().DataGrid()
            .ID("dropDownGrid")
            .DataSource(d => d.WebApi()
            .Controller("QuotationAnalysis")
            .LoadAction("GetQuotationAnalysis")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("Mprno")
            )      
            .HoverStateEnabled(true)
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual)) // or "standard"
            .Height(250)
            .Selection(s => s.Mode(SelectionMode.Single))
            .RowAlternationEnabled(true)
            .OnRowClick("onGridRowClick")

            .FilterRow(f => f.Visible(true))
            .AllowColumnResizing(true)
            .AllowColumnReordering(true)
            @* .GroupPanel(g => g.Visible(true)) *@///COLUMN GROUP IN TOP OF THE GRID

            .Columns(columns => {
            columns.Add().DataField("Mprno").Caption("Request/Enquiry.No");
            columns.Add().DataField("NoOfRfqissued").Caption("No of RFQ Issued");
            columns.Add().DataField("ClientName").Caption("Client Name or Store Name");
            columns.Add().DataField("Mprdate").Caption("MPR Date").DataType(GridColumnDataType.Date). Format("dd-MMM-yyyy");
            columns.Add().DataField("RequestedBy").Caption("Requested By");

            })

            )

        </text>)
            )

        @(Html.DevExtreme().Button()
            .ID("viewAnalysisButton")
            .Text("View Analysis")
            .Icon("chart")
            .Type(ButtonType.Normal)
            )
    </div>
    <!-- ✅ Add this container for PivotGrid -->
</div>
