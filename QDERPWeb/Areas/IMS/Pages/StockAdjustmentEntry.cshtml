        var dataGridInstance;

        var rowData = []; // Store the grid data

        $(function () {

            dataGridInstance = $("#itemGrid").dxDataGrid({

                dataSource: rowData,

                keyExpr: "SNo",

                columns: [

                    {

                        dataField: "SNo",

                        caption: "#",

                        width: 100,

                        allowEditing: false

                    },

                    {

                        dataField: "ItemCode",

                        caption: formatMessage('Item Code'),

                        width: 200

                    },
                    {
			dataField: "Gscode",
			caption: formatMessage('Description'),
			width: 550,
			cssClass: "center-header",
			sortOrder: "asc",
			cellTemplate: function (container, options) {
				if (!options.value) {
					$("<span>").text("").appendTo(container);
					return;
				}
				$.getJSON(`/api/VATModule/GetGoodsAndServiceByCode?code=${options.value}`)
					.done(function (data) {
						$("<span>").text(data.GSDescrpition).appendTo(container);
					});
			},
			editCellTemplate: function (cellElement, cellInfo) {
				let $container = $("<div>").css({
					display: "flex",
					alignItems: "center",
					gap: "5px",
					width: "100%"
				}).appendTo(cellElement);

				let selectedItemData = {};

				const dropdownStore = new DevExpress.data.CustomStore({
				key: "GSCode",
				load: function (loadOptions) {
					const pageNumber = Math.floor((loadOptions.skip || 0) / loadOptions.take) + 1;
					const pageSize = loadOptions.take;
						return $.getJSON("/api/VATModule/GetGoodsAndServices", {
						pageNumber,
						pageSize
					}).then(response => {
						return {
							data: response.data,
							totalCount: response.totalCount
						};
					});
					//}


				},
				byKey: function (key) {
				}
			});
			const $dropDownBox = $("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({
				valueExpr: "GSCode",
				displayExpr: "GSDescrpition",
				value: cellInfo.value,
				dataSource: dropdownStore,
				searchEnabled: true,
				searchExpr: "GSDescrpition",
				searchMode: "contains",
				minSearchLength: 3,
				deferRendering: true,
				dropDownOptions: { width: 800 },
				
				contentTemplate: function (e) {
					return $("<div>").dxDataGrid({
						dataSource: e.component.getDataSource(),
						keyExpr: "GSCode",
						height: 300,
						remoteOperations: true,
						scrolling: { mode: "virtual" },
						paging: { enabled: true, pageSize: 15 },
						pager: {
							visible: true,
							showPageSizeSelector: true,
							allowedPageSizes: [10, 15, 30],
							showInfo: true
						},
						searchPanel: {
							visible: true,
							width: 240,
							placeholder: "Search..."
						},
						selection: { mode: "single" },
						columns: [
							{ dataField: "GSCode", caption: formatMessage("Code"), width: 80 },
							{ dataField: "GSDescrpition", caption: formatMessage("Description"), width: 200 },
							{ dataField: "GsdescriptionAr", caption: formatMessage("Arabic Description"), width: 200 },
							{ dataField: "ItemPartNo", caption: formatMessage("Item Part No"), width: 100 },
							{ dataField: "CostPrice", caption: formatMessage("Cost Price"), width: 100 },
							{ dataField: "GSSellingRate", caption: formatMessage("Selling Rate"), width: 100 },
							{ dataField: "ReorderQty", caption: formatMessage("Current Qty"), width: 100 }
						],
						onSelectionChanged: function (selectedItems) {
							const selectedItem = selectedItems.selectedRowsData[0];
							if (!selectedItem) return;

							selectedItemData = selectedItem;
							cellInfo.setValue(selectedItem.GSCode);
							const dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
							const rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);

							if (rowIndex !== -1) {
								dataGrid.cellValue(rowIndex, "Item Code", selectedItem.GSCode || selectedItem.Gscode || "");
								dataGrid.cellValue(rowIndex, "Cost Price", selectedItem.CostPrice || 0);
								dataGrid.cellValue(rowIndex, "GSSellingRate", selectedItem.GSSellingRate || 0);
								dataGrid.cellValue(rowIndex, "Qty", 1);
								dataGrid.cellValue(rowIndex, "VAT%", "15%");
								dataGrid.cellValue(rowIndex, "UnitRateMethod", selectedItem.GsuoM);

								ItemNo = selectedItem.GSCode;
								Gsdescrpition = selectedItem.GSDescrpition;
								GsdescriptionAr = selectedItem.GsdescriptionAr;
								ItemPartNo = selectedItem.ItemPartNo;
								CostPrice = selectedItem.CostPrice;
								GssellingRate = selectedItem.GSSellingRate;
								ReorderQty = selectedItem.ReorderQty;
								UnitOfMeasure = selectedItem.GsuoM;
							}

							e.component.close();
						}
					});
				}
			});
			const $actionButtonWrapper = $("<div>").addClass("action-buttons-container").appendTo($container);
				$("<div>").dxButton({
				icon: "plus",
