        editCellTemplate: function (cellElement, cellInfo) {
            let dataGrid = $("#itemGrid").dxDataGrid("instance");
            let rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);

            console.log("Editing rowIndex:", rowIndex);

            // Get MinQty and MaxQty from row data
            let rowData = dataGrid.getDataSource().items()[rowIndex] || {};
            let maxQty = rowData.MaxQty || 0;
            let minQty = rowData.MinQty || 0;

            console.log("Row Data:", rowData);
            console.log("MinQty:", minQty, "MaxQty:", maxQty);

            // Create the NumberBox editor
              $("<div>").dxNumberBox({
        value: cellInfo.value || 0,
        showSpinButtons: true,
        onValueChanged: function (e) {
            let newQty = e.value;

            // Fetch updated min/max dynamically
            let rowIndex = cellInfo.row.rowIndex;
            let updatedRow = dataGrid.getDataSource().items()[rowIndex] || {};
            let maxQty = updatedRow.MaxQty || 0;
            let minQty = updatedRow.MinQty || 0;

            console.log("Validation Check -> MinQty:", minQty, "MaxQty:", maxQty, "NewQty:", newQty);

            if (newQty > maxQty) {
                console.warn(`Qty ${newQty} exceeds MaxQty ${maxQty}`);

                DevExpress.ui.dialog.confirm(
                    `The quantity you entered (${newQty}) exceeds the allowed maximum (${maxQty}).`,
                    "Quantity Limit Exceeded"
                ).done(function () {
                    // Optional: you can add confirmation handling here if needed
                });

                setTimeout(() => {
                    DevExpress.ui.notify(`The maximum allowed quantity is ${maxQty}.`, "error", 3000);
                }, 100); // Give it slight delay to ensure render

                e.component.option("value", maxQty);
                cellInfo.setValue(maxQty);
            } else if (newQty < minQty) {
                console.warn(`Qty ${newQty} is below MinQty ${minQty}`);

                setTimeout(() => {
                    DevExpress.ui.notify(`The minimum allowed quantity is ${minQty}.`, "error", 3000);
                }, 100);

                e.component.option("value", minQty);
                cellInfo.setValue(minQty);
            } else {
                console.log(`Qty ${newQty} is valid`);
                cellInfo.setValue(newQty);
            }
        }
    }).appendTo(cellElement);

