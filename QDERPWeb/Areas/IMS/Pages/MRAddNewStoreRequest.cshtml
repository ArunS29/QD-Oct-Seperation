	function navigateToLedgerAccountForm() {
		// make sure this is available in the view
		const url = `/${tenantName}/VAT/VATDatabaseSignatories`;
		const title = "";
		openModal(url, title); // opens in modal instead of new window
	}

	let ItemNo = null, paymentmeanstypecode = null, amt = 0, accheadid = null, revaccheadid = null, InvoiceCurrencyExchangeId = null, TaxCurrencyExchangeId = null, branchcode = null, salespersoncode = null, companyid = null, SellerOtherIdtype = null,
		SignatoryID = null, ChkbySignatoryID = null, ApproedbySignatoryID = null, IsCurrent = "false", ExchangeRate = null;
	let dropDownInstance;
	let vatListInstance;

	
	let Approved=null;
	//View e-Invoice
	$(document).ready(function () {
		const urlParams = new URLSearchParams(window.location.search);
		const mprnos = urlParams.get('Mprno');
		const mprno = mprnos ? mprnos.split("?")[0] : null;
		getSalesPersonByUser();
		if (mprno) {
			// If Mprno is present, load client details
			loadClientDetails(mprno);
		} else {
			// If Mprno is not present and IsCurrent is not "true", generate a Autogenerate request number
			$.ajax({
				url: "/api/AddNewClientRequest/GetNewRequestNoApi",
				type: "GET",
				success: function (data) {
					console.log("Success:", data);

					const invoiceBox = $("#txtRequestNo").dxTextBox("instance");
					if (invoiceBox) {
						invoiceBox.option("value", data || "");
					} else {
						console.warn("Invoice TextBox not initialized.");
					}
				},
				error: function (xhr, status, error) {
					console.error("Error loading Payment Accounts:", error);
					DevExpress.ui.dialog.alert("Failed to load Rquest No details.", "Error");
				}
			});
		}
	});

	function loadClientDetails(mprno) {
	$.ajax({
		url: `/api/AddNewClientRequest/GetClientdataByCode?Mprno=${encodeURIComponent(mprno)}`,
		type: 'GET',
		dataType: 'json',
		success: function (response) {
			console.log("ClientDetails", response);

			if (response) {
				const Approved = response.IsApproved;

				if (Approved === true) {
					hideAllButtonsExcept([
						"btnPrint1",
						"ddButtonLayout",
						"btnBack",
						"btnAttach"
					]);
				}

				$("#btnSave").dxButton("instance").option("text", "Update");

				// Populate DevExtreme controls
				$('#txtRequestNo').dxTextBox("instance").option("value", response.Mprno);
				$("#InvoiceDueDate").dxDateBox("instance").option("value", response.Mprdate);
				$("#GetProjectDropDown").dxDropDownBox("instance").option("value", response.ClientCode);
				$('#txtContactName').dxTextBox("instance").option("value", response.RequestedBy);
				$('#txtReqEmail').dxTextBox("instance").option("value", response.RequesterContactEmail);
				$('#ContactNo').dxTextBox("instance").option("value", response.RequesterContact);
				$("#ddGetModeOfRequest").dxDropDownBox("instance").option("value", response.ModeOfRequest);
				$("#ddGetTypeOfRequest").dxDropDownBox("instance").option("value", response.TypeOfRequest);
				$("#ddGetSalesPerson").dxDropDownBox("instance").option("value", response.SalesPersonCode);
				$('#txtReferenceNo').dxTextBox("instance").option("value", response.ClientRefNo);
				$('#txtPurpose').dxTextBox("instance").option("value", response.PurposeOfRequest);
				$('#txtPriority').dxTextBox("instance").option("value", response.Priority);
				$('#txtCostCenter').dxTextBox("instance").option("value", response.CostCenterText);
				$("#txtExpectedDate").dxDateBox("instance").option("value", response.ExpectedDate);
				$("#ddGetTax").dxDropDownBox("instance").option("value", response.ExpectedVatrate);
				$("#txtRemarks").dxTextArea("instance").option("value", response.Remarks);
				$("#ddGetCompany").dxDropDownBox("instance").option("value", response.CompanyBranch);
				$("#ddGetEnquiry").dxDropDownBox("instance").option("value", response.PurchaseRequestStatusId);
				$("#ddGetInventoryGroup").dxDropDownBox("instance").option("value", response.InventoryMasterGroupId);
				$("#ddGetRequesstingUnit").dxDropDownBox("instance").option("value", response.ProjectSubUnitCode);
				$("#ddBitCls").dxDateBox("instance").option("value", response.BidClosingDate);
				$("#ddReminder").dxDateBox("instance").option("value", response.BidReminderOn);
				$('#txtClientProject').dxTextBox("instance").option("value", response.ClientProject);
				$("#ddPreparedby").dxDropDownBox("instance").option("value", response.RequestSignatory);
				$("#ddVerifiedby").dxDropDownBox("instance").option("value", response.MprverifiedSign);
				$("#ddApprovedby").dxDropDownBox("instance").option("value", response.MprapprovedSign);
				$("#ddRequestedBy").dxDropDownBox("instance").option("value", response.TypeOfMpr);
				$("#ddStoreCodeDropDown").dxDropDownBox("instance").option("value", response.StoreCode);

				// Load child grid data
				$.ajax({
					type: "GET",
					url: `/api/AddNewClientRequest/GetPurchaseRequestChildren?Mprno=${encodeURIComponent(mprno)}`,
					dataType: 'json',
					success: function (gridResponse) {
						console.log("Grid", gridResponse);

						const rowData = gridResponse.map((item, index) => ({
							SNo: index + 1,
							...item
						}));

						initializeDataGrid(rowData);
					},
					error: function (xhr, status, error) {
						console.error("Error fetching grid data:", error);
					}
				});
			} else {
				console.warn("No client details found in the response.");
			}
		},
		error: function (xhr, status, error) {
			console.error("Error fetching client details:", error);
		}
	});
}
	function getSalesPersonByUser() {
	$.ajax({
		type: "GET",
		url: "/api/AddNewClientRequest/GetSalesPersonByUser",
		success: function (data) {
			if (data && data.SalesPersonCode) {
					const salesPersonDropDown = $("#ddGetSalesPerson").dxDropDownBox("instance");
				if (salesPersonDropDown) {
						salesPersonDropDown.option("value", data.SalesPersonCode);
				}
			}
		},
		error: function (xhr) {
			console.log("SalesPerson fetch failed:", xhr.responseText);
		}
	});
}


	// Move the DataGrid configuration into a function for cleanliness
	function initializeDataGrid(rowData) {

		let grid = $("#B2BdataGrid").dxDataGrid({
			dataSource: rowData,
			keyExpr: "LineOrderNo",
