@page
@model QD.ERP.Web.Areas.IMS.Pages.StoreStockAvalibilitysModel
@{
}
<style>
    .mainContainer{
        width:100%;
    }

    .dx-button-text{
        color:black;
    }

</style>
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders

<div class="title">
    <div class="header-container">
        <div id="StoreStockAvalibility" class="no-border-title"></div>
    </div>
</div>


<div style=" padding: 10px; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; padding:20px;">
    <label id="Seletthestoretoissueitem" class="no-border-input" style="font-weight:100 bold; width: 220px; "></label>

    @(Html.DevExtreme().DropDownBox()
            .ID("storeSelectBox")
            .DisplayExpr("Name")
            .ValueExpr("ID")
            .Value(1)
            .Width(250))

    @(Html.DevExtreme().Button()
            .ID("prepareDeliveryNoteBtn")
            .Text("Prepare Delivery Note")
            .Icon("save")
            .Type(ButtonType.Default)
            .StylingMode(ButtonStylingMode.Contained))
</div>
<div style="padding:20px;">
    @(Html.DevExtreme().DataGrid()
        .ID("deliveryNoteGrid")
        .ShowBorders(true)
        .ColumnAutoWidth(true)
        .Height(350)
        .Selection(s => s.Mode(SelectionMode.Multiple).ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always))
        .Columns(columns =>
        {
            columns.Add().Type(GridCommandColumnType.Selection).Width(40);
            columns.Add().DataField("Service").Caption("Service");
            columns.Add().DataField("OrderID").Caption("Order ID");
            columns.Add().DataField("GSCode").Caption("GS Code");
            columns.Add().DataField("StockDescription").Caption("Stock Description");
            columns.Add().DataField("Unit").Caption("Unit");
            columns.Add().DataField("TotalOrderedQty").Caption("Total Ordered Qty");
            columns.Add().DataField("TotalIssdQty").Caption("Total Issd Qty");
            columns.Add().DataField("BalanceToDeliver").Caption("Balance To Deliver");
            columns.Add().DataField("CurrentQtyOrdered").Caption("Current Qty In Ordered Unit");
            columns.Add().DataField("AvailabilityStatus").Caption("Availability Status");
            columns.Add().DataField("DeliveringQuantity").Caption("Delivering Quantity");
        }))
</div>
<div id="pivotGridContainer" style="margin-top: 20px; padding:20px;"></div>

<script>



    const emptyData = []; // No data initially
    $(function () {
        $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                store: {
                    type: "array",
                    data: emptyData
                },
                fields: [
                    { dataField: "SupplierName", caption: "GS Code", area: "row" },
                    { dataField: "ItemDescription", caption: "GS Description", area: "column" },
                    { dataField: "Quantity", caption: "Oredered UOM", area: "data", dataType: "number", summaryType: "sum" },
                    { dataField: "Quantity", caption: "Oredered Qty", area: "data", dataType: "number", summaryType: "sum" },
                    { dataField: "Quantity", caption: "Issd Qty", area: "data", dataType: "number", summaryType: "sum" },
                    { dataField: "Quantity", caption: "Balance ", area: "data", dataType: "number", summaryType: "sum" }
                ]
            },

            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            showColumnTotals: true,
            showRowTotals: true,
            showColumnGrandTotals: true,
            showRowGrandTotals: true,
            wordWrapEnabled: true,
            height: 500,

            // Same fieldChooser settings
            fieldChooser: {
                enabled: true,
                allowSearch: true,
                layout: 0, // Tree layout like your second example
                applyChangesMode: "instantly"
            },

            // Enable the drag-and-drop panel
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true,
                showRowFields: true
            },

            loadPanel: { enabled: true }
        }).dxPivotGrid("instance");
    });



     $(function () {
        $("#StoreStockAvalibility").dxTextBox({
            text:formatMessage("Store Stock Avalibility"),
            readOnly: true,
            onContentReady: function(e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    $(function () {
            $("#Seletthestoretoissueitem").dxTextBox({
                text: formatMessage("Select the Store to Issue Items:"),
                readOnly: true

            });
         });
</script>