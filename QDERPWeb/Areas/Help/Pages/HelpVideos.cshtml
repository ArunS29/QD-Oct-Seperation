@page
@model Demo.Areas.Help.Pages.HelpVideosModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Help Videos</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
        }

        header {
            background-color: #4CAF50;
            color: white;
            padding: 15px;
            text-align: center;
        }

        #filter-container {
            padding: 20px;
            background-color: white;
            border-bottom: 1px solid #ddd;
        }

            #filter-container select, #filter-container input {
                padding: 10px;
                margin-right: 10px;
                border: 1px solid #ddd;
                border-radius: 5px;
                width:20%;
            }

        #videos-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            padding: 20px;
        }

        .video-card {
            background-color: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            margin: 10px;
            padding: 15px;
            width: 300px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s;
        }

            .video-card:hover {
                transform: scale(1.05);
            }

            .video-card iframe {
                width: 100%;
                height: 180px;
                border-radius: 5px;
            }

            .video-card h2 {
                font-size: 18px;
                margin: 10px 0;
            }

            .video-card p {
                font-size: 14px;
                color: #555;
            }

        .no-videos {
            text-align: center;
            font-size: 18px;
            color: #777;
            margin-top: 50px;
        }
    </style>
</head>
<body>
    <header>
        <h1>Help Videos</h1>
    </header>

    <div id="filter-container">
        <label for="sort-options">Sort by:</label>
        <select id="sort-options">
            <option value="title">Title</option>
            <option value="date">Date Added</option>
        </select>

        <label for="search-box">Search:</label>
        <input type="text" id="search-box" placeholder="Search by Title or Description...">
    </div>

    <div id="videos-container">
        <!-- Videos will be loaded dynamically -->
    </div>

    <script>
        $(document).ready(function () {
            const tenantName = window.location.pathname.split('/')[1];
            const urlParams = new URLSearchParams(window.location.search);
            const formName = urlParams.get('formName');

            if (!formName) {
                $("#videos-container").html("<p class='no-videos'>Please provide a form name.</p>");
                return;
            }

            function fetchVideos(sortBy = "title", searchQuery = "") {
                $.ajax({
                    url: `/api/HelpVideos/GetVideos?formName=${formName}`,
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        if (data.length === 0) {
                            $("#videos-container").html("<p class='no-videos'>No videos found for the given Form Name.</p>");
                        } else {
                            if (searchQuery) {
                                data = data.filter(video =>
                                    video.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                    video.description.toLowerCase().includes(searchQuery.toLowerCase())
                                );
                            }

                            if (sortBy === "title") {
                                data.sort((a, b) => a.title.localeCompare(b.title));
                            } else if (sortBy === "date") {
                                data.sort((a, b) => new Date(b.dateAdded) - new Date(a.dateAdded));
                            }

                            let content = "";
                            data.forEach(video => {
                                content += `
                                            <div class="video-card">
                                                <iframe
                                                    src="${video.videoUrl}"
                                                    frameborder="0"
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                    allowfullscreen>
                                                </iframe>
                                                <h2>${video.title}</h2>
                                                <p>${video.description}</p>
                                            </div>`;
                            });
                            $("#videos-container").html(content);
                        }
                    },
                    error: function () {
                        $("#videos-container").html("<p class='no-videos'>Error fetching videos. Please try again later.</p>");
                    }
                });
            }

            // Fetch videos on page load
            fetchVideos();

            // Apply filters on change
            $("#sort-options, #search-box").on("change keyup", function () {
                const sortBy = $("#sort-options").val();
                const searchQuery = $("#search-box").val();
                fetchVideos(sortBy, searchQuery);
            });
        });
    </script>
</body>
</html>
