@page
@model QD.ERP.Web.Areas.General.Pages.UserEntryLogModel
@{
}
<style>


	

	.mainContainer {
		width: 100%;
		overflow: hidden;
	}

	
</style>

<div class="title">
	<div class="header-container">
		<h2>User Entry Log</h2>
	</div>
</div>


<div class="Head">
	<div class="limited-footer">
		@await Html.PartialAsync("userfooter")
	</div>
</div>

<div class="dx-fieldset horizontal-container">
	@(Html.DevExtreme().DateBox()
		.ID("frmdateBox")
		.Label(new JS("formatMessage('Start Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) // First day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(2)
		)

	@(Html.DevExtreme().DateBox()
		.ID("todateBox")
		.Label(new JS("formatMessage('End Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(3)
		)


	@(Html.DevExtreme().DropDownButton()
		.ID("ddBtnShowRecord")
		.Text(new JS("formatMessage('Show Records')"))
		.Icon("smalliconslayout")
		.Width(180)
		.ElementAttr("class", "button-alignment-down")
		.TabIndex(4)
		.SplitButton(true)
.OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }") // MAIN button click
				.DropDownOptions(options => options.Width(230))
				.Items(items =>
				{
					items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").Option("color", "#4285F4").OnClick("function() { ddBtnShowRecords_click('range'); }");
					items.Add().Text(new JS("formatMessage('Today')")).Icon("event").Option("color", "#34A853").OnClick("function() { ddBtnShowRecords_click('today'); }");
					items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").Option("color", "#EA4335").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
					items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").Option("color", "#FBBC05").OnClick("function() { ddBtnShowRecords_click('week'); }");
					items.Add().Text(new JS("formatMessage('This Month Till Date')")).Option("color", "#AB47BC").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
					items.Add().Text(new JS("formatMessage('This Month (Full)')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
					items.Add().Text(new JS("formatMessage('This Year Till Date')")).Option("color", "#FF7043").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
					items.Add().Text(new JS("formatMessage('This Year (Full)')")).Option("color", "#4285F4").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
					items.Add().Text(new JS("formatMessage('Last Month')")).Option("color", "#FBBC05").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
					items.Add().Text(new JS("formatMessage('Last Year')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
				})
				.ItemTemplate(@<text>
            <div class="custom-dropdown-item" >
                  <div style="background-color:<%- color %>;height:90%" class="side-bar"></div>
                <div class="item-content">
                    <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                    <div>
                        <div class="item-title"><%- text %></div>
                    </div>
                </div>
            </div>
        </text>)
		)

</div>
<div class="dx-field ledgerResult">
	@(
			Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Tbl90116UserEntryLogSheet>()
			.ID("dataGrid")
			.RemoteOperations(false)
			.DataSource(new JS("[]"))
			.Columns(columns =>
			{
				columns.Add().Caption("Entry Log").Columns(subColumns =>
			{
				subColumns.AddFor(m => m.UserEntryLogNo).Caption("User Entry Log No").Alignment(HorizontalAlignment.Center).Visible(true);

				subColumns.AddFor(m => m.EntryLogFor).Caption(" Entry Log For").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.EntryLogDetails).Caption("Entry Log Details").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.LogCreatedOn).Caption("Log Created On").Alignment(HorizontalAlignment.Center).Visible(true).Format("dd-MMM-yyyy");
				subColumns.AddFor(m => m.LogCreatedBy).Caption("Log Created By ").Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.LogDocumentNo).Caption(" Log Document No").Alignment(HorizontalAlignment.Center).Visible(true);
				
			});
			})
		.Height(680) // Fixed height for the grid
		.ColumnAutoWidth(true)
		.Width("98%")
		.WordWrapEnabled(true)
		.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.Paging(p => p.Enabled(false))
		.Pager(pager => pager.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.ShowRowLines(true)


		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.StateStoring(stateStoring =>
		{
			stateStoring
			.Enabled(true)
			.Type(StateStoringType.LocalStorage)
			.StorageKey("gridContainerState");
		})
		.OnInitialized("function(e) { loadGridState(); }")
		)

	

</div>
<div id="invoiceErrorPopup"></div>

<script>
		
	function ddBtnShowRecords_click(duration) {
		 var frmDateBox = $("#frmdateBox").dxDateBox("instance");
			var toDateBox = $("#todateBox").dxDateBox("instance");
			var frmDate = new Date(frmDateBox.option("value"));
			var toDate = new Date(toDateBox.option("value"));
			var currentDate = new Date();
			switch (duration) {
				case 'today':
					frmDate = toDate = currentDate;
					break;
				case 'yesterday':
					var dateObj = new Date();
					// Subtract one day from current time
					dateObj.setDate(dateObj.getDate() - 1);
					frmDate = toDate = dateObj;
					break;
				case 'week':
					var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

					// Calculate the start of the week (Saturday)
					var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

					// Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
				frmDate = new Date(currentDate.setDate(startOfWeek)); // 7 days before Saturday
					toDate = new Date(currentDate.setDate(startOfWeek + 6));
					break;
				case 'tillmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = currentDate; //Today
					break;
				case 'fullmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
					break;
				case 'tillyear':
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = currentDate;// Today
					break;
					// Get the first and last day of the current year
					frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
					break;
				case 'lastyear':
					// Get the first and last day of the last year
					frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
					toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
					break;
				case 'lastmonth':
					// Get the first and last day of the current month
					frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
					toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
					break;
			}
				frmDate = frmDate.toISOString().split('T')[0];
	toDate = toDate.toISOString().split('T')[0];

				$.ajax({
		url: '/api/CompanyDetails/GetUserEntryLog',
		type: 'GET',
		data: {
			fromDate: frmDate,
			toDate: toDate
		},
		success: function (data) {
			console.log("Returned Data: ", data); // debug
			$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
		},
		error: function (xhr) {
			console.log("AJAX Error", xhr.responseText); // debug
			DevExpress.ui.notify("Error while loading data", "error", 2000);
		}
	});



	}

</script>