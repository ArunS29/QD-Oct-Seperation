@page
@model QD.ERP.Web.Areas.General.Pages.frm90108ChangePasswordModel
@using DevExtreme.AspNet.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<style>
    .password-page {
        background-color: #dbe2f0;
        height: 100vh;
        padding: 30px;
    }

    .password-container {
        display: flex;
        background-color: white;
        border: 1px solid #ccc;
        padding: 30px;
        border-radius: 8px;
    }

    .password-image {
        flex: 0 0 150px;
        padding-right: 20px;
    }

    .password-fields {
        flex: 1;
    }

    .passwordBtn.dx-button {
        background-color: #a49af7 !important;
        color: black !important;
        border-radius: 6px !important;
        margin-top: 10px !important;
        border: 1px solid black !important;
    }

    .passwordBtn .dx-button-content {
        color: black !important;
    }


    

    #passwordStrength {
        font-weight: bold;
        margin-top: 5px;
        transition: color 0.3s ease-in-out;
    }
</style>

<div style="justify-content: center;">
    <div id="changePasswordPopup"></div>
    

    <div class="password-container mt-3">
        <div class="password-image">
            <img src="@Url.Content("~/images/dicerol.gif")" alt="Keys" width="220" height="200">
        </div>
        <div class="password-fields">
            <label for="currentPassword">Current Password</label>
            @(Html.DevExtreme().TextBox()
                .ID("currentPassword")
                .Mode(TextBoxMode.Password)
                .Width("90%"))

            <label class="mt-3 d-block" for="newPassword">New Password</label>
            @(Html.DevExtreme().TextBox()
                        .ID("newPassword")
                        .Mode(TextBoxMode.Password)
                        .Placeholder("Enter password")
                        .OnFocusIn("showPasswordCondition")
                        .OnFocusOut("hidePasswordCondition")
                        .OnInput("validatePassword")
                        .Width("90%")
                        )
            <div id="password-condition" style="display: none; margin-top: 5px; font-size: 13px;">
                <span id="password-status-text">
                    Make sure it's at least 8 characters including a number, a lowercase letter, and first letter uppercase.
                </span>
            </div>

            <label class="mt-2 d-block" for="confirmPassword">Confirm Your New Password</label>
            @(Html.DevExtreme().TextBox()
                .ID("confirmPassword")
                .Mode(TextBoxMode.Password)
                .Width("90%"))

           
               <div>
                @(Html.DevExtreme().Button()
                    .ID("resetPasswordBtn")
                    .Text("Change Password")
                    .Icon("preferences")
                    .Type(ButtonType.Normal)
                    .OnClick("onResetPasswordClick")
                    .Width(200)
                    .ElementAttr(new
                    {
                        @class = "passwordBtn",
                        style = "background-color:#a49af7; color:black; border-radius:6px; margin-top:10px;"
                    }))

               </div>

        </div>
    </div>

    
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            fetch('/api/utility/CheckUserLevel')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('userLevel').innerText = data.userLevel;
                    } else {
                        document.getElementById('userLevel').innerText = "N/A";
                        console.warn("User level not available.");
                    }
                })
                .catch(error => {
                    document.getElementById('userLevel').innerText = "Error";
                    console.error("Error fetching user level:", error);
                });
        });

        var token = '@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken';

        function getPasswordStrength(password) {
            let score = 0;
            if (password.length >= 10) score++;
            if (/[A-Z]/.test(password)) score++;
            if (/[a-z]/.test(password)) score++;
            if (/\d/.test(password)) score++;
            if (/[$!%*?&]/.test(password)) score++;

            if (score <= 2) return { level: "Weak", color: "red" };
            if (score === 3 || score === 4) return { level: "Medium", color: "orange" };
            if (score === 5) return { level: "Strong", color: "green" };
            return { level: "Unknown", color: "gray" };
        }

         function showPasswordCondition() {
            document.getElementById("password-condition").style.display = "block";
        }

        function hidePasswordCondition() {
            document.getElementById("password-condition").style.display = "none";
        }

        function validatePassword(e) {
            var password = e.event.target.value;

            var isLongEnough = password.length >= 15;

            var hasNumber = /\d/.test(password);
            var hasLowercase = /[a-z]/.test(password);
            var firstIsUpper = password.length > 0 && password[0] === password[0].toUpperCase() && /[A-Z]/.test(password[0]);

            var isMediumValid = password.length >= 8 && hasNumber && hasLowercase && firstIsUpper;

            var isValid = isLongEnough || isMediumValid;

            var statusText = document.getElementById("password-status-text");

            statusText.style.color = isValid ? "green" : "red";
        }

        function onResetPasswordClick() {
            debugger;
            const currentPassword = $("#currentPassword").dxTextBox("instance").option("value");
            const newPassword = $("#newPassword").dxTextBox("instance").option("value");
            const confirmPassword = $("#confirmPassword").dxTextBox("instance").option("value");

            if (!currentPassword || !newPassword || !confirmPassword) {
                DevExpress.ui.notify("All fields are required.", "error", 2000);
                return;
            }

            if (newPassword !== confirmPassword) {
                DevExpress.ui.notify("New Password and Confirm Password do not match.", "error", 2000);
                return;
            }

            const isLongEnough = newPassword.length >= 15;
            const hasNumber = /\d/.test(newPassword);
            const hasLowercase = /[a-z]/.test(newPassword);
            const firstIsUpper = newPassword.length > 0 && newPassword[0] === newPassword[0].toUpperCase() && /[A-Z]/.test(newPassword[0]);
            const isMediumValid = newPassword.length >= 8 && hasNumber && hasLowercase && firstIsUpper;

            const isValidPassword = isLongEnough || isMediumValid;

            if (!isValidPassword) {
                DevExpress.ui.notify("Password must be at least 8 characters with a number, a lowercase letter, and first letter uppercase.", "error", 3000);
                return;
            }

            // First validate the current password
            $.ajax({
                url: "/api/CompanyDetails/ValidateCurrentPassword",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(currentPassword),
                success: function () {
                    // If success, continue with resetting the password
                    $.ajax({
                        url: `/api/CompanyDetails/ResetPassword?newPassword=${encodeURIComponent(newPassword)}`,
                        type: 'POST',
                        contentType: "application/json",
                        success: function (response) {
                            DevExpress.ui.notify(response, "success", 3000);
                        },
                        error: function (xhr) {
                            DevExpress.ui.notify("Failed to reset password: " + xhr.responseText, "error", 3000);
                        }
                    });
                },
                error: function (xhr) {
                    DevExpress.ui.notify("Current password is incorrect.", "error", 3000);
                }
            });
        }


    </script>
}
