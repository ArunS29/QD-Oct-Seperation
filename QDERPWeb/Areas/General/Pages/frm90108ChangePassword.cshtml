@page
@model QD.ERP.Web.Areas.General.Pages.frm90108ChangePasswordModel
@using DevExtreme.AspNet.Mvc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<style>
    .password-page {
        background-color: #dbe2f0;
        height: 100vh;
        padding: 30px;
    }

    .password-container {
        display: flex;
        background-color: white;
        border: 1px solid #ccc;
        padding: 30px;
        border-radius: 8px;
    }

    .password-image {
        flex: 0 0 150px;
        padding-right: 20px;
    }

    .password-fields {
        flex: 1;
    }

    .footer-bar {
        background: #1a4bc3;
        color: white;
        padding: 10px 20px;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: bold;
    }

    .change-password-btn {
        text-align: center;
        margin-top: 20px;
    }

    #passwordStrength {
        font-weight: bold;
        margin-top: 5px;
        transition: color 0.3s ease-in-out;
    }
</style>

<div class="password-page">
    <div class="d-flex justify-content-end">
        <h6><strong>Change User Password</strong></h6>
    </div>

    <div class="password-container mt-3">
        <div class="password-image">
            <img src="~/images/dice2.ico" alt="Keys" width="280" height="180">
        </div>
        <div class="password-fields">
            <label for="currentPassword"><strong><u>Type your current password:</u></strong></label>
            @(Html.DevExtreme().TextBox()
                .ID("currentPassword")
                .Mode(TextBoxMode.Password)
                .Width("60%"))

            <label class="mt-3 d-block" for="newPassword"><strong><u>Enter the new password you want to change…</u></strong></label>
            @(Html.DevExtreme().TextBox()
                .ID("newPassword")
                .Mode(TextBoxMode.Password)
                .Width("60%")
                .OnValueChanged("onNewPasswordChanged"))
            <div id="passwordStrength"></div>

            <label class="mt-2 d-block" for="confirmPassword"><strong><u>Confirm your new password:</u></strong></label>
            @(Html.DevExtreme().TextBox()
                .ID("confirmPassword")
                .Mode(TextBoxMode.Password)
                .Width("60%"))

            <div class="change-password-btn">
                @(Html.DevExtreme().Button()
                    .ID("resetPasswordBtn")
                    .Text("Change Password")
                    .Icon("preferences")
                    .Type(ButtonType.Normal)
                    .OnClick("onResetPasswordClick"))
            </div>
        </div>
    </div>

    <div class="footer-bar">
        <div>@Model.CurrentUserName</div>
        <div>
            <span class="me-3">User Name: @Model.CurrentUserName</span>
            <span class="me-3">User ID: @Model.CurrentUserId</span>
            <span class="me-3">Level: <span id="userLevel">Loading...</span></span>
            <span>@DateTime.Now.ToString("M/d/yyyy h:mm:ss tt")</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            fetch('/api/utility/CheckUserLevel')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('userLevel').innerText = data.userLevel;
                    } else {
                        document.getElementById('userLevel').innerText = "N/A";
                        console.warn("User level not available.");
                    }
                })
                .catch(error => {
                    document.getElementById('userLevel').innerText = "Error";
                    console.error("Error fetching user level:", error);
                });
        });

        var token = '@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken';

        function getPasswordStrength(password) {
            let score = 0;
            if (password.length >= 10) score++;
            if (/[A-Z]/.test(password)) score++;
            if (/[a-z]/.test(password)) score++;
            if (/\d/.test(password)) score++;
            if (/[$!%*?&]/.test(password)) score++;

            if (score <= 2) return { level: "Weak", color: "red" };
            if (score === 3 || score === 4) return { level: "Medium", color: "orange" };
            if (score === 5) return { level: "Strong", color: "green" };
            return { level: "Unknown", color: "gray" };
        }

        function onNewPasswordChanged(e) {
            const password = e.value;
            const strength = getPasswordStrength(password);
            const strengthDiv = document.getElementById("passwordStrength");
            strengthDiv.textContent = `Strength: ${strength.level}`;
            strengthDiv.style.color = strength.color;
        }

        function onResetPasswordClick() {
            const currentPassword = $("#currentPassword").dxTextBox("instance").option("value");
            const newPassword = $("#newPassword").dxTextBox("instance").option("value");
            const confirmPassword = $("#confirmPassword").dxTextBox("instance").option("value");

            if (!currentPassword || !newPassword || !confirmPassword) {
                DevExpress.ui.notify("All fields are required.", "error", 2000);
                return;
            }

            if (newPassword.length < 10) {
                DevExpress.ui.notify("New password must be at least 10 characters long.", "error", 2000);
                return;
            }
            if (newPassword !== confirmPassword) {
                DevExpress.ui.notify("New Password and Confirm Password do not match.", "error", 2000);
                return;
            }
            const strongPasswordRegex = /^(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[$!%*?&]).{10,}$/;
            if (!strongPasswordRegex.test(newPassword)) {
                DevExpress.ui.notify("Password must contain uppercase, lowercase, digit, and special character.", "error", 3000);
                return;
            }

            if (newPassword !== confirmPassword) {
                DevExpress.ui.notify("New Password and Confirm Password do not match.", "error", 2000);
                return;
            }

            $.ajax({
                url: '@Url.Page("frm90108ChangePassword", "ResetPassword")',
                type: 'POST',
                data: {
                    currentPassword: currentPassword,
                    newPassword: newPassword,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    DevExpress.ui.notify(response, "success", 3000);
                },
                error: function (xhr) {
                    DevExpress.ui.notify("Failed to reset password: " + xhr.responseText, "error", 3000);
                }
            });
        }
    </script>
}
