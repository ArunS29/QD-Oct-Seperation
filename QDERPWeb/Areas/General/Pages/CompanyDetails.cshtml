     /////////////////////
         let uploadedLogoBase64 = null;
     let uploadedSealBase64 = null;
     let uploadedLetterHeadBase64 = null;

     function triggerUpload(inputId) {
         const input = document.getElementById(inputId);
         if (input) {
             input.click();
         }
     }

     function uploadImage(type) {
         const input = document.getElementById(type === "logo" ? "CompanyLogoInput" : "CompanySealInput");
         const file = input.files[0];
         if (!file) return;

         const reader = new FileReader();
         reader.onload = function (e) {
             if (!e.target.result || !e.target.result.includes(',')) {
                 DevExpress.ui.notify("Invalid image format.", "error", 3000);
                 return;
             }

             const base64String = e.target.result.split(",")[1];

             if (type === "logo") {
                 uploadedLogoBase64 = base64String;
                 $("#CompanyLogoPreview").html(`<img src="data:image/png;base64,${base64String}" style="max-width:100%; height:auto;">`);
             } else {
                 uploadedSealBase64 = base64String;
                 $("#CompanySealPreview").html(`<img src="data:image/png;base64,${base64String}" style="max-width:100%; height:auto;">`);
             }

             DevExpress.ui.notify(`${type === "logo" ? "Logo" : "Seal"} ready to be saved.`, "info", 2000);
         };
         reader.readAsDataURL(file);
     }

         // New: Display image inside imgBox1 or default text
     function displayImage(base64) {
         const container = document.getElementById("imgBox1");
         if (base64) {
             container.innerHTML = `<img src="data:image/png;base64,${base64}" style="max-width:100%; height:100%; object-fit: contain;" />`;
         } else {
             container.innerHTML = "<span>No Image Data</span>";
         }
     }

     // Handle right click on imgBox1 div to open file selector
     function handleRightClick(event) {
         event.preventDefault(); // Prevent default context menu
         document.getElementById("imageInput").click();
     }

     // Handle file selection for imgBox1 image upload
     function handleFileUpload(event) {
         const file = event.target.files[0];
         if (!file) return;

         const reader = new FileReader();
         reader.onload = function (e) {
             if (!e.target.result || !e.target.result.includes(",")) {
                 DevExpress.ui.notify("Invalid image format.", "error", 3000);
                 return;
             }

             const base64String = e.target.result.split(",")[1];
             uploadedLetterHeadBase64 = base64String;  // assuming imgBox1 is for logo

             displayImage(uploadedLetterHeadBase64);
             DevExpress.ui.notify("Logo ready to be saved.", "info", 2000);
         };
         reader.readAsDataURL(file);
     }

