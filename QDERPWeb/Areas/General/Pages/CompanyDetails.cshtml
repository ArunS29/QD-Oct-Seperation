function setupLetterHeadEvents() {
    const $imgBox = $("#imgBox1");
    $imgBox.off("click").on("click", function (e) {
        if (e.target.id !== "deleteLetterHeadBtn") {
            document.getElementById("imageInput").click();
        }
    });
    $imgBox.off("touchstart").on("touchstart", function (e) {
        if (e.target.id !== "deleteLetterHeadBtn") {
            document.getElementById("imageInput").click();
        }
    });
    $imgBox.off("mouseenter mouseleave").on("mouseenter", function () {
        $("#deleteLetterHeadBtn").show();
    }).on("mouseleave", function () {
        $("#deleteLetterHeadBtn").hide();
    });
    $imgBox.off("touchend").on("touchend", function () {
        $("#deleteLetterHeadBtn").show();
        setTimeout(() => $("#deleteLetterHeadBtn").hide(), 2000);
    });
    $(document).off("click", "#deleteLetterHeadBtn").on("click", "#deleteLetterHeadBtn", function (e) {
        e.stopPropagation();
        uploadedLetterHeadBase64 = null;
        lastLoadedLetterHeadBase64 = null;
        renderLetterHeadImage();
        setupLetterHeadEvents();
        DevExpress.ui.notify("Letter Head image removed.", "info", 2000);
    });
}
function handleFileUpload(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function (e) {
        const base64String = e.target.result.split(",")[1];
        uploadedLetterHeadBase64 = base64String;
        lastLoadedLetterHeadBase64 = base64String;
        renderLetterHeadImage();
        setupLetterHeadEvents();
        DevExpress.ui.notify("Letter Head ready to be saved.", "info", 2000);
    };
    reader.readAsDataURL(file);
}
