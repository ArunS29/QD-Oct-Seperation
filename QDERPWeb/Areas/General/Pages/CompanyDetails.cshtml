    // Show menu on right-click
    $("#CompanyLogoPreview, #CompanySealPreview").on("contextmenu", function (e) {
        e.preventDefault();
        contextTarget = this;
        $("#customContextMenu").css({
            top: e.pageY + "px",
            left: e.pageX + "px"
        }).show();
    });

    // Hide menu on click elsewhere
    $(document).on("click", function () {
        $("#customContextMenu").hide();
    });

    // Handle menu actions
    $("#customContextMenu .ctx-item").on("click", function (e) {
        e.stopPropagation();
        const action = $(this).data("action");
        $("#customContextMenu").hide();

        if (!contextTarget) return;

        switch (action) {
            case "cut":
    const cutImg = $(contextTarget).find("img")[0];
    if (cutImg) {
        imageClipboard = cutImg.src;
        $(contextTarget).find("img").remove();
        // Clear the base64 variable
        if ($(contextTarget).is("#CompanyLogoPreview")) {
            uploadedLogoBase64 = null;
        } else if ($(contextTarget).is("#CompanySealPreview")) {
            uploadedSealBase64 = null;
        }
    }
    break;
           case "copy":
    const copyImg = $(contextTarget).find("img")[0];
    if (copyImg) {
        imageClipboard = copyImg.src;
        // Also update the base64 variable for saving
        if ($(contextTarget).is("#CompanyLogoPreview")) {
            uploadedLogoBase64 = copyImg.src.split(",")[1];
        } else if ($(contextTarget).is("#CompanySealPreview")) {
            uploadedSealBase64 = copyImg.src.split(",")[1];
        }
    }
    break;
           case "paste":
    if (imageClipboard) {
        $(contextTarget).html(`<img src="${imageClipboard}" style="max-width:100%; height:auto;">`);
        // Update the base64 variable for saving
        if ($(contextTarget).is("#CompanyLogoPreview")) {
            uploadedLogoBase64 = imageClipboard.split(",")[1]; // Remove "data:image/png;base64,"
        } else if ($(contextTarget).is("#CompanySealPreview")) {
            uploadedSealBase64 = imageClipboard.split(",")[1];
        }
    }
    break;
           case "delete":
    $(contextTarget).find("img").remove();
    if ($(contextTarget).is("#CompanyLogoPreview")) {
        uploadedLogoBase64 = null;
    } else if ($(contextTarget).is("#CompanySealPreview")) {
        uploadedSealBase64 = null;
    }
    break;
            case "load":
                // Trigger file input for loading image
                if ($(contextTarget).is("#CompanyLogoPreview")) {
                    $("#CompanyLogoInput").click();
                } else if ($(contextTarget).is("#CompanySealPreview")) {
                    $("#CompanySealInput").click();
                }
                break;
            case "save":
                // Download image
                const img = $(contextTarget).find("img")[0];
                if (img) {
                    const a = document.createElement("a");
                    a.href = img.src;
                    a.download = "image.png";
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }
                break;
        }
    });
});

</script>

