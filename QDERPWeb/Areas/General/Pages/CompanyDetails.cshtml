    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

