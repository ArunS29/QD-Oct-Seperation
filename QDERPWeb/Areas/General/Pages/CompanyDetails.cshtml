@page
@model Areas.General.Pages.CompanyDetailsModel
@{
}
<style>

    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold;
        font-size: 14px;
        padding: 10px 15px;
    }


        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue;
            color: white !important;
        }

    .dx-tabpanel {
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        margin: 15px;
        width: 99%;
        padding: 5px;
        border-radius: 1px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .select-box {
        width: 20vh;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container3 {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .column4 {
        flex: 1;
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .containers {
        display: flex;
    }

    .dx-card {
        background: var(--background-color);
    }

    #goToTopBtn {
        z-index: 100;
    }

    .mainContainer {
        width: 100%;
    }

    .dx-button-text {
        color: black;
    }

    .preview-box {
        width: 200px; /* fixed width */
        height: 150px; /* fixed height */
        border: 2px dashed #ccc; /* dashed border */
        border-radius: 8px; /* rounded corners */
        display: flex;
        justify-content: center; /* center horizontally */
        align-items: center; /* center vertically */
        cursor: pointer; /* pointer cursor to indicate clickable */
        overflow: hidden;
        background-color: #f9f9f9;
        position: relative;
        user-select: none; /* prevent text selection on right click */
    }

        .preview-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain; /* keep aspect ratio */
            pointer-events: none; /* so right-click triggers div, not image */
        }

        .preview-box span {
            color: #999;
            font-size: 14px;
            text-align: center;
            user-select: none;
        }

</style>
<div class="dx-card-header minimal-header">
    <div class="card-title-icon">
        <i class="fas fa-file-invoice-dollar"></i>
    </div>
    <h3 class="card-title-text">Company Details</h3>
</div>

<meta charset="UTF-8">

<div class="form-container1">

    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().DeferRendering(false).ID("SupplierTabs").Width("100%")
                .Items(item =>
                {
                    item.Add()
                .Title("Company Details//تفاصيل الشركة")
                .Icon("folder")
                .Text("Company Details//تفاصيل الشركة")
                .Template(@<text>
            <div style="display: flex; gap: 30px; justify-content: space-between; width:100%; padding: 20px; ">

                <!-- Left Side (English) -->
                <div style="flex: 1;">
                    @(Html.DevExtreme().TextBox()
                    .ID("CompanyID")
                    .Label("Company ID:")
                    .LabelMode(EditorLabelMode.Outside)
                    .ReadOnly(true)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%"))

                    @(Html.DevExtreme().TextBox()
                    .ID("CompanyName")
                    .Label("Company Name:")
                    .LabelMode(EditorLabelMode.Outside)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%")
                    )

                    @(Html.DevExtreme().TextBox()
                    .ID("StreetName")
                    .Label("Our Address - Street Name: *")
                    .LabelMode(EditorLabelMode.Outside)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%"))

                    @(Html.DevExtreme().TextBox()
                    .ID("AdditionalAddress")
                    .Label("Our Address - Additional Address:")
                    .LabelMode(EditorLabelMode.Outside)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%"))

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("BuildingNumber")
                            .MaxLength(4)
                            .Mask("0000") // Accept only 4 digits
                         @* .InputAttr("pattern", "[0-9]{4}") // HTML5 pattern for client-side validation *@
                            .Label("Building Number:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("City")
                            .Label("City: *")
                            .LabelMode(EditorLabelMode.Outside)
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("City is required");
                            })
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("AdditionalNumber")
                            .MaxLength(4)
                            .Mask("0000")
                            .Label("Additional Number:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("Province")
                            .Label("Province / State:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("PostalCode")
                            .MaxLength(5)
                            .Mask("00000")
                            .Label("Postal Code:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("District")
                            .Label("District/Neighborhood: *")
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("District is required");
                            })
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().DropDownBox()
                            .ID("CountryCode")
                            .Label("Country Code: *")
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("Country Code is required");
                            })
                            .ValueExpr("CountryCodeAlpha2")
                            .DisplayExpr("CountryName")
                            .DataSource(ds => ds
                            .Mvc()
                            .Controller("CompanyDetails")
                            .LoadAction("GetCountryCode")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .   Key("CountryCodeAlpha2")
                            )
                            .DropDownOptions(d => d.Width(280)) // Make dropdown wide enough for the grid

                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%")
                            .ContentTemplate(new TemplateName("CodeDropDownTemplate"))
                            )
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("ShortName")
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("Company Short Name is required");
                            })
                            .Label("Company Short Name:")
                            .LabelMode(EditorLabelMode.Outside)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>
                </div>

                <!-- Right Side (Arabic) -->
                <div style="flex: 1; direction: rtl;">


                    @(Html.DevExtreme().TextBox()
                    .ID("ar_CompanyID")
                    .Label("هوية الشركة")
                    .LabelMode(EditorLabelMode.Outside)
                    .ReadOnly(true)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%"))

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_CompanyName")
                        .Label("اسم الشركة")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%")
                        )

                        @(Html.DevExtreme().Button()
                        .ID("ar_CompanyName1")
                        .Height(30)
                        .Icon("fas fa-language")
                        .OnClick("function() { translateFieldToArabic('CompanyName', 'ar_CompanyName'); }")
                        )

                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_StreetName")
                        .Label("العنوان 1: (اسم الشارع)")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_StreetName1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">

                        @(Html.DevExtreme().TextBox()
                        .ID("ar_AdditionalAddress")
                        .Label("العنوان 2: إضافي")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_AdditionalAddress1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">

                        @(Html.DevExtreme().TextBox()
                        .ID("ar_City")
                        .Label("رقم المبنى")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_City1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_Province")
                        .Label("رقم إضافي")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_Province1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_District")
                        .Label("الرمز البريدي")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_District1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_ShortName")
                        .Label("رمز الدولة")
                        .LabelMode(EditorLabelMode.Outside)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(
                        Html.DevExtreme().Button()
                        .ID("ar_ShortName1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>
                </div>

            </div>


        </text>);

                    item.Add().Title("ID Details").Icon("detailslayout").Text("ID Details").Template(@<text>

            <div style="display: flex; flex-wrap: wrap; gap: 10px; padding: 20px;">
                <!-- Left Section -->
                <div style="flex: 1; min-width: 100%;">
                    <div style="display: flex; gap: 10px; padding: 0px; width: 100%;">
                        <div style="width: 100%; gap: 10px;">
                            <!-- Full Address -->
                            @(Html.DevExtreme().TextBox()
                            .ID("FullAddress")
                            .Label("Full Address")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            .Height(80))

                            <!-- Full Address Arabic -->
                            @(Html.DevExtreme().TextBox()
                            .ID("FullAddressArabic")
                            .Label("Full Address (Arabic)")
                            .LabelMode(EditorLabelMode.Outside)
                            .Width("100%")
                            .Height(80))
                        </div>
                        <div id="CompanyLogoPreview" class="preview-box" oncontextmenu="triggerUpload('CompanyLogoInput'); return false;">
                            <span>No image data for logo</span>
                        </div>
                        <input type="file" id="CompanyLogoInput" style="display:none" accept="image/*" onchange="uploadImage('logo')">

                        <div id="CompanySealPreview" class="preview-box" oncontextmenu="triggerUpload('CompanySealInput'); return false;">
                            <span>No image data for seal</span>
                        </div>
                        <input type="file" id="CompanySealInput" style="display:none" accept="image/*" onchange="uploadImage('seal')">


                    </div>


                    <!-- Product Name and Company Slogan -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ProductName")
                        .Label("Product Name")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("CompanySlogan")
                        .Label("Company Slogan")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>

                    <!-- Phone / Fax -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("Phone")
                        .Label("Company Phone")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("Fax")
                        .Label("Company Fax")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>

                    <!-- Email / Website -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("Email")
                        .Label("Email Address")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("Website")
                        .Label("Website")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>

                    <!-- VAT / Group VAT / TIN -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("VAT")
                        .Label("VAT Registration No *")
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired()
                        .Message("VAT NO is required");
                        })
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("GroupVAT")
                        .Label("Group VAT No")
                        .MaxLength(10)
                        .Mask("0000000000")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("TIN")
                        .Label("TIN")
                        .MaxLength(10)
                        .Mask("0000000000")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>

                    <!-- ID Type / ID Number / Commercial Reg -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().DropDownBox()
                        .ID("IDType")
                        .Label("ID Type *")
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired()
                        .Message("ID Type is required");
                        })
                        .ValueExpr("SellerOtherIdtype")
                        .DisplayExpr("SellerIdtypeName")
                        .DataSource(ds => ds
                        .Mvc()
                        .Controller("CompanyDetails")
                        .LoadAction("GetIdType")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .   Key("SellerOtherIdtype")
                        )
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%")
                        .ContentTemplate(new TemplateName("IDDropDownTemplate"))
                        )

                        @(Html.DevExtreme().TextBox()
                        .ID("IDNumber")
                        .Label("ID Number *")
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired()
                        .Message("ID Number is required");
                        })
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("CRNumber")
                        .Label("Commercial Registration No")
                        .LabelMode(EditorLabelMode.Outside)
                        .Width("100%"))
                    </div>

                    <!-- Print Button -->
                    <div style="text-align: right; margin-top: 10px;">
                        @(Html.DevExtreme().Button()
                        .Text("Print Company Info")
                        .Icon("print")
                        .Type(ButtonType.Normal)
                        .Width(250))
                    </div>
                </div>




            </div>

        </text>);
                    item.Add().Text("Other//آخر").Icon("home").Title("Other//آخر").Template(@<text>

