        let currentCompanyId = null;

     function onSetAllDatesClick(e) {
    var dateBox = $("#lockedDate").dxDateBox("instance");
    var selectedDate = dateBox ? dateBox.option("value") : null;

    if (!selectedDate) {
        DevExpress.ui.notify("Please select a date to lock.", "error", 3000);
        return;
    }

    // Format date as yyyy-MM-dd (no time, no timezone)
    var d = new Date(selectedDate);
var formattedDate = d.getFullYear() + '-' +
    String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');

    $.ajax({
        url: "/api/CompanyDetails/SetAllVoucherDates",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(formattedDate),
        success: function (res) {
            DevExpress.ui.notify("All voucher dates updated successfully.", "success", 3000);
            var grid = $("#itemGrid1").dxDataGrid("instance");
            if (grid) grid.refresh();
        },
        error: function () {
            DevExpress.ui.notify("Failed to update voucher dates.", "error", 3000);
        }
    });
}
function onUpdateDateLockedClick(e) {
    var grid = $("#itemGrid1").dxDataGrid("instance");
    var changes = grid.getVisibleRows()
        .filter(row => row.data && row.data.VoucherDateLocked !== row.oldData?.VoucherDateLocked)
        .map(row => ({
            VoucherTypeCode: row.data.VoucherTypeCode,
            VoucherDateLocked: row.data.VoucherDateLocked
        }));

    // If your grid uses batch editing, use:
    // var changes = grid.getChanges().filter(c => c.type === "update");

    if (changes.length === 0) {
        DevExpress.ui.notify("No changes to update.", "info", 3000);
        return;
    }

    // Send all changes in one request (if your API supports bulk), or one by one
    let updatePromises = changes.map(change =>
        $.ajax({
            url: "/api/CompanyDetails/UpdateVoucherDateLockedRow",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(change)
        })
    );

    Promise.all(updatePromises)
        .then(() => {
            DevExpress.ui.notify("Voucher dates updated successfully.", "success", 3000);
            grid.refresh();
        })
        .catch(() => {
            DevExpress.ui.notify("Failed to update voucher dates.", "error", 3000);
        });
}
    // --- Company IDs and Navigation ---
