@page
@model Areas.General.Pages.CompanyDetailsModel
@{
}
<style>

    .dx-tabpanel .dx-tab {
        color: black !important;
        font-weight: bold;
        font-size: 14px;
        padding: 10px 15px;
    }

    .dx-tabpanel-container {
        height: 74vh !important;
    }
        .dx-tabpanel .dx-tab.dx-selection {
            background-color: lightblue;
            color: white !important;
        }

    .dx-tabpanel {
    }


    .mainContainer {
        overflow-x: hidden;
    }

    .form-container1 {
        margin: 0px 10px;
        width: 99%;
        padding: 5px;
        border-radius: 1px;
    }

    .form-container {
        width: 100%;
        border-radius: 1px;
    }

    .form-row {
        display: flex;
        gap: 10px;
        padding: 10px;
        margin-bottom: 15px;
        width: 100%;
    }


    .form-label {
        color: black;
        padding: 5px;
        font-weight: bold;
        width: 200px;
        text-align: Left;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dx-textbox .dx-texteditor-input,
    .dx-numberbox .dx-texteditor-input,
    .dx-selectbox .dx-texteditor-input {
    }

    .dx-button {
        margin-left: 5px;
    }

    .dx-selectbox {
        width: 100%;
    }

    .footer-buttons .row {
        margin-top: 20px;
    }

    .form-control-with-border {
        border-radius: 4px;
        padding: 8px;
        width: 100%;
    }


    .horizontal-container {
        display: flex;
        gap: 20px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .button-group {
        align-items: center;
        justify-content: center;
        padding: 8px;
    }

    .form-row.border-outline {
        border: 1px solid gray;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .select-box {
        width: 20vh;
    }

    .imagecontainer {
        border: 2px dashed #ccc;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .imagecontainer:hover {
        border-color: #007bff;
        box-shadow: 0 0 10px rgba(0, 123, 255, 0.3);
    }

    .imagecontainer span {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        color: #999;
        font-size: 1.2rem;
        font-style: italic;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container3 {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .column4 {
        flex: 1;
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .containers {
        display: flex;
    }

    .dx-card {
        background: var(--background-color);
    }

    #goToTopBtn {
        z-index: 100;
    }

    .mainContainer {
        width: 100%;
    }

    .dx-button-text {
        color: black;
    }

    .preview-box {
        width: 200px; /* fixed width */
        height: 150px; /* fixed height */
        border: 2px dashed #ccc; /* dashed border */
        border-radius: 8px; /* rounded corners */
        display: flex;
        justify-content: center; /* center horizontally */
        align-items: center; /* center vertically */
        cursor: pointer; /* pointer cursor to indicate clickable */
        overflow: hidden;
        background-color: #f9f9f9;
        position: relative;
        user-select: none; /* prevent text selection on right click */
    }

        .preview-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain; /* keep aspect ratio */
            pointer-events: none; /* so right-click triggers div, not image */
        }

        .preview-box span {
            color: #999;
            font-size: 14px;
            text-align: center;
            user-select: none;
        }

        .titleCard-toggle1 {
            display: none;
        }
        #customContextMenu .ctx-item {
    padding: 8px 16px;
    cursor: pointer;
    font-size: 15px;
}
#customContextMenu .ctx-item:hover {
    background: #e6f0ff;
}
</style>
<div class="dx-card-header minimal-header">
    <div class="card-title-icon">
        <i class="fas fa-file-invoice-dollar"></i>
    </div>
    <h3 class="card-title-text" id="companydetailshome"></h3>
</div>

<meta charset="UTF-8">

<div class="form-container1">

    <div class="form-container">
        <!-- Tab Menu -->
        @(
                Html.DevExtreme().TabPanel().ID("SupplierTabs").Width("100%").DeferRendering(false)
                .Items(item =>
                {
                    item.Add()
                .Title(new JS("formatMessage('Company Details')"))
                .Icon("folder")
                .Text("Company Details")
                .Template(@<text>
            <div style="display: flex; gap: 30px; justify-content: space-between; width:100%; padding: 20px; ">

                <!-- Left Side (English) -->
                <div style="flex: 1;">
                    @(Html.DevExtreme().TextBox()
                    .ID("CompanyID")
                    .Label(new JS("formatMessage('Company ID:')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .ReadOnly(true)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%"))

                    @(Html.DevExtreme().TextBox()
                    .ID("CompanyName")
                     .Label(new JS("formatMessage('Company Name:')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%")
                    )

                    @(Html.DevExtreme().TextBox()
                    .ID("StreetName")
                     .Label(new JS("formatMessage('Our Address - Street Name: *')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%"))

                    @(Html.DevExtreme().TextBox()
                    .ID("AdditionalAddress")
                    .Label(new JS("formatMessage('Our Address - Additional Address:')"))
                    .LabelMode(EditorLabelMode.Floating)
                    .StylingMode(EditorStylingMode.Outlined)
                    .Width("100%"))

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("BuildingNumber")
                            .MaxLength(4)
                            .Mask("0000") // Accept only 4 digits
                         @* .InputAttr("pattern", "[0-9]{4}") // HTML5 pattern for client-side validation *@
                             .Label(new JS("formatMessage('Building Number:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("City")
                             .Label(new JS("formatMessage('City: *')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("City is required");
                            })
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("AdditionalNumber")
                            .MaxLength(4)
                            .Mask("0000")
                            .Label(new JS("formatMessage('Additional Number:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("Province")
                            .Label(new JS("formatMessage('Province / State:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("PostalCode")
                            .MaxLength(5)
                            .Mask("00000")
                            .Label(new JS("formatMessage('Postal Code:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("District")
                            .Label(new JS("formatMessage('District/Neighborhood: *')"))
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("District is required");
                            })
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; width: 100%;">
                        <div style="flex: 1;">
                            @(Html.DevExtreme().DropDownBox()
                            .ID("CountryCode")
                                                        .Label(new JS("formatMessage('Country Code: *')"))
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("Country Code is required");
                            })
                            .ValueExpr("CountryCodeAlpha2")
                            .DisplayExpr("CountryName")
                            .DataSource(ds => ds
                            .Mvc()
                            .Controller("CompanyDetails")
                            .LoadAction("GetCountryCode")
                            .LoadMode(DataSourceLoadMode.Raw)
                            .   Key("CountryCodeAlpha2")
                            )
                            .DropDownOptions(d => d.Width(280)) // Make dropdown wide enough for the grid

                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%")
                            .ContentTemplate(new TemplateName("CodeDropDownTemplate"))
                            )
                        </div>
                        <div style="flex: 1;">
                            @(Html.DevExtreme().TextBox()
                            .ID("ShortName")
                            .ValidationRules(rules =>
                            {
                            rules.AddRequired()
                            .Message("Company Short Name is required");
                            })
                                                        .Label(new JS("formatMessage('Company Short Name:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .StylingMode(EditorStylingMode.Outlined)
                            .Width("100%"))
                        </div>
                    </div>
                </div>

                <!-- Right Side (Arabic) -->
                <div style="flex: 1; direction: rtl;">


                   



                        <div style="direction: rtl; display:flex; align-items:end;">
                            @(Html.DevExtreme().TextBox()
                             .ID("ar_CompanyID")
                             .Label("هوية الشركة")
                             .LabelMode(EditorLabelMode.Floating)
                             .ReadOnly(true)
                             .StylingMode(EditorStylingMode.Outlined)
                             .Width("100%"))

                            @(Html.DevExtreme().Button()
                             .ID("ar_CompanyButton")
                             .Height(30)
                             .Icon("fas fa-language")
                             .OnClick("function() { translateFieldToArabic('CompanyID', 'ar_CompanyID'); }")
                                                    )

                        </div>



                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_CompanyName")
                        .Label("اسم الشركة")
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%")
                        )

                        @(Html.DevExtreme().Button()
                        .ID("ar_CompanyName1")
                        .Height(30)
                        .Icon("fas fa-language")
                        //.OnClick("function() { translateFieldToArabic('CompanyName', 'ar_CompanyName'); }")
                        )

                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_StreetName")
                        .Label("العنوان 1: (اسم الشارع)")
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_StreetName1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        //.OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">

                        @(Html.DevExtreme().TextBox()
                        .ID("ar_AdditionalAddress")
                        .Label("العنوان 2: إضافي")
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_AdditionalAddress1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        //.OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">

                        @(Html.DevExtreme().TextBox()
                        .ID("ar_City")
                        .Label("رقم المبنى")
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_City1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        //.OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_Province")
                        .Label("رقم إضافي")
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_Province1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        //.OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_District")
                        .Label("الرمز البريدي")
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(Html.DevExtreme().Button()
                        .ID("ar_District1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        //.OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>

                    <div style="direction: rtl; display:flex; align-items:end;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ar_ShortName")
                        .Label("رمز الدولة")
                        .LabelMode(EditorLabelMode.Floating)
                        .StylingMode(EditorStylingMode.Outlined)
                        .Width("100%"))
                        @(
                        Html.DevExtreme().Button()
                        .ID("ar_ShortName1")
                        .Height(30)
                        .Icon("fas fa-language") // Ensure Font Awesome class is correct
                        .ElementAttr(new { @class = "input-button" })
                        //.OnClick("function() { RetentionconvertToArabic(); }")
                        )
                    </div>
                </div>

            </div>


        </text>);

                item.Add().Title(new JS("formatMessage('ID Details')")).Icon("detailslayout").Text("ID Details").Template(@<text>

            <div style="display: flex; flex-wrap: wrap; gap: 10px; padding: 20px;">
                <!-- Left Section -->
                <div style="flex: 1; min-width: 100%;">
                    <div style="display: flex; gap: 10px; padding: 0px; width: 100%;">
                        <div style="width: 100%; gap: 10px;">
                            <!-- Full Address -->
                            @(Html.DevExtreme().TextBox()
                            .ID("FullAddress")
                            .Label(new JS("formatMessage('Full Address')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .Width("100%")
                            .Height(80))



                                <div style="direction: rtl; display:flex; align-items:end;">
                                    @(Html.DevExtreme().TextBox()
                                      .ID("FullAddressArabic")
                                      .Label(new JS("formatMessage('Full Address (Arabic)')"))
                                      .LabelMode(EditorLabelMode.Floating)
                                      .ReadOnly(true)
                                      .StylingMode(EditorStylingMode.Outlined)
                                      .Width("100%"))

                                    @(Html.DevExtreme().Button()
                                     .ID("FullAddressArabicButton")
                                     .Height(30)
                                     .Icon("fas fa-language")
                                     .OnClick("function() { translateFieldToArabic('FullAddress', 'FullAddressArabic'); }")
                                                                    )

                                </div>



                        </div>
                        <div id="CompanyLogoPreview" class="preview-box">
                             <span id="noimagedatalogo"></span>
                        </div>
                        <input type="file" id="CompanyLogoInput" style="display:none" accept="image/*" onchange="uploadImage('logo')">


                        <div id="CompanySealPreview" class="preview-box">
                           <span id="noimageforseal"></span>
                        </div>
                        <input type="file" id="CompanySealInput" style="display:none" accept="image/*" onchange="uploadImage('seal')">


                    </div>


                    <!-- Product Name and Company Slogan -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("ProductName")
                        .Label(new JS("formatMessage('Product Name')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("CompanySlogan")
                                                .Label(new JS("formatMessage('Company Slogan')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>

                    <!-- Phone / Fax -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("Phone")
                                                .Label(new JS("formatMessage('Company Phone')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("Fax")
                                                .Label(new JS("formatMessage('Company Fax')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>

                    <!-- Email / Website -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("Email")
                                                .Label(new JS("formatMessage('Email Address')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("Website")
                                                .Label(new JS("formatMessage('Website')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>

                    <!-- VAT / Group VAT / TIN -->
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().TextBox()
                        .ID("VAT")
                                                .Label(new JS("formatMessage('VAT Registration No *')"))
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired()
                        .Message("VAT NO is required");
                        })
                         .Mask("000000000000000") // 15 digits
                        .MaxLength(15)
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("GroupVAT")
                        .Label(new JS("formatMessage('Group VAT No')"))
                        .MaxLength(15)
                        .Mask("000000000000000")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("TIN")
                                                .Label(new JS("formatMessage('TIN')"))
                        .MaxLength(10)
                        .Mask("0000000000")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%"))
                    </div>

                    
                    <div style="display: flex; gap: 10px;">
                        @(Html.DevExtreme().DropDownBox()
                        .ID("IDType")
                                                .Label(new JS("formatMessage('ID Type *')"))
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired()
                        .Message("ID Type is required");
                        })
                        .ValueExpr("SellerOtherIdtype")
                        .DisplayExpr("SellerIdtypeName")
                        .DataSource(ds => ds
                        .Mvc()
                        .Controller("CompanyDetails")
                        .LoadAction("GetIdType")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .   Key("SellerOtherIdtype")
                        )
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                         .DropDownOptions(d => d.Width(310))
                        .ContentTemplate(new TemplateName("IDDropDownTemplate"))
                        )

                        @(Html.DevExtreme().TextBox()
                        .ID("IDNumber")
                                                .Label(new JS("formatMessage('ID Number *')"))
                        .ValidationRules(rules =>
                        {
                        rules.AddRequired()
                        .Message("ID Number is required");
                        })
                        .LabelMode(EditorLabelMode.Floating)
                        
                        .Width("100%"))

                        @(Html.DevExtreme().TextBox()
                        .ID("CRNumber")
                                                .Label(new JS("formatMessage('Commercial Registration No')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .Mask("0000000000") 
                        .Width("100%"))
                    </div>

                    <!-- Print Button -->
                    <div style="text-align: right; margin-top: 10px;">
                        @(Html.DevExtreme().Button()
                                                .Text(new JS("formatMessage('Print Company Info')"))
                        .Icon("print")
                        .Option("reportName", "CompanyDetail1")
                        .Type(ButtonType.Normal)
                        .OnClick("handleQuatation")
                        .Width(250))
                        .
                    </div>
                </div>




            </div>

        </text>);
                    item.Add().Text("Other").Icon("home").Title(new JS("formatMessage('Other')")).Template(@<text>

            <div style=" padding: 20px; width:100%">

                <!-- Auditor Section -->
