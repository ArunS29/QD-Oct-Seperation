    let uploadedLetterHeadBase64 = null;
    let lastLoadedLetterHeadBase64 = null; // for restoring preview

    // --- Utility: Update Prev/Next Button State ---
    function updateNavButtons() {
        $("#btnPrevious").dxButton("instance").option("disabled", currentCompanyIndex === 0);
        $("#btnNext").dxButton("instance").option("disabled", currentCompanyIndex === companyIds.length - 1);
    }

    // --- Utility: Trigger Hidden Input for Image Upload ---
    function triggerUpload(inputId) {
        document.getElementById(inputId).click();
    }

    // --- Utility: Read and Display Uploaded Images ---
    function uploadImage(type) {
        const input = document.getElementById(type === "logo" ? "CompanyLogoInput" : "CompanySealInput");
        const file = input.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (e) {
            const base64String = e.target.result.split(",")[1];
            if (type === "logo") {
                uploadedLogoBase64 = base64String;
                $("#CompanyLogoPreview").html(`<img src="data:image/png;base64,${base64String}" style="max-width:100%; height:auto;">`);
            } else {
                uploadedSealBase64 = base64String;
                $("#CompanySealPreview").html(`<img src="data:image/png;base64,${base64String}" style="max-width:100%; height:auto;">`);
            }
            DevExpress.ui.notify(`${type === "logo" ? "Logo" : "Seal"} ready to be saved.`, "info", 2000);
        };
        reader.readAsDataURL(file);
    }
    // For Letter Head (full image box)
    function handleRightClick(event) {
        event.preventDefault();
        document.getElementById("imageInput").click();
    }
    // Letter Head: Upload on left/right click, touch, and show delete button on hover/tap
function renderLetterHeadImage() {
    var base64 = uploadedLetterHeadBase64 || lastLoadedLetterHeadBase64;
    if (base64) {
        $("#imgBox1").html(
            `<img src="data:image/png;base64,${base64}" style="max-width:100%; height:100%; object-fit:contain;">` +
            `<button id="deleteLetterHeadBtn" type="button" title="Remove" style="display:none; position:absolute; top:10px; right:10px; z-index=2; background:rgba(255,255,255,0.8); border:none; border-radius:50%; width:32px; height:32px; font-size:20px; cursor:pointer;">&times;</button>`
        );
    } else {
