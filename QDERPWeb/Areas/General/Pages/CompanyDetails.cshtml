    if (!widget) {
        if ($el.hasClass("dx-dropdownbox")) widget = "dxDropDownBox";
        else if ($el.hasClass("dx-selectbox")) widget = "dxSelectBox";
        else if ($el.hasClass("dx-textarea")) widget = "dxTextArea";
        else widget = "dxTextBox";
    }
    var inst = $el[widget]("instance");
    return inst ? inst.option("value") : null;
}
