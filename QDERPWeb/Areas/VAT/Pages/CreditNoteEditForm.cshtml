		$("#btnPostToLedgers").on("click", function (e) {
			const dataGrid = $("#B2BdataGrid").dxDataGrid("instance");

			// Ensure dataGrid exists
			if (!dataGrid) {
				console.error("DataGrid instance not found.");
				return;
			}

			const rowCount = dataGrid.getVisibleRows().length;

			// Check if DataGrid contains rows
			if (rowCount === 0) {
				DevExpress.ui.dialog.custom({
					title: "Invoice postal has failed.",
					message: "Invoice has not been posted. Please enter transactions to proceed with postal.",
					buttons: [{ text: "Ok", onClick: () => false }],
					showTitle: true
				}).show();
			} else {
				DevExpress.ui.dialog.custom({
					title: "Confirm Post To Ledger",
					message: "Are you sure want to post this Invoice?",
					buttons: [
						{ text: "Yes", onClick: () => true },
						{ text: "No", onClick: () => false }
					],
					showTitle: true
				}).show().done(function (dialogResult) {
					if (dialogResult) {
						proceedWithPost(); // Proceed if user clicks Yes
					}
				});
			}
		});


