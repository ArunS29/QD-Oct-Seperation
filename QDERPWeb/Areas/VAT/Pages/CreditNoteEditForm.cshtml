		  function proceedWithPost() {
			// Set ApprovedBy checkbox to true
		//	$("#ApprovedBy").dxCheckBox("instance").option("value", true);

			const vno = $("#CreditNoteNo").dxTextBox("instance").option("value");

			if (!vno) {
				DevExpress.ui.notify("Invoice number is required!", "error", 2000);
				return;
			}

			// Define IsDirect if not already defined (adjust as needed)
			const IsDirect = true; // or false, depending on your logic

			const currentDate = new Date();
			const formattedDate = currentDate.toLocaleDateString("en-GB", {
				day: "2-digit",
				month: "short",
				year: "numeric"
			}).replace(/ /g, '-');

			$.ajax({
				type: "POST",
				url: `/api/VATModule/CreditPostInvoice?CreditNoteNo=${encodeURIComponent(vno)}&IsDirectApproval=${encodeURIComponent(IsDirectApproval)}`,
				contentType: "application/json",
				dataType: "json",
				// Uncomment the following line if the API expects data in the request body:
				// data: JSON.stringify({ voucherNo: vno }),
				success: async function (response) {
					if (response && response.Message) {
					    if(response.IsDirect == true)
						{
	                       DevExpress.ui.notify("VAT Invoice has been posted to the Accounting Books.","success",2000);
						}
						// else if(response.IsPosted == true)
						// 	{
						// 			 DevExpress.ui.dialog.alert(
						// 			"This VAT Credit Note is already posted to your ledgers.",
						// 			"Credit Note Posted Already."
						// 		)
						// 	}
						else
						{
								   DevExpress.ui.dialog.custom({
						title: "Voucher is not Approved",
						message: "Invoice has been Approved,Click Yes if you want to Approve this voucher.",
						buttons: [
							{ text: "Yes", onClick: () => true },
							{ text: "No", onClick: () => false }
						],
						showTitle: true
					}).show().done(function (dialogResult) {
						if (dialogResult) {
							proceedWithApproval();
						}
					});
						}

						btnPostToLedgerdisableEditing();
						// attachment bind to sales in finance with posting

								const creditNoteNoBox = $("#CreditNoteNo").dxTextBox("instance");
								const creditNoteNo = creditNoteNoBox ? creditNoteNoBox.option("value") : null;
								var menuType = "vat";

								var formType ="e-Invoice CreditNote";
								// 1. Get Documents
								const getDocRes = await fetch(`/api/LedgerDocumentsF/GetDocuments?folderId=${encodeURIComponent(creditNoteNo)}&module=${encodeURIComponent(formType)}&menuType=${encodeURIComponent(menuType)}`);
								const documents = await getDocRes.json();
								if (!documents.length) {
												DevExpress.ui.notify("Voucher saved and claim marked as paid without Attachments.", "success", 2500);
												return;
								}
								// 2. Generate DocumentNo to each documents
								const docNoRes = await fetch(`/api/LedgerDocumentsF/GetNewDocumentNos?count=${documents.length}`);
								const newDocNos = await docNoRes.json();
								if (!Array.isArray(newDocNos) || newDocNos.length !== documents.length) {
												DevExpress.ui.notify("Voucher saved and claim marked as paid, Can't Generate Document Nos", "error", 3000);
												return;
								}
								// 3. Reupload each document to AddDocumentsEntry
								const generateNo = $("#CreditNoteNo").dxTextBox("instance").option("value");

								const PostVoucherType = "journal";
								const isMaster = false;
								const PostMenuType = 'finance';
								for (let i = 0; i < documents.length; i++) {
									const doc = documents[i];
									const newDocNo = newDocNos[i];

									try {
										const fileResponse = await fetch(doc.FileUrl);
										const blob = await fileResponse.blob();

										const originalFileName = doc.FileUrl.split('/').pop().split('?')[0];
										const safeFileName = originalFileName.replace(/[^a-zA-Z0-9_.-]/g, "_");

										const formData = new FormData();
										formData.append("file", new File([blob], safeFileName)); // no docNo prefix
										formData.append("DocumentNo", newDocNo);
										formData.append("DocumentRefNo", doc.DocumentRefNo || "");
										formData.append("DocumentType", doc.DocumentType ?? "1");
										formData.append("DocumentRemarks", doc.DocumentRemarks || "");
										formData.append("DocumentExpDate", doc.DocumentExpDate || "");
										formData.append("NotificationDate", doc.DocumentNotificationDate || "");
										formData.append("LedgerNo", generateNo); // new folder id


											const uploadRes = await fetch(`/api/LedgerDocumentsF/AddDocumentsEntry?folderId=${encodeURIComponent(generateNo)}&moduleType=${encodeURIComponent(PostVoucherType)}&isMaster=${isMaster}&menuType=${encodeURIComponent(PostMenuType)}`, {
											method: "POST",
											body: formData
										});

										const uploadResult = await uploadRes.json();
										console.log("Uploaded document:", uploadResult);
									} catch (uploadError) {
													console.error("Error re-uploading document:", uploadError);
									}
								}
							DevExpress.ui.notify(
								"VAT Invoice has been posted to the Accounting Books with Attachments.","success",2000
								
							);
					} else {
						DevExpress.ui.notify("Update failed: Unable to reload details!", "error", 2000);
					}
				},
				error: function (xhr, status, error) {
					let errorMessage = (xhr.responseJSON && xhr.responseJSON.Message)
						? xhr.responseJSON.Message
						: "An error occurred.";
					DevExpress.ui.notify(errorMessage, "error", 2000);
				}
			});
		}



