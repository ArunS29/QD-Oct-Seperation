<!-- Modal Structure -->

<script>

	let accid=null,revaccheadid=null,InvoiceCurrencyExchangeId=null,TaxCurrencyExchangeId=null,branchcode=null,salespersoncode=null,companyid=null,SellerOtherIdtype=null,
			  SignatoryID=null,ChkbySignatoryID=null,ApproedbySignatoryID=null,IsCurrent="false",IsAmend="false",CrNoteNo=null,IsDirectApproval=true,IsDirectVerify=true,UnitCode=null;

	let companyBranchList = [];

	$(async function () {
		// Fetch company list from API
			await $.get("/api/VATModule/GetDefalutCompanyBranch", function (data) {
			companyBranchList = data;

			if (companyBranchList.length > 0) {
				// You can replace '0' with a specific ID using .find()
				const defaultCompany = companyBranchList[0]; // or: companyBranchList.find(c => c.CompanyId === 1);

				const dropDown = $("#ddlGoodsGroup7").dxDropDownBox("instance");

				// Set default selected value in DropDownBox
				dropDown.option("value", defaultCompany.CompanyId);

				// Fill other company fields
				fillCompanyFields(defaultCompany);
			}
		});
	});



	// Populate all related fields based on selected company
	function fillCompanyFields(company) {
		$("#OurGroupVATNo").dxTextBox("instance").option("value", company.SellerGroupVatnumber);
		$("#OurVATNo").dxTextBox("instance").option("value", company.CompanyVatno);
		$("#OtherID1").dxTextBox("instance").option("value", company.SellerOtherSellerId);
		$("#ddlGoodsGroup8").dxDropDownBox("instance").option("value", company.SellerOtherIdtype);
		$("#OurCompanyRegisteredName").dxTextBox("instance").option("value", company.CompanyName);
		$("#OurCompanyNameinArabic").dxTextBox("instance").option("value", company.CompanyNameAr);

		$("#StreetName").dxTextBox("instance").option("value", company.SellerAddressStreet);
		$("#StreetNameArabic").dxTextBox("instance").option("value", company.SellerAddressStreetAr);
		$("#AdditionalAddress").dxTextBox("instance").option("value", company.SellerAdditionalStreet);
		$("#AdditionalAddressArabic").dxTextBox("instance").option("value", company.SellerAdditionalStreetAr);
		$("#BuildingNumber").dxTextBox("instance").option("value", company.SellerBuildingNumber);
		$("#ClientCity").dxTextBox("instance").option("value", company.SellerCity);
		$("#ClientCityArabic").dxTextBox("instance").option("value", company.SellerCityAr);
		$("#AdditionalNumber").dxTextBox("instance").option("value", company.SellerAdditionalNumber);
		$("#Province").dxTextBox("instance").option("value", company.SellerProvince);
		$("#ProvinceArabic").dxTextBox("instance").option("value", company.SellerProvinceAr);
		$("#PostalCode").dxTextBox("instance").option("value", company.SellerPostalCode);
		$("#District").dxTextBox("instance").option("value", company.SellerNeighborhood);
		$("#DistrictArabic").dxTextBox("instance").option("value", company.SellerNeighborhoodAr);
	}
				
		function navigateToLedgerAccountForm() {
		// make sure this is available in the view
			const url = `/${tenantName}/VAT/VATDatabaseSignatories`;
			const title = "";
			openModal(url, title); // opens in modal instead of new window
		}

			  let ItemNo=null, paymentmeanstypecode=null,amt=0, accheadid =null;

	 $(document).ready(function () {
		$.ajax({
			url: "/api/VATModule/CreateNewInvoiceCounter",
			type: 'POST',
			success: function (data) {
				console.log("Success:", data);
				
			   $("#InvoiceCounterValue").dxTextBox("instance").option("value", data);
			},
			error: function (xhr, status, error) {
				console.error("Error loading Payment Accounts:", error);
				DevExpress.ui.notify("Failed to load account details.", "error",3000);
			}
		});
	});

		function InvoiceOPenToSave(data) {
			if (revaccheadid == null) {
				revaccheadid = "L00343";
			}
			
		    var InvoiceMaster = {
			CreditNoteNo: $('#CreditNoteNo').dxTextBox("instance").option("value"),
			CreditNoteDate: $("#CreditNoteDate").dxDateBox("instance").option("value"),
			//InvoiceEffectiveDate: $("#CreditNoteIssuedDateTime").dxDateBox("instance").option("value"),
			InvoiceSupplyDate: $("#SupplyDate").dxDateBox("instance").option("value"),
			//PaymentMeansTypeCode: paymentmeanstypecode,
		   /// InvoiceTypeCode: $("#VATInvoiceType").dxDropDownBox("instance").option("value")
			// InvoiceTypeCodeSubType: $("#VATInvoiceSubType").dxDropDownBox("instance").option("value"),
			// InvoiceTransactionCode: $("#InvoiceTransactionsCode").dxDropDownBox("instance").option("value"),
			 ClientCode: accid,
			 BuyerName: $("#ddclientname").dxTextBox("instance").option("value")||null,
			 BuyerNameAr: $("#ClientNameArabic").dxTextBox("instance").option("value")||null,
			 SellerGroupVatnumber: $("#GroupVATNo").dxTextBox("instance").option("value")||null,
			 BuyerVatnumber: $("#ClientVATNo").dxTextBox("instance").option("value")||null,
			// BuyerOtherIdtype: $("#OtherIDType").dxTextBox("instance").option("value"),
			 BuyerOtherId: $("#ClientOtherID").dxTextBox("instance").option("value")||null,
		     InvoiceCounterValue: $("#InvoiceCounterValue").dxTextBox("instance").option("value")||null,
			// InvoiceNo: $("#InvoiceNo").dxTextBox("instance").option("value")|| null,

			 InvoiceEffectiveDate:$("#EffectiveDate").dxDateBox("instance").option("value")|| null,
			InvoiceStartDate: $("#InvoiceStartDate").dxDateBox("instance").option("value")|| null,
			InvoiceEndDate:$("#InvoiceEndDate").dxDateBox("instance").option("value")|| null,
			RevenueAccount:revaccheadid|| null,
			CostCenterCode: $("#ddlCostCenterAccount").dxDropDownBox("instance").option("value")|| null,
			RemarksInEn: $("#txtInvoiceNotes").dxTextArea("instance").option("value")|| null,
			RemarksInAr: $("#txtNotesinArabic").dxTextArea("instance").option("value")|| null,


				//Deduction&CurrencyDetails
		//	InvoiceCurrencyCode: InvoiceCurrencyExchangeId|| null,
			//TaxCurrencyCode: TaxCurrencyExchangeId|| null,
			ExchangeRate:$("#currencyexchangerate").dxNumberBox("instance").option("value")|| null,
			AdvanceText:$("#LessAdvance").dxTextBox("instance").option("value")|| null,
			AdvanceAmount:$("#currencyexchangerate3").dxNumberBox("instance").option("value")|| null,
			AdvanceTextAr:$("#LessAdvanceAr").dxTextBox("instance").option("value")|| null,
			OtherDeductionText:$("#LessOtherDeductions").dxTextBox("instance").option("value")|| null,
			OtherDeductionAmount:$("#currencyexchangerate4").dxNumberBox("instance").option("value")|| null,
			OtherDeductionTextAr:$("#LessAdvanceAr1").dxTextBox("instance").option("value")|| null,
			RetentionText:$("#LessRetention").dxTextBox("instance").option("value")|| null,
			RetentionAmount:$("#currencyexchangerate5").dxNumberBox("instance").option("value")|| null,
			RetentionTextAr:$("#LessAdvanceAr2").dxTextBox("instance").option("value")|| null,

				//SalesOrderNo: $("#OurSalesOrderNo").dxDropDownBox("instance").option("value")|| null,
			Pono: $("#ClientPONo").dxTextBox("instance").option("value")|| null,
			ReferenceNo: $("#ProjectRef").dxTextBox("instance").option("value")|| null,
			

			//Branch/DivisionDetails
			BranchCode: branchcode|| null,
			InvoiceSalesPerson: salespersoncode|| null,
			CompanyId:companyid|| null,
			 SellerName:$("#OurCompanyRegisteredName").dxTextBox("instance").option("value")|| null,
			  SellerGroupVatnumber:$("#OurGroupVATNo").dxTextBox("instance").option("value")|| null,
			  SellerVATNumber:$("#OurVATNo").dxTextBox("instance").option("value")|| null,
			  SellerNameAr:$("#OurCompanyNameinArabic").dxTextBox("instance").option("value")|| null,
			   SellerOtherIdtype:SellerOtherIdtype|| null,
