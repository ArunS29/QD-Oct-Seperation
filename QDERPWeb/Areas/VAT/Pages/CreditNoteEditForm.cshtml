			function onVatTransactionSelectionChanged(e) {
		const selectedIds = e.component.option("selectedItemKeys");
		const transactionCode = setInvoiceTransactionCode(selectedIds);

		const ddbInstance = $("#InvoiceTransactionsCode").dxDropDownBox("instance");
		transcode = transactionCode;

		let dataSource = ddbInstance.option("dataSource");
		let currentData = Array.isArray(dataSource) ? dataSource : (dataSource?.items?.() || []);

		const found = currentData.find(item => item.code === transactionCode);
		if (!found) {
			currentData.push({ code: transactionCode });
			ddbInstance.option("dataSource", currentData);
		}

		ddbInstance.option("value", transactionCode);

		// Update toggle color
		$(".vat-checkbox").each(function () {
			const id = parseInt($(this).val());

			const isChecked = selectedIds.includes(id);
			$(this).prop("checked", isChecked);
		});
	}


		// Generates the transaction code like "010110"
		function setInvoiceTransactionCode(selectedIds) {
			// Initialize the transaction code with a prefix
			let strTransactionCode = "01";

			// Dynamically generate the binary string based on selections (1 for selected, 0 for unselected)
			for (let i = 1; i <= 5; i++) {
				strTransactionCode += selectedIds.includes(i) ? "1" : "0";
			}

			return strTransactionCode;
		}


	function updateInvoiceChildren() {
		let grid = $("#B2BdataGrid").dxDataGrid("instance");
		let InvoiceChildren = grid.option("dataSource") || [];
		const CreditNoteNo = $("#CreditNoteNo").dxTextBox("instance").option("value");

		// prepare updated datasource
		let updatedDataSource = InvoiceChildren.map(item => ({
			...item,
			CreditNoteNo: CreditNoteNo
			//,
			// UnitRateMethod: UnitCode,
			// TaxAmount: amt
		}));

		// show spinner if you want
		//document.getElementById('loadingSpinner').style.display = 'block';

		$.ajax({
			type: "POST",
				url: `/api/VoucherMaster/UpdateCreditNoteChildDetails`,
			contentType: "application/json",
			data: JSON.stringify(updatedDataSource),
			success: function () {
				// after update -> refresh grid data
				$.ajax({
					type: "GET",
					url: `/api/VATModule/GetGridCreditNoteDetails?CreditNoteNo=${encodeURIComponent(CreditNoteNo)}`,
					dataType: 'json',
					success: function (response) {
						let rowData = response.map((item, index) => ({
							SNo: index + 1,
							...item
						}));

						grid.option("dataSource", rowData);
						grid.refresh();

						getDocumentCount();
					},
					error: function (xhr, status, error) {
						console.error("Error fetching grid data:", error);
					},
					complete: function () {
						//document.getElementById('loadingSpinner').style.display = 'none';
					}
				});

				//isVoucherSaved = true; // Mark Updated step as done
				//updateWorkflowVisual(getWorkflowStatusFromFields());
				///DevExpress.ui.notify("Invoice Details updated Successfully.", "success", 2000);
			},
			error: function (xhr) {
				DevExpress.ui.notify("Error: " + (xhr.responseJSON?.message || xhr.statusText), "error", 3000);
				//document.getElementById('loadingSpinner').style.display = 'none';
			}
		});
	}

		$(function () {

			var dropDownBox = $("#ClientAddressDetails").dxDropDownBox("instance");
			dropDownBox.open();
			dropDownBox.close();


		});


				
</script>

