			 function gridBox_valueChanged(e) {
					var $dataGrid = $("#dataGrid");

					if ($dataGrid.length) {
						var dataGrid = $dataGrid.dxDataGrid("instance");
						dataGrid.selectRows(e.value, false);
					}
					if (e.value) {


						let grid = $("#dataGrid").dxDataGrid("instance");
						let rowIndex = e.element.closest("tr").index(); // Get the edited row index
						let rowData = grid.getVisibleRows()[rowIndex].data;

						let costAllocationDropdownGrid = $("#accountDropDownBoxeditGrid").dxDataGrid("instance");
						let selectedRowData = costAllocationDropdownGrid.getSelectedRowsData()[0]; // Get first selected row

						// if (selectedRowData) {
						//     propertyno = selectedRowData.PropertyNo; // Store the correct ID

						// }

						rowData.AccountHead = e.value; // Update the row data
								grid.cellValue(rowIndex,`${formatMessage('AccountHead')}`, e.value); // Ensure it reflects in the grid

					}
					// Close the dropdown after selection
					e.component.option("opened", false);

				}

			function onEditorPreparing(e) {
           if (e.parentType === "dataRow" &&
			(e.dataField === "QuantityCredited" ||
			 e.dataField === "UnitRate" ||
			// e.dataField === "VATPercentage" ||
			 e.dataField === "Discount")) {
				 
			e.editorOptions.onValueChanged = function (args) {
				debugger;
				let grid = $("#B2BdataGrid").dxDataGrid("instance");
				let rowIndex = e.row.rowIndex;
					
				let newValue = args.value;

				// Get existing values or updated ones
						let qty = e.dataField === "QuantityCredited" ? newValue : grid.cellValue(rowIndex, 'QuantityCredited') || 0;
						let unitPrice = e.dataField === "UnitRate" ? newValue : grid.cellValue(rowIndex,'UnitRate') || 0;
						let discount = e.dataField === "Discount" ? newValue : grid.cellValue(rowIndex, 'Discount') || 0;

				// VAT rate handling
						        let vatRateStr = e.dataField === "VATPercentage" ? newValue : grid.cellValue(rowIndex,`${formatMessage('VAT%')}`) || "0%";
				                let vatRate = parseFloat(vatRateStr.replace("%", "")) / 100;
				                
				                // Calculate amount
				                let amount = qty * unitPrice;
				                let discountedAmount = amount - discount;
				                
				                // Ensure discountedAmount doesn't go negative
				                if (discountedAmount < 0) discountedAmount = 0;
				                
				                let vatValue = discountedAmount * vatRate;
				                let totalValue = discountedAmount + vatValue;

							    grid.cellValue(rowIndex, `${formatMessage('VAT')}`, formatAmount(vatValue));
							    grid.cellValue(rowIndex, `${formatMessage('Total')}`, formatAmount(totalValue));
							    grid.cellValue(rowIndex, `${formatMessage('Unit Price')}`, formatAmount(unitPrice));
							    //grid.cellValue(rowIndex, "Total Before Discount", formatAmount(TotalAmtBeforeDiscount));
								grid.cellValue(rowIndex, `${formatMessage('Amount')}`, formatAmount(amount));
								grid.cellValue(rowIndex, `${formatMessage('Discount')}`, formatAmount(discount));
								grid.cellValue(rowIndex,`${formatMessage('Qty')}` , formatAmount(qty));
						        grid.cellValue(rowIndex, `${formatMessage('VAT%')}`, vatRateStr);
                              	grid.saveEditData();
					            updateInvoiceChildren();
			};
		}
	}

