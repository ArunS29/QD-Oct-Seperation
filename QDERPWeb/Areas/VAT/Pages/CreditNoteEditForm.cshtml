<!-- Modal Structure -->

<script>

	let accid=null,revaccheadid=null,InvoiceCurrencyExchangeId=null,TaxCurrencyExchangeId=null,branchcode=null,salespersoncode=null,companyid=null,SellerOtherIdtype=null,
			  SignatoryID=null,ChkbySignatoryID=null,ApproedbySignatoryID=null,IsCurrent="false";;
		function navigateToLedgerAccountForm() {
		// make sure this is available in the view
			const url = `/${tenantName}/VAT/VATDatabaseSignatories`;
			const title = "";
			openModal(url, title); // opens in modal instead of new window
		}

			  let ItemNo=null, paymentmeanstypecode=null,amt=0, accheadid =null;

			$(document).ready(function () {

			$(".limited-footer .btn-containerIvoiceEdit").each(function () {

				if (!$(this).find("#btnMoveDown,#btnMoveUp,#btnSave,#btnSaveAndClose,#btnPrint1,#btnAddNew,#btnDelete,#btnBack,#btnVerify,#btnApprove,#btnAttach,#btnPostToLedgers,#btnPostTag").length) {

					$(this).remove();

				}

			});

		});

		//View e-Invoice

			$(document).ready(function () {
			var urlParams = new URLSearchParams(window.location.search);
					var CreditNoteNo = urlParams.get('CreditNoteNo');
			var IsEditflag = urlParams.get('IsEditflag');

				IsCurrent=IsEditflag.toString();

				// console.log("Iseditflag",IsEditflag)
				if (IsCurrent === "true") {
				$.ajax({
					url: `/api/VATModule/GetCreditNoteDetails?CreditNoteNo=${encodeURIComponent(CreditNoteNo)}`,
					type: 'GET',
					dataType: 'json',
					success: function (response) {
						console.log("InvoiceDetails", response);

						if (response && response.length > 0) {
							var account = response[0];

							console.log(account)

							$('#CreditNoteNo').dxTextBox("instance")?.option("value", account.CreditNoteNo);
							ClientCodedataGridSelectionChanged({ selectedRowKeys: [account.ClientCode] });
							// ClientNamedataGridSelectionChanged({ selectedRowKeys: [account.BuyerName] });
							$('#ddclientname').dxTextBox("instance")?.option("value", account.BuyerName);

					     	$('#GroupVATNo').dxTextBox("instance")?.option("value", account.BuyerGroupVatnumber);
							$('#ClientVATNo').dxTextBox("instance")?.option("value", account.BuyerVatnumber);
						    $('#ClientNameArabic').dxTextBox("instance")?.option("value", account.BuyerNameAr);
							// dataGridSelectionChanged({ selectedRowKeys: [account.BuyerOtherIdtype] });
							 $('#ClientOtherID').dxTextBox("instance")?.option("value", account.BuyerOtherId);
							 $('#InvoiceCounterValue').dxTextBox("instance")?.option("value", account.InvoiceCounterValue);
						     //$('#InvoiceNo').dxTextBox("instance")?.option("value", account.InvoiceNo);
								dataGridRevenueAccountSelectionChanged({ selectedRowKeys: [account.RevenueAccount]});
								dataGridCostCenterAccountHeadSelectionChanged({ selectedRowKeys: [account.CostCenterCode]});

									$('#txtInvoiceNotes').dxTextArea("instance")?.option("value", account.RemarksInEn);
									$('#txtNotesinArabic').dxTextArea("instance")?.option("value", account.RemarksInAr);
									  $('#ClientPONo').dxTextBox("instance")?.option("value", account.Pono);

							// 		   $('#PODate').dxDateBox("instance")?.option("value", account.Podate);
										 $('#ProjectRef').dxTextBox("instance")?.option("value", account.ReferenceNo);
							 			 $('#SESReference').dxTextBox("instance")?.option("value", account.SesreferenceNo);
							//  		 $('#PaymentTerms').dxTextBox("instance")?.option("value", account.PaymentTerms);
							// 			 $('#QuotationNo').dxTextBox("instance")?.option("value", account.ReferenceNo);
							// 			 $('#DeliveryNotes').dxTextBox("instance")?.option("value", account.DeliveryNoteNos);
							// 				 $('#ClientGRNReference').dxTextBox("instance")?.option("value", account.ClientGrnreferenceNo);
											 $('#OurCompanyRegisteredName').dxTextBox("instance")?.option("value", account.SellerName);
							         		 $('#OurVATNo').dxTextBox("instance")?.option("value", account.SellerVATNumber);
						        			 $('#OurGroupVATNo').dxTextBox("instance")?.option("value", account.SellerGroupVatnumber);
							 				 $('#OurCompanyNameinArabic').dxTextBox("instance")?.option("value", account.SellerNameAr);
											 $('#SellerOtherSellerId').dxTextBox("instance")?.option("value", account.SellerOtherSellerId);
							// 				//dataGridInvoiceCurrencyHeadSelectionChanged({ selectedRowKeys: [account.InvoiceCurrencyExchangeId]});
							// 				//dataGridTaxCurrencyHeadSelectionChanged({ selectedRowKeys: [account.TaxCurrencyCode]});
											dataGridDivisionHeadSelectionChanged({ selectedRowKeys: [account.BranchCode]});
											//dataGridSalesPersonHeadSelectionChanged({ selectedRowKeys: [account.InvoiceSalesPerson]});
							     			dataGridCompanyBranchHeadSelectionChanged({ selectedRowKeys: [account.CompanyId]});
											dataGridOtherIDTypeHeadSelectionChanged({ selectedRowKeys: [account.SellerOtherIdtype]});
							 				dataGridPreparedByHeadSelectionChanged({ selectedRowKeys: [account.InvoicePreparedBy]});
							// 				dataGridCheckedByHeadSelectionChanged({ selectedRowKeys: [account.InvoiceCheckedBy]});
							// 				dataGridApprovedByHeadSelectionChanged({ selectedRowKeys: [account.InvoiceApprovedBy]});

											if(account.IsApproved==true)
											{
												disableEditing();
											}

								// Now call the second AJAX to get grid details
							$.ajax({
								type: "GET",
								url: `/api/VATModule/GetGridCreditNoteDetails?CreditNoteNo=${encodeURIComponent(CreditNoteNo)}`,
									dataType: 'json',
								success: function (response) {
										console.log("Grid",response)
					
										let rowData = response.map((item, index) => ({
			SNo: index + 1,
			...item
		}));
									// let rowData = response;

									// ✅ Now safely initialize the grid here
									initializeDataGrid(rowData);
								},
								error: function (xhr, status, error) {
									console.error("Error fetching grid data:", error);
								}
							});
						} else {
							console.warn("No account details found in the response.");
						}
					},
					error: function (xhr, status, error) {
						console.error("Error fetching invoice details:", error);
					}
				});
			}


		});

	// Move the DataGrid configuration into a function for cleanliness
		function initializeDataGrid(rowData) {

			let grid = $("#B2BdataGrid").dxDataGrid({
				dataSource: rowData,
				keyExpr: "SNo",
				// ✅ your columns, editing, dropdowns, and templates go here, unchanged
				// Just make sure to close all functions properly
				// For brevity, I'm skipping repeating all the column config here
					columns: [
						{

								dataField: "InvoiceChildSLNo",
								caption: "InvoiceChildSLNo",
								width: 100,
								allowEditing: false, // Prevent manual editing
								visible: false // Hide the column
							},
							{

								dataField: "SNo",

								caption: "#",

								width: 100,

								allowEditing: false // Prevent manual editing

							},

							{

								dataField: "ItemCode",

								caption: "Item Code",

								width: 200

							},

						  {

				dataField: "DetailedDescription",

				caption: "Description",

				width: 550,

				  editCellTemplate: function (cellElement, cellInfo) {

								getDropdownData().done(function (dropdownData) {

									let $container = $("<div>").css({

										display: "flex",

										alignItems: "center",

										gap: "5px",

										width: "100%"

									}).appendTo(cellElement);

									$("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({

										dataSource: dropdownData,

										valueExpr: "GSCode",

										displayExpr: "GSDescrpition",

										value: cellInfo.value,

										dropDownOptions: { width: 800 },

										onValueChanged: function (e) {

											let selectedItem = dropdownData.find(item => item.GSCode === e.value);

											if (selectedItem) {

												cellInfo.setValue(selectedItem.GSDescrpition);

												let dataGrid = $("#B2BdataGrid").dxDataGrid("instance");

												let rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);

												if (rowIndex !== -1) {

													dataGrid.cellValue(rowIndex, "Item Code", selectedItem.GSCode || "");

													dataGrid.cellValue(rowIndex, "Cost Price", selectedItem.CostPrice || 0);

													dataGrid.cellValue(rowIndex, "GSSellingRate", selectedItem.GSSellingRate || 0);

												}

												let unitprice = dataGrid.cellValue(rowIndex, "Unit Price");

											}

										},

										contentTemplate: function (e) {

											return $("<div>").dxDataGrid({

												dataSource: dropdownData,

												selection: { mode: "single" },

												keyExpr: "GSCode",

												height: 300, // ✅ Add fixed height to enable scrolling

												scrolling: { mode: "virtual" },

												columns: [

													{ dataField: "GSCode", caption: "Code", width: 80 },

													{ dataField: "GSDescrpition", caption: "Description", width: 200 },

													{ dataField: "GsdescriptionAr", caption: "Description In Arabic", width: 200 },

													{ dataField: "ItemPartNo", caption: "Item Part No", width: 100 },

													{ dataField: "CostPrice", caption: "Cost Price", width: 100 },

													{ dataField: "GSSellingRate", caption: "Selling Rate", width: 100 },

													{ dataField: "ReorderQty", caption: "Current Qty", width: 100 }

												],

												onSelectionChanged: function (selectedItems) {

													let selectedItem = selectedItems.selectedRowsData[0];

													if (selectedItem) {

														e.component.option("value", selectedItem.GSCode);

														cellInfo.setValue(selectedItem.GSDescrpition);

														let dataGrid = $("#B2BdataGrid").dxDataGrid("instance");

														let rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);

														if (rowIndex !== -1) {

															dataGrid.cellValue(rowIndex, "Item Code", selectedItem.GSCode || "");

															dataGrid.cellValue(rowIndex, "Cost Price", selectedItem.CostPrice || 0);

															dataGrid.cellValue(rowIndex, "GSSellingRate", selectedItem.GSSellingRate || 0);

															dataGrid.cellValue(rowIndex, "Qty", 1);

															dataGrid.cellValue(rowIndex, "VAT%", "15%");

														}

														e.component.close();

													}

												}

											});

										}

									});

									// ✅ Add icon with navigation

									$("<div>").dxButton({

										icon: "plus",

										hint: "Add new item",

										onClick: function () {

										  // Replace or fetch dynamically

											let url = `/${tenantName}/VAT/VATGoodsandServices`; // Example add page

											window.location.href = url;

										},

										width: 60,

										height: 30

									}).appendTo($container);

									// ✅ Edit icon with navigation

									$("<div>").dxButton({

										icon: "edit",

										hint: "Edit item",

										onClick: function () {

										  // Replace or fetch dynamically

											let url = `/${tenantName}/VAT/VATGoodsandServices`; // Example edit page

											window.location.href = url;

										},

										width: 60,

										height: 30

									}).appendTo($container);

								});

							}

						},

						{ dataField: "Descriptions", caption: "...", width: 50 },

						{

							dataField: "UnitRateMethod",

							caption: "Unit Rate Method",

							width: 200,

							editCellTemplate: function (cellElement, cellInfo) {

								getUnitRateMethods().done(function (unitRates) {

									// Create container for dropdown + button

									let $container = $("<div>").css({

										display: "flex",

										alignItems: "center",

										gap: "5px",

										width: "100%"

									}).appendTo(cellElement);

									// DropDownBox inside container

									$("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({

										dataSource: unitRates,

										valueExpr: "UnitCode",

										displayExpr: "UnitDesc",

										value: cellInfo.value || null,

										placeholder: "Select Unit Rate Method",

										dropDownOptions: { width: 600 },

										contentTemplate: function (e) {

											return $("<div>").dxDataGrid({

												dataSource: unitRates,

												keyExpr: "UnitCode",

												selection: { mode: "single" },

												height: 300,

												scrolling: { mode: "virtual" },

												columns: [

														{ dataField: "UnitCode", caption: "Code", width: 80 },

													{ dataField: "UnitDesc", caption: "Unit Rate Method", width: 200 },

													{ dataField: "UnitType", caption: "Unit Type", width: 150 },

													{ dataField: "UnitDescAr", caption: "Unit Code", width: 100 }

												],

												onSelectionChanged: function (selectedItems) {

													let selectedItem = selectedItems.selectedRowsData[0];

