	async function getDocumentCount() {
		const creditNoBox = $("#CreditNoteNo").dxTextBox("instance");
		const creditNo = creditNoBox ? creditNoBox.option("value") : null;
		var menuType = "vat";
		var formType ="e-Invoice CreditNote";
		const response = await fetch(`/api/VATModule/GetInvoiceNoFromCreditNote?creditNoteNo=${encodeURIComponent(creditNo)}`);
		var invoiceNofromSales = await response.text(); // Get Invoice No
		//console.log(invoiceNofromSales);
		var invoiceRes = null, invoiceData = null;
		let folderId2 = "";
		if(invoiceNofromSales?.trim()) {
			invoiceRes = await fetch(`/api/VATModule/GetSONoDNoteNoFromInvoice?invoiceNo=${encodeURIComponent(invoiceNofromSales)}`);
			invoiceData = await invoiceRes.json();
			if (invoiceData) {
				folderId2 = [
					invoiceNofromSales,
					invoiceData.SalesOrderNo,
					invoiceData.QuotationNo,
					invoiceData.DeliveryNoteNos,
					invoiceData.ProformaInvoiceNo
				]
				.filter(Boolean)   //remove null/empty
				.join(",");
			}
		}
		
		const res = await fetch(`/api/LedgerDocumentsF/GetDocuments?folderId=${encodeURIComponent(creditNo)}&module=${encodeURIComponent(formType)}&menuType=${encodeURIComponent(menuType)}&folderId2=${encodeURIComponent(folderId2)}`);
