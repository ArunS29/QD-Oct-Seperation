		 function getDropdownData() {

			return $.ajax({

				url: "/api/VATModule/GetGoodsAndServices", // Update with your actual API endpoint

				method: "GET",

				dataType: "json"

			}).then(function(response) {

				console.log("GsData",response)

				return response.map(item => ({

					GSCode: item.Gscode,

					GSDescrpition: item.Gsdescrpition,

					GsdescriptionAr:item.GsdescriptionAr,

					ItemPartNo: item.ItemPartNo,

					CostPrice: item.CostPrice,

					GSSellingRate: item.GssellingRate,

					ReorderQty:item.ReorderQty

				}));

			});

		}

		function getUnitRateMethods() {

			return $.ajax({

				url: "/api/VATModule/GetAccountGroups", // This should match your actual backend endpoint

				method: "GET",

				dataType: "json"

			}).then(function (response) {

				console.log("Unit Rate Data", response);

				return response.map(item => ({

					UnitCode: item.UnitCode,

					UnitDesc: item.UnitDesc,

					UnitType: item.UnitType,

					UnitDescAr: item.UnitDescAr

				}));

			});

		}




