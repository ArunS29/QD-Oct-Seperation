<div class="title">
    <div class="header-container">
        <div id="DetailsDescription2" class="no-border-title"></div>
    </div>
</div>
<div>

    <!-- Detailed Description Section -->
    <div class="form-group" style="position: relative;">
      @*   <label><b>Detailed Description / Specification:</b></label>
 *@
        <div style="position: absolute; top: 0; right: 0; display: flex; align-items: center; gap: 5px;">
            <a href="javascript:void(0)" id="linkUseItemDesc" style="text-decoration: underline; font-size: 15px;">Use Item Description</a>
                          @(Html.DevExtreme().Button()
            .ID("btnAddDescription")
            .Icon("plus")
            .Width(60))
           @*  .ElementAttr(new { style = "margin-left: 5px;" }) *@
        </div>
    </div>

    <!-- Row 2: Arabic Description + Convert Button -->
    <table style="width: 100%; border-spacing: 10px; border-collapse: separate;">
        <tr>
            <td colspan="4">
                @(Html.DevExtreme().TextArea()
                                .Label(new JS("formatMessage('Detailed Description / Specification:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("DetailedDescription")
                @*     .Height("100% !important") *@
                                .Height(150)
                                .Width("100%")
                                )
            @(Html.DevExtreme().Button()
                        .ID("convertToArabic2")
                        .Width(50)
                        .Icon("fas fa-language")
                        .ElementAttr("style", "padding:10px; color:black;margin-right:10px;")
                        .OnClick("convertToArabic1")
                        )
            </td>
        </tr>
        <tr>
            <td colspan="4">
                
                @(Html.DevExtreme().TextArea()
                                .Label(new JS("formatMessage('Detailed Description / Specification (In Arabic):')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("DetailedDescriptionAr")
                @*     .Height("100% !important") *@
                                .Height(150)
                                .Width("100%")
                                )
            </td>
        </tr>
        <tr>
            <td rowspan="2">
                @(Html.DevExtreme().TextArea()
                    .ID("txtRemarks")
                    .ElementAttr("style", "height:150px !important;")
                    .Label("Remarks:")
                    .LabelMode(EditorLabelMode.Floating)
                )
            </td>
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("Remarks1")
                                .Label("Discount Text:")
                                .LabelMode(EditorLabelMode.Floating)
                                )
            </td>
        </tr>
        <tr>
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("discounttxt")
                                .Label("Discount Text:(Arabic)")
                                .LabelMode(EditorLabelMode.Floating)
                                .Buttons(buttons =>
                                {
                                    buttons.Add()
                                    .Name("discounttxtAr")
                                    .Location(TextEditorButtonLocation.After)
                                    .Widget(w => w.Button()
                                    .Type(ButtonType.Default)
                                    .Icon("fas fa-language")
                                    .ElementAttr(new { @class = "custom-hover-button add-hover" })
                                    );
                                   
                                }))
            </td>
        </tr>



    </table>

</div>

<script>

    $(function () {
            $("#DetailsDescription2").dxTextBox({
                text: formatMessage("Details Description"),
                readOnly: true,
                            onContentReady: function(e) {
                            $(e.element).addClass("dx-textbox-heading");
                    }

            });
    });
     async function convertToArabic1() {
         const textBox1Instance = $("#ItemName").dxTextBox("instance");
         const textBox2Instance = $("#ItemNameArabic").dxTextBox("instance");
         if (!textBox1Instance || !textBox2Instance) {
             console.error("TextBox instances are not properly initialized.");
             return;
         }
         const englishText = textBox1Instance.option("value");
         if (!englishText || englishText.trim() === "") {
             return;
         }
         const arabicTranslation = await translateToArabic(englishText);
         textBox2Instance.option("value", arabicTranslation);
    }
</script>