@page
@model QD.ERP.Web.Areas.VAT.Pages.ProformaDetailDescriptionModel
@{
}
<style>
    .form-wrapper {
        margin: 10px;
        padding: 20px;
        border-radius: 6px;
        width: 97%;
        height: 85%;
    }

    .form-group {
        position: relative;
        padding: 10px;
    }

        .form-group label {
            display: block;
            margin-bottom: 15px;
        }

    .form-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .element.style {
        height: 110px !important;
    }
    /*
        .dx-textarea-input,
        .dx-dropdowneditor-input,
        .dx-datebox-input {
            color: black !important;
            height: 45px !important;
        }

        .dx-textarea, .dx-texteditor-input {
            resize: none;
            font-family: inherit;
            display: block;
            overflow: auto;
            white-space: pre-wrap;
            margin: 0;
            height: 100px !important;
        } */
    .arabic-button {
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .top-buttons {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        gap: 8px;
    }

        .top-buttons .dx-button {
            height: 30px;
            color: black;
        }

    .arabic-textbox-wrapper {
        position: relative;
        width: 100%;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 3em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }

    table tr {
        gap: 10px;
    }
</style>


<div class="title">
    <div class="header-container">
        <div id="DetailsDescription2" class="no-border-title"></div>
    </div>
</div>
<div class="form-wrapper">

    <!-- Detailed Description Section -->
    <div class="form-group" style="position: relative;">
      @*   <label><b>Detailed Description / Specification:</b></label>
 *@
        <div style="position: absolute; top: 0; right: 0; display: flex; align-items: center; gap: 5px;">
            <a href="javascript:void(0)" id="linkUseItemDesc" style="text-decoration: underline; font-size: 15px;">Use Item Description</a>
                          @(Html.DevExtreme().Button()
            .ID("btnAddDescription")
            .Icon("plus")
            .Width(60))
           @*  .ElementAttr(new { style = "margin-left: 5px;" }) *@
        </div>
    </div>

    <!-- Row 2: Arabic Description + Convert Button -->
    <table style="width: 100%; border-spacing: 10px; border-collapse: separate;">
        <tr>
            <td colspan="4">
                @(Html.DevExtreme().TextBox()
                                .Label(new JS("formatMessage('Detailed Description / Specification:')"))
                                .LabelMode(EditorLabelMode.Outside)
                                .ID("DetailedDescription")
                @*     .Height("100% !important") *@
                                .Height(120)
                                .Width("100%")
                                )
            </td>
        </tr>
        <tr>
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("Remarks")
                                .Label("Remarks:")
                                .LabelMode(EditorLabelMode.Outside)
                                )
            </td>
        </tr>



    </table>

</div>

<script>

    $(function () {
            $("#DetailsDescription2").dxTextBox({
                text: formatMessage("Details Description"),
                readOnly: true,
                            onContentReady: function(e) {
                            $(e.element).addClass("dx-textbox-heading");
                    }

            });
    });
</script>