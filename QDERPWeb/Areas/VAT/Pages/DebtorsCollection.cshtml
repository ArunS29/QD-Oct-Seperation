@page
@using DevExtreme.AspNet.Mvc
@{
    ViewData["Title"] = "Trial Balance";
}
<style>

    .limited-footer .btn-containerIvoiceEdit:not(:has(#btnPrint, #btnToggleSearch, #btnToggleHeaderFilter,#ddButtonLayout,#btntoggleGroupPanel,#btnColumnChooser,#btnShowRowTotals,#btnShowFields)) {
        display: none !important;
    }

    .dx-fieldset.horizontal-container {
        display: flex;
        align-items: center;
        gap: 8px; /* Reduce spacing between controls */
    }

    .dx-field {
        margin: 0; /* Remove default margins */
        padding: 5px; /* Reduce spacing */
    }

    .dx-field-4 {
        display: flex;
        flex-direction: column;
        gap: 5px; /* Reduce space between checkboxes and dropdown */
        align-content: center;
    }

    #pivotGridContainer {
        flex-grow: 1;
        width: 100%;
        min-height: 400px;
        max-height: 600px;
        overflow: auto;
        padding: 5px; /* Reduce padding */
    }

    .dx-pivotgrid-container {
        font-size: 13px; /* Slightly reduce font size */
        border-radius: 6px; /* Adjust border-radius */
    }

    .dx-pivotgrid-row, .dx-pivotgrid-column {
        padding: 5px; /* Reduce padding */
        border-bottom: 1px solid #ddd;
    }

    .dx-pivotgrid-cell {
        padding: 6px; /* Reduce cell padding */
    }

        .dx-pivotgrid-cell:hover {
            background-color: #f5f5f5;
        }

    .mainContainer {
        width: 100%;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="DebtorsCollection" class="no-border-input"></div>
    </div>
</div>


<div class="container" style="display: flex; flex-direction: column;width:100%;">

    <div class="Head">
        <div class="limited-footer" style="margin: 10px;"
        >
            @await Html.PartialAsync("VATModuleFooter")
        </div>
    </div>
    <!-- Input Controls in One Line -->
    <div class="horizontal-container">


        <div class="dx-field">
            <!-- Start Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("frmdateBox")
              
                .LabelMode(EditorLabelMode.Floating)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(2)
                )
        </div>

        <div class="dx-field">
            <!-- End Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("todateBox")
         
                .LabelMode(EditorLabelMode.Floating)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(3)
                )
        </div>
        <!-- Dropdown Button to Show Records -->
        @(Html.DevExtreme().DropDownButton()
            .ID("ddBtnShowRecords")
            .Text(new JS("formatMessage('Show Records')"))
            .Icon("smalliconslayout")
            .Width(180)
            .ElementAttr("class", "button-alignment-up")
            .TabIndex(4)
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
            })
            )
       
    </div>

    <!-- Pivot Grid (Will Always Appear Below Filters) -->
    <div id="pivotGridContainer" style="width: 100%;"></div>

</div>


<script type="text/javascript">
    let pivotData = [];
    $(function () {
        $("#DebtorsCollection").dxTextBox({
            text: formatMessage("Debtors Collection"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });

    $(document).ready(function () {
        loadDefaultRecords();
    });

    function loadDefaultRecords() {
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        let lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        fetchRecords(firstDay, lastDay);
    }

    function ddBtnShowRecords_click(option) {
        let today = new Date();
        let startDate = null;
        let endDate = null;

        switch (option) {
            case 'today':
                startDate = today;
                endDate = today;
                break;
            case 'yesterday':
                startDate = new Date();
                startDate.setDate(today.getDate() - 1);
                endDate = startDate;
                break;
            case 'week':
                startDate = new Date();
                startDate.setDate(today.getDate() - today.getDay());
                endDate = today;
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = today;
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = today;
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                break;
            case 'lastmonth':
                startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                break;
            case 'lastyear':
                startDate = new Date(today.getFullYear() - 1, 0, 1);
                endDate = new Date(today.getFullYear() - 1, 11, 31);
                break;
            case 'range':
            default:
                startDate = $("#frmdateBox").dxDateBox("instance").option("value");
                endDate = $("#todateBox").dxDateBox("instance").option("value");

                if (!startDate || !endDate) {
                    DevExpress.ui.notify("Please select both From Date and To Date.", "warning", 3000);
                    return;
                }
                break;
        }

        // Set the DateBoxes with selected dates
        $("#frmdateBox").dxDateBox("instance").option("value", startDate);
        $("#todateBox").dxDateBox("instance").option("value", endDate);

        fetchRecords(startDate, endDate);
    }

    function fetchRecords(startDate, endDate) {
        console.log("Fetching records between:", formatDate(startDate), "and", formatDate(endDate));

        $.ajax({
            url: '/api/VATModule/GetDebtorsCollection',
            type: 'GET',
            data: {
                startDate: formatDate(startDate),
                endDate: formatDate(endDate)
            },
            success: function (data) {
                pivotData=data;
                initializePivotGrid(data);
            },
            error: function (xhr, status, error) {
                console.error("Error fetching records:", error);
            }
        });
    }

    function initializePivotGrid(data) {
        var pivotGrid = $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                store: {
                    type: "array",
                    data: data
                },
                fields: [
                    { dataField: "AccountHead", area: "row", caption: "Client Name" },
                    { dataField: "DrAmount", area: "data", caption: "Invoiced Amount", summaryType: "sum", format: { type: "fixedPoint", precision: 2 } },
                    { dataField: "CrAmount", area: "data", caption: "Received/ Credited Amount", summaryType: "sum", format: { type: "fixedPoint", precision: 2 } },
                    { dataField: "VoucherMonth", area: "column", caption: "Transaction Month", dataType: "date", format: "MMM-yyyy" }

                ]

            },
            width: "100%",
            height: $(window).height() - 50,
            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            rowHeaderLayout: "standard",
            wordWrapEnabled: true,
            fieldChooser: {
                enabled: true,
                allowSearch: true
            },
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showRowFields: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true
            },
            showColumnTotals: true,
            showColumnGrandTotals: true,
            showDataHeaders: true,
            showRowTotals: true,
            showRowGrandTotals: true,
             onCellPrepared(e) {
      if (e.area === "row" ) {
        // Reset counter when starting new row set
        if (e.rowIndex === 0) serialCounter = 1;

        // Apply prefix only to first level row items (no nested rows)
        e.cellElement.text(`${serialCounter++}. ${e.cell.text}`);
      }
    }
        }).dxPivotGrid("instance");

        // Expand rows initially
        setTimeout(function () {
            var dataSource = pivotGrid.getDataSource();
            var rows = dataSource.getData().rows;
            rows.forEach(function (row) {
                if (row.text) {
                    dataSource.expandHeaderItem("row", [row.text]);
                }
            });
        }, 100);

        // Resize pivot on window resize
        $(window).resize(function () {
            pivotGrid.option("height", $(window).height() - 50);
        });

        // Some style tweaks
        $(".dx-pivotgrid-container").css({
            "font-size": "14px",
            "border-radius": "8px"
        });

        $(".dx-pivotgrid-row, .dx-pivotgrid-column").css({
            "padding": "10px",
            "border-bottom": "1px solid #ddd"
        });

        $(".dx-pivotgrid-cell").hover(
            function () {
                $(this).css("background-color", "#f5f5f5");
            },
            function () {
                $(this).css("background-color", "");
            }
        );
    }

    function formatDate(date) {
        if (!date) return null;
        if (typeof date === 'string') date = new Date(date);
        return date.toISOString().split('T')[0];
    }
    $(document).ready(function () {
        $(".limited-footer .btn-container").each(function () {
            if (!$(this).find("#btnPrint, #btnToggleSearch, #btnToggleHeaderFilter,#ddButtonLayout,#btntoggleGroupPanel,#btnColumnChooser,#btnShowRowTotals,#btnShowFields").length) {
                $(this).remove();
            }
        });
    });



       let extraFieldsVisible = false;

    $("#btnShowFields").on("click", function (e) {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        const dataSource = pivotGrid.getDataSource();

        const baseFields = [
            { dataField: "AccountHead", area: "row", caption: "Client Name" },
            { dataField: "DrAmount", area: "data", caption: "Invoiced Amount", summaryType: "sum", format: { type: "fixedPoint", precision: 2 } },
            { dataField: "CrAmount", area: "data", caption: "Received/ Credited Amount", summaryType: "sum", format: { type: "fixedPoint", precision: 2 } },
            { dataField: "VoucherMonth", area: "column", caption: "Transaction Month", dataType: "date", format: "MMM-yyyy" },
        ];

        const extraFields = [
            { dataField: "ReferenceNo", area: "filter", caption: "Reference No" },
            { dataField: "AccountNo", area: "filter", caption: "Ledger No" },
            { dataField: "Amount", area: "filter", caption: "Amount" },
            { dataField: "DrCr", area: "filter", caption: "Dr Cr" },
            { dataField: "VoucherAmountFormatted", area: "filter", caption: "Voucher Amount Formatted", format: { type: "fixedPoint", precision: 2 } },
            { dataField: "AccountGroup", area: "filter", caption: "Account Group" },
            { dataField: "MasterGroup", area: "filter", caption: "Master Group" },
            { dataField: "AccountHeadNo", area: "filter", caption: "Account Head No" },
            { dataField: "EntryNarration", area: "filter", caption: "Entry Narration" },
            { dataField: "SysRemarks", area: "filter", caption: "Sys Remarks" },
            { dataField: "VoucherDate", area: "filter", caption: "Voucher Date", dataType: "date" },
            { dataField: "VoucherEffectiveDate", area: "filter", caption: "Effective Date", dataType: "date" },
            { dataField: "EffectiveMonth", area: "filter", caption: "Effective Month" },
            { dataField: "InvoiceSalesPersonCode", area: "filter", caption: "Invoice Sales Person Code" },
            { dataField: "InvoiceSalesPersonName", area: "filter", caption: "Invoice Sales Person Name" },
            { dataField: "VoucherNo", area: "filter", caption: "Voucher No" }
        ];

        // Toggle logic
        if (!extraFieldsVisible) {
            dataSource.fields([...baseFields, ...extraFields]);
            pivotGrid.option("dataSource", dataSource); // reassign DS
            extraFieldsVisible = true;
        } else {
            dataSource.fields(baseFields);
            pivotGrid.option("dataSource", dataSource); // reassign DS
            extraFieldsVisible = false;
        }

        dataSource.load(); // reload grid
    });


       $('#btnShowRowTotals').click(function () {
        showrowtotal(pivotData); // Correctly passing the data array
    });


            function showrowtotal(pivotData) {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        console.log("pivotData", pivotData);

        // Group by CostAllocationUnit (Cost Group)
        const grouped = {};
        pivotData.forEach(item => {
            const groupKey = item.AccountHead;
            if (!groupKey) return; // Skip if no group key
            if (!grouped[groupKey]) grouped[groupKey] = [];
            grouped[groupKey].push(item);
        });

        console.log("Grouped:", pivotData);

        // Create total rows for each Cost Group
        const totalRows = Object.entries(grouped).map(([groupName, rows]) => {
            const totalIncome = rows.reduce((sum, r) => sum + (r.DrAmount || 0), 0);


            return {
                AccountHead: groupName + " Total",
                DrAmount: totalIncome

            };
        });

        // Debug: Check totals
        console.log("Total Rows:", totalRows);

        const updatedData = [...pivotData, ...totalRows];

        // Refresh PivotGrid with updated data
        pivotGrid.option("dataSource", {
            fields: [
                { dataField: "AccountHead", area: "row", caption: "Client Name" },
                { dataField: "DrAmount", area: "data", summaryType: "sum", caption: "Invoiced Amount" }
            ],
            store: updatedData
        });
    }
    function customFormatter(cellInfo) {
        const value = cellInfo.value;
        if (value < 0) {
            return "-" + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        } else {
            return value.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        }
    }

</script>



