					// Disable all dxButton and dxDropDownButton controls
					$('.dx-button').each(function () {
						const id = $(this).attr('id');
						if (id && !allowedButtons.includes(id)) {
							// Disable dxButton and dxDropDownButton widgets except for allowed ones
							if ($(this).data('dxButton')) {
								$(this).dxButton('option', 'disabled', true);
							}
						}
					});
				}

	          let isVoucherSaved = false;

       function getWorkflowStatusFromFields() {
        const verified = $("#VerifiedBy").dxCheckBox("option", "value") === true;
        const approved = $("#ApprovedBy").dxCheckBox("option", "value") === true;

        if (approved) return 3; // Final state
        if (verified) return 2;
        if (isVoucherSaved) return 1;

        return 0;
    }


     function updateWorkflowVisual(status) {
        const steps = [
            { id: "step-update", icon: "fas fa-user" },
            { id: "step-verify", icon: "fas fa-briefcase" },
            { id: "step-approve", icon: "fas fa-file-alt" }
        ];

        steps.forEach((step, index) => {
            const el = document.getElementById(step.id);
            const statusMsg = el.querySelector(".step-status-msg");
            const icon = el.querySelector("i");

            el.classList.remove("completed", "current", "upcoming", "done");
            icon.className = step.icon;

            if (index < status) {
                el.classList.add("completed");
                statusMsg.textContent = "Done";
                icon.className = "fas fa-check-circle";
            } else if (index === status && status < 3) {
                el.classList.add("current");
                statusMsg.textContent = "In Progress";
                icon.className = "fas fa-spinner fa-spin";
            } else {
                el.classList.add("upcoming");
                statusMsg.textContent = "Pending";
            }

            // Final Approved state
            if (status === 3 && index === 2) {
                el.classList.add("completed");
                statusMsg.textContent = "Done";
                icon.className = "fas fa-check-circle";
            }
        });
    }




        function syncWorkflowFromFields() {
            const status = getWorkflowStatusFromFields();
            updateWorkflowVisual(status);
        }

        function attachWorkflowWatchers() {
            $("#VerifiedBy").dxCheckBox("option", "onValueChanged", syncWorkflowFromFields);
            $("#ApprovedBy").dxCheckBox("option", "onValueChanged", syncWorkflowFromFields);
        }

        $(function () {
            setTimeout(() => {
                attachWorkflowWatchers();
                syncWorkflowFromFields();
                 // bindWorkflowPopovers();
                 initWorkflowTippyPopovers();

            }, 300);
        });


    function formatDate(date) {
        if (!date) return "N/A";
        const d = new Date(date);
        return d.toLocaleDateString() + " " + d.toLocaleTimeString();
    }

    function initWorkflowTippyPopovers() {
        // 🧼 Clean up any old tippy instances
        tippy.hideAll();
        document.querySelectorAll('[data-tippy-root]').forEach(el => el.remove());

        const verifiedBy = $("#VerifiedBytext").dxTextBox("instance")?.option("value") || "N/A";
        const verifiedOn = $("#VerifiedOnDate").dxTextBox("instance")?.option("value") || "N/A";
        const approvedBy = $("#ApprovedBytext").dxTextBox("instance")?.option("value") || "N/A";
        const approvedOn = $("#ApprovedOntext").dxTextBox("instance")?.option("value") || "N/A";

        console.log("🧪 Tooltip data:", {
            verifiedBy, verifiedOn, approvedBy, approvedOn
        });

        // 🟩 Verified Popover
        tippy('#circle-verify', {
            content: `✅ Verified by: <strong>${verifiedBy}</strong><br>📅 On: ${verifiedOn}`,
            allowHTML: true,
            followCursor: 'horizontal',
            placement: 'top',
            animation: 'shift-away',
            theme: 'light-border',
            trigger: 'mouseenter focus',
            delay: [100, 100],
        });

        // 🟩 Approved Popover
        tippy('#circle-approve', {
            content: `✅ Approved by: <strong>${approvedBy}</strong><br>📅 On: ${approvedOn}`,
            allowHTML: true,
            followCursor: 'horizontal',
            placement: 'top',
            animation: 'shift-away',
            theme: 'light-border',
            trigger: 'mouseenter focus',
            delay: [100, 100],
        });
    }

        function loadCurrencyGridOnOpen(e) {
        debugger;
        const dropDown = e.component;
        const baseCurrencyId = $("#ddlBaseCurrency").dxDropDownBox("instance").option("value");

        if (!baseCurrencyId) return;

        const grid = $("#currency-datagrid").dxDataGrid("instance");
        if (!grid) return;

        DevExpress.data.AspNet.createStore({
            key: "CurrencyExchangeId",
            loadUrl: `/api/Utility/GetCurrencyListWithRates?baseCurrencyId=${baseCurrencyId}`
        }).load().done(data => {
            grid.option("dataSource", data);
            dropDown.option("dataSource", data);
        });
    }

</script>

