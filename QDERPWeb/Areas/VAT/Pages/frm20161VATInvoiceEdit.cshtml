			onEditorPreparing: function (e) {
		if (e.parentType === "dataRow" && ["QuantityInvoiced", "UnitRate", "Discount"].includes(e.dataField)) {
			e.editorOptions.onValueChanged = function (args) {
				
					let grid = $("#B2BdataGrid").dxDataGrid("instance");
					let rowIndex = e.row.rowIndex;
					rowIx=rowIndex;
						debugger;
					let newValue = args.value;
					let qty = e.dataField === "QuantityInvoiced" ? newValue : grid.cellValue(rowIndex, "QuantityInvoiced") || 0;

	                if (qty <= 0) {

					DevExpress.ui.dialog.alert(
						"Quantity cannot be zero or negative.",
						"Quantity Error"
						)
                 	}
					else
					{
							let unitPrice = e.dataField === "UnitRate" ? newValue : grid.cellValue(rowIndex, "UnitRate") || 0;
						let discount = e.dataField === "Discount" ? newValue : grid.cellValue(rowIndex, "Discount") || 0;

						// VAT rate handling
						let vatRateStr = e.dataField === "VATPercentage" ? newValue : grid.cellValue(rowIndex, "VAT%") || "0%";
						let vatRate = parseFloat(vatRateStr.replace("%", "")) / 100;

						// Calculate amount
						let amount = qty * unitPrice;
						let discountedAmount = amount - discount;

						// Ensure discountedAmount doesn't go negative
						if (discountedAmount < 0) discountedAmount = 0;

						let vatValue = discountedAmount * vatRate;
						let totalValue = discountedAmount + vatValue;

						// Update grid cells
						grid.cellValue(rowIndex, "VAT", vatValue.toFixed(2));
						grid.cellValue(rowIndex, "Total", totalValue.toFixed(2));
						grid.cellValue(rowIndex, "Unit Price",unitPrice);
						grid.cellValue(rowIndex, "Total Before Discount",unitPrice);
						grid.cellValue(rowIndex, "Amount",amount.toFixed(2));
						grid.cellValue(rowIndex, "Discount",discount);
						grid.cellValue(rowIndex, "Qty", qty);
						grid.cellValue(rowIndex, "VAT%", vatRateStr);

							applyDiscount(amount.toFixed(2));

							//applyDiscount(rowIndex);
					}
			};
		}
	}

    }).dxDataGrid("instance");
}


