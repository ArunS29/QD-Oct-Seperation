																			})
																			.ShowClearButton(true)
																			.AcceptCustomValue(true)
																			.OpenOnFieldClick(false)
																			.ValueChangeEvent("input")
																			.HoverStateEnabled(true)
																			.Value(null)
																			.ValueExpr("AccountId")
																			.DisplayExpr("AccountHead")
																			.Width("100%")
																			.TabIndex(1)
																			.DropDownOptions(o => o
																			//.Width("100%") // Set the desired width for the dropdown content*@
																			.Width(1000)
																			)
