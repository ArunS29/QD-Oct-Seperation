									new { ID = 1, Name = "3rd Party Tax Invoice" },
									new { ID = 2, Name = "Nominal Tax Invoice" },
									new { ID = 3, Name = "Export Tax Invoice" },
									new { ID = 4, Name = "Summary Tax Invoice" },
									new { ID = 5, Name = "Self Billed Tax Invoice" }
									})
																			.OnInitialized("onDropDownInitialized")
