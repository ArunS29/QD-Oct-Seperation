						rowData.AccountHead = e.value; // Update the row data
						grid.cellValue(rowIndex, "AccountHead", e.value); // Ensure it reflects in the grid

					}
					// Close the dropdown after selection
					e.component.option("opened", false);

				}

			function onEditorPreparing(e) {

		if (e.parentType === "dataRow" && (e.dataField === "Qty" || e.dataField === "UnitPrice" || e.dataField === "VATPercentage")) {
			e.editorOptions.onValueChanged = function (args) {
				let grid = $("#B2BdataGrid").dxDataGrid("instance");
				let rowIndex = e.row.rowIndex;
		

				// Get the updated value from the input field
				let newValue = args.value;
				console.log("gridnewvalue",newValue)
				// Get existing values
				let qty = e.dataField === "Qty" ? newValue : grid.cellValue(rowIndex, "Qty") || 0;
				console.log("qty",qty)

				 let unitPrice = e.dataField === "UnitPrice" ? newValue : grid.cellValue(rowIndex, "UnitPrice") || 0;
				 console.log("unitPrice",unitPrice)
				// let vatRate = (e.dataField === "VAT%" ? newValue : grid.cellValue(rowIndex, "VAT%")) || 0;
				let vatval=grid.cellValue(rowIndex, "VAT%");
				 console.log("VATVal",vatval)

				let vatRateStr = e.dataField === "VATPercentage" ? newValue : grid.cellValue(rowIndex, "VAT%") || "0%";
				console.log("vatRateStr",vatRateStr)

				let vatRate = parseFloat(vatRateStr.replace("%", "")) / 100; // Convert "15%" → 15 → 0.15
				console.log("vatRate",vatRate)

				// Calculate values
				let amount = qty * unitPrice;
				 console.log("amount",amount)

				let vatValue = amount * vatRate;
				console.log("vatValue",vatValue)

				let totalValue = amount + vatValue;
				console.log("totalValue",vatValue)

