					}
					if (e.value) {


						let grid = $("#dataGrid").dxDataGrid("instance");
						let rowIndex = e.element.closest("tr").index(); // Get the edited row index
						let rowData = grid.getVisibleRows()[rowIndex].data;

						let costAllocationDropdownGrid = $("#accountDropDownBoxeditGrid").dxDataGrid("instance");
