@page
@using DevExtreme.AspNet.Mvc
@model QD.ERP.Web.Areas.Finance.Pages.LedgerAccountModel
@{
}

<style>
	.address-form-container {
		padding: 8px;
		box-sizing: border-box;
		width: 100%;
		font-size: 12px;
	}

	.address-form-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
	}

		.address-form-table td {
			padding: 6px;
			vertical-align: top;
			width: 33%;
		}

		.address-form-table label {
			display: block;
			font-weight: bold;
			font-size: 11px;
			margin-bottom: 3px;
			white-space: nowrap;
			color: black;
		}

		.address-form-table input[type="text"],
		.address-form-table select {
			width: 100%;
			padding: 4px;
			font-size: 11px;
			border: 1px solid #aaa;
			border-radius: 3px;
			box-sizing: border-box;
		}
	.body {
	padding-top: 0px;
	}

	.content {
	margin: 0px;
	}

	.icon-btn {
		background-color: #ffffff;
		border: 1px solid #d1d5db; /* soft gray border */
		border-radius: 6px;
		margin-top: 24px; /* aligns with DevExtreme label */
		padding: 0;
		height: 38px;
		width: 38px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
	}

		.icon-btn:hover {
			background-color: #f3f4f6; /* light hover */
			border-color: #9ca3af;
		}

		.icon-btn i {
			font-size: 14px;
			color: #374151; /* neutral icon */
		}

	
	.content-container-top {
	width: 1700px;
	}
	/* Custom CSS to adjust the height of tab headers */
	.dx-tabpanel .dx-tab {
	padding: 10px 15px; /* Adjust padding to change height */
	font-size: 16px; /* Adjust font size to change header height */
	}

	/* Ensuring the content area also adjusts in height */
	.dx-tabpanel .dx-tab-content {
	padding: 20px;
	min-height: 200px; /* Minimum height for the tab content */
	}

	.dx-fieldset {
	margin: 3px 3px !important;
	padding: 0px;
	}

	.dx-datagrid-headers th {
	text-align: center; /* Centers the text */
	}

	.columnheader {
	text-align: center;
	}

	.tab-content {
	display: none;
	}

	.tab-content.active {
	display: block;
	}

	.tab-content h3 {
	color: #333;
	}

	.tab-content p {
	line-height: 1.6;
	color: #555;
	}

	.dx-dropdownbox .dx-dropdownbox-wrapper .dx-dropdownbox-header {
	display: none;
	}

	.button-group {
	margin-left: 1px !important;
	}

	.button-alignment-up {
	margin-top: 25px !important;
	}

	.button-alignment-down {
	margin-top: 0px !important;
	}

	/*     .dx-editor-outlined .dx-label span {
	font-weight:bold !important;
	} */

	.custom-textbox input {
	font-weight: bold !important;
	color: black !important; /* Use !important to override DevExtreme styles */
	/*   border: 3px solid #282222;
	border-radius: 8px !important; */
	}

	.custom-textbox1 input {
	border: 3px solid #282222;
	/* border-radius: 8px !important; */
	}

	.custom-textbox1 .dx-dropdowneditor-icon {
	border: 3px solid #282222 !important;
	/*  border-radius: 8px !important; */
	}


	.close {
	color: #aaa;
	float: right;
	font-size: 28px;
	font-weight: bold;
	cursor: pointer;
	}

	.close:hover,
	.close:focus {
	color: black;
	}

	.containerLedgerAccount {
	display: flex;
	align-items: center;
	justify-content: center;
	}

	.titleLedgerAccount {
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 1.5em;
	}

	.no-border-input {
	border: none !important;
	outline: none !important;
	box-shadow: none !important;
	background: transparent !important;
	font-weight: bold;
	font-size: 16px;
	color: black;
	pointer-events: none; /* Prevents hover and click effects */
	}

	.container {
	display: none !important;
	}

	.frame {
	display: none !important;
	}

	.footerContainer {
	display: none !important;
	}

	.bodyContainer {
	display: flex;
	justify-content: center;
	}

	.mainContainer {
	margin-top: 1em;
	width: 100%;
	}

	.card-container {
	display: flex;
	justify-content: space-between;
	gap: 20px;
	}

	.card {
	flex: 1;
	padding: 15px;
	border: 1px solid #ddd;
	border-radius: 5px;
	box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
	background: #fff;
	}

	.limited-footer .btn-container:not(:has(#btnMoveDown,#btnMoveUp,#btnSave,#btnSaveAndClose,#btnPrint1,#btnAddNew,#btnDelete,#btnBack,#btnVerify,#btnApprove,#btnAttach,#btnPostToLedgers,#btnPostTag)) {
	display: none !important;
	}
	.playIcon {display: none;	}

</style>
<link rel="stylesheet" href="~/css/Site.css" />
