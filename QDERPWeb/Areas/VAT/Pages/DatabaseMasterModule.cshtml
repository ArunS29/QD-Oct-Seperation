@page
@model QD.ERP.Web.Areas.Finance.Pages.DatabaseMasterModuleModel
@{
}

<style>
    .dx-fieldset {
        margin-bottom: 5px;
    }

    .dx-field-container{
        width:  500px ! important;
    }

    .dx-field label {
        width: 200px;
        font-weight: bold;
        color: #333;
        text-align: right;
        padding-right: 10px;
    }

    .dx-field {
        display: flex;
        align-items: flex-end;
      
       /*  width: 400px ! important ; */
      /*   height: 100px ! important ; */

    }



    .dx-fieldset .dx-field-container {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        /* margin-top: 12px; */
      
    }

/*     .dx-editor-outlined    {
        margin-top: 24px;
        width: 520px !important; */
    }
    .dx-field-container div {
        display: flex;
        flex-direction: column;
    }

    .limited-footer .btn-container:not(:has(#btnMoveDown,#btnMoveUp,#btnSave,#btnSaveAndClose,#btnPrint1,#btnAddNew,#btnDelete,#btnBack,#btnVerify,#btnApprove,#btnAttach,#btnPostToLedgers,#btnPostTag)) {
        display: none !important;
    }

    .dx-button {
        margin-top: 10px;
        height: 38px;
        display: flex;
        align-items: center;
    }

    .dx-button-custom .dx-button-content {
        border-radius: 6px;
        font-weight: 600;
        min-width: 120px; /* Reduced min-width for small screens */
        max-width: 100%; /* Avoid overflow */
        padding: 8px 14px;
        transition: background-color 0.3s, color 0.3s;
        text-align: center;
    }
    .dx-button-custom.btn-save .dx-button-content {
        background-color: #007bff;
        color: #fff;
        border: 1px solid #007bff;
    }

    .dx-button-custom.btn-save:hover .dx-button-content {
        background-color: #0069d9;
    }
    

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
        background-color: aliceblue;
    }

    .mainContainer {
        margin-top: 1em;
    }
</style>
<div class="title">
    <div class="header-container">
        <div id="DatabaseMasterModule" class="no-border-title"></div>
    </div>
</div>
        <div id="TypeCurrency" class="no-border-input"></div>
<div class="dx-fieldset" style="display:flex; align-items: flex-end;">

    <div style="display:flex; align-items: flex-end;">
        <div class="dx-field">
            @(Html.DevExtreme().TextBox()
                .Label(new JS("formatMessage('Currency Name:')"))
                .LabelMode(EditorLabelMode.Floating)
                .ID("txtCurrencyName")
                .Width(400)
                )
            @(Html.DevExtreme().Button()
                .ID("currencyNameArabicConvert")
                .Icon("fas fa-language")
                .ElementAttr(new { @class = "input-button" })
                .OnClick("function() { convertCurrencyNameToArabic(); }")
                )
        </div>
        <div class="dx-field">
            @(Html.DevExtreme().TextBox()
                .Label(new JS("formatMessage('Currency Name (In Arabic):')"))
                .LabelMode(EditorLabelMode.Floating)
                .ID("txtCurrencyNameAr")
                .Width(400)

                )
        </div>
    </div>
</div>

<div class="dx-fieldset" style="display:flex; align-items: flex-end;">
    <div style="display:flex; align-items: flex-end;"> 
        <div class="dx-field">
            @(Html.DevExtreme().TextBox()
                .Label(new JS("formatMessage('Currency Code:')"))
                .LabelMode(EditorLabelMode.Floating)
                .ID("txtCurrencyCode")
                .Width(400))
            @(Html.DevExtreme().Button()
                .ID("currencyCodeArabicConvert")
                .Icon("fas fa-language")
                .ElementAttr(new { @class = "input-button" })
                .OnClick("function() { convertDetailedDescToArabic(); }")
                )
         </div>
        <div class="dx-field">
            @(Html.DevExtreme().TextBox()
                .Label(new JS("formatMessage('Currency Code (In Arabic):')"))
                .LabelMode(EditorLabelMode.Floating)
                .ID("txtCurrencyCodeAr")
                .Width(400))
        </div>
    </div>   
 </div>

<div class="dx-fieldset" style="display:flex; align-items: flex-end;">
    <div style="display:flex; align-items: flex-end;">
        <div class="dx-field">
            @(Html.DevExtreme().NumberBox()
                .ID("currencyexchangerate")
                .Label(new JS("formatMessage('Currency Exchange Rate:')"))
                .LabelMode(EditorLabelMode.Floating)
                .Min(1)
                .Step(1)
                .ShowSpinButtons(true)
                .Width(400)
                )
        </div>
        <div class ="dx-field">
            @(Html.DevExtreme().Button()
                .ID("btnAddCurrency")
                .Icon("plus")
                .Text(new JS("formatMessage('Add')"))
                .Width(100)
                .OnClick("addCurrency")
                )
        </div>
    </div>
</div>

<div class="ledgerResult">

@(Html.DevExtreme().DataGrid()
    .ID("gridCurrencyMaster")
   .DataSource(new JS("[]")) // Assuming a Model with Currency List.
    .ShowBorders(true)
        .Height(350) // Increase height
        .Width("100%")
    .Columns(columns =>
    {
        columns.Add().DataField("ID").Caption(new JS("formatMessage('ID')")).Width(70);
        columns.Add().DataField("CurrencyName").Caption(new JS("formatMessage('Currency Name')")).Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("CurrencyNameAr").Caption(new JS("formatMessage('Currency Name Ar')")).Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("ExchangeRate").Caption(new JS("formatMessage('Exchange Rate')")).Format("#,##0.##").Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("CurrencyCode").Caption(new JS("formatMessage('Currency Code')")).Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("CurrencyCodeAr").Caption(new JS("formatMessage('Currency Code Ar')")).Alignment(HorizontalAlignment.Center);
    })
)
</div>
<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("VATModuleFooter")
    </div>
</div>


<script>
    $(document).ready(function () {

        $(".limited-footer .btn-containerIvoiceEdit").each(function () {

            if (!$(this).find("#btnUpdate,#btnBack").length) {

                $(this).remove();

            }

        });

    });
    function addCurrency() {
        // Add currency logic here
        DevExpress.ui.notify("Currency Added Successfully", "success", 2000);
    }

    function updateCurrency() {
        // Update logic here
        DevExpress.ui.notify("Updated Successfully", "success", 2000);
    }

    function goBack() {
        // Navigation logic here
        window.history.back();
    }
     $(function () {
            $("#DatabaseMasterModule").dxTextBox({
                text: formatMessage("Database Master Module:Foriegn Currency Master"),
                readOnly: true,
                width: "600px",
                onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
            });
        });
    $(function () {
        $("#TypeCurrency").dxTextBox({
            width: "600px",
            text: formatMessage("Type a New Currency Details & Add to the Existing List:"),
            readOnly: true,
            
        });
    });


    async function convertDetailedDescToArabic() {
        const englishBox = $("#txtCurrencyCode").dxTextBox("instance");
            const arabicBox = $("#txtCurrencyCodeAr").dxTextBox("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a detailed description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    async function convertCurrencyNameToArabic() {
        const englishBox = $("#txtCurrencyName").dxTextBox("instance");
            const arabicBox = $("#txtCurrencyNameAr").dxTextBox("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a detailed description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }
</script>

