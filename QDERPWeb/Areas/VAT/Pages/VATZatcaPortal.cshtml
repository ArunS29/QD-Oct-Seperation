					<td>@(Html.DevExtreme().TextBox().Label(new JS("formatMessage('Hash of XML File')")).ID("txtHashXmlFile").LabelMode(EditorLabelMode.Outside).Width(350))</td>
					<td>@(Html.DevExtreme().TextBox().Label(new JS("formatMessage('ECDSA signature of the XML Hash(Digest Value)-Base64')")).ID("txtECDSASignatureBase64").LabelMode(EditorLabelMode.Outside).Width(350))</td>
