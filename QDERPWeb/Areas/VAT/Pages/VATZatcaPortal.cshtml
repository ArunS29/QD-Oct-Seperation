<script>

	$(document).ready(function () {

				var selectedTabIndex = 0;
				$("#tab-content-" + (selectedTabIndex + 1)).show();
			});
				function onTabSelectionChanged(e) {
					// Hide all tab content
					$(".tab-content").hide();

					// Show the content of the selected tab
					var selectedTabIndex = e.component.option("selectedIndex");
					$("#tab-content-" + (selectedTabIndex + 1)).show();
				}

   var qrText = "Sample QR Data for Invoice or anything else";

	// Generate QR code
	var qrcode = new QRCode(document.getElementById("qrcode"), {
		text: qrText,
		width: 450,
		height: 450
	});


	 $(document).ready(function () {
		 // Example: bind to a button click
			 DevExpress.ui.dialog.custom({
				 title: "Fatoora Portal",
				 message: "Connection to Fatoora Portal is available,Would you like to Submit the Invoice to Zatca Portal?",
				 buttons: [
					 { text: "Yes", onClick: () => true },
					 { text: "No", onClick: () => false }
				 ],
				 showTitle: true
			 }).show().done(function (dialogResult) {
				 if (dialogResult) {
					  generateZatcaInvoice(); // Your custom logic here
				 }
			 });
	 });


		function generateZatcaInvoice() {
			debugger;
		const invoiceData = {
			invoiceNo: "INV-001",
			buyerName: "Customer ABC",
			buyerVATNumber: "312345678900003",
			invoiceDate: new Date().toISOString(),
			invoiceTotal: 115.00,
			vatAmount: 15.00,
			sellerName: "JUICE SHOP",
			sellerVATNumber: "123456789000003"
		};

		$.ajax({
			type: "POST",
			url: "/api/VATModule/GenerateZatcaInvoiceXml",
			contentType: "application/json",
			data: JSON.stringify(invoiceData),
			success: function (response) {
				console.log("ZATCA XML:", response.InvoiceXml);
				 console.log("TLV Base64:", response.TLVBase64);
				 console.log("QR Code Base64:", response.QRBase64);

				// Show QR image on the page
				  $("#qrcode").attr("src", "data:image/png;base64," + response.QRBase64);

				// Show raw XML (optional)
				$("#zatcaXml").text(response.invoiceXml);
			},
			error: function (xhr) {
				console.error("Error:", xhr.responseText);
				DevExpress.ui.notify("Failed to generate ZATCA Invoice XML", "error", 3000);
			}
		});
	}

		


</script>


