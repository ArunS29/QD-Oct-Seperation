<div class="Head">
	<div class="limited-footer">
		@await Html.PartialAsync("VATModuleFooter")
	</div>
</div>
<div id="overlay" class="overlay">
	<div class="overlay-content">
		<span class="close-btn" onclick="closeOverlay()">×</span>
		<iframe id="overlay-frame" src="" frameborder="0"></iframe>
	</div>
</div>
<script>
	 $(document).ready(function () {
		$(".limited-footer .btn-containerIvoiceEdit").each(function () {
				if (!$(this).find("#ddButtonLayout,#btnToggleSearch,#btnPrint,#btntoggleGroupPanel").length) {
				$(this).remove();
			}
		});
	});

	$(function () {
					$("#Stockinventorylist").dxTextBox({
						text: formatMessage("Stock Inventory List"),
						width:480,
						readOnly: true,
									onContentReady: function(e) {
									$(e.element).addClass("dx-textbox-heading");
							}

					});
				});
</script>