		let i = 0;
		const el = document.getElementById("todayCount");
		if (!el) return;

		el.classList.remove('bounce');

		const timer = setInterval(() => {
			if (i >= target) {
				el.innerText = target;
				el.classList.add('bounce');
				clearInterval(timer);
			} else {
				el.innerText = i++;
			}
		}, 30);
	}

	const card = document.getElementById('mainCard');
	const counts = [0, 0, 0]; // [Verified, Approved, Submitted]
	const countEls = [
	  document.getElementById("count0"),
	  document.getElementById("count1"),
	  document.getElementById("count2"),
	];
	const tabs = document.querySelectorAll(".tab-text");
	const contents = document.querySelectorAll(".tab-content");

	function animateCount(el, target) {
	  let i = 0;
	  el.innerText = i;
	  el.classList.remove('bounce');
	  const interval = setInterval(() => {
		if (i >= target) {
		  el.innerText = target;
		  el.classList.add('bounce');
		  clearInterval(interval);
		} else {
		  el.innerText = i++;
		}
	  }, 30);
	}

	function switchTab(index) {
	  tabs.forEach((tab, i) => {
		tab.classList.toggle('active', i === index);
		contents[i].classList.toggle('active', i === index);
	  });

	  // Change background class
	  card.className = "card";
	  if (index === 0) card.classList.add("today-bg");
	  if (index === 1) card.classList.add("week-bg");
	  if (index === 2) card.classList.add("month-bg");

	  // Animate count
	  animateCount(countEls[index], counts[index]);
	}

	// ✅ Count Approved Invoices From Grid
		function updateApprovedCountFromGrid() {
		const grid = $("#dataGrid").dxDataGrid("instance");
		const data = grid.getVisibleRows().map(row => row.data);

		// Update dynamic counts based on status
		counts[0] = data.filter(item => item.InvoiceStatus === "Verified").length;
		counts[1] = data.filter(item => item.InvoiceStatus === "Approved").length;
		counts[2] = data.filter(item => item.InvoiceStatus === "Posted").length;

		// Update visible numbers
		countEls[0].textContent = counts[0];
		countEls[1].textContent = counts[1];
		countEls[2].textContent = counts[2];

		// Animate default tab (Verified)
		animateCount(countEls[0], counts[0]);
	}
		function updateInvoiceAmountFromGrid() {
		const grid = $("#dataGrid").dxDataGrid("instance");
		const summaryItems = grid.getTotalSummaryValue("CalcLineAmount");

		const totalAmount = summaryItems != null ? summaryItems : 0;
		const formatted = totalAmount.toLocaleString(undefined, {
			minimumFractionDigits: 2,
			maximumFractionDigits: 2
		});

		document.getElementById("invoiceAmount").textContent = formatted + " SAR";
	}

	// 🔁 Called after DataGrid loads
		function onGridContentReady(e) {
		updateApprovedCountFromGrid();
		updateInvoiceAmountFromGrid();
	}





	




	function UnlockInvoice() {

			if (InvoiceStatus === "Posted") {
		DevExpress.ui.notify(
			"This Proforma Invoice is already made as VAT Invoice, Please Delete the VAT Invoice and Continue",
			"error",
			3000
		);
		return;
	          }

		DevExpress.ui.dialog.confirm("Are you sure you want to unlock this Purchase Bill?", "Confirm Unlock")
			.done(function (dialogResult) {
				if (dialogResult) {
					$.ajax({
						//url: `/api/VATModule/UpdateToPurchaseUnlocktheBil?InvoiceNo=${encodeURIComponent(vno)}&IsDirectVerify=${encodeURIComponent(IsDirectVerify)}`,
						url: '/api/VATModule/UpdateToProformaUnlocktheBil',
						method: 'POST',
						data: { invoiceNo: invoiceNo },
						success: function (response) {
							if (response) {

								DevExpress.ui.notify("Proforma Invoice has been unlocked successfully.", "success",2000);
								// Optionally refresh the grid or perform additional actions
							} else {
								DevExpress.ui.notify(response.message || "Unlocking failed.", "error", 3000);
							}
						},
						error: function () {
							DevExpress.ui.notify("Server error while unlocking the invoice.", "error", 3000);
						}
					});
				}
			});
	}


		function DeleteProformaInvoice() {
		if (InvoiceStatus=="Approved") {
			DevExpress.ui.notify("Proforma Invoice is already approved, You cannot delete the Approved Invoice", "error", 2000);
			return;
		}

		DevExpress.ui.dialog.confirm("You are about to delete the Proforma Invoice from the Register,Click yes if you would like to continue.", "Delete Confirmation")
			.done(function (dialogResult) {
				if (dialogResult) {
					// Using jQuery AJAX
					$.ajax({
						url: '/api/VATModule/DeleteProformaInvoiceMasterView',
						type: 'POST',
						data: { proformaInvoiceNo: invoiceNo },
						success: function (response) {
							DevExpress.ui.notify(response.message || "Proforma Invoice has been successfully removed from the database", "success", 2000);
							// Refresh grid or UI
							if (typeof refreshGrid === "function") {
								refreshGrid();
							}
						},
						error: function (xhr) {
							let errorMessage = xhr.responseJSON?.message || "Error deleting invoice.";
							DevExpress.ui.notify(errorMessage, "error", 3000);
						}
					});
				}
			});
	}
		function refreshGrid() {
		$("#dataGrid").dxDataGrid("instance").refresh();
	}

	 function cloneEInvoice() {

		if (!invoiceNo) {
			alert("InvoiceNo is required.");
			return;
		}

			DevExpress.ui.dialog.confirm("You are about to Duplicate this Proforma Invoice,Are you Sure want to Continue?", "Confirm Duplication.")
			.done(function (dialogResult) {
				if (dialogResult) {
					$.ajax({
						//url: `/api/VATModule/UpdateToPurchaseUnlocktheBil?InvoiceNo=${encodeURIComponent(vno)}&IsDirectVerify=${encodeURIComponent(IsDirectVerify)}`,
						url: '/api/VATModule/InsertProformaCloneEInvoice',
						method: 'POST',
						data: { invoiceNo: invoiceNo },
						success: function (response) {
							if (response) {

								DevExpress.ui.notify("Proforma Invoice has been successfully added to the database.","success", 2000);
								// Optionally refresh the grid or perform additional actions
								$("#dataGrid").dxDataGrid("instance").refresh();
							} else {
								DevExpress.ui.notify(response.message || "Unlocking failed.", "error", 3000);
							}
						},
						error: function () {
							DevExpress.ui.notify("Server error while unlocking the invoice.", "error", 3000);
						}
					});
				}
			});
	}


