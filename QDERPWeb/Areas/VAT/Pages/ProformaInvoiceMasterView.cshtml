			function onByQuarterClick(e) {
		// Prevent the main dropdown from closing
		e.event.stopPropagation();

		// Reopen main dropdown in case DevExtreme tried to close it
		const dd = $("#ddBtnShowRecords").dxDropDownButton("instance");
		dd.open();

		// Open the submenu near the "By Quarter" element
		openQuarterMenu(e.element);
	}

			function openQuarterMenu(targetElement) {
		if ($("#quarterMenu").data("dxContextMenu")) {
			$("#quarterMenu").dxContextMenu("instance").dispose();
		}

		$("#quarterMenu").dxContextMenu({
			target: targetElement,
			showEvent: "",
			width: 230,
			position: {
				at: "right center",
				my: "left center",
				of: targetElement,
				offset: "8 0"
			},
			items: [
				{ text: "1st Quarter (Jan - Mar)", value: "q1", color: "#4285F4", icon: "event" },
				{ text: "2nd Quarter (Apr - Jun)", value: "q2", color: "#34A853", icon: "event" },
				{ text: "3rd Quarter (Jul - Sep)", value: "q3", color: "#EA4335", icon: "event" },
				{ text: "4th Quarter (Oct - Dec)", value: "q4", color: "#FBBC05", icon: "event" }
			],
			onItemClick: function(e) {
				const quarter = e.itemData.value;
				if (quarter) {
					ddBtnShowRecords_click(quarter, 1);
					closeMainDropdown();
				}
			},
			itemTemplate: function(itemData) {
				return $("<div>").addClass("custom-dropdown-item")
					.append(
						$("<div>").addClass("side-bar").css({
							"background-color": itemData.color,
							"height": "90%"
						})
					)
					.append(
						$("<div>").addClass("item-content").append(
							$("<div>").addClass("item-icon dx-icon dx-icon-" + itemData.icon),
							$("<div>").append(
								$("<div>").addClass("item-title").text(itemData.text)
							)
						)
					);
			}
		}).dxContextMenu("instance").show();
	}




	function closeMainDropdown() {
		const dd = $("#ddBtnShowRecords").dxDropDownButton("instance");
		dd.close();  // ✅ closes only after submenu item click
	}

					// Fetch from API on page load
	$.get("/api/VATModule/GetCurrencyDecimals")
		.done(function (decimals) {
			if (decimals != null) {
				currencyDecimals = decimals;
			}
		})
		.fail(function () {
			DevExpress.ui.notify("Failed to load decimals, using 2", "warning", 3000);
		});

			function formatSummaryValue(value) {
		if (value == null || isNaN(value)) return 0;
		return value.toLocaleString(undefined, {
			minimumFractionDigits: currencyDecimals,
			maximumFractionDigits: currencyDecimals
		});
	}


		
