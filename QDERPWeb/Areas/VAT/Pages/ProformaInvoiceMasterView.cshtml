	function UnlockInvoice() {

			if (InvoiceStatus === "Posted") {
		DevExpress.ui.notify(
			"This Proforma Invoice is already made as VAT Invoice, Please Delete the VAT Invoice and Continue",
			"error",
			3000
		);
		return;
			  }

		DevExpress.ui.dialog.confirm("Are you sure you want to unlock this Purchase Bill?", "Confirm Unlock")
			.done(function (dialogResult) {
				if (dialogResult) {
					$.ajax({
						//url: `/api/VATModule/UpdateToPurchaseUnlocktheBil?InvoiceNo=${encodeURIComponent(vno)}&IsDirectVerify=${encodeURIComponent(IsDirectVerify)}`,
						url: '/api/VATModule/UpdateToProformaUnlocktheBil',
						method: 'POST',
						data: { invoiceNo: invoiceNo },
						success: function (response) {
							if (response) {

								DevExpress.ui.notify("Proforma Invoice has been unlocked successfully.", "success",2000);
								// Optionally refresh the grid or perform additional actions
							} else {
								DevExpress.ui.notify(response.message || "Unlocking failed.", "error", 3000);
							}
						},
						error: function () {
							DevExpress.ui.notify("Server error while unlocking the invoice.", "error", 3000);
						}
					});
				}
			});
	}


		function DeleteProformaInvoice() {
		if (InvoiceStatus=="Approved") {
			DevExpress.ui.notify("Proforma Invoice is already approved, You cannot delete the Approved Invoice", "error", 2000);
			return;
		}

		DevExpress.ui.dialog.confirm("You are about to delete the Proforma Invoice from the Register,Click yes if you would like to continue.", "Delete Confirmation")
			.done(function (dialogResult) {
				if (dialogResult) {
					// Using jQuery AJAX
					$.ajax({
						url: '/api/VATModule/DeleteProformaInvoiceMasterView',
						type: 'POST',
						data: { proformaInvoiceNo: invoiceNo },
						success: function (response) {
							DevExpress.ui.notify(response.message || "Proforma Invoice has been successfully removed from the database", "success", 2000);
							// Refresh grid or UI
							if (typeof refreshGrid === "function") {
								refreshGrid();
							}
						},
						error: function (xhr) {
							let errorMessage = xhr.responseJSON?.message || "Error deleting invoice.";
							DevExpress.ui.notify(errorMessage, "error", 3000);
						}
					});
				}
			});
	}
		function refreshGrid() {
		$("#dataGrid").dxDataGrid("instance").refresh();
	}

