	/* 	.dx-texteditor.dx-state-focused { */
	/* 		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15) !important; */
	/* 		border-color: #508ae1 !important; */
	/* 	} */

	.no-border-input {
		border: none !important;
		outline: none !important;
		box-shadow: none !important;
		background: transparent !important;
		font-weight: bold;
		font-size: 16px;
		color: black;
		pointer-events: none;
	}

	.context-menu {
		position: absolute;
		background: #fff;
		border-radius: 8px;
		box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
		width: 200px;
		display: none;
		flex-direction: column;
		padding: 5px 0;
		z-index: 1000;
	}


	.context-menu-item {
		/* display: flex; */
		align-items: center;
		padding: 10px 15px;
		font-size: 14px;
		cursor: pointer;
		transition: background 0.2s ease-in-out;
		color: #333;
	}

		.context-menu-item i {
			margin-right: 10px;
			font-size: 16px;
			color: #007bff;
		}

		.context-menu-item:hover {
			background: #f0f0f0;
		}

		.context-menu-item:not(:last-child) {
			border-bottom: 1px solid #e0e0e0;
		}

	.mainContainer {
		width: 97%;
	}

	.dx-fieldset.horizontal-container {
		margin-top: 10px;
	}

	.voucher-slider {
		position: relative;
		height: 120px;
		overflow: hidden;
	}

	.voucher-slide {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		opacity: 0;
		transform: translateY(100%);
		transition: all 0.5s ease;
		text-align: left;
	}

		.voucher-slide.active {
			opacity: 1;
			transform: translateY(0);
			z-index: 2;
		}

	.with-sidebar {
		position: relative;
		overflow: hidden;
	}

		.with-sidebar::before {
			content: '';
			position: absolute;
			top: 10px;
			left: 0;
			width: 10px;
			height: 80%;
			background: rgba(255, 255, 255, 0.4);
			border-top-right-radius: 12px;
			border-bottom-right-radius: 12px;
		}


	.switch-heading4 {
		font-weight: bold;
		font-size: 20px;
		color: white;
		animation: fadeIn 0.6s ease-in-out;
	}

	.value-display4 {
		font-size: 28px;
		color: white;
		transition: all 0.3s ease-in-out;
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(-5px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.switch-heading4 {
		transition: opacity 0.4s ease;
		opacity: 1;
	}

		.switch-heading4.fade-out {
			opacity: 0;
		}

	.tabs {
		display: flex;
		justify-content: space-between;
		margin-bottom: 12px;
		gap: 10px;
	}

	.tab-text {
		flex: 1;
		text-align: center;
		cursor: pointer;
		font-weight: bold;
		padding: 2px 0;
		border-radius: 13px;
		background: rgba(255, 255, 255, 0.2);
		transition: background 0.3s ease;
	}

		.tab-text.active {
			background: rgba(255, 255, 255, 0.9);
			color: rgb(0 0 0);
		}


	.tab-content {
		display: none;
		text-align: center;
		animation: fadeSlideIn 0.4s ease;
	}

	.tile-icon {
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		height: 100%;
		position: absolute;
		left: 195px !important;
		bottom: 10px;
	}

	.title {
		display: flex;
		gap: 20px;
		align-items: center;
		width: 70% !important;
	}

</style>

