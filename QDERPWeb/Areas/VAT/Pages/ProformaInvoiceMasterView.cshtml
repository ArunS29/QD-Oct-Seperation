	.ledgerResult {
		overflow-x: auto; /* Enable horizontal scrolling for the entire grid */
		width: 100%;
	}

	.close-btn {
		position: absolute;
		top: 10px;
		right: 20px;
		font-size: 30px;
		cursor: pointer;
	}

	.custom-toolbar {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.filter-btn {
		background-color: #007bff;
		color: white;
		border: none;
		padding: 6px 12px;
		border-radius: 5px;
		cursor: pointer;
		font-family: 'Inter', sans-serif;
	}

		.filter-btn:hover {
			background-color: #0056b3;
		}

