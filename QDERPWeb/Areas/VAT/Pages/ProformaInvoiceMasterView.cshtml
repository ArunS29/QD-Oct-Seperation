	function UnlockInvoice() {

		if (Status === "Posted") {
			DevExpress.ui.dialog.alert(
				"This VAT Purchase Bill is already posted to your ledgers.\nPlease delete the Purchase Entry from Accounting Books and continue.",
				"Purchase Bill Posted Already"
			);
			return;
		}


		DevExpress.ui.dialog.confirm("Are you sure you want to unlock this Purchase Bill?", "Confirm Unlock")
			.done(function (dialogResult) {
				if (dialogResult) {
					$.ajax({
						//url: `/api/VATModule/UpdateToPurchaseUnlocktheBil?InvoiceNo=${encodeURIComponent(vno)}&IsDirectVerify=${encodeURIComponent(IsDirectVerify)}`,
						url: '/api/VATModule/UpdateToPurchaseUnlocktheBil',
						method: 'POST',
						data: { invoiceNo: invoiceNo },
						success: function (response) {
							if (response) {

								DevExpress.ui.dialog.alert("Purchase Bill has been unlocked successfully.", "Bill Unlocked");
								// Optionally refresh the grid or perform additional actions
							} else {
								DevExpress.ui.notify(response.message || "Unlocking failed.", "error", 3000);
							}
						},
						error: function () {
							DevExpress.ui.notify("Server error while unlocking the invoice.", "error", 3000);
						}
					});
				}
			});
	}

