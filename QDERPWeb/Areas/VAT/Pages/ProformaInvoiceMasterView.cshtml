	function ddBtnShowRecords_click(duration) {
		const frmDateBox = $("#frmdateBox").dxDateBox("instance");
		const toDateBox = $("#todateBox").dxDateBox("instance");

		let frmDateVal = frmDateBox.option("value");
		let toDateVal = toDateBox.option("value");

		let frmDate = frmDateVal ? new Date(frmDateVal) : null;
		let toDate = toDateVal ? new Date(toDateVal) : null;
		const currentDate = new Date();

		switch (duration) {
				case 'q1':
			frmDate = new Date(currentDate.getFullYear(), 0, 1);   // Jan 1
			toDate  = new Date(currentDate.getFullYear(), 2, 31);  // Mar 31
			break;
			case 'q2':
				frmDate = new Date(currentDate.getFullYear(), 3, 1);   // Apr 1
				toDate  = new Date(currentDate.getFullYear(), 5, 30);  // Jun 30
				break;
			case 'q3':
				frmDate = new Date(currentDate.getFullYear(), 6, 1);   // Jul 1
				toDate  = new Date(currentDate.getFullYear(), 8, 30);  // Sep 30
				break;
			case 'q4':
				frmDate = new Date(currentDate.getFullYear(), 9, 1);   // Oct 1
				toDate  = new Date(currentDate.getFullYear(), 11, 31); // Dec 31
				break;
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				const dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				const today = new Date();
				const dayOfWeek = today.getDay(); // Sunday = 0
				const startOfWeek = new Date(today);
				startOfWeek.setDate(today.getDate() - (dayOfWeek || 7) + 1); // Monday as start
				frmDate = startOfWeek;
				toDate = new Date(startOfWeek);
				toDate.setDate(startOfWeek.getDate() + 6);
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
		}

		// If dates are still null (cleared by user), handle gracefully
		if (!frmDate || !toDate) {
			DevExpress.ui.notify("Please select both Start Date and End Date.", "warning", 2000);
			return;
		}

		// Format dates for server/API
		const formattedFromDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		const formattedToDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		
		// Update DateBoxes visually if needed
		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		// API call
		$.ajax({
			url: '/api/VATModule/GetVatProformaDetails',
			type: 'GET',
			data: {
				frmDate: formattedFromDate,
				toDate: formattedToDate
			},
			success: function (data) {
				console.log("ShowData", data);
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
				if (data.length === 0 && page > 1) return;

				currentPage = Number(data.currentPage);
				var grid = $("#dataGrid").dxDataGrid("instance");
				grid.option("dataSource", data);

				//updateInvoiceAmountCardss(data);
				console.log("SalesRegisterGrid", data);

				if (data && data.length > 0) {
					VoucherAmountFormatted = data[data.length - 1].VoucherAmountFormatted;
					firstrowVoucherAmountFormatted = data[0].VoucherAmountFormatted;
				}

				const totalPages = Math.ceil(Number(data.totalCount) / Number(data.pageSize));
				$("#pageInfo").text(`Page ${data.currentPage} of ${totalPages} (${data.totalCount} items)`);
				$("#nextPage").prop("disabled", totalPages === data.currentPage);
				$("#previousPage").prop("disabled", data.currentPage === 1);

				const animatedCount = data.length;
				animateInvoiceCardCount(animatedCount);

				let periodLabel = "Invoices";
				switch (duration) {
					case 'today': periodLabel = "Today's Invoices"; break;
					case 'yesterday': periodLabel = "Yesterday's Invoices"; break;
					case 'week': periodLabel = "This Week's Invoices"; break;
					case 'tillmonth':
					case 'fullmonth': periodLabel = "This Month's Invoices"; break;
					case 'tillyear':
					case 'fullyear': periodLabel = "This Year's Invoices"; break;
					case 'lastmonth': periodLabel = "Last Month's Invoices"; break;
					case 'lastyear': periodLabel = "Last Year's Invoices"; break;
					default: periodLabel = "Invoices";
				}

				$("#invoicePeriodLabel").text(periodLabel);
				const today = new Date();
				today.setHours(0, 0, 0, 0);

				const fiveYearsAgo = new Date();
				fiveYearsAgo.setFullYear(today.getFullYear() - 5);
				fiveYearsAgo.setHours(0, 0, 0, 0);

				const fiveYearCount = data.filter(row => {
					const d = new Date(row.InvoiceDate); // or row.VoucherDate
					d.setHours(0, 0, 0, 0);
					return d >= fiveYearsAgo && d <= today;
				}).length;

				animateVoucherCount("fiveYearCount", fiveYearCount);
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}

	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
	function formatDate(date) {
