<div class="title">

	 <input id="formId" value="frm201LedgerView" type="hidden" />

	<div class="card blue shine compact">
		<h2 class="title-slide">Proforma Invoice Register</h2>
		<hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.3); margin: 6px 0;">
		<h6 class="fade-in">QuickDice ERP Solutions</h6>

	</div>
	<div id="mainCard" class="card today-bg">
		<div class="tabs">
			<div class="tab-text active" onclick="switchTab(0)">Today</div>
			<div class="tab-text" onclick="switchTab(1)">Week</div>
			<div class="tab-text" onclick="switchTab(2)">Month</div>
		</div>

		<div class="tab-content active">
			<h4>&#128276; Pending Verifications</h4>
			<div class="count" id="count0">0</div>
			@* <div class="trend">🔺 12% more than yesterday</div> *@
			@* <div class="message">You're getting things moving!</div> *@
		</div>

		<div class="tab-content">
			<h4>&#9989; Vouchers Verified</h4>
			<div class="count" id="count1">0</div>
			@* <div class="trend">🔼 25% higher than last week</div> *@
			@* <div class="message">Awesome pace — keep it up!</div> *@
		</div>

		<div class="tab-content">
			<h4>&#128229; New Vouchers</h4>
			<div class="count" id="count2">0</div>
			@* <div class="trend">🔽 10% drop this month</div> *@
			@* <div class="message">Fewer vouchers — time to catch up?</div> *@
		</div>
	</div>

	<div class="card purple sparkle">
		<h1 id="invoiceCount">0</h1>
		<h3>No of Invoices</h3>
	</div>
</div>

<div class="Head">
	@await Html.PartialAsync("/Pages/Shared/VAT/VATProformaInvoiceRegisterFooter.cshtml")
</div>

<div class="context-menu" id="contextMenu">
	<div class="context-menu-item" onclick="viewInvoice()">
		<i class="dx-icon-search"></i> View e-Invoice
	</div>

	<div class="context-menu-item" onclick="cancelInvoice()">
		<i class="dx-icon-close"></i> Cancel/Amend this Invoice (Invoice Credit Note)
	</div>
	<div class="context-menu-item">
		<i class="dx-icon-file"></i> VAT Invoices (Obselete)
	</div>

	<div class="context-menu-item" onclick="cloneEInvoice()">
		<i class="dx-icon-copy"></i> Clone e-Invoice
	</div>
</div>


<div class="horizontal-container">
	@(Html.DevExtreme().DateBox()
		.ID("frmdateBox")
		.Label(new JS("formatMessage('Start Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) // First day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(2)
		)

	@(Html.DevExtreme().DateBox()
		.ID("todateBox")
		.Label(new JS("formatMessage('End Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(3)
		)


	@(Html.DevExtreme().DropDownButton()
		.ID("ddBtnShowRecords")
		.Text(new JS("formatMessage('Show Records')"))
		.Icon("smalliconslayout")
		.Width(180)
		.TabIndex(4)
		.DropDownOptions(options => options.Width(230))
		.Items(items =>
		{
			items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
			items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
			items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
			items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
			items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
			items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
			items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
			items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
			items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
			items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
		})
		)

</div>
