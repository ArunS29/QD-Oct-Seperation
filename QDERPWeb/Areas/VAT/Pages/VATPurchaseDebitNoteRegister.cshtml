	}
/* 
	.limited-footer .btn-container:not(:has(#ddButtonLayout,#btnToggleSearch,#btnPrint,#btntoggleGroupPanel,#btnAddNew1,#ddReports)) {
		display: none !important;
	} */
	#overlay-frame {
		width: 100%;
		height: 100%;
	}
	.close-btn {
		position: absolute;
