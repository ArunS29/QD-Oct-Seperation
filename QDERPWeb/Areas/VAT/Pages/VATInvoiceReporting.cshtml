@page
@using DevExtreme.AspNet.Mvc
@{
    ViewData["Title"] = "Trial Balance";
}
<link rel="stylesheet" href="~/css/animationCardVAT.css" />
<style>
    body {
        margin: 0;
        color: black;
        display: flex;
        height: 100px;
        flex-direction: column;
    }
    .limited-footer .btn-containerIvoiceEdit:not(:has(#btnPrint, #btnToggleSearch, #btnToggleHeaderFilter,#ddButtonLayout,#btntoggleGroupPanel,#btnColumnChooser,#ddReport0,#btnShowRowTotals,#btnShowFields)) {
        display: none !important;
    }
    .dx-fieldset.horizontal-container {
        display: flex;
        align-items: center;
        gap: 8px; /* Reduce spacing between controls */
    }

    .dx-field {
        margin: 0; /* Remove default margins */
        padding: 5px; /* Reduce spacing */
    }

    .dx-field-4 {
        display: flex;
        flex-direction: column;
        gap: 5px; /* Reduce space between checkboxes and dropdown */
        align-content: center;
    }

    #pivotGridContainer {
        flex-grow: 1;
        width: 100%;
        min-height: 400px;
        max-height: 600px;
        overflow: auto;
        padding: 5px; /* Reduce padding */
    }

    .dx-pivotgrid-container {
        font-size: 13px; /* Slightly reduce font size */
        border-radius: 6px; /* Adjust border-radius */
    }

    .dx-pivotgrid-row, .dx-pivotgrid-column {
        padding: 5px; /* Reduce padding */
        border-bottom: 1px solid #ddd;
    }

    .dx-pivotgrid-cell {
        padding: 6px; /* Reduce cell padding */
    }

        .dx-pivotgrid-cell:hover {
            background-color: #f5f5f5;
        }

    .mainContainer {
        width: 100%;
    }

    .dx-fieldset.horizontal-container {
        margin-top: 10px;
    }

    .title {
        display: flex;
        gap: 20px;
        align-items: center;
        width: 35% !important;
    }
</style>
@* <div class="title">
    <div class="header-container">
        <div id="VATInvoiceReporting" class="no-border-input"></div>
    </div>
</div> *@

<div class="title">
   
    <div class="card blue shine compact">
        <h2 class="title-slide">Sales Reporting</h2>
        <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.3); margin: 6px 0;">
        <h6 class="fade-in">Quick Dice ERP Solutions</h6>

    </div>

    <div class="card green shine">
        <h2>This Month Grand Total</h2>
        <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.3); margin: 6px 0;">
        <h1 id="invoiceCount">0</h1>
    </div>
</div>

<div class="container" style="display: flex; flex-direction: column;width:100%;background:white;">

    <div class="Head">    
            @await Html.PartialAsync("/Pages/Shared/VAT/VATInvoiceReportingFooter.cshtml")
    </div>

    <!-- Input Controls in One Line -->
    <div class="dx-fieldset horizontal-container">
       

        <div class="dx-field">
            <!-- Start Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("frmdateBox")
               
                .LabelMode(EditorLabelMode.Floating)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(2)
                )
        </div>

        <div class="dx-field">
            <!-- End Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("todateBox")
            
                .LabelMode(EditorLabelMode.Floating)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(3)
                )
        </div>
        <div>
        <!-- Dropdown Button to Show Records -->
            @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnShowRecords")
                .Text(new JS("formatMessage('Show Records')"))
                .Icon("smalliconslayout")
                .Width(180)
                .TabIndex(4)
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                    items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('range'); }");
                    items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
                    items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                    items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
                    items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                    items.Add().Text(new JS("formatMessage('By Quarter')")).Icon("event").OnClick("quarterSubMenu");
                    items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                    items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                    items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                    items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                    items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                })
                )
        </div>
        <div class="dx-field dx-field-4" id="check">
            <!-- Use Effective Date Checkbox -->
            @(Html.DevExtreme().CheckBox()
                .ID("useEffectiveDate")
                .Text(new JS("formatMessage('Use Effective Date')"))
                .Value(true)
                )
        </div>
    </div>

    <!-- Pivot Grid (Will Always Appear Below Filters) -->
    <div class="mua" style="width: 95%;">
    <div id="pivotGridContainer" style="width: 100%;height:140px;"></div>
    </div>

</div>



<script type="text/javascript">

    let pivotData = [];
    $(function () {
            ddBtnShowRecords_click("range")
        $("#VATInvoiceReporting").dxTextBox({
            text: formatMessage("Sales Reporting"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });

    $(document).ready(function () {
        // Load this month's records by default
        loadDefaultRecords();
    });

    function loadDefaultRecords() {
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        let lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        fetchRecords(firstDay, lastDay);
    }

    function ddBtnShowRecords_click(option) {
        let today = new Date();
        let startDate = null;
        let endDate = null;

        switch (option) {
            case 'today':
                startDate = today;
                endDate = today;
                break;
            case 'yesterday':
                startDate = new Date();
                startDate.setDate(today.getDate() - 1);
                endDate = startDate;
                break;
            case 'week':
                startDate = new Date();
                startDate.setDate(today.getDate() - today.getDay());
                endDate = today;
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = today;
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = today;
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                break;
            case 'lastmonth':
                startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                break;
            case 'lastyear':
                startDate = new Date(today.getFullYear() - 1, 0, 1);
                endDate = new Date(today.getFullYear() - 1, 11, 31);
                break;
            case 'q1': // Jan - Mar
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 2, 31);
                break;

            case 'q2': // Apr - Jun
                startDate = new Date(today.getFullYear(), 3, 1);
                endDate = new Date(today.getFullYear(), 5, 30);
                break;

            case 'q3': // Jul - Sep
                startDate = new Date(today.getFullYear(), 6, 1);
                endDate = new Date(today.getFullYear(), 8, 30);
                break;

            case 'q4': // Oct - Dec
                startDate = new Date(today.getFullYear(), 9, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                break;
            case 'range':
            default:
                // Get manual dates from DateBox controls
                startDate = $("#frmdateBox").dxDateBox("instance").option("value");
                endDate = $("#todateBox").dxDateBox("instance").option("value");
                if (!startDate || !endDate) {
                    DevExpress.ui.notify("Please select Start Date and End Date.", "warning", 3000);
                    return;
                }
                break;
        }

        // Update the DateBoxes with selected range
        $("#frmdateBox").dxDateBox("instance").option("value", startDate);
        $("#todateBox").dxDateBox("instance").option("value", endDate);
         hidequarterSubmenus();
        fetchRecords(startDate, endDate);
    }

    function fetchRecords(startDate, endDate) {
        console.log("Fetching records between:", startDate, "and", endDate);

        $.ajax({
            url: '/api/VATModule/GetVATInvoiceReporting',
            type: 'GET',
            data: {
                startDate: formatDate(startDate),
                endDate: formatDate(endDate)
            },
            // success: function (data) {
            //      pivotData = data; // Set global
            //     initializePivotGrid(data);
            // },
                success: function (data) {
        pivotData = data; // Set global
        updateGrandTotalCard(data); // 👈 Add this function
        initializePivotGrid(data);
    },

            error: function (xhr, status, error) {
                console.error("Error fetching records:", error);
            }
        });
    }
        function updateGrandTotalCard(data) {
        let total = 0;
        if (Array.isArray(data)) {
            total = data.reduce((sum, item) => {
                const value = parseFloat(item.TotalRevenue);
                return sum + (isNaN(value) ? 0 : value);
            }, 0);
        }

        // Format to K/M if needed or just to fixed decimal
        const formatted = total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        // Update the card
        $("#invoiceCount").text(formatted);
    }

    function initializePivotGrid(data) {
        var pivotGrid = $("#pivotGridContainer").dxPivotGrid({
            dataSource: {
                store: {
                    type: "array",
                    data: data
                },
                         fields: [
          { dataField: "AccountHead", area: "row", caption: "Client Name",arguments, width: 250 },
          { dataField: "InvMonth", area: "column", caption: "Inv Month",arguments, width: 100 ,
            customizeText: function (cellInfo) {
            if (cellInfo.value) {
                const date = new Date(cellInfo.value);
                const month = date.toLocaleString("en-US", { month: "short" }); // Jan, Feb, etc.
                const year = date.getFullYear();
                return `${month} - ${year}`;
            }
            return "";
        }
      },
          {
            dataField: "TotalRevenue",
            area: "data",
            caption: "Revenue",
            summaryType: "sum",
            format: { type: "fixedPoint", precision: 2 }
          }
        ]
      },
     
   

           
             height: 500,
      rowHeaderLayout: "virtual",
      showBorders: true,
            width: "100%",
            allowSortingBySummary: true,
            allowSorting: true,
            allowFiltering: true,
            allowExpandAll: true,
            showBorders: true,
            showColumnHeaders: true,
            columnAutoWidth: true,
            allowColumnResizing: true,
            rowHeaderLayout: "virtual",
            wordWrapEnabled: true,
            fieldChooser: {
                enabled: true,
                allowSearch: true
            },
            fieldPanel: {
                visible: true,
                allowFieldDragging: true,
                showRowFields: true,
                showColumnFields: true,
                showDataFields: true,
                showFilterFields: true
            },
            showColumnTotals: true,
            showColumnGrandTotals: true,
            showDataHeaders: true,
            showRowTotals: true,
            showRowGrandTotals: true
        }).dxPivotGrid("instance");

        // Expand rows initially
        setTimeout(function () {
            var dataSource = pivotGrid.getDataSource();
            var accountGroups = dataSource.getData().rows;
            accountGroups.forEach(function (group) {
                if (group.text) {
                    dataSource.expandHeaderItem("row", [group.text]);
                }
            });
        }, 100);

        // Adjust height on window resize
        $(window).resize(function () {
            pivotGrid.option("height", $(window).height() - 50);
        });

        // Minor style tweaks
        $(".dx-pivotgrid-container").css({
            "font-size": "14px",
            "border-radius": "8px"
        });

        $(".dx-pivotgrid-row, .dx-pivotgrid-column").css({
            "padding": "10px",
            "border-bottom": "1px solid #ddd"
        });

        $(".dx-pivotgrid-cell").hover(function () {
            $(this).css("background-color", "#f5f5f5");
        }, function () {
            $(this).css("background-color", "");
        });
    }
    
    function formatDate(date) {
        if (!date) return null;
        if (typeof date === 'string') date = new Date(date);
        return date.toISOString().split('T')[0];
    }   
    	$(document).ready(function () {
		$(".limited-footer .btn-container").each(function () {
            if (!$(this).find("#btnPrint, #btnToggleSearch, #btnToggleHeaderFilter,#ddButtonLayout,#btntoggleGroupPanel,#btnColumnChooser,#ddReport0,#btnShowRowTotals,#btnShowFields").length) {
				$(this).remove();
			}
		});
	});
    function quarterSubMenu(e) {
        e.event.stopPropagation();
        hideAllSubmenus(); // Hide all submenus before showing the selected one
        var $submenu = $('#quarterSubMenu');
        var $target = $(e.event.target).closest('.dx-item-content');
        var offset = $target.offset();
        var submenuWidth = $submenu.outerWidth();

        // Calculate left-side positioning
        var leftPos = offset.left - submenuWidth + 533;

        // Prevent submenu from going off-screen on the left
        if (leftPos < 0) {
            leftPos = offset.left + $target.outerWidth() + 5; // Move it to the right if not enough space
        }

        // Position submenu
        $submenu.css({
            'width': 250,
            'position': 'absolute',
            'top': offset.top,
            'left': leftPos,
            'display': 'block',
            'background': '#fff',
            'border': '1px solid #ccc',
            'box-shadow': '2px 2px 5px rgba(0,0,0,0.2)',
            'padding': '5px'
        });

        // Click outside to close
        $(document).on("click", function (event) {
            if (!$(event.target).closest('#submenuContainer5, .dx-item-content').length) {
                $submenu.hide();
                $(document).off("click");
            }
        });
    }

    let extraFieldsVisible = false; // Flag to track toggle state

        $("#btnShowFields").on("click", function (e) {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        const dataSource = pivotGrid.getDataSource();
           
        // Base fields (always visible)
        const baseFields = [
                    { dataField: "AccountHead", area: "row", caption: "Client Name" },
                    { dataField: "InvoiceMonth", area: "column", caption: "Invoice Month", dataType: "date", format: "MMM-yyyy" },
                    {
                        dataField: "TotalRevenue",
                        area: "data",
                        caption: "Net Revenue",
                        summaryType: "sum",
                        format: { type: "fixedPoint", precision: 2 }
                    }
                ];

        // Extra filter fields
        const extraFields = [
            { dataField: "InvoiceNo", area: "filter", caption: "Invoice No" },
            { dataField: "InvoiceDate", area: "filter", caption: "Invoice Date" },
            {
                dataField: "InvoiceDate",
                area: "filter",
                caption: "Invoice Date",
                format: "dd-MMM-yyyy"
            },
            {
                dataField: "InvoiceEffectiveDate", area: "filter", caption: "Invoice Effective Date", customizeText: function (cellInfo) {
                    const date = new Date(cellInfo.value);
                    if (isNaN(date)) return ""; // handle invalid dates
                    const day = String(date.getDate()).padStart(2, '0');
                    const month = date.toLocaleString('en-US', { month: 'short' });
                    const year = date.getFullYear();
                    return `${day}-${month}-${year}`;
                }
            },
            { dataField: "CostAllocationUnit", area: "filter", caption: "Cost Allocation Unit" },
            { dataField: "CostAllocationGroup", area: "filter", caption: "Cost Allocation Group" },
            { dataField: "CostAllocationMasterGroup", area: "filter", caption: "Cost Allocation Master Group" },
            { dataField: "CompanyBranch", area: "filter", caption: "Company Branch" },
            { dataField: "SalesPersonName", area: "filter", caption: "Sales Person Name" },
            { dataField: "Discount", area: "filter", caption: "Discount" },
            { dataField: "TotalRevenue", area: "filter", caption: "Gross Revenue" },
            { dataField: "CalcTaxAmount", area: "filter", caption: "Tax Amount" },
            { dataField: "AdvanceAmount", area: "filter", caption: "Advance Amount" },
            { dataField: "RetentionAmount", area: "filter", caption: "Retention Amount" },
            { dataField: "InvoiceStatus", area: "filter", caption: "Invoice Status" },
            { dataField: "RetentionAmount", area: "filter", caption: "Invoice Amount with Tax" },
            { dataField: "CreditNoteNo", area: "filter", caption: "Credit Note No" },
            { dataField: "CreditNoteDate", area: "filter", caption: "Credit Note Date" },
            { dataField: "CreditNoteAmount", area: "filter", caption: "Credit Note Amount" },
            { dataField: "CreditNoteTaxAmount", area: "filter", caption: "Credit Note Tax Amount" },
            { dataField: "TotalCreditNoteAmount", area: "filter", caption: "Total Credit Note Amount" },
            { dataField: "TotalCreditNoteAmount", area: "filter", caption: "Received/Credited Amount" },
            { dataField: "InvoiceBalance", area: "filter", caption: "Invoice Balance" },
            { dataField: "ReceivedMonth", area: "filter", caption: "Received Month" },
            { dataField: "RevenueLedgerNo", area: "filter", caption: "Revenue Ledger No" },
            { dataField: "RevenueLedgerName", area: "filter", caption: "Revenue Ledger Name" }
            
        ];

        if (!extraFieldsVisible) {
            // Show extra fields
            dataSource.fields([...baseFields, ...extraFields]);
            extraFieldsVisible = true;
            //e.component.option("text", "Hide Extra Fields"); // Optional: update button text
        } else {
            // Hide extra fields
            dataSource.fields(baseFields);
            extraFieldsVisible = false;
           // e.component.option("text", "Show Extra Fields"); // Optional: update button text
        }

        dataSource.load();
    });

       $('#btnShowRowTotals').click(function () {
        showrowtotal(pivotData); // Correctly passing the data array
    });


            function showrowtotal(pivotData) {
        const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
        console.log("pivotData", pivotData);

        // Group by CostAllocationUnit (Cost Group)
        const grouped = {};
        pivotData.forEach(item => {
            const groupKey = item.AccountHead;
            if (!groupKey) return; // Skip if no group key
            if (!grouped[groupKey]) grouped[groupKey] = [];
            grouped[groupKey].push(item);
        });

        console.log("Grouped:", pivotData);

        // Create total rows for each Cost Group
        const totalRows = Object.entries(grouped).map(([groupName, rows]) => {
            const totalIncome = rows.reduce((sum, r) => sum + (r.TotalRevenue || 0), 0);
           

            return {
                AccountHead: groupName + " Total",
                TotalRevenue: totalIncome
               
            };
        });

        // Debug: Check totals
        console.log("Total Rows:", totalRows);

        const updatedData = [...pivotData, ...totalRows];

        // Refresh PivotGrid with updated data
        pivotGrid.option("dataSource", {
            fields: [
                { dataField: "AccountHead", area: "row", caption: "Client Name" },
                { dataField: "TotalRevenue", area: "data", summaryType: "sum", caption: "Net Revenue" }
            ],
            store: updatedData
        });
    }
    function customFormatter(cellInfo) {
        const value = cellInfo.value;
        if (value < 0) {
            return "-" + Math.abs(value).toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        } else {
            return value.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        }
    }
        $(document).ready(function () {
                                console.log('Start permission handling');
                                // Form ID
                                                var formId = "frm20174VATInvoiceReporting";

                                // Call the API to get permissions
                                $.ajax({
                                    url: '/api/Permissions/GetAccessDetails?formId=' + formId,
                                    type: 'GET',
                                    contentType: 'application/json',
                                    success: function (response) {
                                        console.log("API Response:", response); // Log the API response

                                        if (response.success && response.permissions) {
                                            // Default visibility and enable status for buttons
                                            var controlStates = {
                                                            "ddReport0": { "Visible": true, "Enabled": false },
                                                        "btnPrint": { "Visible": true, "Enabled": false },
                                                            "btnColumnChooser": { "Visible": true, "Enabled": false },
                                                            "ddReport0": { "Visible": true, "Enabled": false },
                                                            "btnShowFields": { "Visible": true, "Enabled": false },
                                                            "btnShowRowTotals": { "Visible": true, "Enabled": false },
                                                      
                                            };


                                            // Check for full access
                                            var fullAccess = response.permissions.find(p =>
                                                p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
                                            );

                                            if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
                                                // Grant full access: make all controls visible and enabled
                                                Object.keys(controlStates).forEach(key => {
                                                    controlStates[key] = { "Visible": true, "Enabled": true };
                                                });
                                            } else {
                                                // Update states based on specific permissions for each control
                                                Object.keys(controlStates).forEach(key => {
                                                    var controlPermission = response.permissions.find(p =>
                                                        p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
                                                    );
                                                    if (controlPermission) {
                                                        controlStates[key] = {
                                                            "Visible": controlPermission.ItemVisible || false,
                                                            "Enabled": controlPermission.ItemEnabled || false
                                                        };
                                                    }
                                                });
                                            }

                                            console.log("Control States:", controlStates); // Log the control states

                                            // Dynamically update button visibility and enabled state
                                            Object.keys(controlStates).forEach(key => {
                                                var button = document.getElementById(key);
                                                if (button) {
                                                    // Handle visibility
                                                    button.style.display = controlStates[key].Visible ? "inline-block" : "none";
                                                    // Handle enable/disable state
                                                    button.disabled = !controlStates[key].Enabled;
                                                    console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
                                                } else {
                                                    console.warn(`Button with ID "${key}" not found in the DOM.`);
                                                }
                                            });
                                        } else {
                                            console.warn("Failed to fetch permissions or no permissions available.");
                                        }
                                    },
                                    error: function (xhr, status, error) {
                                        console.error("Error fetching permissions:", error);
                                        alert('An error occurred while fetching permissions. Please try again.');
                                    }
                                });
                                showColumnChooser();
                                console.log('End permission handling');
                            });

