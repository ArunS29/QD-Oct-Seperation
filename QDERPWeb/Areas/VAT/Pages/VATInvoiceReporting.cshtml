<div class="container" style="display: flex; flex-direction: column;width:100%;background:white;">

    <div class="Head">    
            @await Html.PartialAsync("/Pages/Shared/VAT/VATInvoiceReportingFooter.cshtml")
    </div>
    <div id="loadPanel"></div>
    <!-- Input Controls in One Line -->
    <div class="horizontal-container">
       

        <div class="dx-field">
            <!-- Start Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("frmdateBox")
               
                .LabelMode(EditorLabelMode.Floating)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(2)
                )
        </div>

        <div class="dx-field">
            <!-- End Date Picker -->
            @(Html.DevExtreme().DateBox()
                .ID("todateBox")
            
                .LabelMode(EditorLabelMode.Floating)
                .InputAttr("aria-label", "Date")
                .Type(DateBoxType.Date)
                .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)))
                .DisplayFormat("dd-MMM-yyyy")
                .TabIndex(3)
                )
        </div>
        <div>
        <!-- Dropdown Button to Show Records -->
            @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnShowRecords")
                .Text(new JS("formatMessage('Show Records')"))
                .Icon("smalliconslayout")
                .Width(180)
                .TabIndex(4)
                .DropDownOptions(options => options.Width(230))
                .SplitButton(true) 
                .OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }")
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                    items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").Option("color", "#4285F4").OnClick("function() { ddBtnShowRecords_click('range'); }");
                    items.Add().Text(new JS("formatMessage('Today')")).Icon("event").Option("color", "#34A853").OnClick("function() { ddBtnShowRecords_click('today'); }");
                    items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").Option("color", "#EA4335").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
                    items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").Option("color", "#FBBC05").OnClick("function() { ddBtnShowRecords_click('week'); }");
                    items.Add().Text(new JS("formatMessage('This Month Till Date')")).Option("color", "#AB47BC").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
                            items.Add().Text(new JS("formatMessage('By Quarter')")).Icon("event").Option("color", "#4285F4").OnClick("quarterSubMenu");
                    items.Add().Text(new JS("formatMessage('This Month (Full)')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
                    items.Add().Text(new JS("formatMessage('This Year Till Date')")).Option("color", "#FF7043").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
                    items.Add().Text(new JS("formatMessage('This Year (Full)')")).Option("color", "#4285F4").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
                    items.Add().Text(new JS("formatMessage('Last Month')")).Option("color", "#FBBC05").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
                    items.Add().Text(new JS("formatMessage('Last Year')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
                })
                .ItemTemplate(@<text>
                <div class="custom-dropdown-item">
                    <div style="background-color:<%- color %>;height:90%" class="side-bar"></div>
                    <div class="item-content">
                        <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                        <div>
                            <div class="item-title"><%- text %></div>
                        </div>
                    </div>
                </div>
            </text>)
             )
        </div>
        <div class="dx-field dx-field-4" id="check">
            <!-- Use Effective Date Checkbox -->
            @(Html.DevExtreme().CheckBox()
                .ID("useEffectiveDate")
                .Text(new JS("formatMessage('Use Effective Date')"))
                .Value(true)
                )
        </div>
    </div>

    <!-- Pivot Grid (Will Always Appear Below Filters) -->
    <div class="mua" style="width: 95%;">
        <div class="ledgerResult" id="pivotGridContainer" style="width: 100%;height:140px;"></div>

    </div>

</div>



<script type="text/javascript">
     let pivotData = [];
    let slectedaccount;


    function onCostCenterSelected(e) {
        const selectedData = e.selectedRowsData[0];
        const dropDownBox = $("#requestedBy").dxDropDownBox("instance");

        if (selectedData) {
            slectedaccount = selectedData.CostAllocationUnit;
            dropDownBox.option("value", selectedData.CostAllocationUnit);
            dropDownBox.close();
        }
    }
      $(function () {
        $("#loadPanel").dxLoadPanel({
            shadingColor: "rgba(0,0,0,0.4)",
            position: { of: "body" }, // or change to "#mainContent" if you want to limit area
            visible: false,
            showIndicator: true,
            showPane: true,
            message: "Loading..."
        });
    });
     function loadAllRecords() {
        console.log("Loading sales reporting records...");

        const today = new Date();

        // Define date range: Jan 1st of last year to end of current month
        const firstDay = new Date(today.getFullYear() - 1, 0, 1); // Jan 1 last year
        const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0); // End of current month
        var loadPanel = $("#loadPanel").dxLoadPanel("instance");
        loadPanel.show();
        $.ajax({
            url: '/api/VATModule/GetVATInvoiceReporting',
            type: 'GET',
            data: {
                startDate: firstDay.toISOString().split('T')[0],
                endDate: lastDay.toISOString().split('T')[0],
                accountGroup: "" // include this if your API expects it
            },
            success: function (data) {
                
                if (Array.isArray(data)) {
                    pivotData = data; // Set global
                    initializePivotGrid(data);
                   console.log("pivotdata",data)
                } else {
                    console.error("Unexpected response format", data);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching trial balance records:", xhr.responseText || error);
            },
            complete: function () {
                $("#loadPanel").dxLoadPanel("instance").hide(); // ✅ Always hide the loader
            }
        });
    }
    $(document).ready(function () {
        // Load all records on page load (ignore default date values)
        // initializePivotGrid([]);
        loadAllRecords();
    });

    $(function () {
            ddBtnShowRecords_click("range")
        $("#VATInvoiceReporting").dxTextBox({
            text: formatMessage("Sales Reporting"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });

    $(document).ready(function () {
        // Load this month's records by default
        loadDefaultRecords();
    });

    function loadDefaultRecords() {
        let today = new Date();
        let firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        let lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        fetchRecords(firstDay, lastDay);
    }

    function ddBtnShowRecords_click(option) {
        let today = new Date();
        let startDate = null;
        let endDate = null;

        switch (option) {
            case 'today':
                startDate = today;
                endDate = today;
                break;
            case 'yesterday':
                startDate = new Date();
                startDate.setDate(today.getDate() - 1);
                endDate = startDate;
                break;
            case 'week':
                startDate = new Date();
                startDate.setDate(today.getDate() - today.getDay());
                endDate = today;
                break;
            case 'tillmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = today;
                break;
            case 'fullmonth':
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                break;
            case 'tillyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = today;
                break;
            case 'fullyear':
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                break;
            case 'lastmonth':
                startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                endDate = new Date(today.getFullYear(), today.getMonth(), 0);
                break;
            case 'lastyear':
                startDate = new Date(today.getFullYear() - 1, 0, 1);
                endDate = new Date(today.getFullYear() - 1, 11, 31);
                break;
            case 'q1': // Jan - Mar
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 2, 31);
                break;

            case 'q2': // Apr - Jun
                startDate = new Date(today.getFullYear(), 3, 1);
                endDate = new Date(today.getFullYear(), 5, 30);
                break;

            case 'q3': // Jul - Sep
                startDate = new Date(today.getFullYear(), 6, 1);
                endDate = new Date(today.getFullYear(), 8, 30);
                break;

            case 'q4': // Oct - Dec
                startDate = new Date(today.getFullYear(), 9, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
                break;
            case 'range':
            default:
                // Get manual dates from DateBox controls
                startDate = $("#frmdateBox").dxDateBox("instance").option("value");
                endDate = $("#todateBox").dxDateBox("instance").option("value");
                if (!startDate || !endDate) {
                    DevExpress.ui.notify("Please select Start Date and End Date.", "warning", 3000);
                    return;
                }
                break;
        }

        // Update the DateBoxes with selected range
        $("#frmdateBox").dxDateBox("instance").option("value", startDate);
        $("#todateBox").dxDateBox("instance").option("value", endDate);
         hidequarterSubmenus();
        fetchRecords(startDate, endDate);
    }

    function fetchRecords(startDate, endDate) {
        console.log("Fetching records between:", startDate, "and", endDate);

        $.ajax({
            url: '/api/VATModule/GetVATInvoiceReporting',
            type: 'GET',
            data: {
                startDate: formatDate(startDate),
                endDate: formatDate(endDate)
            },
            // success: function (data) {
            //      pivotData = data; // Set global
            //     initializePivotGrid(data);
            // },
                success: function (data) {
        pivotData = data; // Set global
        updateGrandTotalCard(data); // 👈 Add this function
        initializePivotGrid(data);
           updateGrandTaxTotalCard(data);
    },

            error: function (xhr, status, error) {
                console.error("Error fetching records:", error);
            }
        });
    }
              function updateGrandTaxTotalCard(data) {
        let totalTax = 0;

        if (Array.isArray(data)) {
            totalTax = data.reduce((sum, item) => {
                const tax = parseFloat(item.CalcTaxAmount || 0);
                return sum + (isNaN(tax) ? 0 : tax);
            }, 0);
        }

        const formatted = totalTax.toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        // ✅ Update the card with the final tax amount
        $("#salesTaxTotal").text(formatted);
    }

        function updateGrandTotalCard(data) {
        let total = 0;
        if (Array.isArray(data)) {
            total = data.reduce((sum, item) => {
                const value = parseFloat(item.TotalRevenue);
                return sum + (isNaN(value) ? 0 : value);
            }, 0);
        }

        // Format to K/M if needed or just to fixed decimal
        const formatted = total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        // Update the card
        $("#invoiceCount").text(formatted);
    }

