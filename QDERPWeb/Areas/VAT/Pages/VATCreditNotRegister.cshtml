		function ddBtnShowRecords_click(duration) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");

		var frmDateVal = frmDateBox.option("value");
		var toDateVal = toDateBox.option("value");
		var currentDate = new Date();

		var frmDate = frmDateVal ? new Date(frmDateVal) : null;
		var toDate = toDateVal ? new Date(toDateVal) : null;

		switch (duration) {
			case 'today':
				frmDate = toDate = new Date();
				break;

			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;

			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;

			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;

			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;

			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;

			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;

			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;

			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
		}

		// Validate dates before proceeding
		if (!frmDate || !toDate) {
			DevExpress.ui.notify("Please select both Start and End Dates.", "warning", 2000);
			return;
		}

		// Format dates
		var formattedFrmDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		var formattedToDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });

		FromDate = formattedFrmDate;
		ToDate = formattedToDate;

		frmDateBox.option("value", formattedFrmDate);
		toDateBox.option("value", formattedToDate);

		$.ajax({
			url: '/api/VATModule/GetVatCreditNoteDetails',
			type: 'GET',
			data: {
				frmDate: formattedFrmDate,
				toDate: formattedToDate
			},
			success: function (data) {
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
				var dataGrid = $("#dataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.option("dataSource");
				if (dataSource && dataSource.length > 0) {
					var lastRow = dataSource[dataSource.length - 1];
					VoucherAmountFormatted = lastRow.VoucherAmountFormatted;

					var firstRow = dataSource[0];
					firstrowVoucherAmountFormatted = firstRow.VoucherAmountFormatted;
				}
			
			if (data && data.length > 0) {
				// Get last row
				var lastRow = data[data.length - 1];
				var VoucherAmountFormatted = lastRow.VoucherAmountFormatted;

				// Get first row
				var firstRow = data[0];
				var firstrowVoucherAmountFormatted = firstRow.VoucherAmountFormatted;

				console.log("First Row Amount:", firstrowVoucherAmountFormatted);
				console.log("Last Row Amount:", VoucherAmountFormatted);
			}
		},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}

	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
