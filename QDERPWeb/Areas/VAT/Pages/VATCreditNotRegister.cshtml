<script>
	let currentSlideIndex = 0;
	const slides = document.querySelectorAll('.voucher-slide');

	setInterval(() => {
		slides[currentSlideIndex].classList.remove('active');

		currentSlideIndex = (currentSlideIndex + 1) % slides.length;

		slides[currentSlideIndex].classList.add('active');
	}, 2000);
	let currentSlideIndex1 = 0;
	const slides1 = document.querySelectorAll('.voucher-slide1');

	setInterval(() => {
		slides1[currentSlideIndex1].classList.remove('active');

		currentSlideIndex1 = (currentSlideIndex1 + 1) % slides1.length;

		slides1[currentSlideIndex1].classList.add('active');
	}, 2000);

		function updateVerifiedCount(data) {
		const verifiedOnly = data.filter(item => item.InvoiceStatus === "Verified");
		document.getElementById("verifiedCount").textContent = verifiedOnly.length;
	}
		function updateApprovedCount(data) {
		const approvedOnly = data.filter(item => item.InvoiceStatus === "Approved");
		document.getElementById("approvedCount").textContent = approvedOnly.length;
	}

		function updatePostedCount(data) {
		const postedOnly = data.filter(item => item.InvoiceStatus === "Posted");
		document.getElementById("postedCount").textContent = postedOnly.length;
	}


				function onGridContentReady(e) {
		const dataSource = e.component.option("dataSource");

		if (dataSource && dataSource.length > 0) {
			// Count today's entries
			const todayCount = dataSource.filter(x => isToday(x.Date)).length;

			// Total count
			const totalCount = dataSource.length;

			// ✅ Count of Verified invoices only
