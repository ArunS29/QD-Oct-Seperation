	 function showColumnChooser() {
		var dataGrid = $("#dataGrid").dxDataGrid("instance");
		var isColumnChooserVisible = dataGrid.option("columnChooser.enabled");

		if (isColumnChooserVisible) {
			dataGrid.option("columnChooser.enabled", false); // Disable the column chooser
		} else {
			dataGrid.option("columnChooser.enabled", true);
			dataGrid.showColumnChooser();
		}
	}


		function invoiceStatusCellPrepared(e) {
		// Only target data rows (not header, group, etc.)
		if (e.rowType !== 'data') return;

		// Get the status value for this row
		var status = e.data?.InvoiceStatus;

		// Define status-to-color mapping
		var colors = {
			'Not Processed': { bg: '#f28b82', fg: '#000' },   // light red
			'Verified'     : { bg: '#ccffcc', fg: '#000' },   // light green
			'Approved'     : { bg: '#228B22', fg: '#fff' },   // dark green
			'Posted'       : { bg: '#FFA500', fg: '#000' }    // orange
		};

		// If this status is not in our list, do nothing
		var c = colors[status];
		if (!c) return;

		// Only apply style to the InvoiceStatus column
		if (e.column && e.column.dataField === 'InvoiceStatus') {
			e.cellElement.css({
				'background-color': c.bg,
				'color'           : c.fg
			});
		}

		// Debug log (optional)
		console.log("Styled row for InvoiceStatus:", status);
	}
	

