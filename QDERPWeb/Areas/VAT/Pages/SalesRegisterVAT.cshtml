		function ddBtnShowRecords_click(duration, page) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var chkEffective = $("#chkUseEffectiveDate").dxCheckBox("instance");
		var useEffective = chkEffective.option("value");
		var currentDate = new Date();
		var frmDate, toDate;

		switch (duration) {
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
			default:
				const frmValue = frmDateBox.option("value");
				const toValue = toDateBox.option("value");

				if (!frmValue || !toValue) {
					DevExpress.ui.notify("Please select both Start Date and End Date.", "warning", 2000);
					return;
				}
				frmDate = new Date(frmValue);
				toDate = new Date(toValue);
		}

		const formattedFromDate = frmDate.toLocaleDateString('en-CA');
		const formattedToDate = toDate.toLocaleDateString('en-CA');

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		if (page < 1) return;

		$.ajax({
			url: '/api/VATModule/GetVatInvoices',
			type: 'GET',
			data: {
				frmDate: formattedFromDate,
				toDate: formattedToDate,
				useEffectiveDate: useEffective,
				pageNumber: page,
				pageSize: pageSize
			},
			success: function (data) {
				if (data.data.length === 0 && page > 1) return;

				currentPage = Number(data.currentPage);
				var grid = $("#dataGrid").dxDataGrid("instance");
				grid.option("dataSource", data.data);

				updateInvoiceAmountCard(data.data);
				console.log("SalesRegisterGrid", data.data);

				if (data.data && data.data.length > 0) {
					VoucherAmountFormatted = data.data[data.data.length - 1].VoucherAmountFormatted;
					firstrowVoucherAmountFormatted = data.data[0].VoucherAmountFormatted;
				}

				const totalPages = Math.ceil(Number(data.totalCount) / Number(data.pageSize));
				$("#pageInfo").text(`Page ${data.currentPage} of ${totalPages} (${data.totalCount} items)`);
				$("#nextPage").prop("disabled", totalPages === data.currentPage);
				$("#previousPage").prop("disabled", data.currentPage === 1);

				const animatedCount = data.data.length;
				animateInvoiceCardCount(animatedCount);

				let periodLabel = "Invoices";
				switch (duration) {
					case 'today': periodLabel = "Today's Invoices"; break;
					case 'yesterday': periodLabel = "Yesterday's Invoices"; break;
					case 'week': periodLabel = "This Week's Invoices"; break;
					case 'tillmonth':
					case 'fullmonth': periodLabel = "This Month's Invoices"; break;
					case 'tillyear':
					case 'fullyear': periodLabel = "This Year's Invoices"; break;
					case 'lastmonth': periodLabel = "Last Month's Invoices"; break;
					case 'lastyear': periodLabel = "Last Year's Invoices"; break;
					default: periodLabel = "Invoices";
				}

				$("#invoicePeriodLabel").text(periodLabel);
				
				// ✅ Now Add Five-Year Count Calculation
				const today = new Date();
				today.setHours(0, 0, 0, 0);

				const fiveYearsAgo = new Date();
				fiveYearsAgo.setFullYear(today.getFullYear() - 5);
				fiveYearsAgo.setHours(0, 0, 0, 0);

				const fiveYearCount = data.data.filter(row => {
					const d = new Date(row.InvoiceDate); // or row.VoucherDate
					d.setHours(0, 0, 0, 0);
					return d >= fiveYearsAgo && d <= today;
				}).length;

				animateVoucherCount("fiveYearCount", fiveYearCount);
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}



	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}

	function checkIfOldVATInvoice(invoiceNo) {
		$.ajax({
			url: '/api/VATModule/IsOldVATInvoice',
			type: 'GET',
			data: { invoiceNo: invoiceNo },
			success: function (isOld) {
				if (isOld === true) {
					window.location.href = `/VATModule/frm20161VATInvoiceEdit?invoiceNo=${invoiceNo}`;
				} else {
					showInvoiceErrorPopup("This Invoice is registered as e-Invoice. Please review the Invoice Type. Use the e-Invoice View Form.");
				}
			},
			error: function () {
				showInvoiceErrorPopup("Error checking the invoice type.");
			}
		});
	}

	function showInvoiceErrorPopup(message) {
		$("#invoiceErrorPopup").dxPopup({
			title: "Invalid Action",
			contentTemplate: function () {
				return $("<div>").text(message);
			},
			width: 400,
			height: 200,
			showCloseButton: true,
			showTitle: true,
			visible: true,
			onHiding: function (e) {
