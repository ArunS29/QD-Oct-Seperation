		let isLast5Years = true; // Initial state

	function switchData() {
		const heading = document.getElementById("statusHeading1");
		const value = document.getElementById("valueDisplay1");

		if (isLast5Years) {
			heading.textContent = "New Voucher Today";

			const todayTarget = parseInt(document.getElementById("todayCount")?.textContent || "0", 10);
			animateTodayVoucherCount(todayTarget); // Animate count-up
		} else {
			heading.textContent = "Last 5 Years";
			value.textContent = document.getElementById("fiveYearCount")?.textContent || "0";
		}

		isLast5Years = !isLast5Years;
	}

