		}

		IsEdit = true;

		const url = `/${tenantName}/VAT/frm20161VATInvoiceEdit?InvoiceNo=${encodeURIComponent(invoiceNo)}&IsEditflag=${encodeURIComponent(IsEdit)}`;

		const title = "VAT Invoice Edit(B2B)";
