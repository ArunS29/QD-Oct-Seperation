	 function cloneEInvoice() {
		if (!invoiceNo) {
			alert("InvoiceNo is required.");
			return;
		}

		$.ajax({
			url: `/api/VATModule/InsertCloneEInvoice?InvoiceNo=${encodeURIComponent(invoiceNo)}`, // Change this to match your actual controller route
			type: 'POST',
			data: { InvoiceNo: invoiceNo },
			success: function (response) {
				console.log("Clone success:", response);

			},
			error: function (xhr) {
				let message = xhr.responseJSON?.message || "Unknown error";
				console.error("Clone error:", message);
				alert("Error: " + message);
			}
		});
	}


	function cancelInvoice() {
		if (!invoiceNo) {
			alert("InvoiceNo is required.");
			return;
		}
		let IsAmend=true;

		$.ajax({
			url: `/api/VATModule/InsertAmendEInvoice?InvoiceNo=${encodeURIComponent(invoiceNo)}`,
			type: 'POST',
			success: function (response) {
				CreditNoteNo=response.CreditNoteNo;
					if (response.IsPosted == null) {
		DevExpress.ui.dialog.alert(
			"Invoice is not Posted. You must post the invoice before cancelling or amending the invoice.",
			"Invoice is not Posted"
		);
	}
	else if (response.CreditInvoiceNo!=null && response.IsPosted === true)
	{
		DevExpress.ui.dialog.alert(
			"Invoice is already Issued with full Credit Note,Please review the Invoice & Credit Note Details.",
			"Invoice is already Credit Note Issued."
		);
	}
		else if (response.IsPosted === true) {
		DevExpress.ui.dialog.custom({
			title: "Cancel/Amend Confirmation",
			message: "You are about to Cancel/Amend this VAT Invoice.<br>This will create a new CREDIT NOTE for Invoice Amendment.<br>Click Yes if you would like to continue.",
				buttons: [
				{ text: "Yes", onClick: () => true },
				{ text: "No", onClick: () => false }
			],
			showTitle: true
		}).show().done(function (dialogResult) {
			if (dialogResult) {
				DevExpress.ui.dialog.alert(
					"Credit Note has been added to the database.",
					"Data Insertion Successful"
				).done(function () {
					window.location.href = `/${tenantName}/VAT/CreditNoteEditForm?InvoiceNo=${encodeURIComponent(invoiceNo)}&IsAmend=${encodeURIComponent(IsAmend)}&CreditNoteNo=${encodeURIComponent(CreditNoteNo)}`;
				});
			}
		});
	}
				console.log("Clone success:", response);
				// You can redirect to the Credit Note Edit page now

			},
			error: function (xhr) {
				let message = xhr.responseJSON?.message || "Unknown error";
				console.error("Clone error:", message);
				alert("Error: " + message);
			}
		});
	}







	$(document).ready(function () {
		console.log('Start permission handling AccountingLedgers');
		var formId = "frm201LedgerView";
		$.ajax({
			url: '/api/Permissions/GetAccessDetails?formId=' + formId,
			type: 'GET',
			contentType: 'application/json',
			success: function (response) {
				console.log("API Response:", response);

				if (response.success && response.permissions) {
					var controlStates = {
						"ddBtnShowRecords": { "Visible": false, "Enabled": false },

					};
					var fullAccess = response.permissions.find(p =>
						p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
					);

					if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
						Object.keys(controlStates).forEach(key => {
							controlStates[key] = { "Visible": true, "Enabled": true };
						});
					} else {
						Object.keys(controlStates).forEach(key => {
							var controlPermission = response.permissions.find(p =>
								p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
							);
							if (controlPermission) {
								controlStates[key] = {
									"Visible": controlPermission.ItemVisible || false,
									"Enabled": controlPermission.ItemEnabled || false
								};
							}
						});
					}
					console.log("Control States:", controlStates);
					Object.keys(controlStates).forEach(key => {
						var button = document.getElementById(key);
						if (button) {

							button.style.display = controlStates[key].Visible ? "inline-block" : "none";

							button.disabled = !controlStates[key].Enabled;
							console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
						} else {
							console.warn(`Button with ID "${key}" not found in the DOM.`);
						}
					});
				} else {
					console.warn("Failed to fetch permissions or no permissions available.");
				}
			},
			error: function (xhr, status, error) {
				console.error("Error fetching permissions:", error);
				alert('An error occurred while fetching permissions. Please try again.');
			}
		});
		console.log('End permission handling');
	});
