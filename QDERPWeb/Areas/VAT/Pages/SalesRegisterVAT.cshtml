		//openModal(url, title);
		 window.location.href = url; // Navigate to the page
	}


	 function cloneEInvoice() {
		if (!invoiceNo) {
			alert("InvoiceNo is required.");
			return;
		}

		$.ajax({
			url: `/api/VATModule/InsertCloneEInvoice?InvoiceNo=${encodeURIComponent(invoiceNo)}`, // Change this to match your actual controller route
			type: 'POST',
			data: { InvoiceNo: invoiceNo },
			success: function (response) {
				console.log("Clone success:", response);
				
			},
			error: function (xhr) {
				let message = xhr.responseJSON?.message || "Unknown error";
				console.error("Clone error:", message);
				alert("Error: " + message);
			}
		});
	}


	function cancelInvoice() {
		if (!invoiceNo) {
			alert("InvoiceNo is required.");
			return;
		}
		let IsAmend=true;

		$.ajax({
			url: `/api/VATModule/InsertAmendEInvoice?InvoiceNo=${encodeURIComponent(invoiceNo)}`,
			type: 'POST',
			success: function (response) {
				CreditNoteNo=response.CreditNoteNo;
					if (response.IsPosted == null) {
		DevExpress.ui.dialog.alert(
			"Invoice is not Posted. You must post the invoice before cancelling or amending the invoice.",
			"Invoice is not Posted"
		);
	}
	else if (response.CreditInvoiceNo!=null && response.IsPosted === true)
	{
		DevExpress.ui.dialog.alert(
			"Invoice is already Issued with full Credit Note,Please review the Invoice & Credit Note Details.",
			"Invoice is already Credit Note Issued."
		);
	}
		else if (response.IsPosted === true) {
		DevExpress.ui.dialog.custom({
			title: "Cancel/Amend Confirmation",
	        message: "You are about to Cancel/Amend this VAT Invoice.<br>This will create a new CREDIT NOTE for Invoice Amendment.<br>Click Yes if you would like to continue.",
				buttons: [
				{ text: "Yes", onClick: () => true },
				{ text: "No", onClick: () => false }
			],
			showTitle: true
		}).show().done(function (dialogResult) {
			if (dialogResult) {
				DevExpress.ui.dialog.alert(
					"Credit Note has been added to the database.",
					"Data Insertion Successful"
				).done(function () {
					window.location.href = `/${tenantName}/VAT/CreditNoteEditForm?InvoiceNo=${encodeURIComponent(invoiceNo)}&IsAmend=${encodeURIComponent(IsAmend)}&CreditNoteNo=${encodeURIComponent(CreditNoteNo)}`;
				});
			}
		});
	}
