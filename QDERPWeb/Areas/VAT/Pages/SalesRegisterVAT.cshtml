<script>
			
	const headings = ["Invoice Amount", "VAT Value"];
	let currentIndex = 0;

	// Default values
	let invoiceAmount = "0.00";
	let vatAmount = "0.00";

	// Update values from your data functions:
	function updateInvoiceAmountCard(data) {
		let total = 0;
		if (Array.isArray(data)) {
			total = data.reduce((sum, item) => {
				const val = parseFloat(item.TotalInvoiceAmount);
				return sum + (isNaN(val) ? 0 : val);
			}, 0);
		}
		invoiceAmount = total.toFixed(2);
	}

	function updateTotalVATValue(data) {
		let total = 0;
		if (Array.isArray(data)) {
			data.forEach(item => {
				const vat5 = parseFloat(item.DomesticStandartRatedTax) || 0;
				const vat10 = parseFloat(item.TotalTaxOf10Perc) || 0;
				const vat15 = parseFloat(item.TotalTaxOf15Perc) || 0;
				total += vat5 + vat10 + vat15;
			});
		}
		vatAmount = total.toFixed(2);
	}

	// Switch every 2 seconds
	setInterval(() => {
		currentIndex = (currentIndex + 1) % 2;

		const headingEl = document.getElementById("statusHeading");
		const valueEl = document.getElementById("switchValue");

		headingEl.textContent = headings[currentIndex];
		valueEl.innerHTML = `
			
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124.14 1256.39" width="16" height="16" fill="white" style="vertical-align: middle; margin-right: 5px;">
		<path d="M699.62,1113.02h0c-20.06,44.48-33.32,92.75-38.4,143.37l424.51-90.24c20.06-44.47,33.31-92.75,38.4-143.37l-424.51,90.24Z" />
		<path d="M1085.73,895.8c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.33v-135.2l292.27-62.11c20.06-44.47,33.32-92.75,38.4-143.37l-330.68,70.27V66.13c-50.67,28.45-95.67,66.32-132.25,110.99v403.35l-132.25,28.11V0c-50.67,28.44-95.67,66.32-132.25,110.99v525.69l-295.91,62.88c-20.06,44.47-33.33,92.75-38.42,143.37l334.33-71.05v170.26l-358.3,76.14c-20.06,44.47-33.32,92.75-38.4,143.37l375.04-79.7c30.53-6.35,56.77-24.4,73.83-49.24l68.78-101.97v-.02c7.14-10.55,11.3-23.27,11.3-36.97v-149.98l132.25-28.11v270.4l424.53-90.28Z" />
	</svg>
			${currentIndex === 0 ? invoiceAmount : vatAmount}
		`;
	}, 2000);
	



	function animateTodayVoucherCount(target) {
		let i = 0;
		const el = document.getElementById("todayCount");
		if (!el) return;

		el.classList.remove('bounce');

		const timer = setInterval(() => {
			if (i >= target) {
				el.innerText = target;
				el.classList.add('bounce');
				clearInterval(timer);
			} else {
				el.innerText = i++;
			}
		}, 30);
	}
			function animateTodayVoucherCount(target) {
		let i = 0;
		const el = document.getElementById("valueDisplay1");
		if (!el) return;

		el.classList.remove('bounce');

		const timer = setInterval(() => {
			if (i >= target) {
				el.innerText = target;
				el.classList.add('bounce');
				clearInterval(timer);
			} else {
				el.innerText = i++;
			}
		}, 30);
	}

		let isLast5Years = true; // Initial state

	function switchData() {
		const heading = document.getElementById("statusHeading1");
		const value = document.getElementById("valueDisplay1");

		if (isLast5Years) {
			heading.textContent = "New Voucher Today";

			const todayTarget = parseInt(document.getElementById("todayCount")?.textContent || "0", 10);
			animateTodayVoucherCount(todayTarget); // Animate count-up
		} else {
			heading.textContent = "Last 5 Years";
			value.textContent = document.getElementById("fiveYearCount")?.textContent || "0";
		}

		isLast5Years = !isLast5Years;
	}

	// Call once on page load
	switchData();

	// Automatically switch every 5 seconds
