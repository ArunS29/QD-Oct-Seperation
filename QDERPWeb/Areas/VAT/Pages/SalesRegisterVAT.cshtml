	];
	const tabs = document.querySelectorAll(".tab-text");
	const contents = document.querySelectorAll(".tab-content");

	function animateCount(el, target) {
	  let i = 0;
	  el.innerText = i;
	  el.classList.remove('bounce');
	  const interval = setInterval(() => {
		if (i >= target) {
		  el.innerText = target;
		  el.classList.add('bounce');
		  clearInterval(interval);
		} else {
		  el.innerText = i++;
		}
	  }, 30);
	}

	function switchTab(index) {
	  tabs.forEach((tab, i) => {
		tab.classList.toggle('active', i === index);
		contents[i].classList.toggle('active', i === index);
	  });

	  // Change background class
	  card.className = "card";
	  if (index === 0) card.classList.add("today-bg");
	  if (index === 1) card.classList.add("week-bg");
	  if (index === 2) card.classList.add("month-bg");

	  // Animate count
	  animateCount(countEls[index], counts[index]);
	}

	// ✅ Count Approved Invoices From Grid
	function updateApprovedCountFromGrid() {
	  const grid = $("#dataGrid").dxDataGrid("instance");
	  const data = grid.getDataSource().items();

	  // Update dynamic counts based on status
	  counts[0] = data.filter(item => item.InvoiceStatus === "Verified").length;
	  counts[1] = data.filter(item => item.InvoiceStatus === "Approved").length;
	  counts[2] = data.filter(item => item.InvoiceStatus === "Submitted").length;

	  // You can also update visible numbers immediately
	  countEls[0].textContent = counts[0];
	  countEls[1].textContent = counts[1];
	  countEls[2].textContent = counts[2];

	  // Optionally animate default tab (Today/Verified)
	  animateCount(countEls[0], counts[0]);
	}
