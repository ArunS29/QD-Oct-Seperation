	function ddBtnShowRecords_click(duration) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var chkEffective = $("#chkUseEffectiveDate").dxCheckBox("instance");
		var useEffective = chkEffective.option("value");

		var frmDate, toDate;
		var today = new Date();

		switch (duration) {
			case 'today':
				frmDate = toDate = new Date(today);
				break;
			case 'yesterday':
				var yest = new Date();
				yest.setDate(today.getDate() - 1);
				frmDate = toDate = yest;
				break;
			case 'week':
				var startOfWeek = new Date(today);
				var dayOfWeek = startOfWeek.getDay(); // Sunday=0
				startOfWeek.setDate(today.getDate() - dayOfWeek);
				var endOfWeek = new Date(startOfWeek);
				endOfWeek.setDate(startOfWeek.getDate() + 6);
				frmDate = startOfWeek;
				toDate = endOfWeek;
				break;
			case 'tillmonth':
				frmDate = new Date(today.getFullYear(), today.getMonth(), 1);
				toDate = today;
				break;
			case 'fullmonth':
				frmDate = new Date(today.getFullYear(), today.getMonth(), 1);
				toDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(today.getFullYear(), 0, 1);
				toDate = today;
				break;
			case 'fullyear':
				frmDate = new Date(today.getFullYear(), 0, 1);
				toDate = new Date(today.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(today.getFullYear() - 1, 0, 1);
				toDate = new Date(today.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
				toDate = new Date(today.getFullYear(), today.getMonth(), 0);
				break;
			default:
				frmDate = frmDateBox.option("value");
				toDate = toDateBox.option("value");
		}

		frmDate = new Date(frmDate).toLocaleDateString('en-CA'); // yyyy-MM-dd
		toDate = new Date(toDate).toLocaleDateString('en-CA');

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		$.ajax({
			url: '/api/VATModule/GetVatInvoices',
			type: 'GET',
			data: {
				frmDate: frmDate,
				toDate: toDate,
				useEffectiveDate: useEffective
			},
			success: function (data) {
				var grid = $("#dataGrid").dxDataGrid("instance");
				grid.option("dataSource", data);
				if (data && data.length > 0) {
					VoucherAmountFormatted = data[data.length - 1].VoucherAmountFormatted;
					firstrowVoucherAmountFormatted = data[0].VoucherAmountFormatted;
				}
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}

	function formatDate(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		var strmonth = d.toLocaleString('default', { month: 'short' });
		if (day.length < 2)
			day = '0' + day;

		return [day, strmonth, year].join('-');
	}
