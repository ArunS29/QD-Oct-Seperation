<script>

		const headings = ["Invoice Amount", "VAT Value"];
	let currentIndex = 0;

	// Default values
	let invoiceAmounted = "0.00";
	let vatAmounted = "0.00";

	// Format helper
	function formatNumber(num) {
		return Number(num || 0).toLocaleString("en-US", {
			minimumFractionDigits: 2,
			maximumFractionDigits: 2
		});
	}

	function updateInvoiceAmountCard(data) {
		if (!Array.isArray(data)) return;
		const total = data.reduce((sum, item) => sum + (parseFloat(item.TotalInvoiceAmount) || 0), 0);
		invoiceAmounted = formatNumber(total);
	}

	function updateTotalVATValue(data) {
		if (!Array.isArray(data)) return;
		const total = data.reduce((sum, item) =>
			sum +
			(parseFloat(item.DomesticStandartRatedTax) || 0) +
			(parseFloat(item.TotalTaxOf10Perc) || 0) +
			(parseFloat(item.TotalTaxOf15Perc) || 0), 0
		);
		vatAmounted = formatNumber(total);
	}

	// Switch every 2 seconds
	setInterval(() => {
		currentIndex = (currentIndex + 1) % 2;

		const headingEl = document.getElementById("statusHeading");
		const valueEl = document.getElementById("switchValue");

		headingEl.textContent = headings[currentIndex];
		valueEl.innerHTML = `
			
