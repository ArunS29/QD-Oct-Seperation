<div class="context-menuInvoice" id="contextMenu">
	<div class="context-menu-itemInvoice" onclick="viewInvoice()">
		<i class="dx-icon-search"></i> View e-Invoice
	</div>

	<div class="context-menu-itemInvoice" onclick="cancelInvoice()">
		<i class="dx-icon-close"></i> Cancel/Amend this Invoice (Invoice Credit Note)
	</div>
	<div class="context-menu-itemInvoice has-submenu">
		<i class="dx-icon-file"></i> VAT Invoices (Obselete)
		<div class="submenu">
			<div class="context-menu-itemInvoice" onclick="checkIfOldVATInvoice('INV001')">
				<i class="dx-icon-file"></i> View VAT Invoice
			</div>
		</div>
	</div>

	<div class="context-menu-itemInvoice" onclick="cloneEInvoice()">
		<i class="dx-icon-copy"></i> Clone e-Invoice
	</div>
</div>


<div class="horizontal-container">
	@(Html.DevExtreme().DateBox()
		.ID("frmdateBox")
		.Label(new JS("formatMessage('Start Date')"))
		.LabelMode(EditorLabelMode.Floating)
