		function invoiceStatusCellTemplate(cellElement, cellInfo) {
		const status = cellInfo.value;
		let backgroundColor = "";
		let textColor = "black";

		switch (status) {
			case "Not Processed":
				backgroundColor = "#f8d7da"; // light red
				textColor = "#721c24";       // dark red text
				break;
			case "Verified":
				backgroundColor = "#d4edda"; // light green
				textColor = "#155724";       // dark green text
				break;
			case "Approved":
				backgroundColor = "#c3e6cb"; // darker green
				textColor = "#0b3d18";
				break;
			case "Posted":
				backgroundColor = "#ffeeba"; // light orange/yellow
				textColor = "#856404";
				break;
			default:
				backgroundColor = "#f0f0f0";
				textColor = "#000000";
		}

		cellElement.text(status);
		cellElement.css({
			"background-color": backgroundColor,
			"color": textColor,
			"font-weight": "bold",
			"padding": "5px",
			"border-radius": "4px",
			"text-align": "center"
		});
	}
