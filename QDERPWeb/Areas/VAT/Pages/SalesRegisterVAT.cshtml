				subColumns.AddFor(m => m.InvoiceStatus)
		.Caption(new JS("formatMessage('Invoice Status')"))
		.Alignment(HorizontalAlignment.Center)
		.Visible(true)
		.CellTemplate(new JS("invoiceStatusCellTemplate"));

			});


			columns.Add().Caption(new JS("formatMessage('Revenue & Tax Amount')")).Columns(subColumns =>
