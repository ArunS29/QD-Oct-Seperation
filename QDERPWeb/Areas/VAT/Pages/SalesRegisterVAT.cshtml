<script>

		let invoiceNo = null;
	let IsEdit = false;

	// Assuming tenantName is already defined globally
	function viewInvoice() {
		if (!invoiceNo) {
			alert("Invoice number is not set.");
			return;
		}

		IsEdit = true;

		const params = new URLSearchParams({
			InvoiceNo: invoiceNo,
			IsEditflag: IsEdit,
			modal: true // If you want to explicitly include modal=true
		});

		const url = `/${tenantName}/VAT/frm20161VATInvoiceEdit?${params.toString()}`;
		const title = "VAT Invoice Edit(B2B)";
		//openModal(url, title);
		 window.location.href = url; // Navigate to the page

	}


	 function cloneEInvoice() {
		if (!invoiceNo) {
			alert("InvoiceNo is required.");
			return;
		}

		$.ajax({
			url: `/api/VATModule/InsertCloneEInvoice?InvoiceNo=${encodeURIComponent(invoiceNo)}`, // Change this to match your actual controller route
			type: 'POST',
			data: { InvoiceNo: invoiceNo },
			success: function (response) {
				console.log("Clone success:", response);
				
			},
			error: function (xhr) {
				let message = xhr.responseJSON?.message || "Unknown error";
				console.error("Clone error:", message);
				alert("Error: " + message);
			}
		});
	}


	 function cancelInvoice() {
		if (!invoiceNo) {
			alert("InvoiceNo is required.");
			return;
		}

		$.ajax({
			url: `/api/VATModule/InsertAmendEInvoice?InvoiceNo=${encodeURIComponent(invoiceNo)}`, // Change this to match your actual controller route
			type: 'POST',
			data: { InvoiceNo: invoiceNo },
			success: function (response) {
				console.log("Clone success:", response);
				
			},
			error: function (xhr) {
