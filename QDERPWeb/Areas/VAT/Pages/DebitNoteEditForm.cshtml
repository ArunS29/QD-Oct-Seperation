function onDeleteButtonClick() {
    const DebitNoteNo = $('#DebitNoteNo').dxTextBox("instance").option("value");

    if (!DebitNoteNo) {
        DevExpress.ui.notify("Please select a Debit Note to delete.", "warning", 3000);
        return;
    }

    // Ask for confirmation before deleting
    DevExpress.ui.dialog.confirm("Are you sure you want to delete this Debit Note?", "Confirm Delete")
        .done(function (dialogResult) {
            if (dialogResult) { // true if Yes
                $.ajax({
                    url: '/api/VATModule/DeleteDebitNoteEInvoice',
                    method: 'POST',
                    data: { invoiceNo: DebitNoteNo },
                    success: function (response) {
                        if (response) {
                            DevExpress.ui.notify("Debit Invoice has been successfully deleted from the database.", "success", 3000);
                            grid.refresh();
							history.back();
                        } else {
                            DevExpress.ui.notify(response.message || "Delete failed.", "error", 3000);
                        }
                    },
                    error: function () {
                        DevExpress.ui.notify("Server error while deleting the invoice.", "error", 3000);
                    }
                });
            }
        });
}


