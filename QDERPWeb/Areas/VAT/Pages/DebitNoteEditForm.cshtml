	function VATPercentage(newValue, rowIndex,TaxSlabCode) {
		let grid = $("#B2BdataGrid").dxDataGrid("instance");

		// Get current row values
		let qty = grid.cellValue(rowIndex, "QuantityDebited") || 0;

		let unitPrice = grid.cellValue(rowIndex, "UnitRate") || 0;
		let vatRateStr = newValue || "0%";


		//let vatRate = parseFloat(vatRateStr.replace("%", "")) / 100;
		let vatRate = parseFloat(vatRateStr);


		// Calculate amount and VAT
		let amount = qty * unitPrice;
		let vatValue = amount * vatRate;
		let totalValue = amount + vatValue;
		//alert(vatValue)
					// Update values in the grid
				grid.cellValue(rowIndex, "VAT", vatValue.toFixed(2));
				grid.cellValue(rowIndex, "Total", totalValue.toFixed(2));
				grid.cellValue(rowIndex, "Qty",qty);
				grid.cellValue(rowIndex, "Amount",amount);
				grid.cellValue(rowIndex, "VAT Description",vatRateStr);
				grid.cellValue(rowIndex, "TaxSlabCode",TaxSlabCode);

	}


