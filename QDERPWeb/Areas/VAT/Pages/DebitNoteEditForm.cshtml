	//2. Get Document Count
	async function getDocumentCount() {
		const DebitNoteNoBox = $("#DebitNoteNo").dxTextBox("instance");
        const debitNoteNo = DebitNoteNoBox ? DebitNoteNoBox.option("value") : null;
        var formType ="e-Invoice DebitNote";
        var menuType = "vat";
		const response = await fetch(`/api/VATModule/GetInvoiceNoFromDebitNote?debitNoteNo=${encodeURIComponent(debitNoteNo)}`);
        var invoiceNofromPurchase = await response.text(); // Get Invoice No
        console.log(invoiceNofromPurchase);
        var invoiceRes = null, invoiceData = null;
        let folderId2 = "";
        if(invoiceNofromPurchase?.trim()) {
            invoiceRes = await fetch(`/api/VATModule/GetPONosFromPurchaseInvoice?purchaseInvoiceNo=${encodeURIComponent(invoiceNofromPurchase)}`);
            invoiceData = await invoiceRes.json();
            if (invoiceData) {
                folderId2 = [
                    invoiceData.PurchaseVoucherNo,
                    invoiceData.MaterialReceiptNo,
                    invoiceData.PurchaseOrderNo, 
                ]
                .filter(Boolean)   //remove null/empty
                .join(",");
            }
        }

		const res = await fetch(`/api/LedgerDocumentsF/GetDocuments?folderId=${encodeURIComponent(debitNoteNo)}&module=${encodeURIComponent(formType)}&menuType=${encodeURIComponent(menuType)}&folderId2=${encodeURIComponent(folderId2)}`);
		const docs = await res.json();
		const count = docs.length;
		updateAttachButtonCount("#btnAttach", count);
	}

