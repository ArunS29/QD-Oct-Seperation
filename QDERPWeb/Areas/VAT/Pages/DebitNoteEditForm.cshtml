 async function convertToArabic() {

		// Get the TextBox1 (input) instance

		const textBox1Instance = $("#txtInvoiceNotes").dxTextArea("instance");

		// Get the TextBox2 (output) instance

		const textBox2Instance = $("#txtNotesinArabic").dxTextArea("instance");

		// Ensure both instances are initialized

		if (!textBox1Instance || !textBox2Instance) {

			console.error("TextBox instances are not properly initialized.");

			return;

		}

		
		// Get the value from TextBox1

		const englishText = textBox1Instance.option("value");



		// Validate input

		if (!englishText || englishText.trim() === "") {

			alert("Please enter text to translate.");

			return;

		}

		// Perform translation

		const arabicTranslation = await translateToArabic(englishText);

		// Update TextBox2 with the Arabic translation

		textBox2Instance.option("value", arabicTranslation);

	}


	
			 // Fetch from API when page loads
	$.get("/api/VATModule/GetCurrencyDecimals")
		.done(function (decimals) {
			currencyDecimals = decimals || 2;
			// applyDynamicFormat(currencyDecimals);
		})
		.fail(function () {
			DevExpress.ui.notify("Failed to load currency decimals, defaulting to 2", "warning", 3000);
		});


		function formatAmount(val) {
		if (val == null || isNaN(val)) return 0;
		return Number(val).toFixed(currencyDecimals);
	}

	


	function getDecimalFormat(decimals) {
		if (decimals <= 0) return "#,##0";
		return "#,##0." + "0".repeat(decimals);
	}


	function formatSummaryValue(value) {
		if (value == null || isNaN(value)) return 0;
		return value.toLocaleString(undefined, {
			minimumFractionDigits: currencyDecimals,
			maximumFractionDigits: currencyDecimals
		});
	}

