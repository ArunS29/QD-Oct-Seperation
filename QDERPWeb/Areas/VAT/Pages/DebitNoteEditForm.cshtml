<!-- Modal Structure -->
<script>


	$(document).ready(function () {
    // Sync when Supplier Name changes
    $("#VATSupplierName").dxDropDownBox("instance").on("valueChanged", function(e) {
        var arabicDropDown = $("#ddlSupplierNameArabic").dxDropDownBox("instance");
        if (arabicDropDown && arabicDropDown.option("value") !== e.value) {
            arabicDropDown.option("value", e.value);
        }
    });

    // Sync when Supplier Arabic Name changes
    $("#ddlSupplierNameArabic").dxDropDownBox("instance").on("valueChanged", function(e) {
        var nameDropDown = $("#VATSupplierName").dxDropDownBox("instance");
        if (nameDropDown && nameDropDown.option("value") !== e.value) {
            nameDropDown.option("value", e.value);
        }
    });
});

	let accid=null,revaccheadid=null,InvoiceCurrencyExchangeId=null,TaxCurrencyExchangeId=null,branchcode=null,salespersoncode=null,companyid=null,SellerOtherIdtype=null,
			  SignatoryID=null,ChkbySignatoryID=null,ApproedbySignatoryID=null,IsCurrent="false",IsAmend="false",supplierid=null,IsDirectApproval=true,IsDirectVerify=true,UnitCode=null,currencyDecimals = 2;
			  window.supplierid = 0; // must be global
		function navigateToLedgerAccountForm() {
		// make sure this is available in the view
			const url = `/${tenantName}/VAT/VATDatabaseSignatories`;
			const title = "";
			openModal(url, title); // opens in modal instead of new window
		}

			  let ItemNo=null, paymentmeanstypecode=null,amt=0, accheadid =null;

			function InvoiceOPenToSave(data) {


		var InvoiceMaster = {
		DebitNoteNo:data,
		DebitNoteDate: $("#CreditNoteIssuedDateTime").dxDateBox("instance").option("value") || null,
		PurchaseVoucherNo: $("#VATPurchaseVoucherNo").dxDropDownBox("instance").option("value") || null,
		SupplierBillNo:$("#SupplierInvoiceNo").dxTextBox("instance").option("value") || null,
		SupplierCode: supplierid,
		SupplierBillDate: $("#InvoiceDate").dxDateBox("instance").option("value") || null,
		//SupplierNameAr:$("#ddlSupplierNameArabic").dxDropDownBox("instance").option("value"),
		ReferenceNo:$("#txtReferenceNo").dxTextBox("instance").option("value") || null,
		InvoicePeriod:$("#txtInvoicePeriod").dxTextBox("instance").option("value") || null,
		ItemReturns:$("#ddItemsReturnfromstore").dxDropDownBox("instance").option("value")||null,
		DebitNoteEffectiveDate:$("#EffectiveDate").dxDateBox("instance").option("value") || null,
	// 	//PaymentMeansTypeCode: paymentmeanstypecode,
		RevenueAccount:$("#ddPurchaseAccount").dxDropDownBox("instance").option("value")||null,
		CostCenterCode:$("#ddlCostCenterAccount").dxDropDownBox("instance").option("value")||null,
		DebitNoteRemarks:$("#txtInvoiceNotes").dxTextArea("instance").option("value") || null,
		DebitNoteRemarksAr:$("#txtNotesinArabic").dxTextArea("instance").option("value") || null,
		BranchCode:$("#ddlDivision").dxDropDownBox("instance").option("value")||null,
		CompanyId:$("#ddlDebitNoteDivision").dxDropDownBox("instance").option("value")||null
	};

			console.log("InvoiceMaster:", InvoiceMaster);


			$.ajax({
				type: "POST",
				url: `/api/VoucherMaster/UpdateDebitNoteMasterDetails`,
				contentType: "application/json",
				data: JSON.stringify(InvoiceMaster),
				success: function () {
					getDocumentCount();
				}

			});
		}

		$(function () {
					$("#DebitNoteEditForm").dxTextBox({
						text: formatMessage("New e-Invoice Debit Note"),
						readOnly: true,
									onContentReady: function(e) {
									$(e.element).addClass("dx-textcolor-heading");
							}

					});
				});
		//View e-Invoice

		$(document).ready(function () {
			var urlParams = new URLSearchParams(window.location.search);
			var DebitNoteNo		 = urlParams.get('DebitNoteNo');
			var IsEditflag = urlParams.get('IsEditflag');
			var InvNo = urlParams.get('InvoiceNo');
			IsAmend = urlParams.get('IsAmend');



		 IsCurrent = (IsEditflag || "").toString();
		 console.log(IsCurrent)
		if (IsCurrent === "true") {

				$.ajax({
					url: `/api/VATModule/GetDebitNoteDetails?DebitNoteNo=${encodeURIComponent(DebitNoteNo)}`,
