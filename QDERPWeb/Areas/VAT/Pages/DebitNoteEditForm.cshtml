	$(function () {
			var selectedRowKey = null;
		// Hide context menu when clicking outside
		$(document).on("click", function () {
			$("#contextMenu").hide();
		});

		// Handle context menu item clicks
		$(".context-menu-itemInvoice").on("click", function (e) {
			e.stopPropagation(); // Prevent menu from hiding immediately

			const action = $(this).data("action");
			const grid = $("#B2BdataGrid").dxDataGrid("instance");
			const selectedRowKeys = grid.getSelectedRowKeys();
			selectedRowKey = selectedRowKeys.length > 0 ? selectedRowKeys[0] : null;

			if (!grid) {
				DevExpress.ui.notify("Grid instance not found.", "error", 2000);
				return;
			}

			if (action === "add") {
				grid.addRow();
				grid.saveEditData();
			}
			else if (action === "delete") {
				if (selectedRowKey !== null) {
					const rowIndex = grid.getRowIndexByKey(selectedRowKey);
					if (rowIndex >= 0) {
						const rowData = grid.getDataSource().items()[rowIndex];
						const { DebitNoteChildSlNo, DebitNoteNo } = rowData;

						if (!DebitNoteChildSlNo) {
							grid.deleteRow(rowIndex); // Deletes from UI
						} else {
							DevExpress.ui.dialog.confirm(
								"You are about to delete invoice line item.\nAre you sure you want to delete this invoice detail?",
								"Delete Invoice"
							).done(function (confirmResult) {
								if (confirmResult) {
									$.ajax({
										url: "/api/VATModule/DeleteDebitNoteEditInvoiceChild",
										type: "POST",
										contentType: "application/json",
										data: JSON.stringify(DebitNoteChildSlNo),
										success: function (response) {
											if (response.success) {
												grid.refresh();
												DevExpress.ui.dialog.alert("VAT Invoice Line Item Deleted Successfully.", "Data Delete Successful");

												// Fetch updated data and re-bind the grid
												$.ajax({
													type: "GET",
													url: `/api/VATModule/GetGridDebitNoteDetails?DebitNoteNo=${encodeURIComponent(DebitNoteNo)}`,
													dataType: 'json',
													success: function (data) {
														
														const newRowData = data.map((item, index) => ({
															SNo: index + 1,
															...item
														}));
														initializeDataGrid(newRowData);
													},
													error: function () {
														DevExpress.ui.notify("Failed to refresh grid data.", "error", 2000);
													}
												});
											} else {
												DevExpress.ui.notify(response.message || "Deletion failed.", "error", 2000);
											}
										},
										error: function (xhr) {
											DevExpress.ui.notify("Server error: " + xhr.statusText, "error", 2000);
										}
									});
								}
							});
						}
						grid.saveEditData();
					}
				} else {
					DevExpress.ui.notify("No row selected to delete.", "error", 2000);
				}
			}
	


			$("#contextMenu").hide();
		});
	});

