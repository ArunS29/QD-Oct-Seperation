							url: '/api/VATModule/DeleteDebitNoteCloneEInvoice',
							method: 'POST',
								data: { invoiceNo: DebitNoteNo },
							success: function (response) {
								if (response) {

										DevExpress.ui.dialog.alert("Debit Invoice has been successfully added to the database.", "Cloned Successfully");
