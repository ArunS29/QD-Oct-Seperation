<script>
		function animateInvoiceCount(target) {
	  let i = 0;
	  const el = document.getElementById("invoiceCount");
	  el.classList.remove('bounce');

	  const timer = setInterval(() => {
		if (i >= target) {
		  el.innerText = target;
		  el.classList.add('bounce');
		  clearInterval(timer);
		} else {
		  el.innerText = i++;
		}
	  }, 30);
	}

	// Animate to 40
	animateInvoiceCount(40);


	function countUpTurnover(targetStr) {
	  const el = document.getElementById("turnover");
	  const target = parseFloat(targetStr);
	  let current = 0.0;

	  const interval = setInterval(() => {
		current += 0.5;
		if (current >= target) {
		  el.textContent = targetStr + " K";
		  clearInterval(interval);
		} else {
		  el.textContent = current.toFixed(1) + " K";
		}
	  }, 30);
	}

	// Animate to 46.2 K
	countUpTurnover("46.2");


		  const card = document.getElementById('mainCard');
		const counts = [8, 15, 5];
		const countEls = [
		  document.getElementById("count0"),
		  document.getElementById("count1"),
		  document.getElementById("count2"),
		];
		const tabs = document.querySelectorAll(".tab-text");
		const contents = document.querySelectorAll(".tab-content");

		function animateCount(el, target) {
		  let i = 0;
		  el.innerText = i;
		  el.classList.remove('bounce');
		  const interval = setInterval(() => {
			if (i >= target) {
			  el.innerText = target;
			  el.classList.add('bounce');
			  clearInterval(interval);
			} else {
			  el.innerText = i++;
			}
		  }, 30);
		}

		function switchTab(index) {
		  tabs.forEach((tab, i) => {
			tab.classList.toggle('active', i === index);
			contents[i].classList.toggle('active', i === index);
		  });

		  // Change background class
		  card.className = "card";
		  if (index === 0) card.classList.add("today-bg");
		  if (index === 1) card.classList.add("week-bg");
		  if (index === 2) card.classList.add("month-bg");

		  // Animate count
		  animateCount(countEls[index], counts[index]);
		}

		// Start "Today" count immediately
		animateCount(countEls[0], counts[0]);

		function switchTab(index) {
		  tabs.forEach((tab, i) => {
			tab.classList.toggle('active', i === index);
			contents[i].classList.toggle('active', i === index);
		  });

		  // Change background class
		  card.className = "card";
		  if (index === 0) card.classList.add("today-bg");
		  if (index === 1) card.classList.add("week-bg");
		  if (index === 2) card.classList.add("month-bg");

		  // Animate count
		  animateCount(countEls[index], counts[index]);
		}

		// Auto-start animation for "Today"
		animateCount(countEls[0], counts[0]);



			function DebitStatusCellTemplate(cellElement, cellInfo) {
		const status = cellInfo.value;
		let backgroundColor = "";
		let textColor = "black";

		switch (status) {
			case "Not Processed":
				backgroundColor = "#f8d7da"; // light red
				textColor = "#721c24";       // dark red text
				break;
			case "Verified":
				backgroundColor = "#d4edda"; // light green
				textColor = "#155724";       // dark green text
				break;
			case "Approved":
				backgroundColor = "#c3e6cb"; // darker green
				textColor = "#0b3d18";
				break;
			case "Posted":
				backgroundColor = "#ffeeba"; // light orange/yellow
				textColor = "#856404";
				break;
			default:
				backgroundColor = "#f0f0f0";
				textColor = "#000000";
		}

		cellElement.text(status);
		cellElement.css({
			"background-color": backgroundColor,
			"color": textColor,
			"font-weight": "bold",
			"padding": "5px",
			"border-radius": "4px",
			"text-align": "center"
		});
	}
