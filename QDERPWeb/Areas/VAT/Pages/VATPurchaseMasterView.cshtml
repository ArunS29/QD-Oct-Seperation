		});
		return '<span style=""display:inline-block; background-color:#ffe6e6; color:#d93025; font-weight:bold; padding:4px 10px; border-radius:20px;"">' + formatted + '</span>';
		}
		return '';
		}
		").HeaderCellTemplate(@<text>
						  		<div class="DomesticRevenue-header" style="font-weight: bold;">
						  			<%= column.caption %>
						  		</div>
						  	</text>);

				domestic.AddFor(m => m.TotalDspurchase10Perc)
			.Caption(new JS("formatMessage('Domestic Purchases @10%')"))
