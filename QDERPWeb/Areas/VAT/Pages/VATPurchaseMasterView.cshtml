				domestic.AddFor(m => m.DomesticExemptedTaxPurchases)
			.Caption(new JS("formatMessage('Domestic Exempted Purchases')"))
			.Alignment(HorizontalAlignment.Center)
			.EncodeHtml(false)
			.CustomizeText(@"
