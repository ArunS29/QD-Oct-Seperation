		}
		return '';
		}
		").HeaderCellTemplate(@<text>
		<div class="ToatlAmt-header" style="font-weight: bold;">
			<%= column.caption %>
		</div>
	</text>);

			});

			// 🔹 PURCHASE CLASSIFIED - Domestic & Imports
			columns.Add().Caption(new JS("formatMessage('Revenue Classified')")).Columns(pclass =>
			{
				// Domestic
				pclass.Add().Caption(new JS("formatMessage('Domestic')")).Columns(domestic =>
			{
				domestic.AddFor(m => m.DomesticStandardPurchases)
			.Caption(new JS("formatMessage('Domestic Purchases @5%')"))
			.Alignment(HorizontalAlignment.Center)
			.EncodeHtml(false)
			.CustomizeText(@"
