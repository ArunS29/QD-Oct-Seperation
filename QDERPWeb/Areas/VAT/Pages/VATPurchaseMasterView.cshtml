	// Update values from your data functions:
	function updatePurchaseAmountCard(data) {
		let total = 0;
		if (Array.isArray(data)) {
			total = data.reduce((sum, item) => {
				const val = parseFloat(item.TotalPurchaseAmount);
				return sum + (isNaN(val) ? 0 : val);
			}, 0);
		}
		invoiceAmounts = total.toFixed(2);
	}

	function updateTotalVATValue(data) {
		let total = 0;
		if (Array.isArray(data)) {
			data.forEach(item => {
				const vat5 = parseFloat(item.DomesticStandardPurTax) || 0;
				const vat10 = parseFloat(item.TotalDspurchaseTax10Perc) || 0;
				const vat15 = parseFloat(item.TotalDspurchaseTax15Perc) || 0;
				total += vat5 + vat10 + vat15;
			});
		}
		vatTotalValues = total.toFixed(2);
	}

