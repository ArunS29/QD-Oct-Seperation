<div class="Head">
	@await Html.PartialAsync("/Pages/Shared/VAT/VATPurchaseRegisterFooter.cshtml")
</div>
<div class="context-menu" id="contextMenu" style="width: max-content;">
	<div class="context-menu-item" onclick="viewInvoice()">
		<i class="dx-icon-edit"></i> Edit Invoice
	</div>
	<div class="context-menu-item" onclick="cancelInvoice()">
		<i class="dx-icon-close"></i> Cancel VAT Purchase (Issue Debit Note)
	</div>
	<div class="context-menu-item" onclick="UnlockInvoice()">
		<i class="dx-icon-unlock"></i> Unlock The Bill
	</div>

	<div class="context-menu-item" onclick="cloneEInvoice()">
		<i class="dx-icon-copy"></i> Clone e-Invoice
	</div>
</div>



<div class="horizontal-container">
	@(Html.DevExtreme().DateBox()
		.ID("frmdateBox")
		.Label(new JS("formatMessage('Start Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) // First day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(2)
		)

	@(Html.DevExtreme().DateBox()
		.ID("todateBox")
		.Label(new JS("formatMessage('End Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(3)
		)


	@(Html.DevExtreme().DropDownButton()
		.ID("ddBtnShowRecords")
		.Text(new JS("formatMessage('Show Records')"))
		.Icon("smalliconslayout")
		.Width(180)
		
		.TabIndex(4)
		.SplitButton(true)
.OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }") // MAIN button click
				.DropDownOptions(options => options.Width(230))
				.Items(items =>
				{
					items.Add().Text(new JS("formatMessage('Show Records')")).Icon("event").Option("color", "#4285F4").OnClick("function() { ddBtnShowRecords_click('range'); }");
					items.Add().Text(new JS("formatMessage('Today')")).Icon("event").Option("color", "#34A853").OnClick("function() { ddBtnShowRecords_click('today'); }");
					items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").Option("color", "#EA4335").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
					items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").Option("color", "#FBBC05").OnClick("function() { ddBtnShowRecords_click('week'); }");
					items.Add().Text(new JS("formatMessage('This Month Till Date')")).Option("color", "#AB47BC").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
					items.Add().Text(new JS("formatMessage('This Month (Full)')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
					items.Add().Text(new JS("formatMessage('This Year Till Date')")).Option("color", "#FF7043").Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
					items.Add().Text(new JS("formatMessage('This Year (Full)')")).Option("color", "#4285F4").Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
					items.Add().Text(new JS("formatMessage('Last Month')")).Option("color", "#FBBC05").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
					items.Add().Text(new JS("formatMessage('Last Year')")).Option("color", "#00ACC1").Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
				})
				.ItemTemplate(@<text>
            <div class="custom-dropdown-item" >
                  <div style="background-color:<%- color %>;height:90%" class="side-bar"></div>
                <div class="item-content">
                    <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                    <div>
                        <div class="item-title"><%- text %></div>
                    </div>
                </div>
            </div>
        </text>)
		)

</div>
<div class="dx-field ledgerResult">
	@(Html.DevExtreme().DataGrid<QD.ERP.Web.DAL.Entities.Qry201707vatpurchaseRegisterMainView>()
		.ID("dataGrid")
		.RemoteOperations(false)
		.OnContentReady("onGridContentReady")
		.DataSource(new JS("[]"))
		.Columns(columns =>
		{
			// 🔹 PURCHASE DETAILS
			columns.Add().Caption(new JS("formatMessage('Purchase Details')")).Columns(detail =>
			{
				detail.AddFor(m => m.PurchaseVoucherNo).Caption(new JS("formatMessage('Purchase Voucher No')"));
				detail.AddFor(m => m.PurchaseVoucherDate)
			.Caption(new JS("formatMessage('Purchase Voucher Date')"))
			.Format("dd-MMM-yyyy");

				detail.AddFor(m => m.AccountHead).Caption(new JS("formatMessage('Account Head')"));
				detail.AddFor(m => m.VoucherStatus).Caption(new JS("formatMessage('Voucher Status')")).CellTemplate(new JS("VoucherStatusCellTemplate"));
			});

			// 🔹 PURCHASE & TAX AMOUNT
			columns.Add().Caption(new JS("formatMessage('Purchase & Tax Amount')")).Columns(amount =>
			{
				amount.AddFor(m => m.CalcLineAmount)
			.Caption(new JS("formatMessage('Amount Before Tax')"))
			.Alignment(HorizontalAlignment.Center)
			.EncodeHtml(false) // Required for HTML styling to render
			.CustomizeText(@"
		function(e) {
		if (e.value != null) {
		const formatted = e.value.toLocaleString(undefined, {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2
		});
		return '<span style=""display:inline-block; background-color:#e6ffe6; color:#1a8f1a; font-weight:bold; padding:4px 10px; border-radius:20px;"">' + formatted + '</span>';
		}
		return '';
		}
		").HeaderCellTemplate(@<text>
						   		<div class="AmtBeforeTax-header" style="font-weight: bold;">
						   			<%= column.caption %>
						   		</div>
						   	</text>);


				amount.AddFor(m => m.CalcTaxAmount)
			.Caption(new JS("formatMessage('Total VAT Amount')"))
			.Alignment(HorizontalAlignment.Center)
			.EncodeHtml(false) // Enables HTML formatting for colored styling
			.CustomizeText(@"
		function(e) {
		if (e.value != null) {
		const formatted = e.value.toLocaleString(undefined, {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2
		});
		return '<span style=""display:inline-block; background-color:#ffe6e6; color:#d93025; font-weight:bold; padding:4px 10px; border-radius:20px;"">' + formatted + '</span>';
		}
		return '';
		}
		").HeaderCellTemplate(@<text>
						   		<div class="CalcTaxAmt-header" style="font-weight: bold;">
						   			<%= column.caption %>
						   		</div>
						   	</text>);


				amount.AddFor(m => m.TotalPurchaseAmount)
			.Caption(new JS("formatMessage('Bill Amount')"))
			.Alignment(HorizontalAlignment.Center)
			.EncodeHtml(false) // Enables HTML formatting
			.CustomizeText(@"
		function(e) {
		if (e.value != null) {
		const formatted = e.value.toLocaleString(undefined, {
