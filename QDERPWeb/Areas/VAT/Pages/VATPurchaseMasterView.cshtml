			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				domestic.AddFor(m => m.DomesticZeroTaxPurchases).Caption(new JS("formatMessage('Domestic Zero Rated Purchases')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				domestic.AddFor(m => m.DomesticExemptedTaxPurchases).Caption(new JS("formatMessage('Domestic Exempted Purchases')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
			});

				// Imports
				pclass.Add().Caption(new JS("formatMessage('Imports')")).Columns(imports =>
			{
				imports.AddFor(m => m.ImportsVatpaidAtCustoms).Caption(new JS("formatMessage('Imports Purchases thru Customs 5%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				imports.AddFor(m => m.TotalImportPurchase10Perc).Caption("").Caption(new JS("formatMessage('Imports Purchases thru Customs 10%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				imports.AddFor(m => m.TotalImportPurchase15Perc).Caption(new JS("formatMessage('Imports Purchases thru Customs 15%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				imports.AddFor(m => m.ImportsVatthruRcm).Caption(new JS("formatMessage('Imports RCM 5%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				imports.AddFor(m => m.TotalRcmpurchase10Perc).Caption(new JS("formatMessage('Imports RCM 10%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				imports.AddFor(m => m.TotalRcmpurchase15Perc).Caption(new JS("formatMessage('Imports RCM 15%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
			});
			});

			// 🔹 VAT AMOUNT CLASSIFIED - Domestic VAT & Imports VAT
			columns.Add().Caption(new JS("formatMessage('VAT Amount Classified')")).Columns(vat =>
			{
				// Domestic VAT
				vat.Add().Caption(new JS("formatMessage('Domestic VAT')")).Columns(domesticVAT =>
			{
				domesticVAT.AddFor(m => m.DomesticStandardPurTax).Caption(new JS("formatMessage('Domestic Purchases VAT @5%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				domesticVAT.AddFor(m => m.TotalDspurchaseTax10Perc).Caption(new JS("formatMessage('Domestic Purchases VAT @10%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				domesticVAT.AddFor(m => m.TotalDspurchaseTax15Perc).Caption(new JS("formatMessage('Domestic Purchases VAT @15%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				domesticVAT.AddFor(m => m.DomesticZeroTaxPurTax).Caption(new JS("formatMessage('Domestic Zero Rated VAT')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				domesticVAT.AddFor(m => m.DomesticExemptedTaxPurTax).Caption(new JS("formatMessage('Domestic Exempted VAT')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
			});

				// Imports VAT
				vat.Add().Caption(new JS("formatMessage('Imports VAT')")).Columns(importsVAT =>
			{
				importsVAT.AddFor(m => m.ImportsVatpaidAtCustomsTax).Caption(new JS("formatMessage('VAT Paid in Customs 5%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				importsVAT.AddFor(m => m.TotalImportPurchaseTax10Perc).Caption(new JS("formatMessage('VAT Paid in Customs 10%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				importsVAT.AddFor(m => m.TotalImportPurchaseTax15Perc).Caption(new JS("formatMessage('VAT Paid in Customs 15%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				importsVAT.AddFor(m => m.ImportsVatthruRcmtax).Caption(new JS("formatMessage('VAT thru RCM 5%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				importsVAT.AddFor(m => m.TotalRcmpurchaseTax10Perc).Caption(new JS("formatMessage('VAT thru RCM 10%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
				importsVAT.AddFor(m => m.TotalRcmpurchaseTax15Perc).Caption(new JS("formatMessage('VAT thru RCM 15%')"))
			.CustomizeText("function(e) { return e.value != null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
			});
			});
		})
