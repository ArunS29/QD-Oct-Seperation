			"Invoice is already Debit Note Issued."
		);
	}
		else if (response.IsPosted === true) {
		DevExpress.ui.dialog.custom({
			title: "Cancel/Amend Confirmation",
			message: "You are about to Cancel/Amend this VAT Invoice.<br>This will create a new DEBIT NOTE for Invoice Amendment.<br>Click Yes if you would like to continue.",
				buttons: [
				{ text: "Yes", onClick: () => true },
				{ text: "No", onClick: () => false }
			],
			showTitle: true
		}).show().done(function (dialogResult) {
			if (dialogResult) {
				DevExpress.ui.dialog.alert(
					"Debit Note has been added to the database.",
					"Data Insertion Successful"
				).done(function () {
					window.location.href = `/${tenantName}/VAT/DebitNoteEditForm?InvoiceNo=${encodeURIComponent(invoiceNo)}&IsAmend=${encodeURIComponent(IsAmend)}&DebitNoteNo=${encodeURIComponent(DebitNoteNo)}`;
				});
			}
		});
	}
				console.log("Clone success:", response);
				// You can redirect to the Credit Note Edit page now

			},
			error: function (xhr) {
				let message = xhr.responseJSON?.message || "Unknown error";
				console.error("Clone error:", message);
				alert("Error: " + message);
			}
		});
	}

