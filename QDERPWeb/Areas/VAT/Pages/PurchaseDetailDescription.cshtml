@page
@model QD.ERP.Web.Areas.VAT.Pages.PurchaseDetailDescriptionModel
@{
}
<style>
    .form-wrapper {
        margin: 10px;
        padding: 20px;
        border-radius: 6px;
        width: 97%;
        height: 85%;
    }

    .form-group {
        position: relative;
        padding: 10px;
    }

        .form-group label {
            display: block;
            margin-bottom: 15px;
        }

    .form-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .element.style {
        height: 110px !important;
    }
    /*
        .dx-textarea-input,
        .dx-dropdowneditor-input,
        .dx-datebox-input {
            color: black !important;
            height: 45px !important;
        }

        .dx-textarea, .dx-texteditor-input {
            resize: none;
            font-family: inherit;
            display: block;
            overflow: auto;
            white-space: pre-wrap;
            margin: 0;
            height: 100px !important;
        } */
    .arabic-button {
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .top-buttons {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        gap: 8px;
    }

        .top-buttons .dx-button {
            height: 30px;
            color: black;
        }

    .arabic-textbox-wrapper {
        position: relative;
        width: 100%;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 3em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }

    table tr {
        gap: 10px;
    }

    .dx-checkbox {
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .dx-selectbox {
        margin-bottom: 10px;
    }
</style>


<div class="title">
    <div class="header-container">
        <div id="DetailsDescription2" class="no-border-title"></div>
    </div>
</div>
<div class="form-wrapper">

    <!-- Row 1: Detailed Description + 2 Buttons -->
    <div class="form-group">
        <div class="top-buttons">
            @(Html.DevExtreme().Button()
                        .ID("btnUseDetailedDesc")
                        .Text("Use Detailed Description")
                        .Type(ButtonType.Default)
                        )
            @(Html.DevExtreme().Button()
                        .ID("btnUseItemDesc")
                        .Text("Use Item Description")
                        .Type(ButtonType.Default)
                        )
        </div>
    </div>

    <!-- Row 2: Arabic Description + Convert Button -->
    <table style="width: 100%; border-spacing: 10px; border-collapse: separate;">
        <tr>
            <td colspan="4">
                @(Html.DevExtreme().TextBox()
                                .Label(new JS("formatMessage('Detailed Description / Specification:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("DetailedDescription")
                @*     .Height("100% !important") *@
                                .Width("100%")
                                )
            </td>
        </tr>
       
        <tr>
            <td>
                @(Html.DevExtreme().SelectBox()
                                .ID("CostAllocationEmployees")
                                .Placeholder("Select Employees")
                                .Label("Cost Allocation for Employees:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
            <td>
                @(Html.DevExtreme().SelectBox()
                                .ID("CostAllocationProperty")
                                .Placeholder("Select Property/Equipments")
                                .Label("Cost Allocation for Property/Equipments:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
           
        </tr>

        <tr>


            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("DiscountText")
                                .Label("Discount Text:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
           
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("Remarks")
                                .Label("Remarks:")
                                .LabelMode(EditorLabelMode.Floating)
                                )
            </td>
        </tr>
        
            <!-- Goods in Transit Checkbox -->
        <tr>
            <td colspan="3">
                @(Html.DevExtreme().CheckBox()
                                .ID("IsGoodsInTransit")
                                .Text("Choose this Item as Goods in Transit - Cost (Additional Cost on Inventory)")
                                .ElementAttr("style", "margin-top:10px; margin-bottom:10px; font-weight:normal;")
                                .Width("100%")
                                )
            </td>
        </tr>

        <!-- Goods in Transit Account & Purchase Voucher No -->
        <tr>
            <td>
                @(Html.DevExtreme().SelectBox()
                                .ID("GoodsInTransitAccount")
                                .Placeholder("Select Account")
                                .Label("Select Goods in Transit Account:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
            <td>
                @(Html.DevExtreme().SelectBox()
                                .ID("PurchaseVoucherNo")
                                .Placeholder("Select Voucher")
                                .Label("Purchase Voucher No:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
        </tr>

        


    </table>

</div>

<script>
    function convertToArabic(sourceId, targetId) {
        const sourceValue = $("#" + sourceId).dxTextBox("instance")?.option("value") || $("#" + sourceId).dxTextArea("instance")?.option("value");
        const arabicText = sourceValue + " (Arabic)";
        const targetInstance = $("#" + targetId).dxTextBox("instance") || $("#" + targetId).dxTextArea("instance");
        if (targetInstance) {
            targetInstance.option("value", arabicText);
        }
    }
    $(function () {
            $("#DetailsDescription2").dxTextBox({
                text: formatMessage("Details Description"),
                readOnly: true,
                            onContentReady: function(e) {
                            $(e.element).addClass("dx-textbox-heading");
                    }

            });
    });

    
    $(function () {
        // Sample data for dropdowns
        $("#GoodsInTransitAccount").dxSelectBox("instance").option("items", [
            "GIT Account 001", "GIT Account 002", "GIT Account 003"
        ]);

        $("#PurchaseVoucherNo").dxSelectBox("instance").option("items", [
            "Voucher-1001", "Voucher-1002", "Voucher-1003"
        ]);
    });


</script>