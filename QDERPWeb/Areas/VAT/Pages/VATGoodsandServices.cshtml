        function onSaveClicked() {
        const gsCodeInput = $("#txtGoodsCode7").dxTextBox("instance").option("value");
        const description = $("#txtDescription8").dxTextArea("instance").option("value");

        const goodsCodeValidator = $("#txtGoodsCode7").dxValidator("instance");
        const descriptionValidator = $("#txtDescription8").dxValidator("instance");

        const goodsCodeValid = goodsCodeValidator?.validate().isValid;
        const descriptionValid = descriptionValidator?.validate().isValid;

        if (!goodsCodeValid || !descriptionValid) {
            DevExpress.ui.notify("Please fill in the required fields.", "warning", 3000);
            return;
        }

        const formData = {
            GSCode: gsCodeInput,
            GSGroupID: parseInt($("#ddlGoodsGroup1").dxDropDownBox("instance").option("value")) || 0,
            ItemPartNo: $("#txtItemPartNo4").dxTextBox("instance").option("value"),
            GSDescrpition: description,
            GSDescriptionAr: $("#txtDescriptionArabic").dxTextArea("instance").option("value"),
            GSUoM: parseInt($("#ddlUnitMeasure9").dxDropDownBox("instance").option("value")) || 0,
            GSPackingUnit: parseInt($("#packingUnit").dxNumberBox("instance").option("value")) || 0,
            GSSellingRate: parseFloat($("#sellingRate").dxNumberBox("instance").option("value")) || 0,
            CostPrice: parseFloat($("#txtCostPrice3").dxNumberBox("instance").option("value")) || 0,
            GSDetailedDesc: $("#txtDetailedDescription").dxTextArea("instance").option("value"),
            GSDetailedDescAr: $("#txtDetailedDescriptionArabic").dxTextArea("instance").option("value")
        };

        $.ajax({

            type: "POST",
            url: `/api/VATModule/SaveGoodsAndServices`,
           // data: JSON.stringify(formData,InvoiceChildSLNo),
              data: JSON.stringify({
            ...formData,
            InvoiceChildSLNo: InvoiceChildSLNo
        }),
            contentType: "application/json",
            success: function (response) {
                DevExpress.ui.notify(response.message || "Saved successfully.", "success", 2000);
                getUpdatedData();
                // Set GSCode if it was generated by backend and not manually entered
                if (!gsCodeInput?.trim() && response.gscode) {
                    $("#txtGoodsCode7").dxTextBox("instance").option("value", response.gscode);
                }
            },
            error: function (xhr) {
                const errMsg = xhr.responseJSON?.message || "Save failed.";
                DevExpress.ui.notify(errMsg, "error", 2000);
            }
        });
    }

        function getUpdatedData() {

         let GsCode =  $("#txtGoodsCode7").dxTextBox("instance").option("value");
         let GsDescription =  $("#txtDescription8").dxTextArea("instance").option("value");

         
        // Get Goods & Services Group DropDownBox instance
        var ddlGoodsGroup = $("#ddlGoodsGroup1").dxDropDownBox("instance");
        var goodsGroupId = ddlGoodsGroup.option("value");   // ValueExpr -> GsgroupId
        var goodsGroupText = ddlGoodsGroup.option("text");  // DisplayExpr -> GsgroupName

        // Get Unit of Measure DropDownBox instance
        var ddlUnitMeasure = $("#ddlUnitMeasure9").dxDropDownBox("instance");
        var unitCode = ddlUnitMeasure.option("value");   // ValueExpr -> UnitCode
        var unitType = ddlUnitMeasure.option("text");    // DisplayExpr -> UnitType

        // Build return object
        var updatedData = {
            GsCode: GsCode,
            GoodsDesc: GsDescription,
            UnitCode: unitCode,
            UnitType: unitType
        };

        return updatedData;
    }


        function returnUpdatedValues(updatedData) {
        window.opener.postMessage({
            type: "UpdateGoodsServices",
            payload: updatedData
        }, "*");
