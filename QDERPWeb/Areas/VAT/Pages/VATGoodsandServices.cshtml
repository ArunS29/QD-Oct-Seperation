    async function convertDescriptionToArabic() {
        const englishBox = $("#txtDescription8").dxTextArea("instance");
        const arabicBox = $("#txtDescriptionArabic").dxTextBox("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    async function convertDetailedDescToArabic() {
        const englishBox = $("#txtDetailedDescription").dxTextArea("instance");
        const arabicBox = $("#txtDetailedDescriptionArabic").dxTextBox("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a detailed description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

 
    async function translateToArabic(text) {
        try {
            const response = await fetch(
                `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|ar`
            );

            if (!response.ok) {
                throw new Error("Translation API request failed.");
            }

            const data = await response.json();
            console.log("Translation result:", data);

            return data?.responseData?.translatedText || "Translation not found";

        } catch (error) {
            console.error("Translation failed:", error);
            throw error; 
        }
    }



    function onGoodsGroupChanged(e) {
        const selectedValue = e.value; 
        const dropDownBoxInstance = e.component;

       
        const dataSource = dropDownBoxInstance.getDataSource();

        dataSource.load().done(function (items) {
            const selectedItem = items.find(item => item.GsgroupId === selectedValue);

            if (selectedItem && selectedItem.GsgroupCode) {
                $("#txtGoodsCode7").dxTextBox("instance").option("value", selectedItem.GsgroupCode);
            } else {
                $("#txtGoodsCode7").dxTextBox("instance").option("value", "");
            }
        });
    }
