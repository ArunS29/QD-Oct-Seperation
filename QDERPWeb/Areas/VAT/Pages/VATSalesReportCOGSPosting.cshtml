        .Alignment(HorizontalAlignment.Center);

    columns.Add().DataField("ClientNameOrCashClient")
        .Caption(new JS("formatMessage('Client Name')"))
        .Alignment(HorizontalAlignment.Center);

    columns.Add().DataField("StatusForPosting")
        .Caption(new JS("formatMessage('Status For Posting')"))
        .Alignment(HorizontalAlignment.Center);

    columns.Add().DataField("IsPosted")
        .Caption(new JS("formatMessage('Is Posted')"))
        .Alignment(HorizontalAlignment.Center);

    columns.Add().DataField("IsCogsPosted")
        .Caption(new JS("formatMessage('Is Cogs Posted')"))
        .Alignment(HorizontalAlignment.Center);

   
  
})

)
