<div id="pagination" style="display:flex; justify-content:flex-end; gap:10px; margin-right: 20px;">
	<select id="pageSizeSelect" onchange="changePageSize(this.value)">
		<option value="10">10</option>
		<option value="20">20</option>
		<option value="50">50</option>
		<option value="100">100</option>
		<option value="150">150</option>
	</select>
	<span id="pageInfo"></span>
	<button disabled id="previousPage" onclick="ddBtnShowRecords_click(null, currentPage - 1)">&#x3C;</button>
	<button id="nextPage" onclick="ddBtnShowRecords_click(null, currentPage + 1)">&#x3E;</button>

</div>

    <script>
			$("#btnBack").on("click", function (e) {
				history.back(); // Closes or navigates back
			});
        function showRecords() {
            // Call to backend to reload data based on fromDate and toDate
            DevExpress.ui.notify("Showing records...", "info", 1500);
        }

        function postAverageCost() {
            DevExpress.ui.notify("Posting average cost...", "success", 2000);
        }

        function postCogsToLedger() {
            DevExpress.ui.notify("Posting COGS to ledger...", "success", 2000);
        }



	let currentPage = 1;
	let pageSize = 10;

	function changePageSize(size) {
		pageSize = parseInt(size);
		ddBtnShowRecords_click(null, currentPage);
	}

		function ddBtnShowRecords_click(duration, page) {
			debugger;
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var currentDate = new Date();
		var frmDate, toDate;

		switch (duration) {
			case 'q1':
			frmDate = new Date(currentDate.getFullYear(), 0, 1);   // Jan 1
			toDate  = new Date(currentDate.getFullYear(), 2, 31);  // Mar 31
			break;
			case 'q2':
				frmDate = new Date(currentDate.getFullYear(), 3, 1);   // Apr 1
				toDate  = new Date(currentDate.getFullYear(), 5, 30);  // Jun 30
				break;
			case 'q3':
				frmDate = new Date(currentDate.getFullYear(), 6, 1);   // Jul 1
				toDate  = new Date(currentDate.getFullYear(), 8, 30);  // Sep 30
				break;
			case 'q4':
				frmDate = new Date(currentDate.getFullYear(), 9, 1);   // Oct 1
				toDate  = new Date(currentDate.getFullYear(), 11, 31); // Dec 31
				break;
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
			default:
				const frmValue = frmDateBox.option("value");
				const toValue = toDateBox.option("value");

				if (!frmValue || !toValue) {
					DevExpress.ui.notify("Please select both Start Date and End Date.", "warning", 2000);
					return;
				}
				frmDate = new Date(frmValue);
				toDate = new Date(toValue);
		}

		const formattedFromDate = frmDate.toLocaleDateString('en-CA');
		const formattedToDate = toDate.toLocaleDateString('en-CA');

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		if (page < 1) return;

		$.ajax({
			url: '/api/VATModule/GetCosgsPostingInvoiceList',
			type: 'GET',
			data: {
				frmDate: formattedFromDate,
				toDate: formattedToDate,
				pageNumber: page,
				pageSize: pageSize
			},
			success: function (data) {
				if (data.length === 0 && page > 1) return;

				currentPage = Number(data.currentPage);
				var grid = $("#dataGrid").dxDataGrid("instance");
				grid.option("dataSource",data);

				//updateInvoiceAmountCard(data.data);
				console.log("COGSPosting",data);

				

				const totalPages = Math.ceil(Number(data.totalCount) / Number(data.pageSize));
				$("#pageInfo").text(`Page ${data.currentPage} of ${totalPages} (${data.totalCount} items)`);
				$("#nextPage").prop("disabled", totalPages === data.currentPage);
				$("#previousPage").prop("disabled", data.currentPage === 1);

				const animatedCount = data.length;
			//	animateInvoiceCardCount(animatedCount);

				

				//animateVoucherCount("fiveYearCount", fiveYearCount);
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}
          
    </script>

   

