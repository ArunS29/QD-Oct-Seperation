							const { InvoiceChildSlNo, InvoiceNo } = rowData;

							if (!InvoiceChildSlNo) {
								grid.deleteRow(rowIndex); // Deletes from UI
							} else {
								DevExpress.ui.dialog.confirm(
									"You are about to delete invoice line item.\nAre you sure you want to delete this invoice detail?",
									"Delete Invoice"
								).done(function (confirmResult) {
									if (confirmResult) {
										$.ajax({
											url: "/api/VATModule/DeleteInvoiceChild",
											type: "POST",
											contentType: "application/json",
											data: JSON.stringify(InvoiceChildSlNo),
											success: function (response) {
												if (response.success) {
													grid.refresh();
													DevExpress.ui.dialog.alert("VAT Invoice Line Item Deleted Successfully.", "Data Delete Successful");

													// Fetch updated data and re-bind the grid
													$.ajax({
														type: "GET",
														url: `/api/VATModule/GetGridInvoiceDetails?InvoiceNo=${encodeURIComponent(InvoiceNo)}`,
														dataType: 'json',
														success: function (data) {
														
															const newRowData = data.map((item, index) => ({
																SNo: index + 1,
																...item
															}));
															initializeDataGrid(newRowData);
														},
														error: function () {
															DevExpress.ui.notify("Failed to refresh grid data.", "error", 2000);
														}
													});
												} else {
													DevExpress.ui.notify(response.message || "Deletion failed.", "error", 2000);
												}
											},
											error: function (xhr) {
												DevExpress.ui.notify("Server error: " + xhr.statusText, "error", 2000);
											}
										});
									}
								});
							}
						}
					} else {
						DevExpress.ui.notify("No row selected to delete.", "error", 2000);
					}
				}
				else if (action === "deleteAll") {
					if (selectedRowKey !== null) {
						const rowIndex = grid.getRowIndexByKey(selectedRowKey);
						if (rowIndex >= 0) {
							const rowData = grid.getDataSource().items()[rowIndex];
							const { InvoiceNo } = rowData;

							if (!InvoiceNo) {
								const dataSource = grid.option("dataSource");
								dataSource.length = 0;
								grid.option("dataSource", dataSource);
								grid.refresh();
							} else {
								DevExpress.ui.dialog.confirm(
									"You are about to delete all the invoice line items.\nAre you sure you want to delete this invoice detail?",
									"Delete Invoice"
								).done(function (confirmResult) {
									if (confirmResult) {
										$.ajax({
											url: "/api/VATModule/DeleteInvoiceAllLineItem",
											type: "POST",
											contentType: "application/json",
											data: JSON.stringify(InvoiceNo),
											success: function (response) {
												if (response.success) {
													grid.refresh();
													DevExpress.ui.dialog.alert("VAT Invoice Line Items Deleted Successfully.", "Data Delete Successful");

													$.ajax({
														type: "GET",
														url: `/api/VATModule/GetGridInvoiceDetails?InvoiceNo=${encodeURIComponent(InvoiceNo)}`,
														dataType: 'json',
														success: function (data) {
															const newRowData = data.map((item, index) => ({
																SNo: index + 1,
																...item
															}));
															initializeDataGrid(newRowData);
														},
														error: function () {
															DevExpress.ui.notify("Failed to refresh grid data.", "error", 2000);
														}
													});
												} else {
													DevExpress.ui.notify(response.message || "Deletion failed.", "error", 2000);
												}
											},
											error: function (xhr) {
												DevExpress.ui.notify("Server error: " + xhr.statusText, "error", 2000);
											}
										});
									}
								});
							}
						}
					} else {
						DevExpress.ui.notify("No row selected to delete.", "error", 2000);
					}
				}

				$("#contextMenu").hide();
			});
		});


