<!-- Modal Structure -->

<script>


		  function onClientCodeRowPrepared(e) {
			if (e.rowType === "data" && e.data.IsLedgerObselete === true) {
				e.rowElement.css("background-color", "#ffcccc"); // light red
			}
		}


		function navigateToLedgerAccountForm() {
		// make sure this is available in the view
			const url = `/${tenantName}/VAT/VATDatabaseSignatories`;
			const title = "";
			openModal(url, title); // opens in modal instead of new window
		}

			  let ItemNo=null, paymentmeanstypecode=null,amt=0, accheadid =null,revaccheadid=null,InvoiceCurrencyExchangeId=null,TaxCurrencyExchangeId=null,branchcode=null,salespersoncode=null,companyid=null,SellerOtherIdtype=null,
			  SignatoryID=null,ChkbySignatoryID=null,ApproedbySignatoryID=null,IsCurrent="false",IsDirectApproval=true,IsDirectVerify=true;

	//View e-Invoice

			$(document).ready(function () {
			var urlParams = new URLSearchParams(window.location.search);
					var InvoiceNo = urlParams.get('InvoiceNo');
			var IsEditflag = urlParams.get('IsEditflag');

				IsCurrent=IsEditflag.toString();

				// console.log("Iseditflag",IsEditflag)
				if (IsCurrent === "true") {
				$.ajax({
					url: `/api/VATModule/GetPurchaseMasterInvoiceDetails?InvoiceNo=${encodeURIComponent(InvoiceNo)}`,
					type: 'GET',
					dataType: 'json',
					success: function (response) {
						console.log("InvoiceDetails", response);

						if (response && response.length > 0) {
							var account = response[0];
	$("#InvoiceNo").dxTextBox("instance").option("value", account.PurchaseVoucherNo) || null,
	$("#InvoiceDate").dxDateBox("instance").option("value", account.PurchaseVoucherDate) || null,
	$("#SupplierInvoiceNo").dxDropDownBox("instance").option("value", account.PurchaseBillNo) || null,
	$("#SupplyDate").dxDateBox("instance").option("value", account.PurchaseEffectiveDate) || null,
	$("#VATInvoiceType").dxTextBox("instance").option("value", account.PurchaseTaxCategoryCode) || null,
	$("#OrderDate").dxDateBox("instance").option("value", account.PurchaseOrderDate) || null,
	$("#MaterialReceipt").dxTextBox("instance").option("value", account.MaterialReceiptNo) || null,
	$("#SupplyDates").dxDateBox("instance").option("value", account.PurchaseDeliveryDate) || null,

	// Second Card (Right side)
	ClientCodedataGridSelectionChanged({ selectedRowKeys: [account.SupplierCode] }),
	$("#ddclientname").dxDropDownBox("instance").option("value", account.SupplierName) || null,
	$("#GroupVATNo").dxTextBox("instance").option("value", account.SupplierGroupVatnumber) || null,
	$("#ClientVATNo").dxTextBox("instance").option("value", account.SupplierVatnumber) || null,
	$("#ClientNameArabic").dxTextBox("instance").option("value", account.SupplierNameAr) || null,
	$("#OtherIDType").dxDropDownBox("instance").option("value", account.SupplierOtherIdtype) || null,
	$("#ClientOtherID").dxTextBox("instance").option("value", account.SupplierOtherId) || null,
	// $("#ClientAddressDetails").dxDropDownBox("instance").option("value") || null,
	// PurchasePeriod: $("#InvoiceCounterValue").dxTextBox("instance").option("value") || null,
	$("#UUID").dxTextBox("instance").option("value", account.ReferenceNo) || null,
	$("#InvoiceDueDate").dxDateBox("instance").option("value", account.PurchaseDueDate) || null,
	$("#EffectiveDate").dxDateBox("instance").option("value", account.PurchaseEffectiveDate) || null,
	// $("#InventoryEffectiveDate").dxDateBox("instance").option("value") || null,
	$("#SubmittedBytext").dxTextBox("instance").option("value", account.SupplierInvRecdBy) || null,

	dataGridRevenueAccountSelectionChanged({ selectedRowKeys: [account.PurchaseLedgerAccountNo] }),
	// dataGridRevenueAccountSelectionChanged({ selectedRowKeys: [account.ClientCode] }),
	$("#ddlGoodsGroup1").dxDropDownBox("instance").option("value", account.CostCenterCode) || null,
	$("#txtInvoiceNotes").dxTextArea("instance").option("value", account.RemarksInEn) || null,
	$("#txtNotesinArabic").dxTextArea("instance").option("value", account.RemarksInAr) || null,
	$("#LessAdvance").dxTextBox("instance").option("value", account.AdvanceText) || null,
	$("#currencyexchangerate3").dxNumberBox("instance").option("value", account.AdvanceAmount) || null,
	$("#LessOtherDeductions").dxTextBox("instance").option("value", account.RetentionText) || null,
	$("#currencyexchangerate4").dxNumberBox("instance").option("value", account.RetentionAmount) || null,
	$("#CompanyDivision").dxDropDownBox("instance").option("value", account.CompanyId) || null,
	// $("#ddlDivision").dxTextBox("instance").option("value") || null,
	// $("#ddlinvoicesubmittedon").dxTextBox("instance").option("value") || null,
	$("#ddlSupplierArabicName").dxDropDownBox("instance").option("value", account.SupplierNameAr) || null;


											if(account.IsApproved==true)
											{
												disableEditing();
											}

								// Now call the second AJAX to get grid details
							$.ajax({
								type: "GET",
								url: `/api/VATModule/GetPurchaseChildInvoiceDetails?InvoiceNo=${encodeURIComponent(InvoiceNo)}`,
									dataType: 'json',
								success: function (response) {
										console.log("Grid",response)
									// if (!response || !response.data || response.data.length === 0) {
									// 	console.warn("No voucher entries found.");
									// 	return;
									// }

										let rowData = response.map((item, index) => ({
			SNo: index + 1,
			...item
		}));
									// let rowData = response;

									// ✅ Now safely initialize the grid here
									initializeDataGrid(rowData);
								},
								error: function (xhr, status, error) {
									console.error("Error fetching grid data:", error);
								}
							});
						} else {
							console.warn("No account details found in the response.");
						}
					},
					error: function (xhr, status, error) {
						console.error("Error fetching invoice details:", error);
					}
				});
			}


		});



			function initializeDataGrid(rowData) {
		let grid = $("#B2BdataGrid").dxDataGrid({
			dataSource: rowData,
			keyExpr: "SNo",
			columns: [
						{ dataField: "InvoiceChildSlNo", caption: "InvoiceChildSLNo", width: 100, allowEditing: false, visible: false },
				{ dataField: "SNo", caption: "#", width: 100, allowEditing: false },
				{ dataField: "ItemCode", caption: formatMessage('Item Code'), width: 200 },
				{
					dataField: "DetailedDescription",
					caption: formatMessage('Description'),
					width: 550,
					sortOrder: "asc",
					editCellTemplate: function (cellElement, cellInfo) {
						getDropdownData().done(function (dropdownData) {
							let $container = $("<div>").css({ display: "flex", alignItems: "center", gap: "5px", width: "100%" }).appendTo(cellElement);

							$("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({
								dataSource: dropdownData,
								valueExpr: "GSCode",
								displayExpr: "GSDescrpition",
								value: cellInfo.value,
								dropDownOptions: { width: 800 },
								onValueChanged: function (e) {
									let selectedItem = dropdownData.find(item => item.GSCode === e.value);
									if (selectedItem) {
										cellInfo.setValue(selectedItem.GSDescrpition);
										let dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
										let rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);
										if (rowIndex !== -1) {
											dataGrid.cellValue(rowIndex, "Item Code", selectedItem.GSCode || "");
											dataGrid.cellValue(rowIndex, "Cost Price", selectedItem.CostPrice || 0);
											dataGrid.cellValue(rowIndex, "GSSellingRate", selectedItem.GSSellingRate || 0);
										}
									}
								},
								contentTemplate: function (e) {
									return $("<div>").dxDataGrid({
										dataSource: dropdownData,
										selection: { mode: "single" },
										keyExpr: "GSCode",
										height: 300,
										scrolling: { mode: "virtual" },
										columns: [
											{ dataField: "GSCode", caption: "Code", width: 80 },
											{ dataField: "GSDescrpition", caption: "Description", width: 200 },
											{ dataField: "GsdescriptionAr", caption: "Description In Arabic", width: 200 },
											{ dataField: "ItemPartNo", caption: "Item Part No", width: 100 },
											{ dataField: "CostPrice", caption: "Cost Price", width: 100 },
											{ dataField: "GSSellingRate", caption: "Selling Rate", width: 100 },
											{ dataField: "ReorderQty", caption: "Current Qty", width: 100 }
										],
										onSelectionChanged: function (selectedItems) {
											let selectedItem = selectedItems.selectedRowsData[0];
											if (selectedItem) {
												e.component.option("value", selectedItem.GSCode);
												cellInfo.setValue(selectedItem.GSDescrpition);
												let dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
												let rowIndex = dataGrid.getRowIndexByKey(cellInfo.key);
												if (rowIndex !== -1) {
													dataGrid.cellValue(rowIndex, "Item Code", selectedItem.GSCode || "");
													dataGrid.cellValue(rowIndex, "Cost Price", selectedItem.CostPrice || 0);
													dataGrid.cellValue(rowIndex, "GSSellingRate", selectedItem.GSSellingRate || 0);
													dataGrid.cellValue(rowIndex, "Qty", 1);
													dataGrid.cellValue(rowIndex, "VAT%", "15%");
												}
												e.component.close();
											}
										}
									});
								}
							});

							$("<div>").dxButton({
								icon: "plus",
								hint: "Add new item",
								onClick: function () {
									let url = `/${tenantName}/VAT/VATGoodsandServices`;
									let title = "Goods and Services";
									openModal(url, title);
								},
								width: 60,
								height: 30
							}).appendTo($container);

							$("<div>").dxButton({
								icon: "edit",
								hint: "Edit item",
								onClick: function () {
									let url = `/${tenantName}/VAT/VATGoodsandServices`;
									let title = "Goods and Services";
									openModal(url, title);
								},
								width: 60,
								height: 30
							}).appendTo($container);
						});
					}
				},
				{
					dataField: "Descriptions",
					caption: "...",
					width: 50,
					allowEditing: true,
					editCellTemplate: function (cellElement, cellInfo) {
						let url = `/${tenantName}/VAT/CreditDetailDescription`;
						let title = "VAT Details Description";
						window.currentDescriptionCell = cellInfo;
						openModal(url, title);
					}
				},
				{
					dataField: "UnitRateMethod",
					caption: formatMessage('Unit Rate Method'),
					width: 200,
					editCellTemplate: function (cellElement, cellInfo) {
						getUnitRateMethods().done(function (unitRates) {
							let $container = $("<div>").css({ display: "flex", alignItems: "center", gap: "5px", width: "100%" }).appendTo(cellElement);

							$("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({
								dataSource: unitRates,
								valueExpr: "UnitCode",
								displayExpr: "UnitDesc",
								value: cellInfo.value || null,
								placeholder: "Select Unit Rate Method",
								dropDownOptions: { width: 600 },
								contentTemplate: function (e) {
									return $("<div>").dxDataGrid({
										dataSource: unitRates,
										keyExpr: "UnitCode",
										selection: { mode: "single" },
										height: 300,
