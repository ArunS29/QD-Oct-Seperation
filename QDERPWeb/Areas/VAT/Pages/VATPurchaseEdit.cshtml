		$(document).ready(function () {
					console.log('Start permission handling');
					// Form ID
					var formId = "frm20164VATPurchaseEdit";

					// Call the API to get permissions
					$.ajax({
						url: '/api/Permissions/GetAccessDetails?formId=' + formId,
						type: 'GET',
						contentType: 'application/json',
						success: function (response) {
							console.log("API Response:", response); // Log the API response

							if (response.success && response.permissions) {
								// Default visibility and enable status for buttons
								var controlStates = {
									"ddButtonLayout": { "Visible": true, "Enabled": false },
									"btnMoveDown": { "Visible": true, "Enabled": false },
									"btnMoveUp": { "Visible": true, "Enabled": false },
									"btnSave": { "Visible": true, "Enabled": false },
									"btnSaveAndClose": { "Visible": true, "Enabled": false },
									"btnPrint2": { "Visible": true, "Enabled": false },
									"btnAddNew": { "Visible": true, "Enabled": false },
									"btnDelete": { "Visible": true, "Enabled": false },
									"btnVerify": { "Visible": true, "Enabled": false },
									"btnApprove": { "Visible": true, "Enabled": false },
									"btnAttach": { "Visible": true, "Enabled": false },
									"btnPostToLedgers": { "Visible": true, "Enabled": false },
									"btnPostTag": { "Visible": true, "Enabled": false }
								};

								// Check for full access
								var fullAccess = response.permissions.find(p =>
									p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
								);

								if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
									// Grant full access: make all controls visible and enabled
									Object.keys(controlStates).forEach(key => {
										controlStates[key] = { "Visible": true, "Enabled": true };
									});
								} else {
									// Update states based on specific permissions for each control
									Object.keys(controlStates).forEach(key => {
										var controlPermission = response.permissions.find(p =>
											p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
										);
										if (controlPermission) {
											controlStates[key] = {
												"Visible": controlPermission.ItemVisible || false,
												"Enabled": controlPermission.ItemEnabled || false
											};
										}
									});
								}

								console.log("Control States:", controlStates); // Log the control states

								// Dynamically update button visibility and enabled state
								Object.keys(controlStates).forEach(key => {
									var button = document.getElementById(key);
									if (button) {
										// Handle visibility
										button.style.display = controlStates[key].Visible ? "inline-block" : "none";
										// Handle enable/disable state
										button.disabled = !controlStates[key].Enabled;
										console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
									} else {
										console.warn(`Button with ID "${key}" not found in the DOM.`);
									}
								});
							} else {
								console.warn("Failed to fetch permissions or no permissions available.");
							}
						},
						error: function (xhr, status, error) {
							console.error("Error fetching permissions:", error);
							alert('An error occurred while fetching permissions. Please try again.');
						}
					});
					showColumnChooser();
					console.log('End permission handling');
				});

		 function onClientCodeChanged(accheadid) {
		$.ajax({
			url: '/api/AccountLedgerMaster/GetAccountDetails',
			type: 'GET',
			data: { accountID: accheadid },
			success: function (result) {
			
				// 1. Pick the first record regardless of the shape returned
				const details = Array.isArray(result)
					? result[0]
					: (result.accountDetails || [])[0];

				if (!details) {
					DevExpress.ui.notify("No account details returned", "warning", 3000);
					return;
				}

				// 2. Get your base Invoice Date (today fallback)
				const invoiceDateBox = $("#InvoiceDate").dxDateBox("instance");
				const baseDate = invoiceDateBox?.option("value")
					? new Date(invoiceDateBox.option("value"))
					: new Date();

				// 3. Default credit days from master
				let creditDays = Number(details.NoOfDaysCreditPeriod) || 0;
				let NoOfDays = creditDays;
				// 4. If the checkbox “Submitted By” is ticked, recompute creditDays
				const isSubmitted = $('#SubmittedBy').dxCheckBox("instance")?.option("value");
				if (isSubmitted) {
					const invoiceSubmittedDate = $("#ddlinvoicesubmittedon")
						.dxDateBox("instance")
						.option("value");

					if (invoiceSubmittedDate) {
						const diffMs = new Date(invoiceSubmittedDate) - baseDate;
						SubcreditDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
						NoOfDays = creditDays+SubcreditDays;
					}
				}

				// 5. Calculate the due date and push it into the UI
				const dueDate = new Date(baseDate);
					dueDate.setDate(dueDate.getDate() + NoOfDays);
				$("#InvoiceDueDate").dxDateBox("instance").option("value", dueDate);
			},
			error: function () {
				DevExpress.ui.notify("Failed to fetch data for client", "error", 2000);
			}
		});
	}


		function onSubmittedDateValueChanged() {
		$.ajax({
			url: '/api/AccountLedgerMaster/GetAccountDetails',
			type: 'GET',
			data: { accountID: accheadid },
			success: function (result) {
		

				// Handle API response structure properly
				const details = Array.isArray(result)
					? result[0]
					: (result?.accountDetails || [])[0];

				if (!details) {
					DevExpress.ui.notify("No account details returned", "warning", 3000);
					return;
				}

				// Get base invoice date (fall back to today)
				const invoiceDateBox = $("#InvoiceDate").dxDateBox("instance");
				const baseDate = invoiceDateBox?.option("value")
					? new Date(invoiceDateBox.option("value"))
					: new Date();

				// Default credit days from master
				const creditDays = Number(details.NoOfDaysCreditPeriod) || 0;
				let NoOfDays = creditDays;

				// Check "Submitted By" checkbox
				const isSubmitted = $('#SubmittedBy').dxCheckBox("instance")?.option("value");
				if (isSubmitted) {
					const submittedDate = $("#ddlinvoicesubmittedon").dxDateBox("instance")?.option("value");

					if (submittedDate) {
						const diffMs = new Date(submittedDate) - baseDate;
						const SubcreditDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
						NoOfDays += SubcreditDays;
					}
				}

				// Compute and set the due date
				const dueDate = new Date(baseDate);
				dueDate.setDate(dueDate.getDate() + NoOfDays);

				const dueDateBox = $("#InvoiceDueDate").dxDateBox("instance");
				if (dueDateBox) {
					dueDateBox.option("value", dueDate);
				}
			},
			error: function () {
				DevExpress.ui.notify("Failed to fetch data for client", "error", 2000);
			}
		});
	}


