			function onSupplierInvoiceValueChanged(e) {
		const newValue = e.value;
		const ddbInstance = e.component;

		if (!newValue) return;

		const dataSource = ddbInstance.getDataSource();
		const dataItems = dataSource.items();

		const exists = dataItems.some(item => {
			return item.PurchaseBillNo?.toString().toLowerCase() === newValue.toString().toLowerCase();
		});

		if (exists) {
			ddbInstance.option({
				value: null,
				validationError: {
					message: "Supplier Invoice is already available in the system, Please review again."
				},
				isValid: false
			});
		} else {
			ddbInstance.option({
				validationError: null,
				isValid: true
			});
		}
	}



