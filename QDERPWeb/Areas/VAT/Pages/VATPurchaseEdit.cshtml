		const dataItems = dataSource.items(); // Loaded data from the DropDownBox

		// Check for existing PurchaseBillNo match (case-insensitive)
		const exists = dataItems.some(item => {
			return item.PurchaseBillNo?.toString().toLowerCase() === selectedKey.toString().toLowerCase();
		});

		if (exists) {
			ddbInstance.option({
				value: null,
				validationError: {
					message: "Supplier Invoice is already available in the system, Please review again."
