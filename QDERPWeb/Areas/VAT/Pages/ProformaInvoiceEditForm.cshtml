				function onEditorPreparing(e) {
		if (e.parentType === "dataRow" &&
			(e.dataField === "QuantityInvoiced" ||
				 e.dataField === "UnitRate" ||
			// e.dataField === "VATPercentage" ||
			 e.dataField === "Discount")) {

			e.editorOptions.onValueChanged = function (args) {
				let grid = $("#B2BdataGrid").dxDataGrid("instance");
				let rowIndex = e.row.rowIndex;
						  rowIx=rowIndex;

				let newValue = args.value;

				// Get existing values or updated ones
					let qty = e.dataField === "QuantityInvoiced" ? newValue : grid.cellValue(rowIndex, "QuantityInvoiced") || 0;
					let unitPrice = e.dataField === "UnitRate" ? newValue : grid.cellValue(rowIndex, "UnitRate") || 0;
				let discount = e.dataField === "Discount" ? newValue : grid.cellValue(rowIndex, "Discount") || 0;

				// VAT rate handling
				let vatRateStr = e.dataField === "VATPercentage" ? newValue : grid.cellValue(rowIndex, "VAT Description") || "15%";
				let vatRate = parseFloat(vatRateStr.replace("%", "")) / 100;

				// Calculate amount
				let amount = qty * unitPrice;
				let discountedAmount = amount - discount;

				// Ensure discountedAmount doesn't go negative
				if (discountedAmount < 0) discountedAmount = 0;

				let vatValue = discountedAmount * vatRate;
				let totalValue = discountedAmount + vatValue;

				// Update grid cells
				grid.cellValue(rowIndex, "VAT", formatAmount(vatValue));
					   grid.cellValue(rowIndex, "Total", formatAmount(totalValue));
					   grid.cellValue(rowIndex, "Unit Price", formatAmount(unitPrice));
					 //  grid.cellValue(rowIndex, "Total Before Discount", formatAmount(TotalAmtBeforeDiscount));
					   grid.cellValue(rowIndex, "Amount", formatAmount(amount));
					   grid.cellValue(rowIndex, "Discount", formatAmount(discount));
					   grid.cellValue(rowIndex, "Qty", formatAmount(qty));
					   grid.cellValue(rowIndex, "VAT Description", vatRateStr);

				  // Store value for use in popover
				 window.currentAmount = amount.toFixed(2);
			};
		}
	}


