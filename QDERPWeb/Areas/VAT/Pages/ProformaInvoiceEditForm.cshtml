	$("#btnAddNew").on("click", function (e) {
		const grid = $("#B2BdataGrid").dxDataGrid("instance");
		const store = grid.getDataSource().store();
		const currentData = grid.getDataSource().items();

		const nextSNo = currentData.length > 0
			? Math.max(...currentData.map(row => row.SNo || 0)) + 1
			: 1;

		// Helper to format number with decimals
		const formatAmount = (val) => Number(val).toFixed(currencyDecimals);

		const newRow = {
			SNo: nextSNo,
			ItemCode: "",
			DetailedDescription: "",
			DescriptionDetails: "",
			QuantityInvoiced: 0,
			UnitRate: formatAmount(0),
			CalcLineAmountBeforeDiscount: formatAmount(0),
			Discount: formatAmount(0),
			DiscountDetails: "",
			CalcLineAmount: formatAmount(0),
			ExcemptionCode: "",
			CalcTaxAmount: formatAmount(0),
			LineTotal: formatAmount(0)
		};

		store.insert(newRow)
			.then(() => {
				grid.refresh();
				$(".action-buttons-container").show();
			})
			.catch(error => {
				DevExpress.ui.notify("Error adding row: " + error.message, "error", 3000);
			});
	});


