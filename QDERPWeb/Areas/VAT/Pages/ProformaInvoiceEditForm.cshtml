	function btnPostToLedgerdisableEditing() {
					// Disable all input fields and buttons except for specific ones
					$('input, select, textarea').prop('disabled', true);  // Disable inputs, selects, and textareas
							const allowedButtons = ['btnMoveDown',  'btnMoveUp','btnPostTag','btnPrint2','btnBack'];

					// Disable all dxButton and dxDropDownButton controls
					$('.dx-button, .dx-dropdownbutton').each(function () {
						const id = $(this).attr('id');
						if (id && !allowedButtons.includes(id)) {
							// Disable dxButton and dxDropDownButton widgets except for allowed ones
							if ($(this).data('dxButton')) {
								$(this).dxButton('option', 'disabled', true);
							} else if ($(this).data('dxDropDownButton')) {
								$(this).dxDropDownButton('option', 'disabled', true);
							}
						}
					});

					// Disable DataGrid Editing and Deleting
					var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
					if (dataGrid) {
						dataGrid.option("editing.allowUpdating", false);
						dataGrid.option("editing.allowDeleting", false);
					}
				}


