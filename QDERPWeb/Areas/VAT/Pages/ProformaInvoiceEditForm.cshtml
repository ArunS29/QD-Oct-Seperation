	function onVerifiedByCheckChanged(e) {
		const isChecked = e.value;
		const textBox = $("#VerifiedBytext").dxTextBox("instance");
		textBox.option("disabled", !isChecked);
		if (!isChecked) {
			textBox.option("value", "");
		}
