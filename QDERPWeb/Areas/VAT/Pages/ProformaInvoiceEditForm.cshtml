			// Fetch dropdown data (same API can be used if needed)
				function getDropdownData() {
		// Show loader before AJAX call
		$("#loader").show();

		return $.ajax({
			url: "/api/VATModule/GetGoodsAndServices", // API endpoint
			method: "GET",
			dataType: "json"
		}).then(function(response) {
			console.log("GsData", response);
			return response.map(item => ({
				GSCode: item.Gscode,
				GSDescrpition: item.Gsdescrpition,
				GsdescriptionAr: item.GsdescriptionAr,
				ItemPartNo: item.ItemPartNo,
				CostPrice: item.CostPrice,
				GSSellingRate: item.GssellingRate,
				ReorderQty: item.ReorderQty

			}));
		}).always(function () {
			// Hide loader after AJAX call finishes (success or error)
			$("#loader").hide();
		});
	}
		function getUnitRateMethods() {
			return $.ajax({
				url: "/api/VATModule/GetAccountGroups", // This should match your actual backend endpoint
				method: "GET",
				dataType: "json"
			}).then(function (response) {
				console.log("Unit Rate Data", response);
				return response.map(item => ({
					UnitCode: item.UnitCode,
					UnitDesc: item.UnitDesc,
					UnitType: item.UnitType,

					UnitDescAr: item.UnitDescAr
				}));
			});
		}


			// Fetch dropdown data (same API can be used if needed)
		 function getTaxSlabData() {
			return $.ajax({
				url: "/api/VATModule/GetVatTaxSlabs", // Update with your actual API endpoint
				method: "GET",
				dataType: "json"
			}).then(function(response) {

				return response.map(item => ({
				TaxSlab: item.TaxSlab,
				TaxRate:item.TaxRate,
				TaxSlabCode:item.TaxSlabCode,
				TaxCodeToDisplay:item.TaxCodeToDisplay


				}));
			});
		}





