		  function applyDiscount() {
		  const grid = $("#B2BdataGrid").dxDataGrid("instance");

		  // Get values from UI
		  const total = $("#totalAmount").dxNumberBox("instance").option("value") || 0.00;
		  const discount = $("#discount").dxNumberBox("instance").option("value") || 0.00;

		  // Get required values from grid for the specific row
		  const qty = grid.cellValue(rowIx, "QuantityInvoiced") || 0;
		  const unitPrice = grid.cellValue(rowIx, "UnitRate") || 0;
			let vatRateStr = grid.cellValue(rowIx, "VATPercentage") || "0%";
		  let vatRate = parseFloat(vatRateStr.toString().replace("%", "")) / 100;

		  // Calculate the raw amount
		  let amount = qty * unitPrice;

		  // Apply discount, ensure it doesn't go negative
		  let discountedAmount = amount - discount;
		  if (discountedAmount < 0) discountedAmount = 0;

		  // VAT and total calculations
		  let vatValue = discountedAmount * vatRate;
		  let totalValue = discountedAmount + vatValue;

		  // Update the grid values
			  grid.cellValue(rowIx, "Discount", discount);
			  grid.cellValue(rowIx, "CalcTaxAmount", vatValue);
		   grid.cellValue(rowIx, "LineTotal", totalValue);
		   grid.saveEditData();

		   const popover = $("#CalcardPopover").dxPopover("instance");
	      if (popover) {
	      	popover.hide();
	      }

	  }

