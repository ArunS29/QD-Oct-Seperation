		function deleteProformaInvoiceLine() {
		if (selectedRowKey !== null) {
			const rowIndex = grid.getRowIndexByKey(selectedRowKey);
			if (rowIndex >= 0) {
				const rowData = grid.getDataSource().items()[rowIndex];
				const { InvoiceChildSlNo, InvoiceNo } = rowData;

				if (!InvoiceChildSlNo) {
					grid.deleteRow(rowIndex); // Deletes from UI only
				} else {
					DevExpress.ui.dialog.confirm(
						"You are about to delete the Proforma Invoice from the Register. Click Yes if you would like to continue.",
						"Delete Confirmation"
					).done(function (confirmResult) {
						if (confirmResult) {
							$.ajax({
								url: "/api/VATModule/DeleteProformaInvoiceChild",
								type: "POST",
								contentType: "application/json",
								data: JSON.stringify(InvoiceChildSlNo),
								success: function (response) {
									if (response.success) {
										grid.refresh();
	                    DevExpress.ui.dialog.confirm(
							"Proforma Invoice has been successfully removed from the database",
							"Data Deleted Successfully"
						)
										// Refresh the grid data
										$.ajax({
											type: "GET",
											url: `/api/VATModule/GetGridProformaInvoiceDetails?InvoiceNo=${encodeURIComponent(InvoiceNo)}`,
											dataType: 'json',
											success: function (data) {
												const newRowData = data.map((item, index) => ({
													SNo: index + 1,
													...item
												}));
												initializeDataGrid(newRowData);
											},
											error: function () {
												DevExpress.ui.notify("Failed to refresh grid data.", "error", 2000);
											}
										});
									} else {
										DevExpress.ui.notify(response.message || "Deletion failed.", "error", 2000);
									}
								},
								error: function (xhr) {
									DevExpress.ui.notify("Server error: " + xhr.statusText, "error", 2000);
								}
							});
						}
					});
				}
			}
		} else {
			DevExpress.ui.notify("No row selected to delete.", "error", 2000);
		}
	}


	function onCreateVATInvoiceClick() {
		let invoiceNo = $('#InvoiceNo').dxTextBox("instance").option("value");
		let invoiceIssuedDate = $('#InvoiceIssuedDateTime').dxTextBox("instance").option("value");

		if (!invoiceNo) {
			alert("Invoice number is not set.");
			return;
		}

		let proformaInvoiceNo = invoiceNo; // Assuming InvoiceNo = ProformaInvoiceNo

		$.ajax({
			url: `/${tenantName}/VAT/CreateVATInvoice`,
			type: "POST",
			contentType: "application/json",
			data: JSON.stringify({
				ProformaInvoiceNo: proformaInvoiceNo,
				InvoiceDate: invoiceIssuedDate
			}),
			success: function (response) {
				if (response.success) {
					let newInvoiceNo = response.toInvoiceNo;
					alert("Invoice created successfully: " + newInvoiceNo);

					// Optional: redirect or open edit page
					const params = new URLSearchParams({
						InvoiceNo: newInvoiceNo,
						IsEditflag: true,
						modal: true
					});
					const url = `/${tenantName}/VAT/frm20161VATInvoiceEdit?${params.toString()}`;
					window.location.href = url;
				} else {
					alert("Failed: " + response.message);
				}
			},
			error: function (xhr) {
				alert("Server error: " + xhr.responseText);
			}
		});
	}


