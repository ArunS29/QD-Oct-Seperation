																				.Controller("VATModule")
																				.LoadAction("GetProformaClientName")
																				.LoadMode(DataSourceLoadMode.Raw)
																				.Key("AccountId"))
																				.ValidationRules(rules =>
																				{
																					rules.AddRequired()
																					.Message(new JS("formatMessage('Client Name should be entered')"));
																				})
																				.AcceptCustomValue(true)
																				.OpenOnFieldClick(false)
																				.ValueChangeEvent("input")
																				.HoverStateEnabled(true)
																				.ValueExpr("AccountId")
																				.DisplayExpr("AccountHead")
																				.LabelMode(EditorLabelMode.Floating)
																				.DropDownOptions(d => d.Width(800))
																				.ContentTemplate(new TemplateName("ClientNameContentTemplate"))
																				.Buttons(buttons =>
																				{
										  										// ➕ Add button inside the input
																					buttons.Add()
																					.Name("addClient")
																					.Location(TextEditorButtonLocation.After)
																					.Widget(w => w.Button()
																					.Type(ButtonType.Default)
																					.Icon("plus")
																					.Hint("Add Client")
																					.ElementAttr(new { @class = "custom-hover-button add-hover" })
																					.OnClick("onAddClientClick"));
																				 										// Or your create function

																					// ✏️ Edit button inside the input
																					buttons.Add()
																					.Name("editClient")
																					.Location(TextEditorButtonLocation.After)
																					.Widget(w => w.Button()
																					.Type(ButtonType.Default)
																					.Icon("edit")
																					.Hint("Edit Client")
																					.ElementAttr(new { @class = "custom-hover-button edit-hover" })
																					.OnClick("onEditClientClick"));
																					buttons.Add()
																					.Name("dropDown");
																				})
																				)
									</div>
								</div>

								@(Html.DevExtreme().Popup()
																.ID("ledgerAccountPopup")
																.Width("80%")
																.Height("85%")
