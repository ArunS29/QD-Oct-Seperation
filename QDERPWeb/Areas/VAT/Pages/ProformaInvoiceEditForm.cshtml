	//2. Get Document Count
	async function getDocumentCount() {
		const InvoiceNoBox = $("#InvoiceNo").dxTextBox("instance");
        const invoiceNo = InvoiceNoBox ? InvoiceNoBox.option("value") : null;
        var menuType = "vat";
        var formType ="Proforma Invoice";
		const invoiceRes = await fetch(`/api/VATModule/GetSONoDNoteNoFromProforma?invoiceNo=${encodeURIComponent(invoiceNo)}`);
		const invoiceData = await invoiceRes.json();

		let folderId2 = "";
		if (invoiceData) {
			folderId2 = [
					invoiceData.SalesOrderNo,
					invoiceData.QuotationNo,
					invoiceData.DeliveryNoteNos
					//invoiceData.ProformaInvoiceNo
			]
			.filter(Boolean)   // remove null/empty
			.join(",");
		}


		const res = await fetch(`/api/LedgerDocumentsF/GetDocuments?folderId=${encodeURIComponent(invoiceNo)}&module=${encodeURIComponent(formType)}&menuType=${encodeURIComponent(menuType)}&folderId2=${encodeURIComponent(folderId2)}`);
		const docs = await res.json();
		const count = docs.length;

		updateAttachButtonCount("#btnAttach", count);
	}

