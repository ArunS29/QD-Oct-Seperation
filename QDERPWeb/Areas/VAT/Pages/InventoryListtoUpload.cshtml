<script>
	
		$(document).ready(function () {
		$(".limited-footer .btn-containerIvoiceEdit").each(function () {
			if (!$(this).find("#btnUploadItems").length) {
				$(this).remove();
		}
		});
	});

	function onPasteFromExcelClick() {
			document.getElementById('excel-file').click();
		}
			  function viewInvoice(tenantName) {
				let url = `/${tenantName}/Finance/frm20161VATInvoiceEdit`;
				window.location.href = url; // Navigate to the form
			}
			$(function () {
			$("#InventoryListtoUpload").dxTextBox({
				text: formatMessage("Inventory List to Upload"),
				readOnly: true,
				width: "600px",
				onContentReady: function (e) {
				$(e.element).addClass("dx-textbox-heading");
			}
			});
		});

	$(document).ready(function () {
			console.log('Start permission handling AccountingLedgers');
			var formId = "frm201LedgerView";
			$.ajax({
				url: '/api/Permissions/GetAccessDetails?formId=' + formId,
				type: 'GET',
				contentType: 'application/json',
				success: function (response) {
					console.log("API Response:", response);

					if (response.success && response.permissions) {
						var controlStates = {
							"ddBtnShowRecords": { "Visible": false, "Enabled": false },

						};
						var fullAccess = response.permissions.find(p =>
							p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
						);

						if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
							Object.keys(controlStates).forEach(key => {
								controlStates[key] = { "Visible": true, "Enabled": true };
							});
						} else {
							Object.keys(controlStates).forEach(key => {
								var controlPermission = response.permissions.find(p =>
									p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
								);
								if (controlPermission) {
									controlStates[key] = {
										"Visible": controlPermission.ItemVisible || false,
										"Enabled": controlPermission.ItemEnabled || false
									};
								}
							});
						}
						console.log("Control States:", controlStates);
						Object.keys(controlStates).forEach(key => {
							var button = document.getElementById(key);
							if (button) {

								button.style.display = controlStates[key].Visible ? "inline-block" : "none";

								button.disabled = !controlStates[key].Enabled;
								console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
							} else {
								console.warn(`Button with ID "${key}" not found in the DOM.`);
							}
						});
					} else {
						console.warn("Failed to fetch permissions or no permissions available.");
					}
				},
				error: function (xhr, status, error) {
					console.error("Error fetching permissions:", error);
					alert('An error occurred while fetching permissions. Please try again.');
				}
			});
			 console.log('End permission handling');
		});
		let selectedVoucherNo = null;
		$(function () {
			$("#VATInvoiceWithDetails").dxTextBox({
				text: formatMessage("VAT InvoiceWithDetails"),
				readOnly: true,
				onContentReady: function (e) {
					$(e.element).addClass("dx-textbox-heading");
				}
			});
		});
		let dataGrid;

		document.getElementById('excel-file').addEventListener('change', function (e) {
			const file = e.target.files[0];
			if (!file) return;

			const reader = new FileReader();

			reader.onload = function (e) {
				const data = new Uint8Array(e.target.result);
				const workbook = XLSX.read(data, { type: 'array' });

				const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
				const jsonData = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

				if (!dataGrid) {
					dataGrid = $("#dataGrid").dxDataGrid({
						dataSource: jsonData,
						columnsAutoWidth: true,
						showBorders: true,
						height: 500,
						scrolling: { mode: "virtual" },
						searchPanel: { visible: true },
						filterRow: { visible: true },
						headerFilter: { visible: true },
						columnChooser: { enabled: true },
						grouping: { autoExpandAll: false },
						groupPanel: { visible: true },
						pager: {
							showPageSizeSelector: true,
							allowedPageSizes: [10, 20, 50],
							showInfo: true
						},
						paging: { pageSize: 20 },
						wordWrapEnabled: true
					}).dxDataGrid("instance");
				} else {
					dataGrid.option("dataSource", jsonData);
				}
			};

			reader.readAsArrayBuffer(file);
		});
		
		
</script>
