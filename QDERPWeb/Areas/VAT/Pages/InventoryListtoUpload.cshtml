@page
@using DevExtreme.AspNet.Mvc


<!-- DevExtreme CSS -->
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.4/css/dx.light.css">

<!-- DevExtreme and XLSX Libraries -->
<script src="https://cdn3.devexpress.com/jslib/23.2.4/js/dx.all.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
	.limited-footer .btn-container:not(:has(#btnBack,#btnPastefromExcel,#btnUploadItems)) {
		display: none !important;
	}
	.mainContainer{
		width:100%;
	}
</style>

<div class="title">
	<div class="header-container">
		<div id="InventoryListtoUpload" class="no-border-input"></div>
	</div>
</div>



<div class="dx-fieldset horizontal-container">
	@(Html.DevExtreme().DropDownBox()
		.DataSource(d => d.WebApi()
		.Controller("AccountLedgerMaster")
		.LoadAction("getAccountingLedger")
		.LoadMode(DataSourceLoadMode.Raw)
		.Key("AccountGroupId") // This is the unique key for the data source
		)
		.LabelMode(EditorLabelMode.Outside)
		.Label(new JS("formatMessage('Stock Group')"))
		.ID("ddlAccountGroup")
		.ShowClearButton(true)
		.AcceptCustomValue(true)
		.OpenOnFieldClick(false)
		.ValueChangeEvent("input")
		.HoverStateEnabled(true)
		.ValueExpr("AccountGroupId")
		.DisplayExpr("AccountGroup")
		//.OnInput("ddlAccountGroupOnInput")
		//.OnOpened("ddlAccountGrouponOpened")
		.Width("70%")
		.TabIndex(4)
		.ValidationRules(value => value.AddRequired().Message(new JS("formatMessage('Account Group cannot be empty')")))
		.ValidationMessageMode(ValidationMessageMode.Auto)
		.DropDownOptions(o => o
		.Width("100%")
		)
		//.OnKeyDown("ddlAccountGrouponKeyDown")
		//.OnValueChanged("ddlAccountGroupValueChanged")
		.ContentTemplate(new TemplateName("AccountGroupContentTemplate"))
		)

	@(Html.DevExtreme().Button()
		.ID("btnAddAccount")
		.Icon("plus")
		.Width(80)
		.Height(40)
		.ElementAttr("class", "button-alignment-down button-group")
		@* .OnClick("redirectledgerAccountMaster") *@
		)

	@(Html.DevExtreme().TextBox()
		.ID("txtVatPurchaseNo")
		.Label(new JS("formatMessage('Vat Purchase No')"))
		.LabelMode(EditorLabelMode.Outside)
		.InputAttr("aria-label", "Text")
		.Width("17%")
		)

	@(Html.DevExtreme().TextBox()
		.ID("txtPurchaseInvoiceNo")
		.Label(new JS("formatMessage('Proforma Invoice No')"))
		.LabelMode(EditorLabelMode.Outside)
		.InputAttr("aria-label", "Text")
		.Width("17%")
		)
	@(Html.DevExtreme().TextBox()
		.ID("txtInvoiceNo")
		.Label(new JS("formatMessage('Invoice No')"))
		.LabelMode(EditorLabelMode.Outside)
		.InputAttr("aria-label", "Text")
		.Width("17%")
		)
	@(Html.DevExtreme().TextBox()
		.ID("txtRegisterNo")
		.Label(new JS("formatMessage('Request No')"))
		.LabelMode(EditorLabelMode.Outside)
		.InputAttr("aria-label", "Text")
		.Width("17%")
		)


</div>
<div class="dx-field ledgerResult">
	<div id="gridContainer" style="margin-top: 20px;"></div>
	
</div>
<input style="display:none;" type="file" id="excel-file" accept=".xlsx, .xls" />
<div>

	@(Html.DevExtreme().Button()
		.ID("btnPastefromExcel")
		.Text(new JS("formatMessage('Paste from Excel')"))
		.Icon("card")
		.Width(250)
		.OnClick("onPasteFromExcelClick")
		)
</div>

<div class="Head">
	<div class="limited-footer">
		@await Html.PartialAsync("VATModuleFooter")
</div>
</div>

<div id="overlay" class="overlay">
	<div class="overlay-content">
		<span class="close-btn" onclick="closeOverlay()">×</span>
		<iframe id="overlay-frame" src="" frameborder="0"></iframe>
	</div>
</div>


<script>
	
		$(document).ready(function () {
		$(".limited-footer .btn-containerIvoiceEdit").each(function () {
			if (!$(this).find("#btnUploadItems").length) {
				$(this).remove();
		}
		});
	});

	function onPasteFromExcelClick() {
			document.getElementById('excel-file').click();
		}
			  function viewInvoice(tenantName) {
				let url = `/${tenantName}/Finance/frm20161VATInvoiceEdit`;
				window.location.href = url; // Navigate to the form
			}
			$(function () {
			$("#InventoryListtoUpload").dxTextBox({
				text: formatMessage("Inventory List to Upload"),
				readOnly: true,
				onContentReady: function (e) {
				$(e.element).addClass("dx-textbox-heading");
			}
			});
		});

	$(document).ready(function () {
			console.log('Start permission handling AccountingLedgers');
			var formId = "frm201LedgerView";
			$.ajax({
				url: '/api/Permissions/GetAccessDetails?formId=' + formId,
				type: 'GET',
				contentType: 'application/json',
				success: function (response) {
					console.log("API Response:", response);

					if (response.success && response.permissions) {
						var controlStates = {
							"ddBtnShowRecords": { "Visible": false, "Enabled": false },

						};
						var fullAccess = response.permissions.find(p =>
							p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
						);

						if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
							Object.keys(controlStates).forEach(key => {
								controlStates[key] = { "Visible": true, "Enabled": true };
							});
						} else {
							Object.keys(controlStates).forEach(key => {
								var controlPermission = response.permissions.find(p =>
									p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
								);
								if (controlPermission) {
									controlStates[key] = {
										"Visible": controlPermission.ItemVisible || false,
										"Enabled": controlPermission.ItemEnabled || false
									};
								}
							});
						}
						console.log("Control States:", controlStates);
						Object.keys(controlStates).forEach(key => {
							var button = document.getElementById(key);
							if (button) {

								button.style.display = controlStates[key].Visible ? "inline-block" : "none";

								button.disabled = !controlStates[key].Enabled;
								console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
							} else {
								console.warn(`Button with ID "${key}" not found in the DOM.`);
							}
						});
					} else {
						console.warn("Failed to fetch permissions or no permissions available.");
					}
				},
				error: function (xhr, status, error) {
					console.error("Error fetching permissions:", error);
					alert('An error occurred while fetching permissions. Please try again.');
				}
			});
			 console.log('End permission handling');
		});
		let selectedVoucherNo = null;
		$(function () {
			$("#VATInvoiceWithDetails").dxTextBox({
				text: formatMessage("VAT InvoiceWithDetails"),
				readOnly: true,
				onContentReady: function (e) {
					$(e.element).addClass("dx-textbox-heading");
				}
			});
		});
		let dataGrid;

		document.getElementById('excel-file').addEventListener('change', function (e) {
			const file = e.target.files[0];
			if (!file) return;

			const reader = new FileReader();

			reader.onload = function (e) {
				const data = new Uint8Array(e.target.result);
				const workbook = XLSX.read(data, { type: 'array' });

				const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
				const jsonData = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

				if (!dataGrid) {
					dataGrid = $("#gridContainer").dxDataGrid({
						dataSource: jsonData,
						columnsAutoWidth: true,
						showBorders: true,
						height: 500,
						scrolling: { mode: "virtual" },
						searchPanel: { visible: true },
						filterRow: { visible: true },
						headerFilter: { visible: true },
						columnChooser: { enabled: true },
						grouping: { autoExpandAll: false },
						groupPanel: { visible: true },
						pager: {
							showPageSizeSelector: true,
							allowedPageSizes: [10, 20, 50],
							showInfo: true
						},
						paging: { pageSize: 20 },
						wordWrapEnabled: true
					}).dxDataGrid("instance");
				} else {
					dataGrid.option("dataSource", jsonData);
				}
			};

			reader.readAsArrayBuffer(file);
		});
		
		
</script>
