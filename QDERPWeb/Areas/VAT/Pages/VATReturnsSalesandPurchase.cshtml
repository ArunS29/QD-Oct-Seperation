    .card.compact {
        padding: 14px 16px;
        min-height: unset;
    }

    .blue {
        background: linear-gradient(135deg, #6a11cb, #2575fc) !important; /* soft blue tones */
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }
    @@keyframes gradientPulse {
        0%

    {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }

    }


    /* Text Styles */
    .card.compact h4 {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .card.compact h2 {
        font-size: 18px;
        font-weight: 600;
        margin-top: 2px;
    }

    /* Animations */
    .fade-in {
        animation: fadeIn 0.8s ease forwards;
        opacity: 0;
    }

    .title-slide {
        animation: titleSlide 0.9s ease forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    @@keyframes titleSlide {
        0% {
            opacity: 0;
            transform: translateY(8px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .Head {
        margin-bottom: 10px;
    }

    .dx-tabs {
        border-radius: 4px; /* reduced from 6px or more */
    }

    .text-right-number .dx-texteditor-input {
        text-align: right;
    }

    .dx-fieldset.horizontal-container {
        margin-top: 20px;
    }

    .numberbox-with-icon {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    /* .dx-numberbox-iconed {
        padding-right: 30px;
    }
 */
    .print-icon {
        position: absolute;
        left: 6px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 20px; /* adjust size as needed */
        color: #007bff;
        cursor: pointer;
        z-index: 2;
    }

        .print-icon:hover {
            color: #0056b3;
            transform: translateY(-50%) scale(1.1);
        }


</style>
