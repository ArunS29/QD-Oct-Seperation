<script>
    $(document).ready(function () {
        $(".limited-footer .btn-containerIvoiceEdit").each(function () {
            if (!$(this).find("#btnPrint,#ddReport,#ddReports").length) {
                $(this).remove();
            }
        });

        $("#VATReturns").dxTextBox({
            text: formatMessage("VAT Returns"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });

        var selectedTabIndex = 0;
        $("#tab-content-" + (selectedTabIndex + 1)).show();
    });

    function onTabSelectionChanged(e) {
        $(".tab-content").hide();
        var selectedTabIndex = e.component.option("selectedIndex");
        $("#tab-content-" + (selectedTabIndex + 1)).show();
    }
    function onTabSelectionChanged(e) {
        var selectedIndex = e.component.option("selectedIndex");
        if (selectedIndex === 0) {
            document.getElementById("leftTitle").innerText = "VAT on Sales";
            document.getElementById("vatOnSalesForm").style.display = "flex";
            document.getElementById("vatOnPurchaseForm").style.display = "none";
        } else {
            document.getElementById("leftTitle").innerText = "VAT on Purchase";
            document.getElementById("vatOnSalesForm").style.display = "none";
            document.getElementById("vatOnPurchaseForm").style.display = "flex";
        }
    }


    function ddBtnShowRecords_click(duration) {
        
        var frmDateBox = $("#frmdateBox").dxDateBox("instance");
        var toDateBox = $("#todateBox").dxDateBox("instance");
        var frmDate = new Date(frmDateBox.option("value"));
        var toDate = new Date(toDateBox.option("value"));
        var currentDate = new Date();
        switch (duration) {
            case 'today':
                frmDate = toDate = currentDate;
                break;
            case 'yesterday':
                var dateObj = new Date();
                // Subtract one day from current time
                dateObj.setDate(dateObj.getDate() - 1);
                frmDate = toDate = dateObj;
                break;
            case 'week':
                var dayOfWeek = currentDate.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

                // Calculate the start of the week (Saturday)
                var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7; // Adjust to get Saturday

                // Calculate the start date (7 days before Saturday) and end date (the day before Saturday)
                frmDate = new Date(currentDate.setDate(startOfWeek));
                toDate = new Date(currentDate.setDate(startOfWeek + 6));
                break;
            case 'tillmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
                toDate = currentDate; //Today
                break;
            case 'fullmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); // First day of month
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); // Last day of month
                break;
            case 'tillyear':
                // Get the first and last day of the current year
                frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
                toDate = currentDate;// Today
                break;
            case 'fullyear':
                // Get the first and last day of the current year
                frmDate = new Date(currentDate.getFullYear(), 0, 1); // First day of year (January 1)
                toDate = new Date(currentDate.getFullYear(), 11, 31); // Last day of month
                break;
            case 'lastyear':
                // Get the first and last day of the last year
                frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); // First day of year (January 1)
                toDate = new Date(currentDate.getFullYear() - 1, 11, 31); // Last day of month
                break;
            case 'lastmonth':
                // Get the first and last day of the current month
                frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); // First day of month
                toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); // Last day of month
                break;
        }
        frmDate = frmDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        toDate = toDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        FromDate = frmDate;
        ToDate = toDate;
        //alert(FromDate)

        frmDateBox.option("value", frmDate);  // Set frmDateBox value
        toDateBox.option("value", toDate);    // Set toDateBox value
        $.ajax({
            url: '/api/VATModule/GetVATRetursSalesandPurchase',  // API endpoint
            type: 'GET',
            data: {
                frmDate: frmDate,
                toDate: toDate
            },
            success: function (data) {
          
              $("#DssRevenue").dxNumberBox("instance").option("value", data[0].DSS_Revenue);
              $("#DssCreditNote").dxNumberBox("instance").option("value", data[0].DSS_CreditNote);
              $("#DssSalesTaxAfterAdj").dxNumberBox("instance").option("value", data[0].DSS_Sales_TaxAfterAdj);
              $("#Dss15CreditNote").dxNumberBox("instance").option("value", data[0].DSS_15_CreditNote);
              $("#Dss15SalesTaxAfterAdj").dxNumberBox("instance").option("value", data[0].DSS_15_Sales_TaxAfterAdj);
              $("#GccRevenue").dxNumberBox("instance").option("value", data[0].GCC_Revenue);
              $("#GccCreditNote").dxNumberBox("instance").option("value", data[0].GCC_CreditNote);
              $("#DzrRevenue").dxNumberBox("instance").option("value", data[0].DZR_Revenue);
              $("#DzrCreditNote").dxNumberBox("instance").option("value", data[0].DZR_CreditNote);
              $("#ExpRevenue").dxNumberBox("instance").option("value", data[0].EXP_Revenue);
              $("#ExpCreditNote").dxNumberBox("instance").option("value", data[0].EXP_CreditNote);
              $("#DexCreditNote").dxNumberBox("instance").option("value", data[0].DEX_CreditNote);
              $("#RevenueTotal").dxNumberBox("instance").option("value", data[0].RevenueTotal);
              $("#CreditNoteTotal").dxNumberBox("instance").option("value", data[0].CreditNoteTotal);
              $("#DSSTotalSalesTax").dxNumberBox("instance").option("value", data[0].DSS_Total_SalesTax_BH);
              $("#DssPurchases").dxNumberBox("instance").option("value", data[0].DSS_Purchases);
              $("#DssDebitNote").dxNumberBox("instance").option("value", data[0].DSS_CreditNote);
              $("#DssPurTaxAfterAdj").dxNumberBox("instance").option("value", data[0].DSS_Pur_TaxAfterAdj);
              $("#DssPurchases15Perc").dxNumberBox("instance").option("value", data[0].DSS_Purchases15Perc);
              $("#Dss15PerDebitNote").dxNumberBox("instance").option("value", data[0].DSS_DebitNote);
              $("#Dss15PerPurTaxAfterAdj").dxNumberBox("instance").option("value", data[0].DSS_15Per_Pur_TaxAfterAdj);
              $("#IPCPurchases").dxNumberBox("instance").option("value", data[0].IPC_Purchases);
              $("#IPCDebitNote").dxNumberBox("instance").option("value", data[0].IPC_DebitNote);
              $("#IPCPurTaxAfterAdj").dxNumberBox("instance").option("value", data[0].IPC_Pur_TaxAfterAdj);
              $("#IPCPurchases15Perc").dxNumberBox("instance").option("value", data[0].IPC_Purchases15Perc);
              $("#IPC15PerDebitNote").dxNumberBox("instance").option("value", data[0].IPC_15Per_DebitNote);
              $("#IPC15PerPurTaxAfterAdj").dxNumberBox("instance").option("value", data[0].IPC_15Per_Pur_TaxAfterAdj);
              $("#RCMPurchases").dxNumberBox("instance").option("value", data[0].RCM_Purchases);
              $("#RCMDebitNote").dxNumberBox("instance").option("value", data[0].RCM_DebitNote);
              $("#RCMPurTaxAfterAdj").dxNumberBox("instance").option("value", data[0].RCM_Pur_TaxAfterAdj);
              $("#RCMPurchases15Perc").dxNumberBox("instance").option("value", data[0].RCM_Purchases15Perc);
              $("#RCM15PerDebitNote").dxNumberBox("instance").option("value", data[0].RCM_15Per_DebitNote);
              $("#RCM15PerPurTaxAfterAdj").dxNumberBox("instance").option("value", data[0].RCM_15Per_Pur_TaxAfterAdj);
              $("#DZRPurchases").dxNumberBox("instance").option("value", data[0].DZR_Purchases);
              $("#DZRDebitNote").dxNumberBox("instance").option("value", data[0].DZR_CreditNote);
              $("#DEXPurchases").dxNumberBox("instance").option("value", data[0].DEX_Purchases);
              $("#DEXDebitNote").dxNumberBox("instance").option("value", data[0].DEX_DebitNote);
              $("#TotalPurchaseTax").dxNumberBox("instance").option("value", data[0].TotalPurchaseTax);

            },
            error: function () {
                DevExpress.ui.notify("Error while loading data", "error", 2000);
            }
        });
    }
</script>