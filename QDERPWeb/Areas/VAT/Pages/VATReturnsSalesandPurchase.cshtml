</div>





 


<div class="Head">
    <div class="limited-footer">
        @await Html.PartialAsync("VATModuleFooter")
    </div>
</div>

<script>
    $(document).ready(function () {
        $(".limited-footer .btn-containerIvoiceEdit").each(function () {
            if (!$(this).find("#btnPrint,#ddReport,#ddReports").length) {
                $(this).remove();
            }
        });

        $("#VATReturns").dxTextBox({
            text: formatMessage("VAT Returns"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });

        var selectedTabIndex = 0;
        $("#tab-content-" + (selectedTabIndex + 1)).show();
    });

    function onTabSelectionChanged(e) {
        $(".tab-content").hide();
        var selectedTabIndex = e.component.option("selectedIndex");
        $("#tab-content-" + (selectedTabIndex + 1)).show();
    }
    function onTabSelectionChanged(e) {
        var selectedIndex = e.component.option("selectedIndex");
        if (selectedIndex === 0) {
            document.getElementById("leftTitle").innerText = "VAT on Sales";
            document.getElementById("vatOnSalesForm").style.display = "flex";
            document.getElementById("vatOnPurchaseForm").style.display = "none";
        } else {
            document.getElementById("leftTitle").innerText = "VAT on Purchase";
            document.getElementById("vatOnSalesForm").style.display = "none";
            document.getElementById("vatOnPurchaseForm").style.display = "flex";
        }
    }
</script>