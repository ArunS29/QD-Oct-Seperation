        padding: 10px;
        flex: 1;
    }

    .textbox-container {
        margin-bottom: 15px;
        display: flex;
        justify-content: flex-start;
        align-items: center;
    }

        .textbox-container .dx-numberbox {
            width: 100%;
            max-width: 200px;
        }

    .dx-fieldset.horizontal-container {
        margin-top: 0px;
    }
    /* Targets all DevExtreme tab items */
    .dx-tab {
        padding: 6px 16px;
        border-radius: 15px;
        font-weight: 500;
        font-family: 'Segoe UI', sans-serif;
    }

        
    .dx-tabs .dx-tab {
        padding: 8px 16px;
    }

    .dx-tabs .dx-tab {
        border-radius: 5px;
    }

     /* First tab: Sales => green text, light green background */
    .dx-tabs .dx-tab:nth-child(1) {
        background-color: #e6ffe6; /* light green */
    }

    .dx-tabs .dx-tab:nth-child(1) .dx-tab-text {
        color: #28a745;
        font-weight: bold;
    }

    /* Second tab: Purchase => red text, light red background */
    .dx-tabs .dx-tab:nth-child(2) {
        background-color: #ffe6e6; /* light red */
    }

        .dx-tabs .dx-tab:nth-child(2) .dx-tab-text {
            color: #ff4d4d;
            font-weight: bold;
        }


    .vat-table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Segoe UI', sans-serif;
        font-size: 14px;
        margin-bottom: 30px;
    }

    .vat-table th,
    .vat-table td {
        border: 1px solid #ccc;
        padding: 8px;
        text-align: center;
    }

    .vat-table th {
            background-color: var(--background-color);
            
        font-weight: bold;
    }

    .vat-table td:nth-child(2) {
        text-align: left;
    }

    .vat-table .total-row {
            background-color: #f8f9fa;
        font-weight: bold;
    }


    .dashboard {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .card {
        flex: 1;
        padding: 15px;
        border-radius: 12px;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        height: 110px;
    }

        .card h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

        .card p {
            margin: 4px 0;
            font-size: 14px;
        }

        .card .amount {
            font-size: 26px;
            margin: 5px 0;
            font-weight: bold;
        }

        .card .percent {
            font-size: 14px;
            display: flex;
            align-items: center;
        }


    .tabs {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .tab-text {
        flex: 1;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        padding: 2px 0;
        border-radius: 6px;
        transition: background 0.3s ease;
    }

        .tab-text.active {
            background: rgba(255, 255, 255, 0.9);
            color: #333;
        }

    .tab-content {
        display: none;
        text-align: center;
        animation: fadeSlideIn 0.4s ease;
    }

        .tab-content.active {
            display: block;
        }

    h4 {
        margin-bottom: 4px;
        font-size: 16px;
    }

    .count {
        font-size: 28px;
        font-weight: bold;
        margin: 4px 0;
    }

        .count.bounce {
            animation: bounceIn 0.4s ease;
        }

    .trend {
        font-size: 14px;
        margin-bottom: 8px;
    }

    .message {
        font-size: 14px;
        font-weight: 500;
        margin-top: 6px;
    }

    /* Backgrounds per tab */
    .today-bg {
        background: linear-gradient(270deg, #2196f3, #64b5f6);
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }

    .week-bg {
        background: linear-gradient(270deg, #009688, #4db6ac);
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }

    .month-bg {
        background: linear-gradient(270deg, #9c27b0, #ba68c8);
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }

    /* Keyframes */
    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes bounceIn {
        0% {
            transform: scale(0.9);
            opacity: 0;
        }

        50% {
            transform: scale(1.05);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes gradientPulse {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .card.green {
        background: linear-gradient(135deg, #43a047, #81c784); /* green gradient */
        position: relative;
        overflow: hidden;
    }


    .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
    }

    h1 {
        font-size: 42px;
        margin: 10px 0 5px;
    }

    h3 {
        font-size: 14px;
        font-weight: 500;
        margin: 0;
    }

    /* Count animation bounce */
    h1.bounce {
        animation: bounceIn 0.5s ease;
    }

    @@keyframes bounceIn {
        0% {
            transform: scale(0.9);
            opacity: 0;
        }

        50% {
            transform: scale(1.05);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    /* Sparkle effect (optional) */
    .sparkle::after {
        content: '✨';
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 18px;
        animation: sparkle 1.8s infinite ease-in-out;
    }

    @@keyframes sparkle {
        0%, 100%

    {
        transform: scale(0.8) rotate(0deg);
        opacity: 0.8;
    }

    50% {
        transform: scale(1.2) rotate(30deg);
        opacity: 1;
    }

    }


    .card.red {
        background: linear-gradient(135deg, #e53935, #ef5350); /* rich red gradient */
    }

    .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
    }

    h4 {
