@page

@using DevExpress.AspNetCore

@using QD.ERP.Web.Areas.Finance.Reports

@using QD.ERP.Web.Reports

@model QD.ERP.Web.Pages.DocumentViewerModel

<link rel="stylesheet" href="~/css/reporting.designer.part.bundle.css" />
<script src="~/js/reporting.designer.part.bundle.js"></script>

<!-- Dynamically set the current report name based on the model -->
<script>

    var currentReportName = '@Model.ReportName';

    function onDocumentViewerReady(s, e) {
        // Set zoom level correctly
        s.GetPreviewModel().reportPreview.zoom(1.5);

        // Wait until the toolbar is rendered
        setTimeout(() => {
            tryTriggerFullScreen();
        }, 1000);
    }



           function tryTriggerFullScreen() {
               alert('hi');
        let attempts = 0;
        const maxAttempts = 30;

        const intervalId = setInterval(() => {
            const fullscreenBtn = document.querySelector(
                'div[role="button"][aria-label="Full Screen"]'
            );

            if (fullscreenBtn) {
                fullscreenBtn.click();
                console.log("✅ Fullscreen triggered!");
                clearInterval(intervalId);
            } else {
                attempts++;
                if (attempts >= maxAttempts) {
                    console.warn("❌ Fullscreen button not found after waiting.");
                    clearInterval(intervalId);
                }
            }
        }, 500); // Try every 500ms
    }



    function openEmailPopup() {
        const popup = document.getElementById("emailPopup");
        document.getElementById("emailFrame").src = "/Pages/EmailCompose";
        popup.style.display = "flex";
        popup.classList.add("fade-in");
        document.getElementById("emailLoader").style.display = "block";
        setTimeout(() => {
            document.getElementById("emailLoader").style.display = "none";
        }, 1500);
    }

    function closeEmailPopup() {
        const popup = document.getElementById("emailPopup");
        popup.classList.remove("fade-in");
        popup.classList.add("fade-out");
        setTimeout(() => {
            popup.style.display = "none";
            popup.classList.remove("fade-out");
            document.getElementById("emailFrame").src = "";
        }, 500);
    }

    function refreshEmailPopup() {
        document.getElementById("emailFrame").src = document.getElementById("emailFrame").src;
    }



</script>

<button class="btn btn-primary send-email-btn" onclick="openEmailPopup()">📧 Send Email</button>
@(Html.DevExpress().WebDocumentViewer("documentViewer")
    .Height("82em")
    .ClientSideEvents(events => events.DocumentReady("onDocumentViewerReady"))
    .Bind(Model.Report)
)

@* Floating Edit Report Button with Icon and Text *@
<a href="javascript:void(0);" id="btnOpenDesigner" class="btn-edit-report"
   data-tooltip="Open Designer"
   onclick="openReportDesigner('@Model.ReportName', '@Model.AccountId', '@Model.FrmDate', '@Model.ToDate','@Model.AccountGroup')">
    <span class="btn-text">Open Designer</span>
    <i class="fa fa-pencil-alt"></i>
</a>
<!-- Email Popup -->
<div id="emailPopup" class="popup-overlay">
    <div class="popup-content">
        <div class="popup-header">
            <h5 class="popup-title">📩 Compose Email</h5>
            <button class="popup-btn" onclick="refreshEmailPopup()">🔄</button>
            <button class="popup-close" onclick="closeEmailPopup()">✖</button>
        </div>
        <div id="emailLoader" class="loader"></div>
        <iframe id="emailFrame" src="" width="800px" height="500px" style="border: none;"></iframe>
    </div>
</div>
