@page
@using DevExpress.AspNetCore
@using QD.ERP.Web.Areas.Finance.Reports
@using QD.ERP.Web.Reports
@model QD.ERP.Web.Pages.DocumentViewerModel
@{
    ViewData["Title"] = "";
}

<link rel="stylesheet" href="~/css/reporting.viewer.part.bundle.css" />
<link rel="stylesheet" href="~/css/reporting.designer.part.bundle.css" />
<script src="~/js/reporting.viewer.part.bundle.js"></script>
<script src="~/js/reporting.designer.part.bundle.js"></script>

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <!-- Tab navigation to switch between preview and design mode -->
    <div class="nav nav-tabs" id="reportTab" role="tablist">
        <a class="nav-item nav-link active" id="previewTab" data-bs-toggle="tab" href="#previewSection" role="tab" aria-controls="previewSection" aria-selected="true">Report Preview</a>
        <a class="nav-item nav-link" id="designTab" data-bs-toggle="tab" href="#designSection" role="tab" aria-controls="designSection" aria-selected="false">Design the Report</a>
    </div>

    <div class="tab-content mt-3">
        <!-- Preview Section -->
        <div class="tab-pane fade show active" id="previewSection" role="tabpanel" aria-labelledby="previewTab">
            <h6>Report Preview</h6>
            @(Html.DevExpress().WebDocumentViewer("documentViewer")
                .Height("600px")
                .Bind(Model.Report)  // This will bind the report data for preview
                )
        </div>

        <!-- Design Section (Initially hidden until tab is selected) -->
        <div class="tab-pane fade" id="designSection" role="tabpanel" aria-labelledby="designTab">
            <h6>Report Designer</h6>
            @(Html.DevExpress().ReportDesigner("reportDesigner")
                .Height("1000px")
                .Bind(Model.Report)  // Bind the same model for design mode
                )
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Handle the tab changes when switching between "Preview" and "Design Mode"
        $('#reportTab a').on('click', function (e) {
            var target = $(this).attr('href');
            // Show loading spinner or any pre-processing indicator if necessary before switching tabs
            console.log("Switching tab to: " + target);
        });

        // Optional: If you want to save the report after the user designs it
        var designerElement = $("#reportDesigner");
        if (designerElement.length) {
            var designerInstance = designerElement.data("dxReportDesigner");

            // Listen for the save button click event in the Report Designer
            var saveButton = designerInstance.element().find(".dxrd-save-button");

            if (saveButton.length > 0) {
                saveButton.on("click", function () {
                    // Trigger the save functionality
                    designerInstance.saveReport();  // This saves the report

                    // Optionally, you can add logic here to send the updated report to the server via AJAX
                    console.log("Report saved successfully.");
                });
            }
        }
    });
</script>

<!-- Adding Bootstrap for styling and smoother transitions -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/js/bootstrap.bundle.min.js"></script>