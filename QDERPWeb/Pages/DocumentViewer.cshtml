<script>
    function getTenantNameFromUrl() {
        const pathParts = window.location.pathname.split('/');
        return pathParts[1] || '';
    }

    function openReportDesigner(reportName, accountId, frmDate, toDate, accountGroup) {
        const tenantName = getTenantNameFromUrl();
        let reportDesignerUrl;

        if (accountId && accountId.trim() !== "") {
           
            reportDesignerUrl = `/${tenantName}/ReportDesigner?reportName=${encodeURIComponent(reportName)}&accountId=${encodeURIComponent(accountId)}&frmDate=${encodeURIComponent(frmDate)}&toDate=${encodeURIComponent(toDate)}`;
        } else if (accountGroup && accountGroup.trim() !== "") {
        
            reportDesignerUrl = `/${tenantName}/ReportDesigner?reportName=${encodeURIComponent(reportName)}&accountGroup=${encodeURIComponent(accountGroup)}&frmDate=${encodeURIComponent(frmDate)}&toDate=${encodeURIComponent(toDate)}`;
        } else {
            alert("Please provide either Account ID or Account Group.");
            return;
        }

        window.open(reportDesignerUrl, "_blank", "noopener,noreferrer,width=1200,height=800");
    }
</script>

