@page
@model TemplateCreateModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Email Template</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .preview-box {
            border: 1px solid #ddd;
            padding: 15px;
            margin-top: 20px;
            background: #f9f9f9;
        }
    </style>
</head>
<body>

    <div class="container mt-4">
        <h2>Create Email Template</h2>

        <form method="post">
            <div class="mb-3">
                <label for="templateName" class="form-label">Template Name</label>
                <input type="text" id="templateName" class="form-control" asp-for="TemplateName" required />
            </div>

            <div class="mb-3">
                <label for="subject" class="form-label">Subject</label>
                <input type="text" id="subject" class="form-control" asp-for="Subject" required />
            </div>

            <div class="mb-3">
                <label for="emailBody" class="form-label">Body</label>
                <textarea id="emailBody" class="form-control" asp-for="Body" rows="5" required></textarea>
            </div>

            <div class="mb-3">
                <label for="placeholders" class="form-label">Placeholders</label>
                <select id="placeholders" class="form-control">
                    <option value="{{name}}">Name</option>
                    <option value="{{date}}">Date</option>
                    <option value="{{email}}">Email</option>
                </select>
                <button type="button" class="btn btn-secondary mt-2" onclick="insertPlaceholder()">Insert</button>
            </div>

            <div class="mb-3">
                <label for="status" class="form-label">Status</label>
                <select id="status" class="form-control" asp-for="Status">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Save Template</button>
        </form>

        <h3 class="mt-4">Preview</h3>
        <div class="preview-box">
            <strong>Subject:</strong> <span id="previewSubject"></span><br />
            <hr />
            <div id="previewBody"></div>
        </div>
    </div>

    <script>
        $("#templateCategory").change(function () {
            let category = $(this).val();
            $("#emailTemplate").empty().append('<option value="">-- Select Template --</option>');

            if (category) {
                $.get('/EmailCompose?handler=Templates&category=' + category, function (data) {
                    data.forEach(function (template) {
                        $("#emailTemplate").append(`<option value="${template.id}" data-subject="${template.subject}" data-body="${template.body}">${template.templateName}</option>`);
                    });

                    // Optional: Add option to create a new one
                    $("#emailTemplate").append('<option value="insert">Insert Template</option>');
                });
            }
        });

        document.getElementById("emailBody").addEventListener("input", updatePreview);
        document.getElementById("subject").addEventListener("input", updatePreview);

        function updatePreview() {
            document.getElementById("previewSubject").innerText = document.getElementById("subject").value;
            document.getElementById("previewBody").innerHTML = document.getElementById("emailBody").value;
        }

        function insertPlaceholder() {
            var placeholder = document.getElementById("placeholders").value;
            var textarea = document.getElementById("emailBody");
            textarea.value += placeholder;
            updatePreview();
        }
    </script>

</body>
</html>
