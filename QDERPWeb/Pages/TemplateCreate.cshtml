@page
@model TemplateCreateModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Email Template</title>

    <!-- Bootstrap & Quill -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(to right, #e0f7fa, #f1f8e9);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding-top: 50px;
        }

        .card {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border-radius: 16px;
            border: none;
            background: #ffffff;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
            }

        .form-label {
            font-weight: 600;
            color: #37474f;
        }

        h2 {
            font-weight: 700;
            color: #1e2a38;
        }

        button.btn-primary {
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
            background: linear-gradient(to right, #007bff, #00c6ff);
            border: none;
            transition: background 0.3s ease;
        }

            button.btn-primary:hover {
                background: linear-gradient(to right, #0056b3, #009acd);
            }

        input.form-control, select.form-control, textarea.form-control {
            border-radius: 8px;
            border: 1px solid #ced4da;
            transition: border-color 0.2s ease;
        }

            input.form-control:focus, select.form-control:focus, textarea.form-control:focus {
                border-color: #00bcd4;
                box-shadow: 0 0 0 0.1rem rgba(0, 188, 212, 0.25);
            }

        .container {
            max-width: 700px;
        }

        .preview-box {
            border: 1px dashed #ccc;
            padding: 20px;
            margin-top: 20px;
            background-color: #fffdf7;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.6;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card p-4">
            <h2 class="mb-4 text-center">Create Email Template</h2>

            <form method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="templateName" class="form-label">Template Name</label>
                    <input type="text" id="templateName" class="form-control" asp-for="Template.TemplateName" required />
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <input type="text" id="category" class="form-control" asp-for="Template.Category" required />
                </div>
                <div class="mb-3">
                    <label for="subject" class="form-label">Subject</label>
                    <input type="text" id="subject" class="form-control" asp-for="Template.Subject" required />
                </div>
                <div class="mb-3">
                    <label for="emailBody" class="form-label">Body</label>
                    <div id="editor" style="height: 200px;"></div>
                    <textarea id="emailBody" asp-for="Template.Body" hidden></textarea>
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" class="form-control" asp-for="Template.Status">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="mt-4">
                    <h5 class="text-primary">Live Preview</h5>
                    <div class="preview-box">
                        <strong id="previewSubject"></strong><br>
                        <div id="previewBody"></div>
                    </div>

                    <div class="mt-3">
                        <label for="placeholders" class="form-label">Insert Placeholder:</label>
                        <select id="placeholders" class="form-control w-auto d-inline" onchange="insertPlaceholder()">
                            <option value="">-- Select --</option>
                            <option value="{{UserName}}">{{UserName}}</option>
                            <option value="{{Date}}">{{Date}}</option>
                            <option value="{{InvoiceNo}}">{{InvoiceNo}}</option>
                        </select>
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary">Save Template</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let quill;
        $(document).ready(function () {
            quill = new Quill('#editor', {
                theme: 'snow',
                placeholder: 'Write your email content here...'
            });

            quill.on('text-change', updatePreview);
            $("#subject").on("input", updatePreview);

            window.insertPlaceholder = function () {
                const placeholder = $("#placeholders").val();
                if (placeholder) {
                    const cursorPosition = quill.getSelection()?.index || 0;
                    quill.insertText(cursorPosition, placeholder);
                    updatePreview();
                }
            };

            $("form").on("submit", function () {
                $("#emailBody").val(quill.root.innerHTML);
            });

            function updatePreview() {
                $("#previewSubject").text($("#subject").val());
                $("#previewBody").html(quill.root.innerHTML);
            }

            // Handle success alert
            var isSuccess = "@(HttpContext.Request.Query["isSuccess"])";
            if (isSuccess.toLowerCase() === "true") {
                setTimeout(() => {
                    if (confirm("Email Template saved successfully!")) {
                        history.back();
                    }
                }, 100);
            }
        });
    </script>
</body>
</html>
