@page
@model TemplateCreateModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Email Template</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        .preview-box {
            border: 1px solid #ddd;
            padding: 15px;
            margin-top: 20px;
            background: #f9f9f9;
        }

        #successPopup {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            text-align: center;
            z-index: 1000;
        }

        #overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h2>Create Email Template</h2>

        <form id="templateForm">
            <div class="mb-3">
                <label class="form-label">Template Name</label>
                <input type="text" id="templateName" class="form-control" asp-for="Template.TemplateName" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Category</label>
                <input type="text" id="category" class="form-control" asp-for="Template.Category" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Subject</label>
                <input type="text" id="subject" class="form-control" asp-for="Template.Subject" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Body</label>
                <textarea id="emailBody" class="form-control" asp-for="Template.Body" rows="5" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select id="status" class="form-control" asp-for="Template.Status">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <button type="button" class="btn btn-primary" id="saveTemplate">Save Template</button>
        </form>
    </div>

    <!-- Success Popup -->
    <div id="overlay"></div>
    <div id="successPopup">
        <h4>Template saved successfully!</h4>
        <button id="okButton" class="btn btn-success">OK</button>
    </div>

    <script>
        $(document).ready(function () {
            $("#saveTemplate").click(function () {
                let templateData = {
                    TemplateName: $("#templateName").val(),
                    Category: $("#category").val(),
                    Subject: $("#subject").val(),
                    Body: $("#emailBody").val(),
                    Status: $("#status").val()
                };

                $.post("/TemplateCreate?handler=SaveTemplate", templateData, function (response) {
                    if (response.success) {
                        $("#overlay, #successPopup").fadeIn();
                        $("#okButton").click(function () {
                            window.location.href = "/EmailCompose?selectedTemplate=" + response.templateId;
                        });
                    } else {
                        alert("Error saving template.");
                    }
                });
            });
        });
    </script>
</body>
</html>
