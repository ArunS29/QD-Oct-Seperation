@page
@model TemplateCreateModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Email Template</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(to right, #e0f7fa, #f1f8e9);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding-top: 50px;
        }

        .card {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border-radius: 16px;
            border: none;
            background: #ffffff;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
            }

        .form-label {
            font-weight: 600;
            color: #37474f;
        }

        h2 {
            font-weight: 700;
            color: #1e2a38;
        }

        button.btn-primary {
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
            background: linear-gradient(to right, #007bff, #00c6ff);
            border: none;
            transition: background 0.3s ease;
        }

            button.btn-primary:hover {
                background: linear-gradient(to right, #0056b3, #009acd);
            }

        select.form-control,
        input.form-control,
        textarea.form-control {
            border-radius: 8px;
            border: 1px solid #ced4da;
            transition: border-color 0.2s ease;
        }

            select.form-control:focus,
            input.form-control:focus,
            textarea.form-control:focus {
                border-color: #00bcd4;
                box-shadow: 0 0 0 0.1rem rgba(0, 188, 212, 0.25);
            }

        .container {
            max-width: 700px;
        }

        .preview-box {
            border: 1px dashed #ccc;
            padding: 20px;
            margin-top: 20px;
            background-color: #fffdf7;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.6;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card p-4">
            <h2 class="mb-4 text-center">Create Email Template</h2>

            <form method="post">
                <div class="mb-3">
                    <label for="templateName" class="form-label">Template Name</label>
                    <input type="text" id="templateName" class="form-control" asp-for="Template.TemplateName" required />
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <input type="text" id="category" class="form-control" asp-for="Template.Category" required />
                </div>
                <div class="mb-3">
                    <label for="subject" class="form-label">Subject</label>
                    <input type="text" id="subject" class="form-control" asp-for="Template.Subject" required />
                </div>
                <div class="mb-3">
                    <label for="emailBody" class="form-label">Body</label>
                    <textarea id="emailBody" class="form-control" asp-for="Template.Body" rows="5" required></textarea>
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" class="form-control" asp-for="Template.Status">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Save Template</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $("#templateCategory").change(function () {
                let category = $(this).val();
                $("#emailTemplate").empty().append('<option value="">-- Select Template --</option>');

                if (category) {
                    $.get('/EmailCompose?handler=Templates&category=' + category, function (data) {
                        data.forEach(function (template) {
                            $("#emailTemplate").append(`<option value="${template.id}" data-subject="${template.subject}" data-body="${template.body}">${template.templateName}</option>`);
                        });
                        $("#emailTemplate").append('<option value="insert">Insert Template</option>');
                    });
                }
            });
        });

        document.getElementById("emailBody").addEventListener("input", updatePreview);
        document.getElementById("subject").addEventListener("input", updatePreview);

        function updatePreview() {
            document.getElementById("previewSubject").innerText = document.getElementById("subject").value;
            document.getElementById("previewBody").innerHTML = document.getElementById("emailBody").value;
        }

        function insertPlaceholder() {
            var placeholder = document.getElementById("placeholders").value;
            var textarea = document.getElementById("emailBody");
            textarea.value += placeholder;
            updatePreview();
        }

        var isSuccess = "@Model.IsSuccess".toLowerCase() === "true";

        document.addEventListener("DOMContentLoaded", function () {
            if (isSuccess) {
                setTimeout(function () {
                    if (confirm("Email Template saved successfully!")) {
                        history.back();
                    }
                }, 100);
            }
        });
    </script>

</body>
</html>