@page
@model QD.ERP.Web.Pages.CreateTaskModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Alert Me!</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            font-family: Segoe UI, sans-serif;
            background-color: #e6ecf5;
        }

        .alert-window {
            max-width: 700px;
            margin: 40px auto;
            background: #dbe7f5;
            padding: 20px 25px;
            border: 1px solid #aec6e5;
            border-radius: 6px;
            box-shadow: 0 0 5px rgba(0,0,0,0.1);
        }

            .alert-window label {
                font-weight: 500;
                margin-bottom: 6px;
                color: #333;
            }

        .form-control, .form-select {
            font-size: 14px;
            background-color: #f5faff;
            border: 1px solid #aac6e0;
        }

        .form-check-label {
            font-weight: 500;
        }

        .header-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .btn {
            font-size: 14px;
            padding: 6px 14px;
        }

        .btn-icon {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .alert-btns {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .btn-delete {
            background-color: #d9534f;
            color: white;
        }

        .btn-back {
            background-color: #0275d8;
            color: white;
        }

        .btn-alert {
            background-color: #f7c63d;
            color: black;
            border: 1px solid #e5b530;
        }

        .btn-others {
            background-color: #87c26f;
            color: white;
        }
    </style>
</head>
<body>

    <div class="alert-window">
        <div class="header-title">Alert Me!</div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Alert Code:</label>
                <input id="alertCode" type="text" class="form-control" readonly>
            </div>
            <div class="col-md-6">
                <label>Alert Type:</label>
                <input type="text" class="form-control" value="Assignments" readonly>
            </div>
        </div>

        <div class="mb-3">
            <label>When do you want to be notified?</label>
            <div class="input-group">
                <input id="alertDate" type="datetime-local" class="form-control">
                <span class="input-group-text"><i class="bi bi-clock"></i></span>
            </div>
        </div>

        <div class="mb-3">
            <label>How do you want to be alerted?</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="alertSystem" checked>
                <label class="form-check-label" for="alertSystem">By System Alert</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="alertEmail" onchange="toggleEmailInput()">
                <label class="form-check-label" for="alertEmail">By Email</label>
            </div>
            <div id="emailContainer" class="mt-1" style="display: none;">
                <input id="emailInput" type="email" class="form-control" placeholder="Enter email address">
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="alertSMS" onchange="togglePhoneInput()">
                <label class="form-check-label" for="alertSMS">By SMS</label>
            </div>
            <div id="phoneContainer" class="mt-1" style="display: none;">
                <input id="phoneInput" type="text" class="form-control" placeholder="Enter phone number">
            </div>

        </div>

        <div class="mb-3">
            <label>Alert Message:</label>
            <textarea id="alertMessage" class="form-control" rows="4"></textarea>
        </div>

        <div class="d-flex justify-content-between mb-3">
            <button class="btn btn-alert btn-icon" onclick="alertMe()"><i class="bi bi-chat-left-dots"></i> Alert Me</button>
            <button class="btn btn-others btn-icon" onclick="loadUsers()"><i class="bi bi-people-fill"></i> Alert Others</button>
        </div>

        <div class="mb-3" id="userDropdownContainer" style="display:none">
            <label>Select User to Alert:</label>
            <select id="userSelect" class="form-select" onchange="alertOtherUser(this.value)"></select>
        </div>

        <div class="alert-btns">
            <button class="btn btn-delete btn-icon"><i class="bi bi-x-circle"></i> Delete</button>
            <button class="btn btn-back btn-icon"><i class="bi bi-arrow-left-circle"></i> Back</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        sessionStorage.setItem("UserId", '@HttpContext.Session.GetString("UserId")');
        async function fetchNextAlertCode() {
            try {
                const res = await fetch('/api/Alert/GetNextAlertCode');
                const data = await res.json();
                document.getElementById("alertCode").value = data.AlertCode || "AUTO001";
            } catch (err) {
                console.error("Error fetching alert code", err);
                document.getElementById("alertCode").value = "AUTO001";
            }
        }

               // 🔹 ALERT ME
        async function alertMe() {
            const userId = parseInt(sessionStorage.getItem("UserId") || "0");

            const payload = {
                AlertCode: document.getElementById("alertCode").value,
                AlertUserOn: document.getElementById("alertDate").value,
                AlertUserTime: document.getElementById("alertDate").value,
                AlertBySystem: document.getElementById("alertSystem").checked,
                AlertByEmail: document.getElementById("alertEmail").checked,
                AlertUserEmail: document.getElementById("emailInput").value,
                AlertBySms: document.getElementById("alertSMS").checked,
                AlertUserMobileNo: document.getElementById("phoneInput").value,
                AlertUserMessage: document.getElementById("alertMessage").value,
                AlertUserId: userId    // ✅ this is the logged-in user ID
            };

            const res = await fetch('/api/Alert/CreateTask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const result = await res.json();
            alert(result.message || "Alert created successfully");
        }



        async function loadUsers() {
            const res = await fetch('/api/Alert/GetAllUsers');
            const users = await res.json();

            const select = document.getElementById("userSelect");
            select.innerHTML = users.map(u => `<option value="${u.UserId}">${u.UserName}</option>`).join('');
            document.getElementById("userDropdownContainer").style.display = 'block';
        }

               // 🔹 ALERT OTHERS
        async function alertOtherUser(selectedUserId) {
            const userId = parseInt(selectedUserId || "0");

            const payload = {
                AlertCode: document.getElementById("alertCode").value,
                AlertUserOn: document.getElementById("alertDate").value,
                AlertUserTime: document.getElementById("alertDate").value,
                AlertUserId: userId,   // ✅ this is the user you selected
                AlertBySystem: document.getElementById("alertSystem").checked,
                AlertByEmail: document.getElementById("alertEmail").checked,
                AlertUserEmail: document.getElementById("emailInput").value,
                AlertBySms: document.getElementById("alertSMS").checked,
                AlertUserMobileNo: document.getElementById("phoneInput").value,
                AlertUserMessage: document.getElementById("alertMessage").value
            };

            const res = await fetch('/api/Alert/CreateTask', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const result = await res.json();
            alert(result.message || "Alert sent to user successfully");
        }


        fetchNextAlertCode();


             function toggleEmailInput() {
            const emailChecked = document.getElementById("alertEmail").checked;
            document.getElementById("emailContainer").style.display = emailChecked ? "block" : "none";
        }

        function togglePhoneInput() {
            const phoneChecked = document.getElementById("alertSMS").checked;
            document.getElementById("phoneContainer").style.display = phoneChecked ? "block" : "none";
        }
    </script>
</body>
</html>
