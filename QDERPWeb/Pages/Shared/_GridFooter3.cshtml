
<style type="text/css">
    #reportsByClientPopup .dx-overlay-content {
        max-width: 90vw !important; /* Adjust width */
        max-height: 85vh !important; /* Adjust height */
        overflow: hidden !important;
    }

    /* Style for inner iframe */
    #popupIframe {
        border-radius: 8px;
        padding: 10px;
        overflow: auto;
    }

    .dx-popup-content{
        padding:0px;
    }

    /* Hide outer scrollbar */
    body {
        overflow: hidden;
    }
    #dataGrid .dx-datagrid-headers .dx-datagrid-action {
        text-align: center !important;
    }

    #dataGrid .dx-datagrid-headers .dx-cell-focus-disabled {
        text-align: center !important;
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
        margin-top: 0px;
    }

    .button-alignment-down {
        margin-top: 23px;
    }

    .button-group {
        margin-left: -10px !important;
    }

    /* Custom styles for context menu */
    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        z-index: 1000;
    }

    .context-menu-item {
        padding: 0px, 15px,10px 15px;
        cursor: pointer;
    }

    .ledgerResult {
        margin: 15px !important;
    }

    #rowHeightMenu {
        position: absolute;
        top: 100px; /* Adjust positioning as per your design */
        left: 300px; /* Adjust positioning as per your design */
        display: none; /* Keep it hidden until needed */
    }

</style>
<div class="dx-fieldset horizontal-container">

    @* <div id="ddButtonLayout"></div> *@
    <div class="btn-container">
    @(Html.DevExtreme().Button()
        .ID("btnRefresh")
        .Text(new JS("formatMessage('Refresh')"))
        .Type(ButtonType.Normal)
        .StylingMode(ButtonStylingMode.Outlined)
        .Icon("refresh")
        .Width("100%")
        .OnClick("function() { refreshPage(); }")
        )
    </div>
    <div class="btn-container">
    @(Html.DevExtreme().DropDownButton()
        .ID("ddButtonLayout")
        .Text(new JS("formatMessage('Layout')"))
        .Icon("smalliconslayout")
        .Width("100%")
        .DropDownOptions(options => options.Width(230))
        .Items(items =>
        {
            items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
            items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
            items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
            items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
        })
        .ShowArrowIcon(true)

        @* .OnItemClick("addRecipitsButton_click") *@

        )
        </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
                .ID("rowHeightProperties")
                .Icon("") // fallback to standard icon if "rowproperties" not working
                .Width("100%")
                .Text(new JS("formatMessage('Set Row Height')"))
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                items.Add()
                .Text("Short (1 Line)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="9" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Short
                           </text>)
                .OnClick("function() { ChangeRowHeight('30'); }");
                items.Add()
                .Text("Medium (2 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="6" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Medium
                           </text>)
                .OnClick("function() { ChangeRowHeight('60'); }");
                items.Add()
                .Text("Tall (4 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="4" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="8" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="16" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Tall
                           </text>)
                .OnClick("function() { ChangeRowHeight('90'); }");
                items.Add()
                .Text("Extra Tall (8 Lines)")
                .Template(@<text>
            <svg width="20" height="20" viewBox="0 0 20 20">
                @for (var i = 1; i <= 8; i++)
                        {
                            var y = 1 + (i - 1) * 2;
                            <text><rect x="2" y="@y" width="16" height="1" fill="var(--title-background-color)" /></text>
                        }
            </svg> Extra Tall
        </text>)
                .OnClick("function() { ChangeRowHeight('130'); }");
                })
                .ShowArrowIcon(false))
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnPrint")
            .Text(new JS("formatMessage('Print')"))
            .Icon("print")
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Width("100%")
            .OnClick("function() { exportDataGridToPDF('dataGrid'); }")
            )
    </div>

    <div class="btn-container">
    @(Html.DevExtreme().Button()
        .ID("btnToggleSearch")
        .Text(new JS("formatMessage('Search')"))
        .Type(ButtonType.Normal)
        .StylingMode(ButtonStylingMode.Outlined)
        .Icon("search")
        .Width("100%")
        .OnClick("function() { toggleFilterRow(); }")
        )
        </div>
    <div class="btn-container">
    @(Html.DevExtreme().Button()
        .ID("btntoggleGroupPanel")
        .Text(new JS("formatMessage('Group')"))
        .Type(ButtonType.Normal)
        .StylingMode(ButtonStylingMode.Outlined)
        .Icon("hierarchy")
        .Width("100%")
        .OnClick("toggleGroupPanel")
        )
</div>
    <div class="btn-container">



        @(
                Html.DevExtreme().DropDownButton()
                .ID("btntoggleReport")
                .Text(new JS("formatMessage('Report')"))
                .Icon("textdocument")
                .Width("100%")
                .DropDownOptions(options => options.Width(350))
                .Items(items =>
                {
                    items.Add().Text(new JS("formatMessage('Receivables Reports')")).Icon("textdocument");
                    items.Add().Text(new JS("formatMessage('Receivables Reports with Effective Date')")).Icon("textdocument");
                    items.Add().Text(new JS("formatMessage('Ageing Reports')")).Icon("textdocument").OnClick("showSubmenu1");
                    items.Add().Text(new JS("formatMessage('Receivables Summary Reports')")).Icon("textdocument");

                    items.Add().Text(new JS("formatMessage('Receivables By Client')")).Icon("taskcomplete").OnClick("ReportsByClient");
                    items.Add().Text(new JS("formatMessage('Receivables By Sales Person')")).Icon("taskcomplete").OnClick("ReportsByClient");
                    items.Add().Text(new JS("formatMessage('Receivables By Branch/ Division')")).Icon("taskcomplete").OnClick("ReportsByClient");



                    items.Add().Text(new JS("formatMessage('Invoice Collection Report')")).Icon("event");
                    items.Add().Text(new JS("formatMessage('Receivables with unmapped Vouchers')"))
                        .Icon("optionsgear")
                        .OnClick("function() { Mapping('Receivables with unmapped Vouchers'); }");
                })
        .ShowArrowIcon(true)
        .OnItemClick("handleReportsClick") 
        )
      
</div>
   
</div>
<script type="text/javascript">




    // Hide context menu on click outside
    $(document).on("click", function () {
        var contextMenu = $("#contextMenu");
        contextMenu.hide();
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
        var $submenu = $('#submenuContainer1');
        $submenu.hide(); // Hide the submenu popup
    });


    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });
    function saveLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var layout = grid.state();
        const layoutJson = JSON.stringify(layout, null, 2); // Pretty-print JSON
        //console.log(layoutJson);
        // Create a Blob from the JSON string
        const blob = new Blob([layoutJson], { type: "application/json" });
        // Create a URL for the Blob
        const url = URL.createObjectURL(blob);
        // Create a link element
        const a = document.createElement("a");
        a.href = url;
        a.download = "grid-layout.json"; // Set the file name for download
        // Append the link to the body (needed for Firefox)
        document.body.appendChild(a);
        // Programmatically click the link to trigger the download
        a.click();
        // Clean up by removing the link and revoking the Object URL
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        //DevExpress.ui.notify("Layout", "success", 600);
    }
    function openLayoutClick(e) {
        $("#loadLayoutInput").click();
    }

    function loadGridState() {
        var form = $('#formId').val();
        // Call the API to get the grid state
        $.ajax({
            url: `/api/Utility/LoadLayout`, // Adjust to your actual API endpoint
            method: 'GET',
            data: {
                form: form
            },
            success: function (response) {
                // Get the DataGrid instance
                var dataGrid = $("#dataGrid").dxDataGrid("instance");

                // Load the state into the DataGrid
                if (response) {
                    try {
                        // Parse the JSON string from the file
                        const layout = JSON.parse(response);

                        // Restore the grid state
                        dataGrid.state(layout);
                    } catch (error) {
                        console.error("Error parsing JSON:", error);
                        alert("Failed to load layout. Please ensure the JSON is valid.");
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading grid state:", error);
            }
        });
    }
    function setDefaultLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var form = $('#formId').val();
        var layout = grid.state();
        const layoutJson = JSON.stringify(layout, null, 2);
        console.log(layoutJson);

        $.ajax({
            url: '/api/Utility/SaveLayout',  // API endpoint
            type: 'POST',
            data: {
                layout: layoutJson,
                form: form
            },
            success: function (data) {
                DevExpress.ui.notify("Layout saved successfully", "success", 2000);
            },
            error: function () {
                DevExpress.ui.notify("Error while saving data", "error", 2000);
            }
        });
    }
    function resetLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var form = $('#formId').val();
        $.ajax({
            url: '/api/Utility/SaveLayout',  // API endpoint
            type: 'POST',
            data: {
                layout: null,
                form: form
            },
            success: function (data) {
                DevExpress.ui.notify("Layout reset successfull", "success", 2000);
                grid.state({});
            },
            error: function () {
                DevExpress.ui.notify("Error while saving data", "error", 2000);
            }
        });
    }
    // Footer Group Pannel button click event
    function toggleGroupPanel() {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var isVisible = dataGrid.option("groupPanel.visible");
        dataGrid.option("groupPanel.visible", !isVisible);
    }
    // Footer Filter row button click event
    function toggleFilterRow() {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var currentVisibility = grid.option("filterRow.visible");

        grid.option("filterRow.visible", !currentVisibility); // Toggle FilterRow visibility
    }
    // Footer Recipits button event
    function addRecipitsButton_click(e) {
        DevExpress.ui.notify(e.itemData, "success", 600);
    }
    function addReportsButton_click(e) {
        DevExpress.ui.notify(e.itemData, "success", 600);
    }
    function ChangeRowHeight(newHeight) {
        // Update the row height
        $("#dataGrid .dx-data-row").css("height", newHeight + "px");
        closeSubmenu();
    }
    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function showSubmenu1(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer1');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 380,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function closeSubmenu() {
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
        var $submenu = $('#submenuContainer1');
        $submenu.hide(); // Hide the submenu popup
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });



   
    //Refresh button function
    function refreshPage() {
        location.reload(); 
    }
    function ReportsByClient() {
        alert("hi")
        let url = `/${tenantName}/Finance/ReportsByClients`; 

        
        $("#popupIframe").attr("src", url);

        // Open the popup
        let popup = $("#reportsByClientPopup").dxPopup("instance");
        popup.show();
    }
        const reportMappings = {
        "Receivables Reports": "BillsRecivableReport1",
        "Receivables Reports with Effective Date": "ReceivableReport(EffectiveDate)",
        "Receivables Summary Reports": "Summary",
        "Invoice Collection Report": "InvoiceCollectionReport",
        "Receivables with Unmapped Vouchers": "ReceivablesUnmappedVouchersReport"
    };

    function handleReportsClick(e) {
        const selectedText = e.itemData.text;

        // Check if report exists in mappings
        if (reportMappings[selectedText]) {
            const reportName = reportMappings[selectedText];
            console.log(`Opening report: ${reportName}`);

            // Open Document Viewer without parameters
            window.open(`/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}`, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
        } else {
            console.warn('No report mapping found for:', selectedText);
        }
    }

 

    $(function () {
        // Initialize DevExtreme Popup
        $("#reportsByClientPopup").dxPopup({
            width: 600,
            height: 750,
            title: "Reports by Clients",
            visible: false,
            showCloseButton: true,
            closeOnOutsideClick: true,
            shading: true, // Ensures a modal effect
            dragEnabled: false, // Prevent resizing
            resizeEnabled: false,
            contentTemplate: function () {
                return $("<iframe>", {
                    id: "popupIframe",
                    width: "600px",
                    height: "750px",
                    frameborder: 0,
                    
                }).css({
                    overflow: "hidden",
                    border: "none",
                    display: "block" // Ensures no extra margins
                });
            }
        });

      
    });
    function Mapping(reportKey) {
        alert('hi');
        if (reportKey === "Receivables with unmapped Vouchers") {
            window.location.href = `/${tenantName}/Finance/MappingBillsReceivable`;
        } else {
            console.warn('No report mapping found for:', reportKey);
        }
    }
     $(function () {
