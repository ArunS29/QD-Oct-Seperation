    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {

                    const layout = JSON.parse(e.target.result);


                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };


            reader.readAsText(file);
        }
    });

    const reportMappings = {
        "Summary Report": "SummaryReport",
        "Summary Report (By Date)": "SummaryReportByDate",
        "Cost Center Report": "CostCenterReport",
        "Cost Center Report (By Date)": "CostCenterReportByDate",
        "Cost Center Group Report": "CostCenterGroupReport",
        "Cost Center Group Report (By Date)": "CostCenterGroupReportByDate",
        "Detailed Report":"DetailReport",
         "Detailed Report (By Date)":"DetailedBydate",
          "Detailed Group Report":"DetailedGroup",
           "Detailed Group Report (By Date)":"detailGroupBydate",
           "Cost Center Master Report":"CostCenterMasterGroup",
           "Cost Center Master Report (By Date)":"detailedMasterByDate"

    };



    function handleReportsClick(e) {
        // Use reportName property from itemData instead of reportMappings
        const reportName = e.itemData.reportName;

        // Get instances of SelectBox and DateBox components
        var dropDownBox = $("#requestedBy").dxDropDownBox("instance");
        var requestedBy = dropDownBox.option("value");

        var frmDateBox = $("#frmdateBox").dxDateBox("instance");
        var toDateBox = $("#todateBox").dxDateBox("instance");

        var frmDate = frmDateBox.option("value");
        var toDate = toDateBox.option("value");
        var useEffectiveDate = $("#useEffectiveDate").dxCheckBox("instance").option("value");

        // Validate required fields
        if (!frmDate || !toDate) {
            alert("Please select both start and end dates.");
            return;
        }

        // Format date as D-MMM-YYYY
        function formatDate(date) {
            let dateObj = new Date(date);
            let day = dateObj.getDate();
            let month = dateObj.toLocaleString('en-US', { month: 'short' });
            let year = dateObj.getFullYear();
            return `${day}-${month}-${year}`;
        }

        var frmDateStr = formatDate(frmDate);
        var toDateStr = formatDate(toDate);

        if (reportName) {
            // Construct the URL with frmDate and toDate (always required)
            let url = `/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}`;

            // Append requestedBy only if selected
            if (requestedBy && requestedBy !== '') {
                url += `&requestedBy=${encodeURIComponent(requestedBy)}`;
            }
              const screenWidth = window.screen.availWidth;
               const screenHeight = window.screen.availHeight;
            url += `&useEffectiveDate=${useEffectiveDate}`;
            window.open(
                url,
                '_blank',
                `top=0,left=0,width=${screenWidth},height=${screenHeight},scrollbars=yes,resizable=yes`
            );
        } else {
            console.warn('No report mapping found for:', e.itemData.text);
        }
    }



        function printGrid() {
        const gridContainer = $("#costcenter-datagrid").closest('.some-container');
        const wasHidden = gridContainer.is(":hidden");
        if (wasHidden) {
            gridContainer.show();
        }
        exportPivotGridToPDF('costcenter-datagrid');
        if (wasHidden) {
            gridContainer.hide();
        }
    }
