<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style type="text/css">
    .dx-button {
        background-color: whitesmoke;
    }



    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
        margin-top: 0px;
    }

    .button-alignment-down {
        margin-top: 23px;
    }

    .button-group {
        margin-left: -10px !important;
    }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
        margin-bottom: 50px;
    }
    /* Custom styles for context menu */
    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        border: 1px solid #ccc;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

    .context-menu-item {
        padding: 0px, 15px,10px 15px;
        cursor: pointer;
    }

    .ledgerResult {
        margin: 15px !important;
    }

    #rowHeightMenu {
        position: absolute;
        top: 100px; /* Adjust positioning as per your design */
        left: 300px; /* Adjust positioning as per your design */
        display: none; /* Keep it hidden until needed */
    }

    .btn-container {
        display: inline-block;
        position: relative;
        overflow: hidden;
    }

        /* Initially hide the button text and set a fixed small width */
        .btn-container .dx-button {
            width: 40px !important; /* Small width for icons */
            transition: width 0.3s ease-in-out;
        }

        /* Show full text when hovered */
        .btn-container:hover .dx-button {
            width: 200px !important; /* Expand to fit text */
        }

        /* Initially hide text */
        .btn-container .dx-button .dx-button-text {
            display: none;
        }

        /* Show text on hover */
        .btn-container:hover .dx-button .dx-button-text {
            display: inline-block;
        }

        /* Ensure dropdown button behaves similarly */
        .btn-container .dx-dropdownbutton {
            width: 75px !important;
            transition: width 0.3s ease-in-out;
        }

        .btn-container:hover .dx-dropdownbutton {
            width: 180px !important; /* Adjust as needed */
        }

        .btn-container .dx-dropdownbutton .dx-button-text {
            display: none;
        }

        .btn-container:hover .dx-dropdownbutton .dx-button-text {
            display: inline-block;
        }
</style>

<div class="dx-fieldset horizontal-container">
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddLayoutOptions")
            .Icon("smalliconslayout")
            .Text("Layout")
            .DropDownOptions(d => d.Width(200))
            .Items(items =>
            {
                items.Add().Text("Print Layout 1").Icon("print").OnClick("showSubmenu");
                items.Add().Text("Print Layout 2").Icon("print").OnClick("onPrintLayout2");
                items.Add().Text("Show Fields").Icon("hierarchy").OnClick("onShowFields");
                items.Add().Text("Show Row Totals").Icon("hierarchy").OnClick("onShowRowTotals");
            })
            )

    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnPrint")
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("print")
            .Text("Print")
            )

    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnShowFields")
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("hierarchy")
            .Text("Show Fields")
            )

    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnShowRowTotals")
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("hierarchy")
            .Text("Show Row Totals")

            )

    </div>


</div>

<script type="text/javascript">
          function onPrintLayout1(e) {
        // Logic for first print button
        console.log("Print Layout 1 clicked");
    }

    function onPrintLayout2(e) {
        // Logic for second print button
        console.log("Print Layout 2 clicked");
    }

    function onShowFields(e) {
        // Logic to show fields
        console.log("Show Fields clicked");
    }

    function onShowRowTotals(e) {
        // Logic to show row totals
        console.log("Show Row Totals clicked");
    }


    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content');
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();

        // Position submenu with a slight margin (e.g., 5px)
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth + 5, // Add margin
            'display': 'block'
        });
    }

    function closeSubmenu() {
        $("#submenuContainer").hide();
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {

                    const layout = JSON.parse(e.target.result);


                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };


            reader.readAsText(file);
        }
    });
</script>
