<script type="text/javascript">
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });
    // Convert JS object to XML string
    function sanitizeXmlTagName(name) {
        let safeName = name.replace(/[^a-zA-Z0-9_\-]/g, "_");
        if (/^[^a-zA-Z_]/.test(safeName)) {
            safeName = "_" + safeName;
        }
        return safeName;
    }

    function objectToXml(obj, rootName) {
        let xml = `<${sanitizeXmlTagName(rootName)} originalName="${rootName}">`;
        for (let prop in obj) {
            if (!obj.hasOwnProperty(prop)) continue;
            let value = obj[prop];

            // Skip undefined or null
            if (value === undefined || value === null) continue;

            if (Array.isArray(value)) {
                xml += `<${sanitizeXmlTagName(prop)} originalName="${prop}">` +
                    value.map(item => objectToXml(item, 'item')).join('') +
                    `</${sanitizeXmlTagName(prop)}>`;
            } else if (typeof value === "object") {
                xml += objectToXml(value, prop);
            } else {
                xml += `<${sanitizeXmlTagName(prop)} originalName="${prop}">${String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")}</${sanitizeXmlTagName(prop)}>`;
            }
        }
        xml += `</${sanitizeXmlTagName(rootName)}>`;
        return xml;
    }

    function xmlToObject(xml) {
        if (xml.children.length === 0) {
            let text = xml.textContent;
            if (text === "true") return true;
            if (text === "false") return false;
            if (text === "" || text === null) return undefined;
            if (!isNaN(text) && text.trim() !== "") return Number(text);
            return text;
        }

        const isItem = (el) => el.nodeName === "item";
        let obj = {};

        for (let child of xml.children) {
            const key = child.getAttribute("originalName") || child.nodeName;
            const val = xmlToObject(child);

            if (key === "item") {
                if (!Array.isArray(obj)) obj = [];
                obj.push(val);
            } else {
                if (obj.hasOwnProperty(key)) {
                    if (!Array.isArray(obj[key])) obj[key] = [obj[key]];
                    obj[key].push(val);
                } else {
                    obj[key] = val;
                }
            }
        }

        return obj;
    }
    // Save as default layout
     function setDefaultLayoutClick() {
         const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
         const form = $('#formId').val();

         if (!pivotGrid) {
             DevExpress.ui.notify("Grid not found", "error", 2000);
             return;
         }

         // Include expanded paths in state
         const state = pivotGrid.getDataSource().state();
         state.rowExpandedPaths = pivotGrid.getDataSource()._descriptions.rows.expandedPaths || [];
         state.columnExpandedPaths = pivotGrid.getDataSource()._descriptions.columns.expandedPaths || [];

         const layoutXml = objectToXml(state, "Layout");

         $.ajax({
             url: '/api/Utility/SaveLayout',
             type: 'POST',
             contentType: 'application/json',
             data: JSON.stringify({
                 layout: layoutXml,
                 form: form
             }),
             success: function () {
                 DevExpress.ui.notify("Default layout saved", "success", 2000);
             },
             error: function (xhr) {
                 console.error("SaveLayout error:", xhr.responseText);
                 DevExpress.ui.notify("Error while saving layout", "error", 2000);
             }
         });
     }

     // Reset layout
     function resetLayoutClick() {
         const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
         const form = $('#formId').val();

         $.ajax({
             url: '/api/Utility/SaveLayout',
             type: 'POST',
             contentType: 'application/json',
             data: JSON.stringify({
                 layout: null,
                 form: form
             }),
             success: function () {
                 DevExpress.ui.notify("Layout reset successful", "success", 2000);
                 pivotGrid.getDataSource().state({});
             },
             error: function (xhr) {
                 console.error(xhr.responseText);
                 DevExpress.ui.notify("Error while resetting layout", "error", 2000);
             }
         });
     }

     // Download layout
     function saveLayoutClick() {
         const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
         const state = pivotGrid.getDataSource().state();
         state.rowExpandedPaths = pivotGrid.getDataSource()._descriptions.rows.expandedPaths || [];
         state.columnExpandedPaths = pivotGrid.getDataSource()._descriptions.columns.expandedPaths || [];

         const layoutXml = objectToXml(state, "Layout");

         const blob = new Blob([layoutXml], { type: "application/xml" });
         const url = URL.createObjectURL(blob);
         const a = document.createElement("a");
         a.href = url;
         a.download = "pivotgrid-layout.xml";
         document.body.appendChild(a);
         a.click();
         document.body.removeChild(a);
         URL.revokeObjectURL(url);
     }

     // Open layout from file
     function openLayoutClick() {
         const input = document.createElement("input");
         input.type = "file";
         input.accept = "application/xml";

         input.addEventListener("change", function (event) {
             const file = event.target.files[0];
             if (!file) return;

             const reader = new FileReader();
             reader.onload = function (e) {
                 try {
                     const parser = new DOMParser();
                     const xmlDoc = parser.parseFromString(e.target.result, "application/xml");
                     let layoutObj = xmlToObject(xmlDoc.documentElement);
                     layoutObj = JSON.parse(JSON.stringify(layoutObj));
                     const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");
                     pivotGrid.getDataSource().state(layoutObj);
                 } catch (error) {
                     DevExpress.ui.notify("Invalid layout file!", "error", 600);
                 }
             };

             reader.readAsText(file);
         });

         input.click();
     }

     // Load default layout on page ready
     $(document).ready(function () {
         const pivotGrid = $("#pivotGridContainer").dxPivotGrid({
             // ... your pivot grid config
             onContentReady: function (e) {
                 // Load layout only once on first render
                 if (!e.component.__layoutLoaded) {
                     loadGridState();
                     e.component.__layoutLoaded = true;
                 }
             }
         }).dxPivotGrid("instance");
     });

     function loadGridState() {
         const form = $('#formId').val();

         $.ajax({
             url: `/api/Utility/LoadLayout`,
             method: 'GET',
             data: { form: form },
             success: function (response) {
                 const pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");

                 if (response) {
                     try {
                         const parser = new DOMParser();
                         const xmlDoc = parser.parseFromString(response, "application/xml");
                         let layoutObj = xmlToObject(xmlDoc.documentElement);

                         if (layoutObj.fields && Array.isArray(layoutObj.fields)) {
                             layoutObj.fields.sort((a, b) => {
                                 const aIndex = Number(a.areaIndex ?? 0);
                                 const bIndex = Number(b.areaIndex ?? 0);
                                 return aIndex - bIndex;
                             });
                         }

                         pivotGrid.getDataSource().state(layoutObj);
                     } catch (error) {
                         console.error("Error parsing layout XML:", error);
                     }
                 }
             },
             error: function (xhr, status, error) {
                 console.error("Error loading grid layout:", error);
             }
         });
     }
           function exportPivotToPdfExact() {
        var pivotGrid = $("#pivotGridContainer").dxPivotGrid("instance");

        DevExpress.pdfExporter.exportPivotGrid({
            component: pivotGrid,
            fileName: "PivotGrid.pdf",
            filterable: true,             // include filtering if used
            autoFilterEnabled: true,
            keepColumnWidths: true,       // keeps same column widths as on screen
            loadPanel: { enabled: false }, // hide loading panel
            customizeCell: function(options) {
                // Customize header cells
                if (options.area === "column" || options.area === "row") {
                    options.backgroundColor = "#f0f0f0";
                    options.font = { bold: true };
                    options.borderColor = "#d0d0d0";
                }

                // Customize data cells
                if (options.area === "data") {
                    options.font = { bold: false };
                    options.borderColor = "#d0d0d0";
                }

                // Customize total / grand total cells
                if (options.total || options.grandTotal) {
                    options.font = { bold: true };
                    options.backgroundColor = "#d9edf7";
                }
            }
        }).then(function() {
            DevExpress.ui.notify("PivotGrid exported to PDF successfully", "success", 2000);
        }).catch(function(err) {
            console.error("Export error:", err);
            DevExpress.ui.notify("Export failed", "error", 2000);
        });
    }


</script>
