    </div>
    <div class="btn-container">
    @(Html.DevExtreme().Button()
        .ID("btntoggleGroupPanel")
        .Text(new JS("formatMessage('Group')"))
        .Type(ButtonType.Normal)
        .StylingMode(ButtonStylingMode.Outlined)
        .Icon("hierarchy")
        .Width("100%")
        .OnClick("toggleGroupPanel")
        )
    </div>
     <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnToggleHeaderFilter")

            .Text(new JS("formatMessage('Toggle Filter')"))
            @* .Icon("filter") *@
            .OnClick("toggleHeaderFilter")
