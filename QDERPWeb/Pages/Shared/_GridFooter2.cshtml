    const reportMappings = {
        "Bills Payable": "BIllsPayable",
        "Payable Summary": "PayableSummary",
        
        "Bills Payable with Unmapped Vouchers": "BillsPayableUnmapped"
    };

    function handleReportClick(e) {
        const selectedText = e.itemData.text;
        const reportName = reportMappings[selectedText];

        if (reportName) {
            console.log(`Opening report: ${reportName}`);

            // Ensure tenantName is defined before using
            if (typeof tenantName === "undefined") {
                console.error("tenantName is not defined.");
                return;
            }

            window.open(`/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}`, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
        } else {
            console.warn('No report mapping found for:', selectedText);
        }
    }



    $(function () {
        $("#reportsByClientPopup").dxPopup({
            width: 600,
            height: 750,
            title: "Reports by Clients",
            visible: false,
            showCloseButton: true,
            closeOnOutsideClick: true,
            shading: true, // Ensures a modal effect
            dragEnabled: false, // Prevent resizing
            resizeEnabled: false,
            contentTemplate: function () {
                return $("<iframe>", {
                    id: "popupIframe",
                    width: "600px",
                    height: "750px",
                    frameborder: 0,

                }).css({
                    overflow: "hidden",
                    border: "none",
                    display: "block" // Ensures no extra margins
                });
            }
        });


    })
</script>
