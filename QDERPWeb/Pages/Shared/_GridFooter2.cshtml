
<style type="text/css">
    #dataGrid .dx-datagrid-headers .dx-datagrid-action {
        text-align: center !important;
    }

    #dataGrid .dx-datagrid-headers .dx-cell-focus-disabled {
        text-align: center !important;
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
        margin-top: 0px;
    }

    .button-alignment-down {
        margin-top: 23px;
        
    }

    .button-group {
        margin-left: -10px !important;
    }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc; /* Border between rows */
    }
    /* Custom styles for context menu */
    .context-menu {
        display: none;
        position: absolute;
        background-color: white;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

    .context-menu-item {
        padding: 0px, 15px,10px 15px;
        cursor: pointer;
    }

    .ledgerResult {
        margin: 15px !important;
    }
    #rowHeightMenu {
        position: absolute;
        top: 100px; /* Adjust positioning as per your design */
        left: 300px; /* Adjust positioning as per your design */
        display: none; /* Keep it hidden until needed */
    }

</style>
<div class="dx-fieldset horizontal-container">

    @* <div id="ddButtonLayout"></div> *@
<div class="btn-container">
    @(Html.DevExtreme().Button()
    .ID("btnRefresh")
    .Text(new JS("formatMessage('Refresh')"))
    .Type(ButtonType.Normal)
    .StylingMode(ButtonStylingMode.Outlined)
    .Icon("refresh")
    .Width("100%")
    .OnClick("function() { refreshPage(); }")
            )
    </div>
    <div class="btn-container">
    @(Html.DevExtreme().DropDownButton()
        .ID("ddButtonLayout")
        .Text(new JS("formatMessage('Layout')"))
        .Icon("smalliconslayout")
        .Width("100%")
        .DropDownOptions(options => options.Width(230))
        .Items(items =>
        {
            items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
            items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
            items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
            items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
        })
        .ShowArrowIcon(true)

        @* .OnItemClick("addRecipitsButton_click") *@

        )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
                .ID("rowHeightProperties")
                .Icon("") // fallback to standard icon if "rowproperties" not working
                .Width("100%")
                .Text(new JS("formatMessage('Set Row Height')"))
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                items.Add()
                .Text("Short (1 Line)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="9" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Short
                           </text>)
                .OnClick("function() { ChangeRowHeight('30'); }");
                items.Add()
                .Text("Medium (2 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="6" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Medium
                           </text>)
                .OnClick("function() { ChangeRowHeight('60'); }");
                items.Add()
                .Text("Tall (4 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="4" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="8" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="16" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Tall
                           </text>)
                .OnClick("function() { ChangeRowHeight('90'); }");
                items.Add()
                .Text("Extra Tall (8 Lines)")
                .Template(@<text>
            <svg width="20" height="20" viewBox="0 0 20 20">
                @for (var i = 1; i <= 8; i++)
                        {
                            var y = 1 + (i - 1) * 2;
                            <text><rect x="2" y="@y" width="16" height="1" fill="var(--title-background-color)" /></text>
                        }
            </svg> Extra Tall
        </text>)
                .OnClick("function() { ChangeRowHeight('130'); }");
                })
                .ShowArrowIcon(false))
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnPrint")
            .Text(new JS("formatMessage('Print')"))
            .Icon("print")
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Width("100%")
            .OnClick("function() { exportDataGridToPDF('dataGrid'); }")
