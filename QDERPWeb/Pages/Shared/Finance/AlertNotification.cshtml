@using DevExtreme.AspNet.Mvc
@{
    var alertItems = new[] {
        new { Id = "company", Label = "Company Documents" },
        new { Id = "hr", Label = "HR Documents" },
        new { Id = "equipment", Label = "Equipment Documents" }
    };
}

@foreach (var item in alertItems)
{
    <div style="border: 1px solid #8ea5c2; background-color: #d8e4f0; border-radius: 5px; padding: 15px; margin-bottom: 15px; max-width: 800px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <img src="https://cdn-icons-png.flaticon.com/512/1827/1827375.png"
                 alt="bell"
                 style="width: 32px; height: 32px;" />

            @(Html.DevExtreme().Button()
                .Text($"Remove Alert Notification for {item.Label}")
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Outlined)
                .ID($"removeAlert_{item.Id}")
                .Width(350)
                )
        </div>
        <div style="margin-top: 10px; font-weight: 500; color: #1d3c8d; font-size: 15px;">
            This User Account is set to receive Popup Notification on Expiry of <strong>@item.Label</strong>.
        </div>
    </div>
}
