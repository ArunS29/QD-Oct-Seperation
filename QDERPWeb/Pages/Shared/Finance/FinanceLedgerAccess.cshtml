<!-- Dropdown Header -->
<div style="margin-bottom: 15px;">
    @(Html.DevExtreme().DropDownBox()
        .ID("screenSelector11")
        .Label("select the Ledger Account to Block Access:")
        .LabelMode(EditorLabelMode.Floating)
        .ShowClearButton(true) // Optional: show clear button
        .Width(300)
        )
</div>


<!-- ERP Master Grid -->
<div><h4 style="color:red">
    This User Account Will Not be able to View Ledger Transactios of these Ledger
</h4></div>
<div id="erpMasterGridContainer">
    @(Html.DevExtreme().DataGrid()
        .ID("erpMasterGrid11")
        .SearchPanel(s => s.Visible(false)
        .HighlightSearchText(true))
        .FilterRow(f => f.Visible(false))
        .HeaderFilter(h => h.Visible(false))
        .ShowBorders(true)
    
        .ColumnAutoWidth(true)
        .HoverStateEnabled(true)
        .Height(600)
        .Columns(columns =>
        {
            columns.Add().DataField("AccountId").Caption("Account Id");
            columns.Add().DataField("AccountHead").Caption("Account Head");
            columns.Add().DataField("AccountGroup").Caption("Account Group");
            columns.Add().DataField("UserId").Caption("User Id");

        })
        )
</div>



