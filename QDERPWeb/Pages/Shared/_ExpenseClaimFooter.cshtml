        function addReportsButton_click(e) {
            let pageUrl = '';
            let selectedText = e.itemData.text;

            switch (selectedText) {
                case (formatMessage('Ledger to Salary Payable Mapping')):
                    var accountDropDown = $("#accountDropDownBox").dxDropDownBox("instance");
                    var selectedAccountId = accountDropDown.option("value");

                    if (!selectedAccountId) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Please select the Account to Review',
                            text: 'You need to select an account before proceeding.',
                            confirmButtonText: 'OK'
                        });
                        return;
                    }

                    // Load full item from DataSource
                    var dataSource = accountDropDown.getDataSource();
                    dataSource.load().done(function (items) {
                        var selectedItem = items.find(x => x.AccountId === selectedAccountId);

                        if (!selectedItem) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Account not found',
                                text: 'Please reselect the account.',
                                confirmButtonText: 'OK'
                            });
                            return;
                        }

                        var frmDate = $("#frmdateBox").dxDateBox("instance").option("value");
                        var toDate = $("#todateBox").dxDateBox("instance").option("value");

                        var formattedFromDate = frmDate;
                        var formattedToDate = toDate;

                        var acchedid = selectedItem.AccountId;
                        var accheadname = selectedItem.AccountHead;

                        // ✅ Construct the URL
                        var pageUrl = `/${tenantName}/Finance/SalaryPayableMapping?acchedid=${encodeURIComponent(acchedid)}&accheadname=${encodeURIComponent(accheadname)}&FromDate=${encodeURIComponent(formattedFromDate)}&ToDate=${encodeURIComponent(formattedToDate)}`;

                        // ✅ Open the modal with the page URL
                        if (pageUrl) {
                            openModal(pageUrl, selectedText);
                        }
                    });
                    break;

                case (formatMessage('Ledger to Receivable/Payable Mapping')):
                    if (typeof acchedid !== 'undefined' && typeof accheadname !== 'undefined') {
                        pageUrl = `/${tenantName}/Finance/LedgerToSubLedgerMapping?acchedid=${encodeURIComponent(acchedid)}&accheadname=${encodeURIComponent(accheadname)}&accid=${encodeURIComponent(accid)}&FromDate=${encodeURIComponent(FromDate)}&ToDate=${encodeURIComponent(ToDate)}`;
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Please select the Account to Review',
                            text: 'You need to select an account before proceeding.',
                            confirmButtonText: 'OK'
                        });
                        return;
                    }
                    break;

                case (formatMessage('Bank Reconciliation')):
                    if (typeof acchedid !== 'undefined' && typeof accheadname !== 'undefined') {
                        pageUrl = `/${tenantName}/Finance/BankReconciliation?acchedid=${encodeURIComponent(acchedid)}&accheadname=${encodeURIComponent(accheadname)}&accid=${encodeURIComponent(accid)}&FromDate=${encodeURIComponent(FromDate)}&ToDate=${encodeURIComponent(ToDate)}&lastRowBalance=${encodeURIComponent(lastRowBalance)}&firstRowBalance=${encodeURIComponent(firstRowBalance)}`;
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Please Select the Account to Reconcile',
                            text: 'You need to select an account before proceeding.',
                            confirmButtonText: 'OK'
                        });
                        return;
                    }
                    break;

                case (formatMessage('Detailed Transaction Report')):
                    window.open(`/${tenantName}/Finance/TransactionDetails`, 'popupWindow', 'width=1200,height=800,scrollbars=yes,resizable=yes');
                    return;  // No need to set pageUrl for new window
            }
            if (pageUrl) {
                openModal(pageUrl, selectedText); // Open modal with the URL and title
            }

            // Handle Account Statement Cases
            const reportMapping = {
                "Account Statements": "AccountReport",
                "Statement Of Account With Narration": "AccountWithNarration",
                "Statement Of Account Export Formate": "AccountExportFormatReport",
                "Statement Of Account Export Formate[Landscape]": "AccountExportLandscapeReport",
                "Statement of Account Export [Formate2]": "AccountStatementFormat2Report",
                "Statement of Account [OrderByVoucerNo9 (Without Narration)]": "AccountOrderbyVchNoWONarrationReport"
            };

            if (reportMapping[selectedText]) {
                window.location.href = `/DocumentViewer?reportName=${reportMapping[selectedText]}`;
            }
        }




