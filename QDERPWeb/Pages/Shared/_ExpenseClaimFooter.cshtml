<script type="text/javascript">

        $(document).ready(function () {
            console.log('Start permission handling');
            // Form ID
            var formId = "frm20107ExpenseClaimView";

            // Call the API to get permissions
            $.ajax({
                url: '/api/Permissions/GetAccessDetails?formId=' + formId,
                type: 'GET',
                contentType: 'application/json',
                success: function (response) {
                    console.log("API Response:", response); // Log the API response

                    if (response.success && response.permissions) {
                        // Default visibility and enable status for buttons
                        var controlStates = {
                            "ddBtnShowRecords": { "Visible": false, "Enabled": false },
                            "btnPrint": { "Visible": false, "Enabled": false },
                            "btnSearch": { "Visible": false, "Enabled": false },
                            "ddButtonLayout": { "Visible": false, "Enabled": false },
                            "btnToggleSearch": { "Visible": false, "Enabled": false },
                            "btntoggleGroupPanel": { "Visible": false, "Enabled": false },
                            "btnToggleHeaderFilter": { "Visible": false, "Enabled": false },
                            "btnColumnChooser": { "Visible": false, "Enabled": false },
                            "ExpenseSubmission": { "Visible": false, "Enabled": false },
                            "ddButtonExpense": { "Visible": false, "Enabled": false }
                        };


                        // Check for full access
                        var fullAccess = response.permissions.find(p =>
                            p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
                        );

                        if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
                            // Grant full access: make all controls visible and enabled
                            Object.keys(controlStates).forEach(key => {
                                controlStates[key] = { "Visible": true, "Enabled": true };
                            });
                        } else {
                            // Update states based on specific permissions for each control
                            Object.keys(controlStates).forEach(key => {
                                var controlPermission = response.permissions.find(p =>
                                    p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
                                );
                                if (controlPermission) {
                                    controlStates[key] = {
                                        "Visible": controlPermission.ItemVisible || false,
                                        "Enabled": controlPermission.ItemEnabled || false
                                    };
                                }
                            });
                        }

                        console.log("Control States:", controlStates); // Log the control states

                        // Dynamically update button visibility and enabled state
                        Object.keys(controlStates).forEach(key => {
                            var button = document.getElementById(key);
                            if (button) {
                                // Handle visibility
                                button.style.display = controlStates[key].Visible ? "inline-block" : "none";
                                // Handle enable/disable state
                                button.disabled = !controlStates[key].Enabled;
                                console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
                            } else {
                                console.warn(`Button with ID "${key}" not found in the DOM.`);
                            }
                        });
                    } else {
                        console.warn("Failed to fetch permissions or no permissions available.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching permissions:", error);
                    alert('An error occurred while fetching permissions. Please try again.');
                }
            });
           // showColumnChooser();
            console.log('End permission handling');
        });


     function exportGridToPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('l', 'mm', 'a4'); // 'l' for landscape, 'mm' for millimeters, 'a4' for A4 size

        // Get the instance of the DataGrid
        var dataGrid = $("#dataGrid").dxDataGrid("instance");

        // Extract headers
        var headers = dataGrid.getVisibleColumns().map(column => column.caption);

        // Extract data and calculate sums
        var creditSum = 0;
        var debitSum = 0;
        var data = dataGrid.getVisibleRows().map(row => {
            return dataGrid.getVisibleColumns().map(column => {
                let value = row.data[column.dataField];
                if (column.dataType === 'date' && value) {
                    // Format date as dd-MMM-yyyy
                    let date = new Date(value);
                    let day = String(date.getDate()).padStart(2, '0');
                    let month = date.toLocaleString('default', { month: 'short' });
                    let year = date.getFullYear();
                    return `${day}-${month}-${year}`;
                }
                if (column.dataField === 'CrAmount') {
                    creditSum += value || 0;
                }
                if (column.dataField === 'DrAmount') {
                    debitSum += value || 0;
                }
                return value;
            });
        });

        // Generate PDF
        doc.autoTable({
            head: [headers],
            body: data,
            styles: { overflow: 'linebreak' },
            theme: 'grid',
            tableWidth: 'auto', // Adjust table width to fit the page
            columnStyles: {
                0: { cellWidth: 'wrap' }, // Adjust the first column width
                // Add more column styles if needed
            },
            margin: { top: 10, right: 10, bottom: 30, left: 10 }, // Adjust margins if needed
            didDrawPage: function (data) {
                // Remove the "DataGrid Export" text
                // doc.setFontSize(10);
                // doc.text('DataGrid Export', data.settings.margin.left, 10);

                // Add footer
                var pageCount = doc.internal.getNumberOfPages();
                doc.setFontSize(8);
                doc.text(`Page ${data.pageNumber} of ${pageCount}`, data.settings.margin.left, doc.internal.pageSize.height - 20);

                // Add sum of credit and debit, and row count
                doc.text(`Total Rows: ${dataGrid.getVisibleRows().length}`, data.settings.margin.left, doc.internal.pageSize.height - 15);
                doc.text(`Total Credit: ${creditSum.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`, data.settings.margin.left + 50, doc.internal.pageSize.height - 15);
                doc.text(`Total Debit: ${debitSum.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`, data.settings.margin.left + 150, doc.internal.pageSize.height - 15);
            }
        });

        // Open PDF in a new window
        var string = doc.output('datauristring');
        var newWindow = window.open();
        newWindow.document.write('<iframe width="100%" height="100%" src="' + string + '"></iframe>');
    }



