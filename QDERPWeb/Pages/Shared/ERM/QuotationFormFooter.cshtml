        function showSubmenu(e) {
            e.event.stopPropagation();
            var $submenu = $('#submenuContainer');
            var $target = $(e.event.target).closest('.dx-item-content');
            var offset = $target.offset();
            var elementWidth = $target.outerWidth();

            // Position submenu with a slight margin (e.g., 5px)
            $submenu.css({
                'width': 180,
                'position': 'absolute',
                'top': offset.top,
                'left': offset.left + elementWidth + 5, // Add margin
                'display': 'block'
            });
        }

        function closeSubmenu() {
            $("#submenuContainer").hide();
        }
             function addNewMaterialRequest(e) {
            let url = ''; // Declare once
            switch (e.itemData.text) {
                case formatMessage('Add New Client Request'):
                    url = `/${tenantName}/ERM/AddNewClientRequest`;
                    break;
                case formatMessage('Add New Store Request'):
                    url = `/${tenantName}/ERM/MRAddNewStoreRequest`;
                    break;
                case formatMessage('Add New Project Request'):
                    url = `/${tenantName}/ERM/MRAddNewProjectRequest`;
                    break;
                default:
                    console.log("Clicked item: ", e.itemData.text);
                    return;
            }

            window.location.href = url;
        }
                 async function handleCreditReportPrinting(e) {

           

        const itemText = e.itemData?.text;

        let requestNo = $("#txtRequestNo").dxTextBox("instance").option("value");

        if (!requestNo) {

            alert("RequestNo  is required.");

            return;

        }

        try {

            const isApproved = await checkInvoiceApprovalStatus1(requestNo);

            const watermarkText = isApproved ? "" : "Draft Copy";

            let reportName = "";

            switch (itemText) {

                case "Preview Request":

                        reportName = "MaterialRequestInventory";

                    break;

                case "Preview Request(With Expected Unit Price)":

                    reportName = "MaterialPurcchaseRequestion";

                    break;

                default:

                    alert("Invalid report format selected.");

                    return;

            }

            const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&RequestNo=${encodeURIComponent(requestNo)}&skipPreview=true&watermark=${encodeURIComponent(watermarkText)}&isApproved=${isApproved}`;

            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {

            console.error("Error checking approval status:", error);

            alert("Failed to check invoice approval status.");

        }

    }

    async function checkInvoiceApprovalStatus1(requestNo) {

        try {

            const response = await $.ajax({


                url: `/api/AddNewClientRequest/GetRequestNoteApprovalStatus/${encodeURIComponent(requestNo)}`,

                method: 'GET',

                dataType: 'json',

            });

            return response?.isApproved ?? false;

        } catch (error) {

            console.error("Error fetching approval status:", error);

            return false;

        }

    }
           const quotationReportMap = {
        "Preview Quotation": "PreviewQuotations",
        "Preview Quotation(W/O Discount Column)": "wtDiscount",
        "Preview Quotation(W/o VAT)":"QuotationWOvat",
        "Preview Quotation(W/o VAT & W/o TotalPrice)":"vatTotalPricewithout",
        "Preview Quotation(W/o VAT & W/o Discount)":"withoutvatDiscount",
        "Preview Quotation(With Addl Details)":"PreviewQuotationwithadditionalDetails",
        "Preview Quotation(Without Price)":"PreviewQuotationwithoutPrice",
        "Preview Quotation(With Item Image)":"PreviewQuotationWithImage",
        "Preview Quotation(With Group Code)":"GroupCode",
        "Preview Quotation(With Sub Group)":"PreviewQuotationWithSubGroup"
         };


    function handleQuatation(e) {
        alert('History trig')
        const itemText = e.itemData?.text;
        const tenantName = window.tenantName || "";
        const quotationNo = $("#txtQuotationNo").dxTextBox("instance").option("value");

        if (!quotationNo && itemText.includes("Quotation")) {
            alert("Quotation number is required.");
            return;
        }

        try {
            const reportName = quotationReportMap[itemText];

            if (!reportName) {
                alert("Invalid report format selected.");
                return;
            }

            const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&QuotationNo=${encodeURIComponent(quotationNo)}`;
            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {
            console.error("Failed to open report:", error);
            alert("An error occurred while trying to open the report.");
        }
    }
</script>
