        async function handlePurchase(e) {
        var reportName = e.itemData.reportName;
        const tenantName = window.tenantName || "";
        const purchaseOrderNo = $("#PurchaseOrderNo").dxTextBox("instance").option("value");

        if (!purchaseOrderNo) {
            DevExpress.ui.notify("Purchase order number is required.", "error", 3000);
            return;
        }

        if (!reportName) {
            DevExpress.ui.notify("Invalid report format selected.", "error", 3000);
            return;
        }

        try {
            // Check approval status like in MaterialRequestFormFooter1
            const isApproved = await checkPurchaseOrderApprovalStatus(purchaseOrderNo);
            const watermarkText = isApproved ? "" : "Draft Copy";

            // Base URL
            let url = `/${tenantName}/EquipmentViewer?reportName=${encodeURIComponent(reportName)}&purchaseOrderNo=${encodeURIComponent(purchaseOrderNo)}&skipPreview=true&watermark=${encodeURIComponent(watermarkText)}&isApproved=${isApproved}`;

            // Add additional report parameters like in PurchaseOrderEditFooter
            const purchaseReports = [
                "PreviewPurchaseOrders",

                "PreviewPurchaseOrderWoVAT"
            ];

            if (purchaseReports.includes(reportName)) {
                const params = {
                    showSeal: $("#hdnshowSeal").val(),
                    showSignature: $("#hdnshowSignature").val(),
                    printLetterhead: $("#hdnprintLetterhead").val(),
                    pageBreakBefore: $("#hdnPageBreakBefore").val(),
                    pageBreakAfter: $("#hdnPageAfterBefore").val(),
                    ShowPaymentTermsShippingDetails: $("#hdnShowPaymentTermsShippingDetails").val(),
                    ShowSignatoryPositionOnly: $("#hdnShowSignatoryPositionOnly").val(),
                    ShowSimpleSuppilerAcceptance: $("#hdnShowSimpleSuppilerAcceptance").val(),
                    ShowFullSupplierAcceptance: $("#hdnShowFullSupplierAcceptance").val(),
                    ShowitemPartNumberinsteadStockCode: $("#hdnShowitemPartNumberinsteadStockCode").val(),
                    ShowHSCodeinsteadStockCode: $("#hdnShowHSCodeinsteadStockCode").val()
                };

                // Add parameters that are set to "true"
                Object.keys(params).forEach(key => {
                    if (params[key] === "true") {
                        url += `&${key}=true`;
                    }
                });
            }

            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {
            console.error("Failed to open purchase report:", error);
            DevExpress.ui.notify("An error occurred while trying to open the report.", "error", 3000);
        }
    }

    async function checkPurchaseOrderApprovalStatus(purchaseOrderNo) {
        try {
            const response = await $.ajax({
                url: `/api/PurchaseOrder/GetPurchaseOrderApprovalStatus/${encodeURIComponent(purchaseOrderNo)}`,
                method: 'GET',
                dataType: 'json',
            });

            return response?.isApproved ?? false;
        } catch (error) {
            console.error("Error fetching approval status:", error);
            return false;
        }
    }


