<script>
     function handleShowTimesheet() {
        switch(e.itemData.text) {
            case "Show All Timesheet":
                showAllTimesheet();
                break;
            case "Show Client Timesheet":
                showClientTimesheet();
                break;
            case "Show Supplier Timesheet":
                showSupplierTimesheet();
                break;
            case "Show Operator - Day Shift Timesheet":
                showOperatorDayShiftTimesheet();
                break;
            case "Show Operator - Night Shift Timesheet":
                showOperatorNightShiftTimesheet();
                break;
            default:
                showClientTimesheet(); // fallback if none match
        }
    }

    // === Grid Column Change Functions ===
     function showAllTimesheet() {
        var grid = $("#timesheetGrid").dxDataGrid("instance");
        if (!grid) return;

        grid.option("columns", [
            {
                caption: formatMessage("Equipment TimeSheet Details"), alignment: "center",
                columns: [
                    { dataField: "PropertyNo", caption: formatMessage("Property No"), width: 120,  alignment: "center" },
                    { dataField: "TimeSheetDate", caption: formatMessage("Date"), dataType: "date",  alignment: "center" },
