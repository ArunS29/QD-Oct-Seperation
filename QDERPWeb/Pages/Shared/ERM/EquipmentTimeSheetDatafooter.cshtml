                        dataField: "WorkStatus",
                        caption: formatMessage("Status"),
                        width: 200,
                        alignment: "center",
                        editCellTemplate: function(cellElement, cellInfo) {
                        workStatusDropDownEditor(cellElement, cellInfo);
