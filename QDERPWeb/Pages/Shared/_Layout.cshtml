                $(document).ready(function () {
            // Keep track of previous IDs for each module
            let prevIds = {
                MaterialRequest: new Set(),
                Quotation: new Set(),
                SalesOrder: new Set(),
                RFQ: new Set(),
                PurchaseOrder: new Set()
            };

            let totalInventoryCount = 0;

            function updateInventoryTab() {
                $("#inventoryTab").text(`Inventory ${totalInventoryCount}`);
            }

            // Generic function for fetching and updating summaries
                    function loadInventorySummary(moduleName, apiUrl, idPrefix) {
            $.getJSON(apiUrl, function (data) {
                if (!data.success) return;

                // Determine where summary is
                const summary = data.Summary || data.data;
                if (!summary) return;

                let moduleCount = 0;

                Object.keys(summary).forEach(key => {
                    const value = summary[key] || 0;

                    // Make sure your HTML IDs match key names (case-insensitive)
                    $(`#${idPrefix}-${key.toLowerCase()}`).text(value);

                    // Use class for dot
                    $(`#${idPrefix}-${key.toLowerCase()}-dot`).toggle(value > 0);

                    moduleCount += value;
                });

                totalInventoryCount += moduleCount;
                updateInventoryTab();
            });
        }


            // Call loaders for each module
            loadInventorySummary("MaterialRequest", "/api/Notification/GetMaterialRequestSummary", "materialrequest");
            loadInventorySummary("Quotation", "/api/Notification/GetQuotationSummary", "quotation");
            loadInventorySummary("SalesOrder", "/api/Notification/GetSalesOrderSummary", "salesorder");
            loadInventorySummary("RFQ", "/api/Notification/GetRFQSummary", "rfq");
            //loadInventorySummary("PurchaseOrder", "/api/Notification/GetPurchaseOrderSummary", "purchaseorder");

            // ---------------- Clear All ----------------
            $("#clearAllInventoryNotifications").on("click", function () {
                Object.keys(prevIds).forEach(module => {
                    $(`#notification${module}List`).empty();
                    prevIds[module].clear();
                });
                totalInventoryCount = 0;
                updateInventoryTab();
            });
        });
