    <style>
        <style >
        /* Apply Inter Regular 400 Italic globally */
        * {
            color: var(--Global-Color-Grey-32, #525252); /* Default color */
            font-family: var(--Font-family-Base, 'Inter', sans-serif); /* Font family */
            font-size: var(--Font-size-300, 14px); /* Font size */
            font-style: normal; /* Font style */
            font-weight: 500; /* Font weight */
            line-height: var(--Line-height-300, 20px); /* Line height */
            -webkit-font-smoothing: antialiased; /* Smoothing for WebKit browsers */
            -moz-osx-font-smoothing: grayscale; /* Font smoothing for Firefox on macOS */
        }

        :root {
            font-family: "Inter", Helvetica, Arial, sans-serif;
            --highlight-color: #0f6cbd;
            --text-color: #525252;
            --hover-bg: darkblue;
            --sidebar-bg: #909ead00;
            --breadcrumb-color: #808080;
        }

        

        .container {
            display: flex;
            flex-grow: 1;
            padding: 0px;
            margin-left: 0px;
            margin-right: 0px;
            background-color: #909ead00;
            /* height: 100vh; */
        }

        /* Sidebar 1 styles */
        .sidebar {
            width: 250px;
            background-color: var(--sidebar-bg);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            border-right: 1px solid #ddd;
            /* padding: 16px; */
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6.5em;
            transition: width 0.3s ease;
            height: 105vh;
        }

     
        /* Hidden state of sidebar */
        .sidebar.hidden {
            width: 60px; /* Minimized width to show icons only */
            background-color: white;
            height: inherit;
        }



        /* Expanded state of sidebar 2 */
        .sidebar2.expanded {
            margin-left: 0px; /* Sidebar 2 moves left when sidebar1 is collapsed */
            /* margin-top: 45px; */
        }

        /* Menu items */
        .menu-item {
            display: flex;
            align-items: center;
            padding: 16px 8px;
            gap: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        /* Hide text when sidebar is hidden */
        .sidebar.hidden .menu-item .text {
            display: none; /* Hide text */
        }

        /* Menu item hover effect */
        .menu-item:hover {
            background-color: var(--hover-bg);
            border-radius: 4px;
        }

            /* Change text color to white on hover */
            .menu-item:hover {
                color: white;
                i{
                color: white;
                }
            }

        .menu-item i {
            width: 22.5px;
            height: 18.4px;
            font-size: 18px; /* Adjust as needed for consistent sizing */
            display: flex;
            align-items: center;
            justify-content: center;
        }


        .menu-item  {
            color: var(--text-color);
            font-size: 14px;
            font-weight: 500;
        }

        /* Active menu item */
        .menu-item.active .text {
            color: var(--highlight-color);
        }

        /* Toggle button */
        .toggle-btn {
            position: absolute;
            top: 70px;
            /* left: calc(var(--sidebar-width, 17em)); /* Use the sidebar width */
            width: 30px;
            height: 30px;
            background-color: #ffffff;
            border: 1px solid #ddd;
            box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            /* z-index: 1000; */
            transition: left 0.3s ease; /* Smooth transition */
        }

            .toggle-btn:hover {
                background-color: #e9ecef;
            }

        /* Sidebar hidden state */
        .sidebar.hidden ~ .toggle-btn {
            left: calc(var(--sidebar-width, 60px)); /* Adjust position dynamically */
        }



        /* Sidebar 2 styles */
        .sidebar2 {
            transition: background-color 0.3s ease;
            background-color: #fff;
            display: flex;
            flex-direction: column;
            border-left: 1px solid #ddd;
            border-right: 1px solid #ddd;
            /* padding-top: 50px; */
            margin-top: 75px; /* Adjust to align with the rest of your layout */
            height: calc(100vh - 75px); /* Sidebar takes full height minus the top margin */
            overflow-y: auto; /* Enable vertical scrolling */
            scrollbar-width: thin; /* For Firefox: thin scrollbar */
            scrollbar-color: #ccc #f9f9f9; /* For Firefox: color */
            /* padding:10px; */
            margin-left: 0px;
            transition: margin-left 0.3s ease;
            color:black;
            height:inherit;
        }

            /* Scrollbar styles for Webkit-based browsers */
            .sidebar2::-webkit-scrollbar {
                width: 8px; /* Set the width of the scrollbar */
            }

            .sidebar2::-webkit-scrollbar-thumb {
                background-color: #ccc; /* Color of the scrollbar thumb */
                border-radius: 4px; /* Round edges */
            }

                .sidebar2::-webkit-scrollbar-thumb:hover {
                    background-color: #aaa; /* Darker color on hover */
                }

            .sidebar2::-webkit-scrollbar-track {
                background-color: #f9f9f9; /* Background color of the scrollbar track */
                border-radius: 4px;
            }


            /* Make the inner elements unbold */
            .sidebar2 .submenu-item {
                font-weight: normal;
                font-size: 15px;
                color: black;
            }

            .sidebar2 .text {
                text-align: left;
                font-weight: normal;
                width: max-content;
            }

        /* Breadcrumb styles */
        .breadcrumb {
            display:none;
            /* margin-left: 10px; */
            font-size: 14px;
            color: var(--breadcrumb-color);
            padding-left: 35px; /* Add some left padding */
            /* display: flex; */
            justify-content: flex-start;
            align-items: center;
            gap: 8px;
            height: 30.5px;
            position: absolute;
            top: 65px; /* Align it to the top */
            left: calc(var(--sidebar-width, 17em)); /* Dynamically adjusts based on sidebars */
            right: 0; /* Stretches to full width of the screen */
            background-color: #f8f9fa;
            z-index: 10;
            flex-wrap: nowrap;
            border: 1px solid #ddd;
            transition: left 0.3s ease, width 0.3s ease; /* Smooth transition */
        }

            /* Breadcrumb item styles */
            .breadcrumb span {
                cursor: pointer;
                font-weight: 500;
                color: var(--text-color);
            }

            .breadcrumb .separator {
                color: #aaa;
                font-size: 14px;
            }

            .breadcrumb span:hover {
                color: var(--highlight-color);
                text-decoration: underline;
            }




        /* Submenu styles */
        .submenu-item {
            display: flex;
            align-items: center;
            padding: 10px 10px;
            gap: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .submenu-item:hover {
                background-color: var(--hover-bg);
                border-radius: 4px;
            }

                .submenu-item:hover {
                    color: white;
                }

            .submenu-item i {
                font-size: 14px;
                width: 14px;
                height: 14px;
            }

        /* Previous Button Style */
       
        .frame {
            display: flex; /* Use flexbox to align items */
            align-items: center; /* Vertically align items */
            justify-content: flex-end; /* Push items to the right */
            width: 100%; /* Occupy the full width of the screen */
            padding: 10px; /* Add some spacing */
            padding-bottom: 0px;
            background-color: #ffffff; /* Optional background color */
            position: fixed; /* Make it fixed to stay visible on scroll */
            top: 0; /* Position at the top */
            left: 0; /* Start from the very left */
            z-index: 100; /* Ensure it stays above other elements */
            height: 5em;
            border-bottom: 1px solid #ddd;
        }


            /* Style for the icons */
            .frame .img {
                font-size: 20px; /* Set size of icons */
                margin: 0 5px; /* Add spacing between icons */
                color: #333; /* Set icon color */
                cursor: pointer; /* Add pointer cursor for hover effect */
            }

            /* Style for the avatar */
            .frame .avatar {
                width: 20px;
                height: 20px;
                background-color: #f8f9fa; /* Placeholder color */
                border-radius: 50%; /* Make it circular */
                border: 2px solid #333; /* Optional border */
                margin-left: 10px;
                margin-right: 15px; /* Spacing from the last icon */
            }
            /* Logo styling inside the frame */
            .frame .image {
                display: flex; /* Flex container for logo */
                align-items: center; /* Center-align vertically */
                margin-right: auto; /* Push other elements to the right */
                margin-bottom: 10px;
                padding-left: 30px;
            }

                .frame .image img {
                    width: 140px; /* Adjust logo size */
                    height: 50px; /* Maintain aspect ratio */
                }
        /*  /* Loader styling */
        .loader {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1000; /* Ensure it's above all elements */
            display: none; /* Hidden by default */
        }

            .loader img {
                width: 500px; /* Adjust size as needed */
                height: 500px;
            }

        .menu i {
            color: darkgrey;
        }

        .financeDashboardSubmenu {
            height: 20px;
            width: 114px;
        }
        /* Base styling for all popups */
        .popup {
            display: none; /* Hidden by default */
            position: absolute; /* Make it float above the content */
            top: 10%;
            right: 10%;
            width: 300px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            z-index: 9999;
            border-radius: 8px;
            padding: 20px;
        }

        .popup-header {
            font-size: 18px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .popup-close {
            font-size: 20px;
            cursor: pointer;
            color: #888;
        }

            .popup-close:hover {
                color: #333;
            }

        .popup-content {
            font-size: 16px;
            color: #333;
        }

        /* Styling for the avatar (User Profile Button) */
        .avatar {
            width: 40px;
            height: 40px;
            background-color: #ccc;
            border-radius: 50%;
            cursor: pointer;
        }

        /* Special styling for the Profile Popup */
        .profile-popup {
            width: 350px;
            top: 15%;
            right: 5%;
        }





        /* Ensure iframe takes full size */
        #contentIframe {
            width: 100% !important;
            height: 100% !important;
            display: block;
        }



        /* Main Content */
        .mainContainer {
            margin-top: 6em;
            /* width: 85%; */
            /* padding: 20px; */
        }

        a {
            text-decoration: none;
        }

        .bodyContainer{
            display:flex;
        }
        .footerContainer{
            display:flex;
            align-items:center;
            justify-content:center;
            background-color:#fff;
            border: 1px solid #ddd;
        }
    </style>
</head>
