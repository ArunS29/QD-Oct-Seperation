                    function formatDate(date) {
                        if (!date) return "";
                        let dateObj = new Date(date);
                        let day = dateObj.getDate(); // Get Day
                        let month = dateObj.toLocaleString('en-US', { month: 'short' }); // Get Month as 'Jan', 'Feb'
                        let year = dateObj.getFullYear(); // Get Year
                        return `${day}-${month}-${year}`; // Format as D-MMM-YYYY
                    }

                    // Format dates correctly
                    var frmDateStr = formatDate(frmDate);
                    var toDateStr = formatDate(toDate);

