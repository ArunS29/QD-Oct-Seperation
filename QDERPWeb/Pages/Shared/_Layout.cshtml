        //Fuction for report onclick


        function handleClick(selectedText) {
            var dropDownBox = $("#accountDropDownBox").dxDropDownBox("instance");
            var frmDateBox = $("#frmdateBox").dxDateBox("instance");
            var toDateBox = $("#todateBox").dxDateBox("instance");

            var accountId = dropDownBox.option("value");
            var frmDate = frmDateBox.option("value");
            var toDate = toDateBox.option("value");

            // Check if accountId is not selected
            if (!accountId) {
                alert("Please select an account.");
                return;
            }

            // Function to format date as D-MMM-YYYY (e.g., 18-Jan-2022)
            function formatDate(date) {
                if (!date) return "";
                let dateObj = new Date(date);
                let day = dateObj.getDate(); // Get Day
                let month = dateObj.toLocaleString('en-US', { month: 'short' }); // Get Month as 'Jan', 'Feb'
                let year = dateObj.getFullYear(); // Get Year
                return `${day}-${month}-${year}`; // Format as D-MMM-YYYY
            }

            // Format dates correctly
            var frmDateStr = formatDate(frmDate);
            var toDateStr = formatDate(toDate);

            // Debugging: Log selectedText and formatted dates
            console.log("Selected Report Type:", selectedText);
            console.log("Formatted From Date:", frmDateStr);
            console.log("Formatted To Date:", toDateStr);

            // Mapping report names to URLs
            const reportMappings = {
                "Account Ledger - Statement of Accounts": "StatementOfAccountReport",
                "Account Ledger - Statement of Accounts (With Narration)": "AccountWithNarration",
                "Account Ledger - Statement of Accounts (Export Format2)": "AccountStatementFormat2Report",
                "Account Ledger - Statement of Accounts (Export Format)": "AccountExportFromatReport",
                "Account Ledger - Statement of Account OrderByVocuherNo(Without Narration)": "AccountOrderbyVchNoWONarrationReport",
                "Account Ledger - Statement of Account Export Format(Landscape)": "AccountExportLandscapeReport",
                "AccountOrderByVoucherNo": "AccountOrderByVoucherNo",
                "BillsReceivablelandscapeformat": "BillsReceivablelandscapeformat",
                 "BillsReceivableAll" : "BillsReceivableAll",
                "BillsReceivableByAccount": "BillsReceivableByAccount",
                "BillsReceivableAgeingToday": "BillsReceivableAgeingToday",
                "Report4": "Report4",
                "BillsReceivableRentation": "BillsReceivableRentation",
                "BillsReceivableLedgerBalance": "BillsReceivableLedgerBalance",
                "BillsReceivableFormat": "BillsReceivableFormat",
                "rpt201BillsPayable": "rpt201BillsPayable",
                "rpt201BillsPayableWithVchNo": "rpt201BillsPayableWithVchNo",
                "AccountDetails":"AccountDetails",
                "AgeingToday":"AgeingToday",
                "EndDate":"EndDate",
                 "Payablelandscape":"Payablelandscape"
            };

            // Check if selectedText matches any report name
            if (reportMappings[selectedText]) {
                let reportName = reportMappings[selectedText];
                console.log(`Redirecting to ${reportName}`);
        window.open(
          `/${tenantName}/DocumentViewer?reportName=${encodeURIComponent(reportName)}&accountId=${encodeURIComponent(accountId)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}&skipPreview=true`,
          '_blank',
          'width=1200,height=800,scrollbars=yes,resizable=yes'
        );            } else {
                console.log("No matching report found for selectedText:", selectedText);
            }

            // Optional: Adjust row height
            ChangeRowHeight(70);
        }


        window.onclick = function (event) {
            if (!event.target.matches('.fa-user')) {
                let dropdowns = document.getElementsByClassName("dropdown-menu");
                for (let i = 0; i < dropdowns.length; i++) {
                    let openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        };
        function toggleDropdown() {
            document.getElementById("userDropdown").classList.toggle("show");
        }
        function logout() {
            fetch('/api/Login/SignOut', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Redirect to login page after successful logout
                        window.location.href = `/${tenantName}/Security/Login`; // Redirect to login page

                    } else {
                        alert("Logout failed. Please try again.");
                    }
                })
                .catch(error => console.error("Error:", error));
        }
    </script>
