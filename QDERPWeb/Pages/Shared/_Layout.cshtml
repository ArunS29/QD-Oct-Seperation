                     let alertsData = [];

                async function fetchUnseenCount() {
                  try {
                    const response = await fetch('/api/Notification/GetUserNotifications');
                    if (!response.ok) throw new Error('Failed to fetch notifications');

                    const json = await response.json();
                    alertsData = json.data || [];

                    const unseenCount = alertsData.filter(n => n.IsSeen === false).length;
                    const badge = document.getElementById('notificationBadge');
                    badge.style.display = unseenCount > 0 ? 'inline-block' : 'none';
                    badge.textContent = unseenCount;

                  } catch (err) {
                    console.error('Error fetching notifications:', err);
                  }
                }

                function showPopup() {
                  const popup = document.getElementById('notificationPopup');
                  const content = document.getElementById('notificationPopupContent');

                  const unread = alertsData.filter(n => !n.IsSeen && n.AlertUserMessage);

                  if (unread.length === 0) {
                    content.innerHTML = '<div class="notification-item">No new notifications</div>';
                  } else {
                    content.innerHTML = unread.map(n => `
                      <div class="notification-item">
                        <strong>${n.AlertCode}</strong>
                        <span>${n.AlertUserMessage}</span>
                      </div>
                    `).join('');
                  }

                  popup.style.display = 'block';
                }

                function hidePopup() {
                  document.getElementById('notificationPopup').style.display = 'none';
                }

