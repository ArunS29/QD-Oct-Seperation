                $(document).ready(function () {
            let previousIds = new Set(); // track notifications already seen

            function updateNotifications() {
                $.getJSON('/api/Notification/GetFinanceNotificationSummary', function (data) {
                    const summary = data.Summary;
                    const notifications = data.Notifications;

                    // Update individual status numbers
                    $("#payments-verified").text(summary.Payments.ToBeVerified);
                    $("#payments-approved").text(summary.Payments.ToBeApproved);
                    $("#payments-audited").text(summary.Payments.ToBeAudited);
                    $("#receipt-verified").text(summary.Receipts.ToBeVerified);
                    $("#receipt-approved").text(summary.Receipts.ToBeApproved);
                    $("#receipt-audited").text(summary.Receipts.ToBeAudited);
                    $("#salespurchase-verified").text(summary.SalesPurchase.ToBeVerified);
                    $("#salespurchase-approved").text(summary.SalesPurchase.ToBeApproved);
                    $("#salespurchase-audited").text(summary.SalesPurchase.ToBeAudited);
                    $("#journals-verified").text(summary.Journals.ToBeVerified);
                    $("#journals-approved").text(summary.Journals.ToBeApproved);
                    $("#journals-audited").text(summary.Journals.ToBeAudited);
                    $("#expenseclaims-verified").text(summary.ExpenseClaims.ToBeVerified);
                    $("#expenseclaims-approved").text(summary.ExpenseClaims.ToBeApproved);
                    $("#expenseclaims-audited").text(summary.ExpenseClaims.ToBeAudited);

                    const $list = $("#notificationList");

                    // Add new notifications
                    notifications.forEach(n => {
                        const date = new Date(n.CreatedOn);
                        const userName = n.User || "Unknown";
                        const uniqueId = n.VoucherNumber + date.getTime();

                        if (!previousIds.has(uniqueId)) previousIds.add(uniqueId);

                        if ($(`#notif-${uniqueId}`).length === 0) {
                            const $item = $(`
                                <div class="notification-item" id="notif-${uniqueId}">
                                    <div class="notification-avatar">${userName.charAt(0)}</div>
                                    <div class="notification-content-text">
                                        <div class="notification-title">
                                            ${n.VoucherType} Voucher ${n.VoucherNumber} has been ${n.Status} by ${userName}${n.Amount ? ', ₹' + n.Amount : ''}.
                                        </div>
                                        <div class="notification-time">
                                            ${date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                                        </div>
                                    </div>
                                </div>
                            `);
                            $list.prepend($item.hide().slideDown(300));
                        }
                    });

                    // Calculate total notifications from summary
                    const totalCount =
                        summary.Payments.ToBeVerified + summary.Payments.ToBeApproved + summary.Payments.ToBeAudited +
                        summary.Receipts.ToBeVerified + summary.Receipts.ToBeApproved + summary.Receipts.ToBeAudited +
                        summary.SalesPurchase.ToBeVerified + summary.SalesPurchase.ToBeApproved + summary.SalesPurchase.ToBeAudited +
                        summary.Journals.ToBeVerified + summary.Journals.ToBeApproved + summary.Journals.ToBeAudited +
                        summary.ExpenseClaims.ToBeVerified + summary.ExpenseClaims.ToBeApproved + summary.ExpenseClaims.ToBeAudited;

                    $("#sidebarBadge").text(totalCount);
                    $("#financeTab").text(`Finance ${totalCount}`);
                });
            }

            // Mark all as seen (does not remove)
            $(".mark-read-btn").click(function () {
                $("#bellBadge, #sidebarBadge").text(0);
                previousIds.clear();
            });

            // Clear all notifications with animation
            $("#clearAllNotifications").click(function () {
                const $items = $("#notificationList .notification-item");
                if ($items.length === 0) return;

                $items.slideUp(300, function () { $(this).remove(); });

                // Reset badges
                $("#bellBadge, #sidebarBadge").text(0);
                $("#financeTab").text(`Finance 0`);
                previousIds.clear();
            });

            // Initial load + refresh every 60 seconds
            updateNotifications();
            setInterval(updateNotifications, 60000);
        });






