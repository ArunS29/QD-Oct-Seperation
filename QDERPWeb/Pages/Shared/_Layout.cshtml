<script>
    function openNav() {
        document.getElementById("mySidebar").style.width = "250px";
        document.getElementById("main").style.marginLeft = "120px";
    }

    function closeNav() {
        document.getElementById("mySidebar").style.width = "0";
        document.getElementById("main").style.marginLeft = "0";
    }

    const sideMenu = document.getElementById("sideMenu");
    const mContent = document.getElementById("mContent");

    // Toggle sidebar visibility
    function toggleMenu() {
        if (sideMenu.style.width === "250px") {
            sideMenu.style.width = "0";
            mContent.style.marginLeft = "0";
        } else {
            sideMenu.style.width = "250px";
            mContent.style.marginLeft = "250px";
        }
    }

    // Function to adjust sidebar on screen size change
    function adjustMenuForScreenSize() {
        const screenWidth = window.innerWidth;
        if (screenWidth <= 768) {
            sideMenu.style.width = "0"; // Hide sidebar by default on small screens
            mContent.style.marginLeft = "0";
        } else {
            sideMenu.style.width = "250px"; // Show sidebar on larger screens
            mContent.style.marginLeft = "250px";
        }
    }


    // Adjust menu on window resize
    window.addEventListener("resize", adjustMenuForScreenSize);

    // Initial adjustment on page load
    adjustMenuForScreenSize();
</script>
