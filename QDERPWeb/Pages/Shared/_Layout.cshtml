<body style="padding-top: 3.5rem;">

    <nav class="navbar navbar-dark bg-dark fixed-top navbar-expand-md">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">DemoPOC</a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbar" aria-expanded="false" aria-controls="navbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="navbar" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a href="/" class="nav-link active">Home</a></li>
                    <li class="nav-item"><a href="/#about" class="nav-link">About</a></li>
                    <li class="nav-item"><a href="/#contact" class="nav-link">Contact</a></li>
                    <li class="nav-item"><a href="\Finance\AccountingLedgers" class="nav-link active">Ledger List</a></li>
                    <li class="nav-item"><a href="\Finance\AccountingRegister" class="nav-link active">Ledger By Voucher Type</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container" style="margin-top: 1.5rem;">
        <input type="file" id="loadLayoutInput" accept=".json" style="display: none;" />
        <div id="rowHeightMenu"></div>
        <!-- Submenu-->
        <div id="submenuContainer" class="context-menu" style="display:none;">
            <div class="context-menu-item">
                <div style="margin-bottom:5px; margin-left:5px" onclick="ChangeRowHeight(30)">
                    <i style="color:black" class="fa fa-th-list">
                        <span style="color:black">Short</span>
                    </i>
                </div>
                <div style="margin-bottom:5px; margin-left:5px" onclick="ChangeRowHeight(40)">
                    <i style="color:black" class="fa fa-th-list">
                        <span>Mediam</span>
                    </i>
                </div>
                <div style="margin-bottom:5px; margin-left:5px" onclick="ChangeRowHeight(60)">
                    <i style="color:black" class="fa fa-th-list">
                        <span style="color:black">Tall</span>
                    </i>
                </div>
                <div style="margin-bottom:5px; margin-left:5px" onclick="ChangeRowHeight(70)">
                    <i style="color:black" class="fa fa-th-list">
                        <span style="color:black">Extra Tall</span>
                    </i>
                </div>
            </div>
        </div>

        @RenderBody()
        <footer class="footer mt-auto content-container-bottom">
         
            <div class="container">
                <span class="text-muted">© 2024 My Application. All rights reserved.</span>
                <a href="/privacy" class="text-muted">Privacy Policy</a>
                <a href="/terms" class="text-muted">Terms of Service</a>
            </div>
        </footer>
    </main>
