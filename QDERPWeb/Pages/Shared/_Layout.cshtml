              // Open sidebar when bell clicked
        document.getElementById('bellButton').addEventListener('click', function(e) {
            const sidebar = document.getElementById('notificationSidebar');
            if (!sidebar) return;

            sidebar.classList.add('open');

            // Stop the click from propagating to document
            e.stopPropagation();
        });

        // Close sidebar when clicking outside
        document.addEventListener('click', function(e) {
            const sidebar = document.getElementById('notificationSidebar');
            if (!sidebar) return;

            // If sidebar is open and click is outside sidebar & bell
            if (sidebar.classList.contains('open') &&
                !sidebar.contains(e.target) &&
                !e.target.closest('#bellButton')) {
                sidebar.classList.remove('open');
            }
        });
                $(document).ready(function() {
            $(".category-tab").click(function() {
