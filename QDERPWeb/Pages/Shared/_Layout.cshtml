@using System.IdentityModel.Tokens.Jwt
@using System.Linq
@using Microsoft.AspNetCore.Http
@using QD.ERP.Web.DAL.Entities
@using QD.ERP.Web.Service
@* @inject CurrencyService CurrencyService *@
@inject LanguageService LanguageService
@inject SaasKit.Multitenancy.ITenant<Tenant> Tenant
@inject UserAccessService UserAccessService

@{
    // var currencies = CurrencyService.GetCurrencies();
    var Languages = LanguageService.GetLanguages();

    string userName = "";
    string userId = "";
    string tenantName = "";
    string companyName = "";
    string escapedJson = "{}"; // Initialize early to make available later
    string escapedJson1 = "{}"; // Initialize early to make available later
    List<string> userModules = new List<string>();
    string encryptedTenantName = EncryptionHelper.Encrypt(tenantName); // Encrypt tenantName


    var authToken = Context.Request.Cookies["AuthToken"];
    if (!string.IsNullOrEmpty(authToken))
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(authToken);

            userName = jwtToken.Claims.FirstOrDefault(c => c.Type == JwtRegisteredClaimNames.Sub)?.Value;
            userId = jwtToken.Claims.FirstOrDefault(c => c.Type == "UserId")?.Value;
            tenantName = jwtToken.Claims.FirstOrDefault(c => c.Type == "TenantName")?.Value;
            companyName = jwtToken.Claims.FirstOrDefault(c => c.Type == "CompanyName")?.Value;

            Context.Session.SetString("UserName", userName ?? "");
            Context.Session.SetString("UserId", userId ?? "");
            Context.Session.SetString("TenantName", tenantName ?? "");



            if (int.TryParse(userId, out int parsedUserId))
            {
                userModules = UserAccessService.GetUserModules(parsedUserId);
                var financeMenuAccess = await UserAccessService.GetFinanceMenuAccessAsync(parsedUserId);
                var json = System.Text.Json.JsonSerializer.Serialize(financeMenuAccess);
                escapedJson = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(json);
                var inventoryMenuAccess = await UserAccessService.GetInventoryMenuAccessAsync(parsedUserId);
                var json1 = System.Text.Json.JsonSerializer.Serialize(inventoryMenuAccess);
                escapedJson1 = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(json1);
            }
        }
        catch (Exception ex)
        {
            userName = "Error decoding token: " + ex.Message;
        }
    }
    else
    {
        userName = "No AuthToken found.";
    }
}

@inject QD.ERP.Web.Service.LicenseService LicenseService

@{
    // Retrieve tenantName from session
    string tenantNameFromSession = Context.Session.GetString("TenantName") ?? "";

