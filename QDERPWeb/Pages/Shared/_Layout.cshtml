                function updateBreadcrumbFromSidebar2(submenuItem) {
                    // Clear the breadcrumb trail before adding the new item
                    breadcrumbTrail.length = 1;
                    breadcrumbTrail.push(submenuItem); // Add the new breadcrumb item
                    updateBreadcrumb(); // Re-render the breadcrumb trail
                }


                function updateBreadcrumb() {
                    const breadcrumbContainer = document.getElementById("breadcrumb");

                    // Clear existing breadcrumb items
                    breadcrumbContainer.innerHTML = '';

                    breadcrumbTrail.forEach((name, index) => {
                        // Create breadcrumb item
                        const breadcrumbItem = document.createElement("span");
                        breadcrumbItem.textContent = name;
                        breadcrumbItem.onclick = () => goToLevel(index);
                        breadcrumbContainer.appendChild(breadcrumbItem);

                        // Add a separator if not the last item
                        if (index < breadcrumbTrail.length - 1) {
                            const separator = document.createElement("span");
                            separator.textContent = " / ";
                            separator.className = "separator";
                            breadcrumbContainer.appendChild(separator);
                        }
                    });
                }


                function goToLevel(level) {
                    breadcrumbTrail = breadcrumbTrail.slice(0, level + 1); // Keep up to the selected level
                    updateBreadcrumb();
                }

