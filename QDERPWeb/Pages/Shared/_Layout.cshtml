                }

            .sidebar .closebtn {
                position: absolute;
                top: 0;
                right: 25px;
                font-size: 36px;
                margin-left: 50px;
            }


        .openbtn {
            font-size: 20px;
            cursor: pointer;
            background-color: #c0dceb;
            color: white;
            padding: 10px 15px;
            border: none;
        }

            .openbtn:hover {
                background-color: #c0dceb;
            }

        #main {
            transition: margin-left .5s;
            padding: 16px;
        }


        /* Main Content Styles */
        #mContent {
            /* margin-left: 250px; /* Aligns with the sidebar width */ */ transition: margin-left 0.3s ease; /* Smooth transition when toggling */
            margin: 0;
            padding: 0;
        }

        /* Navbar Styles */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1020;
        }

        .navbar-toggler {
            font-size: 1.5rem;
            border: none;
            background: none;
        }

        /* Dropdown Menu Scroll */
        .nav-item .dropdown-menu {
            max-height: 650px; /* Adjust dropdown height */
            overflow-y: auto; /* Enable scrolling */
        }

        /* Adjustments for Small Screens */
        @@media (max-width: 768px) {
            #sideMenu {
                width: 0; /* Collapse sidebar */
            }

            #mContent {
                margin-left: 0; /* Full width for main content */
            }
        }

        /* Submenu Styles */
        .context-menu {
            display: none;
            position: absolute;
            background: white;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 10px;
            z-index: 1000;
            border-radius: 5px;
        }

        .context-menu-item div {
            display: flex;
            align-items: center;
            cursor: pointer;
            margin-bottom: 5px;
            padding: 5px;
        }

            .context-menu-item div:hover {
                background-color: #f1f1f1;
            }

        .context-menu-item i {
            margin-right: 8px;
            color: #333;
        }

        .context-menu-item span {
            font-size: 13px;
            color: #333;
        }

        footer {
            text-align: center;
            padding: 20px;
            background-color: #f1f1f1;
            color: #666;
            border-top: 1px solid #ccc;
        }

            footer a {
                text-decoration: none;
                color: #666;
                margin: 0 10px;
            }

                footer a:hover {
                    color: #000;
                }
    </style>

