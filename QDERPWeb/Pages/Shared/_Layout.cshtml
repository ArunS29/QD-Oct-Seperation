        // Function to toggle visibility of nested submenus
        function toggleSubmenu(submenuId) {
            const submenu = document.getElementById(submenuId);
            if (submenu.style.display === 'none') {
                submenu.style.display = 'block';
            } else {
                submenu.style.display = 'none';
            }
        }

        // Function to toggle visibility of nested submenus
        function toggleSubmenu(submenuId) {
            const submenu = document.getElementById(submenuId);
            if (submenu.style.display === 'none') {
                submenu.style.display = 'block';
            } else {
                submenu.style.display = 'none';
            }
        }


        function loadAccountLedger() {
            // Set the iframe source to load Accounting Ledgers content
            const iframe = document.getElementById("contentIframe");
            iframe.src = "/Finance/AccountingLedgers";
            hideSidebars();
            // Update the breadcrumb (same as the anchor tag in the menu)
            updateBreadcrumbFromSidebar2('Accounting Ledgers');

        }


        function hideSidebars() {
            const sidebar = document.getElementById('sidebar');
            const sidebar2 = document.getElementById('sidebar2');
            const root = document.documentElement; // Access CSS custom properties

            // Hide Sidebar 1 and Sidebar 2
            sidebar.classList.add('hidden');
            sidebar2.classList.add('hidden');
            sidebar2.style.display = 'none'; // Set display to none for sidebar2

            // Update the CSS variable based on the sidebar state
            root.style.setProperty('--sidebar-width', '0px'); // No sidebar
            sidebar2.style.marginTop = '70px'; // Adjust Sidebar 2 margin

            // Adjust the toggle button symbol
            const toggleBtn = document.querySelector('.toggle-btn');
            toggleBtn.innerHTML = '&gt;';
        }


        function updateBreadcrumbFromSidebar2(submenuItem) {
            // Clear the breadcrumb trail before adding the new item
            breadcrumbTrail.length = 1;
            breadcrumbTrail.push(submenuItem); // Add the new breadcrumb item
            updateBreadcrumb(); // Re-render the breadcrumb trail
        }


        function updateBreadcrumb() {
            const breadcrumbContainer = document.getElementById("breadcrumb");

            // Clear existing breadcrumb items
            breadcrumbContainer.innerHTML = '';

            breadcrumbTrail.forEach((name, index) => {
                // Create breadcrumb item
                const breadcrumbItem = document.createElement("span");
                breadcrumbItem.textContent = name;
                breadcrumbItem.onclick = () => goToLevel(index);
                breadcrumbContainer.appendChild(breadcrumbItem);

                // Add a separator if not the last item
                if (index < breadcrumbTrail.length - 1) {
                    const separator = document.createElement("span");
                    separator.textContent = " / ";
                    separator.className = "separator";
                    breadcrumbContainer.appendChild(separator);
                }
            });
        }


        function goToLevel(level) {
            breadcrumbTrail = breadcrumbTrail.slice(0, level + 1); // Keep up to the selected level
            updateBreadcrumb();
        }

        function resetBreadcrumb() {
            breadcrumbTrail = ["Home"]; // Reset to the initial state
            updateBreadcrumb();
        }

        // Example usage to ensure Sidebar2 interactions don't interfere with the trail
        function selectNestedSubmenu(parent, child) {
            updateBreadcrumbFromSidebar2(parent); // Update second level
            updateBreadcrumbFromSidebar2(child); // Add/update the third level
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const sidebar2 = document.getElementById('sidebar2');
            const toggleBtn = document.querySelector('.toggle-btn');
            const root = document.documentElement; // Access CSS custom properties

            // Toggle visibility of Sidebar 1
            sidebar.classList.toggle('hidden');
            sidebar2.classList.toggle('expanded');

            // Update the CSS variable based on the sidebar state
            if (sidebar.classList.contains('hidden') && sidebar2.classList.contains('expanded')) {
                root.style.setProperty('--sidebar-width', '80px'); // Sidebar 2 width
                //sidebar2.style.marginTop = '70px'; // Adjust Sidebar 2 margin
            } else if (sidebar.classList.contains('hidden')) {
                root.style.setProperty('--sidebar-width', '0px'); // No sidebar
              //  sidebar2.style.marginTop = '70px'; // Adjust Sidebar 2 margin
            } else {
                root.style.setProperty('--sidebar-width', '256px'); // Sidebar 1 width
                //sidebar2.style.marginTop = '70px'; // Keep Sidebar 2 margin
                //sidebar.style.marginTop = '45px'; // Adjust Sidebar 1 margin
            }

            // Adjust the toggle button symbol
            toggleBtn.innerHTML = sidebar.classList.contains('hidden') ? '&gt;' : '&lt;';
        }

    </script>
