                                `/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}&skipPreview=true`,
                                '_blank',
                                'width=1200,height=800,scrollbars=yes,resizable=yes'
                            );
                        } else {
                            console.warn("No matching report found for:", selectedText);
                            alert("No matching report found.");
                        }
                    } catch (error) {
                        console.error("An error occurred:", error);
                        alert("Something went wrong. Check console for details.");
                    }
                }
