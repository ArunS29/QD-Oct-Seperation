                var authToken = '@authToken';
                tenantName = '@tenantName';
                var userName = '@userName';
                var userId = '@userId';

                $(document).ready(function () {
                    if (authToken) {
                        var decodedToken = jwt_decode(authToken);
                        var tokenExpiry = new Date(decodedToken.exp * 1000); // Token expiry time in milliseconds
                        var currentTime = new Date();

                        // Store token expiry in sessionStorage for use across reloads
                        sessionStorage.setItem('TokenExpiry', tokenExpiry);
                        monitorTokenExpiry();
                        // Initialize idle timeout handling
                        setupIdleTimeout();
                        $('.modal-backdrop').remove();
                        // Function to monitor token expiry and extend session
                        function monitorTokenExpiry() {
                            // Set interval to check the token expiry every 30 seconds
                            setInterval(function () {
                                var tokenExpiry = new Date(sessionStorage.getItem('TokenExpiry')); // Get updated expiry
                                var currentTime = new Date();
                                var timeToExpiry = (tokenExpiry - currentTime) / 1000; // Time left in seconds

                                // If token will expire in less than 2 minutes, extend the session
                                if (timeToExpiry <= 120 && timeToExpiry > 0) {
                                    console.log('Token is about to expire. Extending session...');
                                    extendSession();
                                }
                            }, 30000); // Check every 30 seconds
                        }

                        // Function to setup idle timeout logic
                        function setupIdleTimeout() {
                            var countdown;
                            var countdownTime = 60; // Countdown for 30 seconds
                            var countdownInterval;
                            $(document).idle({
                                idle: 15 * 60 * 1000, // 15 minutes of inactivity
                                onIdle: function () {
                                    // Show the modal when the user is idle for 15 minutes
                                    $('#idleModal').modal('show');
                                    $('.modal-backdrop').remove();
                                    // Start countdown
                                    countdown = countdownTime;
                                    updateCountdownDisplay(countdown);
                                    countdownInterval = setInterval(function () {
                                        countdown--;
                                        updateCountdownDisplay(countdown);

                                        // If countdown reaches 0, log out automatically
                                        if (countdown <= 0) {
                                            clearInterval(countdownInterval);
                                            autoLogout();
                                        }
                                    }, 1000);
                                },
                                onActive: function () {
                                    // If user becomes active again, stop countdown and hide the modal
                                },
                                keepTracking: true,
                            });

                            // Handle "Stay Logged In" button
                            $('#stayLoggedIn').on('click', function () {
                                $('#idleModal').modal('hide');
                                clearInterval(countdownInterval); // Stop countdown
                                extendSession(); // Extend session when user stays logged in
                            });

                            // Handle "Log Out" button
                            $('#logout').on('click', function () {
                                clearInterval(countdownInterval); // Stop countdown
                                autoLogout(); // Log out the user
                            });

                            // Function to update countdown display
                            function updateCountdownDisplay(seconds) {
                                var minutes = Math.floor(seconds / 60);
                                var secondsLeft = seconds % 60;
                                $('#countdownTimer').text(`${minutes}:${secondsLeft < 10 ? '0' + secondsLeft : secondsLeft}`);
                            }
                        }

                        // Function to automatically log out the user
                        function autoLogout() {
                            var url = `/${tenantName}/Security/Login`;
                            $.ajax({
                                url: '/api/Login/SignOut', // Call the SignOut API
                                type: 'GET', // HTTP method
                                success: function (response) {
                                    sessionStorage.clear();
                                    // alert(response.message);
                                    window.location.href = url; // Redirect to login page
                                },
                                error: function (xhr, status, error) {
                                    alert('An error occurred during sign-out');
                                }
                            });
                        }

                        // Function to extend the session
                        function extendSession() {
                            $.ajax({
                                url: '/api/Login/ExtendSession', // API endpoint for extending session
                                type: 'POST',
                                xhrFields: {
                                    withCredentials: true // Include cookies in the request
                                },
                                success: function (data) {
                                    if (data.success) {
                                        console.log('Session extended successfully.');
                                        // Update AuthToken and Permissions in sessionStorage
                                        sessionStorage.setItem('AuthToken', data.token);
                                        sessionStorage.setItem('Permissions', JSON.stringify(data.permissions));

                                        // Update the token expiry
                                        var newDecodedToken = jwt_decode(data.token);
                                        var newTokenExpiry = new Date(newDecodedToken.exp * 1000);
                                        sessionStorage.setItem('TokenExpiry', newTokenExpiry);
                                    } else {
                                        console.error('Failed to extend session:', data.message);
                                    }
                                },
                                error: function (xhr, status, error) {
                                    console.error('Error extending session:', error);
                                }
                            });
                        }
                    }
                });

