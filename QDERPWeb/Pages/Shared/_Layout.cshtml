        $(document).ready(function () {

            function updateBellBadge(extraCount) {
                let currentCount = parseInt($("#bellBadge").text()) || 0;
                $("#bellBadge").text(currentCount + extraCount);
            }

            function loadOthersNotifications() {
                $.getJSON('/api/Notification/GetUserNotifications', function (res) {
                    const notifications = res.data || [];
                    const list = $("#othersNotificationList");
                    list.empty();

                    if (notifications.length > 0) {
                        notifications.forEach(function (notif) {
                            const item = $(`
                                <div class="notification-item">
                                    <div class="notification-avatar">O</div>
                                    <div class="notification-content-text">
                                        <div class="notification-title">${notif.AlertUserMessage}</div>
                                        <div class="notification-time">${new Date(notif.AlertUserOn).toLocaleString()}</div>
                                    </div>
                                </div>
                            `);
                            list.append(item);
                        });
                    } else {
                        list.append('<div class="notification-empty">No notifications</div>');
                    }

                    // Count
                    const totalCount = res.totalCount || notifications.length;

                    // Update Others tab
                    $("#othersTab").text(`Others ${totalCount}`);

                    // Add this section's count to the bell badge
                    updateBellBadge(totalCount);
                });
            }

            // Initial load
            loadOthersNotifications();

            // Clear All button click
            $("#clearAllOthers").on("click", function () {
                $("#othersNotificationList .notification-item").fadeOut(300, function () {
                    $(this).remove();
                });
                $("#othersTab").text("Others 0");

                // Reduce bell badge count accordingly
                let currentCount = parseInt($("#bellBadge").text()) || 0;
                $("#bellBadge").text(Math.max(0, currentCount - ($("#othersNotificationList .notification-item").length)));
            });

        });

