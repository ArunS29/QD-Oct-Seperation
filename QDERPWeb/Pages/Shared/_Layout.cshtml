                        <span class="category-tab active" id="financeTab" data-tab="financeContent">Finance 0</span>
                        <span class="category-tab inactive" id="vatTab" data-tab="vatContent">VAT 0</span>
                        <span class="category-tab inactive" id="inventoryTab" data-tab="inventoryContent">Inventory 0</span>
                        <span class="category-tab inactive" id="othersTab" data-tab="othersContent">Others 0</span>
                    </div>
                </div>

                <!-- Content -->
                <div class="notification-content">

                    <!-- Finance Tab Content -->
                    <div class="tab-content" id="financeContent">
                        <!-- Payments (Bank/Cash) -->
                        <div class="status-card">
                            <div class="status-card-title">Payments (Bank/Cash)</div>
                            <div class="status-grid">
                                <div class="status-item" onclick="goToVoucherApproval('Payments','ToBeVerified')">
                                    <div class="status-icon"><i class="fas fa-file"></i></div>
                                    <div class="status-number" id="payments-verified">0</div>
                                    <div class="status-label">To Be Verified</div>
                                    <span class="new-dot" id="payments-verified-dot"></span>
                                </div>
