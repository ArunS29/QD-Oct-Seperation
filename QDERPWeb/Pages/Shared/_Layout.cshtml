@using System.IdentityModel.Tokens.Jwt
@using System.Linq
@using Microsoft.AspNetCore.Http
@using QD.ERP.Web.DAL.Entities
@using QD.ERP.Web.Service
@inject SaasKit.Multitenancy.ITenant<Tenant> Tenant

@{
    string userName = "";
    string userId = "";
    string tenantName = "";
    string companyName = "";

    var authToken = Context.Request.Cookies["AuthToken"];
    if (!string.IsNullOrEmpty(authToken))
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(authToken);

            userName = jwtToken.Claims.FirstOrDefault(c => c.Type == JwtRegisteredClaimNames.Sub)?.Value;
            userId = jwtToken.Claims.FirstOrDefault(c => c.Type == "UserId")?.Value;
            tenantName = jwtToken.Claims.FirstOrDefault(c => c.Type == "TenantName")?.Value;
            companyName = jwtToken.Claims.FirstOrDefault(c => c.Type == "CompanyName")?.Value; // Extract Company Name

            Context.Session.SetString("UserName", userName ?? "");
            Context.Session.SetString("UserId", userId ?? "");
            Context.Session.SetString("TenantName", tenantName ?? "");
            //Context.Session.SetString("CompanyName", companyName ?? ""); // Store Company Name
        }
        catch (Exception ex)
        {
            userName = "Error decoding token: " + ex.Message;
        }
    }
    else
    {
        userName = "No AuthToken found.";
    }
}

