<div class="dx-fieldset horizontal-container" style="gap:10px;background-color:transparent;">


    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddButtonLayout")
            .Icon("smalliconslayout")
            .Width("100%")
            .Text(new JS("formatMessage('Layout')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
                items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
                items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
                items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
            })
            .ShowArrowIcon(false)
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("rowHeightProperties")
            .Icon("") 
            .Width(50)
            .Text(new JS("formatMessage('Set Row Height')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add()
                .Text("Short (1 Line)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="9" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Short
                           </text>)
                .OnClick("function() { ChangeRowHeight('30'); }");

                items.Add()
                .Text("Medium (2 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="6" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Medium
                           </text>)
                .OnClick("function() { ChangeRowHeight('60'); }");

                items.Add()
                .Text("Tall (4 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="4" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="8" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="16" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Tall
                           </text>)
                .OnClick("function() { ChangeRowHeight('90'); }");

                items.Add()
                .Text("Extra Tall (8 Lines)")
                .Template(@<text>
            <svg width="20" height="20" viewBox="0 0 20 20">
                @for (var i = 1; i <= 8; i++)
                        {
                            var y = 1 + (i - 1) * 2;
                            <text><rect x="2" y="@y" width="16" height="1" fill="var(--title-background-color)" /></text>
                        }
            </svg> Extra Tall
        </text>)
                .OnClick("function() { ChangeRowHeight('130'); }");
            })
            .ShowArrowIcon(false)
        )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnPrint")
            .Icon("print")
            .Text(new JS("formatMessage('Print')"))
            .OnClick("printFun")
            )
    </div>
     <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnToggleSearch")
            .Icon("search")
            .Text(new JS("formatMessage('Search')"))
            .OnClick("toggleFilterRow")
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btntoggleGroupPanel")
            .Icon("hierarchy")
            .Text(new JS("formatMessage('Group')"))
            .OnClick("toggleGroupPanel")
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnToggleHeaderFilter")

            .Text(new JS("formatMessage(' Filter')"))
            .ElementAttr(new { style = "display: none;" })
            @* .Icon("filter") *@
            .OnClick("toggleHeaderFilter")
            .Template(@<text>
            <div style="display: flex; justify-content: center; align-items: center;">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="none">
                    <!-- Circle background -->
                    <circle cx="12" cy="12" r="12" fill="var(--title-background-color)" />
                    <!-- Filter funnel icon in white -->
                    <polygon points="6 8 18 8 13 13 13 17 11 17 11 13 6 8" fill="#ffffff" />
                </svg>
            </div>
        </text>)
            )

    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnColumnChooser")
            .Icon("columnchooser")
            .Text(new JS("formatMessage('Column Chooser')"))
            .OnClick("showColumnChooser")
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnDeliveryNoteDetails")
            .Icon("overflow")
            .Text(new JS("formatMessage('Delivery Note Details')"))
            .OnClick("OpenDeliveryNoteDetails")
            )

    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("btnDeliveryNotePosting")
            .Icon("upload")
            .Text(new JS("formatMessage('Delivery Note Posting')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add()
                    .Text(new JS("formatMessage('Posting Of Cost Prices')"))
                    .Option("color", "#00ACC1")  // Cyan
                    .Icon("money");

                items.Add()
                    .Text(new JS("formatMessage('Posting of DN to Journal Books')"))
                    .Option("color", "#AB47BC")  // Purple
                    .Icon("book");
            })
            .ItemTemplate(@<text>
                <div class="custom-dropdown-item">
                    <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                    <div class="item-content">
                        <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                        <div>
                            <div class="item-title"><%- text %></div>
                        </div>
                    </div>
                </div>
            </text>)
            @* .OnItemClick("addNewDeliveryNotePosting") *@
            .ShowArrowIcon(false)
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("btnAddDeliverynote")
            .Icon("add")
            .Text(new JS("formatMessage('Add')"))
            .DropDownOptions(options => options.Width(325))
            .Items(items =>
            {
                items.Add()
                    .Text(new JS("formatMessage('Add New Delivery to Client')"))
                    .Option("color", "#34A853")  // Green
                    .Icon("runner");

                items.Add()
                    .Text(new JS("formatMessage('Add Material Issued To Store(Consumption)')"))
                    .Option("color", "#FBBC05")  // Yellow
                    .Icon("box");

                items.Add()
                    .Text(new JS("formatMessage('Add Material Issued To Project(Consumption)')"))
                    .Option("color", "#00ACC1")  // Cyan
                    .Icon("box");

                items.Add()
                    .Text(new JS("formatMessage('Add Store Transfers')"))
                    .Option("color", "#4285F4")  // Blue
                    .Icon("export");
            })
            .ItemTemplate(@<text>
                <div class="custom-dropdown-item">
                    <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                    <div class="item-content">
                        <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                        <div>
                            <div class="item-title"><%- text %></div>
                        </div>
                    </div>
                </div>
            </text>)
            .OnItemClick("addNewDeliveryNote")
            .ShowArrowIcon(false)
            )
    </div>
   
</div>

<script>
        
  
        function showSubmenu(e) {
            e.event.stopPropagation();
            var $submenu = $('#submenuContainer');
            var $target = $(e.event.target).closest('.dx-item-content');
            var offset = $target.offset();
            var elementWidth = $target.outerWidth();

            // Position submenu with a slight margin (e.g., 5px)
            $submenu.css({
                'width': 180,
                'position': 'absolute',
                'top': offset.top,
                'left': offset.left + elementWidth + 5, // Add margin
                'display': 'block'
            });
        }

        function closeSubmenu() {
            $("#submenuContainer").hide();
        }
  
        function OpenDeliveryNoteDetails() {
            window.location.href = `/${tenantName}/IMS/DeliveryNoteDetails`;
        }
        function addNewDeliveryNote(e) {
            let url = ''; // Declare once
            switch (e.itemData.text) {
               case formatMessage('Add New Delivery to Client'):
                    url = `/${tenantName}/IMS/AddNewDeliverytoClient`;
                    break;
                case formatMessage('Add Material Issued To Store(Consumption)'):
                    url = `/${tenantName}/IMS/AddNewStoreRequest`;
                    break;
                case formatMessage('Add Material Issued To Project(Consumption)'):
                    url = `/${tenantName}/IMS/AddNewProjectRequest`;
                    break;
                case formatMessage('Add Store Transfers'):
                    url = `/${tenantName}/IMS/AddNewProjectRequest`;
                    break;
                default:
                    console.log("Clicked item: ", e.itemData.text);
                    return;
            }

            window.location.href = url;
        }
</script>
