           function approveDeliveryNote() {
        const deliveryNoteNo = $("#deliveryNoteNo").dxTextBox("instance").option("value");
        if (!deliveryNoteNo) {
            DevExpress.ui.notify("Delivery Note No is required", "error", 3000);
            return;
        }
        // Show confirmation dialog
        DevExpress.ui.dialog.confirm(
            "Are you sure you want to approve this Delivery Note?",
            "Confirm Approval"
        ).done(function (dialogResult) {
            if (!dialogResult) return; // user cancelled

            // Proceed with approval
            fetch('/api/DeliveryNote/ApproveDeliveryNote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(deliveryNoteNo)
            })
            .then(response => {
                // Always parse JSON safely
                if (!response.ok) return response.json().then(err => { throw err; });
                return response.json();
            })
            .then(result => {
                // ✅ Always show message
                DevExpress.ui.notify(result.message || "Approval completed", result.success ? "success" : "error", 3000);
                if (result.success && result.VoucherApprovedBy) {
                    const approvedByBox = $("#Dnsignatory").dxDropDownBox("instance");
                    if (approvedByBox) approvedByBox.option("value", result.VoucherApprovedBy);
                }
                // Optional UI updates
                syncWorkflowFromFields();
                disableEditing();
                $("#btnPrint1").dxDropDownButton("instance").option("disabled", false);
            })
            .catch(err => {
                DevExpress.ui.notify(err.message || "Approval failed", "error", 3000);
            });
        });
    }
