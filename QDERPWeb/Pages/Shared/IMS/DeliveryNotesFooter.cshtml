       function handleDeliveryNote(e) {
        const itemText = e.itemData?.text?.trim();
        const tenantName = window.tenantName || "";
        const deliveryNote = $("#deliveryNoteNo").dxTextBox("instance").option("value");

        if (!deliveryNote) {
            alert("DeliveryNote number is required.");
            return;
        }

        const DeliverynoteReportMap = {
            "Preview Delivery Note": "PreviewDeliveryNote",
            "Preview Material Issue Note": "ReportforMaterialIssueNote",
            "Preview Delivery Note (with Price)": "PreviewDeliveryNotewithPrice",
            "Preview Delivery Note (Dot Matrix)": "DotMatrics",
            "Preview Delivery Note (WIth Cost Price)": "DeliveryNoteWithCostPrice"
        };

        const reportName = DeliverynoteReportMap[itemText];

        if (!reportName) {
            alert("Invalid report format selected.");
            return;
        }

        const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&DeliveryNoteNo=${encodeURIComponent(deliveryNote)}`;
        window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
    }

    function onIMSAttachmentButtonClick(e) {
        // Get Voucher No safely
        const deliveryNoBox = $("#deliveryNoteNo").dxTextBox("instance");
        const deliveryNo = deliveryNoBox ? deliveryNoBox.option("value") : null;
        var dataGrid = $("#itemGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;
        var dataSource = dataGrid.option("dataSource");

        if (rowCount === 0 || rowCount === null) {
            DevExpress.ui.notify(
                "Not allow to Add Attachments. Please enter some transactions in Grid.",
                "warning",
                4000
                );
            return;
        }
        var menuType = "inventory";

        var formType = '';
        var deliveryType = $("#DeliveryType").dxSelectBox("instance");
        var deliveryTypevalue = deliveryType.option("value");
        if (deliveryTypevalue == "1") 
            formType = "Delivery To Client";
        else if (deliveryTypevalue == "2")
            formType = "Delivery To Store";
        else if (deliveryTypevalue == "3")
            formType = "Delivery To Project";
        else if (deliveryTypevalue == "4")
            formType = "Delivery Store Tranfers";
            
        // Log and build URL
        console.log("Voucher No:", deliveryNo);
        console.log("Voucher Type:", formType);

        const isMaster = false;
        const url = `/${tenantName}/Finance/LedgerDocuments?ReferenceNo=${encodeURIComponent(deliveryNo)}&ModuleType=${encodeURIComponent(formType)}&isMaster=${encodeURIComponent(isMaster)}&menuType=${encodeURIComponent(menuType)}&modal=true`;
        const title = "Transaction Documents";

        openModal(url, title);
    }

