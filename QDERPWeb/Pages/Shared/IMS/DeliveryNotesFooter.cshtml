


<div class="dx-fieldset horizontal-container mt-2">
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnSave")
                .Text(new JS("formatMessage('Save')"))
                .Icon("save")
                .Hint("Click to save")
                .ElementAttr(new { @class = "dx-button-custom btn-save" })
                .OnClick("saveDeliveryNote") // Bind JS function here
                )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnSaveAndClose")
                .Icon("save")
                .Text(new JS("formatMessage('Save And Close')"))
                .Hint("Save and Close")
                .Width(150)
                .ElementAttr(new { @class = "dx-button-custom btn-save-close" })
                .OnClick("onSaveAndCloseClicked") // Save and go back
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnBack")
                .Text(new JS("formatMessage('Back')"))
                .Icon("arrowleft")
                .Hint("Click to go back")
                .Width(150)
                .ElementAttr(new { @class = "dx-button-custom btn-back" })
                .OnClick("onBackButtonClick")
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnAttach")
                .Icon("attach")
                .Text(new JS("formatMessage('Attach')"))
                .OnClick("onIMSAttachmentButtonClick")
                .ElementAttr(new { @class = "dx-button-custom btn-attach" })
                .Width(200)
                )

    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
                .ID("btnPrint")
                .Text(new JS("formatMessage('Print')"))
                .Icon("print")
                .ElementAttr(new { @class = "bold-button" })
                .DropDownOptions(options => options.Width(280))
                .ShowArrowIcon(false)
                .Items(items =>
                {
                    items.Add()
                        .Text("Custom Report Designs")
                        .Icon("print")
                        .Option("color", "#FF7043"); // Orange

                    items.Add()
                        .Text("Preview Delivery Note")
                        .Icon("file")
                        .Option("color", "#00ACC1"); // Cyan

                    items.Add()
                        .Text("Preview Material Issue Note")
                        .Icon("folder")
                        .Option("color", "#AB47BC"); // Purple

                    items.Add()
                        .Text("Preview Delivery Note (Dot Matrix)")
                        .Icon("folder")
                        .Option("color", "#FBBC05"); // Yellow

                    items.Add()
                        .Text("Preview Delivery Note (with Price)")
                        .Icon("folder")
                        .Option("color", "#EA4335"); // Red

                    items.Add()
                        .Text("Preview Delivery Note (WIth Cost Price)")
                        .Icon("folder")
                        .Option("color", "#34A853"); // Green
                })
                .ItemTemplate(@<text>
                    <div class="custom-dropdown-item">
                        <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                        <div class="item-content">
                            <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                            <div>
                                <div class="item-title"><%- text %></div>
                            </div>
                        </div>
                    </div>
                </text>)
                .OnItemClick("handleDeliveryNote")
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnDelete")
                .Icon("trash")
                .Text(new JS("formatMessage('Delete')"))
                .Hint("Delete")
                .Width(150)
                .ElementAttr(new { @class = "dx-button-custom btn-delete" })
                .OnClick("onDeleteClick")  // <-- Call JS function here
                )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnApprove")
