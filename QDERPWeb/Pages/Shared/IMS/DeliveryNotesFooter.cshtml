        const deliveryNoteNo = $("#deliveryNoteNo").dxTextBox("instance").option("value");
        if (!deliveryNoteNo) {
            DevExpress.ui.notify("Delivery Note No is required!", "error", 2000);
            return;
        }
        $.ajax({
            type: "POST",
            url: `/api/DeliveryNote/ApproveDeliveryNote`,
            contentType: "application/json",
            data: JSON.stringify(deliveryNoteNo),
            success: function (response) {
                if (response && response.success) {
