    });

    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    const layout = JSON.parse(e.target.result);

                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            reader.readAsText(file);
        }
    });
    
    function openLayoutClick(e) {
        $("#loadLayoutInput").click();
    }

    function ChangeRowHeight(newHeight) {
        // Update the row height
        $("#dataGrid .dx-data-row").css("height", newHeight + "px");
        closeSubmenu();
    }
    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function closeSubmenu() {
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });
      

        function saveDeliveryNote(closeAfterSave = false) {
        var isUpdate = $("#btnSave").data("is-update");

        if (window.edits===false) {
            // New mode: generate number first
            $.get("/api/DeliveryNote/GetAutoGeneratedDeliveryNoteNumber")
                .done(function(res) {
                    if (res.success && res.deliveryNoteNo) {
                        console.log("getnewno",res.deliveryNoteNo);
                        $("#deliveryNoteNo").dxTextBox("instance").option("value", res.deliveryNoteNo);
                        // Now call save
                        saveDeliveryNoteWithNumber(res.deliveryNoteNo, closeAfterSave, isUpdate);
                    } else {
                        DevExpress.ui.notify("Failed to generate Delivery Note number", "error", 3000);
                    }
                })
                .fail(function() {
                    DevExpress.ui.notify("Error generating Delivery Note number.", "error", 3000);
                });
        } else {
            // Edit mode: use existing number
            const existingNo = $("#deliveryNoteNo").dxTextBox("instance").option("value");
            saveDeliveryNoteWithNumber(existingNo, closeAfterSave, isUpdate);
        }
    }


          function saveDeliveryNoteWithNumber(deliveryNoteNo, closeAfterSave = false, isUpdate) {
        var isUpdate = $("#btnSave").data("is-update");

        const model = {
            deliveryNoteNo: deliveryNoteNo,
            deliveryDate: $("#deliveryNoteDate").dxDateBox("instance").option("value"),
            clientCode: $("#GetProjectDropDown").dxDropDownBox("instance").option("value"),
            salesPersonCode: $("#ddGetSalesPerson").dxDropDownBox("instance").option("value"),
            clientPono: $("#clientPOnumber").dxTextBox("instance").option("value"),
            clientPodate: $("#ClientPODate").dxDateBox("instance").option("value"),
            attention: $("#ClientRefName").dxTextBox("instance").option("value"),
            clientContactNo: $("#ClientContactNo").dxTextBox("instance").option("value"),
            clientContactEmail: $("#ClientEmail").dxTextBox("instance").option("value"),
            StoreCode: $("#ddStockfromStore").dxDropDownBox("instance").option("value"),
            projectId: $("#ddGetTypeOfRequest").dxDropDownBox("instance").option("value"),
            clientProject: $("#clientProject").dxTextBox("instance").option("value"),
            deliveryNoteRemarks: $("#DeliveryNoteRemarks").dxTextArea("instance").option("value"),
            salesman: $("#Salesman").dxTextBox("instance").option("value"),
            transportedBy: $("#DeliveredBy").dxTextBox("instance").option("value"),
            driversName: $("#DriverName").dxTextBox("instance").option("value"),
            driversId: $("#DriverID").dxTextBox("instance").option("value"),
            vehicleNo: $("#VehicleNo").dxTextBox("instance").option("value"),
            companyBranch: $("#CompanyName").dxSelectBox("instance").option("value"),
            deliveryType: $("#DeliveryType").dxSelectBox("instance").option("value"),
            inventoryMasterGroupId: $("#InventoryGroup").dxSelectBox("instance").option("value"),
            salesOrderNo: $("#SalesOrderNo").dxTextBox("instance").option("value"),
            quotationNo: $("#QuotationNo").dxTextBox("instance").option("value"),
            enquiryRequestNo: $("#EnquiryRequestNo").dxTextBox("instance").option("value"),
            Dnsignatory: $("#Dnsignatory").dxDropDownBox("instance").option("value"),
                CurrencyRate : $('#currencyexchangerate').dxNumberBox("instance")?.option("value"),
                BaseCurrencyId :$("#ddlGoodsGroup4").dxDropDownBox("instance").option("value"),
                CurrencyId : $("#ddlGoodsGroup3").dxDropDownBox("instance").option("value")
        };

        // Get grid data (items)
        const B2BdataGridInstance = $("#B2BdataGrid").dxDataGrid("instance");
        const items = B2BdataGridInstance.getDataSource().items();

        // Call both APIs: 1) save delivery note, 2) save item details
        const saveNote = $.ajax({
            url: '/api/DeliveryNote/SaveDeliveryNote',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(model)
        });

         const saveItems = $.ajax({
        url: '/api/DeliveryNote/SaveOrUpdateDeliveryNoteItems',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            deliveryNoteNo: model.deliveryNoteNo,
            items: items
        })
    });


      Promise.all([saveNote, saveItems])
    .then(function ([noteRes, itemRes]) {
        DevExpress.ui.notify(isUpdate ? "Updated successfully!" : "Saved successfully!", "success", 3000);

        if (!isUpdate) {
            $("#btnSave").dxButton("instance").option("text", "Update");
            $("#btnSave").data("is-update", true);
        }

        // Navigate back after success
        setTimeout(() => {
            window.history.back();
        }, 1000);
    })
    .catch(function (err) {
        DevExpress.ui.notify("Failed to save. " + (err.responseText || ""), "error", 3000);
    });
    }
   


 

        function onDeleteClick() {
        const gscode = $("#StockNoItemCode").dxTextBox("instance").option("value");

        if (!gscode) {
            DevExpress.ui.notify("No item selected to delete.", "warning", 2000);
            return;
        }

        DevExpress.ui.dialog.confirm("Are you sure you want to delete this item?", "Confirm Delete")
            .done(function (dialogResult) {
                if (dialogResult) {
                    // Call API to delete
                    fetch(`/api/StockInventory/DeleteByCode?code=${encodeURIComponent(gscode)}`, {
                        method: 'DELETE'
                    })
                        .then(response => {
                            if (!response.ok) throw new Error("Failed to delete item");
                            return response.json();
                        })
                        .then(result => {
                            if (result.success) {
                                DevExpress.ui.notify("Item deleted successfully.", "success", 2000);
                                setTimeout(() => window.location.reload(), 500);
                            } else {
                                DevExpress.ui.notify(result.message || "Delete failed.", "error", 3000);
                            }
                        })
                        .catch(error => {
                            console.error("Delete error:", error);
                            DevExpress.ui.notify("Error occurred while deleting item.", "error", 3000);
                        });
                }
            });
    }
        function approveDeliveryNote() {
        const deliveryNoteNo = $("#deliveryNoteNo").dxTextBox("instance").option("value");

        if (!deliveryNoteNo) {
            DevExpress.ui.notify("Delivery Note No is required", "error", 3000);
            return;
        }

        // Show confirmation dialog
        DevExpress.ui.dialog.custom({
            title: "Confirm Approval",
            message: "Are you sure you want to approve this Delivery Note?",
            buttons: [
                { text: "Yes", onClick: () => true },
                { text: "No", onClick: () => false }
            ],
            showTitle: true
        }).show().done(function (dialogResult) {
            if (!dialogResult) {
                return; // User clicked "No"
            }

            // Proceed with approval if confirmed
            fetch('/api/DeliveryNote/ApproveDeliveryNote', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(deliveryNoteNo)
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(error => { throw error; });
                }
                return response.json();
            })
            .then(result => {
                DevExpress.ui.notify(result.message, "success", 3000);
                disableEditing(); // Disable form fields after approval
             $("#btnPrint").dxDropDownButton("instance").option("disabled", false);

            })
            .catch(error => {
                DevExpress.ui.notify(error.message || "Approval failed", "error", 3000);
            });
        });
    }



    function disableEditing() {
        // Disable all standard HTML form fields
        $('input, select, textarea').prop('disabled', true);

        // Allowed buttons to NOT disable
        const allowedButtons = ['btnPrint', 'btnBack'];

        // Disable all DevExtreme widgets (TextBox, DateBox, DropDownBox, etc.)
        $(".dx-widget").each(function () {
            const $el = $(this);
            const widgetType = $el.data("dxWidgetName");
            if (!widgetType) return;

            // Skip if element or its closest parent has an allowed ID
            const elId = $el.attr("id") || $el.closest("[id]").attr("id");
            if (allowedButtons.includes(elId)) return;

            try {
                const instance = $el.data(widgetType);
                if (instance && typeof instance.option === "function") {
                    instance.option("disabled", true);
                }
            } catch (e) {
                console.warn("Error disabling widget:", e);
            }
        });

        // Explicitly disable DateBox and DropDownBox (in case missed above)
        $('.dx-datebox, .dx-dropdownbox').each(function () {
            const elId = $(this).attr("id") || $(this).closest("[id]").attr("id");
            if (allowedButtons.includes(elId)) return;

            try {
                const instance = $(this).data("dxDateBox") || $(this).data("dxDropDownBox");
                if (instance && typeof instance.option === "function") {
                    instance.option("disabled", true);
                }
            } catch (e) {
                console.warn("Error disabling DateBox/DropDownBox:", e);
            }
        });

        // Disable buttons (dxButton or dxDropDownButton) except allowed ones
        $('.dx-button, .dx-dropdownbutton').each(function () {
            const id = $(this).attr('id') || $(this).closest("[id]").attr("id");
            if (!id || allowedButtons.includes(id)) return;

            try {
                const btnInstance = $(this).data('dxButton') || $(this).data('dxDropDownButton');
                if (btnInstance && typeof btnInstance.option === "function") {
                    btnInstance.option("disabled", true);
                }
            } catch (e) {
                console.warn("Error disabling button:", e);
            }
        });

        // Disable SelectBox and NumberBox explicitly
        $('.dx-selectbox, .dx-numberbox').each(function () {
            const elId = $(this).attr("id") || $(this).closest("[id]").attr("id");
            if (allowedButtons.includes(elId)) return;

            try {
                const instance = $(this).data("dxSelectBox") || $(this).data("dxNumberBox");
                if (instance && typeof instance.option === "function") {
                    instance.option("disabled", true);
                }
            } catch (e) {
                console.warn("Error disabling widget:", e);
            }
        });

        // Disable editing and deleting in the DataGrid
        const dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
        if (dataGrid) {
            dataGrid.option("editing.allowUpdating", false);
            dataGrid.option("editing.allowDeleting", false);
        }

        // Disable specific buttons explicitly
        ["btnApprove", "btnSave", "btnSaveAndClose", "btnDelete", "btnAddNewPayment"].forEach(id => {
            const btn = $("#" + id).dxButton("instance");
            if (btn) btn.option("disabled", true);
        });
    }




     const DeliverynoteReportMap = {
        "Preview Delivery Note": "PreviewDeliveryNote", // Fixed: matches the item text exactly
        "Preview Material Issue Note": "ReportforMaterialIssueNote",
        "Preview Delivery Note (with Price)": "PreviewDeliveryNotewithPrice",
        "Preview Delivery Note (Dot Matrix)": "DotMatrics",
        "Preview Delivery Note (WIth Cost Price)": "DeliveryNoteWithCostPrice"
    };

       function handleDeliveryNote(e) {
        const itemText = e.itemData?.text?.trim();
        const tenantName = window.tenantName || "";
        const deliveryNote = $("#deliveryNoteNo").dxTextBox("instance").option("value");

        if (!deliveryNote) {
            alert("DeliveryNote number is required.");
            return;
        }

         try {
            const reportName = DeliverynoteReportMap[itemText];

            if (!reportName) {
                alert("Invalid report format selected.");
                return;
            }
                        let url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&DeliveryNoteNo=${encodeURIComponent(deliveryNote)}`;

        const DeliverynoteReport = [
            "Preview Delivery Note",
            "Preview Material Issue Note",
            "Preview Delivery Note (with Price)",
            "Preview Delivery Note (Dot Matrix)",
            "Preview Delivery Note (WIth Cost Price)"
        ];
             if (DeliverynoteReport.includes(itemText)) {
                // Collect parameters only if true
                const params = {
                    PrintFooterAtBottom: $("#hdnPrintFooterAtBottom").val(),
                    ShowItemLineNo: $("#hdnShowItemLineNo").val(),
                    printItemPartArabicDesc: $("#hdnprintItemPartArabicDesc").val(),
                    printItemPartNoDesc: $("#hdnprintItemPartNoDesc").val(),
                    printItemCodeDesc: $("#hdnprintItemCodeDesc").val(),
                    showSeal: $("#hdnshowSeal").val(),
                    showSignature: $("#hdnshowSignature").val(),
                    printLetterhead: $("#hdnprintLetterhead").val()
                };
                    // Append only those that are "true"
                Object.keys(params).forEach(key => {
                    if (params[key] === "true") {
                        url += `&${key}=true`;
                    }
                });
    }
     window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {
            console.error("Failed to open report:", error);
            alert("An error occurred while trying to open the report.");
        }
    }


    function onIMSAttachmentButtonClick(e) {
        // Get Voucher No safely
        const deliveryNoBox = $("#deliveryNoteNo").dxTextBox("instance");
        const deliveryNo = deliveryNoBox ? deliveryNoBox.option("value") : null;
        var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;
        var dataSource = dataGrid.option("dataSource");

        if (rowCount === 0 || rowCount === null) {
            DevExpress.ui.notify(
                "Not allow to Add Attachments. Please enter some transactions in Grid.",
                "warning",
                4000
                );
            return;
        }
        var menuType = "inventory";

        var formType = '';
        var deliveryType = $("#DeliveryType").dxSelectBox("instance");
        var deliveryTypevalue = deliveryType.option("value");
        if (deliveryTypevalue == "1") 
            formType = "Delivery To Client";
        else if (deliveryTypevalue == "2")
            formType = "Delivery To Store";
        else if (deliveryTypevalue == "3")
            formType = "Delivery To Project";
        else if (deliveryTypevalue == "4")
            formType = "Delivery Store Tranfers";
            
        // Log and build URL
        console.log("Voucher No:", deliveryNo);
        console.log("Voucher Type:", formType);

        const isMaster = false;
        const url = `/${tenantName}/Finance/LedgerDocuments?ReferenceNo=${encodeURIComponent(deliveryNo)}&ModuleType=${encodeURIComponent(formType)}&isMaster=${encodeURIComponent(isMaster)}&menuType=${encodeURIComponent(menuType)}&modal=true`;
        const title = "Transaction Documents";

        openModal(url, title);
    }

</script>