<div class="dx-fieldset horizontal-container" style="gap:10px;background-color:transparent;">

    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnSave")
                .Text(new JS("formatMessage('Save')"))
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Outlined)
                .Icon("save")
                .ElementAttr(new { @class = "dx-button-custom btn-save" })
                )

    </div>
    <div class="btn-container">

        @(Html.DevExtreme().Button()
                .ID("btnSaveAndClose")
                .Text(new JS("formatMessage('Save and Close')"))
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Outlined)
                .Icon("save")
                .ElementAttr(new { @class = "dx-button-custom btn-save-close" })
                )
    </div>
    <div class="btn-container">

        @(Html.DevExtreme().Button()
                .ID("btnBack")
                .Text(new JS("formatMessage('Back')"))
                .Icon("arrowleft")
                .ElementAttr(new { @class = "dx-button-custom btn-back" })
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
                .ID("btnPrint3")
                .Text(new JS("formatMessage('Print')"))
                .Icon("print")
                .Width(90)
                .ElementAttr(new { @class = "bold-button" })
                .DropDownOptions(options => options.Width(230))
                .ShowArrowIcon(false)
                .Items(items =>
                {
                    items.Add().Text("Custom Report Designs").Icon("print");
                    items.Add().Text("Preview RFQ").Icon("file");
                })
                .OnItemClick("handleRFQ")
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnDelete")
                .Text(new JS("formatMessage('Delete')"))
                .Icon("close")
                .ElementAttr(new { @class = "dx-button-custom btn-delete" })
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnVerify")
                .Text(new JS("formatMessage('Verify')"))
                .Icon("check")
                .ElementAttr(new { @class = "dx-button-custom btn-verify" })
                )

    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnApprove")
                .Text(new JS("formatMessage('Approve')"))
                .Icon("exportselected")
                .ElementAttr(new { @class = "dx-button-custom btn-approve" })
                )

    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnSubmit")
                .Text(new JS("formatMessage('Submit')"))
                .Icon("check")
                .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class

                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnAddNew")
                .Text(new JS("formatMessage('Add New Item')"))
                .Icon("plus")
                .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnCreatePo")
                .Text(new JS("formatMessage('Create PO')"))
                .Icon("arrowright")
                .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnMoveUp")
                .Text(new JS("formatMessage('Move Up')"))
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Outlined)
                .Icon("spinup") // Change the icon to an up/down arrow option
                .ElementAttr(new { @class = "bold-button" })
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnMoveDown")
                .Text(new JS("formatMessage('Move Down')"))
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Outlined)
                .Icon("spindown") // Change the icon to an up/down arrow option
                .ElementAttr(new { @class = "bold-button" })
                )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddButtonLayout")
            .Icon("smalliconslayout")
            .Width("100%")
            .Text(new JS("formatMessage('Layout')"))
            
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
                items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
                items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
                items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
            })
            .ShowArrowIcon(false)
            )
    </div>
    <div class="btn-container">
    @(Html.DevExtreme().DropDownButton()
            .ID("rowHeightProperties")
            .Icon("") // fallback to standard icon if "rowproperties" not working
            .Width(50)
            .Text(new JS("formatMessage('Set Row Height')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add()
                .Text("Short (1 Line)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="9" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Short
                           </text>)
                .OnClick("function() { ChangeRowHeight('30'); }");

                items.Add()
                .Text("Medium (2 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="6" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Medium
                           </text>)
                .OnClick("function() { ChangeRowHeight('60'); }");

                items.Add()
                .Text("Tall (4 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="4" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="8" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="16" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Tall
                           </text>)
                .OnClick("function() { ChangeRowHeight('90'); }");

                items.Add()
                .Text("Extra Tall (8 Lines)")
                .Template(@<text>
            <svg width="20" height="20" viewBox="0 0 20 20">
                @for (var i = 1; i <= 8; i++)
                        {
                            var y = 1 + (i - 1) * 2;
                            <text><rect x="2" y="@y" width="16" height="1" fill="var(--title-background-color)" /></text>
                        }
            </svg> Extra Tall
        </text>)
                .OnClick("function() { ChangeRowHeight('130'); }");
            })
            .ShowArrowIcon(false)
    )
</div>
</div>

<script>
       
    
  
        function showSubmenu(e) {
            e.event.stopPropagation();
            var $submenu = $('#submenuContainer');
            var $target = $(e.event.target).closest('.dx-item-content');
            var offset = $target.offset();
            var elementWidth = $target.outerWidth();

            // Position submenu with a slight margin (e.g., 5px)
            $submenu.css({
                'width': 180,
                'position': 'absolute',
                'top': offset.top,
                'left': offset.left + elementWidth + 5, // Add margin
                'display': 'block'
            });
        }

        function closeSubmenu() {
            $("#submenuContainer").hide();
        }
             function addNewMaterialRequest(e) {
            let url = ''; // Declare once
            switch (e.itemData.text) {
                case formatMessage('Add New Client Request'):
                    url = `/${tenantName}/IMS/AddNewClientRequest`;
                    break;
                case formatMessage('Add New Store Request'):
                    url = `/${tenantName}/IMS/MRAddNewStoreRequest`;
                    break;
                case formatMessage('Add New Project Request'):
                    url = `/${tenantName}/IMS/MRAddNewProjectRequest`;
                    break;
                default:
                    console.log("Clicked item: ", e.itemData.text);
                    return;
            }

            window.location.href = url;
        }
                 async function handleCreditReportPrinting(e) {

           debugger;

        const itemText = e.itemData?.text;

        let requestNo = $("#txtRequestNo").dxTextBox("instance").option("value");

        if (!requestNo) {

            alert("RequestNo  is required.");

            return;

        }

        try {

            const isApproved = await checkInvoiceApprovalStatus1(requestNo);

            const watermarkText = isApproved ? "" : "Draft Copy";

            let reportName = "";

            switch (itemText) {

                case "Preview Request":

                        reportName = "MaterialRequestInventory";

                    break;

                case "Preview Request(With Expected Unit Price)":

                    reportName = "MaterialPurcchaseRequestion";

                    break;

                default:

                    alert("Invalid report format selected.");

                    return;

            }

            const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&RequestNo=${encodeURIComponent(requestNo)}&skipPreview=true&watermark=${encodeURIComponent(watermarkText)}&isApproved=${isApproved}`;

            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {

            console.error("Error checking approval status:", error);

            alert("Failed to check invoice approval status.");

        }

    }

    async function checkInvoiceApprovalStatus1(requestNo) {

        try {

            const response = await $.ajax({


                url: `/api/AddNewClientRequest/GetRequestNoteApprovalStatus/${encodeURIComponent(requestNo)}`,

                method: 'GET',

                dataType: 'json',

            });

            return response?.isApproved ?? false;

        } catch (error) {

            console.error("Error fetching approval status:", error);

            return false;

        }

    }
    



    const RFQMap = {
        "Preview RFQ": "RFQEdit"
    };

    function handleRFQ(e) {
        const itemText = e.itemData?.text;
        const tenantName = window.tenantName || "";
        const rfqNo = $("#RFQNo").dxTextBox("instance").option("value");

        if (!rfqNo) {
            alert("RFQ number is required.");
            return;
        }

        const reportName = RFQMap[itemText];

        if (!reportName) {
            alert("Invalid report format selected.");
            return;
        }


        const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&rfqNo=${encodeURIComponent(rfqNo)}`;

        window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
    }
</script>
