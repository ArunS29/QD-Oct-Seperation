        //             break;
        //         default:
        //             console.log("Clicked item: ", e.itemData.text);
        //             return;
        //     }

        //     window.location.href = url;
        // }

          function addNewMaterialReceipt(e) {
        let url = ''; // Declare once
        switch (e.itemData.text) {
            case formatMessage('Add New Material Receipt-From Supplier'):
                url = `/${tenantName}/IMS/MaterialReceiptFromSupplier`;
                break;
            case formatMessage('Add New Material Receipt-From Project'):
                url = `/${tenantName}/IMS/MaterialReceiptFromProject`;
                break;
          
            default:
                console.log("Clicked item: ", e.itemData.text);
                return;
        }

        window.location.href = url;
    }
</script>
