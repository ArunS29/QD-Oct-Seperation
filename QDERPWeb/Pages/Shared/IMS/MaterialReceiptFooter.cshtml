    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
                .ID("btnAddMaterialRequest")
                .Icon("add")
                .Width("150%")
                .Text(new JS("formatMessage('Create New')"))
                .DropDownOptions(options => options.Width(370))
                .Items(items =>
                {
                    items.Add().Text(new JS("formatMessage('Add New Material Receipt-From Supplier')")).Icon("user").Option("color", "#FF7043");
                    items.Add().Text(new JS("formatMessage('Add New Material Receipt-From Project')")).Icon("cart").Option("color", "#00ACC1");
                  
                })
                .ItemTemplate(@<text>
            <div class="custom-dropdown-item">
                <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                <div class="item-content">
                    <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                    <div>
                        <div class="item-title"><%- text %></div>
                    </div>
                </div>
            </div>
        </text>)
                .OnItemClick("addNewMaterialReceipt")
                .ShowArrowIcon(false)
                )
    </div>
</div>

<script>
        
  
        function showSubmenu(e) {
            e.event.stopPropagation();
            var $submenu = $('#submenuContainer');
            var $target = $(e.event.target).closest('.dx-item-content');
            var offset = $target.offset();
            var elementWidth = $target.outerWidth();

            // Position submenu with a slight margin (e.g., 5px)
            $submenu.css({
                'width': 180,
                'position': 'absolute',
                'top': offset.top,
                'left': offset.left + elementWidth + 5, // Add margin
                'display': 'block'
            });
        }

        function closeSubmenu() {
            $("#submenuContainer").hide();
        }
  
        function MaterialReceiptDetails() {
            window.location.href = `/${tenantName}/IMS/MaterialReceiptDetails`;
        }
        // function addNewMaterialReceipt(e) {
