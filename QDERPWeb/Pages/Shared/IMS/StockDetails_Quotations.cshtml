@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
@{
    ViewBag.Title = "Invoice Grid";
}
 @{ 
    var dummyData = new[] {
    new { QuoteNo = "INV001", QuoteDate = DateTime.Now.AddDays(-3), ClientName = "John Doe", Qty = 3, UnitPrice=200, Discount = 10m, VatAmount = 5m },
     new { QuoteNo = "INV002", QuoteDate = DateTime.Now.AddDays(-2), ClientName = "Jane Smith", Qty = 2,  UnitPrice=200, Discount = 20m, VatAmount = 10m },
     new { QuoteNo = "INV003", QuoteDate = DateTime.Now.AddDays(-1), ClientName = "Acme Corp", Qty = 5,  UnitPrice=200, Discount = 15m, VatAmount = 7.5m }
 };
 }  


<style>

</style>
@(Html.DevExtreme().DropDownButton()
    .ID("Dropdown")
    .Text(new JS("formatMessage('Print')"))
    .Icon("print")
  .ElementAttr("style", "padding:10px")
    .DisplayExpr("Text")
    .KeyExpr("Text")
    .ItemTemplate(@<text>
    <div style="display: flex; align-items: center;">
        <i class="dx-icon-<%- Icon %>" style="padding:10px;"></i>
        <span><%- Text %></span>
    </div>
</text>)

)


<div class="dx-card " style="background-color:transparent; border:none;padding:10px;">
   

    @(Html.DevExtreme().DataGrid()
            .ID("quotationGrid")
            .Height(620)
            .DataSource(dummyData)
            .ShowBorders(true)
            .ShowColumnLines(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ColumnAutoWidth(true)
            .Columns(columns =>
            {
            columns.Add().DataField("QuoteNo").Caption(new JS("formatMessage('Quote No')"));
                columns.Add().DataField("QuoteDate").Caption(new JS("formatMessage('Quote Date')")).DataType(GridColumnDataType.Date);
                columns.Add().DataField("ClientName").Caption(new JS("formatMessage('Client Name')"));
                columns.Add().DataField("Qty").Caption(new JS("formatMessage('Qty')")).DataType(GridColumnDataType.Number);
            columns.Add().DataField("UnitPrice").Caption(new JS("formatMessage('Unit Price')"));
            columns.Add().DataField("Discount").Caption(new JS("formatMessage('Discount')")).Format("##,##0.00");
            columns.Add().DataField("VatAmount").Caption(new JS("formatMessage('VAT Amount')")).Format("##,##0.00");
            })
            .Summary(summary =>
            {
                summary.TotalItems(items =>
                {
                items.Add().Column("QuoteNo").SummaryType(SummaryType.Count).DisplayFormat(" {0}");

                    items.Add().Column("Qty").SummaryType(SummaryType.Sum).ValueFormat("##,##0");
                    items.Add().Column("Discount").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
                    items.Add().Column("VatAmount").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
                });
            })
            )
</div>

