@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
@{
    ViewBag.Title = "Purchases Grid";
}
@{
    var dummyData = new[] {
    new { InvoiceNo = "INV001", InvoiceDate = DateTime.Now.AddDays(-3), ClientName = "John Doe", Qty = 3, UnitDesc = "Product A", UnitRate = 100m, Discount = 10m, VatAmount = 5m, Total = 295m },
     new { InvoiceNo = "INV002", InvoiceDate = DateTime.Now.AddDays(-2), ClientName = "Jane Smith", Qty = 2, UnitDesc = "Product B", UnitRate = 200m, Discount = 20m, VatAmount = 10m, Total = 390m },
     new { InvoiceNo = "INV003", InvoiceDate = DateTime.Now.AddDays(-1), ClientName = "Acme Corp", Qty = 5, UnitDesc = "Product C", UnitRate = 150m, Discount = 15m, VatAmount = 7.5m, Total = 732.5m }
 }; 
}  


<style>

</style>
@(Html.DevExtreme().DropDownButton()
    .ID("purchaseDropdown")
    .Text(new JS("formatMessage('Print')"))
    .Icon("print")
    .ElementAttr("style", "padding:10px")
    .DisplayExpr("Text")
    .KeyExpr("Text")
    .ItemTemplate(@<text>
    <div style="display: flex; align-items: center;">
        <i class="dx-icon-<%- Icon %>" style="padding:10px;"></i>
        <span><%- Text %></span>
    </div>
</text>)

)


<div class="dx-card " style="background-color:transparent; border:none;padding:10px;">
  

    @(Html.DevExtreme().DataGrid()
            .ID("PurchaseGrid")
            .Height(620)
            .DataSource(dummyData)
            .ShowBorders(true)
            .ShowColumnLines(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ColumnAutoWidth(true)
            .Columns(columns =>
            {
            columns.Add().DataField("ItemCode").Caption(new JS("formatMessage('Item Code')"));
            columns.Add().DataField("PurchaseVoucherNo").Caption(new JS("formatMessage('Purchase Voucher No')"));
            columns.Add().DataField("PurchaseVoucherDate").Caption(new JS("formatMessage('Purchase Voucher Date')"));
            columns.Add().DataField("InventoryEffectiveDate").Caption(new JS("formatMessage('Inventory Effective Date')"));
            columns.Add().DataField("QuantityInvoiced").Caption(new JS("formatMessage('Quantity Invoiced')"));

            columns.Add().DataField("UnitDesc").Caption(new JS("formatMessage('Unit Desc')"));
            columns.Add().DataField("UnitRate").Caption(new JS("formatMessage('Unit Rate')"));
            columns.Add().DataField("Discount").Caption(new JS("formatMessage('Discount')")).Format("##,##0.00");
            columns.Add().DataField("TotalAfterDisc").Caption(new JS("formatMessage('Total After Disc')")).Format("##,##0.00");
            columns.Add().DataField("TaxAmount").Caption(new JS("formatMessage('Tax Amount')")).Format("##,##0.00");
            columns.Add().DataField("TotalWithTax").Caption(new JS("formatMessage('Total With Tax')")).Format("##,##0.00");

            })
            .Summary(summary =>
            {
                summary.TotalItems(items =>
                {
                items.Add().Column("TaxAmount").SummaryType(SummaryType.Count).DisplayFormat(" {0}");
                items.Add().Column("TotalAfterDisc").SummaryType(SummaryType.Sum).ValueFormat("##,##0");
                    items.Add().Column("Discount").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
                items.Add().Column("TotalWithTax").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
                });
            })
            )
</div>
