@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
@{
    ViewBag.Title = "Invoice Grid";
}
@{
    var dummyData = new[] {
    new { PONo = "INV001", PODate = DateTime.Now.AddDays(-3), SupplierName = "John Doe", Qty = 3, UnitPrice=200, Discount = 10m, VatAmount = 5m, Total = 295m },
     new { PONo = "INV002", PODate = DateTime.Now.AddDays(-2), SupplierName = "Jane Smith", Qty = 2, UnitPrice=200, Discount = 20m, VatAmount = 10m, Total = 390m },
     new { PONo = "INV003", PODate = DateTime.Now.AddDays(-1), SupplierName = "Acme Corp", Qty = 5, UnitPrice=200, Discount = 15m, VatAmount = 7.5m, Total = 732.5m }
 };
}


<style>

</style>
@(Html.DevExtreme().DropDownButton()
    .ID("ItemReceivedDropdown")
    .Text(new JS("formatMessage('Print')"))
    .Icon("print")
  .ElementAttr("style", "padding:10px")
    .DisplayExpr("Text")
    .KeyExpr("Text")
    .ItemTemplate(@<text>
    <div style="display: flex; align-items: center;">
        <i class="dx-icon-<%- Icon %>" style="padding:10px;"></i>
        <span><%- Text %></span>
    </div>
</text>)

)


<div class="dx-card " style="background-color:transparent; border:none;padding:10px;">
   

    @(Html.DevExtreme().DataGrid()
        .ID("ItemReceivedGrid")
        .Height(620)
        .DataSource(dummyData)
        .ShowBorders(true)
        .ShowColumnLines(true)
        .ShowRowLines(true)
        .RowAlternationEnabled(true)
        .ColumnAutoWidth(true)
        .Columns(columns =>
        {
            columns.Add().DataField("ReceiptNo").Caption(new JS("formatMessage('Receipt No')"));
            columns.Add().DataField("ReceiptDate").Caption(new JS("formatMessage('Receipt Date')")).DataType(GridColumnDataType.Date);
            columns.Add().DataField("SupplierName").Caption(new JS("formatMessage('Supplier Name')"));
            columns.Add().DataField("Qty").Caption(new JS("formatMessage('Qty')")).DataType(GridColumnDataType.Number);
            columns.Add().DataField("UnitDesc").Caption(new JS("formatMessage('Unit Desc')"));
            columns.Add().DataField("UnitPrice").Caption(new JS("formatMessage('Unit Price')"));
            columns.Add().DataField("Discount").Caption(new JS("formatMessage('Discount')")).Format("##,##0.00");
            columns.Add().DataField("VatAmount").Caption(new JS("formatMessage('VAT Amount')")).Format("##,##0.00");
            columns.Add().DataField("Total").Caption(new JS("formatMessage('Total')")).Format("##,##0.00");
        })
        .Summary(summary =>
        {
            summary.TotalItems(items =>
            {
                items.Add().Column("ReceiptNo").SummaryType(SummaryType.Count).DisplayFormat(" {0}");
                items.Add().Column("Qty").SummaryType(SummaryType.Sum).ValueFormat("##,##0");
                items.Add().Column("Discount").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
                items.Add().Column("VatAmount").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
                items.Add().Column("Total").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
            });
        })
        )
</div>
