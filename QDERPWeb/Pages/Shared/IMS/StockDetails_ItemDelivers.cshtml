@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders
@{
    ViewBag.Title = "ItemDelivers Grid";
}
@{
 
}


<style>

</style>
@(Html.DevExtreme().DropDownButton()
    .ID("ItemDeliversDropdown")
    .Text(new JS("formatMessage('Print')"))
    .Icon("print")
  .ElementAttr("style", "padding:10px")
    .DisplayExpr("Text")
    .KeyExpr("Text")
    .ItemTemplate(@<text>
    <div style="display: flex; align-items: center;">
        <i class="dx-icon-<%- Icon %>" style="padding:10px;"></i>
        <span><%- Text %></span>
    </div>
</text>)

)


<div class="dx-card " style="background-color:transparent; border:none;padding:10px;">
  

    @(Html.DevExtreme().DataGrid()
        .ID("ItemDeliversGrid")
        .Height(620)
        .ShowBorders(true)
        .ShowColumnLines(true)
        .ShowRowLines(true)
        .RowAlternationEnabled(true)
        .ColumnAutoWidth(true)
        .Columns(columns =>
        {
            columns.Add().DataField("DeliveryNoteNo").Caption(new JS("formatMessage('Delivery Note No')"));
            columns.Add().DataField("DeliveryDate").Caption(new JS("formatMessage('Delivery Date')")).DataType(GridColumnDataType.Date);
            columns.Add().DataField("Status").Caption(new JS("formatMessage('Status')"));
            columns.Add().DataField("InvoiceNo").Caption(new JS("formatMessage('Invoice No')"));
            columns.Add().DataField("IssuedFromStore").Caption(new JS("formatMessage('Issued From(Store)')"));
            columns.Add().DataField("IssuedTo").Caption(new JS("formatMessage('Issued To')"));

            columns.Add().DataField("Qty").Caption(new JS("formatMessage('Qty')")).DataType(GridColumnDataType.Number);
            columns.Add().DataField("UnitPrice").Caption(new JS("formatMessage('Unit Price')"));
            columns.Add().DataField("Total").Caption(new JS("formatMessage('Total')")).Format("##,##0.00");

        })
        .Summary(summary =>
        {
            summary.TotalItems(items =>
            {
                items.Add().Column("DeliveryNoteNo ").SummaryType(SummaryType.Count).DisplayFormat(" {0}");
                items.Add().Column("Qty").SummaryType(SummaryType.Sum).ValueFormat("##,##0");
                items.Add().Column("Total").SummaryType(SummaryType.Sum).ValueFormat("##,##0.00");
            });
        })
        )
</div>

