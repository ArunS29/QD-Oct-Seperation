<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
<script src="https://unpkg.com/@@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>

<style type="text/css">

    .workflow-container {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        /* padding: 16px 0; */
        background: #fff;
        border-radius: 12px;
        gap: 10px;
        height: 48px;
    }

    /* FIXED: Single full connector line behind steps */
    .workflow-line {
        position: absolute;
        top: 19px;
        /* right: 10px; */
        left: 25px;
        width: 97%;
        height: 2px;
        background: #d1d5db;
        z-index: 0;
        pointer-events: none;
        transition: background 0.3s ease;
    }

    .workflow-step {
        padding-right: 20px;
        padding-left: 20px;
        text-align: center;
        position: relative;
        transition: all 0.3s ease;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .step-circle {
        width: 36px;
        height: 36px;
        margin: 0 auto;
        border-radius: 50%;
        background: #d1d5db;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
        z-index: 2;
        transition: background 0.3s ease;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .step-label {
        /* margin-top: 6px; */
        font-weight: 500;
        font-size: 12px;
        color: #4b5563;
        transition: color 0.3s ease;
    }

    .step-status-msg {
        margin-top: 9px;
        font-size: 11px;
        font-weight: 600;
        color: #9ca3af;
        opacity: 1;
        transform: translateY(-4px);
        transition: all 0.3s ease;
    }

    /* Status-based Colors */
    .workflow-step.completed .step-circle {
        background: #10b981;
    }

    .workflow-step.completed .step-label,
    .workflow-step.completed .step-status-msg {
        color: #10b981;
    }

    .workflow-step.current .step-circle {
        background: #3b82f6;
    }

    .workflow-step.current .step-label {
        color: #3b82f6;
    }

    .workflow-step.current .step-status-msg {
        color: #3b82f6;
        opacity: 1;
    }

    .workflow-step.upcoming .step-circle {
        background: #d1d5db;
    }

    .workflow-step.upcoming .step-label,
    .workflow-step.upcoming .step-status-msg {
        color: #9ca3af;
    }

    /* Optional: Hover Animation */
    .workflow-step:hover .step-circle {
        transform: scale(1.05);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
    }

    .popover-box {
        position: absolute;
        background-color: #fff;
        border: 1px solid #ccc;
        padding: 8px 12px;
        border-radius: 6px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        font-size: 13px;
        display: none;
        z-index: 9999;
        white-space: nowrap;
    }

    .footer-fixed {
        bottom: 35px !important;
    }
</style>
<div class="WorkFlow">
    <div class="workflow-container">
        <div class="workflow-line"></div>

        <div class="workflow-step" id="step-update">
            <div class="step-circle"><i class="fas fa-user"></i></div>
            <div class="workflowText">
                <div class="step-label">Updated</div>
                <div class="step-status-msg"> - In Progress</div>
            </div>
        </div>
        <div class="workflow-step" id="step-submit">
            <div class="step-circle" id="circle-submit"><i class="fas fa-paper-plane"></i></div>
            <div class="workflowText">
                <div class="step-label">Submitted</div>
                <div class="step-status-msg"> - Pending</div>
            </div>
        </div>

        <div class="workflow-step" id="step-verify">
            <div class="step-circle" id="circle-verify"><i class="fas fa-briefcase"></i></div>
            <div class="workflowText">
                <div class="step-label">Verified</div>
                <div class="step-status-msg"> - Waiting</div>
            </div>
        </div>

        <div class="workflow-step" id="step-approve">
            <div class="step-circle" id="circle-approve"><i class="fas fa-file-alt"></i></div>
            <div class="workflowText">
                <div class="step-label">Approved</div>
                <div class="step-status-msg"> - Pending</div>
            </div>
        </div>

        <div id="verifyPopover" class="popover-box">Verified by: <span id="verifiedByName"></span><br>On: <span id="verifiedOn"></span></div>
        <div id="approvePopover" class="popover-box">Approved by: <span id="approvedByName"></span><br>On: <span id="approvedOn"></span></div>

    </div>
</div>
<div class="horizontal-container1">
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                    .ID("btnSave")
                    .Text(new JS("formatMessage('Save')"))
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    .Icon("save")
                    .ElementAttr(new { @class = "dx-button-custom btn-save" })
                    )

    </div>
    <div class="btn-container">

        @(Html.DevExtreme().Button()
                    .ID("btnSaveAndClose")
                    .Text(new JS("formatMessage('Save and Close')"))
                    .Type(ButtonType.Normal)
                    .StylingMode(ButtonStylingMode.Outlined)
                    .Icon("save")
                    .ElementAttr(new { @class = "dx-button-custom btn-save-close" })
                    )
    </div>

    <div class="btn-container">

        @(Html.DevExtreme().Button()
                    .ID("btnBack")
                    .Text(new JS("formatMessage('Back')"))
                    .Icon("arrowleft")
                    .ElementAttr(new { @class = "dx-button-custom btn-back" })
                    )
    </div>
    <div class="btn-container">
        @(
            Html.DevExtreme().Button()
                .ID("btnAttach")
                .Text(new JS("formatMessage('Attach')"))
                .Icon("attach")
                .OnClick("onIMSAttachmentButtonClick")
                .ElementAttr(new { @class = "dx-button-custom btn-attach" })
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
                .ID("btnPrint1")
                .Text(new JS("formatMessage('Print')"))
                .Icon("print")
                .ElementAttr(new { @class = "bold-button" })
                .DropDownOptions(options => options.Width(320))
                .ShowArrowIcon(false)
                .Items(items =>
                {
                    items.Add().Text(new JS("formatMessage('Preview Quotation')")).Icon("folder").Option("color", "#FF7043");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(W/O Discount Column)')")).Icon("folder").Option("color", "#00ACC1");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(W / o VAT)')")).Icon("folder").Option("color", "#AB47BC");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(W/o VAT & W/o TotalPrice)')")).Icon("folder").Option("color", "#FBBC05");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(W/o VAT & W/o Discount)')")).Icon("folder").Option("color", "#EA4335");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(With Addl Details)')")).Icon("folder").Option("color", "#34A853");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(Without Price)')")).Icon("folder").Option("color", "#4285F4");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(With Item Image)')")).Icon("folder").Option("color", "#FF7043");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(With Group Code)')")).Icon("folder").Option("color", "#00ACC1");
                    items.Add().Text(new JS("formatMessage('Preview Quotation(With Sub Group)')")).Icon("folder").Option("color", "#AB47BC");
                    items.Add().Text(new JS("formatMessage('Prepare Cost Sheet')")).Icon("money").Option("color", "#34A853");
                })
                .ItemTemplate(@<text>
                    <div class="custom-dropdown-item">
                        <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                        <div class="item-content">
                            <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                            <div>
                                <div class="item-title"><%- text %></div>
                            </div>
                        </div>
                    </div>
                </text>)
                .OnItemClick("handleQuatation")
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnDelete")
                .Text(new JS("formatMessage('Delete')"))
                .Icon("close")
                .ElementAttr(new { @class = "dx-button-custom btn-delete" })
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnAddNew")
                .Text(new JS("formatMessage('Add New Item')"))
                .Icon("plus")
                .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnSubmit")
                .Text(new JS("formatMessage('Submit')"))
                .Icon("check")
                .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnVerify")
                .Text(new JS("formatMessage('Verify')"))
                .Icon("check")
                .ElementAttr(new { @class = "dx-button-custom btn-verify" })

                )

    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnApprove")
                .Text(new JS("formatMessage('Approve')"))
                .Icon("exportselected")
                .ElementAttr(new { @class = "dx-button-custom btn-approve" })
                )

    </div>
    
</div>

<script>
       
    
  
        function showSubmenu(e) {
            e.event.stopPropagation();
            var $submenu = $('#submenuContainer');
            var $target = $(e.event.target).closest('.dx-item-content');
            var offset = $target.offset();
            var elementWidth = $target.outerWidth();

            // Position submenu with a slight margin (e.g., 5px)
            $submenu.css({
                'width': 180,
                'position': 'absolute',
                'top': offset.top,
                'left': offset.left + elementWidth + 5, // Add margin
                'display': 'block'
            });
        }

        function closeSubmenu() {
            $("#submenuContainer").hide();
        }
             function addNewMaterialRequest(e) {
            let url = ''; // Declare once
            switch (e.itemData.text) {
                case formatMessage('Add New Client Request'):
                    url = `/${tenantName}/IMS/AddNewClientRequest`;
                    break;
                case formatMessage('Add New Store Request'):
                    url = `/${tenantName}/IMS/MRAddNewStoreRequest`;
                    break;
                case formatMessage('Add New Project Request'):
                    url = `/${tenantName}/IMS/MRAddNewProjectRequest`;
                    break;
                default:
                    console.log("Clicked item: ", e.itemData.text);
                    return;
            }

            window.location.href = url;
        }
                 async function handleCreditReportPrinting(e) {

           

        const itemText = e.itemData?.text;

        let requestNo = $("#txtRequestNo").dxTextBox("instance").option("value");

        if (!requestNo) {

            alert("RequestNo  is required.");

            return;

        }

        try {

            const isApproved = await checkInvoiceApprovalStatus1(requestNo);

            const watermarkText = isApproved ? "" : "Draft Copy";

            let reportName = "";

            switch (itemText) {

                case "Preview Request":

                        reportName = "MaterialRequestInventory";

                    break;

                case "Preview Request(With Expected Unit Price)":

                    reportName = "MaterialPurcchaseRequestion";

                    break;

                default:

                    alert("Invalid report format selected.");

                    return;

            }

            const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&RequestNo=${encodeURIComponent(requestNo)}&skipPreview=true&watermark=${encodeURIComponent(watermarkText)}&isApproved=${isApproved}`;

            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {

            console.error("Error checking approval status:", error);

            alert("Failed to check invoice approval status.");

        }

    }

    async function checkInvoiceApprovalStatus1(requestNo) {

        try {

            const response = await $.ajax({


                url: `/api/AddNewClientRequest/GetRequestNoteApprovalStatus/${encodeURIComponent(requestNo)}`,

                method: 'GET',

                dataType: 'json',

            });

            return response?.isApproved ?? false;

        } catch (error) {

            console.error("Error fetching approval status:", error);

            return false;

        }

    }
           const quotationReportMap = {
        "Preview Quotation": "PreviewQuotations",
        "Preview Quotation(W/O Discount Column)": "wtDiscount",
        "Preview Quotation(W/o VAT)":"QuotationWOvat",
        "Preview Quotation(W/o VAT & W/o TotalPrice)":"vatTotalPricewithout",
        "Preview Quotation(W/o VAT & W/o Discount)":"withoutvatDiscount",
        "Preview Quotation(With Addl Details)":"PreviewQuotationwithadditionalDetails",
        "Preview Quotation(Without Price)":"PreviewQuotationwithoutPrice",
        "Preview Quotation(With Item Image)":"PreviewQuotationWithImage",
        "Preview Quotation(With Group Code)":"GroupCode",
        "Preview Quotation(With Sub Group)":"PreviewQuotationWithSubGroup"
         };


    function handleQuatation(e) {
        alert('History trig')
        const itemText = e.itemData?.text;
        const tenantName = window.tenantName || "";
        const quotationNo = $("#txtQuotationNo").dxTextBox("instance").option("value");

        if (!quotationNo && itemText.includes("Quotation")) {
            alert("Quotation number is required.");
            return;
        }

        try {
            const reportName = quotationReportMap[itemText];

            if (!reportName) {
                alert("Invalid report format selected.");
                return;
            }

            const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&QuotationNo=${encodeURIComponent(quotationNo)}`;
            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {
            console.error("Failed to open report:", error);
            alert("An error occurred while trying to open the report.");
        }
    }

    function onIMSAttachmentButtonClick(e) {
        // Get Voucher No safely
        const materialRecNoBox = $("#txtMaterialReceiptNo").dxTextBox("instance");
        const materialReceiptNo = materialRecNoBox ? materialRecNoBox.option("value") : null;
        var dataGrid = $("#B2BdataGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;
        var dataSource = dataGrid.option("dataSource");

        if (rowCount === 0 || rowCount === null) {
            DevExpress.ui.notify(
                "Not allow to Add Attachments. Please enter some transactions in Grid.",
                "warning",
                4000
                );
            return;
        }
        var menuType = "inventory";


        var formType ="Material Receipts";
        // Log and build URL
        console.log("Voucher No:", materialReceiptNo);
        console.log("Voucher Type:", formType);

        const isMaster = false;
        const url = `/${tenantName}/Finance/LedgerDocuments?ReferenceNo=${encodeURIComponent(materialReceiptNo)}&ModuleType=${encodeURIComponent(formType)}&isMaster=${encodeURIComponent(isMaster)}&menuType=${encodeURIComponent(menuType)}&modal=true`;
        const title = "Transaction Documents";

        openModal(url, title);
    }
</script>
