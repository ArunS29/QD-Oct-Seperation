                            "ddButtonPayment": { "Visible": false, "Enabled": false },
                            "ddOtherVouchers": { "Visible": false, "Enabled": false },
                            "ddReports": { "Visible": false, "Enabled": false },
                             "btnRefresh": { "Visible": false, "Enabled": false },
                                "btnAddClientLeads": { "Visible": false, "Enabled": false },
                                "btnAddSuppliers": { "Visible": false, "Enabled": false },
                                  "btnRequestEnquiry": { "Visible": false, "Enabled": false },
