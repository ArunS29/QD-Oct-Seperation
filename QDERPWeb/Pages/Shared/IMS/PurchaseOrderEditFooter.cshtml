                             "btnAddNewQuotation": { "Visible": false, "Enabled": false },
                             "btnAddSalesOrder": { "Visible": false, "Enabled": false },
                             "btnDeliveryNotePosting": { "Visible": false, "Enabled": false },
                             "btnDeliveryNoteDetails": { "Visible": false, "Enabled": false },
                             "btnAddDeliverynote": { "Visible": false, "Enabled": false },
                             "btnSalesOrderDetails": { "Visible": false, "Enabled": false },
                             "btnRfqDetails": { "Visible": false, "Enabled": false },
                             "btnAddNewRFQ": { "Visible": false, "Enabled": false },
                             "btnCreateQuotations": { "Visible": false, "Enabled": false },
                             "btnPurchaseOrderDetails": { "Visible": false, "Enabled": false },
                             "btnNewPurchaseOrder": { "Visible": false, "Enabled": false },
                             "btnMaterialReceiptDetails": { "Visible": false, "Enabled": false },
                             "btnAddNewReceipt": { "Visible": false, "Enabled": false },
                             "btnAddNewJobOrder": { "Visible": false, "Enabled": false },
                             "btnAddNewStockAdjustment": { "Visible": false, "Enabled": false },
                             "btnStockAdjustmentDetails": { "Visible": false, "Enabled": false },
                           "btnSave":{ "Visible": false, "Enabled": false },
                        "btnMoveDown": { "Visible": false, "Enabled": false },
                        "btnMoveUp": { "Visible": false, "Enabled": false },
                        "btnSaveAndClose": { "Visible": false, "Enabled": false },
                        "btnAddNew": { "Visible": false, "Enabled": false },
                        "btnDelete": { "Visible": false, "Enabled": false },
                         "btnUpdate": { "Visible": false, "Enabled": false },
                        "btnBack": { "Visible": false, "Enabled": false },
                        "btnSubmit": { "Visible": false, "Enabled": false },
                        "btnVerify": { "Visible": false, "Enabled": false },
                        "btnApprove": { "Visible": false, "Enabled": false },
                        "btnCancel": { "Visible": false, "Enabled": false },
                        "btnAttach": { "Visible": false, "Enabled": false },
                        "btnUpload": { "Visible": false, "Enabled": false },
                        "btnQuotationDetails": { "Visible": false, "Enabled": false },
                        "btnPurchaseEditDetails": { "Visible": false, "Enabled": false },
                        };


                        // Check for full access
                        var fullAccess = response.permissions.find(p =>
                            p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
                        );

                        if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
                            // Grant full access: make all controls visible and enabled
                            Object.keys(controlStates).forEach(key => {
                                controlStates[key] = { "Visible": true, "Enabled": true };
                            });
                        } else {
                            // Update states based on specific permissions for each control
                            Object.keys(controlStates).forEach(key => {
                                var controlPermission = response.permissions.find(p =>
                                    p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
                                );
                                if (controlPermission) {
                                    controlStates[key] = {
                                        "Visible": controlPermission.ItemVisible || false,
                                        "Enabled": controlPermission.ItemEnabled || false
                                    };
                                }
                            });
                        }

                        console.log("Control States:", controlStates); // Log the control states

                        // Dynamically update button visibility and enabled state
                        Object.keys(controlStates).forEach(key => {
                            var button = document.getElementById(key);
                            if (button) {
