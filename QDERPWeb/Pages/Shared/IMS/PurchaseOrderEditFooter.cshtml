        function handlePurchase(e) {
        const itemText = e.itemData?.text;
        const tenantName = window.tenantName || "";
        const purchaseNo = $("#PurchaseOrderNo").dxTextBox("instance").option("value");

        if (!purchaseNo) {
            DevExpress.ui.notify("Purchase order number is required.", "error", 3000);
            return;
        }

        try {
            // Special case for "Distribute Discount Amount"
            if (itemText === "Distribute Discount Amount") {
                const url = `/${tenantName}/IMS/PODiscountDistribution?purchaseOrderNo=${encodeURIComponent(purchaseNo)}`;
                window.location.href = url;
                return;
            }

            // Normal report handling
            const reportName = PurchaseMap[itemText];

            if (!reportName) {
                DevExpress.ui.notify("Invalid report format selected.", "error", 3000);
                return;
            }

            const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&purchaseOrderNo=${encodeURIComponent(purchaseNo)}`;
            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');

        } catch (error) {
            console.error("Failed to open purchase report:", error);
            DevExpress.ui.notify("An error occurred while trying to open the report.", "error", 3000);
        }
    }


