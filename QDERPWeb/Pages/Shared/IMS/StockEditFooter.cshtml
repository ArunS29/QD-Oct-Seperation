


<style type="text/css">
    #dataGrid .dx-datagrid-headers .dx-datagrid-action {
        text-align: center !important;
    }

    #dataGrid .dx-datagrid-headers .dx-cell-focus-disabled {
        text-align: center !important;
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
        margin-top: 0px;
    }

    .button-alignment-down {
        margin-top: 23px;
    }

    .button-group {
        margin-left: -10px !important;
    }

    /* Custom styles for context menu */
    .context-menu {
        display: none;
        position: absolute;
        /* background-color: aliceblue;
                        border: 1px solid aliceblue; */
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

    .context-menu-item {
        padding: 0px, 15px,10px 15px;
        cursor: pointer;
    }

    .ledgerResult {
        margin: 15px !important;
    }

    #rowHeightMenu {
        position: absolute;
        top: 100px; /* Adjust positioning as per your design */
        left: 300px; /* Adjust positioning as per your design */
        display: none; /* Keep it hidden until needed */
    }

    /* #previewModal {
                        border: 1px solid aliceblue;
                    } */

    .bold-button .dx-button-text {
        font-weight: bold;
    }

    .dx-icon-green-circle::before {
        content: '';
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: green;
        vertical-align: middle;
    }
</style>
<div class="dx-fieldset horizontal-container mt-2">
   
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddButtonLayout")
            .Icon("smalliconslayout")
            .Text(new JS("formatMessage('Layout')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
                items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
                items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
                items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
            })
            .ShowArrowIcon(false)
            )
    </div>
    <div class="btn-container">
    @(Html.DevExtreme().DropDownButton()
        .ID("rowHeightProperties")
        .Icon("rowproperties") // fallback to standard icon if "rowproperties" not working
        .Width(50)
        .Text(new JS("formatMessage('Set Row Height')"))
        .DropDownOptions(options => options.Width(230))
        .Items(items =>
        {
            items.Add().Text(new JS("formatMessage('Short')"))
                .Icon("chevrondown")
                .OnClick("function() { ChangeRowHeight('30'); }");

            items.Add().Text(new JS("formatMessage('Medium')"))
                .Icon("lock")
                .OnClick("function() { ChangeRowHeight('40'); }");

            items.Add().Text(new JS("formatMessage('Tall')"))
                .Icon("edit")
                .OnClick("function() { ChangeRowHeight('60'); }");

            items.Add().Text(new JS("formatMessage('Extra Tall')"))
                .Icon("folder")
                .OnClick("function() { ChangeRowHeight('70'); }");
        })
        .ShowArrowIcon(false)
    )
</div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnSave")
            .Text(new JS("formatMessage('Save')"))
            .Icon("save")
            .Hint("Click to save")
            .ElementAttr(new { @class = "bold-button" })
            .OnClick("onSaveClicked") // Bind JS function here
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnSaveAndClose")
            .Icon("save")
            .Text(new JS("formatMessage('Save And Close')"))
            .Hint("Save and Close")
            .Width(180)
            .ElementAttr(new { @class = "bold-button" })
            .OnClick("onSaveAndCloseClicked") // Save and go back
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnDelete")
            .Icon("trash")
            .Text(new JS("formatMessage('Delete')"))
            .Hint("Delete")
            .Width(150)
            .ElementAttr(new { @class = "bold-button" })
            .OnClick("onDeleteClick")  // <-- Call JS function here
            )
    </div>


    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text(new JS("formatMessage('Back')"))
            .Icon("arrowleft")
            .Hint("Click to go back")
            .Width(150)
            .ElementAttr(new { @class = "bold-button" })
            .OnClick("onBackButtonClick")
            )
    </div>





</div>
