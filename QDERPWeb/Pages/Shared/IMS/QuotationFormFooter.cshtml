                    items.Add().Text("Preview Quotation(W/o VAT & W/o TotalPrice)").Icon("folder");
                    items.Add().Text("Preview Quotation(W/o VAT & W/o Discount)").Icon("folder");
                    items.Add().Text("Preview Quotation(With Addl Details)").Icon("folder");
                    items.Add().Text("Preview Quotation(Without Price)").Icon("folder");
                    items.Add().Text("Preview Quotation(With Item Image)").Icon("folder");
                    items.Add().Text("Preview Quotation(With Group Code)").Icon("folder");
