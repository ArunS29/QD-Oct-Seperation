


<style type="text/css">
    #dataGrid .dx-datagrid-headers .dx-datagrid-action {
        text-align: center !important;
    }

    #dataGrid .dx-datagrid-headers .dx-cell-focus-disabled {
        text-align: center !important;
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
        margin-top: 0px;
    }

    .button-alignment-down {
        margin-top: 23px;
    }

    .button-group {
        margin-left: -10px !important;
    }

    /* Custom styles for context menu */
    .context-menu {
        display: none;
        position: absolute;
        /* background-color: aliceblue;
                    border: 1px solid aliceblue; */
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

    .context-menu-item {
        padding: 0px, 15px,10px 15px;
        cursor: pointer;
    }

    .ledgerResult {
        margin: 15px !important;
    }

    #rowHeightMenu {
        position: absolute;
        top: 100px; /* Adjust positioning as per your design */
        left: 300px; /* Adjust positioning as per your design */
        display: none; /* Keep it hidden until needed */
    }

    /* #previewModal {
                    border: 1px solid aliceblue;
                } */

    .bold-button .dx-button-text {
        font-weight: bold;
    }

    .dx-icon-green-circle::before {
        content: '';
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: green;
        vertical-align: middle;
    }
</style>
<div class="dx-fieldset horizontal-container mt-2">
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnRefresh")
            .Icon("refresh")
            .Text(new JS("formatMessage('Refresh')"))
            .Width(150)
            .OnClick("refreshGrid")
            )
    </div>
    <div class="btn-container">
    @(Html.DevExtreme().DropDownButton()
        .ID("ddButtonLayout")
        .Icon("smalliconslayout")
        .Width(150)
        .Text(new JS("formatMessage('Layout')"))
        .DropDownOptions(options => options.Width(230))
        .Items(items =>
        {
            items.Add().Text(new JS("formatMessage('Set Row Height')")).Icon("rowproperties").OnClick("showSubmenu");
            items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
            items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
            items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
            items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
        })
        .ShowArrowIcon(false)
        )
        </div>
    <div class="btn-container">
    @(Html.DevExtreme().Button()
        .ID("btnPrint")
        .Text(new JS("formatMessage('Print')"))
        .Icon("print")
        .Hint("Click to print")
        .OnClick("function() { openPrint(); }")
        .ElementAttr(new { @class = "bold-button" }) 
        )
        </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnToggleSearch")
            .Icon("search")
            .Text(new JS("formatMessage('Search')"))
            .Width(150)
            .OnClick("toggleFilterRow")
            )
    </div>



    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btntoggleGroupPanel")
            .Icon("hierarchy")
            .Width(150)
            .Text(new JS("formatMessage('Group')"))
            .OnClick("toggleGroupPanel")
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddButtonShow")
            .Icon("green-circle")
            .Width(150)
            .Text(new JS("formatMessage('Show')"))
            .DropDownOptions(options => options.Width(250))
            .Items(items =>
            {
                items.Add()
                .Text(new JS("formatMessage('Show Items Discontinued')"))
                .Icon("close")
                .OnClick("DiscontinuedClick");

                items.Add()
                .Text(new JS("formatMessage('Show All Items')"))
                .Icon("selectall") 
                .OnClick("AllitemsClick");

                items.Add()
                .Text(new JS("formatMessage('Show Items In Use')"))
                .Icon("check") 
                .OnClick("UseClick");
            })
            .ShowArrowIcon(false)
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddReports")
            .Icon("print")
            .Width(150)
            .Text(new JS("formatMessage('Report')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text(new JS("formatMessage('Inventory Report(With Expiry date)')")).Icon("money");
                items.Add().Text(new JS("formatMessage('Inventory Report By date')")).Icon("money");
                items.Add().Text(new JS("formatMessage('Inventory Report On Stores')")).Icon("money");
                items.Add().Text(new JS("formatMessage('Inventory Report on Store(Pivort Report)')")).Icon("money");
                items.Add().Text(new JS("formatMessage('Inventory Report On stores (By Date)')")).Icon("money");
                items.Add().Text(new JS("formatMessage('Inventory - Stock Movement report')")).Icon("money");
            })
            .OnItemClick("handleReportClick")
            .ShowArrowIcon(false)
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnAddNewPayment")
            .Icon("money")
            .Text(new JS("formatMessage('Add New Stock Item')"))
            .Width(200)
            .OnClick("addStock")
            )

    </div>
</div>
