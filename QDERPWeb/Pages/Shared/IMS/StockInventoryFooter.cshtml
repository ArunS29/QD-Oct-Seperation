<div class="dx-fieldset horizontal-container mt-2">
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnRefresh")
            .Icon("refresh")
            .Text(new JS("formatMessage('Refresh')"))
            .Width(150)
            .OnClick("refreshGrid")
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddButtonLayout")
            .Icon("smalliconslayout")
            .Width(150)
            .Text(new JS("formatMessage('Layout')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text(new JS("formatMessage('Set Row Height')")).Icon("").OnClick("showSubmenu");
                items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
                items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
                items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
                items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
            })
            .ShowArrowIcon(false)
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("rowHeightProperties")
            .Icon("")
            .Width(50)
            .Text(new JS("formatMessage('Set Row Height')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add().Text(new JS("formatMessage('Short')"))
                .Icon("chevrondown")
                .OnClick("function() { ChangeRowHeight('30'); }");

                items.Add().Text(new JS("formatMessage('Medium')"))
                .Icon("lock")
                .OnClick("function() { ChangeRowHeight('40'); }");

                items.Add().Text(new JS("formatMessage('Tall')"))
                .Icon("edit")
                .OnClick("function() { ChangeRowHeight('60'); }");

                items.Add().Text(new JS("formatMessage('Extra Tall')"))
                .Icon("folder")
                .OnClick("function() { ChangeRowHeight('70'); }");
            })
            .ShowArrowIcon(false)
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnPrint")
            .Text(new JS("formatMessage('Print')"))
            .Icon("print")
            .Hint("Click to print")
            .OnClick("printFun")
            .ElementAttr(new { @class = "bold-button" })
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnToggleSearch")
            .Icon("search")
            .Text(new JS("formatMessage('Search')"))
            .Width(150)
            .OnClick("toggleFilterRow")
            )
    </div>



    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btntoggleGroupPanel")
            .Icon("hierarchy")
            .Width(150)
            .Text(new JS("formatMessage('Group')"))
            .OnClick("toggleGroupPanel")
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
                .ID("btnColumnChooser")
                .Icon("columnchooser")
                .Text(new JS("formatMessage('Column Chooser')"))
                .OnClick("showColumnChooser")
                )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddButtonShow")
            .Icon("folder")
            .Width(150)
            .Text(new JS("formatMessage('Show')"))
            .DropDownOptions(options => options.Width(250))
            .Items(items =>
            {
                items.Add()
                    .Text(new JS("formatMessage('Show Items Discontinued')"))
                    .Icon("close")
                    .Option("color", "#EA4335") // Red
                    .OnClick("DiscontinuedClick");

                items.Add()
                    .Text(new JS("formatMessage('Show All Items')"))
                    .Icon("selectall")
                    .Option("color", "#4285F4") // Blue
                    .OnClick("AllitemsClick");

                items.Add()
                    .Text(new JS("formatMessage('Show Items In Use')"))
                    .Icon("check")
                    .Option("color", "#34A853") // Green
                    .OnClick("UseClick");
            })
            .ItemTemplate(@<text>
                <div class="custom-dropdown-item">
                    <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                    <div class="item-content">
                        <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                        <div>
                            <div class="item-title"><%- text %></div>
                        </div>
                    </div>
                </div>
            </text>)
            .ShowArrowIcon(false)
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddReports")
            .Icon("print")
            .Width(150)
            .Text(new JS("formatMessage('Report')"))
            .DropDownOptions(options => options.Width(350))
            .Items(items =>
            {
                items.Add()
                    .Text(new JS("formatMessage('Inventory Report(With Expiry date)')"))
                    .Icon("money")
                    .Option("color", "#FF7043"); // Orange

                items.Add()
                    .Text(new JS("formatMessage('Inventory Report By date')"))
                    .Icon("money")
                    .Option("color", "#00ACC1"); // Cyan

                items.Add()
                    .Text(new JS("formatMessage('Inventory Report On Stores')"))
                    .Icon("money")
                    .Option("color", "#AB47BC"); // Purple

                items.Add()
                    .Text(new JS("formatMessage('Inventory Report on Store(Pivort Report)')"))
                    .Icon("money")
                    .Option("color", "#FBBC05"); // Yellow

                items.Add()
                    .Text(new JS("formatMessage('Inventory Report On stores (By Date)')"))
                    .Icon("money")
                    .Option("color", "#EA4335"); // Red

                items.Add()
                    .Text(new JS("formatMessage('Inventory - Stock Movement report')"))
                    .Icon("money")
                    .Option("color", "#34A853"); // Green
            })
            .ItemTemplate(@<text>
                <div class="custom-dropdown-item">
                    <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                    <div class="item-content">
                        <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                        <div>
                            <div class="item-title"><%- text %></div>
                        </div>
                    </div>
                </div>
            </text>)
            .OnItemClick("handleReportClick")
            .ShowArrowIcon(false)
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnAddNewPayment")
            .Icon("money")
            .Text(new JS("formatMessage('Add New Stock Item')"))
            .Width(200)
            .OnClick("addStock")
            )

    </div>
</div>
