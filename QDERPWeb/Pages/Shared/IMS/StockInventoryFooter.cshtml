    let IsDirect = true;
     
    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function closeSubmenu() {
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });

    function addStock() {
        var url = `/${tenantName}/IMS/InventoryStockDetails`;
        window.location.href = url;
    }

    function DiscontinuedClick() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.clearFilter();
        grid.filter(["IsDiscontinued", "=", true]);
    }

    function AllitemsClick() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.clearFilter();
    }

    function UseClick() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.clearFilter();
        grid.filter(["IsDiscontinued", "=", false]);
    }
    const reportMappings = {
        "Inventory Report(With Expiry date)": "InventoryReportWithExpireDates",



    };

    function handleReportClick(e) {
        const selectedText = e.itemData.text;
        const reportName = reportMappings[selectedText];

        if (reportName) {
            console.log(`Opening report: ${reportName}`);

            // Ensure tenantName is defined before using
            if (typeof tenantName === "undefined") {
                console.error("tenantName is not defined.");
                return;
            }

            window.open(`/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}`, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
        } else {
            let url = "";
            switch (selectedText) {
            case "Inventory Report By date":
                url = `/${tenantName}/IMS/InventoryByDateReport`;
                break;
            case "Inventory Report On Stores":
                url = `/${tenantName}/IMS/StoreInventoryReport`;
                break;
            case "Inventory Report on Store(Pivort Report)":
                url = `/${tenantName}/IMS/PivotStoreInventory`;
                break;
            case "Inventory Report On stores (By Date)":
                url = `/${tenantName}/IMS/StoreInventoryByDate`;
                break;
            case "Inventory - Stock Movement report":
                url = `/${tenantName}/IMS/StockMovementReport`;
                break;
            default:
                console.warn('No URL mapping found for:', selectedText);
                return;
        }

            window.location.href = url;
        }
    }
</script>