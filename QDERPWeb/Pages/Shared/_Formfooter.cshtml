    function onAttachButtonClick() {
        const dialog = DevExpress.ui.dialog.custom({
            title: "Select Attachment Option", // Title must be plain text
            messageHtml: "<p>How would you like to attach files?</p>",
            buttons: [
                { text: "Single File", onClick: () => handleFileSelection(false) },
                { text: "Multiple Files", onClick: () => handleFileSelection(true) }
            ]
        });

        let dialogContainer = dialog.show(); // Show the dialog

        setTimeout(() => {
            // Find the dialog title and append a close button
            let titleElement = document.querySelector(".dx-dialog .dx-popup-title");
            if (titleElement) {
                let closeButton = document.createElement("span");
                closeButton.innerHTML = "&times;";
                closeButton.classList.add("dx-dialog-custom-close");
                closeButton.style.cursor = "pointer";
                closeButton.style.fontSize = "20px";
                closeButton.style.fontWeight = "bold";
                closeButton.style.position = "absolute";
                closeButton.style.right = "15px";
                closeButton.style.top = "10px";

                titleElement.style.position = "relative"; // Ensure positioning works
                titleElement.appendChild(closeButton);

                // Close the dialog without triggering button events
                closeButton.addEventListener("click", () => {
                    let dialogElement = document.querySelector(".dx-dialog");
                    if (dialogElement) {
                        dialogElement.remove(); // Removes the dialog from the DOM
                    }
                });
            }

            // **Disable Dragging (Correct Method)**
            let dialogPopup = document.querySelector(".dx-dialog");
            if (dialogPopup) {
                dialogPopup.classList.remove("dx-draggable"); // Prevent dragging without affecting clicks
            }
        }, 0);
    }




