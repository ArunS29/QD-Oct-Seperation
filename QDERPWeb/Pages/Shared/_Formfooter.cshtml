        DevExpress.ui.notify(e.itemData, "success", 600);
    }
    function ChangeRowHeight(newHeight) {
        // Update the row height
        $("#dataGrid .dx-data-row").css("height", newHeight + "px");
        closeSubmenu();
    }
    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function closeSubmenu() {
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });


    function onDeleteButtonClick() {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;
        var dataSource = dataGrid.option("dataSource");

        if (rowCount === 0 || rowCount === null) {
            DevExpress.ui.dialog.alert(
                "No records available to delete. Please enter some transactions.",
                "Data Not Found"
            ).done(function () {

            });
        } else {
            // Retrieve the unique identifier for the row
            var voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

            // **Ask for confirmation before proceeding**
            confirmToDeleteAllVoucher(function () {
                // User clicked "Yes", proceed with deletion
                $.ajax({
                    url: `/api/VoucherMaster/DeleteAllVoucherEntry?VoucherNo=${encodeURIComponent(voucherNo)}`,
                    type: "POST",
                    success: function (response) {
                        if (response.data) {
                            $("#dataGrid").dxDataGrid("instance").option("dataSource", response.data);
                            DevExpress.ui.dialog.alert("Voucher has been successfully removed from the database.",
                                "Data Deleted Successfully").done(function () {
                                    history.back(); // Execute only when "OK" is clicked
                                });

                        } else {
                            DevExpress.ui.notify("No updated data returned from the server.", "error", 2000);
                        }
                    },
                    error: function (xhr, status, error) {
                        DevExpress.ui.notify("Error deleting record: " + error, "error", 2000);
                    }
                });
            });
        }
    }


    function confirmToDeleteAllVoucher(onConfirm) {
        DevExpress.ui.dialog.confirm(
            "You are about to delete the Voucher Entries from the database. You cannot revert the changes. Are you sure you want to delete?",
            "Delete Confirm."
        ).done(function (dialogResult) {
            if (dialogResult) {
                onConfirm(); // Proceed only if the user clicks "Yes"
                // DevExpress.ui.dialog.alert(
                //     "All Entries has been successfully removed from the database.",
                //     "Data Deleted Successfully"
                // );
            }
        });
    }

    function onBackButtonClick() {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const rowCount = dataGrid.getVisibleRows().length;

        if (rowCount === 0) {
            DevExpress.ui.dialog.confirm(
                "No entries in the voucher, do you want to clear the voucher completely?",
                "No line items"
            ).done(function (dialogResult) {
                if (dialogResult) {
                    if (typeof onConfirm === "function") {
                        onConfirm(); // Ensure onConfirm is defined before calling
                    }
                    DevExpress.ui.dialog.alert(
                        "Voucher has been successfully removed from the database.",
                        "Data Deleted Successfully"
                    ).done(function () {
                        history.back(); // Go back to the previous page
                    });
                }
            });
        } else {
            history.back(); // Closes or navigates back
        }
    }


    function onVerifyButtonClick() {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        IsDirect = false;
        // Ensure dataGrid exists
        if (!dataGrid) {
            console.error("DataGrid instance not found.");
            return;
        }

        const rowCount = dataGrid.getVisibleRows().length;

        // Check if DataGrid contains rows
        if (rowCount === 0) {
            DevExpress.ui.dialog.custom({
                title: "Voucher verification has failed.",
                message: "Voucher has not been Verified. Please enter transactions to proceed with verification.",
                buttons: [{ text: "Ok", onClick: () => false }],
                showTitle: true
            }).show();
        } else {
            DevExpress.ui.dialog.custom({
                title: "Confirm Verification",
                // message: "Voucher has not been Verified. Click Yes if you want to Verify this Voucher.",
                message: "Are you sure want to verify this voucher?",
                buttons: [
                    { text: "Yes", onClick: () => true },
                    { text: "No", onClick: () => false }
                ],
                showTitle: true
            }).show().done(function (dialogResult) {
                if (dialogResult) {
                    proceedWithVerification(); // Proceed if user clicks Yes
                }
            });
        }
    }




    function proceedWithVerification() {
        // Set VerifiedBy checkbox to true
        $("#VerifiedBy").dxCheckBox("instance").option("value", true);

        const vno = $("#VoucherNo").dxTextBox("instance").option("value");

        if (!vno) {
            DevExpress.ui.notify("Voucher number is required!", "error", 2000);
            return;
        }

        const currentDate = new Date();

        const formattedDate = currentDate.toLocaleDateString("en-GB", {

            day: "2-digit",

            month: "short",

            year: "numeric"

        }).replace(/ /g, '-');

        $.ajax({
            type: "POST",
            url: "/api/VoucherMaster/VerifyVoucher",
            contentType: "application/json",
            dataType: "json",
            data: JSON.stringify({ voucherNo: vno }), // Send as JSON in request body
            success: function (response) {
                if (response && response.Message) {
                    DevExpress.ui.dialog.alert(
                        "Voucher has been Verified.",
                        "Verified"
                    ).done(() => {
                        $("#VerifiedBytext").dxTextBox("instance").option("value", response.VoucherVerifiedBy || "N/A");
                        $("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate || "N/A");
                    });
                }
                else {
                    DevExpress.ui.notify("Update failed: Unable to reload details!", "error", 2000);
                }
            },
            error: function (xhr, status, error) {
                let errorMessage = xhr.responseJSON && xhr.responseJSON.Message
                    ? xhr.responseJSON.Message
                    : "An error occurred.";
            }
        });
    }



    function disableEditing() {
        // Disable all input fields and buttons except for specific ones
        $('input, select, textarea').prop('disabled', true);

        $('.dx-button').each(function () {
            const allowedButtons = ['btnBack', 'btnPreview1', 'btnPrint', 'btnAttach'];
            if (!allowedButtons.includes($(this).attr('id'))) {
                $(this).dxButton('option', 'disabled', true);
            }
        });
    }


