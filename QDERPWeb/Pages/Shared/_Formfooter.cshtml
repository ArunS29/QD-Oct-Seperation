    function proceedWithApproval() {
        // Set ApprovedBy checkbox to true
        $("#ApprovedBy").dxCheckBox("instance").option("value", true);

        const vno = $("#VoucherNo").dxTextBox("instance").option("value");

        if (!vno) {
            DevExpress.ui.notify("Voucher number is required!", "error", 2000);
            return;
        }

        // Define IsDirect if not already defined (adjust as needed)
        const IsDirect = true; // or false, depending on your logic

        const currentDate = new Date();
        const formattedDate = currentDate.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }).replace(/ /g, '-');

        $.ajax({
            type: "POST",
            url: `/api/VoucherMaster/ApproveVoucher?VoucherNo=${encodeURIComponent(vno)}&IsDirect=${encodeURIComponent(IsDirect)}`,
            contentType: "application/json",
            dataType: "json",
            // Uncomment the following line if the API expects data in the request body:
            // data: JSON.stringify({ voucherNo: vno }),
            success: function (response) {
                if (response && response.Message) {
                    DevExpress.ui.dialog.alert(
                        "Voucher has been Approved.",
                        "Approved"
                    ).done(() => {
                        disableEditing();
                        $("#ApprovedBytext").dxTextBox("instance").option("value", response.VoucherApprovedBy || "N/A");
                        $("#ApprovedOntext").dxTextBox("instance").option("value", formattedDate || "N/A");

                        if (IsDirect === true) {
                            $("#VerifiedBy").dxCheckBox("instance").option("value", true);
                            $("#VerifiedBytext").dxTextBox("instance").option("value", response.VoucherApprovedBy || "N/A");
                            $("#VerifiedOnDate").dxTextBox("instance").option("value", formattedDate || "N/A");
                        }
                    });
                } else {
                    DevExpress.ui.notify("Update failed: Unable to reload details!", "error", 2000);
                }
            },
            error: function (xhr, status, error) {
                let errorMessage = (xhr.responseJSON && xhr.responseJSON.Message)
                    ? xhr.responseJSON.Message
                    : "An error occurred.";
                DevExpress.ui.notify(errorMessage, "error", 2000);
            }
        });
    }

    function onAttachButtonClick() {
        const dialog = DevExpress.ui.dialog.custom({
            title: "Select Attachment Option", // Title must be plain text
            messageHtml: "<p>How would you like to attach files?</p>",
            buttons: [
                { text: "Single File", onClick: () => handleFileSelection(false) },
                { text: "Multiple Files", onClick: () => handleFileSelection(true) }
            ]
        });

        let dialogContainer = dialog.show(); // Show the dialog

        setTimeout(() => {
            // Find the dialog title and append a close button
            let titleElement = document.querySelector(".dx-dialog .dx-popup-title");
            if (titleElement) {
                let closeButton = document.createElement("span");
                closeButton.innerHTML = "&times;";
                closeButton.classList.add("dx-dialog-custom-close");
                closeButton.style.cursor = "pointer";
                closeButton.style.fontSize = "20px";
                closeButton.style.fontWeight = "bold";
                closeButton.style.position = "absolute";
                closeButton.style.right = "15px";
                closeButton.style.top = "10px";

                titleElement.style.position = "relative"; // Ensure positioning works
                titleElement.appendChild(closeButton);

                // Close the dialog without triggering button events
                closeButton.addEventListener("click", () => {
                    let dialogElement = document.querySelector(".dx-dialog");
                    if (dialogElement) {
                        dialogElement.remove(); // Removes the dialog from the DOM
                    }
                });
            }

            // **Disable Dragging (Correct Method)**
            let dialogPopup = document.querySelector(".dx-dialog");
            if (dialogPopup) {
                dialogPopup.classList.remove("dx-draggable"); // Prevent dragging without affecting clicks
            }
        }, 0);
    }




