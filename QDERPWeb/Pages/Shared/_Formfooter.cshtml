        color: #17a2b8;
        border: 1px solid #17a2b8;
       
    }

    .dx-button-custom.btn-preview:hover .dx-button-content {
        background-color: #c2f1fa;
    }

    /* Save */
    .dx-button-custom.btn-save .dx-button-content {
        background-color: #007bff;
        color: #fff;
        border: 1px solid #007bff;
    }

    .dx-button-custom.btn-save:hover .dx-button-content {
