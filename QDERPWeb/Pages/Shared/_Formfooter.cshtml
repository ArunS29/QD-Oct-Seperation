    }

    /* Verify */
    .dx-button-custom.btn-verify .dx-button-content {
        background-color: #ffc107;
        color: #fff;
        border: 1px solid #ffc107;
    }

    .dx-button-custom.btn-verify:hover .dx-button-content {
