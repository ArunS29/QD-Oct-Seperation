<div class="workflow-wrapper">
    <!-- First row: Workflow -->
    <div class="workflow-row">
        <div class="WorkFlow">
            <div class="workflow-container">
                <div class="workflow-line"></div>

                <div class="workflow-step" id="step-update">
                    <div class="step-circle"><i class="fas fa-user"></i></div>
                    <div class="step-label">Updated</div>
                    <div class="step-status-msg">In Progress</div>
                </div>
                <div class="workflow-step" id="step-verify">
                    <div class="step-circle" id="circle-verify"><i class="fas fa-briefcase"></i></div>
                    <div class="step-label">Verified</div>
                    <div class="step-status-msg">Waiting</div>
                </div>
                <div class="workflow-step" id="step-approve">
                    <div class="step-circle" id="circle-approve"><i class="fas fa-file-alt"></i></div>
                    <div class="step-label">Approved</div>
                    <div class="step-status-msg">Pending</div>
                </div>

                <div id="verifyPopover" class="popover-box">
                    Verified by: <span id="verifiedByName"></span><br>
                    On: <span id="verifiedOn"></span>
                </div>
                <div id="approvePopover" class="popover-box">
                    Approved by: <span id="approvedByName"></span><br>
                    On: <span id="approvedOn"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Second row: Footer with Buttons -->
    <div class="footer-row">
        <div class="dx-fieldset horizontal-container">
            @(Html.DevExtreme().Button()
                        .ID("btnSave")
                        .Text("Save")
                        .Icon("save")
                        .Width(180)
                        .Hint("Click to save")
                        .ElementAttr(new { @class = "dx-button-custom btn-save" }))

            @(Html.DevExtreme().Button()
                        .ID("btnSaveAndClose")
                        .Text("Save & Close")
                        .Icon("save")
                        .Width(180)
                        .Hint("Click to save and close")
                        .ElementAttr(new { @class = "dx-button-custom btn-save-close" }))

            @(Html.DevExtreme().Button()
                        .ID("btnBack")
                        .Text(new JS("formatMessage('Back')"))
                        .Icon("arrowleft")
                        .Width(180)
                        .Hint("Click to back")
                        .OnClick("onBackButtonClick")
                        .ElementAttr(new { @class = "dx-button-custom btn-back" }))

            @(Html.DevExtreme().Button()
                        .ID("btnAttach")
                        .Text(new JS("formatMessage('Attach')"))
                        .Icon("link")
                        .Hint("Click to attach")
                        .Width(180)
                        .OnClick("onAttachmentButtonClick")
                        .ElementAttr(new { @class = "dx-button-custom btn-attach" }))

            @(Html.DevExtreme().DropDownButton()
                        .ID("btnPreview1")
                        .Text(new JS("formatMessage('Preview')"))
                        .Icon("fullscreen")
                        .Hint("Click to Preview")
                        .ElementAttr(new { @class = "dx-button-custom btn-preview" })
                        .Width(180)
                        .DropDownOptions(o => o.Width(220))
                        .Items(items =>
                        {
                            items.Add().Text(new JS("formatMessage('Preview Format 1')")).Icon("textdocument");
                            items.Add().Text("Preview Format 2").Icon("textdocument");
                        })
                        .OnItemClick("handlePreviewClick"))

            @(Html.DevExtreme().Button()
                        .ID("btnDelete")
                        .Text("Delete")
                        .Icon("close")
                        .Width(180)
                        .Hint("Click to delete")
                        .OnClick("onDeleteButtonClick")
                        .ElementAttr(new { @class = "dx-button-custom btn-delete" }))

            @(Html.DevExtreme().Button()
                        .ID("btnVerify")
                        .Text(new JS("formatMessage('Verify')"))
                        .Icon("check")
                        .Hint("Click to Verify")
                        .Width(180)
                        .OnClick("onVerifyButtonClick")
                        .ElementAttr(new { @class = "dx-button-custom btn-verify" }))

            @(Html.DevExtreme().Button()
                        .ID("btnApprove")
                        .Text(new JS("formatMessage('Approve')"))
                        .Icon("exportselected")
                        .Hint("Click to Approve")
                        .Width(180)
                        .OnClick("onApproveButtonClickWithAnimation")
                        .ElementAttr(new { @class = "dx-button-custom btn-approve" }))

            @(Html.DevExtreme().Button()
                        .ID("btnVoucherColumnChooser")
                        .Text(new JS("formatMessage('Column Chooser')"))
                        .Icon("columnchooser")
                        .Hint("Click to column chooser")
                        .Width(210)
                        .OnClick("showColumnChooser")
                        .ElementAttr(new { @class = "dx-button-custom btn-attach" }))
        </div>
    </div>
</div>



<script type="text/javascript">

    function showColumnChooser() {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var isColumnChooserVisible = dataGrid.option("columnChooser.enabled");

        if (isColumnChooserVisible) {
            dataGrid.option("columnChooser.enabled", false); // Disable the column chooser
        } else {
            dataGrid.option("columnChooser.enabled", true); // Enable the column chooser
            dataGrid.showColumnChooser(); // Show the column chooser
        }
    }





    $(document).ready(function () {
        console.log('Start permission handling');
        // Form ID
        var formId = "frm201VoucherCashPayment";

        // Call the API to get permissions
        $.ajax({
            url: '/api/Permissions/GetAccessDetails?formId=' + formId,
            type: 'GET',
            contentType: 'application/json',
            success: function (response) {
                console.log("API Response:", response); // Log the API response

                if (response.success && response.permissions) {
                    // Default visibility and enable status for buttons
                    var controlStates = {
                        "btnSave": { "Visible": true, "Enabled": true },
                        "btnSaveAndClose": { "Visible": false, "Enabled": false },
                        "btnPreview1": { "Visible": true, "Enabled": true },
                        "btnPrint": { "Visible": true, "Enabled": true },
                        "btnDelete": { "Visible": false, "Enabled": false },
                        "btnBack": { "Visible": false, "Enabled": false },
                        "btnVerify": { "Visible": true, "Enabled": true },
                        "btnApprove": { "Visible": false, "Enabled": false },
                        "btnAttach": { "Visible": false, "Enabled": false }
                    };


                    // Check for full access
                    var fullAccess = response.permissions.find(p =>
                        p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
                    );

                    if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
                        // Grant full access: make all controls visible and enabled
                        Object.keys(controlStates).forEach(key => {
                            controlStates[key] = { "Visible": true, "Enabled": true };
                        });
                    } else {
                        // Update states based on specific permissions for each control
                        Object.keys(controlStates).forEach(key => {
                            var controlPermission = response.permissions.find(p =>
                                p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
                            );
                            if (controlPermission) {
                                controlStates[key] = {
                                    "Visible": controlPermission.ItemVisible || false,
                                    "Enabled": controlPermission.ItemEnabled || false
                                };
                            }
                        });
                    }

                    console.log("Control States:", controlStates); // Log the control states

                    // Dynamically update button visibility and enabled state
                    Object.keys(controlStates).forEach(key => {
                        var button = document.getElementById(key);
                        if (button) {
                            // Handle visibility
                            button.style.display = controlStates[key].Visible ? "" : "none";
                            // Handle enable/disable state
                            button.disabled = !controlStates[key].Enabled;
                            // Ensure button text is visible
                            button.style.color = controlStates[key].Enabled ? "black" : "gray"; // Adjust colors as needed
                            console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
                        } else {
                            console.warn(`Button with ID "${key}" not found in the DOM.`);
                        }
                    });

                } else {
                    console.warn("Failed to fetch permissions or no permissions available.");
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching permissions:", error);
                alert('An error occurred while fetching permissions. Please try again.');
            }
        });
        // showColumnChooser();
        console.log('End permission handling');
    });


    let IsDirect = true;
    // Hide context menu on click outside
    $(document).on("click", function () {
        var contextMenu = $("#contextMenu");
        contextMenu.hide();
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
    });

    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });
    function saveLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var layout = grid.state();
        const layoutJson = JSON.stringify(layout, null, 2); // Pretty-print JSON
        //console.log(layoutJson);
        // Create a Blob from the JSON string
        const blob = new Blob([layoutJson], { type: "application/json" });
        // Create a URL for the Blob
        const url = URL.createObjectURL(blob);
        // Create a link element
        const a = document.createElement("a");
        a.href = url;
        a.download = "grid-layout.json"; // Set the file name for download
        // Append the link to the body (needed for Firefox)
        document.body.appendChild(a);
        // Programmatically click the link to trigger the download
        a.click();
        // Clean up by removing the link and revoking the Object URL
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        //DevExpress.ui.notify("Layout", "success", 600);
    }
    function openLayoutClick(e) {
        $("#loadLayoutInput").click();
    }

    function loadGridState() {
        var form = $('#formId').val();
        // Call the API to get the grid state
        $.ajax({
            url: `/api/Utility/LoadLayout`, // Adjust to your actual API endpoint
            method: 'GET',
            data: {
                form: form
            },
            success: function (response) {
                // Get the DataGrid instance
                var dataGrid = $("#dataGrid").dxDataGrid("instance");

                // Load the state into the DataGrid
                if (response) {
                    try {
                        // Parse the JSON string from the file
                        const layout = JSON.parse(response);

                        // Restore the grid state
                        dataGrid.state(layout);
                    } catch (error) {
                        console.error("Error parsing JSON:", error);
                        alert("Failed to load layout. Please ensure the JSON is valid.");
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading grid state:", error);
            }
        });
    }
