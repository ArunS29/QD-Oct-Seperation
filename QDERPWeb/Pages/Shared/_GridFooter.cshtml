                                       <path d="M7.25 7C7.25 6.58579 7.58579 6.25 8 6.25H16C16.4142 6.25 16.75 6.58579 16.75 7C16.75 7.41421 16.4142 7.75 16 7.75H8C7.58579 7.75 7.25 7.41421 7.25 7Z" fill="#1C274D" />
                                       <path d="M8 9.75C7.58579 9.75 7.25 10.0858 7.25 10.5C7.25 10.9142 7.58579 11.25 8 11.25H13C13.4142 11.25 13.75 10.9142 13.75 10.5C13.75 10.0858 13.4142 9.75 13 9.75H8Z" fill="#1C274D" />
                                   </svg>
                                   <span id="OtherVouchers"></span>
                               </text>)
                .Text(new JS("formatMessage('Other Vouchers')"))
                .ElementAttr(new { style = "display: none;" })
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                        items.Add().Text(new JS("formatMessage('Add Purchase Voucher')")).Option("color", "#4285F4").Icon("add");
                        items.Add().Text(new JS("formatMessage('Add Sales Voucher')")).Option("color", "#34A853").Icon("add");
                        items.Add().Text(new JS("formatMessage('Add Journal Voucher')")).Option("color", "#EA4335").Icon("add");
                })
                    .ItemTemplate(@<text>
                                       <div class="custom-dropdown-item">
                                             <div style="background-color:<%- color %>; height:90%" class="side-bar"></div>
                                           <div class="item-content">
                                               <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                                               <div>
                                                   <div class="item-title"><%- text %></div>
