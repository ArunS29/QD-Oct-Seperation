                                       <path opacity="0.4" d="M2 7V21C2 21.83 2.94001 22.3 3.60001 21.8L5.31 20.52C5.71 20.22 6.27 20.26 6.63 20.62L8.28999 22.29C8.67999 22.68 9.32001 22.68 9.71001 22.29L11.39 20.61C11.74 20.26 12.3 20.22 12.69 20.52L14.4 21.8C15.06 22.29 16 21.82 16 21V4C16 2.9 16.9 2 18 2H7H6C3 2 2 3.79 2 6V7Z" fill="#292D32" />
                                       <path d="M11.75 9.25H9.75V7.25C9.75 6.84 9.41 6.5 9 6.5C8.59 6.5 8.25 6.84 8.25 7.25V9.25H6.25C5.84 9.25 5.5 9.59 5.5 10C5.5 10.41 5.84 10.75 6.25 10.75H8.25V12.75C8.25 13.16 8.59 13.5 9 13.5C9.41 13.5 9.75 13.16 9.75 12.75V10.75H11.75C12.16 10.75 12.5 10.41 12.5 10C12.5 9.59 12.16 9.25 11.75 9.25Z" fill="#292D32" />
                                   </svg>
                                <span id="AddReceipt"></span>
                               </text>)
              
                .ElementAttr(new { style = "display: none;" })
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                        items.Add().Text(new JS("formatMessage('Add Cash Receipts')")).Option("color", "#34A853").Icon("money");
                        items.Add().Text(new JS("formatMessage('Add Bank Receipts')")).Option("color", "#FBBC05").Icon("product");
                })
                    .ItemTemplate(@<text>
                                       <div class="custom-dropdown-item">
                                           <div style="background-color:<%- color %>; height:90%" class="side-bar"></div>
                                           <div class="item-content">
                                               <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                                               <div>
                                                   <div class="item-title"><%- text %></div>
                                               </div>
                                           </div>
                                       </div>
                                   </text>)
                .OnItemClick("addRecipitsButton_click")
                .ShowArrowIcon(false)
                )
        </div>

        <div class="btn-container">
            @(Html.DevExtreme().DropDownButton()
                    .ID("ddButtonPayment")
                    .Text(new JS("formatMessage('Add Payment')"))
                    .Icon("")
                    .Template(@<text>
                                   <svg width="30px" height="23px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                       <path d="M22 19V22H2V19C2 18.45 2.45 18 3 18H21C21.55 18 22 18.45 22 19Z" fill="#292D32" stroke="#292D32" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
