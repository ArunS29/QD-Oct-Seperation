    function addExpenseButton_click(e) {
        switch (e.itemData.text) {
            
            case ('Expense Claim Request'):
                window.location.href = `/${tenantName}/Finance/ExpensesClaimRequest`;
                break;
            case ('Petty Cash Request'):
                window.location.href = `/${tenantName}/Finance/PettyCashRequest`;
                break;
            case 'Supplier Payment Request':
                
                $.ajax({
                    
                    url: `/api/ExpenseClaim/GetSupplierpayment`,
                    type: 'GET',
                    dataType: "html",
                    success: function (data) {
                        let popupInstance = $("#SupplierpaymentPopup").dxPopup("instance");
                        popupInstance.option("contentTemplate", function () {
                            return $("<div>").html(data);
                        });
                        popupInstance.show();
                    },
                    error: function (xhr) {
                        alert('Failed to load the Supplier Payment Request view.');
                    }
                });
                break;

            // You can handle other cases here if needed
            default:
                console.log("Clicked item: ", e.itemData.text);
        }
    }
