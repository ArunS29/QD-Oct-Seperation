            'border': '1px solid #ccc',
            'box-shadow': '2px 2px 5px rgba(0,0,0,0.2)',
            'padding': '5px'
        });

        // Click outside to close
        $(document).on("click", function (event) {
            if (!$(event.target).closest('#submenuContainer7, .dx-item-content').length) {
                $submenu.hide();
                $(document).off("click");
            }
        });
    }

    // Helper function to hide all submenus
    function hideAllSubmenus() {
        $('#submenuContainer4').hide();
        $('#submenuContainer5').hide();
        $('#submenuContainer6').hide();
        $('#submenuContainer7').hide();
    }

</script>
