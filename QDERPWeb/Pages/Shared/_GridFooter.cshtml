<script type="text/javascript">

    $(document).ready(function () {
        console.log('Start permission handling');
        // Form ID
        var formId = "frm201LedgerView";

        // Call the API to get permissions
        $.ajax({
            url: '/api/Permissions/GetAccessDetails?formId=' + formId,
            type: 'GET',
            contentType: 'application/json',
            success: function (response) {
                console.log("API Response:", response); // Log the API response

                if (response.success && response.permissions) {
                    // Default visibility and enable status for buttons
                    var controlStates = {
                        "btnShowRecords": { "Visible": false, "Enabled": false },
                        "btnPrint": { "Visible": false, "Enabled": false },
                        "btnSearch": { "Visible": false, "Enabled": false },
                        "ddButtonLayout": { "Visible": false, "Enabled": false },
                        "btnToggleSearch": { "Visible": false, "Enabled": false },
                        "btntoggleGroupPanel": { "Visible": false, "Enabled": false },
                        "btnToggleHeaderFilter": { "Visible": false, "Enabled": false },
                        "btnColumnChooser": { "Visible": false, "Enabled": false },
                        "ddButtonReceipts": { "Visible": false, "Enabled": false },
                        "ddButtonPayment": { "Visible": false, "Enabled": false },
                        "ddOtherVouchers": { "Visible": false, "Enabled": false },
                        "ddReports": { "Visible": false, "Enabled": false },
                        "ddButtonExpense": { "Visible": false, "Enabled": false }
                    };


                    // Check for full access
                    var fullAccess = response.permissions.find(p =>
                        p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_FullAccess").trim().toLowerCase()
                    );

                    if (fullAccess && fullAccess.ItemEnabled && fullAccess.ItemVisible) {
                        // Grant full access: make all controls visible and enabled
                        Object.keys(controlStates).forEach(key => {
                            controlStates[key] = { "Visible": true, "Enabled": true };
                        });
                    } else {
                        // Update states based on specific permissions for each control
                        Object.keys(controlStates).forEach(key => {
                            var controlPermission = response.permissions.find(p =>
                                p.ItemName && p.ItemName.trim().toLowerCase() === (formId + "_" + key).trim().toLowerCase()
                            );
                            if (controlPermission) {
                                controlStates[key] = {
                                    "Visible": controlPermission.ItemVisible || false,
                                    "Enabled": controlPermission.ItemEnabled || false
                                };
                            }
                        });
                    }

                    console.log("Control States:", controlStates); // Log the control states

                    // Dynamically update button visibility and enabled state
                    Object.keys(controlStates).forEach(key => {
                        var button = document.getElementById(key);
                        if (button) {
                            // Handle visibility
                            button.style.display = controlStates[key].Visible ? "inline-block" : "none";
                            // Handle enable/disable state
                            button.disabled = !controlStates[key].Enabled;
                            console.log(`Button ${key} - Visible: ${controlStates[key].Visible}, Enabled: ${controlStates[key].Enabled}`); // Log button state
                        } else {
                            console.warn(`Button with ID "${key}" not found in the DOM.`);
                        }
                    });
                } else {
                    console.warn("Failed to fetch permissions or no permissions available.");
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching permissions:", error);
                alert('An error occurred while fetching permissions. Please try again.');
            }
        });
       // showColumnChooser();
        console.log('End permission handling');
    });

    // Footer Recipits button event
    function addRecipitsButton_click(e) {
        switch (e.itemData.text) {
            case (formatMessage('Add Cash Receipts')):
                window.open(`/${tenantName}/Finance/VoucherEntryCashReceipts`, 'popupWindow', 'width=1200,height=800,scrollbars=yes,resizable=yes');
                break;
            case (formatMessage('Add Bank Receipts')):
                window.open(`/${tenantName}/Finance/VoucherEntryReceipts`, 'popupWindow', 'width=1200,height=800,scrollbars=yes,resizable=yes');
                break;
            // You can handle other cases here if needed
            default:
                console.log("Clicked item: ", e.itemData.text);
        }
    }
    function addReportsButton_click(e) {
        let pageUrl = '';
        let selectedText = e.itemData.text;

        switch (selectedText) {
            case (formatMessage('Ledger to Salary Payable Mapping')):
                var accountDropDown = $("#accountDropDownBox").dxDropDownBox("instance");
                var selectedAccountId = accountDropDown.option("value");
                debugger;
                if (!selectedAccountId) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Please select the Account to Review',
                        text: 'You need to select an account before proceeding.',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                         // ✅ Make GET request to fetch AccountHeadName
                $.get(`/api/AccountingLedgers/GetAccountHeadName`, { accountId: selectedAccountId })
                    .done(function (selectedItem) {
                        if (!selectedItem || !selectedItem.AccountHead) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Account not found',
                                text: 'Please reselect the account.',
                                confirmButtonText: 'OK'
                            });
                            return;
                        }

                        var frmDate = $("#frmdateBox").dxDateBox("instance").option("value");
                        var toDate = $("#todateBox").dxDateBox("instance").option("value");

                        var formattedFromDate = frmDate;
                        var formattedToDate = toDate;

                        var acchedid = selectedItem.AccountId;
                        var accheadname = selectedItem.AccountHead;

                        // ✅ Construct the URL
                        var pageUrl = `/${tenantName}/Finance/SalaryPayableMapping?acchedid=${encodeURIComponent(acchedid)}&accheadname=${encodeURIComponent(accheadname)}&FromDate=${encodeURIComponent(formattedFromDate)}&ToDate=${encodeURIComponent(formattedToDate)}`;

                        // ✅ Open the modal with the page URL
                        if (pageUrl) {
                            openModal(pageUrl, selectedText);
                        }
                    });

                break;

            case (formatMessage('Ledger to Receivable/Payable Mapping')):
                if (typeof acchedid !== 'undefined' && typeof accheadname !== 'undefined') {
                    pageUrl = `/${tenantName}/Finance/LedgerToSubLedgerMapping?acchedid=${encodeURIComponent(acchedid)}&accheadname=${encodeURIComponent(accheadname)}&accid=${encodeURIComponent(accid)}&FromDate=${encodeURIComponent(FromDate)}&ToDate=${encodeURIComponent(ToDate)}`;
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Please select the Account to Review',
                        text: 'You need to select an account before proceeding.',
                        confirmButtonText: 'OK'
                    });
                    return;
                }
                break;

            case (formatMessage('Bank Reconciliation')):
                if (typeof acchedid !== 'undefined' && typeof accheadname !== 'undefined') {
                    pageUrl = `/${tenantName}/Finance/BankReconciliation?acchedid=${encodeURIComponent(acchedid)}&accheadname=${encodeURIComponent(accheadname)}&accid=${encodeURIComponent(accid)}&FromDate=${encodeURIComponent(FromDate)}&ToDate=${encodeURIComponent(ToDate)}&lastRowBalance=${encodeURIComponent(lastRowBalance)}&firstRowBalance=${encodeURIComponent(firstRowBalance)}`;
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Please Select the Account to Reconcile',
                        text: 'You need to select an account before proceeding.',
                        confirmButtonText: 'OK'
                    });
                    return;
                }
                break;

            case (formatMessage('Detailed Transaction Report')):
                window.open(`/${tenantName}/Finance/TransactionDetails`, 'popupWindow', 'width=1200,height=800,scrollbars=yes,resizable=yes');
                return;  // No need to set pageUrl for new window
        }
        if (pageUrl) {
            openModal(pageUrl, selectedText); // Open modal with the URL and title
        }

        // Handle Account Statement Cases
        const reportMapping = {
            "Account Statements": "AccountReport",
            "Statement Of Account With Narration": "AccountWithNarration",
            "Statement Of Account Export Formate": "AccountExportFormatReport",
            "Statement Of Account Export Formate[Landscape]": "AccountExportLandscapeReport",
            "Statement of Account Export [Formate2]": "AccountStatementFormat2Report",
            "Statement of Account [OrderByVoucerNo9 (Without Narration)]": "AccountOrderbyVchNoWONarrationReport"
        };

        if (reportMapping[selectedText]) {
            window.location.href = `/DocumentViewer?reportName=${reportMapping[selectedText]}`;
        }
    }




