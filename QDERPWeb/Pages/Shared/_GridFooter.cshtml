     function showSubmenu5(e) {
        e.event.stopPropagation();

        // Check accgroup validity
        if (!currentAccGroup.toUpperCase().includes("SUNDRY DEBTORS")) {
            $("#popupWarningMessage").text("No records to print");
            $("#warningPopup").dxPopup("instance").show();
            return;
        }

        hideAllSubmenus(); // Hide all submenus

        var $submenu = $('#submenuContainer5');
        var $target = $(e.event.target).closest('.dx-item-content');

        if (!$target.length) return;

        var offset = $target.offset();
        var submenuWidth = $submenu.outerWidth();
        var targetWidth = $target.outerWidth();
        var windowWidth = $(window).width();

        // Default position: right of button
        var leftPos = offset.left + targetWidth + 10;

        // If not enough space on right, move to left
        if (leftPos + submenuWidth > windowWidth) {
            leftPos = offset.left - submenuWidth - 10;
        }

