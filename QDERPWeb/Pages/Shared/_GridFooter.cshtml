                                       <path opacity="0.6" d="M16 11H12V18H16V11Z" fill="#292D32" />
                                       <path opacity="0.4" d="M20 11H16V18H20V11Z" fill="#292D32" />
                                       <path d="M23 22.75H1C0.59 22.75 0.25 22.41 0.25 22C0.25 21.59 0.59 21.25 1 21.25H23C23.41 21.25 23.75 21.59 23.75 22C23.75 22.41 23.41 22.75 23 22.75Z" fill="#292D32" />
                                       <path d="M21.37 5.74982L12.37 2.14984C12.17 2.06984 11.83 2.06984 11.63 2.14984L2.63 5.74982C2.28 5.88982 2 6.29981 2 6.67981V9.99982C2 10.5498 2.45 10.9998 3 10.9998H21C21.55 10.9998 22 10.5498 22 9.99982V6.67981C22 6.29981 21.72 5.88982 21.37 5.74982ZM12 8.49982C11.17 8.49982 10.5 7.82982 10.5 6.99982C10.5 6.16982 11.17 5.49982 12 5.49982C12.83 5.49982 13.5 6.16982 13.5 6.99982C13.5 7.82982 12.83 8.49982 12 8.49982Z" fill="#292D32" />
                                   </svg>
                                   <span id="AddPayment"></span>
                               </text>)
                .Text(new JS("formatMessage('Add Payment')"))
                .ElementAttr(new { style = "display: none;" })
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                        items.Add().Text(new JS("formatMessage('Add Cash Payment')")).Option("color", "#FBBC05").Icon("money");
                        items.Add().Text(new JS("formatMessage('Add Bank Payment')")).Option("color", "#AB47BC").Icon("product");
                })
                    .ItemTemplate(@<text>
                                       <div class="custom-dropdown-item">
                                           <div style="background-color:<%- color %>; height:90%" class="side-bar"></div>
                                           <div class="item-content">
                                               <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                                               <div>
                                                   <div class="item-title"><%- text %></div>
                                               </div>
                                           </div>
                                       </div>
                                   </text>)
                .OnItemClick("addPaymentButton_click")
                .ShowArrowIcon(false)
                )
        </div>

        <div class="btn-container">
            @(Html.DevExtreme().DropDownButton()
                    .ID("ddOtherVouchers")
                    .Text(new JS("formatMessage('Other Vouchers')"))
                    .Icon("")
                    .Template(@<text>
                                   <svg width="30px" height="25px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                       <path opacity="0.5" d="M4.72718 2.73332C5.03258 2.42535 5.46135 2.22456 6.27103 2.11478C7.10452 2.00177 8.2092 2 9.7931 2H14.2069C15.7908 2 16.8955 2.00177 17.729 2.11478C18.5387 2.22456 18.9674 2.42535 19.2728 2.73332C19.5782 3.0413 19.7773 3.47368 19.8862 4.2902C19.9982 5.13073 20 6.24474 20 7.84202L20 18H7.42598C6.34236 18 5.96352 18.0057 5.67321 18.0681C5.15982 18.1785 4.71351 18.4151 4.38811 18.7347C4.27837 18.8425 4.22351 18.8964 4.09696 19.2397C4.02435 19.4367 4 19.5687 4 19.7003V7.84202C4 6.24474 4.00176 5.13073 4.11382 4.2902C4.22268 3.47368 4.42179 3.0413 4.72718 2.73332Z" fill="#1C274D" />
