    // Handle button clicks
    function addRecipitsButton_click(e) {
        let url = "";
        let title = "Receipts";
        switch (e.itemData.text) {
            case (formatMessage('Add Cash Receipts')):
                url = `/${tenantName}/Finance/VoucherEntryCashReceipts`;
                title = formatMessage('Add Cash Receipts');
                break;
            case (formatMessage('Add Bank Receipts')):
                url = `/${tenantName}/Finance/VoucherEntryReceipts`;
                title = formatMessage('Add Bank Receipts');
