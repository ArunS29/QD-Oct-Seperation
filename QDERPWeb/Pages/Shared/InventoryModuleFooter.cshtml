<script type="text/javascript">
    function refreshPage() {
        location.reload();
    }
    function navigateToInvoiceEdit() {
               // Replace with the actual tenant name dynamically
                    var url = `/${tenantName}/Finance/VATInvoiceWithDetails`;
                window.location.href = url; // Navigate to the page
            }




        // function getDropdownData() {
