        //         { id: 1, name: "Item A" },
        //         { id: 2, name: "Item B" },
        //         { id: 3, name: "Item C" }
        //     ];
        // }

        // Fetch dropdown data (same API can be used if needed)
     function getDropdownData() {
        return $.ajax({
            url: "/api/VATModule/GetGoodsAndServices", // Update with your actual API endpoint
            method: "GET",
            dataType: "json"
        }).then(function(response) {
            console.log("GsData",response)
            return response.map(item => ({
                GSCode: item.Gscode,
                GSDescrpition: item.Gsdescrpition,
                GsdescriptionAr:item.GsdescriptionAr,
                ItemPartNo: item.ItemPartNo,
                CostPrice: item.CostPrice,
                GSSellingRate: item.GssellingRate,
                ReorderQty:item.ReorderQty
            }));
        });
    }


     // Handle button clicks
        function addPrintButton_click(e) {
            let url = "";
            let title = "Print1";
            switch (e.itemData.text) {
                case (formatMessage('Upload Items from Excel')):
                    url = `/${tenantName}/Finance/InventoryListtoUpload`;
                    title = formatMessage('Upload Items from Excel');
                    break;
                case (formatMessage('Profit On Sale')):
                    url = `/${tenantName}/Finance/InvoiceProfitorLossSummary`;
                    title = formatMessage('Profit On Sale');
                    break;
                case (formatMessage('Invoice Cost Posting')):
                    url = `/${tenantName}/Finance/InvoiceCostPosting`;
                    title = formatMessage('Invoice Cost Posting');
                    break;
                default:
                    console.log("Clicked item: ", e.itemData.text);
                    return;
            }
            openModal(url, title);
        }


        $(document).ready(function () {
            console.log('Start permission handling');
            // Form ID
            var formId = "frm201LedgerView";

            // Call the API to get permissions
            $.ajax({
                url: '/api/Permissions/GetAccessDetails?formId=' + formId,
                type: 'GET',
                contentType: 'application/json',
                success: function (response) {
                    console.log("API Response:", response); // Log the API response

                    if (response.success && response.permissions) {
                        // Default visibility and enable status for buttons
                        var controlStates = {
                            "btnShowRecords": { "Visible": false, "Enabled": false },
                            "btnPrint": { "Visible": false, "Enabled": false },
                            "btnSearch": { "Visible": false, "Enabled": false },
                            "ddButtonLayout": { "Visible": false, "Enabled": false },
                            "btnToggleSearch": { "Visible": false, "Enabled": false },
                            "btntoggleGroupPanel": { "Visible": false, "Enabled": false },
                            "btnToggleHeaderFilter": { "Visible": false, "Enabled": false },
                            "btnColumnChooser": { "Visible": false, "Enabled": false },
                            "ddButtonReceipts": { "Visible": false, "Enabled": false },
                            "ddButtonPayment": { "Visible": false, "Enabled": false },
                            "ddOtherVouchers": { "Visible": false, "Enabled": false },
