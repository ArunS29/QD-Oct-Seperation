         "Balance Sheet(Horizondal Format)":"BalanceSheetHorizondalFormat",
         "Cash Flow Statements":"Cash Flow Statements",
        "Bills Receivable- Ageing (By End Date)": "BillsReceivableEndDate",
        "Bills Receivable- Ageing as per Ledger Balance(By End Date)": "BillsReceivableledgerBalance",
          "Bills Receivable Summary- Ageing as per Ledger Balance (By End Date)":"BillsReceivablesSummaryAgeingasperLedgerBalanceByEndDate",
        "Bills Receivable Report(By End Date)": "BillsReceivablesReportByEndDate",
        "Bills Payable- Ageing (By End Date)": "BillsPayablesAgeingByEndDate",
        "Bills Payable- Ageing as per Ledger Balance(By End Date)": "BillsPayablesSummaryAgeingasperLedgerBalanceByEndDate",
          "Bills Payable Summary- Ageing as per Ledger Balance (By End Date)":"billsPayableSummaryLedgerBalance",
          "Bills Payable Report (By End Date)":"BillsPayableReportEnddate",
          "Property Allocation Report":"PropertAllocationReport",

      };
    function handleReportsClick(e) {
        const selectedText = e.itemData.text;

        // 👇 Use global selectedMode or default to "online"
        const mode = selectedMode || "online";

        var accountGroup = selectBox;
        var frmDateBox = $("#frmdateBox").dxDateBox("instance");
        var toDateBox = $("#todateBox").dxDateBox("instance");

        var frmDate = frmDateBox.option("value");
        var toDate = toDateBox.option("value");

            if (selectedText === "Trial Balance" && mode === "offline") {
            reportName = "TrialBalancePreReport";

            DevExpress.ui.notify({
                message: "📁 Your report is generating in *Offline Mode* (preloaded data).",
                type: "info",
                displayTime: 5000,
                position: {
                    my: "top center",
                    at: "top center"
                }
            }, "info", 3000);
        }

        function formatDate(date) {
            let dateObj = new Date(date);
            let day = dateObj.getDate();
            let month = dateObj.toLocaleString('en-US', { month: 'short' });
            let year = dateObj.getFullYear();
            return `${day}-${month}-${year}`;
        }

        var frmDateStr = formatDate(frmDate);
        var toDateStr = formatDate(toDate);

        if (reportMappingss[selectedText]) {
            let reportName = reportMappingss[selectedText];

            // 👇 Override report name if Trial Balance and mode is offline
            if (selectedText === "Trial Balance" && mode === "offline") {
                reportName = "TrialBalancePreReport";
            }

            if (selectedText === "Cash Flow Statements") {
                const formattedFrmDate = new Date(frmDate).toISOString().split('T')[0];
                const formattedToDate = new Date(toDate).toISOString().split('T')[0];
                var url = `/${tenantName}/Finance/CashInflow?fromDate=${formattedFrmDate}&toDate=${formattedToDate}`;
                window.open(url, '_blank');
            } else if (selectedText === "Property Allocation Report") {
                const formattedFrmDate = new Date(frmDate).toISOString().split('T')[0];
                const formattedToDate = new Date(toDate).toISOString().split('T')[0];
                var url = `/${tenantName}/Finance/PropertAllocationReport?fromDate=${formattedFrmDate}&toDate=${formattedToDate}`;
                window.open(url, '_blank');
            } else {
                    let url = `/${tenantName}/DocumentViewer?reportName=${encodeURIComponent(reportName)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}&accountGroup=${encodeURIComponent(accountGroup)}`;

                    const screenWidth = window.screen.availWidth;
                    const screenHeight = window.screen.availHeight;

                    window.open(
                        url,
                        '_blank',
                        `top=0,left=0,width=${screenWidth},height=${screenHeight},scrollbars=yes,resizable=yes`
                    );
            }
        } else {
            console.warn("No report mapping found for:", selectedText);
        }
    }




</script>

