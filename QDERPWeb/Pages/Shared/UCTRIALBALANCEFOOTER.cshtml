       // Function to open preview report in DocumentViewer
       function openPreviewReport(reportName, frmDateStr, toDateStr, accountGroup, tenantName) {
           console.log("openPreviewReport called with:", {reportName, frmDateStr, toDateStr, accountGroup, tenantName});
           
           // Show preview notification
           DevExpress.ui.notify("🔍 Opening report preview...", "info", 2000);
           
           // Build preview URL using DocumentViewer
           var previewUrl = `/${tenantName}/DocumentViewer?reportName=${encodeURIComponent(reportName)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}&accountGroup=${encodeURIComponent(accountGroup)}`;
           
           console.log("Preview URL:", previewUrl);
           
           try {
               // Open in new tab
               window.open(previewUrl, '_blank');
               
               // Success notification after short delay
               setTimeout(() => {
                   DevExpress.ui.notify("✅ Preview opened successfully!", "success", 2000);
               }, 500);
           } catch (error) {
               console.error('Preview error:', error);
               DevExpress.ui.notify("❌ Failed to open preview", "error", 3000);
           }
       }

       // Native browser download with progress notifications
       function downloadReportWithIndicator(reportName, frmDateStr, toDateStr, accountGroup, format) {
           const formatText = format === "pdf" ? "PDF" : "Excel";
           console.log(`downloadReportWithIndicator called: ${reportName}, ${format}`);
           
           // Build download URL with format parameter
           var downloadUrl = `/api/Report/DownloadReports?reportName=${encodeURIComponent(reportName)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}&accountGroup=${encodeURIComponent(accountGroup)}&format=${encodeURIComponent(format)}`;
           
           const fileExtension = format === "pdf" ? "pdf" : "xlsx";
           const fileName = `${reportName}_${frmDateStr}_to_${toDateStr}.${fileExtension}`;
           
           // Show enhanced notifications
           DevExpress.ui.notify({
               message: `� Generating ${formatText} report...\nThis may take several minutes for large reports.`,
               type: "info",
               displayTime: 4000,
               position: {
                   my: "top center",
                   at: "top center"
               }
           });
           
           // Add timestamp for cache busting
           const timestampedUrl = downloadUrl + `&_t=${Date.now()}`;
           
           // Trigger native browser download - this will show in browser's Downloads section
           const downloadLink = document.createElement('a');
           downloadLink.href = timestampedUrl;
           downloadLink.download = fileName;
           downloadLink.style.display = 'none';
           
           document.body.appendChild(downloadLink);
           downloadLink.click();
           document.body.removeChild(downloadLink);
           
           // Show follow-up notifications
           setTimeout(() => {
               DevExpress.ui.notify({
                   message: `📥 ${formatText} download started!\nCheck your browser's Downloads section for progress.`,
                   type: "success",
                   displayTime: 5000,
                   position: {
                       my: "top right",
                       at: "top right"
                   }
               });
           }, 2000);
           
           // Show reminder after longer delay
           setTimeout(() => {
               DevExpress.ui.notify({
                   message: `💡 Tip: Large reports may take 5-20 minutes to generate.\nDownload progress will appear in your browser's Downloads area.`,
                   type: "info",
                   displayTime: 6000,
                   position: {
                       my: "bottom right",
                       at: "bottom right"
                   }
               });
           }, 8000);
       }

       // Legacy function for backward compatibility
       function downloadReport(reportName, frmDateStr, toDateStr, accountGroup, format) {
           downloadReportWithIndicator(reportName, frmDateStr, toDateStr, accountGroup, format);
       }

