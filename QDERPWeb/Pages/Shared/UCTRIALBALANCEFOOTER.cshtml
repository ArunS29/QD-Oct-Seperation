                type: "info",
                displayTime: 5000,
                position: {
                    my: "top center",
                    at: "top center"
                }
            });
        }

        function formatDate(date) {
            if (!date) return "";
            let dateObj = new Date(date);
            let day = dateObj.getDate().toString().padStart(2, '0');
            let month = (dateObj.getMonth() + 1).toString().padStart(2, '0');
            let year = dateObj.getFullYear();
            return `${year}-${month}-${day}`; // Use ISO format for better parsing
        }

        var frmDateStr = formatDate(frmDate);
        var toDateStr = formatDate(toDate);
        
        // Get tenantName from global variable or extract from URL
        var tenantName = window.tenantName || document.location.pathname.split('/')[1];

        console.log("reportName from mapping:", reportName);
        console.log("frmDateStr:", frmDateStr);
        console.log("toDateStr:", toDateStr);
        console.log("accountGroup:", accountGroup);
        console.log("tenantName:", tenantName);

        if (reportName && reportName !== "") {
            // **Special handling for navigation-based reports**
            if (selectedText === "Cash Flow Statements") {
                var url = `/${tenantName}/Finance/CashInflow?fromDate=${frmDateStr}&toDate=${toDateStr}`;
                window.open(url, '_blank');
            } else if (selectedText === "Property Allocation Report") {
                var url = `/${tenantName}/Finance/PropertAllocationReport?fromDate=${frmDateStr}&toDate=${toDateStr}`;
                window.open(url, '_blank');
            } else {
                console.log("About to call showFormatSelectionPopup...");
                // **Show format selection popup**
                showFormatSelectionPopup(reportName, frmDateStr, toDateStr, accountGroup, tenantName);
            }
        } else {
            console.warn("No report mapping found for:", selectedText);
            DevExpress.ui.notify("Report not found for: " + selectedText, "warning", 2000);
        }
