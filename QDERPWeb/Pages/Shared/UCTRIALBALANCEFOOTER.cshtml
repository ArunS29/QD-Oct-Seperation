    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {

                    const layout = JSON.parse(e.target.result);


                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };


            reader.readAsText(file);
        }
    });

   



    function toggleMenuReports(e) {
        const menuContainer = document.getElementById("menuContainer");
        const button = document.getElementById("btnFinancialReports");

        if (menuContainer.style.display === "none") {
            // Position menu below the button
            const rect = button.getBoundingClientRect();
            menuContainer.style.position = "absolute";
            menuContainer.style.top = `${rect.bottom + window.scrollY}px`;
            menuContainer.style.left = `${rect.left + window.scrollX}px`;
            menuContainer.style.display = "block";
        } else {
            menuContainer.style.display = "none";
        }
    }





