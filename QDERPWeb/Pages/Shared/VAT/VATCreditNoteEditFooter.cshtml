        // Fetch approval status from API
        async function checkInvoiceApprovalStatus(invoiceNo) {
            try {
                const response = await $.ajax({
                    url: `/api/VATModule/GetInvoiceApprovalStatus/${encodeURIComponent(invoiceNo)}`,
                    method: 'GET',
                    dataType: 'json',
                });

                if (response && response.isApproved !== undefined) {
                    console.log('Invoice Approval Status:', response.isApproved);
                    return response.isApproved;
                } else {
                    console.log("Error: Invalid response from server.");
                    return false;
                }
            } catch (error) {
                console.log("Error fetching approval status:", error);
                return false;
            }
        }

