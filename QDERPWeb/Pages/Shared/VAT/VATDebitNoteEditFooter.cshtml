                    function handleReportClick(e) {
            const selectedText = e.itemData.text;
            const reportName = reportMappings[selectedText];

            if (!reportName) {
                console.warn('No report mapping found for:', selectedText);
                return;
            }

            // Extract tenant name from URL
            let pathParts = window.location.pathname.split('/');
            let tenantName = pathParts[1] || "defaultTenant";

            if (!tenantName) {
                console.error("tenantName is not defined.");
                return;
            }

            // Get the DateBox instances
            var frmDateBox = $("#frmdateBox").dxDateBox("instance");
            var toDateBox = $("#todateBox").dxDateBox("instance");

            if (!frmDateBox || !toDateBox) {
                console.error("DateBox instances not found.");
                alert("Date selection components are missing.");
                return;
            }

            // Get and format the date values
            var frmDate = frmDateBox.option("value");
            var toDate = toDateBox.option("value");

            function formatDate(date) {
                if (!date) return "";
                let dateObj = new Date(date);
                let day = dateObj.getDate();
                let month = dateObj.toLocaleString('en-US', { month: 'short' });
                let year = dateObj.getFullYear();
                return `${day}-${month}-${year}`;
            }

            var frmDateStr = formatDate(frmDate);
            var toDateStr = formatDate(toDate);

            if (!frmDateStr || !toDateStr) {
                alert("Please select valid From and To dates.");
                return;
            }

            // Open report in new tab with date parameters
            const reportUrl = `/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}`;
            window.open(reportUrl, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
        }
        // Handles all report printing logic
        function handleReportPrinting(itemText) {
            var invoiceNoBox = $("#InvoiceNo").dxTextBox("instance");
            var invoiceNo = invoiceNoBox.option("value");

            if (!invoiceNo) {
                alert("Invoice No is required.");
                return;
            }

            checkInvoiceApprovalStatus(invoiceNo).then(function (isApproved) {
                var reportName = "";
                var watermarkText = isApproved ? "" : "Draft Copy";

                switch (itemText) {
                    case "Print Regular TAX Invoice":
                        reportName = "TAXINVOICEWTDOCUMENTALLEVELDISCOUNTSS";
                        break;
                    case "Print Simplified TAX Invoice":
                        reportName = "PrintsimplifiedTaxInvoices";
                        break;
                    case "Print Regular Tax Invoice - Format 02":
                        reportName = "PrintRegularInvoiceFormat02";
                        break;
                    case "Print Tax Invoice - (Foreign Currency)":
                        reportName = "Foreigncurrency1";
                        break;
                    case "Print Regular Tax Invoice - Without Signatories (Format 05)":
                        reportName = "RegulartaxinvoicewithoutSignatoriesFormat05";
                        break;
                    case "Print Regular Tax Invoice - With Signatories (Format 05)":
                        reportName = "PrintRegularTaxInvoiceWithSignatories_Format05_";
                        break;
                    case "Design 02 (W/o Signatories)":
                        reportName = "Withoutsignatories";
                        break;
                    case "Design 02 (With Signatories)":
                        reportName = "withsignatories";
                        break;
                        case "Print Regular Tax Invoice -  (Format 06)":
                            reportName = "RegularTaxInvoiceFormat06";
                            break;
                        case "Print Regular Tax Invoice - wt Document Level Discount":
                            reportName = "PrintRegularTaxInvoiceWtDocumentLevelDiscount";
                            break;

                         case "Print Regular Tax Invoice - without Signatories(with symbols)":
                            reportName = "taxinvoicewithSignatoriesWithSymbols";
                            break;



                   case "Preview Invoices in (Foreign Currency)":
                            reportName = "ForeignCurrencyProforma";
                            break;
                        case "Preview Invoices in Foreign Currency(English)":
                            reportName = "ForeignEnglishProforma";
                            break;
                        case "Preview Invoice(English)":
                            reportName = "ProformaInvoiceEnglish";
                            break;
                        case "Preview Invoice":
                            reportName = "ProformaPreviewInvoice";
                            break;
                             case "Preview Proforma Invoice(NewFormat)":
                            reportName = "ProformaNewFormat";
                            break;
                        case "Preview Invoices in -with discount":
                            reportName = "Wtdiscountpreviewinvoice";
                            break;
                        case "Preview Invoices in -withOut discount":
                            reportName = "WithoutDiscountInvoice";
                            break;

                    case "Preview VAT Purchase Bill":
                            reportName = "BillsPurchases";
                            break;
                    default:
                        alert("Invalid report format selected.");
                        return;
                }

                window.open(
                    `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&invoiceNo=${encodeURIComponent(invoiceNo)}&skipPreview=true&watermark=${encodeURIComponent(watermarkText)}&isApproved=${isApproved}`,
                    '_blank',
