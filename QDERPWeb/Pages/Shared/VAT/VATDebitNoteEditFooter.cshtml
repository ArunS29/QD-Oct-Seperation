        async function handleCreditReportPrinting(e) {
            const itemText = e.itemData?.text;
            const tenantName = window.tenantName || ""; // Ensure tenantName is defined globally

            let creditNoteNo = $("#CreditNoteNo").dxTextBox("instance").option("value");

            if (!creditNoteNo) {
                alert("Credit Note No is required.");
                return;
            }

            try {
                const isApproved = await checkInvoiceApprovalStatus1(creditNoteNo);
                const watermarkText = isApproved ? "" : "Draft Copy";
                let reportName = "";

                switch (itemText) {
                    case "Preview Credit Note":
                            reportName = "creditnote";
                        break;
                    case "Preview Credit Note(Foreign Currency)":
                        reportName = "CreditForeignCurrency";
                        break;

                    default:
                        alert("Invalid report format selected.");
                        return;
                }

                const url = `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&CreditNoteNo=${encodeURIComponent(creditNoteNo)}&skipPreview=true&watermark=${encodeURIComponent(watermarkText)}&isApproved=${isApproved}`;

                window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
            } catch (error) {
                console.error("Error checking approval status:", error);
                alert("Failed to check invoice approval status.");
            }
        }

        async function checkInvoiceApprovalStatus1(creditNoteNo) {
            try {
                const response = await $.ajax({
                    url: `/api/VATModule/GetCreditNoteApprovalStatus/${encodeURIComponent(creditNoteNo)}`,
                    method: 'GET',
                    dataType: 'json',
                });

                return response?.isApproved ?? false;
            } catch (error) {
                console.error("Error fetching approval status:", error);
                return false;
            }
        }


