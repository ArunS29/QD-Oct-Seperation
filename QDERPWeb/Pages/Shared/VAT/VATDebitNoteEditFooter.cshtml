        function handleReportPrinting2(e) {
            const debitNoteBox = $("#DebitNoteNo").dxTextBox("instance");
            const debitNoteNo = debitNoteBox.option("value");

            if (!debitNoteNo) {
                alert("Debit Note No is required.");
                return;
            }

            const itemText = e.itemData?.text;

            if (itemText !== "Preview DebitNote Invoice") {
                alert("Invalid report format selected.");
                return;
            }

            GetDebitNoteApprovalStatus(debitNoteNo).then(function (status) {
                const reportName = "DebitNoteView";

                // Show "Draft Copy" watermark for any status other than "Approved"
                const watermarkText = (status === "Approved") ? "" : "Draft Copy";

                window.open(
                    `/${tenantName}/VoucherViewer?reportName=${encodeURIComponent(reportName)}&debitNoteNo=${encodeURIComponent(debitNoteNo)}&skipPreview=true&watermark=${encodeURIComponent(watermarkText)}&isApproved=${status === "Approved"}`,
                    '_blank',
                    'width=1200,height=800,scrollbars=yes,resizable=yes'
                );
            }).catch(function (error) {
                console.error("Error checking invoice approval status:", error);
                alert("Failed to check invoice approval status.");
            });
        }

