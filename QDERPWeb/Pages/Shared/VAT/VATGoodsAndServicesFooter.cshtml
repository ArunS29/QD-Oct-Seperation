        // Fetch approval status from API
        async function checkInvoiceApprovalStatus(invoiceNo) {
            try {
                const response = await $.ajax({
                    url: `/api/VATModule/GetInvoiceApprovalStatus/${encodeURIComponent(invoiceNo)}`,
                    method: 'GET',
                    dataType: 'json',
                });

                if (response && response.isApproved !== undefined) {
