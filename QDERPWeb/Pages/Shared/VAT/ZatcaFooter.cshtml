<div class="dx-fieldset horizontal-container" style="width:1000px;background-color:transparent;gap:3px">


    <div class="btn-containers">
        @(Html.DevExtreme().Button()
            .ID("btnZatcaPortal")
            .Text(new JS("formatMessage('Connect to Zatca Portal')"))
            .Type(ButtonType.Normal)
             .Width(40)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("editconnection") // Change the icon to an up/down arrow option
            .ElementAttr(new { @class = "bold-button" })
            )
    </div>
    <div class="btn-containers">
        @(Html.DevExtreme().Button()
            .ID("btnSubmitInvoiceToZatca")
                .Text(new JS("formatMessage('Submit Invoice To Zatca')"))
            .Type(ButtonType.Normal)
            .Width(40)
            .StylingMode(ButtonStylingMode.Outlined)
                .Icon("save") // Change the icon to an up/down arrow option
            .ElementAttr(new { @class = "bold-button" })
            )
    </div>

    <div class="btn-containers">
        @(Html.DevExtreme().Button()
            .ID("btnPrintPreview")
            .Text(new JS("formatMessage('Save')"))
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
            .Icon("preview")
            .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
                                                         // .OnClick("saveInvoiceDetails") // Calls the JavaScript function
            )

    </div>

    <div class="btn-containers">

        @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text(new JS("formatMessage('Back')"))
            .Type(ButtonType.Normal)
            .StylingMode(ButtonStylingMode.Outlined)
                .Icon("arrowleft")
            .ElementAttr(new { @class = "bold-button" }) // Apply custom CSS class
            )
    </div>

</div>



