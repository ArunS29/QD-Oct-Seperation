    .modal-content {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 90%;
        height: 90%;
        max-height: 800px;
        background: white;
        border-radius: 8px;
        padding: 0;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
        overflow: hidden; /* Prevents content overflow */
    }

    .update-button {
        font-weight: bold;
        padding: 10px 20px;
        background-color: #e0e7f0;
        border-radius: 6px;
    }


    .btn-containerIvoiceEdit .dx-button {
        width: 40px !important; /* Small width for just the icon */
        transition: width 0.3s ease-in-out;
        overflow: hidden;
        padding-left: 0 !important;
        padding-right: 0 !important;
        text-align: center;
    }

    /* On hover, expand the button */
    .btn-containerIvoiceEdit:hover .dx-button {
        width: 200px !important;
    }

    .btn-container:hover #btnAddNewPayment.dx-button {
        width: 240px !important;
    }

    /* Keep the icon always visible */
    .btn-containerIvoiceEdit .dx-button .dx-icon {
        display: inline-block !important;
    }

    /* Initially hide text */
    .btn-containerIvoiceEdit .dx-button .dx-button-text {
        display: none;
    }

    /* Show text on hover */
    .btn-containerIvoiceEdit:hover .dx-button .dx-button-text {
        display: inline-block;
        margin-left: 8px; /* optional spacing between icon and text */
    }



    .multiline-button .dx-button-text {
        white-space: normal;
    }
