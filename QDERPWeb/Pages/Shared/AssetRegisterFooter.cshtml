                window.open(`/${tenantName}/Finance/Voucherjournal`, 'popupWindow', 'width=1200,height=800,scrollbars=yes,resizable=yes');
                break;

            // You can handle other cases here if needed
            default:
                console.log("Clicked item: ", e.itemData.text);
        }
    }



    function ChangeRowHeight(newHeight) {
        // Update the row height
        $("#dataGrid .dx-data-row").css("height", newHeight + "px");
        closeSubmenu();
    }
    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function closeSubmenu() {
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {

                    const layout = JSON.parse(e.target.result);


                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };


            reader.readAsText(file);
        }
    });

            function handleReportClick(e) {
        var selectedText = e.itemData.text;

        var selectBox = $("#voucherTypeSelect").dxSelectBox("instance");
        var voucherType = selectBox ? selectBox.option("value") : null;

        var frmDateBox = $("#frmdateBox").dxDateBox("instance");
        var toDateBox = $("#todateBox").dxDateBox("instance");

        var frmDate = frmDateBox ? frmDateBox.option("value") : null;
        var toDate = toDateBox ? toDateBox.option("value") : null;

        if (!voucherType) {
            alert("Please select a voucher type.");
            return;
        }

        function formatDate(date) {
            if (!date) return "";
            let dateObj = new Date(date);
            let day = dateObj.getDate();
            let month = dateObj.toLocaleString('en-US', { month: 'short' });
            let year = dateObj.getFullYear();
            return `${day}-${month}-${year}`;
        }

        var frmDateStr = formatDate(frmDate);
        var toDateStr = formatDate(toDate);

        console.log("Selected Report Type:", selectedText);
        console.log("Voucher Type:", voucherType);
        console.log("Formatted From Date:", frmDateStr);
        console.log("Formatted To Date:", toDateStr);

        var tenantName = window.tenantName || "defaultTenant";

        const reportMappings = {
            "Preview Register": "PreviewRegister",
            "Preview Register (Order By VoucherNo)": "OrderByVchNoRegister",
            "Preview Register (With Line Entry Narration)": "RegisterLineEntryNarration",
            "Preview Register (With Line Entry Narration Order by VoucherNo)": "Register4line",
            "Preview Register (With Voucher Narration)": "RegisterWithVchNarration",
            "Preview Register (With Voucher Narration - Order by Voucher No)": "OrderbyVchNoWIthVchNarration"
        };

        if (reportMappings[selectedText]) {
            let reportName = reportMappings[selectedText];
            console.log(`Redirecting to ${reportName}`);

            window.open(
                `/${tenantName}/RegisterViewer?reportName=${encodeURIComponent(reportName)}&voucherType=${encodeURIComponent(voucherType)}&frmDate=${encodeURIComponent(frmDateStr)}&toDate=${encodeURIComponent(toDateStr)}&skipPreview=true`,
                '_blank',
                'width=1200,height=800,scrollbars=yes,resizable=yes'
            );
        } else {
            console.error("No matching report found for selectedText:", selectedText);
        }

        if (typeof ChangeRowHeight === "function") {
            ChangeRowHeight(70);
        }
    }


</script>
