            function saveverifydetails(){
            var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var rowCount = dataGrid.getVisibleRows().length;

        if (rowCount !== 0) {
            var gridData = dataGrid.getDataSource().items(); // Gets all current grid data

            var VM = {
                ClaimRefNo: $("#VoucherNo").dxTextBox("instance").option("value"),
                ClaimDate: $("#claimerdate").dxDateBox("instance").option("value")|| new Date(),
                ClaimEffectiveDate:$("#claimerEffectiveDate").dxDateBox("instance").option("value")|| new Date(),
                ProjectClaimedFor: paymentaccheadId,
                ClaimRemarks: $("#txtEntryNarration").dxTextArea("instance").option("value"),
                PaymentType: $("#radioGroup").dxRadioGroup("instance").option("value") || null,
                PaymentAccount: $("#ddAccountHead").dxDropDownBox("instance").option("value")||null,
                FundRequestTypeId: 2,
                ExpenseDetails: gridData // 🔁 Add the grid rows here
            };

            $.ajax({
                type: "POST",
                url: "/api/ExpenseClaim/UpdateVoucher",
                contentType: "application/json",
                data: JSON.stringify(VM),
                dataType: "json",
                success: function (response) {
                    if (response.success) {
                             proceedWithVerify();
                    } else {
                        alert("Update failed: " + response.message);
                    }
                },
                error: function () {
                    DevExpress.ui.dialog.alert(
                        "Voucher has no line items to be saved, please enter transaction to save.!",
                        "No Line Items"
                    );
                }
            });
        } else {
            if (IsNotification === true) {
                DevExpress.ui.dialog.alert(
                    "Cannot continue saving with errors, please clear the errors and continue.",
                    "Clear Errors"
                );
            } else {
                DevExpress.ui.dialog.alert(
                    "Voucher has no line items to be saved, please enter transaction to save.!",
                    "No Line Items"
                );
            }
        }
        }
            function proceedWithVerify() {
        const voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

        $.ajax({
            url: '/api/ExpenseClaim/Verifyclaim',
            method: 'POST',
             data: JSON.stringify({ ClaimRefNo: voucherNo }),
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.dialog.alert("Claim has been Verified for Approval.", "Verified Successfull")
                        .done(function () {
                            $("#VerifiedOntext").dxTextBox("instance").option("value", response.verifiedBy);
                            $("#VerifiedBytext").dxTextBox("instance").option("value", response.verifiedOn);
                            $("#IsVerified").dxCheckBox("instance").option("value", true);

                            disableclaim();
                            syncWorkflowFromFields();
                        });
                } else {
                    DevExpress.ui.notify("Submission failed.", "error", 2000);
                }
            },
            error: function () {
                DevExpress.ui.notify("An error occurred while submitting the claim.", "error", 2000);
            }
        });
    }

