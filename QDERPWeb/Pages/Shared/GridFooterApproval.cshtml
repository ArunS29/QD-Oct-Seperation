        function ChangeRowHeight(newHeight) {
            // Update the row height
            $("#dataGrid .dx-data-row").css("height", newHeight + "px");
            closeSubmenu();
        }
        function showSubmenu(e) {
            e.event.stopPropagation();
            var $submenu = $('#submenuContainer');
            var $target = $(e.event.target).closest('.dx-item-content');
            var offset = $target.offset();
            var elementWidth = $target.outerWidth();

            // Position submenu with a slight margin (e.g., 5px)
            $submenu.css({
                'width': 180,
                'position': 'absolute',
                'top': offset.top,
                'left': offset.left + elementWidth + 5, // Add margin
                'display': 'block'
            });
        }

        function closeSubmenu() {
            $("#submenuContainer").hide();
        }
        // Handle the file selection
        $("#loadLayoutInput").on("change", function (event) {
            const dataGrid = $("#dataGrid").dxDataGrid("instance");
            const file = event.target.files[0];

            if (file) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    try {

                        const layout = JSON.parse(e.target.result);


                        dataGrid.state(layout);
                    } catch (error) {
                        console.error("Error parsing JSON:", error);
                        alert("Failed to load layout. Please ensure the file is valid JSON.");
                    }
                };


                reader.readAsText(file);
            }
        });
    function onVoucherSelection(e) {
        var selectedText = e.itemData.text;
        var voucherType = [];
        startDate = $("#VoucherDate").dxDateBox("instance").option("value");
        endDate = $("#EffectiveDate").dxDateBox("instance").option("value");

        if (!(startDate instanceof Date)) startDate = new Date(startDate);
        if (!(endDate instanceof Date)) endDate = new Date(endDate);

        // Format as MM/dd/yyyy (because the backend is allergic to ISO?)
        startDate = startDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });

        endDate = endDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });

        switch (selectedText) {
            case formatMessage("All Vouchers"):
                voucherType = ["Bank Payment", "Cash Payment",
                    "Bank Receipts", "Cash Receipts",
                    "Sales", "Purchases", "Journal"]; // Show all vouchers
                break;
            case formatMessage("Payments"):
                voucherType = ["Bank Payment", "Cash Payment"];
                break;
            case formatMessage("Receipts"):
                voucherType = ["Bank Receipts", "Cash Receipts"];
                break;
            case formatMessage("Client Receivables"):
                voucherType = ["Sales"];
                break;
            case formatMessage("Supplier Payables"):
                voucherType = ["Purchases"];
                break;
            case formatMessage("Other Vouchers"):
                voucherType = ["Journal"];
                break;
        }

        // 🚀 Final AJAX call
        $.ajax({
            url: '/api/VoucherApproval/GetVoucherApprovals',
            type: 'GET',
            data: {
                startDate: startDate, // already formatted
                endDate: endDate,     // already formatted
                voucherTypes: voucherType.join(",")
            },
            success: function (data) {
                const targetGrid = $("#dataGrid").dxDataGrid("instance");
                targetGrid.option("dataSource", data);
                targetGrid.refresh();
            },
            error: function (err) {
                DevExpress.ui.notify("Failed to load data", "error", 2000);
                console.error(err);
            }
        });
    }


