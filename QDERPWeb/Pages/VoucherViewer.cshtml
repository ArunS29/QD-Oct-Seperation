@page
@using DevExpress.AspNetCore
@using QD.ERP.Web.Areas.Finance.Reports
@using QD.ERP.Web.Reports
@model QD.ERP.Web.Pages.VoucherViewerModel

<link rel="stylesheet" href="~/css/reporting.designer.part.bundle.css" />
<script src="~/js/reporting.designer.part.bundle.js"></script>

<script>
    function onDocumentViewerReady(s, e) {
        s.preview.zoom(1); 
    }

    function openEmailPopup() {
        alert('Preparing');

        var voucherNo = '@Model.VoucherNo';
        var currentReportName = 'cashPayments';

        console.log("Voucher No:", voucherNo);
        console.log("Current Report Name:", currentReportName);

        fetch('/api/ReportAttachment/Prepare', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                reportName: currentReportName,
                voucherNo: voucherNo
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const fileName = data.fileName;
                const tenantName = window.location.pathname.split('/')[1]; // e.g., 'Sudhir'

                // ✅ FIXED PATH (removed /Pages)
                document.getElementById("emailFrame").src =
                    `/${tenantName}/EmailCompose?fileName=${encodeURIComponent(fileName)}`;

                const popup = document.getElementById("emailPopup");
                popup.style.display = "flex";
                popup.classList.add("fade-in");

                document.getElementById("emailLoader").style.display = "block";
                setTimeout(() => {
                    document.getElementById("emailLoader").style.display = "none";
                }, 1500);
            } else {
                alert("Failed to prepare attachment.");
            }
        })
        .catch(err => {
            console.error("Attachment generation failed:", err);
            alert("Error preparing email attachment.");
        });
    }



    function closeEmailPopup() {
        const popup = document.getElementById("emailPopup");
        popup.classList.remove("fade-in");
        popup.classList.add("fade-out");
        setTimeout(() => {
            popup.style.display = "none";
            popup.classList.remove("fade-out");
            document.getElementById("emailFrame").src = "";
        }, 500);
    }

    function refreshEmailPopup() {
        document.getElementById("emailFrame").src = document.getElementById("emailFrame").src;
    }

    function maximizePopup() {
        const popup = document.querySelector(".popup-content");
        popup.classList.toggle("maximized");
    }

    function showErrorPopup(message) {
        const errorPopup = document.getElementById("errorPopup");
        document.getElementById("errorMessage").innerText = message;
        errorPopup.style.display = "block";
        setTimeout(() => {
            errorPopup.style.display = "none";
        }, 3000);
    }

    function makeDraggable() {
        const popup = document.querySelector(".popup-content");
        let isDragging = false, offsetX, offsetY;

        popup.addEventListener("mousedown", (e) => {
            isDragging = true;
            offsetX = e.clientX - popup.getBoundingClientRect().left;
            offsetY = e.clientY - popup.getBoundingClientRect().top;
            popup.style.transition = "none";
        });

        document.addEventListener("mousemove", (e) => {
            if (isDragging) {
                popup.style.left = `${e.clientX - offsetX}px`;
                popup.style.top = `${e.clientY - offsetY}px`;
            }
        });

        document.addEventListener("mouseup", () => {
            isDragging = false;
            popup.style.transition = "0.3s ease-in-out";
        });
    }

    document.addEventListener("DOMContentLoaded", makeDraggable);


            document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" || event.keyCode === 27) {
            window.close();
        }
    });
</script>

<button class="btn btn-primary send-email-btn" onclick="openEmailPopup()">📧 Send Email</button>

@(Html.DevExpress().WebDocumentViewer("documentViewer")
    .Height("100em")
    
    .ClientSideEvents(events => events.DocumentReady("onDocumentViewerReady"))
    .Bind(Model.Report))


<a href="javascript:void(0);" id="btnOpenDesigner" class="btn-edit-report"
   onclick="openReportDesigner(
   '@Model.ReportName',
   '@Model.quotationNo',
   '@Model.purchaseOrderNo',
   '@Model.rfqNo',
   '@Model.deliveryNoteNo',
   '@Model.salesOrderNo',
   '@Model.RequestNo',
   '@Model.CreditNoteNo',
   '@Model.debitNoteNo',
   '@Model.invoiceNo'
)">
    <span class="btn-text">Open Designer</span>
    <i class="fa fa-pencil-alt"></i>
</a>

<!-- Email Popup -->
<div id="emailPopup" class="popup-overlay">
    <div class="popup-content">
        <div class="popup-header">
            <h5 class="popup-title">📩 Compose Email</h5>
            <button class="popup-btn" onclick="refreshEmailPopup()">🔄</button>
            <button class="popup-btn" onclick="maximizePopup()">🗖</button>
            <button class="popup-close" onclick="closeEmailPopup()">✖</button>
        </div>
        <div id="emailLoader" class="loader"></div>
        <iframe id="emailFrame" src="" width="800px" height="500px" style="border: none;"></iframe>
    </div>
</div>

<!-- Error Popup -->
<div id="errorPopup" class="alert-popup">
    <p id="errorMessage"></p>
</div>

<!-- CSS Styles -->
<style>
    .popup-content.maximized {
        position: fixed !important;
        width: 100vw !important;
        height: 100vh !important;
        max-width: none !important;
        max-height: none !important;
        top: 0 !important;
        left: 0 !important;
        border-radius: 0 !important;
    }

    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .popup-content {
        position: absolute;
        background: white;
        width: 50%;
        max-width: 800px;
        border-radius: 8px;
        box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        transition: transform 0.3s ease-in-out;
    }

    .btn-edit-report {
        position: fixed;
        top: 14px; /* Positioning from the top */

        right: 4px; /* Positioning from the right */

        background-color: transparent;
        border: 1px solid #007bff; /* Border to make it rectangular */

        padding: 5px 15px; /* Adjusting padding for rectangular shape */

        font-size: 14px;
        color: #007bff; /* Button color */

        border-radius: 15px; /* Curved edges */

        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Slight shadow */

        cursor: pointer;
        z-index: 9999; /* Ensure it's on top of other elements */

        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        height: 35px; /* Height set between 10-15px */
    }

    .popup-header {
        background: #007bff;
        color: white;
        padding: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: move;
    }

    .popup-title {
        margin: 0;
    }

    .popup-btn, .popup-close {
        background: none;
        border: none;
        color: white;
        font-size: 18px;
        cursor: pointer;
        transition: color 0.3s ease-in-out;
    }

        .popup-btn:hover, .popup-close:hover {
            color: #ffcccc;
        }

    .loader {
        display: none;
        border: 5px solid #f3f3f3;
        border-top: 5px solid #3498db;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    @@keyframes spin {
        0% {
            transform: translate(-50%, -50%) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) rotate(360deg);
        }
    }

    .fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    .fade-out {
        animation: fadeOut 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
            transform: scale(1);
        }

        to {
            opacity: 0;
            transform: scale(0.9);
        }
    }

    .alert-popup {
        position: fixed;
        top: 10px;
        right: 10px;
        background: red;
        color: white;
        padding: 10px;
        border-radius: 5px;
        display: none;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 0px !important;
    }

    .mainContainer {
        background-color: white;
        margin-top: 0px;
        margin-left: 0px;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        padding: 0px;
    }
    /* Floating Close Button */

    .send-email-btn {
        position: fixed;
        top: 14px; /* Positioning from the top */

        left: 4px; /* Adjusting position from the right (so it doesn't overlap with Open Designer button) */

        background-color: transparent;
        border: 1px solid #dc3545; /* Border to make it rectangular */

        padding: 5px 15px; /* Adjusting padding */

        font-size: 14px;
        color: #dc3545; /* Button color */

        border-radius: 15px; /* Curved edges */

        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Slight shadow */

        cursor: pointer;
        z-index: 9999; /* Ensure it's on top of other elements */

        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        height: 35px;
    }

    .btn-edit-report .btn-text {
        margin-right: 10px; /* Space between the text and the icon */

        font-weight: bold;
    }

    .btn-edit-report i {
        font-size: 16px;
    }

    /* Change on Hover */

    .btn-edit-report:hover {
        background-color: rgba(0, 123, 255, 0.1); /* Light blue background on hover */

        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3); /* Larger shadow */

        color: #0056b3; /* Darker color on hover */
    }

</style>
<script>

       function getTenantNameFromUrl() {
        const pathParts = window.location.pathname.split('/');
        return pathParts[1] || '';
    }
      function openReportDesigner(
    reportName,
    quotationNo,
    purchaseOrderNo,
    rfqNo,
    deliveryNoteNo,
    salesOrderNo,
    requestNo,
    creditNoteNo,
    debitNoteNo,
    invoiceNo
) {
    const tenantName = getTenantNameFromUrl();

    if (!tenantName || !reportName) {
        alert("Missing required parameters.");
        return;
    }

    let reportDesignerUrl = `/${tenantName}/InvoiceDesigner?reportName=${encodeURIComponent(reportName)}`;

    // Only add the relevant parameter for the selected report
    switch (reportName) {
        case "PreviewQuotations":
        case "PreviewQuotationwithadditionalDetails":
        case "PreviewQuotationwithoutPrice":
        case "QuotationWOvat":
        case "vatTotalPricewithout":
        case "withoutvatDiscount":
        case "GroupCode":
        case "wtDiscount":
        case "PreviewQuotationWithImage":
        case "PreviewQuotationWithSubGroup":
            if (quotationNo && quotationNo !== "null" && quotationNo !== "undefined") {
                reportDesignerUrl += `&quotationNo=${encodeURIComponent(quotationNo)}`;
            }
            break;
        case "MaterialRequestInventory":
        case "MaterialPurcchaseRequestion":
            if (requestNo && requestNo !== "null" && requestNo !== "undefined") {
                reportDesignerUrl += `&RequestNo=${encodeURIComponent(requestNo)}`;
            }
            break;
        case "SalesOrderReport":
        case "SalesOrderReportWithoutPrice":
            if (salesOrderNo && salesOrderNo !== "null" && salesOrderNo !== "undefined") {
                reportDesignerUrl += `&salesOrderNo=${encodeURIComponent(salesOrderNo)}`;
            }
            break;
        case "PreviewDeliveryNote":
        case "ReportforMaterialIssueNote":
        case "PreviewDeliveryNotewithPrice":
        case "DotMatrics":
        case "DeliveryNoteWithCostPrice":
            if (deliveryNoteNo && deliveryNoteNo !== "null" && deliveryNoteNo !== "undefined") {
                reportDesignerUrl += `&deliveryNoteNo=${encodeURIComponent(deliveryNoteNo)}`;
            }
            break;
        case "RFQEdit":
            if (rfqNo && rfqNo !== "null" && rfqNo !== "undefined") {
                reportDesignerUrl += `&rfqNo=${encodeURIComponent(rfqNo)}`;
            }
            break;
        // Add other cases as needed
        default:
            // Optionally handle other report types
            break;
    }

    window.open(reportDesignerUrl, "_blank", "noopener,noreferrer,width=1200,height=800");
}

     document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" || event.keyCode === 27) {
            window.close();
        }
    });
</script>