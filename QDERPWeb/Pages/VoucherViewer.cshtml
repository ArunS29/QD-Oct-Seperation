@page
@using DevExpress.AspNetCore
@using QD.ERP.Web.Areas.Finance.Reports
@using QD.ERP.Web.Reports
@model QD.ERP.Web.Pages.VoucherViewerModel

<link rel="stylesheet" href="~/css/reporting.designer.part.bundle.css" />
<script src="~/js/reporting.designer.part.bundle.js"></script>

<script>
    function onDocumentViewerReady(s, e) {
        s.preview.zoom(1); // Set document viewer zoom to 100%
    }

    function openEmailPopup() {
        alert('Hi'); // This shows that the function is being called

        var voucherNo = '@Model.VoucherNo'; // Ensure this value is properly passed from the Razor view
        var currentReportName = 'cashPayments'; // Ensure currentReportName is set correctly

        console.log("Voucher No:", voucherNo); // Check if voucherNo is correctly set
        console.log("Current Report Name:", currentReportName); // Check if report name is correct

        fetch('/api/ReportAttachment/Prepare', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                reportName: currentReportName,
                voucherNo: voucherNo
            })
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const fileName = data.fileName;

                    const popup = document.getElementById("emailPopup");
                    document.getElementById("emailFrame").src = "/Pages/EmailCompose?fileName=" + encodeURIComponent(fileName);

                    popup.style.display = "flex";
                    popup.classList.add("fade-in");

                    document.getElementById("emailLoader").style.display = "block";
                    setTimeout(() => {
                        document.getElementById("emailLoader").style.display = "none";
                    }, 1500);
                } else {
                    alert("Failed to prepare attachment.");
                }
            })

            .catch(err => {
                console.error("Attachment generation failed:", err);
                alert("Error preparing email attachment.");
            });
    }


    function closeEmailPopup() {
        const popup = document.getElementById("emailPopup");
        popup.classList.remove("fade-in");
        popup.classList.add("fade-out");
        setTimeout(() => {
            popup.style.display = "none";
            popup.classList.remove("fade-out");
            document.getElementById("emailFrame").src = "";
        }, 500);
    }

    function refreshEmailPopup() {
        document.getElementById("emailFrame").src = document.getElementById("emailFrame").src;
    }

    function maximizePopup() {
        const popup = document.querySelector(".popup-content");
        popup.classList.toggle("maximized");
    }

    function showErrorPopup(message) {
        const errorPopup = document.getElementById("errorPopup");
        document.getElementById("errorMessage").innerText = message;
        errorPopup.style.display = "block";
        setTimeout(() => {
            errorPopup.style.display = "none";
        }, 3000);
    }

    function makeDraggable() {
        const popup = document.querySelector(".popup-content");
        let isDragging = false, offsetX, offsetY;

        popup.addEventListener("mousedown", (e) => {
            isDragging = true;
            offsetX = e.clientX - popup.getBoundingClientRect().left;
            offsetY = e.clientY - popup.getBoundingClientRect().top;
            popup.style.transition = "none";
        });

        document.addEventListener("mousemove", (e) => {
            if (isDragging) {
                popup.style.left = `${e.clientX - offsetX}px`;
                popup.style.top = `${e.clientY - offsetY}px`;
            }
        });

        document.addEventListener("mouseup", () => {
            isDragging = false;
            popup.style.transition = "0.3s ease-in-out";
        });
    }

    document.addEventListener("DOMContentLoaded", makeDraggable);
</script>

<button class="btn btn-primary send-email-btn" onclick="openEmailPopup()">📧 Send Email</button>

@(Html.DevExpress().WebDocumentViewer("documentViewer")
    .Height("100em")
    .Width("110em")
    .ClientSideEvents(events => events.DocumentReady("onDocumentViewerReady"))
    .Bind(Model.Report))

<!-- Email Popup -->
<div id="emailPopup" class="popup-overlay">
    <div class="popup-content">
        <div class="popup-header">
            <h5 class="popup-title">📩 Compose Email</h5>
            <button class="popup-btn" onclick="refreshEmailPopup()">🔄</button>
            <button class="popup-btn" onclick="maximizePopup()">🗖</button>
            <button class="popup-close" onclick="closeEmailPopup()">✖</button>
        </div>
        <div id="emailLoader" class="loader"></div>
        <iframe id="emailFrame" src="" width="800px" height="500px" style="border: none;"></iframe>
    </div>
</div>

<!-- Error Popup -->
<div id="errorPopup" class="alert-popup">
    <p id="errorMessage"></p>
</div>

<!-- CSS Styles -->
<style>
    .popup-content.maximized {
        position: fixed !important;
        width: 100vw !important;
        height: 100vh !important;
        max-width: none !important;
        max-height: none !important;
        top: 0 !important;
        left: 0 !important;
        border-radius: 0 !important;
    }

    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .popup-content {
        position: absolute;
        background: white;
        width: 50%;
        max-width: 800px;
        border-radius: 8px;
        box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        transition: transform 0.3s ease-in-out;
    }

    .popup-header {
        background: #007bff;
        color: white;
        padding: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: move;
    }

    .popup-title {
        margin: 0;
    }

    .popup-btn, .popup-close {
        background: none;
        border: none;
        color: white;
        font-size: 18px;
        cursor: pointer;
        transition: color 0.3s ease-in-out;
    }

        .popup-btn:hover, .popup-close:hover {
            color: #ffcccc;
        }

    .loader {
        display: none;
        border: 5px solid #f3f3f3;
        border-top: 5px solid #3498db;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    @@keyframes spin {
        0% {
            transform: translate(-50%, -50%) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) rotate(360deg);
        }
    }

    .fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    .fade-out {
        animation: fadeOut 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
            transform: scale(1);
        }

        to {
            opacity: 0;
            transform: scale(0.9);
        }
    }

    .alert-popup {
        position: fixed;
        top: 10px;
        right: 10px;
        background: red;
        color: white;
        padding: 10px;
        border-radius: 5px;
        display: none;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
    }

</style>
