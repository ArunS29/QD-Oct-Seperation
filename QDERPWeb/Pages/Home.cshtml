@page
@model QD.ERP.Web.Pages.Shared.HomeModel

@{
    var tenantName = HttpContext.Session.GetString("TenantName") ?? "";
    var defaultCompanyID = HttpContext.Session.GetString("DefaultcompanyID") ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Professional ERP solution for comprehensive business management including Finance, VAT, HR, Inventory, and more." />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <style>
        :root {
            --primary-color: #1e293b;
            --primary-light: #334155;
            --accent-color: #f59e0b;
            --accent-light: #fbbf24;
            --success-color: #059669;
            --bg-light: #f8fafc;
            --text-muted: #64748b;
        }

        html {
            scroll-behavior: smooth;
        }


        .gradient-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
        }

        .gradient-accent {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-light));
        }

        .gradient-hero {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 50%, var(--accent-color) 100%);
        }

        .text-gradient {
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .shadow-soft {
            box-shadow: 0 2px 8px rgba(30, 41, 59, 0.05);
        }

        .shadow-medium {
            box-shadow: 0 4px 16px rgba(30, 41, 59, 0.1);
        }

        .shadow-strong {
            box-shadow: 0 8px 32px rgba(30, 41, 59, 0.15);
        }

        .shadow-glow {
            box-shadow: 0 0 40px rgba(245, 158, 11, 0.3);
        }

        .card-hover {
            transition: all 0.3s ease-in-out;
        }

            .card-hover:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 32px rgba(30, 41, 59, 0.15);
            }

        .btn-gradient {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            border: none;
            color: white;
            transition: all 0.3s ease;
        }

            .btn-gradient:hover {
                background: linear-gradient(135deg, #fbbf24, #f97316);
                box-shadow: 0 0 40px rgba(245, 158, 11, 0.3);
                color: white;
                transform: translateY(-1px);
            }

        .icon-container {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            margin-bottom: 1rem;
        }

        .module-icon {
            width: 32px;
            height: 32px;
        }

        .hero-section {
            padding: 3px 0;
            position: relative;
            overflow: hidden;
            margin-left: 254px;
        }

            .hero-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                
                opacity: 0.05;
            }

        .cta-section {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 50%, var(--accent-color) 100%);
            color: white;
            padding: 80px 0;
        }

        .navbar-brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }

        .text-warning {
            cursor: pointer;
        }

        .card-body > .d-flex {
            cursor: pointer;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        .container{
            width:100%!important;
            padding:0px!important;
            max-width: 100%!important;
        }

        .titleCard-toggle1{
            display:none!important;
        }

        .card-hover {
            background-color: #d8d8d84f !important; /* subtle frosted background */
            border: 1px solid transparent;
            transition: all 0.4s ease;
            position: relative;
            z-index: 0;
            overflow: hidden;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
        }

            /* Blue gradient glow + lift on hover */
            .card-hover:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.2), 0 8px 20px rgba(0, 123, 255, 0.3), 0 0 20px rgba(0, 123, 255, 0.15);
                border-color: rgba(0, 123, 255, 0.4);
            }

            /* Optional glowing animated background on hover */
            .card-hover::before {
                content: "";
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(0, 123, 255, 0.05), transparent 60%);
                transform: scale(0);
                transition: transform 0.5s ease;
                z-index: -1;
            }

            .card-hover:hover::before {
                transform: scale(1);
            }

            /* Icon pulse on hover (optional) */
            .card-hover:hover i {
                animation: pulse 0.4s ease-in-out;
            }

        @keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }

        100% {
            transform: scale(1);
        }

        }


        html, body {
            height: 100%;
            overflow-y: auto;
        }

        .mainContainer{
        height:150vh!important;
        }

        .card-hover:hover i {
            animation: pulse 0.6s ease-in-out;
        }

        @@keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }

        100% {
            transform: scale(1);
        }

        }
    </style>
</head>
<body>

    <!-- ✅ 1. HERO SECTION -->
    <section class="hero-section text-center">
        <div class="container position-relative">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <h1 class="display-2 fw-bold mb-4 text-gradient">Welcome to QuickDice ERP Solutions</h1>
                    <p class="lead mb-5 text-muted" style="font-size: 1.5rem;">
                        A unified system built to simplify, scale, and strengthen your business operations.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                        <button class="btn btn-gradient btn-lg">Start Your Journey <i class="fas fa-arrow-right ms-2"></i></button>
                        <button class="btn btn-outline-primary btn-lg">Watch Demo</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ✅ 2. FEATURES ROW: Security, Real-time, Multi-location -->
    <section class="py-5 ">
       
            <div class="row text-center mb-5">
                <div class="col-lg-12">
                    <h2 class="fw-bold mb-3">Complete ERP Modules</h2>
                    <p class="text-muted">Integrated modules designed to work seamlessly together for maximum efficiency</p>
                </div>
            </div>

            <!-- Features Row -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover text-center h-100">
                        <div class="icon-container bg-dark-subtle mx-auto">
                            <i class="fas fa-shield-alt text-dark fs-4"></i>
                        </div>
                        <h6 class="fw-bold">Enterprise Security</h6>
                        <p class="text-muted small">Bank-level security with role-based access control</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover text-center h-100">
                        <div class="icon-container bg-dark-subtle mx-auto">
                            <i class="fas fa-clock text-dark fs-4"></i>
                        </div>
                        <h6 class="fw-bold">Real-time Updates</h6>
                        <p class="text-muted small">Live data synchronization across all modules</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover text-center h-100">
                        <div class="icon-container bg-dark-subtle mx-auto">
                            <i class="fas fa-globe text-dark fs-4"></i>
                        </div>
                        <h6 class="fw-bold">Multi-location Support</h6>
                        <p class="text-muted small">Manage operations across multiple locations seamlessly</p>
                    </div>
                </div>
            </div>

            <!-- ✅ 3. ERP MODULE CARDS -->
            <div class="row g-4">
                <!-- Finance -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-container bg-light me-3">
                                <i class="fas fa-calculator text-dark fs-5"></i>
                            </div>
                            <h6 class="mb-0">Finance & Accounting</h6>
                        </div>
                        <p class="text-muted small">Complete financial management with advanced reporting and budgeting tools</p>
                        <a href="#" class="text-warning small">Learn More <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- VAT -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-container bg-light me-3">
                                <i class="fas fa-receipt text-warning fs-5"></i>
                            </div>
                            <h6 class="mb-0">VAT Management</h6>
                        </div>
                        <p class="text-muted small">Automated VAT calculations, returns, and compliance management</p>
                        <a href="#" class="text-warning small">Learn More <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- HR -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-container bg-light me-3">
                                <i class="fas fa-user-friends text-success fs-5"></i>
                            </div>
                            <h6 class="mb-0">Human Resources</h6>
                        </div>
                        <p class="text-muted small">Employee lifecycle management, payroll, and performance tracking</p>
                        <a href="#" class="text-warning small">Learn More <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- Inventory -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-container bg-light me-3">
                                <i class="fas fa-boxes text-warning fs-5"></i>
                            </div>
                            <h6 class="mb-0">Inventory Control</h6>
                        </div>
                        <p class="text-muted small">Real-time inventory tracking with automated reorder points</p>
                        <a href="#" class="text-warning small">Learn More <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- CRM -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-container bg-light me-3">
                                <i class="fas fa-handshake text-primary fs-5"></i>
                            </div>
                            <h6 class="mb-0">Sales & CRM</h6>
                        </div>
                        <p class="text-muted small">Customer relationship management with sales pipeline tracking</p>
                        <a href="#" class="text-warning small">Learn More <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- Procurement -->
                <div class="col-md-4">
                    <div class="bg-white rounded-4 p-4 shadow-soft card-hover h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-container bg-light me-3">
                                <i class="fas fa-shopping-cart text-danger fs-5"></i>
                            </div>
                            <h6 class="mb-0">Procurement</h6>
                        </div>
                        <p class="text-muted small">Streamlined purchasing process with vendor management</p>
                        <a href="#" class="text-warning small">Learn More <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
       

        </div>
    </section>

</body>

</html>

