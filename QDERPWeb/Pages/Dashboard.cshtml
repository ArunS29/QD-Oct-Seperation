        // Function to toggle visibility of nested submenus
        function toggleSubmenu(submenuId) {
            const submenu = document.getElementById(submenuId);
            if (submenu.style.display === 'none') {
                submenu.style.display = 'block';
            } else {
                submenu.style.display = 'none';
            }
        }

        // Function to toggle visibility of nested submenus
        function toggleSubmenu(submenuId) {
            const submenu = document.getElementById(submenuId);
            if (submenu.style.display === 'none') {
                submenu.style.display = 'block';
            } else {
                submenu.style.display = 'none';
            }
        }


        function loadAccountLedger() {
            // Set the iframe source to load Accounting Ledgers content
            const iframe = document.getElementById("contentIframe");
            iframe.src = "/Finance/AccountingLedgers";
            hideSidebars();
            // Update the breadcrumb (same as the anchor tag in the menu)
            updateBreadcrumbFromSidebar2('Accounting Ledgers');

        }


        function hideSidebars() {
            const sidebar = document.getElementById('sidebar');
            const sidebar2 = document.getElementById('sidebar2');
            const root = document.documentElement; // Access CSS custom properties

            // Hide Sidebar 1 and Sidebar 2
            sidebar.classList.add('hidden');
            sidebar2.classList.add('hidden');
            sidebar2.style.display = 'none'; // Set display to none for sidebar2

            // Update the CSS variable based on the sidebar state
            root.style.setProperty('--sidebar-width', '0px'); // No sidebar
