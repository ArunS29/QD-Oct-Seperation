    <script>
        // Function for Bell icon click - show notifications popup
        function handleBellClick() {
            const notificationPopup = document.getElementById('notificationPopup');
            if (notificationPopup) {
                notificationPopup.style.display = 'block';
            }
        }

        // Function for Gear icon click - show settings popup
        function handleGearClick() {
            const settingsPopup = document.getElementById('settingsPopup');
            if (settingsPopup) {
                settingsPopup.style.display = 'block';
            }
        }

        // Function for Avatar click - show user profile
        function handleAvatarClick() {
            const profilePopup = document.getElementById('profilePopup');
            if (profilePopup) {
                profilePopup.style.display = 'block';
            }
        }

        // Function to close the popup
        function closePopup(popupId) {
            const popup = document.getElementById(popupId);
            if (popup) {
                popup.style.display = 'none';
            }
        }

        const breadcrumbTrail = []; // Tracks the breadcrumb trail

        function navigate(name) {
            const sidebar2 = document.getElementById('sidebar2');

            // Toggle sidebar2 visibility based on whether it's already visible or not
            if (sidebar2.style.display === 'block') {
                sidebar2.style.display = 'none'; // Hide sidebar2
            } else {
                sidebar2.style.display = 'block'; // Show sidebar2
            }
            // Dynamically load submenu items for the first sidebar menu
            if (name === 'Finance') {
                showFinanceSubmenu();
                breadcrumbTrail[0] = name;
                updateBreadcrumb();
            } else if (name === 'Human Resources') {
                breadcrumbTrail.length = 0;
                updateBreadcrumb();
                updateBreadcrumbFromSidebar2('');
                sidebar2.style.display = 'none';
            } else if (name === 'VAT Modules') {
                breadcrumbTrail.length = 0;
                updateBreadcrumb();
                updateBreadcrumbFromSidebar2('');
                sidebar2.style.display = 'none';
            } else if (name === 'Equipment Rentals') {
                breadcrumbTrail.length = 0;
                updateBreadcrumb();
                updateBreadcrumbFromSidebar2('');
                sidebar2.style.display = 'none';
            } else if (name === 'Camp Management') {
                breadcrumbTrail.length = 0;
                updateBreadcrumb();
                updateBreadcrumbFromSidebar2('');
                sidebar2.style.display = 'none';
            } else if (name === 'Inventory Management') {
                breadcrumbTrail.length = 0;
                updateBreadcrumb();
                updateBreadcrumbFromSidebar2('');
                sidebar2.style.display = 'none';
            } else if (name === 'Projects Control') {
                breadcrumbTrail.length = 0;
                updateBreadcrumb();
                updateBreadcrumbFromSidebar2('');
                sidebar2.style.display = 'none';
            }
        }


