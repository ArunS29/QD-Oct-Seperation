@* @page
@using DevExtreme.AspNet.Mvc

<script>
    var myValue = false;
</script>

@(Html.DevExtreme().DataGrid<QD.Web.DAL.Entities.Qry50106TenantListMasterView>()
.DataSource(ds => ds.WebApi()
.Controller("CheckInMaster")
.LoadAction("Get")
.UpdateAction("Put")
.InsertAction("Post")
.DeleteAction("Delete")
.Key("CheckInId")
)
.RemoteOperations(true)
.Editing(e => e.Mode(GridEditMode.Popup)
.AllowUpdating(true)
.AllowAdding(true)
.AllowDeleting(true)
.Popup(p => p
.Title("Tenant Entry")
.ShowTitle(true)
.Width(700)
.Height(525)
)
.Form(f => f.Items(items =>
{
    items.AddSimpleFor(m => m.ClientCode);
    items.AddSimpleFor(m => m.TenantName);
    items.AddSimpleFor(m => m.TenantIdno);
    items.AddSimpleFor(m => m.RentPerDay);
    items.AddSimpleFor(m => m.NationalityId);
    items.AddSimpleFor(m => m.RoomCode);
    items.AddSimpleFor(m => m.CheckInDate);
    items.AddSimpleFor(m => m.CheckOutDate);
}))
)
.Columns(columns =>
{
    columns.AddFor(m => m.CheckInId).SortOrder(SortOrder.Desc).Visible(false);
    columns.AddFor(m => m.RoomCode)
    .EditCellTemplate(new TemplateName("RoomDropDownBoxTemplate"));

    columns.AddFor(m => m.RoomCategory).Caption("Room Category");
    columns.AddFor(m => m.RentPerDay).Visible(false);
    columns.AddFor(m => m.TenantIdno);
    columns.AddFor(m => m.TenantName);
    columns.AddFor(m => m.CheckInDate);
    columns.AddFor(m => m.CheckOutDate).Visible(false);
    columns.AddFor(m => m.ClientCode).Visible(false)
    .EditCellTemplate(new TemplateName("ClientDropDownBoxTemplate"));
    columns.AddFor(m => m.ClientName);
    columns.AddFor(m => m.NationalityId)
    .EditCellTemplate(new TemplateName("NationalityDropDownBoxTemplate"));
    columns.AddFor(m => m.NationalityEn);
    columns.AddFor(m => m.OccupanyStatus).Caption("Occupancy Status");
    columns.AddFor(m => m.RoomCapacity).Caption("Room Capacity");
    columns.AddFor(m => m.NoOfOccupancy).Caption("No. Of Occupancy");
})
)

@using (Html.DevExtreme().NamedTemplate("RoomDropDownBoxTemplate"))
{
    @(Html.DevExtreme().DropDownBox()
                    .DataSource(d => d.Mvc().Controller("QryRoomWtStatus")
                    .LoadAction("Get")
                    .LoadMode(DataSourceLoadMode.Raw).Key("RoomCode"))
                    .Value(new JS("value"))
                    .ValueExpr("RoomCode")
                    .InputAttr("aria-label", "Owner")
                    .DisplayExpr("RoomCode")
                    .DropDownOptions(options => options.Width(500))
                    .Option("setValue", new JS("setValue"))
                    .ContentTemplate(new TemplateName("RoomContentTemplate"))
                    )
}
