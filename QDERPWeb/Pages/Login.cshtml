@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <style>
        /* Fullscreen background */
        body {
            margin: 0;

            padding: 0;
            height: 100vh;
            font-family: Arial, sans-serif;
            background-color: #ffffff; /* White background for the entire body */
        }

        /* Outer container */
        .background-container {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            position: relative;
            min-height: 100vh;
        }

        /* Login Box */
        .login-container {
            background: #ffffff;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            padding: 30px;
            width: 400px;
            text-align: center;
            z-index: 10;
            border: 1px solid #ddd;
        }

      

        /* Labels and Input fields */
        label {
            display: block;
            text-align: left;
            font-size: 14px;
            margin-bottom: 5px;
            color: #333;
        }

        input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
            background-color: #f9f9f9;
        }

        input:focus {
            outline: none;
            border-color: #007bff;
            background-color: #fff;
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            margin-bottom: 20px;
        }

        .remember-me {
            display: flex;
            align-items: center; /* Aligns the checkbox and text horizontally */
            gap: 5px; /* Space between checkbox and text */
        }

        .forgot-password {
            text-decoration: none;
            color: #007bff;
            margin-left: auto; /* Pushes the text to the right */
        }




        /* Button */
        button {
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 10px;
            width: 100%;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background-color: #0056b3;
        }

        /* Logo */
        .logo {
            margin-bottom: 20px;
            position: relative; /* Set position to relative */
            z-index: 10; /* Higher z-index to bring it to the front */
        }

            .logo img {
                width: 200px;
                height: 80px;
            }

        /* Background container */
        .background-container {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            position: relative;
            min-height: 100vh;
        }

        /* Full-size Building Skyline */
        .skyline {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 100vh; /* Full viewport height */
            background: url('/images/background.GIF') no-repeat center center;
            background-size: cover;
            z-index: 1; /* Lower z-index to keep it behind other elements */
        }


        /* Footer Text */
        .footer {
            font-size: 12px;
            text-align: center;
            color: #777;
            margin-top: 20px;
        }

        /* Password toggle visibility icon */
        .input-group {
            position: relative;
        }

        .input-group-append {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
        }

        .input-group-append button {
            background: none;
            border: none;
            cursor: pointer;
            color: #007bff;
        }

        /* Mandatory fields indication */
        .mandatory {
            color: red;
        }

        .error-message {
            color: red;
            font-size: 14px;
            margin-bottom: 15px;
        }
        /* Modal Styling */
 
        /* Modal Styling */
        .modal {
            display: none;
            position: fixed;
            z-index: 999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.3); /* Light overlay for background */
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            width: 300px;
            text-align: center;
            position: relative;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

            .modal-content .close {
                position: absolute;
                top: 10px;
                right: 10px;
                font-size: 18px;
                font-weight: bold;
                color: #fff; /* White color for the "X" */
                background-color: #ff0000; /* Red background for contrast */
                border: none;
                border-radius: 50%;
                width: 25px;
                height: 25px;
                line-height: 25px;
                text-align: center;
                cursor: pointer;
            }

                .modal-content .close:hover {
                    background-color: #cc0000; /* Slightly darker red on hover */
                }

            .modal-content p {
                font-size: 16px;
                color: #ff0000;
                margin: 20px 0 0;
            }



        /* Fade-in animation */
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }

        }
    </style>
</head>
<body>

    <div class="background-container">
        <!-- Logo -->
        <div class="logo">
            <img src="~/images/Pulse.png" alt="Logo">
        </div>

        <!-- Login Box -->
        <div class="login-container">
            <h2>Login</h2>
            <p>Welcome back! Please login to your account</p>

    

            <form method="post" asp-action="Login" asp-controller="Login">
                <div>
                    <label for="email">Email <span class="mandatory">*</span></label>
                    <input type="email" id="email" name="email" placeholder="Enter your email ID" required>
                </div>

                <div class="input-group">
                    <label for="password">Password <span class="mandatory">*</span></label>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    <div class="input-group-append">
                        <button type="button" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <div class="remember-me">
                        <input type="checkbox" name="remember">RememberMe
                    </div>
                    <a href="#" class="forgot-password">Forgot Password?</a>
                </div>

                <button type="submit">Sign In</button>
            </form>
        </div>
        <!-- Modal -->
        <div id="errorModal" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <p id="errorMessage">@ViewBag.Error</p>
            </div>
        </div>

        <!-- Full-size Building Skyline -->
        <div class="skyline"></div>

        <!-- Footer -->
        <div class="footer">
            © 2024 Country Limited.
        </div>
    </div>

    <!-- Password visibility toggle script -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
         $(document).ready(function () {
            // Check if an error message is present
            if ($('#errorMessage').length && $('#errorMessage').text().trim() !== '') {
                $('#errorModal').css('display', 'flex'); // Show modal
            }

            // Close the modal when the close button is clicked
            $('.close').click(function () {
                $('#errorModal').hide(); // Hide modal
            });

            // Optional: Close modal if the user clicks outside the modal content
            $('#errorModal').click(function (e) {
                if ($(e.target).is('#errorModal')) {
                    $(this).hide();
                }
            });
        });


        $('#togglePassword').click(function () {
            var passwordField = $('#password');
            var type = passwordField.attr('type') === 'password' ? 'text' : 'password';
            passwordField.attr('type', type);
            
            var icon = $(this).find('i');
            icon.toggleClass('fa-eye fa-eye-slash');
        });
    </script>
</body>
</html>
