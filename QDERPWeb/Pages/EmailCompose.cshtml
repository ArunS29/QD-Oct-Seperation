@page
@model EmailComposeModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Compose</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        /* Popup Styling */
        #emailPopup {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            text-align: center;
            z-index: 1000;
        }

        /* Overlay */
        #overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            background-color:aliceblue;
        }

        /* Loader */
        #emailLoader {
            display: none;
            width: 80px;
            height: 80px;
            margin: 10px auto;
        }

        /* Success/Error GIF */
        #emailStatusGif {
            display: none;
            width: 120px;
            height: auto;
            margin: 10px auto;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2>Compose Email</h2>
        <form id="emailForm">
            <div class="mb-3">
                <label>From:</label>
                <input type="email" class="form-control" id="fromEmail" value="DoNotReply@notification.quickdice.net" disabled>
            </div>
            <div class="mb-3">
                <label>To:</label>
                <input type="email" class="form-control" id="toEmail" required>
            </div>
            <div class="mb-3">
                <label>Template:</label>
                <select id="emailTemplate" class="form-select">
                    <option value="">-- Select Template --</option>
                    <option value="insert">Insert Template</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Subject:</label>
                <input type="text" class="form-control" id="subject" required>
            </div>
            <div class="mb-3">
                <label>Body:</label>
                <textarea class="form-control" id="emailBody" rows="5" required></textarea>
            </div>
            <div class="mb-3">
                <label>Attachment:</label>
                <input type="file" class="form-control" id="attachment" multiple>
            </div>
            <button type="button" class="btn btn-primary" id="sendButton">Send</button>
            <div id="statusMessage" class="mt-3"></div>
        </form>
    </div>

    <!-- Overlay -->
    <div id="overlay"></div>

    <!-- Email Sending Popup -->
    <div id="emailPopup">
        <h4 id="popupTitle">Sending Email...</h4>
        <img id="emailLoader" src="/images/Loadingmail.gif" alt="Loading...">
        <img id="emailStatusGif" src="" alt="Status">
    </div>

    <script>
        $(document).ready(function () {
            $("#emailTemplate").change(function () {
                if ($(this).val() === "insert") {
                    if (confirm("Do you want to open a new template creation page?")) {
                        window.open("/Pages/TemplateCreate", "_blank");
                    }
                }
            });

            $("#sendButton").click(function () {
                showConfirmationPopup();
            });
        });

        function showConfirmationPopup() {
            if (confirm("Are you sure you want to send this email?")) {
                sendEmail();
            }
        }

        function sendEmail() {
            // Show the popup with the loader
            $("#overlay").fadeIn();
            $("#emailPopup").fadeIn();
            $("#popupTitle").text("Sending Email...");
            $("#emailLoader").show();
            $("#emailStatusGif").hide();

            var formData = new FormData();
            formData.append("To", $("#toEmail").val());
            formData.append("Subject", $("#subject").val());
            formData.append("Body", $("#emailBody").val());

            // Handle Attachments
            var files = $("#attachment")[0].files;
            if (files.length > 0) {
                for (var i = 0; i < files.length; i++) {
                    formData.append("Attachments", files[i]);
                }
            }

            $.ajax({
                url: "/api/Email/send",
                type: "POST",
                processData: false,
                contentType: false,
                data: formData,
                success: function (response) {
                    $("#popupTitle").text("Email Sent!");
                    $("#emailLoader").hide();
                    $("#emailStatusGif").attr("src", "/images/Successful.gif").show();
                    $("#statusMessage").html("<div class='alert alert-success'>" + response.message + "</div>");
                },
                error: function (xhr) {
                    let errorMessage = xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : "An unexpected error occurred.";
                    $("#popupTitle").text("Failed to Send Email!");
                    $("#emailLoader").hide();
                    $("#emailStatusGif").attr("src", "/images/Fail.gif").show();
                    $("#statusMessage").html("<div class='alert alert-danger'>" + errorMessage + "</div>");
                },
                complete: function () {
                    setTimeout(function () {
                        $("#emailPopup, #overlay").fadeOut(); // Hide popup after 3 seconds
                    }, 3000);
                }
            });
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
