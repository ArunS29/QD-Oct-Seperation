@page
@model EmailComposeModel
@{
    Layout = null;
}
@{

    var fileName = HttpContext.Request.Query["fileName"];
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Compose</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        /* Popup Styling */
        #emailPopup {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            text-align: center;
            z-index: 1000;
        }

        /* Overlay */
        #overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            background-color: aliceblue;
        }

        /* Loader */
        #emailLoader {
            display: none;
            width: 80px;
            height: 80px;
            margin: 10px auto;
        }

        /* Success/Error GIF */
        #emailStatusGif {
            display: none;
            width: 120px;
            height: auto;
            margin: 10px auto;
        }

          .fade-out {
        animation: fadeOut 0.5s ease forwards;
    }

    @@keyframes fadeOut {
        from { opacity: 1; }
        to { opacity: 0; }
    }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2>Compose Email</h2>
        <form id="emailForm">
            <div class="mb-3">
                <label>From:</label>
                <input type="email" class="form-control" id="fromEmail" value="DoNotReply@notification.quickdice.net" disabled>
            </div>
            <div class="mb-3">
                <label>To:</label>
                <input type="email" class="form-control" id="toEmail" required>
            </div>
            <div class="mb-3">
                <label>Template Category:</label>
                <select id="templateCategory" class="form-select">
                    <option value="">-- Select Category --</option>
                    <option value="insert">Insert Template</option>
                </select>
            </div>



            <div class="mb-3">
                <label>Subject:</label>
                <input type="text" class="form-control" id="Subject" required>
            </div>

            <div class="mb-3">
                <label>Body:</label>
                <textarea class="form-control" id="emailBody" rows="5" required></textarea>
            </div>
            <div class="mb-3">
                <label>Attachment:</label>
                <!-- Removed the manual file input -->
                <input type="hidden" id="serverAttachment" value="@fileName" />
            </div>

            <!-- Optional: show the generated attachment link -->
            <div id="attachmentDisplay" class="mt-2 text-muted">
                <span>Attachment: @fileName</span>
            </div>


            <button type="button" class="btn btn-primary" id="sendButton">Send</button>
            <div id="statusMessage" class="mt-3"></div>
        </form>
    </div>

    <!-- Overlay -->
    <div id="overlay"></div>

    <!-- Email Sending Popup -->
    <div id="emailPopup">
        <h4 id="popupTitle">Sending Email...</h4>
        <img id="emailLoader" src="/images/Loadingmail.gif" alt="Loading...">
        <img id="emailStatusGif" src="" alt="Status">
    </div>

    <script>
        $(document).ready(function () {
            // Load categories with templates
            $.ajax({
                url: '/api/EmailTemplate/categories',
                type: 'GET',
                success: function (categories) {
                    let categoryDropdown = $("#templateCategory");
                    categoryDropdown.empty().append('<option value="">-- Select Category --</option>');
                    $.each(categories, function (index, category) {
                        categoryDropdown.append(`<option value="${category}">${category}</option>`);
                    });
                    categoryDropdown.append('<option value="insert">Insert Template</option>');
                },
                error: function () {
                    alert("Error loading categories.");
                }
            });

            // Load template details when category changes
            $("#templateCategory").change(function () {
                let selectedCategory = $(this).val();

                if (selectedCategory === "insert") {
                    if (confirm("Do you want to open a new template creation page?")) {
                        document.body.classList.add("fade-out");

                        // Delay to allow fade-out before opening the window
                        setTimeout(() => {
                            const tenantName = window.location.pathname.split('/')[1];
                                  window.location.href = `/${tenantName}/TemplateCreate`;


                        }, 500); // match animation duration
                    }
                    return;
                }

            


                if (selectedCategory) {
                    $.ajax({
                        url: '/api/EmailTemplate/templateByCategory?category=' + encodeURIComponent(selectedCategory),
                        type: 'GET',
                        success: function (response) {
                            $("#Subject").val(response.Subject || "No Subject Available");
                            $("#emailBody").val(response.Body || "No Content Available");
                        },
                        error: function () {
                            alert("Failed to load template details.");
                        }
                    });
                } else {
                    $("#Subject").val("");
                    $("#emailBody").val("");
                }
            });

            // Handle Send button click
            $("#sendButton").click(function () {
                showConfirmationPopup();
            });
        });

        function showConfirmationPopup() {
            if (confirm("Are you sure you want to send this email?")) {
                sendEmail();
            }
        }

        function sendEmail() {
            // Show sending popup
            $("#overlay").fadeIn();
            $("#emailPopup").fadeIn();
            $("#popupTitle").text("Sending Email...");
            $("#emailLoader").show();
            $("#emailStatusGif").hide();

            // Build FormData with required values
            var formData = new FormData();
            formData.append("To", $("#toEmail").val());
            formData.append("Subject", $("#Subject").val());
            formData.append("Body", $("#emailBody").val());

            // Only include server-generated attachment
            var serverAttachment = $("#serverAttachment").val();
            if (serverAttachment) {
                formData.append("ServerGeneratedAttachment", serverAttachment);
            }

            // Send AJAX call
            sendFinalEmail(formData);
        }

        function sendFinalEmail(formData) {
            $.ajax({
                url: "/api/Email/send",
                type: "POST",
                processData: false,
                contentType: false,
                data: formData,
                success: function (response) {
                    $("#popupTitle").text("Email Sent!");
                    $("#emailLoader").hide();
                    $("#emailStatusGif").attr("src", "/images/Successful.gif").show();
                    $("#statusMessage").html(`<div class='alert alert-success'>${response.message}</div>`);
                },
                error: function (xhr) {
                    let errorMessage = xhr.responseJSON?.message || "An unexpected error occurred.";
                    $("#popupTitle").text("Failed to Send Email!");
                    $("#emailLoader").hide();
                    $("#emailStatusGif").attr("src", "/images/Fail.gif").show();
                    $("#statusMessage").html(`<div class='alert alert-danger'>${errorMessage}</div>`);
                },
                complete: function () {
                    setTimeout(() => {
                        $("#emailPopup, #overlay").fadeOut();
                    }, 3000);
                }
            });
        }
    </script>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>