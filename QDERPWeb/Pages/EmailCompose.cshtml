@page
@model EmailComposeModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Compose</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        /* Popup Styling */
        #emailPopup {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
            text-align: center;
            z-index: 1000;
        }

        /* Overlay */
        #overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            background-color: aliceblue;
        }

        /* Loader */
        #emailLoader {
            display: none;
            width: 80px;
            height: 80px;
            margin: 10px auto;
        }

        /* Success/Error GIF */
        #emailStatusGif {
            display: none;
            width: 120px;
            height: auto;
            margin: 10px auto;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2>Compose Email</h2>
        <form id="emailForm">
            <div class="mb-3">
                <label>From:</label>
                <input type="email" class="form-control" id="fromEmail" value="DoNotReply@notification.quickdice.net" disabled>
            </div>
            <div class="mb-3">
                <label>To:</label>
                <input type="email" class="form-control" id="toEmail" required>
            </div>

            <!-- Template Selection -->
            <div class="mb-3">
                <label>Template Category:</label>
                <select id="templateCategory" class="form-select">
                    <option value="">-- Select Category --</option>
                    <option value="HR">HR</option>
                    <option value="Finance">Finance</option>
                    <option value="IT">IT</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Template:</label>
                <select id="emailTemplate" class="form-select">
                    <option value="">-- Select Template --</option>
                    <option value="insert">Insert Template</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Subject:</label>
                <input type="text" class="form-control" id="subject" required>
            </div>
            <div class="mb-3">
                <label>Body:</label>
                <textarea class="form-control" id="emailBody" rows="5" required></textarea>
            </div>
            <div class="mb-3">
                <label>Attachment:</label>
                <input type="file" class="form-control" id="attachment" multiple>
            </div>
            <button type="button" class="btn btn-primary" id="sendButton">Send</button>
            <div id="statusMessage" class="mt-3"></div>
        </form>
    </div>

    <!-- Overlay -->
    <div id="overlay"></div>

    <!-- Email Sending Popup -->
    <div id="emailPopup">
        <h4 id="popupTitle">Sending Email...</h4>
        <img id="emailLoader" src="/images/Loadingmail.gif" alt="Loading...">
        <img id="emailStatusGif" src="" alt="Status">
    </div>

    <script>
        $(document).ready(function () {
            let templates = {
                "HR": [
                    { "id": "hr_welcome", "name": "HR - Welcome Email", "subject": "Welcome to the Company!", "body": "Dear Employee,\n\nWelcome to our company! We are excited to have you on board.\n\nBest Regards,\nHR Team" },
                    { "id": "hr_leave", "name": "HR - Leave Approval", "subject": "Leave Request Approved", "body": "Dear Employee,\n\nYour leave request has been approved. Enjoy your time off!\n\nBest Regards,\nHR Team" }
                ],
                "Finance": [
                    { "id": "fin_invoice", "name": "Finance - Invoice Reminder", "subject": "Invoice Payment Reminder", "body": "Dear Customer,\n\nThis is a friendly reminder to pay your outstanding invoice.\n\nBest Regards,\nFinance Team" }
                ],
                "IT": [
                    { "id": "it_support", "name": "IT - Support Ticket", "subject": "IT Support Ticket Update", "body": "Dear User,\n\nYour IT support ticket has been updated. Please check your email for details.\n\nBest Regards,\nIT Team" }
                ]
            };

            // Populate template dropdown based on category selection
            $("#templateCategory").change(function () {
                let category = $(this).val();
                $("#emailTemplate").empty().append('<option value="">-- Select Template --</option>');

                if (category && templates[category]) {
                    templates[category].forEach(template => {
                        $("#emailTemplate").append(`<option value="${template.id}" data-subject="${template.subject}" data-body="${template.body}">${template.name}</option>`);
                    });
                }

                // Add Insert Template option
                $("#emailTemplate").append('<option value="insert">Insert Template</option>');
            });

            // Auto-fill subject and body when selecting a template
            $("#emailTemplate").change(function () {
                let selectedOption = $(this).find(":selected");
                let subject = selectedOption.data("subject");
                let body = selectedOption.data("body");

                if ($(this).val() === "insert") {
                    if (confirm("Do you want to open a new template creation page?")) {
                        window.open("/Pages/TemplateCreate", "_blank");
                    }
                } else if (subject && body) {
                    $("#subject").val(subject);
                    $("#emailBody").val(body);
                } else {
                    $("#subject").val("");
                    $("#emailBody").val("");
                }
            });

            $("#sendButton").click(function () {
                showConfirmationPopup();
            });
        });

        function showConfirmationPopup() {
            if (confirm("Are you sure you want to send this email?")) {
                sendEmail();
            }
        }

        function sendEmail() {
            alert("Email sent successfully! (Simulation)");
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
