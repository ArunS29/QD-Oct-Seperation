    <div class="dx-field">
        @(Html.DevExtreme().DataGrid()
                .ID("SignatoryGrid")
                .KeyExpr("SignatoryID")
                .RemoteOperations(false)
                .DataSource(d => d.WebApi()
                .Controller("Signatories")
                .LoadAction("GetAllSignData")
                .LoadMode(DataSourceLoadMode.Raw)
                )
                .Editing(editing => editing
                .Mode(GridEditMode.Batch)
                .AllowUpdating(true)
                )
                .Toolbar(toolbar =>
                {
                    toolbar.Items(items => { }); // hide default toolbar
                })
                .OnRowUpdating("onSignatoryUpdating")
                .OnContextMenuPreparing("onSignatoryContextMenuPreparing")
                .Columns(columns =>
                {
                    columns.Add().DataField("SignatoryID").Caption(new JS("formatMessage('ID')")).Width(80).AllowEditing(false);
                    columns.Add().DataField("SignatoryName").Caption(new JS("formatMessage('Name')")).Width(200);
                    columns.Add().DataField("SignatoryPosition").Caption(new JS("formatMessage('Position')")).Width(200);
                    columns.Add().DataField("SignatoryContact").Caption(new JS("formatMessage('Contact')")).Width(150);
                    columns.Add().DataField("SignatoryEmail").Caption(new JS("formatMessage('Email')")).Width(250);
                    columns.Add().DataField("DecodedBusinessCard1")
                    .Caption(new JS("formatMessage('Signature Image')"))
                    .EditCellTemplate(new JS(@"
                        function(cellElement, cellInfo) {
                        const currentImage = cellInfo.value;
                        const wrapper = $('<div>')
                        .css({
                        display: 'flex',
                        flexDirection: 'column',
                        alignItems: 'center',
                        justifyContent: 'center',
                        width: '100%',
                        height: '100%'
                        })
                        .appendTo(cellElement);

                        // Image display
                        const img = $('<img>')
                        .attr('src', currentImage || '')
                        .css({
                        width: '100px',
                        height: 'auto',
                        marginBottom: '8px',
                        cursor: 'pointer',
                        border: '1px solid #ccc',
                        borderRadius: '4px',
                        display: currentImage ? 'block' : 'none'
                        })
                        .appendTo(wrapper);

                        // Change button
                        const changeBtn = $('<button>')
                        .text(currentImage ? 'Change' : 'Upload')
                        .addClass('dx-button dx-button-mode-contained dx-button-normal')
                        .css({ padding: '4px 10px', fontSize: '12px' })
                        .appendTo(wrapper);

                        // Hidden file input
                        const fileInput = $('<input type=""file"" accept=""image/*"" style=""display:none;"">').appendTo(wrapper);

                        // Handle button click
                        changeBtn.on('click', function() {
                        fileInput.click();
                        });

                        // Handle image click (same as button)
                        img.on('click', function() {
                        fileInput.click();
                        });

                        // File selection
                        fileInput.on('change', function(event) {
                        const file = event.target.files[0];
                        if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                        const base64Image = e.target.result;
                        img.attr('src', base64Image).show();
                        
                        changeBtn.text('Change');

                        // Update cell value
                        cellInfo.setValue(base64Image);
                        };
                        reader.readAsDataURL(file);
                        }
                        });
                        }
                        "))
                            .CellTemplate(new JS(@"
                        function(cellElement, cellInfo) {
                        if (cellInfo.value) {
                        $('<img>')
                        .attr('src', cellInfo.value)
                        .css({ width: '100px', height: 'auto' })
                        .appendTo(cellElement);
                        }
                        }
                    "))
                        .Width(180);

                })
                .Height(275)
                .ColumnAutoWidth(true)
                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(f => f.Enabled(true))
                .Paging(p => p.Enabled(true))
                .Scrolling(s => s
                .Mode(GridScrollingMode.Virtual)
                .RowRenderingMode(GridRowRenderingMode.Virtual)
                .PreloadEnabled(true)
                .ScrollByContent(true)
                )
                .SearchPanel(sp => sp
                .Visible(true)
                .HighlightSearchText(true)
                .Placeholder("Search...")
                )
                .ShowBorders(true)
                .ShowRowLines(true)
                .Width("100%")
                )



    </div>

</div>
<div class="limited-footer">
    @await Html.PartialAsync("VATModuleFooter")
</div>
<script>

    $(document).ready(function () {

          $(".limited-footer .btn-containerIvoiceEdit").each(function () {

              if (!$(this).find("#btnUpdate,#btnBack").length) {

                  $(this).remove();

              }

          });

      });

        $(document).on("click", "#btnBack", function () {
        const popup = $(".dx-popup:visible").dxPopup("instance");
        if (popup) {
            popup.hide(); // close the popup
        } else {
            window.history.back(); // fallback if popup not found
        }
    });


      $(function () {
            $("#DatabaseSignatories").dxTextBox({
                text: formatMessage("Database "),
                readOnly: true,


            });
        });

    $(function () {
        $("#TypeSignatory").dxTextBox({
            text: formatMessage("Database Signatories"),
            readOnly: true,
            onContentReady: function (e) {
                $(e.element).addClass("dx-textbox-heading");
            }
        });
    });
    async function convertToArabic(sourceId, targetId) {
        const sourceBox = $("#" + sourceId).dxTextBox("instance");
        const targetBox = $("#" + targetId).dxTextBox("instance");

        if (!sourceBox || !targetBox) {
            console.error("TextBox not initialized.");
            return;
        }

        const sourceText = sourceBox.option("value");

        if (!sourceText || sourceText.trim() === "") {
            alert("Please enter a value to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(sourceText);
            targetBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

   
    //img
    let businessCard1Base64 = "";
       function addSignatoryToGrid() {
        // 1️⃣ Validate required fields (TextBoxes)
        const nameValidationResult = $("#SignatoryName").dxValidator("instance").validate();
        const positionValidationResult = $("#SignatoryPosition").dxValidator("instance").validate();

        // 2️⃣ Validate SignatoryUserId DropDownBox
        const signatoryUserId = $("#SignatoryUserId").dxDropDownBox("instance").option("value");
        if (!signatoryUserId) {
            DevExpress.ui.notify("Please select a Signatory User ID.", "warning", 2000);
            return;
        }

        // 3️⃣ Validate image upload
        if (!businessCard1Base64) {
            DevExpress.ui.notify("Please upload a signature image.", "warning", 2000);
            return;
        }

        // 4️⃣ Stop if textbox validations fail
        if (!nameValidationResult.isValid || !positionValidationResult.isValid) {
            DevExpress.ui.notify("Please fill all required fields.", "warning", 2000);
            return;
        }

        // 5️⃣ Prepare data
        const data = {
            SignatoryName: $("#SignatoryName").dxTextBox("instance").option("value"),
            SignatoryNameArabic: $("#SignatoryNameArabic").dxTextBox("instance").option("value"),
            SignatoryPosition: $("#SignatoryPosition").dxTextBox("instance").option("value"),
            SignatoryPositionArabic: $("#SignatoryPositionArabic").dxTextBox("instance").option("value"),
            SignatoryContact: $("#SignatoryContact").dxTextBox("instance").option("value"),
            SignatoryEmail: $("#SignatoryEmail").dxTextBox("instance").option("value"),
            SignatoryUserId: signatoryUserId,
            SignatureImage: businessCard1Base64 ? businessCard1Base64.split(',')[1] : null
        };

        // 6️⃣ AJAX call to save data
        $.ajax({
            url: '/api/Signatories/SaveOrUpdateSignatory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Signatory saved successfully!", "success", 2000);

                // 7️⃣ Clear all inputs after successful save
                $("#SignatoryName").dxTextBox("instance").reset();
                $("#SignatoryNameArabic").dxTextBox("instance").reset();
                $("#SignatoryPosition").dxTextBox("instance").reset();
                $("#SignatoryPositionArabic").dxTextBox("instance").reset();
                $("#SignatoryContact").dxTextBox("instance").reset();
                $("#SignatoryEmail").dxTextBox("instance").reset();
                $("#SignatoryUserId").dxDropDownBox("instance").reset();

                // Clear uploaded image
                const imgContainer = document.getElementById('imgBox1');
                imgContainer.innerHTML = '<span style="color: #888; font-size: 14px; line-height: 100px; display: flex; align-items: center; justify-content: center;">Upload Signature Image</span>';
                imgContainer.style.backgroundColor = 'white';
                businessCard1Base64 = null;

                // Refresh grid if exists
                if ($("#SignatoryGrid").length) {
                    $("#SignatoryGrid").dxDataGrid("instance").refresh();
                }
            },
            error: function () {
                DevExpress.ui.notify("Failed to save signatory.", "error", 2000);
            }
        });
    }



    $("#btnUpdate").on("click", function () {
        const grid = $("#SignatoryGrid").dxDataGrid("instance");
        grid.saveEditData(); // 🔥 only triggers on manual click
    });


        function onSignatoryUpdating(e) {
           let signatureBase64 = e.newData.DecodedBusinessCard1 ?? e.oldData.DecodedBusinessCard1;

        // Strip prefix if it exists
        if (signatureBase64 && signatureBase64.startsWith('data:')) {
            signatureBase64 = signatureBase64.split(',')[1];
        }
        const data = {
            SignatoryID: e.oldData.SignatoryID,
            SignatoryName: e.newData.SignatoryName ?? e.oldData.SignatoryName,
            SignatoryPosition: e.newData.SignatoryPosition ?? e.oldData.SignatoryPosition,
            SignatoryContact: e.newData.SignatoryContact ?? e.oldData.SignatoryContact,
            SignatoryEmail: e.newData.SignatoryEmail ?? e.oldData.SignatoryEmail,
            SignatureImage: signatureBase64
        };

        e.cancel = true; // prevent grid default update

        return $.ajax({
            url: '/api/Signatories/SaveOrUpdateSignatory',
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function () {
                DevExpress.ui.notify("Data Updated Successfully!", "success", 1500);
                $("#SignatoryGrid").dxDataGrid("instance").refresh();
            },
            error: function () {
                DevExpress.ui.notify("Failed to save.", "error", 1500);
            }
        });
    }



    //Imageupload

    let selectedContainer = null;


    // Add event listeners after the DOM is ready
    document.addEventListener("DOMContentLoaded", function () {
        const containers = document.querySelectorAll('.imagecontainer');

        containers.forEach(container => {
            container.addEventListener('click', () => {
                selectedContainer = container;
                document.getElementById('imageInput').click();
            });
        });

        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file && selectedContainer) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    const base64Image = e.target.result;

                    selectedContainer.innerHTML = '';
                    const img = document.createElement('img');
                    img.src = base64Image;
                    img.style.maxWidth = '100%';
                    selectedContainer.appendChild(img);

                    businessCard1Base64 = base64Image;
                };

                reader.readAsDataURL(file);
                event.target.value = '';
            }
        });
    });

        $(function () {
        $("#databasesignatoryss").text(formatMessage("Database Signatory"));
    });
        $(function () {
        $("#uploadsignature").text(formatMessage("Upload Signature"));
    });
            function validateEmailInstantly(e) {
        const validator = $("#SignatoryEmail").dxValidator("instance");
        if (validator) {
            const result = validator.validate();
            if (!result.isValid && e.value) {
                // Clear only if user has typed something invalid
                $("#SignatoryEmail").dxTextBox("instance").option("value", "");
                DevExpress.ui.notify("Invalid email format. Please re-enter.", "warning", 2000);
            }
        }
    }
    function onSignatoryContextMenuPreparing(e) {
        if (e.target === "content" && e.row && e.row.rowType === "data") {
            e.items = [
                {
                    text: "Delete Entry",
                    icon: "trash",
                    onItemClick: function () {
                        const rowData = e.row.data;

                        DevExpress.ui.dialog.confirm(
                            `Are you sure you want to delete Signatory '${rowData.SignatoryName}'?`,
                            "Confirm Delete"
                        ).done(function (dialogResult) {
                            if (dialogResult) {
                                $.ajax({
                                    url: `/api/Signatories/DeleteSignatory?id=${rowData.SignatoryID}`,
                                    type: "DELETE",
                                    success: function (response) {
                                        if (response.success) {
                                            DevExpress.ui.notify("Deleted successfully", "success", 2000);
                                            const grid = $("#SignatoryGrid").dxDataGrid("instance");
                                            grid.getDataSource().reload();
                                        } else {
                                            DevExpress.ui.notify(response.message || "Failed to delete", "error", 2000);
                                        }
                                    },
                                    error: function (xhr) {
                                        DevExpress.ui.notify(`Error deleting entry: ${xhr.statusText}`, "error", 2000);
                                    }
                                });
                            }
                        });
                    }
                }
            ];
        }
    }




</script>