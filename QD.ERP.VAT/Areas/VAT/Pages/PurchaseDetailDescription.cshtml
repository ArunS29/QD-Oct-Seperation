@* <div class="title">
    <div class="header-container">
        <div id="DetailsDescription2" class="no-border-title"></div>
    </div>
</div> *@
<div class="form-wrapper">

    <!-- Row 1: Detailed Description + 2 Buttons -->
    <div class="form-group">
        <div class="top-buttons">
            @(Html.DevExtreme().Button()
                        .ID("btnUseDetailedDesc")
                        .Text(new JS("formatMessage('Use Detailed Description')"))
                        .Type(ButtonType.Default)
                        .OnClick("onUseDetailedDescriptionClick") // 🔹 JS handler
                        )
            @(Html.DevExtreme().Button()
                        .ID("btnUseItemDesc")
                        .Text(new JS("formatMessage('Use Item Description')"))
                        .Type(ButtonType.Default)
                        .OnClick("onUseItemDescriptionClick") // 🔹 JS handler
                        )
        </div>
    </div>

    <!-- Row 2: Arabic Description + Convert Button -->
    <table style="width: 100%; border-spacing: 10px; border-collapse: separate;">
        <tr>
            <td colspan="4">
                @(Html.DevExtreme().TextBox()
                                .Label(new JS("formatMessage('Detailed Description / Specification:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("DetailedDescription")
                @*     .Height("100% !important") *@
                                .Width("100%")
                                )
            </td>
        </tr>
       
        <tr>
            <td>
                @(Html.DevExtreme().SelectBox()
                                .ID("CostAllocationEmployees")
                                .Placeholder("Select Employees")
                                .Label(new JS("formatMessage('Cost Allocation for Employees:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
            <td>
                @(Html.DevExtreme().SelectBox()
                                .ID("CostAllocationProperty")
                                .Placeholder("Select Property/Equipments")
                                .Label(new JS("formatMessage('Cost Allocation for Property/Equipments:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
           
        </tr>

        <tr>


            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("DiscountText")
                                .Label(new JS("formatMessage('Discount Text:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .Width("100%")
                                )
            </td>
           
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("Remarks")
                                .Label(new JS("formatMessage('Remarks:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                )
            </td>
        </tr>
        
            <!-- Goods in Transit Checkbox -->
        <tr>
            <td colspan="3">
                @(Html.DevExtreme().CheckBox()
                                .ID("IsGoodsInTransit")
                                .Text(new JS("formatMessage('Choose this Item as Goods in Transit - Cost (Additional Cost on Inventory)')"))
                                .ElementAttr("style", "margin-top:10px; margin-bottom:10px; font-weight:normal;")
                                .Width("100%")
                                )
            </td>
        </tr>

        <!-- Goods in Transit Account & Purchase Voucher No -->
        <tr>
            <td>

                @(Html.DevExtreme().DropDownBox()
                                .Label(new JS("formatMessage('Select Goods in Transit Account:')"))
                                .ID("GoodsInTransitAccount")
                                .DataSource(d => d.WebApi()
                                .Controller("VATModule")
                                .LoadAction("GetvatpurchaseGoodsInTransitLedgers")
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("AccountId")
                                )
                                .AcceptCustomValue(true)
                                .OpenOnFieldClick(false)
                                .ValueChangeEvent("input")
                                .HoverStateEnabled(true)
                                .ValueExpr("AccountId")
                                .DisplayExpr("AccountHead")
                                .LabelMode(EditorLabelMode.Floating)
                                .DropDownOptions(o => o.Width(900)
                                )
                                .ContentTemplate(new TemplateName("PurchaseGoodsInTransitLedgersTemplate"))
                                )
            </td>
            <td>
                @(Html.DevExtreme().DropDownBox()
                                .Label(new JS("formatMessage('Purchase Voucher No:')"))
                                .ID("VATPurchaseVoucherNo")
                                .DataSource(d => d.WebApi()
                                .Controller("VATModule")
                                .LoadAction("GetPurchaseVoucher")
                                .LoadMode(DataSourceLoadMode.Raw)
                                .Key("PurchaseVoucherNo")
                                )
                                .AcceptCustomValue(true)
                                .OpenOnFieldClick(false)
                                .ValueChangeEvent("input")
                                .HoverStateEnabled(true)
                                .ValueExpr("PurchaseVoucherNo")
                                .DisplayExpr("PurchaseVoucherNo")
                                .LabelMode(EditorLabelMode.Floating)
                                .DropDownOptions(o => o.Width(900)
                                )
                                .ContentTemplate(new TemplateName("PurchaseVoucherNoTemplate"))
                                )
            </td>
        </tr>

        


    </table>

    @using (Html.DevExtreme().NamedTemplate("PurchaseGoodsInTransitLedgersTemplate"))
    {
        @(Html.DevExtreme().DataGrid()

            .ID("purchasegoodsintrans-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("VATModule")
            .LoadAction("GetvatpurchaseGoodsInTransitLedgers")
            .LoadMode(DataSourceLoadMode.Raw)
            ///   .Key("AccountHead") //salary paid entry
            .Key("AccountId")

            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            .SearchPanel(sp => sp.HighlightSearchText(true))
            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
            .OnSelectionChanged("dataGridGoodsInTransitAccountSelectionChanged")
            .OnInitialized("dataGridGoodsInTransitAccountInitialized")
                                                                // .HeaderFilter(p => p.Visible(true))
            .ShowBorders(true)
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .ColumnChooser(c => c
            .Enabled(true)
            .Mode(GridColumnChooserMode.DragAndDrop)
            )
            .Pager(pager => pager
            .Visible(true)                            // show pager UI (page numbers etc)
            .ShowPageSizeSelector(true)              // allow user to change page size
            .AllowedPageSizes(new[] { 10, 15, 20 })  // optional page size options
            .ShowInfo(true)                          // show info like "Page 1 of 10"
            )
            .FilterRow(f => f.Visible(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Columns(columns =>
            {
                columns.Add().DataField("AccountId").Caption(new JS("formatMessage('Account Code')")).Alignment(HorizontalAlignment.Center);
                columns.Add().DataField("AccounHead").Caption(new JS("formatMessage('Goods In Transit Ledger')")).Alignment(HorizontalAlignment.Center);
               

            })

            )

        }

    @using (Html.DevExtreme().NamedTemplate("PurchaseVoucherNoTemplate"))
    {
        @(Html.DevExtreme().DataGrid()

            .ID("purchase-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("VATModule")
            .LoadAction("GetvatpurchaseCostPostingForPurchaseVoucher")
            .LoadMode(DataSourceLoadMode.Raw)
            ///   .Key("AccountHead") //salary paid entry
            .Key("PurchaseVoucherNo")

            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            .SearchPanel(sp => sp.HighlightSearchText(true))
            .Selection(sl => sl.Mode(SelectionMode.Single)) // Set to Single selection mode
            .OnSelectionChanged("dataGridPurchaseVoucherSelectionChanged")
            .OnInitialized("dataGridPurchaseVoucherInitialized")
                                                                // .HeaderFilter(p => p.Visible(true))
            .ShowBorders(true)
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .ColumnChooser(c => c
            .Enabled(true)
            .Mode(GridColumnChooserMode.DragAndDrop)
            )
            .Pager(pager => pager
            .Visible(true)                            // show pager UI (page numbers etc)
            .ShowPageSizeSelector(true)              // allow user to change page size
            .AllowedPageSizes(new[] { 10, 15, 20 })  // optional page size options
            .ShowInfo(true)                          // show info like "Page 1 of 10"
            )
            .FilterRow(f => f.Visible(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Columns(columns =>
            {
                columns.Add().DataField("PurchaseVoucherNo").Caption(new JS("formatMessage('Purchase Voucher No')")).Alignment(HorizontalAlignment.Center);
                columns.Add().DataField("PurchaseBillNo").Caption(new JS("formatMessage('Purchase Bill No')")).Alignment(HorizontalAlignment.Center);
                columns.Add().DataField("PurchaseVoucherDate").Caption(new JS("formatMessage('Purchase Voucher Date')")).Alignment(HorizontalAlignment.Center);


            })

            )

        }


</div>

<script>
    function convertToArabic(sourceId, targetId) {
        const sourceValue = $("#" + sourceId).dxTextBox("instance")?.option("value") || $("#" + sourceId).dxTextArea("instance")?.option("value");
        const arabicText = sourceValue + " (Arabic)";
        const targetInstance = $("#" + targetId).dxTextBox("instance") || $("#" + targetId).dxTextArea("instance");
        if (targetInstance) {
            targetInstance.option("value", arabicText);
        }
    }
    $(function () {
            $("#DetailsDescription2").dxTextBox({
                text: formatMessage("Details Description"),
                readOnly: true,
                            onContentReady: function(e) {
                            $(e.element).addClass("dx-textbox-heading");
                    }

            });
    });

        // ✅ Fetch Detailed Description from Item Description
    function onUseDetailedDescriptionClick() {
        const descValue = $("#DetailedDescription").dxTextBox("instance").option("value");

        if (!descValue) {
            DevExpress.ui.notify("Please enter an Item Description first", "warning", 2000);
            return;
        }

        $.ajax({
            url: `/api/VATModule/GetDetailedDescription`,
            type: "GET",
            data: { description: descValue },
            success: function (res) {
                if (res.success) {
                    $("#DetailedDescription").dxTextBox("instance").option("value", res.detailedDesc);
                    DevExpress.ui.notify("Detailed Description loaded", "success", 2000);
                } else {
                    DevExpress.ui.notify("Detailed Description not found", "error", 2000);
                }
            },
            error: function () {
                DevExpress.ui.notify("API call failed", "error", 2000);
            }
        });
    }


            function dataGridGoodsInTransitAccountInitialized(e) {

                dataGrid = e.component;

            }

        function dataGridGoodsInTransitAccountSelectionChanged(e) {

            const selectedKey = e.selectedRowKeys[0];

            const ddbInstance = $("#GoodsInTransitAccount").dxDropDownBox("instance");

            acchead = selectedKey;

            if (selectedKey) {

                ddbInstance.option("value", selectedKey);

                if (ddbInstance.option("opened")) {

                    ddbInstance.close();

                }
              
                    var selectedRowData = $("#purchase-datagrid").dxDataGrid("instance").getSelectedRowsData();

            }
        }


            function dataGridPurchaseVoucherInitialized(e) {

                dataGrid = e.component;

            }

        function dataGridPurchaseVoucherSelectionChanged(e) {

            const selectedKey = e.selectedRowKeys[0];

            const ddbInstance = $("#VATPurchaseVoucherNo").dxDropDownBox("instance");

            acchead = selectedKey;

            if (selectedKey) {

                ddbInstance.option("value", selectedKey);

                if (ddbInstance.option("opened")) {

                    ddbInstance.close();

                }

                    var selectedRowData = $("#purchase-datagrid").dxDataGrid("instance").getSelectedRowsData();

            }
        }

    // ✅ Fetch Item Description from Detailed Description
    function onUseItemDescriptionClick() {
        const descValue = $("#DetailedDescription").dxTextBox("instance").option("value");

        if (!descValue) {
            DevExpress.ui.notify("Please enter a Detailed Description first", "warning", 2000);
            return;
        }

        $.ajax({
            url: `/api/VATModule/GetDescription`,
            type: "GET",
            data: { description: descValue },
            success: function (res) {
                if (res.success) {
                    $("#DetailedDescription").dxTextBox("instance").option("value", res.detailedDesc);
                    DevExpress.ui.notify("Item Description loaded", "success", 2000);
                } else {
                    DevExpress.ui.notify("Item Description not found", "error", 2000);
                }
            },
            error: function () {
                DevExpress.ui.notify("API call failed", "error", 2000);
            }
        });
    }

</script>