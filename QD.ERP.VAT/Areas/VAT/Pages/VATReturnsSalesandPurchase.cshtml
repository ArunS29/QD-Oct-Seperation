    $.get("/api/VATModule/GetCurrencyDecimals")
        .done(function (decimals) {
            currencyDecimals = decimals || 2;
            // applyDynamicFormat(currencyDecimals);
        })
        .fail(function () {
            DevExpress.ui.notify("Failed to load currency decimals, defaulting to 2", "warning", 3000);
        });

        function getDynamicFormat() {
        // Example: currencyDecimals = 3 → "#,##0.000"
        let decimals = currencyDecimals || 2;
        return "#,##0." + "0".repeat(decimals);
    }



    function getTabText(type) {
        if (currencyDecimals === 3) {
            return type === "sales"
                ? formatMessage("VAT on Sales (BH)")
                : formatMessage("VAT on Purchase (BH)");
        } else {
            return type === "sales"
                ? formatMessage("VAT on Sales")
                : formatMessage("VAT on Purchase");
        }
    }




