    }

    .week-bg {
        background: linear-gradient(270deg, #009688, #4db6ac);
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }

    .month-bg {
        background: linear-gradient(270deg, #9c27b0, #ba68c8);
        background-size: 400% 400%;
        animation: gradientPulse 6s ease infinite;
    }

    /* Keyframes */
    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
