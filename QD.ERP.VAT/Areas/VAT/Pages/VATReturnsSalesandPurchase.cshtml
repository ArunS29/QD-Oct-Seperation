    .title {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .card {
        flex: 1;
        padding: 15px;
        border-radius: 12px;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        height: 110px;
    }

        .card h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

        .card p {
            margin: 4px 0;
            font-size: 14px;
        }

        .card .amount {
            font-size: 26px;
            margin: 5px 0;
            font-weight: bold;
        }

        .card .percent {
            font-size: 14px;
            display: flex;
            align-items: center;
        }


    .tabs {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .tab-text {
        flex: 1;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
        padding: 2px 0;
        border-radius: 6px;
        transition: background 0.3s ease;
    }

        .tab-text.active {
            background: rgba(255, 255, 255, 0.9);
            color: #333;
        }

    .tab-content {
        display: none;
        text-align: center;
        animation: fadeSlideIn 0.4s ease;
    }

        .tab-content.active {
            display: block;
        }

    h4 {
        margin-bottom: 4px;
        font-size: 16px;
    }

    .count {
        font-size: 28px;
        font-weight: bold;
