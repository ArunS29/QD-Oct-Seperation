              $("#TotalPurchaseTax").dxNumberBox("instance").option("value", data[0].TotalPurchaseTax);
              $("#vatSalesTurnover").text(new Intl.NumberFormat().format(data[0].RevenueTotal));
              $("#vatPurchaseTurnover").text(new Intl.NumberFormat().format(data[0].TotalPurchaseTax));
              $("#DssSalesTaxAfterAdj").dxNumberBox("instance").option("value", data[0].DSS_Sales_TaxAfterAdj);
              $("#Dss15SalesTaxAfterAdj").dxNumberBox("instance").option("value", data[0].DSS_15_Sales_TaxAfterAdj);
                  $("#DSSTotalSalesTax").dxNumberBox("instance").option("value",
        (data[0].DSS_Sales_TaxAfterAdj || 0) + (data[0].DSS_15_Sales_TaxAfterAdj || 0)
      
    );
      $("#PurchaseTotal").dxNumberBox("instance").option("value", data[0].PurchaseTotal);
          $("#DebitNoteTotal").dxNumberBox("instance").option("value", data[0].DebitNoteTotal);

 

            },
            error: function () {
                DevExpress.ui.notify("Error while loading data", "error", 2000);
            }
