@page
@model QD.ERP.VAT.Areas.VAT.Pages.ClientAddressDetailsDropdownModel
@using DevExtreme.AspNet.Mvc

<style>
    .address-form-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .address-form-table {
        width: 100%;
        border-collapse: collapse;
    }

        .address-form-table td {
            padding: 10px;
            vertical-align: top;
        }

        .address-form-table label {
            display: block;
            font-weight: bold;
            color: #333;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .address-form-table input[type="text"],
        .address-form-table select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }
</style>

<div class="dx-viewport address-form-container">
    <table class="address-form-table">
        <!-- Row 1 -->
        <tr>
            <td colspan ="2"><label for="StreetName">Address - Street Name:*</label></td>
            <td><label for="StreetNameArabic">Address - Street Name (Arabic):*</label></td>
        </tr>
        <tr>
            <td colspan ="2"><input type="text" id="StreetName" name="StreetName" /></td>
            <td><input type="text" id="StreetNameArabic" name="StreetNameArabic" /></td>
        </tr>

        <!-- Row 2 -->
        <tr>
            <td><label for="AdditionalAddress">Address - Additional Address</label></td>











            <td><label for="AdditionalAddressArabic">Address - Additional Address (Arabic)</label></td>
        </tr>
        <tr>
            <td><input type="text" id="AdditionalAddress" name="AdditionalAddress" /></td>
            <td><input type="text" id="AdditionalAddressArabic" name="AdditionalAddressArabic" /></td>
        </tr>

        <!-- Row 3 -->
        <tr>
            <td><label for="BuildingNumber">Building Number:*</label></td>
            <td><label for="ClientCity">Client City:*</label></td>
            <td><label for="ClientCityArabic">Client City (Arabic):*</label></td>
        </tr>
        <tr>
            <td><input type="text" id="BuildingNumber" name="BuildingNumber" /></td>
            <td><input type="text" id="ClientCity" name="ClientCity" /></td>
            <td><input type="text" id="ClientCityArabic" name="ClientCityArabic" /></td>
        </tr>

        <!-- Row 4 -->
        <tr>
            <td><label for="AdditionalNumber">Additional Number:*</label></td>
            <td><label for="Province">Province / State</label></td>
            <td><label for="ProvinceArabic">Province / State (Arabic)</label></td>
        </tr>
        <tr>
            <td><input type="text" id="AdditionalNumber" name="AdditionalNumber" /></td>
            <td><input type="text" id="Province" name="Province" /></td>
            <td><input type="text" id="ProvinceArabic" name="ProvinceArabic" /></td>
        </tr>

        <!-- Row 5 -->
        <tr>
            <td><label for="PostalCode">Postal Code:*</label></td>
            <td><label for="District">District / Neighborhood:*</label></td>
            <td><label for="DistrictArabic">District / Neighborhood (Arabic):*</label></td>
        </tr>
        <tr>
            <td><input type="text" id="PostalCode" name="PostalCode" /></td>
            <td><input type="text" id="District" name="District" /></td>
            <td><input type="text" id="DistrictArabic" name="DistrictArabic" /></td>
        </tr>

        <!-- Row 6 -->
        <tr>
            <td><label for="CountryCode">Country Code:*</label></td>
        </tr>
        <tr>
            <td>
                <select id="CountryCode" name="CountryCode">
                    <option value="US">US</option>
                    <option value="UK">UK</option>
                    <option value="IN" selected>IN</option>
                    <option value="SA">SA</option>
                    <option value="UAE">UAE</option>
                </select>
            </td>
        </tr>
    </table>
</div>
