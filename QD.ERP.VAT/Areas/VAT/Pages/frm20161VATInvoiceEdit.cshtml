	async function onVatAttachmentButtonClick(e) {

		const grid = $("#B2BdataGrid").dxDataGrid("instance");
		const data = grid.getDataSource().items();
		const hasValidAmounts = data.some(row => {
			return (row.CalcLineAmount && row.CalcLineAmount > 0);
