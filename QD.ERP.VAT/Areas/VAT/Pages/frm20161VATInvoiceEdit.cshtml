function validateVATPrefix(vatNo) {

    if (!vatNo || vatNo.length === 0) return { success: true };
	let currencyType="";
    if (currencyType === "BHD" && !vatNo.startsWith("2")) {
        return { success: false, message: "VAT No must start with 2 for BHD currency." };
    }
    if (currencyType === "SAR" && !vatNo.startsWith("3")) {
        return { success: false, message: "VAT No must start with 3 for SAR currency." };
    }
    return { success: true };
}

