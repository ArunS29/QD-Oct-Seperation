async function updateInvoiceChildren() {
	debugger;
    const grid = $("#B2BdataGrid").dxDataGrid("instance");
    let InvoiceChildren = grid.option("dataSource") || [];

    const InVoiceNo = $("#InvoiceNo").dxTextBox("instance").option("value");
    const spinner = document.getElementById('loadingSpinner');

    spinner.style.display = 'block'; // show spinner

    try {
        // 🔹 Step 1: Update UnitRateMethod with corresponding UnitCode
        for (const item of InvoiceChildren) {
            // If UnitRateMethod is empty → set null and skip
            if (!item.UnitRateMethod || item.UnitRateMethod.trim() === "") {
                item.UnitRateMethod = null;
                continue;
            }

            try {
                const unitCode = await $.get("/api/VoucherMaster/GetUnitCodeByDesc", {
                    unitDesc: item.UnitRateMethod
                });

                // Replace description with UnitCode
                item.UnitRateMethod = unitCode ?? null;

            } catch (xhr) {
                console.error(`❌ Error fetching UnitCode for ${item.UnitRateMethod}:`, xhr.responseText);
                item.UnitRateMethod = null; // fallback
            }
        }

        // 🔹 Step 2: Prepare updated data
        const updatedDataSource = InvoiceChildren.map(item => ({
            ...item,
            InvoiceNo: InVoiceNo,
            TaxAmount: item.TaxAmount || 0
        }));

        // 🔹 Step 3: POST to UpdateInvoiceChildDetails API
        await $.ajax({
            type: "POST",
            url: `/api/VoucherMaster/UpdateInvoiceChildDetails`,
            contentType: "application/json",
            data: JSON.stringify(updatedDataSource)
        });

        // 🔹 Step 4: Refresh grid after update
        const response = await $.ajax({
            type: "GET",
            url: `/api/VATModule/GetGridInvoiceDetails?InvoiceNo=${encodeURIComponent(InVoiceNo)}`,
            dataType: 'json'
        });

        const rowData = response.map((item, index) => ({
            SNo: index + 1,
            ...item
        }));

        grid.option("dataSource", rowData);
        grid.refresh();

        getDocumentCount();
        isVoucherSaved = true;
        updateWorkflowVisual(getWorkflowStatusFromFields());

        DevExpress.ui.notify("✅ Invoice details updated successfully.", "success", 2000);

    } catch (err) {
        console.error("Error updating invoice children:", err);
        DevExpress.ui.notify("Error updating invoice children.", "error", 3000);
    } finally {
        spinner.style.display = 'none'; // always hide spinner
    }
}


