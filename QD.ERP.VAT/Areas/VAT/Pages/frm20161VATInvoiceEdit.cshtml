<div class="containerLedgerAccount">
	<div class="content-container-top">
		<div class="horizontal-container">
			@(Html.DevExtreme().Tabs()
						.Items(items =>
						{
							items.Add().Icon("optionsgear").Text(new JS("formatMessage('Invoice Details')"));
							items.Add().Icon("accountbox").Text(new JS("formatMessage('Other Details')"));
							items.Add().Icon("description").Text(new JS("formatMessage('Documents')"));
							items.Add().Icon("card").Text(new JS("formatMessage('Deductions & Currency Details')"));
							items.Add().Icon("group").Text(new JS("formatMessage('Branch/Division Details')"));
							items.Add().Icon("attach").Text(new JS("formatMessage('Signatories')"));
						})
						.SelectedIndex(0)
						.OnSelectionChanged("onTabSelectionChanged")
						)
		</div>

		<!-- Tab Content -->
		<div class="dx-fieldset">


			<div id="tab-content-1" class="tab-content">
				
				<div class="card-container">
					<!-- First Card (Left Side) -->
					<table width="100%" style="font-size:14px; margin:10px 0;" cellpadding="5">
							<tr>
							<td>@(Html.DevExtreme().TextBox().Label(new JS("formatMessage('Invoice No')")).ID("InvoiceNo").Disabled(true).LabelMode(EditorLabelMode.Floating))</td>
							<td>@(Html.DevExtreme().DateBox().Label(new JS("formatMessage('Invoice Date')")).ID("InvoiceDate").Type(DateBoxType.Date).DisplayFormat("dd-MMM-yyyy").Value(DateTime.Now).Disabled(true).LabelMode(EditorLabelMode.Floating))</td>
							<td>
								
									@(Html.DevExtreme().DropDownBox()
																		.Label(new JS("formatMessage('Client Code')"))
																		.DataSource(d => d.WebApi().Controller("VATModule")
																		.LoadAction("GetClientCode")
																		.LoadMode(DataSourceLoadMode.Raw)
																		.Key("AccountId"))
																		.LabelMode(EditorLabelMode.Floating)
																		.ID("ddclientcode")
																		.ValidationRules(rules =>
																		{
																			rules.AddRequired()
																			.Message(new JS("formatMessage('Client Code should be entered')"));
																		})
																		.ShowClearButton(true)
																		.AcceptCustomValue(true)
																		.OpenOnFieldClick(true)
																		.MaxLength(5)
																		.ValueChangeEvent("input")
																		.HoverStateEnabled(true)
																		.ValueExpr("AccountId")
																		.DisplayExpr("AccountId")
																		.OnInput("dropDownBoxOnInput")
																		.OnClosed("onDropDownBoxClosed")
																		.OnOpened("onOpened")
																		.TabIndex(4)
																		.Width("100%")
																		.DropDownOptions(o => {
                                                                        o.Width(900);
                                                                        o.Height(300);
                                                                        })
																		.ContentTemplate(new TemplateName("ClientCodeContentTemplate"))
																		// 👇 Add Buttons Inside DropDownBox
																		.Buttons(buttons =>
																		{
																			buttons.Add()
																			.Name("addButton")
																			.Location(TextEditorButtonLocation.After)
																			.Widget(w => w.Button()
																			.Icon("plus")
																			.Hint("Add Description")
																				.ElementAttr(new { @class = "custom-hover-button add-hover" })
																			.OnClick("onAddClientClick"));
																		

																			buttons.Add()
																			.Name("editButton")
																			.Location(TextEditorButtonLocation.After)
																			.Widget(w => w.Button()
																			.Icon("edit")
																			.Hint("Edit Description")
																			.ElementAttr(new { @class = "custom-hover-button edit-hover" })
					                                                        .OnClick("onEditClientClick"));
																				buttons.Add().Name("dropDown");
																		})
																		)


								

								<!-- Add Popup -->
									@(Html.DevExtreme().Popup()
				.ID("ledgerAccountPopup")
				.Width("80%")
				.Height("85%")
				.Title(new JS("formatMessage('Add Ledger Account')"))
				.ShowTitle(true)
				.CloseOnOutsideClick(true)
				.Visible(false)
				.ResizeEnabled(true)
				.ContentTemplate(@<text>
			<div id="popupContent" class="background" style="width:100%; height:100%;">
				<iframe id="ledgerAccountFrame" class="background" style="width:100%; height:100%; border:none;"></iframe>
			</div>
		</text>)
				)


		@(Html.DevExtreme().Popup()
				.ID("ledgerEditAccountPopup")
				.Width("80%")
				.Height("85%")
				.Title(new JS("formatMessage('Edit Ledger Account')"))
				.ShowTitle(true)
				.CloseOnOutsideClick(true)
				.Visible(false)  // Hidden by default
				.ResizeEnabled(true)
				.ContentTemplate(@<text>
			<div id="popupContent" style="width:100%; height:100%;">
				<iframe id="ledgerEditAccountFrame" style="width:100%; height:100%; border:none;"></iframe>
			</div>
		</text>)
				)

							</td>

							<td>
								@(Html.DevExtreme().DropDownBox()
																.Label(new JS("formatMessage('Client Name')"))
																.DataSource(d => d.WebApi().Controller("VATModule")
																.LoadAction("GetClientCode")
																.LoadMode(DataSourceLoadMode.Raw)
																.Key("AccountId"))
																.LabelMode(EditorLabelMode.Floating)
																.ID("ddclientname")
																.ValidationRules(rules =>
																{
																	rules.AddRequired()
																	.Message(new JS("formatMessage('Client Name should be entered')"));
																})
																.ShowClearButton(true)
																.AcceptCustomValue(true)
																.OpenOnFieldClick(false)
																.ValueChangeEvent("input")
																.HoverStateEnabled(true)
																.ValueExpr("AccountId")
																.DisplayExpr("AccountHead")
																.TabIndex(1)
																.Width("100%")
																.DropDownOptions(o =>
                                                                 {
                                                                     o.Width(500);
                                                                     o.OnShowing("onClientNameBeforeOpen"); // ✅ hook before opening
                                                                 })
																.OnKeyDown("onKeyDown")
																.ContentTemplate(new TemplateName("ClientNameContentTemplate"))
																.Buttons(b =>
                                                                {
                                                                    b.Add()
                                                                        .Name("linkButton")
                                                                        .Location(TextEditorButtonLocation.After)
                                                                        .Widget(w => w.Button()
                                                                            .Icon("link")
                                                                            .Hint("Link")
                                                                            .StylingMode(ButtonStylingMode.Text)
                                                                            .Type(ButtonType.Normal)
                                                                            .OnClick("onClientLinkClick") // Moved inside the Button widget config
                                                                        );
                                                                
                                                                    b.Add().Name("dropDown");
                                                                })

																)
							</td>



						<!-- Group VAT No -->
