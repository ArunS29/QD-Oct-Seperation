				 function onClientCodeChanged(accheadid) {
		$.ajax({
			url: '/api/AccountLedgerMaster/GetAccountDetails',
			type: 'GET',
			data: { accountID: accheadid },
			success: function (result) {
				
				// 1. Pick the first record regardless of the shape returned
				const details = Array.isArray(result)
					? result[0]
					: (result.accountDetails || [])[0];

				if (!details) {
					DevExpress.ui.notify("No account details returned", "warning", 3000);
					return;
				}

				// 2. Get your base Invoice Date (today fallback)
				const invoiceDateBox = $("#InvoiceDate").dxDateBox("instance");
				const baseDate = invoiceDateBox?.option("value")
					? new Date(invoiceDateBox.option("value"))
					: new Date();

				// 3. Default credit days from master
				let creditDays = Number(details.NoOfDaysCreditPeriod) || 0;
				let NoOfDays = creditDays;
			
				// 4. If the checkbox “Submitted By” is ticked, recompute creditDays
				const isSubmitted = $('#SubmittedBy').dxCheckBox("instance")?.option("value");
				if (isSubmitted) {
					const invoiceSubmittedDate = $("#ddlinvoicesubmittedon")
						.dxDateBox("instance")
						.option("value");

					if (invoiceSubmittedDate) {
						const diffMs = new Date(invoiceSubmittedDate) - baseDate;
						SubcreditDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
						NoOfDays = creditDays+SubcreditDays;
					}
				}

				// 5. Calculate the due date and push it into the UI
				const dueDate = new Date(baseDate);
					dueDate.setDate(dueDate.getDate() + NoOfDays);
				$("#InvoiceDueDate").dxDateBox("instance").option("value", dueDate);
			},
			error: function () {
				DevExpress.ui.notify("Failed to fetch data for client", "error", 2000);
			}
		});
	}


