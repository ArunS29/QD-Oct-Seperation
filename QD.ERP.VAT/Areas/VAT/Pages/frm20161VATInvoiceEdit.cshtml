</td>


							<td>
								@(Html.DevExtreme().DropDownBox()
															.Label(new JS("formatMessage('Other ID Type')"))
															.DataSource(d => d.WebApi().Controller("VATModule").LoadAction("GetVATInvoiceMaster").LoadMode(DataSourceLoadMode.Raw).Key("BuyerOtherIdtype"))
															.LabelMode(EditorLabelMode.Floating)
															.ID("OtherIDType")
															.ShowClearButton(true)
															.AcceptCustomValue(true)
															.OpenOnFieldClick(false)
															.ValueChangeEvent("input")
															.HoverStateEnabled(true)
															.Value(null)
															.ValueExpr("BuyerOtherIdtype")
															.DisplayExpr("BuyerIdtypeName")
															.Width("100%")
															.TabIndex(1)
															.DropDownOptions(o => o.Width(700))
															.OnKeyDown("onKeyDown")
															.ContentTemplate(new TemplateName("ClientNameContent"))
