					//Discount
						function onEditorPreparing(e) {
		     if (e.parentType === "dataRow" &&
				(e.dataField === "QuantityInvoiced" ||
				 e.dataField === "UnitRate" ||
			// e.dataField === "VATPercentage" ||
			 e.dataField === "Discount")) {
				 
			e.editorOptions.onValueChanged = function (args) {
				let grid = $("#B2BdataGrid").dxDataGrid("instance");
				let rowIndex = e.row.rowIndex;
						rowIx=rowIndex;
				debugger;
				let newValue = args.value;

					//	let qty = e.dataField === "QuantityInvoiced" ? newValue : grid.cellValue(rowIndex, `${formatMessage('QuantityInvoiced')}`) || 0;
						 let qty = (e.dataField === "QuantityInvoiced")
         ? newValue
         : (grid.cellValue(rowIndex, "QuantityInvoiced") ?? 0);


						if (qty <= 0) {

						DevExpress.ui.dialog.alert(
							"Quantity cannot be zero or negative.",
							"Quantity Error"
							)
						}
						else
						{
				
				let unitPrice = e.dataField === "UnitRate" ? newValue : grid.cellValue(rowIndex, 'UnitRate') || 0;
				let discount = e.dataField === "Discount" ? newValue : grid.cellValue(rowIndex,'Discount') || 0;
			    let TotalAmtBeforeDiscount = e.dataField === "CalcLineAmountBeforeDiscount" ? newValue : grid.cellValue(rowIndex, 'CalcLineAmountBeforeDiscount') || 0;

				// VAT rate handling
				let vatRateStr = e.dataField2 === "VATPercentage" ? newValue : grid.cellValue(rowIndex, `${formatMessage('VAT%')}`) || "0%";
				let vatRate = parseFloat(vatRateStr.replace("%", "")) / 100;

				// Calculate amount
				let amount = qty * unitPrice;
				let discountedAmount = amount - discount;

				// Ensure discountedAmount doesn't go negative
				if (discountedAmount < 0) discountedAmount = 0;

				let vatValue = discountedAmount * vatRate;
				let totalValue = discountedAmount + vatValue;
                 grid.cellValue(rowIndex, `${formatMessage('VAT')}`, formatAmount(vatValue));
                        grid.cellValue(rowIndex, `${formatMessage('Total')}`, formatAmount(totalValue));
                        grid.cellValue(rowIndex, `${formatMessage('Unit Price')}`, formatAmount(unitPrice));
                        grid.cellValue(rowIndex, `${formatMessage('Total Before Discount')}`, formatAmount(TotalAmtBeforeDiscount));
                        grid.cellValue(rowIndex, `${formatMessage('Amount')}`, formatAmount(amount));
                        grid.cellValue(rowIndex, `${formatMessage('Discount')}`, formatAmount(discount));
                        grid.cellValue(rowIndex, `${formatMessage('Qty')}`, formatAmount(qty));
                        grid.cellValue(rowIndex, `${formatMessage('VAT%')}`, vatRateStr); // % can remain as string

			  // Store value for use in popover
               currentAmount = formatAmount(amount);
               grid.saveEditData();
			   updateInvoiceChildren();
			   }

			};
		}
	}

