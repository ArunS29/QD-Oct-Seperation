  $(document).ready(function () {
	  debugger;
      const voucherNoField = $("#InvoiceNo").dxTextBox("instance");
      const voucherNoFromUrl = getUrlParameter('InvoiceNo');

      if (voucherNoFromUrl) {
          // ✅ Use voucher number from URL
          voucherNoField.option("value", voucherNoFromUrl);
          getDocumentCount();
      } else {
    	if (IsCurrent !== "true") {
          $.ajax({
              url: '@Url.Action("GetVATInvoiceNo", "VATModule")',
              type: 'GET',
              success: function (data) {
                  voucherNoField.option("value", data);
                  //Savedetailsonload();
                 InvoiceOPenToSave(data);
                  const newUrl = `/${tenantName}/VAT/frm20161VATInvoiceEdit?InvoiceNo=${encodeURIComponent(data)}`;
                  window.history.replaceState({}, "", newUrl);

                  
                  getDocumentCount();
              },
              error: function () {
                  alert("Error generating voucher number.");
              }
          });
		  }
      }

      // Helper to extract URL parameter
      function getUrlParameter(name) {
          name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
          const regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
          const results = regex.exec(window.location.search);
          return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
      }
  });


</script>

