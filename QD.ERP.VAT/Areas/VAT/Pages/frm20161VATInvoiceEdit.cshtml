	// Generates the transaction code like "010110"
	function setInvoiceTransactionCode(selectedIds) {
		// Initialize the transaction code with a prefix
		let strTransactionCode = "01";

		// Dynamically generate the binary string based on selections (1 for selected, 0 for unselected)
		for (let i = 1; i <= 5; i++) {
			strTransactionCode += selectedIds.includes(i) ? "1" : "0";
		}

		return strTransactionCode;
	}


