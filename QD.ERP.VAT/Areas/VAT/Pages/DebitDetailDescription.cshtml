@page
@model QD.ERP.VAT.Areas.VAT.Pages.DebitDetailDescriptionModel
@{
}
<style>
    .form-wrapper {
        margin: 10px;
        padding: 20px;
        border-radius: 6px;
        width: 100%;
        height: 85%;
    }

    .form-group {
        position: relative;
        padding: 10px;
    }

        .form-group label {
            display: block;
            margin-bottom: 15px;
        }

    .form-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .element.style {
        height: 110px !important;
    }
    /*
        .dx-textarea-input,
        .dx-dropdowneditor-input,
        .dx-datebox-input {
            color: black !important;
            height: 45px !important;
        }

        .dx-textarea, .dx-texteditor-input {
            resize: none;
            font-family: inherit;
            display: block;
            overflow: auto;
            white-space: pre-wrap;
            margin: 0;
            height: 100px !important;
        } */
    .arabic-button {
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .top-buttons {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        gap: 8px;
    }

        .top-buttons .dx-button {
            height: 30px;
            color: black;
        }

    .arabic-textbox-wrapper {
        position: relative;
        width: 100%;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
     
        width: 97%;
    }

    .playIcon {
        display: none;
    }

    table tr {
        gap: 10px;
    }
</style>


<div class="title">
    <div class="header-container">
        <div id="DetailsDescription2" class="no-border-title"></div>
    </div>
</div>
<div class="form-wrapper">

    <!-- Row 1: Detailed Description + 2 Buttons -->
    <div class="form-group">
        <div class="top-buttons">
            @(Html.DevExtreme().Button()
                        .ID("btnUseDetailedDesc")
                        .Text("Use Detailed Description")
                        .Type(ButtonType.Default)
                        )
            @(Html.DevExtreme().Button()
                        .ID("btnUseItemDesc")
                        .Text("Use Item Description")
                        .Type(ButtonType.Default)
                        )
        </div>
    </div>

    <!-- Row 2: Arabic Description + Convert Button -->
    <table style="width: 100%; border-spacing: 10px; border-collapse: separate;">
        <tr>
            <td colspan="4">
                @(Html.DevExtreme().TextBox()
                                .Label(new JS("formatMessage('Detailed Description / Specification:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("DetailedDescription")
                @*     .Height("100% !important") *@
                                .Width("100%")
                                )
            </td>
        </tr>
        



    </table>

</div>

<script>
    
    $(function () {
            $("#DetailsDescription2").dxTextBox({
                text: formatMessage("Details Description"),
                readOnly: true,
                            onContentReady: function(e) {
                            $(e.element).addClass("dx-textbox-heading");
                    }

            });
    });
</script>