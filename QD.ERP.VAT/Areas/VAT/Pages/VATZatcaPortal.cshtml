			function generateZatcaInvoice() {
		debugger;
		let ConnectionStatus = "Connected";

		$.ajax({
			url: "/api/VATZatca/ConnectToPortal",
			type: "POST",
			contentType: "application/json",
			data: JSON.stringify({
				InvNo: InvNo,                 // pass invoice number
				ConnectionStatus: ConnectionStatus // pass connection status
			}),
			success: function (res) {
				if (res.Success) {
					DevExpress.ui.notify(res.Message, "success", 2000);
					 console.log("XMLResponse",res)
					 debugger;
					  XMLResponse = res.XMLResponse;
						  getInvoiceLog(InvNo,XMLResponse);
							getInvoiceMaster(InvNo);
	
				} else {
					DevExpress.ui.notify(res.Message || "Connection failed", "error", 3000);
				}
			},
			error: function (xhr) {
				let errMsg = xhr.responseJSON?.Error || xhr.responseText || "Unexpected error";
				DevExpress.ui.notify("Error: " + errMsg, "error", 3000);
			}
		});
	}

			 function getInvoiceLog(invNo, XMLResponse) {
		$.ajax({
			url: "/api/VATZatca/GetInvoiceLog",
			type: "GET",
			data: { invoiceNo: invNo },  // pass as query string parameter
			success: function (res) {
				if (res) {
					DevExpress.ui.notify("Invoice log fetched successfully", "success", 2000);
					console.log("Invoice Log:", res);

					// Bind response data to B2BdataGrid
					let grid = $("#B2BdataGrid").dxDataGrid("instance");
					grid.option("dataSource", [res]); // wrap in array if single record

					// Show status
					console.log("Invoice Status:", res.InvoiceStatus);
				} else {
					DevExpress.ui.notify("No log found", "warning", 3000);
				}
			},
			error: function (xhr) {
				let errMsg = xhr.responseJSON?.Error || xhr.responseText || "Unexpected error";
				DevExpress.ui.notify("Error: " + errMsg, "error", 3000);
			}
		});
	}


