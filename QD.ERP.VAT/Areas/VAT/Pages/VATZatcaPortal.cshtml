<div class="containerLedgerAccount">
	<div class="content-container-top">
		<div class="horizontal-container">
			@(Html.DevExtreme().Tabs()
						.Items(items =>
						{
							items.Add().Icon("optionsgear").Text(new JS("formatMessage('Main')"));
							items.Add().Icon("accountbox").Text(new JS("formatMessage('Invoice Master')"));
							items.Add().Icon("description").Text(new JS("formatMessage('Seller & Buyer Details')"));
							items.Add().Icon("card").Text(new JS("formatMessage('Payment Details')"));
							items.Add().Icon("group").Text(new JS("formatMessage('Item Details')"));
							items.Add().Icon("attach").Text(new JS("formatMessage('Validations')"));
							items.Add().Icon("attach").Text(new JS("formatMessage('XML')"));

						})
						.SelectedIndex(0)
						.OnSelectionChanged("onTabSelectionChanged")
						)
		</div>

		<!-- Tab Content -->
		<div class="dx-fieldset">
			<div id="tab-content-1" class="tab-content">
				<div class="card-container" style="display: flex; gap: 20px;">

					<!-- Left Side: QR Code Table -->
					<div style="flex: 1; max-width: 40%;">
						<table width="100%" style="font-size:14px; margin:10px 0;" cellpadding="5" border="1">
							<tr>
								<td>
									<h3>QR Code(Phase 2):</h3>
									<div id="qrCodeBox" style="min-height: 322px; border: 1px solid #ccc; padding: 10px; text-align: center;">
										@* <img src="data:image/png;base64,"
											 alt="Dummy QR" style="max-width: 150px; max-height: 150px;" /> *@
										<div id="qrcode"></div>
										<div style="margin-top: 10px;">Sample QR Data</div>
									</div>
								</td>
							
							</tr>
						</table>
						<td>@(Html.DevExtreme().TextBox().Label(new JS("formatMessage('')")).ID("XMLResponse").LabelMode(EditorLabelMode.Floating).Width(300))</td>
						<div style="margin-top: 10px;">Connection Status:</div>
					</div>

					<!-- Right Side: DataGrid -->
					<div style="flex: 2;">
						<h3>eInvoice Submission Log to Zatca Fatoora Portal</h3>
						<div class="dx-field ledgerResult">
							@(
														Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.Tbl90121eInvoiceLogTable>()
														.ID("B2BdataGrid")
														.DataSource(new JS("[]"))
														.RemoteOperations(false)
														.Columns(columns =>
														{
															columns.AddFor(m => m.EInvoiceNo)
															.Caption(new JS("formatMessage('Invoice No')"))
															.Visible(true);

															columns.AddFor(m => m.EInvoiceDateTime)
															.Caption(new JS("formatMessage('Invoice Date')"))
															.Visible(true);

															columns.AddFor(m => m.InvoiceStatus)
															.Caption(new JS("formatMessage('Invoice Status')"))
															.Visible(true);

															columns.AddFor(m => m.SubmissionStatusText)
															.Caption(new JS("formatMessage('Submission Status')"))
															.Visible(true)
															.EditCellTemplate(@<text>
												   								function(cellElement, cellInfo) {
												   								$("<textarea></textarea>")
												   								.css({ width: "100%", height: "100px" })
												   								.val(cellInfo.value)
												   								.on("change", function() {
												   								cellInfo.setValue($(this).val());
												   								})
												   								.appendTo(cellElement);
												   								}
												   							</text>);


															columns.AddFor(m => m.SubmittedBy)
															.Caption(new JS("formatMessage('Submitted By')"))
															.Visible(true);

															columns.AddFor(m => m.SubmittedOn)
															.Caption(new JS("formatMessage('Submitted On')"))
															.Visible(true);

															columns.AddFor(m => m.ZatcaResponse)
															.Caption(new JS("formatMessage('Zatca Response')"))
															.Visible(true)
															.EditCellTemplate(@<text>
												   								function(cellElement, cellInfo) {
												   								$("<textarea></textarea>")
												   								.css({ width: "100%", height: "100px" })
												   								.val(cellInfo.value)
												   								.on("change", function() {
												   								cellInfo.setValue($(this).val());
												   								})
												   								.appendTo(cellElement);
												   								}
												   							</text>);
														})
														.Selection(selection => selection.Mode(SelectionMode.Single))
														.AllowColumnReordering(true)
														.AllowColumnResizing(true)
														.ColumnFixing(fixing => fixing.Enabled(true))
														.Height(400)
														.ColumnAutoWidth(true)
														.FilterRow(filterRow => filterRow.Visible(false))
														.GroupPanel(groupPanel => groupPanel.Visible(false))
														.ShowBorders(true)
														.Width("100%")
														.Editing(editing => editing
														.Mode(GridEditMode.Cell)
														.AllowUpdating(true)
														.UseIcons(true)
														)
														)
						</div>
					</div>

				</div>
			</div>

			</div>


