	.toggle-switch {
		position: relative;
		display: inline-block;
		width: 40px;
		height: 20px;
	}

		.toggle-switch input {
			opacity: 0;
			width: 0;
			height: 0;
		}

	.slider {
		position: absolute;
		cursor: pointer;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: #e53935; /* Red by default */

		transition: 0.4s;
		border-radius: 20px;
	}

		.slider:before {
			position: absolute;
			content: "";
			height: 16px;
			width: 16px;
			left: 2px;
			bottom: 2px;
			background-color: white;
			transition: 0.4s;
			border-radius: 50%;
		}

	.toggle-switch input:checked + .slider {
		background-color: #4CAF50; /* Green when checked */
	}

		.toggle-switch input:checked + .slider:before {
			transform: translateX(20px);
		}

