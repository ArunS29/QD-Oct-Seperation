


<style type="text/css">
    #dataGrid .dx-datagrid-headers .dx-datagrid-action {
        text-align: center !important;
    }

    #dataGrid .dx-datagrid-headers .dx-cell-focus-disabled {
        text-align: center !important;
    }

    .horizontal-container {
        display: flex;
        gap: 10px; /* Adds spacing between buttons */
        justify-content: start; /* Aligns buttons to the left */
        align-items: center; /* Vertically centers the buttons */
        margin: 15px;
        margin-top: 0px;
    }

    .button-alignment-down {
        margin-top: 23px;
    }

    .button-group {
        margin-left: -10px !important;
    }

    /* Custom styles for context menu */
    .context-menu {
        display: none;
        position: absolute;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
        z-index: 1000;
    }

    .context-menu-item {
        padding: 0px, 15px,10px 15px;
        cursor: pointer;
    }

    .ledgerResult {
        margin: 15px !important;
    }

    #rowHeightMenu {
        position: absolute;
        top: 100px; /* Adjust positioning as per your design */
        left: 300px; /* Adjust positioning as per your design */
        display: none; /* Keep it hidden until needed */
    }

    .bold-button .dx-button-text {
        font-weight: bold;
    }

    .dx-icon-green-circle::before {
        content: '';
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: green;
        vertical-align: middle;
    }
</style>
<div class="dx-fieldset horizontal-container mt-2">
   
  
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnSave")
            .Text(new JS("formatMessage('Save')"))
            .Icon("save")
            .Hint("Click to save")
            .ElementAttr(new { @class = "dx-button-custom btn-save" })
            .OnClick("onSaveClicked") // Bind JS function here
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnSaveAndClose")
            .Icon("save")
            .Text(new JS("formatMessage('Save And Close')"))
            .Hint("Save and Close")
            .Width(180)
                .ElementAttr(new { @class = "dx-button-custom btn-save" })
            .OnClick("onSaveAndCloseClicked") // Save and go back
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnDelete")
            .Icon("trash")
            .Text(new JS("formatMessage('Delete')"))
            .Hint("Delete")
            .Width(150)
            .ElementAttr(new { @class = "dx-button-custom btn-save-close" })
            .OnClick("onDeleteClick")  // <-- Call JS function here
            )
    </div>


    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnBack")
            .Text(new JS("formatMessage('Back')"))
            .Icon("arrowleft")
            .Hint("Click to go back")
            .Width(150)
                .ElementAttr(new { @class = "dx-button-custom btn-back" })
            .OnClick("onBackButtonClick")
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
                .ID("ddBtnLayout")
                .Icon("smalliconslayout")
                .Text(new JS("formatMessage('Layout')"))
                .DropDownOptions(options => options.Width(230))
                .Items(items =>
                {
                    items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
                    items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
                })
                .ShowArrowIcon(false)
                )
    </div>



</div>
<script type="text/javascript">
    let IsDirect = true;
    $(document).on("click", function () {
        var contextMenu = $("#contextMenu");
        contextMenu.hide();
        var $submenu = $('#submenuContainer');
        $submenu.hide();
    });

    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    const layout = JSON.parse(e.target.result);

                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            reader.readAsText(file);
        }
    });
    function saveLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var layout = grid.state();
        const layoutJson = JSON.stringify(layout, null, 2);
        const blob = new Blob([layoutJson], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "grid-layout.json";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }
    function openLayoutClick(e) {
        $("#loadLayoutInput").click();
    }

    function loadGridState() {
        var form = $('#formId').val();
        $.ajax({
            url: `/api/Utility/LoadLayout`,
            method: 'GET',
            data: {
                form: form
            },
            success: function (response) {
                var dataGrid = $("#dataGrid").dxDataGrid("instance");
                if (response) {
                    try {
                        const layout = JSON.parse(response);
                        dataGrid.state(layout);
                    } catch (error) {
                        console.error("Error parsing JSON:", error);
                        alert("Failed to load layout. Please ensure the JSON is valid.");
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading grid state:", error);
            }
        });
    }
     
 
    function ChangeRowHeight(newHeight) {
        // Update the row height
        $("#dataGrid .dx-data-row").css("height", newHeight + "px");
        closeSubmenu();
    }
    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function closeSubmenu() {
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });
    function onBackButtonClick(e) {
        window.history.back();
    }

        function onDeleteClick() {
        const gscode = $("#StockNoItemCode").dxTextBox("instance").option("value");

        if (!gscode) {
            DevExpress.ui.notify("No item selected to delete.", "warning", 2000);
            return;
        }

        DevExpress.ui.dialog.confirm("Are you sure you want to delete this item?", "Confirm Delete")
            .done(function (dialogResult) {
                if (dialogResult) {
                    // Call API to delete
                    fetch(`/api/StockInventory/DeleteByCode?code=${encodeURIComponent(gscode)}`, {
                        method: 'DELETE'
                    })
                        .then(response => {
                            if (!response.ok) throw new Error("Failed to delete item");
                            return response.json();
                        })
                        .then(result => {
                            if (result.success) {
                                DevExpress.ui.notify("Item deleted successfully.", "success", 2000);
                                setTimeout(() => window.location.reload(), 500);
                            } else {
                                DevExpress.ui.notify(result.message || "Delete failed.", "error", 3000);
                            }
                        })
                        .catch(error => {
                            console.error("Delete error:", error);
                            DevExpress.ui.notify("Error occurred while deleting item.", "error", 3000);
                        });
                }
            });
    }



</script>