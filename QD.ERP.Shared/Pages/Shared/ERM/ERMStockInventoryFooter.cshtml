


   
<div class="dx-fieldset horizontal-container mt-2">
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnRefresh")
            .Icon("refresh")
            .Text(new JS("formatMessage('Refresh')"))
            .Width(150)
            .OnClick("refreshGrid")
            )
    </div>
    <div class="btn-container">
    @(Html.DevExtreme().DropDownButton()
        .ID("ddButtonLayout")
        .Icon("smalliconslayout")
        .Width(150)
        .Text(new JS("formatMessage('Layout')"))
        .DropDownOptions(options => options.Width(230))
        .Items(items =>
        {
            items.Add().Text(new JS("formatMessage('Set as Default Layout')")).Icon("lock").OnClick("setDefaultLayoutClick");
            items.Add().Text(new JS("formatMessage('Reset Layout')")).Icon("revert").OnClick("resetLayoutClick");
            items.Add().Text(new JS("formatMessage('Open Layout')")).Icon("activefolder").OnClick("openLayoutClick");
            items.Add().Text(new JS("formatMessage('Save Layout')")).Icon("save").OnClick("saveLayoutClick");
        })
        .ShowArrowIcon(false)
        )
        </div>
        <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("rowHeightProperties")
            .Icon("") // fallback to standard icon if "rowproperties" not working
            .Width(50)
            .Text(new JS("formatMessage('Set Row Height')"))
            .DropDownOptions(options => options.Width(230))
            .Items(items =>
            {
                items.Add()
                .Text("Short (1 Line)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="9" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Short
                           </text>)
                .OnClick("function() { ChangeRowHeight('30'); }");

                items.Add()
                .Text("Medium (2 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="6" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Medium
                           </text>)
                .OnClick("function() { ChangeRowHeight('60'); }");

                items.Add()
                .Text("Tall (4 Lines)")
                .Template(@<text>
                               <svg width="20" height="20" viewBox="0 0 20 20">
                                   <rect x="2" y="4" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="8" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="12" width="16" height="2" fill="var(--title-background-color)" />
                                   <rect x="2" y="16" width="16" height="2" fill="var(--title-background-color)" />
                               </svg> Tall
                           </text>)
                .OnClick("function() { ChangeRowHeight('90'); }");

                items.Add()
                .Text("Extra Tall (8 Lines)")
                .Template(@<text>
            <svg width="20" height="20" viewBox="0 0 20 20">
                @for (var i = 1; i <= 8; i++)
                        {
                            var y = 1 + (i - 1) * 2;
                            <text><rect x="2" y="@y" width="16" height="1" fill="var(--title-background-color)" /></text>
                        }
            </svg> Extra Tall
        </text>)
                .OnClick("function() { ChangeRowHeight('130'); }");
            })
            .ShowArrowIcon(false)
        )
    </div>
    <div class="btn-container">
    @(Html.DevExtreme().Button()
        .ID("btnPrint")
        .Text(new JS("formatMessage('Print')"))
        .Icon("print")
        .Hint("Click to print")
        .OnClick("printFun")
        .ElementAttr(new { @class = "bold-button" }) 
        )
        </div>
    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnToggleSearch")
            .Icon("search")
            .Text(new JS("formatMessage('Search')"))
            .Width(150)
            .OnClick("toggleFilterRow")
            )
    </div>



    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btntoggleGroupPanel")
            .Icon("hierarchy")
            .Width(150)
            .Text(new JS("formatMessage('Group')"))
            .OnClick("toggleGroupPanel")
            )
    </div>
    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddButtonShow")
            .Icon("folder")
            .Width(150)
            .Text(new JS("formatMessage('Show')"))
            .DropDownOptions(options => options.Width(250))
            .Items(items =>
            {
                items.Add()
                    .Text(new JS("formatMessage('Show Items Discontinued')"))
                    .Icon("close")
                    .Option("color", "#EA4335") // Red
                    .OnClick("DiscontinuedClick");

                items.Add()
                    .Text(new JS("formatMessage('Show All Items')"))
                    .Icon("selectall")
                    .Option("color", "#4285F4") // Blue
                    .OnClick("AllitemsClick");

                items.Add()
                    .Text(new JS("formatMessage('Show Items In Use')"))
                    .Icon("check")
                    .Option("color", "#34A853") // Green
                    .OnClick("UseClick");
            })
            .ItemTemplate(@<text>
                <div class="custom-dropdown-item">
                    <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                    <div class="item-content">
                        <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                        <div>
                            <div class="item-title"><%- text %></div>
                        </div>
                    </div>
                </div>
            </text>)
            .ShowArrowIcon(false)
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().DropDownButton()
            .ID("ddReports")
            .Icon("print")
            .Width(150)
            .Text(new JS("formatMessage('Report')"))
            .DropDownOptions(options => options.Width(350))
            .Items(items =>
            {
                items.Add()
                    .Text(new JS("formatMessage('Equipment Revenue & Cost Report')"))
                    .Icon("money")
                    .OnClick("EqrevenueCostsum")
                    .Option("color", "#FF7043");  // Orange

                items.Add()
                    .Text(new JS("formatMessage('Report on Equipment Revenue & cost (Detailed)')"))
                    .Icon("money")
                    .OnClick("ReportonCost")
                    .Option("color", "#00ACC1");  // Cyan

                items.Add()
                    .Text(new JS("formatMessage('Doucument Expiry Details')"))
                    .Icon("money")
                    .OnClick("DoucumentExpiry")
                    .Option("color", "#AB47BC");  // Purple

                @* items.Add()
                    .Text(new JS("formatMessage('Inventory Report on Store(Pivort Report)')"))
                    .Icon("money")
                    .Option("color", "#FBBC05");  // Yellow

                items.Add()
                    .Text(new JS("formatMessage('Inventory Report On stores (By Date)')"))
                    .Icon("money")
                    .Option("color", "#EA4335");  // Red

                items.Add()
                    .Text(new JS("formatMessage('Inventory - Stock Movement report')"))
                    .Icon("money")
                    .Option("color", "#34A853");  // Green *@
            })
            .ItemTemplate(@<text>
                <div class="custom-dropdown-item">
                    <div style="background-color:<%- color || '#808080' %>; height:90%" class="side-bar"></div>
                    <div class="item-content">
                        <div class="item-icon dx-icon dx-icon-<%- icon %>"></div>
                        <div>
                            <div class="item-title"><%- text %></div>
                        </div>
                    </div>
                </div>
            </text>)
            .ShowArrowIcon(false)
            )
    </div>

    <div class="btn-container">
        @(Html.DevExtreme().Button()
            .ID("btnAddNewProperty")
            .Icon("fa-solid fa-house")
            .Text(new JS("formatMessage('Add New Property')"))
            .Width(200)
            .OnClick("addStock")
            )

    </div>
</div>
<script type="text/javascript">
    let IsDirect = true;
    $(document).on("click", function () {
        var contextMenu = $("#contextMenu");
        contextMenu.hide();
        var $submenu = $('#submenuContainer');
        $submenu.hide(); 
    });

    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    const layout = JSON.parse(e.target.result);

                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            reader.readAsText(file);
        }
    });
    function saveLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var layout = grid.state();
        const layoutJson = JSON.stringify(layout, null, 2); 
        const blob = new Blob([layoutJson], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "grid-layout.json"; 
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }
    function openLayoutClick(e) {
        $("#loadLayoutInput").click();
    }

    function loadGridState() {
        var form = $('#formId').val();
        $.ajax({
            url: `/api/Utility/LoadLayout`, 
            method: 'GET',
            data: {
                form: form
            },
            success: function (response) {
                var dataGrid = $("#dataGrid").dxDataGrid("instance");
                if (response) {
                    try {
                        const layout = JSON.parse(response);
                        dataGrid.state(layout);
                    } catch (error) {
                        console.error("Error parsing JSON:", error);
                        alert("Failed to load layout. Please ensure the JSON is valid.");
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading grid state:", error);
            }
        });
    }
    function setDefaultLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var form = $('#formId').val();
        var layout = grid.state();
        const layoutJson = JSON.stringify(layout, null, 2);
        console.log(layoutJson);

        $.ajax({
            url: '/api/Utility/SaveLayout',  // API endpoint
            type: 'POST',
            data: {
                layout: layoutJson,
                form: form
            },
            success: function (data) {
                DevExpress.ui.notify("Layout saved successfully", "success", 2000);
            },
            error: function () {
                DevExpress.ui.notify("Error while saving data", "error", 2000);
            }
        });
    }
    function resetLayoutClick(e) {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var form = $('#formId').val();
        $.ajax({
            url: '/api/Utility/SaveLayout',  // API endpoint
            type: 'POST',
            data: {
                layout: null,
                form: form
            },
            success: function (data) {
                DevExpress.ui.notify("Layout reset successfull", "success", 2000);
                grid.state({});
            },
            error: function () {
                DevExpress.ui.notify("Error while saving data", "error", 2000);
            }
        });
    }
    function toggleGroupPanel() {
        var dataGrid = $("#dataGrid").dxDataGrid("instance");
        var isVisible = dataGrid.option("groupPanel.visible");
        dataGrid.option("groupPanel.visible", !isVisible);
    }
    function toggleFilterRow() {
        var grid = $("#dataGrid").dxDataGrid("instance");
        var currentVisibility = grid.option("filterRow.visible");

        grid.option("filterRow.visible", !currentVisibility);
    }

    function ChangeRowHeight(newHeight) {
        // Update the row height
        $("#dataGrid .dx-data-row").css("height", newHeight + "px");
        closeSubmenu();
    }
    function showSubmenu(e) {
        e.event.stopPropagation();
        var $submenu = $('#submenuContainer');
        var $target = $(e.event.target).closest('.dx-item-content'); // Target the content of the item
        var offset = $target.offset();
        var elementWidth = $target.outerWidth();
        var elementHeight = $target.outerHeight();

        // Position the submenu to the right of the dropdown item
        $submenu.css({
            'width': 180,
            'position': 'absolute',
            'top': offset.top,
            'left': offset.left + elementWidth, // Position to the right of the item
            'display': 'block' // Show the submenu
        });
    }
    function closeSubmenu() {
        var $submenu = $('#submenuContainer');
        $submenu.hide(); // Hide the submenu popup
    }
    // Handle the file selection
    $("#loadLayoutInput").on("change", function (event) {
        const dataGrid = $("#dataGrid").dxDataGrid("instance");
        const file = event.target.files[0];

        if (file) {
            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    // Parse the JSON string from the file
                    const layout = JSON.parse(e.target.result);

                    // Restore the grid state
                    dataGrid.state(layout);
                } catch (error) {
                    console.error("Error parsing JSON:", error);
                    alert("Failed to load layout. Please ensure the file is valid JSON.");
                }
            };

            // Read the file as text
            reader.readAsText(file);
        }
    });
     
    function addStock() {
        var url = `/${tenantName}/ERM/AddNewProperty?mode=add`;
        window.location.href = url;
    }

    function DoucumentExpiry() {
        var url = `/${tenantName}/ERM/DocumentExpiryDetails`;
        window.location.href = url;
    }

    function EqrevenueCostsum() {
        var url = `/${tenantName}/ERM/EquipmentRevenueCostSummary`;
        window.location.href = url;
    }

    function ReportonCost() {
        var url = `/${tenantName}/ERM/EquipmentsRevenue&CostDetails`;
        window.location.href = url;
    }

    function refreshGrid() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.refresh();
    }

    function DiscontinuedClick() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.clearFilter();
        grid.filter(["IsDiscontinued", "=", true]);  
    }

    function AllitemsClick() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.clearFilter();  
    }

    function UseClick() {
        const grid = $("#dataGrid").dxDataGrid("instance");
        grid.clearFilter();
        grid.filter(["IsDiscontinued", "=", false]);  
    }



    
