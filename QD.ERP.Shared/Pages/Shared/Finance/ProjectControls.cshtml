<!-- Dropdown Header -->
<div style="margin-bottom: 15px;">
    @(Html.DevExtreme().SelectBox()
        .ID("screenSelector8")
        .Placeholder("Screen / Form / Modules") // Placeholder text
        .SearchEnabled(false) // Makes it look like a classic dropdown
        .ShowClearButton(true) // Optional: show clear button
        .Width(300)
        )
</div>


<!-- ERP Master Grid -->
<div id="erpMasterGridContainer">
    @(Html.DevExtreme().DataGrid()
        .ID("erpMasterGrid8")
        .SearchPanel(s => s.Visible(false)
        .HighlightSearchText(true))
        .FilterRow(f => f.Visible(false))
        .HeaderFilter(h => h.Visible(false))
        .ShowBorders(true)
        .ColumnAutoWidth(true)
        .HoverStateEnabled(true)
        .Height(600)
        .Columns(columns =>
        {
            columns.Add().DataField("Item").Caption("Item#").Width(60);
            columns.Add().DataField("Name").Caption("Item Name");
            columns.Add().DataField("Description").Caption("Item Description");
            columns.Add().DataField("EnableAccess").Caption("Enable Access").CellTemplate(@<text>
        <input type="checkbox" class="row-checkbox" data-claimrefno="<%= data.ClaimRefNo %>" onclick="highlightRow(this)" />
    </text>);

        })
        )
</div>



