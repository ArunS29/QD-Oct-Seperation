@page
@model QD.ERP.Shared.Areas.Security.Pages.LicenseActivationModel
@{
    ViewData["Title"] = "License Activation Required";
    Layout = null;
}

<h2>License Activation Required</h2>

<div style="border: 1px solid #f44336; background-color: #ffebee; padding: 20px; max-width: 600px; margin: 30px auto; border-radius: 5px; font-family: Arial, sans-serif;">
    <p style="font-size: 1.2rem; color: #b71c1c;">
        Your license has expired or is not activated.
    </p>
    <p>
        Please contact support or your administrator to activate your license and continue using the application.
    </p>
    <p>
        <a href="mailto:support@example.com" style="color: #d32f2f; text-decoration: underline;">Contact Support</a>
    </p>
</div>
