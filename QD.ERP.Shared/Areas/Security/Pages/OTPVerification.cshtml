@page
@model QD.ERP.Shared.Areas.Security.Pages.OTPVerificationModel
@{
    ViewData["Title"] = "OTP Verification";
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/jquery.idle.js"></script>
<script src="~/js/jwt-decode.min.js"></script>
<style>
        .text-weak {
            color: red;
        }

        .text-moderate {
            color: orange;
        }

        .text-strong {
            color: green;
        }
    </style>


    <div class="container mt-5">
        <div class="card">
            <div class="card-header">
                <h2>OTP Verification and Reset Password</h2>
            </div>
            <div class="card-body">
                <form id="resetPasswordForm" method="post">
                    <div class="mb-3">
                        <label for="otp" class="form-label">OTP</label>
                        <input type="text" class="form-control" id="otp" name="otp" required />
                    </div>

                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" required />
                        <small id="passwordHelp" class="form-text text-muted">
                            Your password must be at least 8 characters long, contain one uppercase letter, one number, and one special character.
                        </small>
                        <div id="passwordStrength" class="mt-2"></div>
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required />
                        <div class="text-danger" id="passwordMismatchError" style="display:none;">
                            Passwords do not match.
                        </div>
                    </div>

                    <div class="">
                        <button type="submit" class="btn btn-primary" id="submitBtn">Submit</button>
                        <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
                    <button type="button" class="btn btn-success" id="btnhome">Home</button>

                    </div>
                </form>
            </div>
        </div>
    </div>

<script>
    $(document).ready(function () {

        $('#btnhome').on('click', function () {
            var tenantName = "@Model.TenantName";
            window.location.href = `/${tenantName}/Security/Login`;
        });
        // Password strong validation regex
        var passwordRegex = /^(?=.*[A-Z])(?=.*\d)(?=.*[$!%*?&])[A-Za-z\d$!%*?&]{8,}$/;

        // On form submit, validate OTP and passwords
        $('#resetPasswordForm').on('submit', function (e) {
            e.preventDefault();

            // Get values from fields
            var getotp = $('#otp').val();
            var newPassword = $('#newPassword').val();
            var confirmPassword = $('#confirmPassword').val();

            // Check if passwords match
            if (newPassword !== confirmPassword) {
                $('#passwordMismatchError').show();
                return;
            }

            // Check if password meets strength criteria
            var strength = getPasswordStrength(newPassword);
            if (strength < 4) {
                showErrorMessage('Password is not strong enough. Please follow the guidelines.');
                return;
            }

            // If everything is fine, submit form (simulated here with an alert)
            var userId = sessionStorage.getItem('UserId');
            var password = document.getElementById('confirmPassword').value;
            var tenantName = "@Model.TenantName";
            const resetpassword = true;
            var otp = getotp;

            $.ajax({
                url: `/api/Login/SignIn`, // API endpoint
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Username: userId,
                    Password: password,
                    TenantName: tenantName,
                    ResetPassword: resetpassword,
                    otp: otp
                }),
                success: function (data) {
                    if (data.success) {
                        window.location.href = `/@Model.TenantName/Security/Login`;
                    } else {
                        showErrorMessage(data.message); // Show error message from response
                    }
                },
                error: function (xhr, status, error) {
                    var response = JSON.parse(xhr.responseText);
                    showErrorMessage(response.message); // Show error message from response
                }
            });
        });

        // Cancel button logic
        $('#cancelBtn').on('click', function () {
            // Clear form inputs
            $('#resetPasswordForm')[0].reset();
            $('#passwordMismatchError').hide();
        });

        // Password strength validation on input event
        $('#newPassword').on('input', function () {
            var password = $(this).val();
            var strength = getPasswordStrength(password);
            var strengthText = '';

            if (strength < 2) {
                strengthText = '<span class="text-weak">Weak</span>';
            } else if (strength < 4) {
                strengthText = '<span class="text-moderate">Moderate</span>';
            } else {
                strengthText = '<span class="text-strong">Strong</span>';
            }

            $('#passwordStrength').html('Password Strength: ' + strengthText);

            // Validate strong password
            if (strength < 4) {
                showErrorMessage('Password is not strong enough. Please follow the guidelines.');
            } else {
                hideErrorMessage();
            }
        });

        function getPasswordStrength(password) {
            var strength = 0;
            if (password.length >= 8) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;
            if (/[^A-Za-z0-9]/.test(password)) strength++;
            return strength;
        }

        function showErrorMessage(message) {
            var errorMessage = $('#passwordMismatchError');
            errorMessage.text(message);
            errorMessage.show();
        }

        function hideErrorMessage() {
            var errorMessage = $('#passwordMismatchError');
            errorMessage.hide();
        }
    });
</script>





