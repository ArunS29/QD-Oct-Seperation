@page
@model QD.ERP.Finance.Areas.Finance.Pages.DatabaseMasterModuleModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Goods and Services</title>
    <style>
        .dx-fieldset {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
            padding: 15px;
            background-color: #e6eef7;
            width: 1200px;


        }

        .dx-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
            align-items: end;
        }

        .field-label {
            font-weight: bold;
        }

        .aligned-input {
            width: 100%;
        }

        .dx-card {
            padding: 20px;
            background-color: #e6eef7;
            width: 90%;
            margin: auto;
            border-radius: 8px;
        }

        .input-group {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dx-textarea {
            width: 100%;
            height: 1000px;
        }
        .dx-card{
            width : 1460px;
        }
         
        .limited-footer .btn-container:not(:has(#btnSave,#btnSaveAndClose,#btnPrint1,#btnDelete,#btnBack)) {
            display: none !important;
        }

        .icon-button .dx-button-content {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0;
        }

        .icon-button {
            border-radius: 50% !important;
        }


            .icon-button .dx-button-content {
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 0;
            }

        .icon-button {
            border-radius: 50% !important;
        }

        .container {
            display: none !important;
        }

        .frame {
            display: none !important;
        }

        .footerContainer {
            display: none !important;
        }

        .bodyContainer {
            display: flex;
            justify-content: center;
        }

        .mainContainer {
            margin-top: 1em;
        }

        .playIcon {
            display:  none;

        }

        .heightTextArea{
            height:100px !important;
        }

        .custom-textarea .dx-texteditor-input {
            overflow-y: auto; /* Enables vertical scrollbar */
            resize: vertical; /* Allows manual resize (optional) */
            min-height: 150px;
            line-height: 1.5;
        }

    </style>
   
</head>
<body>
    <div class="dx-card">

        <div id="goodsServicesForm">
            <!-- Your entire form HTML here -->
     
        <h3>Goods and Services</h3>
        <!-- Row 1: Goods Code | Goods Group | Item Part No -->
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td>
                            <label class="field-label">Goods & Services Code:</label>
                                @(Html.DevExtreme().TextBox()
                                    .ID("txtGoodsCode7")
                                    .Width("80%")
                                    .ValidationRules(rules =>
                                    {
                                        rules.AddRequired().Message("Goods Code is required");
                                    })
                                    )
                                
                        </td>
                            <td>
                                <label class="field-label">Goods & Services Group:</label>
                                <div style="display: flex; align-items: center; gap: 5px;">
                                    @(Html.DevExtreme().DropDownBox()
                                        .DataSource(d => d.WebApi()
                                        .Controller("VATModule")
                                        .LoadAction("GetGoodsAndServicesGroups")
                                        .LoadMode(DataSourceLoadMode.Raw)
                                        .Key("GsgroupId"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        .ID("ddlGoodsGroup1")
                                        .ShowClearButton(true)
                                        .AcceptCustomValue(true)
                                        .OpenOnFieldClick(false)
                                        .ValueChangeEvent("input")
                                        .OnValueChanged("onGoodsGroupChanged")
                                        .HoverStateEnabled(true)
                                        .ValueExpr("GsgroupId")
                                        .DisplayExpr("GsgroupName")
                                        .OnInput("dropDownBoxOnInput")
                                        .OnOpened("onOpened")
                                        .DropDownOptions(o => o.Width(1000))
                                        .ContentTemplate(new TemplateName("GoodsandServicesContentTemplate"))
                                        .Width("70%") // Full width inside the flex container
                                        )

                                   @*  @(Html.DevExtreme().Button()
                                        .ID("btnAddGroup3")
                                        .Icon("plus")
                                        .Width(30) // Optional: fix width
                                        .Height(30))  *@

                                    @(Html.DevExtreme().Button()
                                        .ID("btnAddUOM1")
                                        .Icon("plus")
                                        .Hint("Add Unit")
                                        .Width(40)
                                        .Height(40)
                                        .StylingMode(ButtonStylingMode.Contained)
                                        .ElementAttr(new
                                        {
                                            @class = "icon-button"
                                        })
                                        .OnClick("function() { redirectToVATMasterModule(); }") // ✅ Call separate function
                                        )
                                </div>
                            </td>

                            
                        
                        <td>
                            <label class="field-label">Item Part No:</label>
                            @(Html.DevExtreme().TextBox().ID("txtItemPartNo4").Width("70%"))
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <!-- Row 2: Description | Description (Arabic) -->
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td >

                                @(Html.DevExtreme().TextArea()
                                    .Label("Goods & Services Description:")
                                    .LabelMode(EditorLabelMode.Floating)
                                    .ID("txtDescription8")
                                    .Width("100%")
                                    .Height(150) // Adjust height here for scrollbar to appear
                                    .ElementAttr(new { @class = "custom-textarea heightTextArea" })
                                    .ValidationRules(rules =>
                                    {
                                        rules.AddRequired().Message("Description is required");
                                    })
                                    )

                        </td>
                        <td style="width:0%;padding:1em;">
                                @(Html.DevExtreme().Button()
                                    .ID("convertToArabicDesc")
                                    .Icon("fas fa-language")
                                    .ElementAttr(new { @class = "input-button" })
                                    .OnClick("function() { convertDescriptionToArabic(); }")
                                    )
                        </td>
                            <td>
                                @(Html.DevExtreme().TextBox()
                                .Label(new JS("formatMessage('Goods & Services Description (in Arabic):')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("txtDescriptionArabic").Width("100%")
                                    .ElementAttr(new { @class = "heightTextArea" }))
                                
                            </td>
                    </tr>
                </table>
            </div>
        </div>
        
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                            <td>
                                <div style="display: flex; align-items: end; gap: 8px; margin-right:10px;">
                                    @(Html.DevExtreme().DropDownBox()
                                        .Label(new JS("formatMessage('Unit of Measure:')"))
                                        .LabelMode(EditorLabelMode.Floating)
                                        .ID("ddlUnitMeasure9")
                                        .Width("100%")
                                        .DataSource(d => d.WebApi()
                                        .Controller("VATModule")
                                        .LoadAction("GetUnitofMeasure")
                                        .LoadMode(DataSourceLoadMode.Raw)
                                        .Key("UnitCode")
                                        )
                                        .LabelMode(EditorLabelMode.Floating)
                                        .ShowClearButton(true)
                                        .AcceptCustomValue(true)
                                        .OpenOnFieldClick(false)
                                        .ValueChangeEvent("input")
                                        .HoverStateEnabled(true)
                                        .ValueExpr("UnitCode")
                                        .DisplayExpr("UnitType")
                                        .OnInput("dropDownBoxOnInput")
                                        .OnOpened("onOpened")
                                        .OnValueChanged("onUnitMeasureValueChanged")
                                        .DropDownOptions(o => o.Width(400))
                                        .ContentTemplate(new TemplateName("UnitofMeasureContentTemplate"))
                                        .Width("100%") // Keep DropDownBox at 85% width
                                        )

                                    @(Html.DevExtreme().Button()
                                        .ID("btnAddUOM")
                                        .Icon("plus")
                                        .Hint("Add Unit")
                                        .Width(50)
                                        .Height(40)
                                        .StylingMode(ButtonStylingMode.Contained)
                                        .ElementAttr(new
                                        {
                                            @class = "icon-button"
                                        })
                                        .OnClick("function() { redirectToVATMasterModule(); }") // ✅ Call separate function
                                        )


                                </div>
                            </td>

                        <td colspan="3">
                            @(Html.DevExtreme().NumberBox()
                                .ID("packingUnit")
                                .Label(new JS("formatMessage('Packing Unit:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .Value(1) // default
                                .Min(1)
                                .Step(1)
                                .ShowSpinButtons(true)
                                .Format("#") // no decimals
                                .Width("76%")
                                )
                        </td>

                        <td>
                            @(Html.DevExtreme().NumberBox()
                                .Label(new JS("formatMessage('Selling Rate:')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("sellingRate")
                                .Value(1)
                                .Min(1)
                                .Step(1)
                                .ShowSpinButtons(true)
                                .Format("#") // no decimals
                                    .Width("100%")
                                )
                        </td>

                        <td>
                            @(Html.DevExtreme().NumberBox()
                                .LabelMode(EditorLabelMode.Floating)
                                .Label(new JS("formatMessage('Cost Price:')"))
                                .ID("txtCostPrice3")
                                .Value(1)
                                .Min(1)
                                .Step(1)
                                .ShowSpinButtons(true)
                                .Format("#") // no decimals
                                .Width("100%")
                                )
                        </td>

                    </tr>
                </table>
            </div>
        </div>
        <!-- Row 4: Detailed Description | Detailed Description (Arabic) -->
        <div class="dx-fieldset">
            <div class="dx-field">
                <table style="width: 1300px;">
                    <tr>
                        <td>
                            @(Html.DevExtreme().TextArea()
                            .Label(new JS("formatMessage('Detailed Description:')"))
                            .LabelMode(EditorLabelMode.Floating)
                            .ID("txtDetailedDescription")
                            .ElementAttr(new { @class = "heightTextArea" })
                            .Width("100%").Height(80))
                        </td>
                        
                            <td style="width:0%;padding:1em;">
                                    @(Html.DevExtreme().Button()
                                        .ID("convertToArabicDesc1")
                                        .Icon("fas fa-language")
                                        .ElementAttr(new { @class = "input-button" })
                                    .OnClick("function() { convertDetailedDescToArabic(); }")
                                        )
                            </td>
                        
                            <td style="display:flex;">
                                @(Html.DevExtreme().TextBox()
                                .Label(new JS("formatMessage('Detailed Description (in Arabic):')"))
                                .LabelMode(EditorLabelMode.Floating)
                                .ID("txtDetailedDescriptionArabic")
                                .ElementAttr(new { @class = "heightTextArea" })
                                .Width("100%").Height(80))
                                
                            </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="Head">
            <div class="limited-footer">
                @await Html.PartialAsync("VATModuleFooter")
            </div>
        </div>
    </div>

    @using (Html.DevExtreme().NamedTemplate("GoodsandServicesContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("accounthead-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("VATModule")
            .LoadAction("GetGoodsAndServicesGroups")
            .LoadMode(DataSourceLoadMode.Raw)
            .Key("GsgroupId")
            )
            .WordWrapEnabled(true)
            .ShowBorders(true)
            .SearchPanel(sp => sp.HighlightSearchText(true))
            .Selection(sl => sl.Mode(SelectionMode.Single))
            .OnSelectionChanged("dataGridAccountHeadSelectionChanged")
            .OnInitialized("dataGridAccountHeadInitialized")
            .HoverStateEnabled(true)
            .Paging(p => p.PageSize(15))
            .FilterRow(f => f.Visible(true))
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .Height(345)
            .Selection(s => s.Mode(SelectionMode.Single))
            .SelectedRowKeys(new JS(@"component.option(""value"") ? [component.option(""value"")] : []"))
            .Columns(columns =>
            {
               

                columns.Add().DataField("GsgroupId")
                .Caption(new JS("formatMessage('Group')"))
                .Lookup(lookup => lookup
                .DataSource(ds => ds.WebApi()
                .Controller("VATModule")
                .LoadAction("GetGoodsAndServicesGroups") // You must implement this
                .Key("GsgroupId")
                )
                .ValueExpr("GsgroupId")
                .DisplayExpr("GsgroupName")
                );

               
            })
            )
    }

    @using (Html.DevExtreme().NamedTemplate("UnitofMeasureContentTemplate"))
    {
        @(Html.DevExtreme().DataGrid()
            .ID("unitofmeasure-datagrid")
            .DataSource(d => d.WebApi()
            .Controller("VATModule")
            .LoadAction("GetUnitofMeasure")

            .LoadMode(DataSourceLoadMode.Raw)
            .Key("UnitCode")
            )
            .Selection(s => s.Mode(SelectionMode.Single))
            .HoverStateEnabled(true)
       
            .FilterRow(f => f.Visible(false))
            .Height(345)
            .Width("100%")
            .Scrolling(s => s.Mode(GridScrollingMode.Virtual))
            .OnSelectionChanged("onUnitMeasureSelectionChanged")
            .Columns(columns =>
            {
             
                columns.Add().DataField("UnitType").Caption("Type");
             
            })
            .WordWrapEnabled(true)
            .ShowBorders(true)
            )
    }



    </div>
    
</body>
</html>
<script>

    function redirectToVATMasterModule() {
        const url = `/${tenantName}/Finance/VATMasterModule`;
        const title = "VAT Master Module";

        openModal(url, title);
    }



    function onUnitMeasureSelectionChanged(e) {
        const selected = e.selectedRowsData[0];
        if (selected) {
            const dropDownBox = $("#ddlUnitMeasure9").dxDropDownBox("instance");
            dropDownBox.option("value", selected.UnitCode); 
        }
    }
    function onUnitMeasureValueChanged(e) {
        const value = e.value;
        const component = e.component;

      
        const selected = component.option("selectedItem");

        if (selected && selected.UnitName) {
            $("#txtUnitName").dxTextBox("instance").option("value", selected.UnitName);
        } else {
          
            const dataSource = component.getDataSource();
            dataSource.load().done(function (items) {
                const match = items.find(x => x.UnitCode === value);
                if (match) {
                    console.log("Manually matched item:", match);
                    $("#txtUnitName").dxTextBox("instance").option("value", match.UnitName);
                } else {
                    console.warn("Could not find matching item for value:", value);
                }
            });
        }
    }

      

     function dropDownBoxOnInput(e) {
                const ddbInstance = e.component;
                if (!ddbInstance.option("opened")) ddbInstance.open();


                const text = ddbInstance.option("text");
                if (dataGrid) {
                    dataGrid.option("searchPanel.text", text);
                }
            }

             function onOpened(e) {
                setTimeout(() => {
                    e.component.focus();
                });
            }

               function dataGridAccountHeadSelectionChanged(e) {
                const selectedKey = e.selectedRowKeys[0];
                const ddbInstance = $("#ddlGoodsGroup1").dxDropDownBox("instance");
                acchead = selectedKey;
                if (selectedKey) {
                    ddbInstance.option("value", selectedKey);
                    if (ddbInstance.option("opened")) {
                        ddbInstance.close();
                    }
                    var selectedRowData = $("#accounthead-datagrid").dxDataGrid("instance").getSelectedRowsData();
                 
                    if (selectedRowData.length > 0) {
                        

                    } else {
                        DevExpress.ui.notify("Please select a row from the grid!", "error", 2000);
                        return;
                    }
                }
            }


            function dataGridAccountHeadInitialized(e) {
                dataGrid = e.component;
            }

    async function convertDescriptionToArabic() {
        const englishBox = $("#txtDescription8").dxTextArea("instance");
        const arabicBox = $("#txtDescriptionArabic").dxTextBox("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

    async function convertDetailedDescToArabic() {
        const englishBox = $("#txtDetailedDescription").dxTextArea("instance");
        const arabicBox = $("#txtDetailedDescriptionArabic").dxTextBox("instance");

        if (!englishBox || !arabicBox) {
            console.error("TextBox/TextArea not initialized.");
            return;
        }

        const englishText = englishBox.option("value");

        if (!englishText || englishText.trim() === "") {
            alert("Please enter a detailed description to translate.");
            return;
        }

        try {
            const translatedText = await translateToArabic(englishText);
            arabicBox.option("value", translatedText);
        } catch (error) {
            console.error("Translation failed", error);
            alert("Translation failed. Please try again.");
        }
    }

 
