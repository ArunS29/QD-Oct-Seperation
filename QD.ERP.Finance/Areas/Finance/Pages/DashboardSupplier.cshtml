@page
@model QD.ERP.Finance.Areas.Finance.Pages.DashboardSupplierModel

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<!-- Page Loader Overlay -->
<div id="dashboardPageLoader" style="position:fixed;z-index:9999;top:0;left:0;width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.7)">
    <img src="/images/dicerol.gif" alt="Loading..." style="height:150px;">
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.umd.min.js"></script>
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/latest/css/dx.common.css">
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/latest/css/dx.light.css">
<script src="https://cdn3.devexpress.com/jslib/latest/js/dx.all.js"></script>
<script src="https://cdn3.devexpress.com/jslib/latest/js/dx.viz.js"></script>

<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<div class="dashboard-card-header">Supplier Outstanding Details</div>


<!-- Enhanced Summary Cards Container -->
<div class="dx-card-container">
    <div class="Popupcard enhanced-card" id="clientcard">
        <div class="enhanced-header">Total Client Outstanding</div>
        <div class="enhanced-content">
            <span class="card-loader" id="loaderClientOutstanding" style="display:none;">
                <img src="/images/dicerol.gif" alt="Loading..." style="height:16px;">
            </span>
            <div id="totalClientOutstandingValue" class="enhanced-value">--</div>
        </div>
    </div>

    <div class="Popupcard enhanced-card" id="DashboardBankAccount">
        <div class="enhanced-header">Total Cash Balance</div>
        <div class="enhanced-content">
            <span class="card-loader" id="loaderCashBalance" style="display:none;">
                <img src="/images/dicerol.gif" alt="Loading..." style="height:16px;">
            </span>
            <div id="cashBalanceValue" class="enhanced-value">--</div>
        </div>
    </div>

    <div class="Popupcard enhanced-card" id="SupplierCard">
        <div class="enhanced-header">Total Supplier Outstanding</div>
        <div class="enhanced-content">
            <span class="card-loader" id="loaderBillsOutstanding" style="display:none;">
                <img src="/images/dicerol.gif" alt="Loading..." style="height:16px;">
            </span>
            <div id="totalBillsOutstandingValue" class="enhanced-value">--</div>
        </div>
    </div>
</div>
<div class="dashboard-main-container">
    <div class="data-table-card">
        <div class="card-title"><span id="SupplierOutstanding"></span></div>
        <div id="billsPayableGrid"></div>
    </div>
    <div class="chart-card">
        <div class="card-title"><span id="SupplierOutstandingAgingChart"></span></div>
        <div class="chart-toolbar">
            <button id="fullScreenChart" title="Full Screen"><span style="font-size:18px;">⛶</span></button>
            <button id="resetZoom" title="Reset Zoom">🔄</button>
            <button id="downloadChart" title="Download PNG">⬇️</button>
        </div>
        <div id="chartFullScreenWrapper">
            <canvas id="billsOutstandingChart"></canvas>
        </div>
    </div>
</div>
<h2>Bills Payable Outstanding Supplier Chart</h2>

<!-- Loader -->
<div id="loader" style="display: flex; align-items: center; justify-content: center; height: 300px;">
    <img src="/images/dicerol.gif" alt="Loading..." style="height: 100px;" />
</div>

<!-- Chart Containers -->
<div style="display: flex; flex-wrap: wrap; justify-content: space-around; gap: 30px;">
    <div id="barChartContainer" style="width: 48%; min-width: 400px; height: 500px; display: none;"></div>
    <div id="donutChartContainer" style="width: 48%; min-width: 400px; height: 500px; display: none;"></div>
</div>

<!-- DevExtreme Scripts -->
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.light.css">
<script src="https://cdn3.devexpress.com/jslib/23.2.5/js/dx.all.js"></script>

<script>
let billsOutstandingChartInstance = null;
let allChartData = [];
let isFullScreen = false;

$(document).ready(function () {
    $("#dashboardPageLoader").show();
    let pendingLoads = [];

    // SUMMARY CARDS AJAX
    const apiEndpoints = [
        { url: "/api/Dashboard/supplieroutstanding", target: "#totalBillsOutstandingValue", loader: "#loaderBillsOutstanding", key: "balance" },
        { url: "/api/Dashboard/GetTotalClientOutstanding", target: "#totalClientOutstandingValue", loader: "#loaderClientOutstanding", key: "balance" },
        { url: "/api/Dashboard/GetCashBalance", target: "#cashBalanceValue", loader: "#loaderCashBalance", key: "balance" }
    ];
    apiEndpoints.forEach(endpoint => {
        $(endpoint.loader).show();
        let p = $.getJSON(endpoint.url)
            .done(response => {
                if (response.success) {
                    $(endpoint.target).text(response[endpoint.key].toLocaleString('en-US'));
                }
            })
            .always(() => $(endpoint.loader).hide());
        pendingLoads.push(p);
    });

    // DATAGRID
    function loadbillsPayableGrid() {
        let deferred = $.Deferred();
        $("#billsPayableGrid").dxDataGrid({
            dataSource: {
                load: function () {
                    return $.ajax({
                        url: "/api/Dashboard/GetBillsPayableOutstandingSupplier",
                        dataType: "json"
                    }).then(function (response) {
                        deferred.resolve();
                        return response.data;
                    });
                }
            },
            columns: [
                { dataField: "AccountHead", caption: "Account Head", width: 190, allowReordering: true,
                    headerCellTemplate: function (header, info) {
                        $("<div>").text(info.column.caption).css({"text-align":"center","font-weight":"bold"}).appendTo(header);}
                },
                { dataField: "Balance", caption: "Balance Amount", format: {type: "fixedPoint", precision: 2}, allowReordering: true,
                    headerCellTemplate: function (header, info) {
                        $("<div>").text(info.column.caption).css({"text-align":"center","font-weight":"bold"}).appendTo(header);}
                },
                {
                    caption: "Trend",
                    width: 110,
                    allowExporting: false,
                    cellTemplate: function(container, options) {
                        var trend = options.data.BalanceHistory ||
                            [
                                options.data.Balance * 0.7,
                                options.data.Balance * 0.85,
                                options.data.Balance * 0.95,
                                options.data.Balance
                            ];
                        $("<div>").dxSparkline({
                            dataSource: trend,
                            type: "line",
                            showMinMax: true,
                            minColor: "#e91e63",
                            maxColor: "#1976d2",
                            lineColor: "#0088cc",
                            pointSize: 3,
                            size: { width: 80, height: 28 }
                        }).appendTo(container);
                    }
                },
                { dataField: "OverdueDays", caption: "Overdue Days", visible: false, allowHiding: true },
                { dataField: "AccountGroupId", caption: "Account Group", visible: false, allowHiding: true },
                { dataField: "AccountHeadNo", caption: "Account Head No", visible: false, allowHiding: true }
            ],
            columnAutoWidth: true,
            showBorders: false,
            filterRow: { visible: true },
            paging: { enabled: true, pageSize: 15 },
            pager: { visible: true, showPageSizeSelector: true, allowedPageSizes: [10, 15, 20], showInfo: true },
            height: 500,
            width: "100%",
            scrolling: { mode: "virtual" },
            searchPanel: { visible: true },
            allowColumnReordering: true,
            allowColumnResizing: true,
            columnChooser: { enabled: true, mode: "select" },
            loadPanel: { enabled: true },
            summary: {
                totalItems: [
                    { column: "Balance", summaryType: "sum", valueFormat: {type: "fixedPoint", precision: 2}, displayFormat: "Total : {0}" },
                    { column: "AccountHead", summaryType: "count", displayFormat: "Count : {0}" }
                ]
            }
        });
        return deferred.promise();
    }
    pendingLoads.push(loadbillsPayableGrid());

    // CHART AJAX
    let chartLoad = $.ajax({
        url: '/api/Dashboard/GetBillsPayableOutstandingSupplierChart',
        type: 'GET'
    }).done(function (result) {
        if (result.success) {
            allChartData = result.data || [];
            renderBillsOutstandingChart(allChartData);
        }
    });
    pendingLoads.push(chartLoad);

    // ---- Retina/High Quality Chart ----
    function setChartCanvasSize(isFullScreen) {
        const dpr = window.devicePixelRatio || 1;
        let displayWidth, displayHeight;
        if (isFullScreen) {
            displayWidth = Math.floor(window.innerWidth * 0.97);
            displayHeight = Math.floor(window.innerHeight * 0.90);
        } else {
            displayWidth = 850;
            displayHeight = 650;
        }
        const canvas = document.getElementById('billsOutstandingChart');
        canvas.width = displayWidth * dpr;
        canvas.height = displayHeight * dpr;
        canvas.style.width = displayWidth + "px";
        canvas.style.height = displayHeight + "px";
    }

    // Render the chart, always call setChartCanvasSize first!
    function renderBillsOutstandingChart(data) {
        setChartCanvasSize(isFullScreen);

        // Top 10 + Others logic
        const sorted = [...data].sort((a, b) => {
            const balA = a.TotalBalance ?? a.Balance ?? 0;
            const balB = b.TotalBalance ?? b.Balance ?? 0;
            return balB - balA;
        });
        const topN = 10;
        const top = sorted.slice(0, topN);
        const others = sorted.slice(topN);

        let labels = top.map(x => x.AccountHead ?? "Unknown");
        let balances = top.map(x => x.TotalBalance ?? x.Balance ?? 0);

        if (others.length > 0) {
            const othersBalance = others.reduce((sum, x) => sum + (x.TotalBalance ?? x.Balance ?? 0), 0);
            labels.push("Others");
            balances.push(othersBalance);
        }

        const ctx = document.getElementById('billsOutstandingChart').getContext('2d');
        if (billsOutstandingChartInstance) billsOutstandingChartInstance.destroy();
        billsOutstandingChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Outstanding Balance',
                    data: balances,
                    backgroundColor: labels.map(l => l === "Others" ? "#e68a00" : "#007acc"),
                    borderColor: labels.map(l => l === "Others" ? "#e68a00" : "#007acc"),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: false,
                devicePixelRatio: window.devicePixelRatio || 1,
                plugins: {
                    zoom: {
                        zoom: {
                            wheel: { enabled: true },
                            pinch: { enabled: true },
                            drag: { enabled: true },
                            mode: 'xy'
                        },
                        pan: { enabled: true, mode: 'xy' }
                    },
                    legend: {
                        display: true,
                        labels: { font: { size: 15, family: 'Inter' } }
                    },
                    tooltip: {
                        enabled: true,
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ": ₹" + context.parsed.y.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    y: { beginAtZero: true, title: { display: true, text: 'Balance (SAR)' }, ticks: { font: { family: "Inter" } } },
                    x: { title: { display: true, text: 'Account Head' }, ticks: { font: { family: "Inter" }, autoSkip: false } }
                }
            }
        });
    }

    // ---- Chart Toolbar ----
    $("#resetZoom").on("click", function() {
        if (billsOutstandingChartInstance) billsOutstandingChartInstance.resetZoom();
    });

    $("#downloadChart").on("click", function() {
        // Export high-res chart (always as if in fullscreen)
        setChartCanvasSize(true);
        if (billsOutstandingChartInstance) billsOutstandingChartInstance.resize();
        setTimeout(function() {
            let url = billsOutstandingChartInstance.toBase64Image();
            let a = document.createElement('a');
            a.href = url;
            a.download = 'SupplierOutstandingChart.png';
            a.click();
            // Restore canvas size after download if not in fullscreen
            setChartCanvasSize(isFullScreen);
            if (billsOutstandingChartInstance) billsOutstandingChartInstance.resize();
        }, 60);
    });

    $("#fullScreenChart").on("click", function () {
        let $wrapper = $("#chartFullScreenWrapper");
        isFullScreen = !isFullScreen;
        if (isFullScreen) {
            $wrapper.addClass("fullscreen");
        } else {
            $wrapper.removeClass("fullscreen");
        }
        setChartCanvasSize(isFullScreen);
        setTimeout(() => {
            if (billsOutstandingChartInstance) billsOutstandingChartInstance.resize();
        }, 80);
    });

    // HIDE LOADER WHEN ALL READY
    $.when.apply($, pendingLoads).always(function () {
        setTimeout(function () {
            $("#dashboardPageLoader").fadeOut(200);
        }, 120);
    });

    // CARD NAV
    $("#clientcard").on("click", function () {
        window.location.href = `/${tenantName}/Finance/DashboardClient`;
    });
    $("#SupplierCard").on("click", function () {
        window.location.href = `/${tenantName}/Finance/DashboardSupplier`;
    });
    $("#DashboardBankAccount").on("click", function () {
        window.location.href = `/${tenantName}/Finance/DashboardBankAccount`;
    });

    // HEADINGS
    $("#TotalClientOutstanding").dxTextBox({
        text: "Total Client Outstanding", readOnly: true,
        onContentReady: function(e) { $(e.element).addClass("dx-textbox-heading10"); }
    });
    $("#TotalCashBalance").dxTextBox({
        text: "Total Cash Balance", readOnly: true,
        onContentReady: function(e) { $(e.element).addClass("dx-textbox-heading10"); }
    });
    $("#TotalSupplierOutstanding").dxTextBox({
        text: "Total Supplier Outstanding", readOnly: true,
        onContentReady: function(e) { $(e.element).addClass("dx-textbox-heading10"); }
    });
    $("#SupplierOutstanding").dxTextBox({
        text: "Supplier Outstanding", readOnly: true,
        onContentReady: function(e) { $(e.element).addClass("dx-textbox-heading10"); }
    });
    $("#SupplierOutstandingAgingChart").dxTextBox({
        text: "Supplier Outstanding Aging Chart", readOnly: true,
        onContentReady: function(e) { $(e.element).addClass("dx-textbox-heading10"); }
    });
});

  document.addEventListener('DOMContentLoaded', function () {
        const loader = document.getElementById('loader');
        const barContainer = document.getElementById('barChartContainer');
        const donutContainer = document.getElementById('donutChartContainer');

        fetch('/api/Dashboard/GetBillsPayableOutstandingSupplierChart')
            .then(response => response.json())
            .then(result => {
                loader.style.display = 'none';

                if (!result.success || !result.data || result.data.length === 0) {
                    barContainer.innerHTML = "<p style='color:red;'>No data available</p>";
                    donutContainer.innerHTML = "<p style='color:red;'>No data available</p>";
                    barContainer.style.display = 'block';
                    donutContainer.style.display = 'block';
                    return;
                }

                const sortedData = result.data.sort((a, b) => b.Balance - a.Balance);
                const top10 = sortedData.slice(0, 10);
                const others = sortedData.slice(10);
                const otherTotal = others.reduce((sum, item) => sum + item.Balance, 0);

                // Show Bar Chart (Top 10)
                barContainer.style.display = 'block';
                $("#barChartContainer").dxChart({
                    dataSource: top10,
                    series: [{
                        valueField: "Balance",
                        argumentField: "AccountHead",
                        name: "Top 10 Suppliers",
                        type: "bar",
                        color: "#3c8dbc"
                    }],
                    argumentAxis: {
                        label: {
                            rotationAngle: 45,
                            overlappingBehavior: "rotate"
                        }
                    },
                    valueAxis: {
                        title: "Amount"
                    },
                    legend: { visible: false },
                    tooltip: {
                        enabled: true,
                        format: { type: "currency", precision: 2 }
                    },
                    export: { enabled: true },
                    title: {
                        text: "Top 10 Suppliers - Bills Payable Outstanding",
                        font: { size: 16 }
                    },
                    animation: { enabled: true }
                });

                // Show Donut Chart (Others)
                donutContainer.style.display = 'block';
                const donutData = [...others.map(item => ({
                    AccountHead: item.AccountHead,
                    Balance: item.Balance
                }))];

                // Optional: Group all remaining as a single "Others" slice
                donutData.length = 0;
                donutData.push({
                    AccountHead: "Others",
                    Balance: otherTotal
                });

                $("#donutChartContainer").dxPieChart({
                    dataSource: donutData,
                    type: "doughnut",
                    palette: "Soft Pastel",
                    series: [{
                        argumentField: "AccountHead",
                        valueField: "Balance",
                        label: {
                            visible: true,
                            format: "fixedPoint",
                            precision: 2,
                            connector: { visible: true }
                        }
                    }],
                    tooltip: {
                        enabled: true,
                        format: { type: "currency", precision: 2 }
                    },
                    export: { enabled: true },
                    legend: {
                        orientation: "horizontal",
                        itemTextPosition: "right",
                        horizontalAlignment: "center",
                        verticalAlignment: "bottom"
                    },
                    title: {
                        text: "Others (Remaining Suppliers)",
                        font: { size: 16 }
                    }
                });

            })
            .catch(() => {
                loader.style.display = 'none';
                barContainer.innerHTML = "<p style='color:red;'>Error loading data</p>";
                donutContainer.innerHTML = "<p style='color:red;'>Error loading data</p>";
                barContainer.style.display = 'block';
                donutContainer.style.display = 'block';
            });
    });
</script>
<style>

.dx-card-container {
    display: flex; justify-content: center; gap: 20px; padding: 1em;
}
.enhanced-card {
    min-width: 260px;
    max-width: 340px;
    width: 100%;
    padding: 22px 24px 20px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-radius: 20px;
    box-shadow: 0 6px 20px rgba(0, 84, 179, 0.08);
    text-align: center;
    border: 1.5px solid rgba(231, 238, 250, 0.9);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.25s;
    cursor: pointer;
    overflow: hidden;
    position: relative;
    animation: fadeInUp 0.4s ease-in-out;
}

.enhanced-card:hover {
    transform: translateY(-8px) scale(1.015);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 10px 32px rgba(0, 84, 179, 0.18);
}

.enhanced-header {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: #004080;
    font-family: 'Inter', sans-serif;
}

.enhanced-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.enhanced-value {
    font-size: 2.4rem;
    font-weight: bold;
    color: #007acc;
    font-family: 'Inter', sans-serif;
    margin-top: 5px;
    transition: color 0.3s ease;
}

.enhanced-card:hover .enhanced-value {
    color: #004080;
}

.card-loader {
    display: block;
    margin: auto;
    padding-bottom: 8px;
}

/* Ripple Effect */
.ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(0, 123, 255, 0.25);
    transform: scale(0);
    animation: ripple 0.6s linear;
    pointer-events: none;
    z-index: 1;
}

@@keyframes ripple {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

/* Entry animation */
@@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive */
@@media (max-width: 768px) {
    .enhanced-value {
        font-size: 2rem;
    }
    .enhanced-header {
        font-size: 1rem;
    }
}
body {
    background: #f4f8fc;
}
.dashboard-card-header {
    text-align: center; font-size: 2.2rem; font-weight: 700; color: #004080;
    letter-spacing: 0.5px; padding: 24px 0 14px 0; margin-top: 10px; margin-bottom: 0;
    background: #f7fbff; border-radius: 14px 14px 0 0; font-family: 'Inter', sans-serif;
}
.dx-card-container {
    display: flex; justify-content: center; gap: 24px; padding: 1.5em 0 0 0;
}
.Popupcard {
    display: inline-block; min-width: 260px; padding: 22px 20px 15px 20px; background: #fff;
    border-radius: 14px; box-shadow: 0 3px 16px #ddeeff22, 0 1.5px 10px #c7daf833;
    text-align: center; transition: transform 0.2s, box-shadow 0.3s; cursor: pointer; border: 1.2px solid #e7eefe;
}
.Popupcard:hover {
    box-shadow: 0 6px 32px #a6d2ff44;
    transform: translateY(-6px) scale(1.015); background-color: #f5f9ff;
}
.dx-card-header { font-size: 1.15rem; font-weight: 600; margin-bottom: 8px; text-align: center; }
.dx-card-content .total-value { font-size: 2.2rem; font-weight: bold; color: #007acc; }
.dashboard-main-container {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: 34px; padding: 30px 10px 10px 10px;
    max-width: 1920px; margin: auto;
}
.data-table-card, .chart-card {
    background: #fff; border-radius: 14px; box-shadow: 0 3px 20px #e7eefe36, 0 1.5px 10px #b2d9fc22;
    padding: 26px 28px 24px 28px; min-width: 500px; min-height: 440px; max-width: 730px;
    flex: 1 1 600px; position: relative;
}
.chart-card {
    min-width: 670px; max-width: 1020px;
}
.card-title {
    font-size: 1.15rem; font-weight: 600; color: #286fb9; margin-bottom: 18px; font-family: 'Inter', sans-serif; text-align: left;
}
.chart-toolbar {
    position: absolute; top: 20px; right: 30px; z-index: 2;
}
.chart-toolbar button {
    margin-left: 4px; background: #f7fbff; border: 1px solid #eee; border-radius: 6px; cursor: pointer; font-size: 17px; padding: 4px 11px 3px 11px;
    transition: box-shadow .1s; font-family: 'Inter', sans-serif;
}
.chart-toolbar button:hover {
    background: #e6f0fa;
    box-shadow: 0 2px 6px #b7e4ff33;
}
#chartFullScreenWrapper.fullscreen {
    position: fixed !important;
    left: 0; top: 0; width: 100vw; height: 100vh; z-index: 9999;
    background: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 120px #0004;
}
#billsOutstandingChart {
    border-radius: 13px; box-shadow: 0 2px 16px #ddeeff22, 0 1.5px 10px #b2d9fc22;
    background: #fff; display: block; margin: 0 auto;
}
#dashboardPageLoader { display: none; }
select[multiple] {
    font-family: 'Inter', sans-serif; font-size: 15px;
}
::-webkit-scrollbar { width: 10px; background: #ecf1fa;}
::-webkit-scrollbar-thumb { background: #b1cbe5; border-radius: 8px;}
</style>
