        function onUpdateClick() {
        let grid = $("#dataGrid").dxDataGrid("instance");
        let rows = grid.getDataSource().items(); // get all rows

        if (!rows || rows.length === 0) {
            DevExpress.ui.notify("No data to update.", "warning", 3000);
            return;
        }

        let payload = rows.map(row => ({
            VoucherEntryNo: row.VoucherEntryNo,
            BankClearedOn: row.BankClearedOn ? new Date(row.BankClearedOn).toISOString() : null,
            PaymentStatus: row.PaymentStatus || null
        }));

        $.ajax({
            url: `/api/SalaryPayableMapping/UpdateBankClearedOnBulk`,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (response) {
                DevExpress.ui.notify("Bank Reconciliation updated successfully.", "success", 3000);
                Reloadgriddata();
            },
            error: function (xhr) {
                alert("Error updating BankClearedOn: " + xhr.responseText);
            }
        });
    }

    function onUpdatecloseClick() {
             let grid = $("#dataGrid").dxDataGrid("instance");
            let rows = grid.getDataSource().items(); // get all rows

            if (!rows || rows.length === 0) {
                DevExpress.ui.notify("No data to update.", "warning", 3000);
                return;
            }

            let payload = rows.map(row => ({
                VoucherEntryNo: row.VoucherEntryNo,
                BankClearedOn: row.BankClearedOn ? new Date(row.BankClearedOn).toISOString() : null,
                PaymentStatus: row.PaymentStatus || null
            }));

            $.ajax({
                url: `/api/SalaryPayableMapping/UpdateBankClearedOnBulk`,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (response) {
                    DevExpress.ui.notify("Bank Reconciliation updated successfully.", "success", 3000);
                         window.parent.closeModal();
                },
                error: function (xhr) {
                    alert("Error updating BankClearedOn: " + xhr.responseText);
                }
            });
    }

