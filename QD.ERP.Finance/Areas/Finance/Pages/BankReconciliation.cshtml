    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px;
    }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }

    .button-alignment-down {
        margin-bottom: 10px;
    }

    #Narration {
        overflow-y: auto;
        resize: none;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }

    #AccountHeadName {
        width: 250px;
    }

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }
</style>


