@page
@model QD.ERP.Finance.Areas.Finance.Pages.SalesProjectManagerListModel
@{
}

<style>
    .dx-fieldset {
        border: 1px solid #d3d3d3;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        background-color: #f8f9fa; /* Light background */
    }

    .dx-field .dx-fields {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }

        .dx-field .dx-fields label {
            width: 200px; /* Adjust label width */
            font-weight: bold;
            color: #333;
            text-align: right;
            padding-right: 10px;
        }

        .dx-field .dx-textbox,
        .dx-fields .dx-selectbox {
            flex-grow: 1;
            max-width: 400px;
        }

    .dx-fieldset .dx-field-container {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .dx-field-container div {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .dx-button {
        margin-left: 10px;
        height: 38px;
        display: flex;
        align-items: center;
    }

    #gridSalesPerson .dx-datagrid-headers .dx-header-row {
        background-color: #007bff;
        color: white;
        font-weight: bold;
    }

    .dx-datagrid {
        margin-top: 15px;
    }
    

    .limited-footer .btn-container:not(:has(#btnMoveDown,#btnMoveUp,#btnSave,#btnSaveAndClose,#btnPrint1,#btnAddNew,#btnDelete,#btnBack,#btnVerify,#btnApprove,#btnAttach,#btnPostToLedgers,#btnPostTag)) {
        display: none !important;
    }
    .inputTable{
        width: 100%;
        padding: 10px;
    }
</style>

<!-- Input Form -->
<div class="inputTable">
    <table class="inputTable">
        <tr>
            <td colspan="3">
    <!-- First TextBox -->
    @(Html.DevExtreme().TextBox()
        .ID("txtSalesPersonCode")
        .Label("Type a New SalesPerson / Project Manager & Add to the Existing List:")
        .Width("100%"))

            </td>
    <!-- Table Layout -->
        <tr>
            <td>
                @(Html.DevExtreme().TextBox()
                    .Label("SalesPerson / Project Manager Code:")
                    .ID("txtSalesProjectCode")
                    .Width("100%"))
            </td>
        
            <td colspan="2">
                @(Html.DevExtreme().TextBox()
                    .Label("Email Address:")
                    .ID("txtEmailAddress")
                    .Width("100%"))
            </td>
        </tr>
        <tr>
            <td>
                @(Html.DevExtreme().SelectBox()
                    .Label("User Code:")
                    .ID("ddlUserCode")
                    .DataSource(new JS("[]")) /* Dynamic data */
                    .ValueExpr("ID")
                    .DisplayExpr("UserCode")
                    .Width("100%"))
            </td>
            <td>
                @(Html.DevExtreme().TextBox()
                    .Label("Contact No:")
                    .ID("txtContactNo")
                    .Width("100%"))
            </td>
            <td>
                @(Html.DevExtreme().Button()
                    .ID("btnAddSalesPerson")
                    .Text("Add")
                    .Icon("plus")
                    .Type(ButtonType.Success)
                    .Width("100%")
                    .OnClick("addSalesPerson"))
            </td>
        </tr>
    </table>
    @* 
<div class="Head"> *@
    <div class="limited-footer">
        @await Html.PartialAsync("VATModuleFooter")
    </div>
    @* </div> *@
</div>


<!-- Data Grid -->
@(Html.DevExtreme().DataGrid()
    .ID("gridSalesPerson")
    .DataSource(new JS("[]")) // Assume dynamic data binding
    .ShowBorders(true)
    .Columns(columns =>
    {
        columns.Add().DataField("UserCode").Caption("User Code").Width(80);
        columns.Add().DataField("SalesPersonName").Caption("Sales Person Name").Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("EmailAddress").Caption("Email Address").Alignment(HorizontalAlignment.Center);
        columns.Add().DataField("SalesPersonContactNo").Caption("Sales Person Contact No").Alignment(HorizontalAlignment.Center);
    })
)

<script>
    $(document).ready(function () {

        $(".limited-footer .btn-containerIvoiceEdit").each(function () {

            if (!$(this).find("#btnSave,#btnBack").length) {

                $(this).remove();

            }

        });

    });

    function addSalesPerson() {
        DevExpress.ui.notify("SalesPerson Added Successfully", "success", 2000);
    }

    function updateSalesPerson() {
        DevExpress.ui.notify("Updated Successfully", "success", 2000);
    }

    function goBack() {
        window.history.back();
    }
</script>
