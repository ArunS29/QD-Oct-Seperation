@page
@model QD.ERP.Finance.Areas.Finance.Pages.JournalEntryFormAddModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Cost Entry Table</title>

    <!-- DevExtreme CSS -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.4/css/dx.light.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
            background-color: #f4f8ff;
        }

        .table-container {
            background-color: white;
            padding: 15px;
            border: 1px solid #ccc;
            border-radius: 8px;
            height: 400px; /* Set the height here */
            overflow: auto; /* Adds scroll if content overflows */
        }
    </style>
</head>
<body>

    <div class="table-container">
        <div id="costTable"></div>
    </div>

    <!-- DevExtreme JS -->
    <script src="https://cdn3.devexpress.com/jslib/23.2.4/js/jquery.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.4/js/jszip.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.4/js/dx.all.js"></script>

    <script>
        $(function() {
            $("#costTable").dxDataGrid({
                dataSource: [],
                showBorders: true,
                columns: [
                    {
                        dataField: "costCode",
                        caption: "Cost Code",
                        width: 200
                    },
                    {
                        dataField: "costUnit",
                        caption: "Cost Unit",
                        width: 200
                    },
                    {
                        dataField: "amount",
                        caption: "Amount",
                        width: 150,
                        format: { type: "fixedPoint", precision: 2 },
                        alignment: "right"

                    },
                    {
                        dataField: "drCr",
                        caption: "Dr/Cr",
                        width: 100
                    }
                ],
                editing: {
                    mode: "cell",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: false // Disable the add button
                },
                height: 400 // Set the height of the grid here if you prefer to do it via JS
            });
        });
    </script>

</body>
</html>


