                    stylingMode: "outlined",
                    value: null,
                    onValueChanged: function (e) {
                        selectedMode = e.value.toLowerCase();

                        const msg = selectedMode === "online"
                            ? "✅ You’ve selected <strong>Online Mode</strong>. This is real-time data.It will take Few minutes to load data. 🔄"
                            : "🕓 You’ve selected <strong>Offline Mode</strong>. This is preloaded data till last night.if you need live data go online 📁";

                        messageBox.html(msg).slideDown(200);
                    }
                }).css({
                    marginTop: "20px",
                    textAlign: "center"
                });

                $("<div>").addClass("dx-field-value").append(radioGroup).appendTo(container);
            },
            showCloseButton: true,
            showTitle: true,
            width: 500,
            height: "auto",
            dragEnabled: false,
            shadingColor: "rgba(0,0,0,0.15)",
            animation: {
                show: {
                    type: "slide",
                    from: { top: -150, opacity: 0 },
                    to: { top: 0, opacity: 1 },
                    duration: 400
                },
                hide: {
                    type: "fade",
                    duration: 100
                }
            },
            visible: true,
            toolbarItems: [
                {
                    toolbar: "bottom",
                    location: "after",
                    widget: "dxButton",
                    options: {
                        text: "🎯 Confirm",
                        type: "success",
                        elementAttr: {
                            style: "border-radius: 8px; font-weight: 600; min-width: 100px;"
                        },
                       onClick: function () {
                        playSound();

                        // Show deep hole animation
                        // const hole = document.getElementById("deep-hole-overlay");
                        // hole.style.display = "flex";

                        // // Restart animation
                        // hole.style.animation = "none";
                        // void hole.offsetWidth; // Force reflow
                        // hole.style.animation = "tunnelZoom 1.5s forwards";

                        setTimeout(() => {
                          //  hole.style.display = "none"; // Hide after animation
                            $("#dataModePopup").dxPopup("instance").hide();
                            callback(selectedMode); // Continue your logic
                        }, 200); // Match animation duration
                    }

                    }
                }
            ]
        });
    }
</script>

