@page
@model QD.ERP.Finance.Areas.Finance.Pages.DivmasterModel
@{
}
@using DevExtreme.AspNet.Mvc
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Add SweetAlert CSS and JS CDN -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.10/dist/sweetalert2.min.js"></script>

<style type="text/css">
    .mainContainer {
    background-color: white;
     margin-top: 0px!important; 
    margin-left: 0px!important; 
    width: 97%;
    height: 100vh;
    /* overflow: hidden; */
    /* padding: 20px; */
}
    .card-container {
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .card-container label {
            color: blue;
        }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .dx-datagrid-headers .dx-header-row .dx-datagrid-text-content {
        color: #2d5799;
    }

    .dx-datagrid-headers .dx-header-row {
        background-color: white;
    }

    .dx-button-add {
        background-color: #f5f8fb !important;
        color: red !important;
        border: 1px solid #b0c4de;
    }

        .dx-button-add .dx-icon {
            color: green !important;
        }

    .dx-selectbox .dx-texteditor-input {
        text-align: center;
    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 15px 0;
        flex-wrap: wrap;
    }

    .action-buttons-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
        flex-wrap: wrap;
    }

        .action-buttons-container .dx-button {
            margin: 5px;
        }

    .container, .frame, .footerContainer, .playIcon {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    #goToTopBtn {
        z-index: 100;
    }

    @@media (max-width: 768px) {
        .dx-textbox, .dx-button

    {
        width: 100% !important;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    }
</style>

<div class="card-container">
    <div class="row g-3">
        <!-- Branch Name -->
        <div class="form-group col-lg-4 col-md-6 col-sm-12">
            @(Html.DevExtreme().TextBox()
                .Label(new JS("formatMessage('Type a New Branch & Add to the Existing List')"))
                .LabelMode(EditorLabelMode.Floating)
                .ID("txtbranchName")
                .Value(null)
                .ValidationRules(rules => {
                    rules.AddRequired().Message(new JS("formatMessage('Branch Name is required')"));
                })
            )
        </div>

        <!-- Arabic Name and Button -->
        <div class="form-group col-lg-4 col-md-6 col-sm-12">
            <div class="d-flex align-items-end gap-2">
                <div style="flex-grow: 1;">
                    @(Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Branch In Arabic')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("txtarabName")
                        .Value(null)
                        .Width("100%")
                    )
                </div>
                <div>
                    @(Html.DevExtreme().Button()
                        .ID("convertToArabic1")
                        .Width(45)
                        .Height(33)
                        .Icon("fas fa-language")
                        .ElementAttr(new { @class = "input-button" })
                        .OnClick("function() { convertToArabic(); }")
                    )
                </div>
            </div>
        </div>

        <!-- ADD Button -->
        <div class="form-group col-lg-4 col-md-6 col-sm-12 d-flex align-items-end">
            @(Html.DevExtreme().Button()
                .ID("btnadd")
                .Text(new JS("formatMessage('ADD')"))
                .Height(40)
                .Width("100%")
                .Icon("plus")
                .OnClick("function() { adddivmaster(); }")
                .ElementAttr(new { @class = "dx-button-add" })
            )
        </div>
    </div>

    <!-- Grid Container -->
    <div class="row mt-4">
        <div class="col-12">
            <div id="gridContainer" class="w-100"></div>
        </div>
    </div>
</div>

<script type="text/javascript">

    async function convertToArabic() {

        // Get the TextBox1 (input) instance

        const textBox1Instance = $("#txtbranchName").dxTextBox("instance");

        // Get the TextBox2 (output) instance

        const textBox2Instance = $("#txtarabName").dxTextBox("instance");

        // Ensure both instances are initialized

        if (!textBox1Instance || !textBox2Instance) {

            console.error("TextBox instances are not properly initialized.");

            return;

        }


        // Get the value from TextBox1

        const englishText = textBox1Instance.option("value");

        // Validate input

        if (!englishText || englishText.trim() === "") {

            alert("Please enter text to translate.");

            return;

        }

        // Perform translation

        const arabicTranslation = await translateToArabic(englishText);

        // Update TextBox2 with the Arabic translation

        textBox2Instance.option("value", arabicTranslation);

    }
    $(function () {
        var updatedRows = []; // To store the updated rows
        var searchPanelVisible = false; // Track the visibility of the search panel

        // Initialize DevExtreme DataGrid with CustomStore
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "BranchCode",
                load: function () {
                    return $.getJSON('/api/Master/GetBranches'); // Fetch data from the API
                },
                update: function (key, values) {
                    var updatedBranch = {
                        BranchCode: key, // Use the key for the branch to identify it
                        BranchName: values.BranchName,
                        BranchNameAr: values.BranchNameAr
                    };

                    // Add the updated branch to the updatedRows array
                    updatedRows.push(updatedBranch);

                    // Send the updated data to the backend via AJAX
                    return $.ajax({
                        type: "POST",
                        url: "/api/Master/UpdateBranch",
                        data: JSON.stringify(updatedBranch),
                        contentType: "application/json",
                        success: function (response) {
                            // SweetAlert on success
                            Swal.fire({
                                icon: 'success',
                                title: formatMessage('Branch Updated'),
                                text: formatMessage('The branch has been successfully updated.'),
                                confirmButtonText: 'OK'
                            });
                        },
                        error: function (xhr) {
                            // Check if the error is due to a duplicate branch name
                            var errorMessage = xhr.responseJSON?.message || "An error occurred.";

                            if (xhr.status === 400 && errorMessage.includes("Branch Name already exists")) {

                                Swal.fire({
                                    icon: 'error',
                                    title: formatMessage('Duplicate Branch Name'),
                                    text: formatMessage('This branch name already exists! Please choose a different name.'),
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    // Trigger the cancel action on the DataGrid after alert is closed
                                    var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                    dataGrid.cancelEditData();  // Cancel the current edit
                                });


                            } else {
                                // Handle other errors
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: errorMessage,
                                    confirmButtonText: 'OK'
                                });
                            }
                        }
                    });
                }
            }),
            editing: {
                mode: "batch", // Enable batch edit mode for multiple row editing
                allowUpdating: true,  // Allow cell updates
                allowAdding: false,   // No new rows
                allowDeleting: true, // Prevent row deletion
                useIcons: true, // Use icons for save/cancel
                texts: {
                    saveAll: "Update", // Custom text for save button
                    cancelAll: "Cancel All Changes" // Custom text for cancel button
                }
            },
            columns: [
                { dataField: "BranchCode", caption: formatMessage("Branch Code"), width: 100, editorOptions: { readOnly: true } },
                { dataField: "BranchName", caption: formatMessage("Branch Name") },
                { dataField: "BranchNameAr", caption: formatMessage("Branch Name (Arabic)") },
                {
                    type: "buttons",
                    width: 100,
                    buttons: [
                        {
                            icon: "trash",
                            hint: "Delete",
                            onClick: function (e) {
                                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                                var selectedData = e.row.data;
                                var branchCode = selectedData.BranchCode;

                                // Send delete request to the API
                                $.ajax({
                                    type: "POST",
                                    url: "/api/Master/DeleteBranchMaster",
                                    data: JSON.stringify({ BranchCode: branchCode }),
                                    contentType: "application/json",
                                    success: function (response) {
                                        if (response.success) {
                                            dataGrid.refresh(); // Refresh the grid
                                            Swal.fire({
                                                icon: 'success',
                                                title: 'Success',
                                                text: formatMessage('Branch deleted successfully.'),
                                                confirmButtonText: 'OK'
                                            });
                                        } else {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'Error',
                                                text: response.message,
                                                confirmButtonText: 'OK'
                                            });
                                        }
                                    },
                                    error: function (xhr) {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error',
                                            text: xhr.responseText,
                                            confirmButtonText: 'OK'
                                        });
                                    }
                                });
                            }
                        }
                    ]
                }
            ],
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: {
                visible: searchPanelVisible, // Set initial visibility of the filter row
                applyFilter: "auto"
            },
            toolbar: {
                items: [
                    {
                        widget: "dxButton",
                        options: {
                            icon: "save",  // Icon for the Save button
                            text: formatMessage("Update"),  // Text alongside the icon
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").saveEditData();  // Save all changes
                            }
                        },
                        location: "after"
                    },
                    {
                        widget: "dxButton",  // Adding Cancel button
                        options: {
                            icon: "close",  // Icon for Cancel button
                            text: formatMessage("Cancel"),  // Text for Cancel button
                            onClick: function () {
                                $("#gridContainer").dxDataGrid("instance").cancelEditData();  // Cancel all edits
                            },
                            visible: false // Initially hide the cancel button
                        },
                        location: "after",
                        name: "cancelButton"
                    },
                    {
                        widget: "dxButton",  // Adding Search Toggle button
                        options: {
                            icon: "search",  // Icon for Search button
                            text: formatMessage("Toggle Search"),  // Text for Search button
                            onClick: function () {
                                searchPanelVisible = !searchPanelVisible; // Toggle the visibility
                                $("#gridContainer").dxDataGrid("instance").option("filterRow.visible", searchPanelVisible); // Update the grid
                            }
                        },
                        location: "after"
                    }
                ]
            },
            onEditingStart: function (e) {
                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                var toolbarItems = dataGrid.option("toolbar.items");
                var cancelButton = toolbarItems.find(item => item.name === "cancelButton");
                cancelButton.options.visible = true; // Show the cancel button when editing starts
                dataGrid.option("toolbar.items", toolbarItems);
            },
            onSaved: function (e) {
                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                var toolbarItems = dataGrid.option("toolbar.items");
                var cancelButton = toolbarItems.find(item => item.name === "cancelButton");
                cancelButton.options.visible = false; // Hide the cancel button when editing ends
                dataGrid.option("toolbar.items", toolbarItems);
            },
            onEditCanceling: function (e) {
                var dataGrid = $("#gridContainer").dxDataGrid("instance");
                var toolbarItems = dataGrid.option("toolbar.items");
                var cancelButton = toolbarItems.find(item => item.name === "cancelButton");
                cancelButton.options.visible = false; // Hide the cancel button when editing is canceled
                dataGrid.option("toolbar.items", toolbarItems);
            },

            onRowUpdated: function (e) {
                // SweetAlert when a row is updated
                Swal.fire({
                    icon: 'success',
                    title: formatMessage('Row Updated'),
                    text: formatMessage('The row data was successfully updated.'),
                    confirmButtonText: 'OK'
                });
            },
            onRowInserted: function (e) {
                // SweetAlert when a new row is inserted
                Swal.fire({
                    icon: 'success',
                    title: formatMessage('Row Inserted'),
                    text: formatMessage('A new row was added successfully.'),
                    confirmButtonText: 'OK'
                });
            },
            onRowRemoved: function (e) {
                // SweetAlert when a row is removed
                Swal.fire({
                    icon: 'info',
                    title: formatMessage('Row Removed'),
                    text: formatMessage('The row has been removed from the grid.'),
                    confirmButtonText: 'OK'
                });
            },

            // Enable vertical and horizontal scrolling
            scrolling: {
                mode: "virtual", // This makes the scrolling virtual, loading rows as you scroll
                rowRenderingMode: "virtual", // Optimizes row rendering
                useNative: true // Use native scrolling for better performance
            },
            height: "80%", // Set a fixed height for the grid (this helps in showing vertical scrollbar)
            width: "100%" // Make grid responsive and take full width of the container
        });
    });


    function adddivmaster() {
        // Get the values from the text boxes
        var branchName = $("#txtbranchName").dxTextBox("instance").option("value");
        var arabicBranchName = $("#txtarabName").dxTextBox("instance").option("value");

        // Get the branch name validator instance
        var branchNamevalidator = $("#txtbranchName").dxValidator("instance");

        // Validate the branch name input
        var branchNamevalidation = branchNamevalidator.validate();

        // If the branch name is valid, proceed with the AJAX request
        if (branchNamevalidation.isValid) {

            // Get the data array from the grid's data source
            var existingBranches = $("#gridContainer").dxDataGrid("instance").getDataSource().items();

            // Check if the branch name already exists in the grid data
            var duplicate = existingBranches.some(function (item) {
                return item.BranchName.toLowerCase() === branchName.toLowerCase();
            });

            if (duplicate) {
                Swal.fire({
                    icon: 'error',
                    title: formatMessage('Duplicate Branch'),
                    text: formatMessage('This branch already exists!'),
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Create the data object to send to the API
            var branchData = {
                BranchName: branchName,
                BranchNameAr: arabicBranchName
            };

            // Send the data to the AddBranch API using AJAX
            $.ajax({
                url: '/api/Master/AddBranch',  // The API endpoint for adding a branch
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(branchData),  // Convert the data object to JSON string
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: formatMessage('Branch Added'),
                            text: response.message,
                            confirmButtonText: 'OK'
                        });
                        // Clear the text inputs after success
                        $("#txtbranchName").dxTextBox("instance").option("value", "");
                        $("#txtarabName").dxTextBox("instance").option("value", "");

                        // Optionally, you can reload the data grid to reflect the newly added branch
                        $("#gridContainer").dxDataGrid("instance").refresh();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: formatMessage('Error'),
                            text: response.message,
                            confirmButtonText: 'OK'
                        });
                    }
                },
                error: function (xhr) {
                    var errorMessage = xhr.status === 500
                        ? "Server error: Please try again later."
                        : "Validation error: " + xhr.responseText;
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: errorMessage,
                        confirmButtonText: 'OK'
                    });
                }
            });
        } else {
            // If validation fails, show a notification
            DevExpress.ui.notify(formatMessage('Please fill required details!'), "error", 2000);
        }
    }

   
     $(function () {
                 $("#BranchMaster").dxTextBox({
            text: formatMessage("Branch Master"),
                readOnly: true,
                onContentReady: function (e) {
                    $(e.element).addClass("dx-textcolor-heading");
                }
                });
            });
</script>

