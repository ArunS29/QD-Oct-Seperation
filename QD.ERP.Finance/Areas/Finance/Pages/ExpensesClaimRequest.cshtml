        function getUrlParameter(name) {
            name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
            let regex = new RegExp("[\\?&]" + name + "=([^&#]*)");
            let results = regex.exec(location.search);
            return results === null ? null : decodeURIComponent(results[1].replace(/\+/g, " "));
        }
                
        $(document).ready(function () {
            const voucherNoField = $("#VoucherNo").dxTextBox("instance");
            const dataGrid = $("#dataGrid").dxDataGrid("instance");

            function getVoucherNo() {
                return voucherNoField.option("value");
            }

                function addEmptyRowIfNeeded() {

                        const dataSource = dataGrid.option("dataSource") || [];

                        if (!Array.isArray(dataSource)) {
                            return;
                        }
                        if (Issubmitted || Isverified || Isapproved) {
                            return;
                        }

                        if (dataSource.length === 0 || Object.keys(dataSource[dataSource.length - 1]).length !== 0) {
                            dataSource.push({
                                ClaimedAmount: 0.00,
                                ApprovedAmount: 0.00,
                                VoucherNo: getVoucherNo()
                            });
                            dataGrid.option("dataSource", dataSource);
                        }
                    }

            function initializeDataGrid(voucherNo) {
                $.ajax({
                    url: "/api/ExpenseClaim/GetChildClaimsByVoucherNo",
                    type: "GET",
                    data: { voucherNo: voucherNo },
                    success: function (data) {
                        dataGrid.option("dataSource", data);
                       if (!Isapproved){

                                addEmptyRowIfNeeded();
                       }
                    }
                });

                dataGrid.option("onRowInserted", function (e) {
                    e.data.ClaimRefNo = getVoucherNo();

                    $.ajax({
                        url: "/api/ExpenseClaim/AddOrUpdateChildClaim",
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(e.data),
                        success: function () {
                            DevExpress.ui.notify("Row inserted successfully", "success", 1500);
                            // ✅ Reload updated data (with new ClaimChildNo, etc.)
                            $.ajax({
                                url: "/api/ExpenseClaim/GetChildClaimsByVoucherNo",
                                type: "GET",
                                data: { voucherNo: voucherNo },
                                success: function (data) {
                                    dataGrid.option("dataSource", data);
                                    addEmptyRowIfNeeded(); // Optional: keep extra row
                                },
                                error: function () {
                                    DevExpress.ui.notify("Failed to reload data", "error", 1500);
                                }
                            });
                        },
                        error: function () {
                            DevExpress.ui.notify("Insert failed", "error", 1500);
                        }
                    });

                    addEmptyRowIfNeeded();
                });

                dataGrid.option("onRowUpdated", function (e) {

                    e.data.ClaimRefNo = getVoucherNo();

                    $.ajax({
                        url: "/api/ExpenseClaim/AddOrUpdateChildClaim",
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(e.data),
                        success: function () {
                            // DevExpress.ui.notify("Row updated successfully", "success", 1500);
                            // ✅ Reload updated data (with new ClaimChildNo, etc.)
                            $.ajax({
                                url: "/api/ExpenseClaim/GetChildClaimsByVoucherNo",
                                type: "GET",
                                data: { voucherNo: voucherNo },
                                success: function (data) {
                                    dataGrid.option("dataSource", data);
                                    addEmptyRowIfNeeded();

                                },
                                error: function () {
                                    DevExpress.ui.notify("Failed to reload data", "error", 1500);
                                }
                            });
                        },
                        error: function () {
                            DevExpress.ui.notify("Update failed", "error", 1500);
                        }
                    });

                        addEmptyRowIfNeeded();

                });
                        dataGrid.option("summary", {
                            totalItems: [
                                     {
                                        column: "ClaimedAmount",
                                        summaryType: "sum",
                                        customizeText: function (e) {
                                            return e.value != null ? e.value.toFixed(2) : "";
                                        }
                                    },
                                    {
                                        column: "ApprovedAmount",
                                        summaryType: "sum",
                                        customizeText: function (e) {
                                            return e.value != null ? e.value.toFixed(2) : "";
                                        }
