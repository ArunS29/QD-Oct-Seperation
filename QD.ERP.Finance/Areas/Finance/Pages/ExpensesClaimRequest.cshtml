@model QD.ERP.Finance.Areas.Finance.Pages.ExpensesClaimRequestModel
@using Microsoft.AspNetCore.Http

@{
    // pull your session value (“2”) into baseCurrencyIdnew
    var sessionID = HttpContext.Session.GetString("currencyID");
    int baseCurrencyIdnew = 0;
    if (!string.IsNullOrEmpty(sessionID))
        int.TryParse(sessionID, out baseCurrencyIdnew);

}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
