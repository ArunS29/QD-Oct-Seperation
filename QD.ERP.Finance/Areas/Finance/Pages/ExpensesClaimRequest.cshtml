<style>
    .dx-button-mode-contained.dx-button-default .dx-icon {
        color: var(--title-background-color);
    }

    /* Hover row (applies to all grids in dropdowns) */
    .dx-dropdowneditor-overlay .dx-datagrid-rowsview .dx-row.dx-state-hover > td {
        background-color: var(--title-background-color) !important; /* light red */
        color: #000 !important;
    }
    /* Red summary for ClaimedAmount */
    .dx-datagrid-total-footer td[aria-label*="ClaimedAmount"] .dx-datagrid-summary-item {
        color: red !important;
        font-weight: bold;
    }

    /* Green summary for ApprovedAmount */
    .dx-datagrid-total-footer td[aria-label*="ApprovedAmount"] .dx-datagrid-summary-item {
        color: green !important;
        font-weight: bold;
    }

    /* Selected row (all dropdown grids) */
    .dx-dropdowneditor-overlay .dx-datagrid-rowsview .dx-row.dx-selection > td,
    .dx-dropdowneditor-overlay .dx-datagrid-rowsview .dx-row.dx-row-focused > td {
        background-color: var(--title-background-color) !important; /* strong red */
        color: #fff !important;
    }

    .dx-dropdowneditor-overlay .dx-datagrid-rowsview .dx-row {
        background-color: var(--header-color) !important; /* ✅ light background for all rows */
    }

       /* #accounthead-datagrid .dx-datagrid-rowsview .dx-row:nth-child(even) {
            background-color: #e9eff5; 
        } */
    .form-container {
        padding: 5px;
        border-radius: 8px;
        background-color: white;
        max-width: 985px;
        margin: 0px;
        color: black;
    }

    table {
        width: 100%;
        border-spacing: 5px;
    }

        table td, th {
            vertical-align: top;
            padding: 3px;
        }

    input[type="text"], textarea {
        width: 100%;
        padding: 2px;
        box-sizing: border-box;
        border-radius: 2px;
        /* border: 1px solid #ccc; */
        color: black;
    }

    textarea {
        resize: none;
    }

    .btn {
        background-color: #d4e6fb;
        color: #000;
        padding: 8px 16px;
        margin-right: 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
        width: 100%;
    }

    .add-btn {
        background-color: #d4e6fb;
        color: #000;
        padding: 5px 12px;
        border: none;
        margin-left: 10px;
        cursor: pointer;
        font-size: 20px;
        vertical-align: top;
    }

    .narration-cell {
        position: relative;
    }

    /* .narration-cell a { */
    /*     a {
                        position: absolute;
                        right: 70px;
                        top: 8px;
                        color: white;
                        text-decoration: underline;
                        font-size: 14px;
                        cursor: pointer;
                    } */

    .highlight {
        background-color: #ffffb3;
    }

    /* New styles for labels above inputs */
    .input-group {
        display: flex;
        flex-direction: column;
    }

        .input-group label {
            margin-bottom: 5px;
            font-weight: bold;
            color: black;
        }

    flex-row {
        display: flex;
        align-items: end;
    }

    .dropdown-box {
        position: absolute;
        background-color: #ffffff;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 16px;
        width: 50%;
        z-index: 9999;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin-left: 12px;
    }

    .col {
        flex: 1;
        padding: 0 8px;
        min-width: 180px;
    }

    label {
        display: block;
        margin-bottom: 4px;
        font-weight: 600;
        color: #333;
    }

    .actions {
        justify-content: flex-end;
    }

        .actions .col {
            text-align: right;
        }

    .overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    /* ✅ Force borders for all cells in the grid */
    #dataGrid .dx-row > td {
        border: 1px solid var(--title-background-color) !important;
    }

    /* ✅ Highlight empty row */
    #dataGrid .dx-row.dx-data-row:last-child {
        background-color: #f9f9f9; /* Light background to highlight empty row */
    }

    .displayFlex {
        display: flex;
    }

    .card-button .dx-icon {
        color: white; /* Bootstrap primary blue */
        background-color: #007BFF;
        border: 1px solid #007BFF; /* optional: add a border for visibility */
    }

    #calculateVATButton .dx-button-text {
        color: black !important;
    }

    #saveEntryButton .dx-button-text {
        color: black !important;
    }

    .dx-overlay-wrapper {
        z-index: 1050 !important; /* Or higher if necessary */
    }

    .footer-fixed {
        bottom: 37px !important;
    }

    .titleCard-toggle1 {
        display: none;
    }


    .icon-green.dx-icon-attach::before {
        color: green !important;
    }

    .icon-red.dx-icon-attach::before {
        color: red !important;
    }
</style>

<div class="dx-card-header minimal-header">
    <div class="card-title-icon">
        <i class="fas fa-file-invoice-dollar"></i>
    </div>
    <div id="ExpensesClaims" class="titleText no-border-title"></div>
</div>

<div class="content-container">
    <!-- Top Row -->
    <div class="row w-100 align-items-center" style="margin-top: 8px;">
        <div class="form-group col-md-2 col-sm-6">
            @(Html.DevExtreme().TextBox()
                        .Label(new JS("formatMessage('Claim Reference No:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("VoucherNo")
                        .Value("")
                        .ReadOnly(true)
                        .ValidationRules(rules => { rules.AddRequired().Message("VoucherNo is required"); })
                        )
        </div>
        <div class="form-group col-md-2 col-sm-6">
            @(Html.DevExtreme().DateBox()
                        .Label(new JS("formatMessage('Claim Date:')"))
                        .ID("claimerdate")
                        .LabelMode(EditorLabelMode.Floating)
                        .Type(DateBoxType.Date)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Value(DateTime.Now)
                        .ElementAttr("class", "dynamicFormatDateBox")
                        .OnValueChanged("onVoucherDateChanged")
                        )
        </div>
        <div class="form-group col-md-2 col-sm-6">
            @(Html.DevExtreme().DateBox()
                        .Label(new JS("formatMessage('Effective Date:')"))
                        .ID("claimerEffectiveDate")
                        .LabelMode(EditorLabelMode.Floating)
                        .Type(DateBoxType.Date)
                        .DisplayFormat("dd-MMM-yyyy")
                        .Value(DateTime.Now)
                        .ElementAttr("class", "dynamicFormatDateBox")
                        .OnValueChanged("onVoucherDateChanged")
                        )
        </div>
        <div class="form-group col-md-6 col-sm-6">
            @(Html.DevExtreme().TextArea()
                        .Label(new JS("formatMessage('Claim Remarks:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("txtEntryNarration")
                        .Value("")
                      
                        .Placeholder("Enter your comments here...")
                        .MaxLength(500)
                        )
        </div>
    </div>

    <!-- Second Row -->
    <div class="row w-100 align-items-center" style="margin-top: 8px;">
        <div class="form-group col-md-4 col-sm-6">
            @(Html.DevExtreme().DropDownBox()
                        .DataSource(d => d.WebApi()
                        .Controller("CostAllocation")
                        .LoadAction("GetCostAllocationUnits")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("CostAllocationUnitId")
                        )
                        .Label(new JS("formatMessage('Claimed for Project/Jobs:')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ID("accountDropDownBox")
                        .ShowClearButton(true)
                        .AcceptCustomValue(true)
                        .OpenOnFieldClick(false)
                        .ValueChangeEvent("change") // Detects changes in the dropdown
                        .HoverStateEnabled(true)

                        .ValueExpr("CostAllocationUnitId")
                        .DisplayExpr("CostAllocationUnit")

                        .OnInput("dropDownBoxOnInput")
                        .OnOpened("onclaimOpened")
                        .OnValueChanged("oncostValueChanged")
                        .TabIndex(1)
                        .DropDownOptions(o => o.Width(500))
                        .OnKeyDown("onKeyDown")
                        .ContentTemplate(new TemplateName("PaymentAmountContentTemplate"))
                        )
        </div>
        <div class="form-group col-md-2 col-sm-6">
            @(
                        Html.DevExtreme().SelectBox()
                        .Label(new JS("formatMessage('Priority:')"))
                        .ID("Priorityclaim")
                        .LabelMode(EditorLabelMode.Floating)
                        .DataSource(new[] { "Critical", "High", "Medium", "Low" })
                        .Value(null)
                        )
        </div>
        <div class="form-group col-md-2 col-sm-6">
            @(Html.DevExtreme().DropDownBox()
                        .ID("ddlBaseCurrency")
                        .DataSource(d => d.WebApi()
                        .Controller("Utility")
                        .LoadAction("GetCurrencyList")
                        .LoadMode(DataSourceLoadMode.Raw)
                        .Key("CurrencyExchangeId")
                        )
                        .ValueExpr("CurrencyExchangeId")
                        .DisplayExpr("CurrencyName")
                                                     // now use your renamed variable
                        .Value(baseCurrencyIdnew)
                        .Label(new JS("formatMessage('Base Currency')"))
                        .LabelMode(EditorLabelMode.Floating)
                        .ValidationRules(rules => rules.AddRequired().Message("Please select a base currency."))
                        .ShowClearButton(true)
                        .AcceptCustomValue(false)
                        .DropDownOptions(o => o.Width(300))
                        .ReadOnly(true)
                        .ElementAttr(new { @class = "custom-disabled-selectbox" })
                        )
        </div>
    </div>

    <div class="dx-field ledgerResult">
        @(Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.Tbl20103ExpenseClaimChild>()
                .ID("dataGrid")
                .Columns(columns =>
                {
                    columns.AddFor(m => m.ClaimChildNo).Caption(new JS("formatMessage('Child No')")).Visible(false).AllowEditing(false);
                    columns.AddFor(m => m.ExpenseDescription).Caption(new JS("formatMessage('Expense Description')")).Visible(true);
                    columns.AddFor(m => m.BillRefNo).Caption(new JS("formatMessage('Bill Ref No')"));
                    columns.AddFor(m => m.BillDate).Caption(new JS("formatMessage('Bill Date')")).AllowEditing(true).CellTemplate(@<text>
                                                                                                              <span>
                                                                                                                  <%- data.BillDate ? DevExpress.localization.formatDate(new Date(data.BillDate), "dd-MMM-yyyy") : '' %>
                                                                                                              </span>
                                                                                                          </text>)
                    // Edit Mode
                    .EditCellTemplate(@<text>
                @(Html.DevExtreme().DateBox()
                            .Type(DateBoxType.Date)
                            .Value(new JS("data.BillDate")) // Default to today
                            .OnValueChanged("setEffectiveDate") // Pass full data object
                            .DisplayFormat("dd-MMM-yyyy")
                            )
            </text>);
                    columns.AddFor(m => m.ClaimedAmount)
                    .Caption(new JS("formatMessage('Claimed Amount')"))
                    .Alignment(HorizontalAlignment.Right)
                    .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }") // ✅ Fix: Prevent undefined error
                    .AllowEditing(true).EditCellTemplate(@<text>
                @(Html.DevExtreme().NumberBox()
                            .ID("claimedAmountEditor")
                            .Value(new JS("data.ClaimedAmount"))
                            .Min(0)
                            .Max(99999999)
                            .ShowSpinButtons(false)
                            .OnValueChanged("onClaimedAmountChanged")
                            .Format("#,##0.00")
                            )
            </text>);
                    columns.AddFor(m => m.ApprovedAmount)
                    .Caption(new JS("formatMessage('Approved Amount')"))
                    .AllowEditing(true)
                    .Alignment(HorizontalAlignment.Right)
                    .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }").EditCellTemplate(@<text>
                @(Html.DevExtreme().NumberBox()
                            .ID("approvedAmountEditor")
                            .Value(new JS("data.ApprovedAmount"))
                            .Min(0)
                            .Max(99999999)
                            .ShowSpinButtons(false)
                            .OnValueChanged("onApprovedAmountChanged")
                            .Format("#,##0.00")
                            )
            </text>);
                    columns.Add().Caption(new JS("formatMessage('Actions')")).Width(120)
                    .CellTemplate(@<text>
                                       <div class="dropdown-wrapper">
                    @(Html.DevExtreme().Button()
                                    .Icon("card")
                                    .Type(ButtonType.Default)
                                    .OnClick("onCardClick").Disabled(new JS("Ispaid === true")))
            </div>
        </text>).Alignment(HorizontalAlignment.Center);

                    columns.AddFor(m => m.AccountId).DataField("AccountHead").Caption(new JS("formatMessage('Account Ledger')")).Width(300)
                    .CellTemplate(@<text>
                                       <span>
                                           <% if (data.AccountHead) { %>
                                           <%= data.AccountHead %>
                                           <% } else { %>
                                           <span style="color: black;">&lt;select Account Ledger&gt;</span>
                                           <% } %>
                                       </span>
                                   </text>)
                    // Edit Mode
                    .EditCellTemplate(@<text>
                                           <div style="display: flex; justify-content: space-between; align-items: center;">
                    @(Html.DevExtreme().DropDownBox()
                                    .DataSource(d => d.WebApi().Controller("VoucherEntryCashReceipts")
                                    .LoadAction("GetEditAccountHead")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("AccountId"))
                                    .LabelMode(EditorLabelMode.Floating)
                                    .ID("accountDropDownBoxEdit")
                                    .ShowClearButton(false)
                                    .AcceptCustomValue(true)
                                    .OpenOnFieldClick(false)
                                    .HoverStateEnabled(true)
                                    .OnValueChanged("gridLedger_valueChanged")
                                    .ValueExpr("AccountId")
                                    .DisplayExpr("AccountHead")
                                    .Placeholder(new JS("formatMessage('Select Account Head')"))
                                    .Width(350)
                                    .DropDownOptions(o => o.Width(800))
                                    .Value(new JS("data.AccountId"))
                                    .ContentTemplate(new TemplateName("ReceivingAccountDropdownContentTemplate"))
                                    )


            </div>

                    </text>);



                    columns.AddFor(m => m.CostCenterCode).DataField("CostAllocationUnit").Caption(new JS("formatMessage('Cost Center Code')")).Width(300)
                    .CellTemplate(@<text>
                                       <span>
                                           <% if (data.CostAllocationUnit) { %>
                                           <%= data.CostAllocationUnit %>
                                           <% } else { %>
                                           <span style="color: black;">&lt;select Cost Center&gt;</span>
                                           <% } %>
                                       </span>
                                   </text>)
                    // Edit Mode
                    .EditCellTemplate(@<text>
                                           <div style="display: flex; justify-content: space-between; align-items: center;">
                    @(Html.DevExtreme().DropDownBox()
                                    .DataSource(d => d.WebApi().Controller("ExpenseClaim")
                                    .LoadAction("GetEditCostCenter")
                                    .LoadMode(DataSourceLoadMode.Raw)
                                    .Key("CostAllocationUnitId"))
                                    .LabelMode(EditorLabelMode.Floating)
                                    .ID("CostDropDownBoxEdit")
                                    .ShowClearButton(false)
                                    .AcceptCustomValue(true)
                                    .OpenOnFieldClick(false)
                                    .HoverStateEnabled(true)
                                    .OnValueChanged("gridCost_valueChanged")
                                    .ValueExpr("CostAllocationUnitId")
                                    .DisplayExpr("CostAllocationUnit")
                                    .Placeholder(new JS("formatMessage('Select Cost Center')"))
                                    .Width(350)
                                    .DropDownOptions(o => o.Width(400))
                                    .Value(new JS("data.CostCenterCode"))
                                    .ContentTemplate(new TemplateName("CostDropdownContentTemplate"))
                                    )


                </div>

            </text>);
                })
                .AllowColumnReordering(true)
                .AllowColumnResizing(true)
                .ColumnFixing(fixing => fixing.Enabled(true))
                .Height(250)
                .Width("100%")
                .ColumnAutoWidth(true)
                .ShowBorders(true)
                .RowAlternationEnabled(true)
                .Editing(editing => editing
                .Mode(GridEditMode.Cell)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)

                )
                .Summary(summary =>
                {
                    summary.TotalItems(totalItems =>
                    {
                        totalItems.Add().Column("ClaimedAmount").SummaryType(SummaryType.Sum)
                    .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
                        totalItems.Add().Column("ApprovedAmount").SummaryType(SummaryType.Sum)
                    .CustomizeText("function(e) { return e.value !== undefined && e.value !== null ? e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : ''; }");
                                                                                                                                                                                                          // ✅ This must match "options.name" in JS exactly
                        totalItems.Add()
                    .Name("ExpenseDescriptionCount")
                    .SummaryType(SummaryType.Custom)
                    .ShowInColumn("ExpenseDescription")
                    .CustomizeText("function(e) { return (e.value || 0) > 0 ? e.value + ' Bills' : ''; }");


                    });
                })
                .OnRowRemoving("onexpenserowremoving")
                .OnCellPrepared("onExpenseCellPrepared")
                )
    </div>
