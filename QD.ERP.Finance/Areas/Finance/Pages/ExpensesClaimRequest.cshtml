     function updateWorkflowVisual(status) {
            const steps = [
        { id: "step-update", icon: "fas fa-user" },
        { id: "step-submit", icon: "fas fa-paper-plane" },
        { id: "step-verify", icon: "fas fa-briefcase" },
        { id: "step-approve", icon: "fas fa-file-alt" }
    ];

        steps.forEach((step, index) => {
            const el = document.getElementById(step.id);
            const statusMsg = el.querySelector(".step-status-msg");
            const icon = el.querySelector("i");

            el.classList.remove("completed", "current", "upcoming", "done");
            icon.className = step.icon;

            if (index < status) {
                el.classList.add("completed");
                statusMsg.textContent = "Done";
                icon.className = "fas fa-check-circle";
            } else if (index === status && status < 3) {
                el.classList.add("current");
                statusMsg.textContent = "In Progress";
                icon.className = "fas fa-spinner fa-spin";
            } else {
                el.classList.add("upcoming");
                statusMsg.textContent = "Pending";
            }

            // Final Approved state
                        if (status === 4 && index === 4) {
                el.classList.add("completed");
                statusMsg.textContent = "Done";
                icon.className = "fas fa-check-circle";
            }
        });
    }




