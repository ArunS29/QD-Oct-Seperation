        function getAccountHeadData(type) {
        let loadAction = type === "Cash Payment"
            ? "GetCPPaymentAccounts"
            : "GetBPPaymentAccounts";

        return DevExpress.data.AspNet.createStore({
            key: "AccountId",
            loadUrl: "/api/ExpenseClaim/" + loadAction
        });
    }


    // DropDownBox opened: always ensure grid shows correct data
    function onPaymentOpened(e) {
        if (!currentRadioValue) return; // nothing selected
        updateAccountHeadGrid();
            const grid = $("#accounthead-datagrid").dxDataGrid("instance");
           setTimeout(() => {
            if (grid) {
                const ds = grid.getDataSource();
                const items = ds ? ds.items() : [];

                // ✅ Only try to focus/select if data exists and Accountname is valid
                if (items.length > 0 && Accountname) {
                    grid.selectRows([Accountname], false);
                    grid.option("focusedRowKey", Accountname);
                } else {
                    // Disable row focusing if no data to avoid E1042
                    grid.option("focusedRowEnabled", false);
                }
            }
        }, 1000);
    }

    // Function to update the DataGrid's data based on current radio selection
    function updateAccountHeadGrid() {
        if (!accountHeadGrid) return;

        let loadAction = currentRadioValue === "Cash Payment"
            ? "GetCPPaymentAccounts"
            : "GetBPPaymentAccounts";

        let newStore = DevExpress.data.AspNet.createStore({
            key: "AccountId",
            loadUrl: "/api/ExpenseClaim/" + loadAction
        });

        accountHeadGrid.option("dataSource", newStore);
        newStore.load(); // ensure first load happens immediately
    }






