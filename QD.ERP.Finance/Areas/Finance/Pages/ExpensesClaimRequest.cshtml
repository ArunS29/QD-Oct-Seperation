    $("#btnDelete").on("click", function (e) {
           e.preventDefault();
        const voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");

        if (!voucherNo) {
            DevExpress.ui.notify("Voucher number is required", "error", 3000);
            return;
        }

        $.get("/api/ExpenseClaim/CheckClaimStatus", { voucherNo: voucherNo })
            .done(function (result) {
                if (!result) {
                    DevExpress.ui.notify("Claim not found", "error", 3000);
                    return;
                }

                if (result.IsSubmitted) {
                    DevExpress.ui.notify("Claim is already submitted, You cannot delete the Submitted Claim", "error", 4000);
                    return;
                }
                if (result.IsApproved) {
                    DevExpress.ui.notify("Claim is already Approved, You cannot delete the Approved Claim", "error", 4000);
                    return;
                }
                if (result.IsPaid) {
                    DevExpress.ui.notify("Claim is already Paid, You cannot delete the Paid Claim", "error", 4000);
                    return;
                }

                // All false -> confirm and delete
                DevExpress.ui.dialog.confirm("Are you sure you want to delete this claim?", "Confirm Deletion")
                    .done(function (dialogResult) {
                        if (dialogResult) {
                            debugger;
                             const voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
                            $.post("/api/ExpenseClaim/DeleteClaim", { voucherNo: voucherNo })
                                .done(function (deleteResult) {
                                    if (deleteResult.success) {
                                        DevExpress.ui.dialog.alert("Claim Successfully   removed from the database", "Success")
                                                    .done(function () {
                                                            // Attachment Delete
                                        var module = "finance";
                                        $.ajax({
                                                url: `/api/LedgerDocumentsF/DeleteAllVoucherEntry?VoucherNo=${encodeURIComponent(voucherNo)}&module=${encodeURIComponent(module)}`,
                                            type: "POST",
                                            success: function (response) {
                                                if (response.success) {
                                                        DevExpress.ui.notify("Attachments Deleted successfully", "success", 2000);
                                                } else {
                                                        DevExpress.ui.notify("There is no Attachments", "success", 2000);
                                                }
                                            },
                                            error: function (xhr, status, error) {
                                                DevExpress.ui.notify("There is no Attachments" + error, "success", 2000);
                                            }
                                        });
                                                        sessionStorage.setItem("refreshPage", "true");
                                                        history.back();
                                                    });
                                    } else {
                                        DevExpress.ui.notify(deleteResult.message, "error", 3000);
                                    }
                                })
                                .fail(function () {
                                    DevExpress.ui.notify("Error deleting claim", "error", 3000);
                                });
                        }
                    });
            })
            .fail(function () {
                DevExpress.ui.notify("Error checking claim status", "error", 3000);
            });
    });

