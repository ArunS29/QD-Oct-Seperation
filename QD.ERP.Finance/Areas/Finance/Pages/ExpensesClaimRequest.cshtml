              function onClaimedAmountChanged(e) {
        const grid = $("#dataGrid").dxDataGrid("instance");

        // Find the row element and key safely
        const $rowElement = $(e.element).closest(".dx-row");
        const rowKey = grid.getKeyByRowIndex($rowElement.index());
        const rowIndex = grid.getRowIndexByKey(rowKey);

        const claimedValue = e.value || 0;

        grid.cellValue(rowIndex, "ClaimedAmount", claimedValue);
        grid.cellValue(rowIndex, "ApprovedAmount", claimedValue);
    }

    function onApprovedAmountChanged(e) {
        const grid = $("#dataGrid").dxDataGrid("instance");

        const $rowElement = $(e.element).closest(".dx-row");
        const rowKey = grid.getKeyByRowIndex($rowElement.index());
        const rowIndex = grid.getRowIndexByKey(rowKey);

        const approvedValue = e.value || 0;
        const claimedValue = grid.cellValue(rowIndex, "ClaimedAmount") || 0;

        if (approvedValue > claimedValue) {
            DevExpress.ui.notify("Approved Amount Cannot be more than Claimed Amount", "error", 3000);
            grid.cellValue(rowIndex, "ApprovedAmount", claimedValue);
        } else {
            grid.cellValue(rowIndex, "ApprovedAmount", approvedValue);
        }
    }

