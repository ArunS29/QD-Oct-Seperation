    function accountHeadToolbarPreparing(e) {
        const grid = e.component;
        const items = e.toolbarOptions.items;

        // Build our toggle button
        const searchToggle = {
            location: "after",
            widget: "dxButton",
            options: {
                icon: "search",
                hint: "Toggle Search Panel",
               onClick: function () {
                    const visible = grid.option("filterRow.visible");
                    grid.option("filterRow.visible", !visible);
                }

            }
        };

        // Insert right after the built-in Column Chooser button if present
        const ccIndex = items.findIndex(i => i.name === "columnChooserButton");
        if (ccIndex >= 0) {
            items.splice(ccIndex + 1, 0, searchToggle);
        } else {
            // Fallback: just add it to the right side
            items.push(searchToggle);
        }
    }
        function initializeEditMode(entry) {
        // 1️⃣ Set RadioGroup
        let radioGroup = $("#radioGroup").dxRadioGroup("instance");
        radioGroup.option("value", entry.PaymentType);
        currentRadioValue = entry.PaymentType;

        // 2️⃣ Prepare correct store
        let loadAction = currentRadioValue === "Cash Payment"
            ? "GetCPPaymentAccounts"
            : "GetBPPaymentAccounts";

        let newStore = DevExpress.data.AspNet.createStore({
            key: "AccountId",
            loadUrl: "/api/ExpenseClaim/" + loadAction
        });

        // 3️⃣ Apply to DataGrid + DropDownBox
        const accountHeadGrid = $("#accounthead-datagrid").dxDataGrid("instance");
        const dropDownBox = $("#ddAccountHead").dxDropDownBox("instance");

        if (accountHeadGrid) {
            accountHeadGrid.option("dataSource", newStore);
        }
        dropDownBox.option("dataSource", newStore);

        // 4️⃣ Pre-set value to saved AccountId
        dropDownBox.option("value", entry.PaymentAccount);

        // 5️⃣ Also select in grid after it binds
        newStore.load().done(function (data) {
            if (accountHeadGrid && entry.PaymentAccount) {
                accountHeadGrid.selectRows([entry.PaymentAccount], false);
                accountHeadGrid.option("focusedRowKey", entry.PaymentAccount);
            }
        });
    }
            // Prevent non-digit keys and prevent typing beyond 15 digits
    function suppliervatno_onKeyDown(e) {
        const k = e.event.key;

        // allow editing/navigation keys
        const allowed = ["Backspace", "Delete", "ArrowLeft", "ArrowRight", "Tab", "Home", "End"];
        if (allowed.indexOf(k) !== -1) return;

        // allow Ctrl/Cmd combos (copy/paste/select all)
        if (e.event.ctrlKey || e.event.metaKey) return;

        // only digits allowed
        if (!/^\d$/.test(k)) {
            e.event.preventDefault();
            return;
        }

        // block if value length would exceed 15 (consider selection replacement)
        const input = e.element.querySelector('input');
        if (!input) return;
        const current = input.value || "";
        const selStart = input.selectionStart;
        const selEnd = input.selectionEnd;
        const newLength = current.length - (selEnd - selStart) + 1; // +1 for the new digit
        if (newLength > 15) {
            e.event.preventDefault();
        }
    }

    // Handle paste: clean non-digits and trim to 15, then insert
    function suppliervatno_onPaste(e) {
        e.event.preventDefault();
        const pasted = (e.event.clipboardData || window.clipboardData).getData('text') || "";
        const digits = pasted.replace(/\D/g, "").slice(0, 15);

        const input = e.element.querySelector('input');
        const current = input ? input.value || "" : "";
        const selStart = input ? input.selectionStart : 0;
        const selEnd = input ? input.selectionEnd : 0;

        const newVal = (current.slice(0, selStart) + digits + current.slice(selEnd))
                         .replace(/\D/g, "")
                         .slice(0, 15);

        e.component.option('value', newVal);
    }

    // Ensure programmatic changes / other events also keep only digits and max length
    function suppliervatno_onValueChanged(e) {
        const v = e.value || "";
        const cleaned = String(v).replace(/\D/g, "").slice(0, 15);
        if (cleaned !== String(v)) {
            // update only if changed (avoids infinite loop)
            e.component.option("value", cleaned);
        }
    }

