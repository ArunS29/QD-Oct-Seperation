           function onexpenserowremoving(e) {
               debugger;
        const grid = $("#dataGrid").dxDataGrid("instance");
        const row = e.data;
        const rowCount = grid.getVisibleRows().length;

        // ✅ Check if row is completely empty (no data in major fields)
        const isEmptyRow =
            (!row.ExpenseDescription || row.ExpenseDescription.trim() === "") &&
            (!row.BillRefNo || row.BillRefNo.trim() === "") &&
            (!row.BillDate) &&
            (!row.ClaimedAmount || row.ClaimedAmount === 0) &&
            (!row.ApprovedAmount || row.ApprovedAmount === 0) &&
            (!row.AccountId || row.AccountId === null) &&
            (!row.CostCenterCode || row.CostCenterCode === null);

        const claimChildNo = row.ClaimChildNo;

        // 🧩 Helper: add a new blank row
        function addBlankRow() {
               const dataSource = grid.option("dataSource") || [];
                   const voucherNoField = $("#VoucherNo").dxTextBox("instance");
                            if (!Array.isArray(dataSource)) {
                                return;
                            }
                            if (Issubmitted || Isverified || Isapproved) {
                                return;
                            }

                            if (dataSource.length === 0 || Object.keys(dataSource[dataSource.length - 1]).length !== 0) {
                                dataSource.push({
                                    ClaimedAmount: 0.00,
                                    ApprovedAmount: 0.00,
                                    VoucherNo: voucherNoField
                                });
                                grid.option("dataSource", dataSource);
                            }
        }

        // 🧭 CASE 1: Empty unsaved row
        if (isEmptyRow && !claimChildNo) {
            // DevExpress.ui.notify("Empty row removed successfully", "success", 2000);
            e.cancel = true; // allow DevExtreme to remove it

            // If this was the only row → add a new blank one
            if (rowCount === 1) {
                setTimeout(addBlankRow, 300);
            }
            return;
        }

        // 🧭 CASE 2: Saved row (ClaimChildNo exists) — delete via API
        if (claimChildNo) {
            e.cancel = true; // Prevent default DevExtreme deletion behavior

            $.ajax({
                url: '/api/ExpenseClaim/DeleteExpenseChild',
                type: 'POST',
                data: JSON.stringify(claimChildNo),
                contentType: 'application/json',
                success: function (response) {
                    if (response.success) {
                        // DevExpress.ui.notify("Expense row deleted successfully", "success", 2000);

                        const voucherNo = $("#VoucherNo").dxTextBox("instance").option("value");
                        loadExpenseGridData(voucherNo);

                        
                    } else {
                        DevExpress.ui.notify(response.message || "Delete failed", "error", 2000);
                    }
                },
                error: function () {
                    DevExpress.ui.notify("Server error during delete", "error", 2000);
                }
            });
            return;
        }

        // 🧭 CASE 3: No ClaimChildNo but has partial data — just remove it locally
        DevExpress.ui.notify("Row removed", "success", 2000);
        e.cancel = false;
        if (rowCount === 1) {
            setTimeout(addBlankRow, 300);
        }
    }


