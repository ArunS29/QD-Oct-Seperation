<script>
        function onCardClick(e) {

            const button = $(e.element);
            const $dataRow = button.closest(".dx-data-row");
            const $dataGrid = $("#dataGrid").dxDataGrid("instance");
            const rowIndex = $dataRow.index();
            const rowData = $dataGrid.getVisibleRows()[rowIndex].data;


            const claimChildNo = encodeURIComponent(rowData.ClaimChildNo ?? 0);
            const description = encodeURIComponent(rowData.ExpenseDescription || '');
            const approvedAmount = encodeURIComponent(rowData.ApprovedAmount ?? 0);

            const popover = $("#cardPopover").dxPopover("instance");

             // 👉 Set the target to the button that was clicked
              popover.option("target", button);

            // Dynamically update the popover contentTemplate with row-specific URL
            popover.option("contentTemplate", function (contentElement) {
                contentElement.empty();

                $.ajax({
                    url: `/api/ExpenseClaim/ExpenseClaimVAT?claimChildNo=${claimChildNo}&description=${description}&approvedAmount=${approvedAmount}`,
                    type: 'GET',
                    success: function (data) {
                        contentElement.html(data);
                    },
                    error: function () {
                        contentElement.html("<div style='color:red;'>Failed to load content.</div>");
                    }
                });
            });

            // Show the popover
            if (popover.option("visible")) {
                popover.hide();
            } else {
                popover.show();
            }
        }





