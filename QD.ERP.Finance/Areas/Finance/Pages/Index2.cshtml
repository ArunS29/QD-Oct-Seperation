<script>
$(document).ready(function () {
    // 1. Summary Cards AJAX
    const apiEndpoints = [
        { url: "/api/Dashboard/GetTotalClientOutstanding",   target: "#totalClientOutstandingValue",  loader: "#loaderClientOutstanding",  key: "balance" },
        { url: "/api/Dashboard/supplieroutstanding",         target: "#totalSupplierOutstandingValue",loader: "#loaderBillsOutstanding",    key: "balance" },
        { url: "/api/Dashboard/GetBankBalance",              target: "#totalBankBalanceValue",        loader: "#loaderBankBalance",         key: "balance" },
        { url: "/api/Dashboard/GetCashBalance",              target: "#cashBalanceValue",             loader: "#loaderCashBalance",         key: "balance" }
    ];
    function safeSetText(selector, value) { $(selector).text(value); }
    apiEndpoints.forEach(endpoint => {
        $(endpoint.loader).show();
        $.getJSON(endpoint.url)
            .done(response => {
                if (response && (response.success === undefined || response.success) && response[endpoint.key] != null) {
                    safeSetText(endpoint.target, Number(response[endpoint.key]).toLocaleString('en-US'));
                } else {
                    safeSetText(endpoint.target, '0');
                }
            })
            .fail(() => { safeSetText(endpoint.target, '0'); })
            .always(() => $(endpoint.loader).hide());
    });

    // Table Loader (General)
    function loadOutstandingTable(apiUrl) {
        const $body = $("#topOutstandingTableBody");
        $body.html('<tr><td colspan="5" style="text-align:center;color:#b9b9b9;">Loading...</td></tr>');
        $.getJSON(apiUrl, function (data) {
            if (data && Array.isArray(data.data) && data.data.length > 0) {
                let rows = "";
                data.data.forEach(function(row) {
                    rows += `<tr>
                        <td>${row.AccountHead || row.accountHead || ''}</td>
                        <td>${row.Balance != null ? Number(row.Balance).toLocaleString('en-US') : (row.balance != null ? Number(row.balance).toLocaleString('en-US') : '')}</td>
                        <td>${row.OverdueDays != null ? row.OverdueDays : (row.overdueDays != null ? row.overdueDays : '')}</td>
                        <td>${row.AccountGroup || row.accountGroup || ''}</td>
                        <td>${row.AccountHeadNo || row.accountHeadNo || ''}</td>
                    </tr>`;
                });
                $body.html(rows);
            } else {
                $body.html('<tr><td colspan="5" style="text-align:center;color:#e66a6a;">No data found</td></tr>');
            }
        }).fail(function(){
            $body.html('<tr><td colspan="5" style="text-align:center;color:#e66a6a;">Failed to load data</td></tr>');
        });
    }

    // Load default (Client Outstanding)
    loadOutstandingTable("/api/Dashboard/GetClientOutstanding");

    // Tab click handlers
    $(".dashboard-tab").click(function () {
        $(".dashboard-tab").removeClass("active");
        $(this).addClass("active");
        if (this.id === "tabClientOutstanding") {
            loadOutstandingTable("/api/Dashboard/GetClientOutstanding");
        }
        else if (this.id === "tabSupplierOutstanding") {
            loadOutstandingTable("/api/Dashboard/GetBillsPayableOutstanding");
        }
        // Optionally, handle bank/cash tabs
    });

    // Donut Chart
    const donutCtx = document.getElementById('donutChart').getContext('2d');
    new Chart(donutCtx, {
        type: 'doughnut',
        data: {
            labels: ['12%', '7%', '7%', '6%', '5%', '2%'],
