@page
@model QD.ERP.Finance.Areas.Finance.Pages.ExpensesClaimRequestFormModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>VAT Entry Form</title>

    <!-- DevExtreme CSS -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.4/css/dx.light.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: white;
            padding: 5px;
        }

        .form-container {
           
            padding: 5px;
            border-radius: 8px;
            background-color: white;
            max-width: 900px;
            margin: auto;
        }

        table {
            width: 100%;
            border-spacing: 5px;
        }

        table td, th {
           
            vertical-align: top;
            padding: 3px;
        }

        input[type="text"], textarea {
            width: 100%;
            padding: 2px;
            box-sizing: border-box;
            border-radius: 2px;
            border: 1px solid #ccc;
            color: black;
        }

        textarea {
            resize: none;
        }

        .btn {
            background-color: #d4e6fb;
            color: #000;
            padding: 8px 16px;
            margin-right: 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .add-btn {
            background-color: #d4e6fb;
            color: #000;
            padding: 5px 12px;
            border: none;
           
            margin-left: 10px;
            cursor: pointer;
            font-size: 20px;
            vertical-align: top;
        }

        .narration-cell {
            position: relative;
            
        }

            /* .narration-cell a { */
            /*     a {
                position: absolute;
                right: 70px;
                top: 8px;
                color: white;
                text-decoration: underline;
                font-size: 14px;
                cursor: pointer;
            } */

        .highlight {
            background-color: #ffffb3;
        }

        /* New styles for labels above inputs */
        .input-group {
            display: flex;
            flex-direction: column;
        }

            .input-group label {
                margin-bottom: 4px;
                font-weight: bold;
                color: white;
            }
            flex-row {
                display:flex;
                align-items: end;
            }
    </style>
</head>

<body>

    <div class="form-container">
        <table>
            <tr class="flex-row" >
                <td colspan="2"  style="padding-top: 27px;">
                    @(Html.DevExtreme().Button()
                        .ID("calculateVat") 
                        .Text("Calculate VAT")
                        .Height("80px")
                        .Width("100%")
                         @* .OnClick("ReplicateUserAccountOnClick") *@
                     )
                </td>
                <td colspan="2" style="padding-top: 27px;">
                    @(Html.DevExtreme().Button()
                                        .ID("saveEntry")
                                        .Text("Save Entry")
                                        .Height("80px")
                                        .Width("100%")
                    )
                </td>
                  
                <td colspan="2" style="display:flex; align-items: end;">
                 
                        @(Html.DevExtreme().SelectBox()
                              .ID("taxPercentage")
                              .Label("Tax Percentage")
                              .Width("100%")
                              .LabelMode(EditorLabelMode.Floating)
                              )
                    @(Html.DevExtreme().Button()
                                        @* .ID("saveEntry") *@
                                        .Icon("close")
                                        )
                </td>
            </tr>

            <tr class="flex-row">
                <td colspan="2">
                   
                        @(Html.DevExtreme().TextBox()
                            .ID("taxableAmount")
                            .Width("100%")
                            .Label("Taxable Amount")
                            .LabelMode(EditorLabelMode.Floating)
                            @* .ElementAttr("class", "input-group") *@
                            )
            
                   
                </td>
                <td colspan="2">

                    @(Html.DevExtreme().TextBox()
                            .ID("vatAmount")
                            .Label("VAT Amount")
                            .Width("100%")
                            .LabelMode(EditorLabelMode.Floating)
                            .ElementAttr("class", "input-group")
                            )
                    
                </td>
                <td colspan="2">
                    @(Html.DevExtreme().TextBox()
                            .ID("roundOff")
                            .Label("Round Off")
                            .Width("100%")
                            .LabelMode(EditorLabelMode.Floating)
                            .ElementAttr("class", "input-group")
                            )
                    
                </td>
                <td colspan="2">
                    @(Html.DevExtreme().TextBox()
                        .ID("billAmount")
                        .Label("Bill Amount")
                        .Width("100%")
                        .LabelMode(EditorLabelMode.Floating)
                        .ElementAttr("class", "input-group")
                        )
                   
                </td>
            </tr>

            <tr class="flex-row">
                <td colspan="3">
                    @(Html.DevExtreme().SelectBox()
                        .ID("supplierName")
                        .Label("Supplier Name")
                        .Width("100%")
                        .LabelMode(EditorLabelMode.Floating)
                        @* .ElementAttr("class", "input-group") *@
                        )
                    
                </td>
                <td colspan="3">
                    @(Html.DevExtreme().TextBox()
                        @* .ID("supplierName") *@
                        .Label("Supplier Name In Arabic")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        .ElementAttr("class", "input-group")
                        )

                </td>
            </tr>

            <tr class="flex-row">
                <td colspan="3">
                    @(Html.DevExtreme().TextBox()
                    @* .ID("supplierName") *@
                        .Label("Supplier VAT No")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        .ElementAttr("class", "input-group")
                        )
                </td>
                <td colspan="3">
                    @(Html.DevExtreme().SelectBox()
                        .ID("purchaserName")
                        .Label("Purchaser Name")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("100%")
                        @* .ElementAttr("class", "input-group") *@
                        )
                </td>
            </tr>

            <tr  class="flex-row">
                <td colspan="4">
                    @(Html.DevExtreme().TextArea()
                                        .Label("Line Narration")
                                        .LabelMode(EditorLabelMode.Floating)
                                        .Width("100%")
                                        )
                </td>
                <td colspan="3">
                    <a style="color:blue;" href="#"><u>Use Expense Description</u></a>
                </td>
                <td colspan="1">
                    @(Html.DevExtreme().Button()
                                        .Icon("plus")
                                        .Width(50)
                                        )
                </td>
                
            </tr>


            <tr class="flex-row">
                <td colspan="4">
                    @(Html.DevExtreme().SelectBox()
                        .ID("costEmployees")
                        .Label("Cost Allocation for Employees")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width("90%")
                        @* .ElementAttr("class", "input-group") *@
                        )
                   
                </td>
                <td colspan="4">
                    @(Html.DevExtreme().SelectBox()
                        .ID("costProperty")
                        .Label("Cost Allocation for Property/Equipment")
                        .Width("90%")
                        .LabelMode(EditorLabelMode.Floating)
                    @* .ElementAttr("class", "input-group") *@
                                        )

                </td>
            </tr>
        </table>
    </div>

    <!-- DevExtreme JS -->
    <script src="https://cdn3.devexpress.com/jslib/23.2.4/js/jquery.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.4/js/jszip.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.4/js/dx.all.js"></script>

    <script>
        $(function() {
            $("#taxPercentage").dxSelectBox({
                dataSource: ["5%", "10%", "15%"],
                showClearButton: true
            });

            $("#supplierName").dxSelectBox({
                dataSource: ["Supplier A", "Supplier B", "Supplier C"],
                searchEnabled: true,
                showClearButton: true
            });

            $("#purchaserName").dxSelectBox({
                dataSource: ["Purchaser X", "Purchaser Y"],
                searchEnabled: true,
                showClearButton: true
            });

            $("#costEmployees").dxSelectBox({
                dataSource: ["Employee 1", "Employee 2"],
                searchEnabled: true,
                showClearButton: true
            });

            $("#costProperty").dxSelectBox({
                dataSource: ["Equipment A", "Equipment B"],
                searchEnabled: true,
                showClearButton: true
            });
        });
    </script>

</body>
</html>
