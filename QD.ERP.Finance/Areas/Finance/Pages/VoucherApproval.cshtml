@page
@model QDWEB.Pages.Shared.GridforAssetViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Voucher Verification";

}
<link rel="stylesheet" href="~/css/animationCardFinance.css" />

<style type="text/css">
    .kpi-card {
        padding: 15px;
        border-radius: 16px;
        color: white;
        margin: 10px;
        width: 250px;
        display: inline-block;
    }

        .kpi-card .header {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .kpi-card .value {
            font-size: 1rem;
            margin: 3px 0;
        }

        .kpi-card .clickable {
            cursor: pointer;
        }

    .blue {
        background: linear-gradient(to right, #2193b0, #6dd5ed);
    }

    .green {
        background: linear-gradient(to right, #56ab2f, #a8e063);
    }

    .purple {
        background: linear-gradient(to right, #8e2de2, #4a00e0);
    }

    .dx-datagrid .dx-row {
        border-bottom: 1px solid #ccc;
    }

    .selected-row {
        background-color: #d1e7dd !important; /* Light green background */
    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        justify-content: start;
        align-items: center;
        margin: 0px 20px !important;
    }

    /* Context Menu Styling */
    .dx-context-menu {
        border-radius: 8px !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2) !important;
        background: #fff !important;
        padding: 5px;
    }

    /* Menu Item Styling */
    .dx-menu-item {
        font-size: 14px !important;
        font-weight: 500 !important;
        color: #333 !important;
        padding: 8px 15px !important;
        border-radius: 5px !important;
        transition: background 0.3s ease-in-out;
    }

        /* Hover Effect */
        .dx-menu-item:hover {
            background:  var(--title-background-color) !important;
            color: white !important;
        }

        /* Icons */
        .dx-menu-item .dx-icon {
            font-size: 18px !important;
            margin-right: 8px;
            vertical-align: middle;
        }

    /* Add smooth animations */
    .dx-overlay-content {
        animation: fadeIn 0.2s ease-in-out;
    }

    .voucher-actions {
        list-style-type: none;
        padding: 0;
        margin: 0;
        background-color: #fff;
        border-radius: 5px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .dx-icon-edit::before { color: #007bff !important; }
    .dx-icon-find::before { color: #6c757d !important; }
    .dx-icon-check::before { color: green !important; }
    .dx-icon-close::before { color: red !important; }
    .dx-icon-card::before { color: darkgreen !important; }
    .dx-icon-user::before { color: orange !important; }
    .dx-icon-unlock::before { color: purple !important; }

        .voucher-actions .menu-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 14px;
            color: #333;
            border-bottom: 1px solid #f0f0f0;
        }

            .voucher-actions .menu-item:hover {
                background-color: #f0f0f0;
            }

            .voucher-actions .menu-item:last-child {
                border-bottom: none;
            }


    .dx-icon {
        font-size: 16px;
        margin-right: 10px;
    }


    .dx-checkbox {
        margin: 10px;
    }
    
    .menu-item .dx-icon-edit {
        color: #007bff;
    }

    .menu-item .dx-icon-find {
        color: #28a745;
    }

    .menu-item .dx-icon-check {
        color: #ffc107;
    }

    .menu-item .dx-icon-trash {
        color: #dc3545;
    }

    .menu-item .dx-icon-selectall {
        color: #17a2b8;
    }

    .menu-item .dx-icon-todo {
        color: #6c757d;
    }

    .menu-item .dx-icon-unlock {
        color: #6610f2;
    }


    .menu-item:hover i {
        opacity: 0.8;
    }

    #dataGrid .dx-header-row .dx-datagrid-text-content {
        font-weight: bold;
        color: black;
    }
    .headerBolder{
        white-space: normal;
        text-align: center;
        font-weight: bold;
    }

    #dataGrid .debit-pill, #dataGrid .credit-pill {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    #dataGrid .debit-pill {
        background: rgba(255, 77, 79, .15);
        color: #ff4d4f;
    }

    #dataGrid .credit-pill {
        background: rgba(82, 196, 26, .15);
        color: #52c41a;
    }
</style>
