    function loadVoucherApprovals() {
        const urlParams = new URLSearchParams(window.location.search);
        const docType = urlParams.get('docType');
        const status = urlParams.get('status');

        // ✅ If coming from notification → load filtered data & exit early
        if (docType && status) {
            $.getJSON(`/api/VoucherApproval/GetVoucherApprovalFiltered?docType=${encodeURIComponent(docType)}&status=${encodeURIComponent(status)}`, function (data) {
                const grid = $("#dataGrid").dxDataGrid("instance");
                grid.option("dataSource", data);
                injectHeaderSVG();
                grid.refresh();
                injectHeaderSVG();
                updateCards(data);
            });
            return; // prevent normal flow
        }

        // ✅ Normal existing logic (untouched)
        const startDateComponent = $("#VoucherDate").dxDateBox("instance");
        const endDateComponent = $("#EffectiveDate").dxDateBox("instance");

        if (!startDateComponent || !endDateComponent) {
            console.warn("DateBox components not found.");
            return;
        }

        const startDate = startDateComponent.option("value");
        const endDate = endDateComponent.option("value");

        if (!startDate || !endDate) {
            DevExpress.ui.notify("Please select both start and end dates.", "warning", 2000);
            return;
        }

        const voucherType = [
            "Bank Payment", "Cash Payment",
            "Bank Receipts", "Cash Receipts",
            "Sales", "Purchases", "Journal"
        ];

        const useFormattedDate = true;
        const formattedStart = useFormattedDate
            ? startDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })
            : startDate.toISOString();

        const formattedEnd = useFormattedDate
            ? endDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })
            : endDate.toISOString();

        $.ajax({
            url: '/api/VoucherApproval/GetVoucherApprovals',
            type: 'GET',
            data: {
                startDate: formattedStart,
                endDate: formattedEnd,
                voucherTypes: voucherType.join(",")
            },
            success: function (data) {
                const targetGrid = $("#dataGrid").dxDataGrid("instance");
                targetGrid.option("dataSource", data);
                injectHeaderSVG();
                targetGrid.refresh();
                injectHeaderSVG();
                updateCards(data);
            },
            error: function (err) {
                DevExpress.ui.notify("Failed to load data", "error", 2000);
                console.error(err);
            }
        });
    }


    function onAuditCheckChanged(value, data) {
        if (!value) return; // Only handle when checked

        DevExpress.ui.dialog.confirm("Are you sure you want to audit this voucher?", "Confirm Audit")
            .done(function (dialogResult) {
                if (!dialogResult) return;

                $.ajax({
                    url: '/api/VoucherApproval/UpdateAuditVerification',
                    type: 'POST',
                    data: {
                        voucherNo: data.VoucherNo
                    },
                    success: function () {
                    const grid = $("#dataGrid").dxDataGrid("instance");
                    const rowIndex = grid.getRowIndexByKey(data.VoucherNo);

                    if (rowIndex >= 0) {
                        // ✅ Clone the data and update required fields
                        const updatedData = Object.assign({}, data, {
                            IsAuditVerified: true,
                            AuditVerifiedBy: "@HttpContext.Session.GetString("UserName")", // Or return from API
                            AuditVerifiedOn: new Date().toISOString()
                        });

                        // ✅ Update individual cell values instead of full row reload
                        grid.cellValue(rowIndex, "IsAuditVerified", true);
                        grid.cellValue(rowIndex, "AuditVerifiedBy", updatedData.AuditVerifiedBy);
                        grid.cellValue(rowIndex, "AuditVerifiedOn", updatedData.AuditVerifiedOn);

                        // ✅ Get the cell element for VoucherNo column and apply background color
                        const rowElement = grid.getRowElement(rowIndex);
                        const columnIndex = grid.getVisibleColumnIndex("VoucherNo");
                        if (columnIndex >= 0) {
                            rowElement.find("td").eq(columnIndex).css("background-color", "rgb(192, 255, 192)");
                        }

                        DevExpress.ui.notify("Voucher audited successfully!", "success", 2000);

                        // Optional: refresh only that row to re-render templates properly
                        grid.repaintRows([rowIndex]);

                        injectHeaderSVG();
                    }
                }


                    ,
                    error: function () {
                        DevExpress.ui.dialog.alert("Failed to update audit status.", "Error");
                    }
                });
            });
    }


