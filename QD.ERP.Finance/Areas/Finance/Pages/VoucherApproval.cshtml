        function updateCards(data) {
        const now = new Date();
        const currentYear = now.getFullYear();
        const currentMonth = now.getMonth();

        const uniqueVoucherNos = new Set();
        const approvedVoucherNos = new Set();
        const verifiedVoucherNos = new Set();

        let voucherDateTotal = 0;
        let voucherDateMonth = 0;
        let voucherDateYear = 0;

        data.forEach(item => {
            const voucherNo = item.VoucherNo;

            // === Unique VoucherNo Collection ===
            if (voucherNo) {
                uniqueVoucherNos.add(voucherNo);

                if (item.IsApproved === true || item.IsApproved === 1) {
                    approvedVoucherNos.add(voucherNo);
                }

                if (item.IsAuditVerified === true || item.IsAuditVerified === 1) {
                    verifiedVoucherNos.add(voucherNo);
                }
            }

            // === VoucherDate calculations ===
            if (item.VoucherDate) {
                const voucherDate = new Date(item.VoucherDate);
                if (!isNaN(voucherDate)) {
                    voucherDateTotal++;

                    if (voucherDate.getFullYear() === currentYear) {
                        voucherDateYear++;

                        if (voucherDate.getMonth() === currentMonth) {
                            voucherDateMonth++;
                        }
                    }
                }
            }
        });

        const format = num => num.toLocaleString(undefined, {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        });

        // === CardDebit: Voucher Approval Stats ===
        const totalVouchers = uniqueVoucherNos.size;
        const approvedCount = approvedVoucherNos.size;
        const pendingApproval = totalVouchers - approvedCount;

        const debitSlider = $("#cardDebit .value-slider span");
        const debitOverlay = $("#cardDebit .overlay .detail");

        debitSlider.eq(0).html(`<strong>Total: ${format(approvedCount)}</strong>`);
        debitSlider.eq(1).html(`<strong>Approved: ${format(approvedCount)}</strong>`);
        debitSlider.eq(2).html(`<strong>Pending: ${format(pendingApproval)}</strong>`);

        debitOverlay.eq(0).html(`Total: ${format(totalVouchers)}`);
        debitOverlay.eq(1).html(`Approved: ${format(approvedCount)}`);
        debitOverlay.eq(2).html(`Pending: ${format(pendingApproval)}`);

        // === CardCredit: Audit Verification Stats ===
        const verifiedCount = verifiedVoucherNos.size;
        const pendingVerification = totalVouchers - verifiedCount;

        const creditSlider = $("#cardCredit .value-slider span");
        const creditOverlay = $("#cardCredit .overlay .detail");

        creditSlider.eq(0).html(`<strong>Total: ${format(verifiedCount)}</strong>`);
        creditSlider.eq(1).html(`<strong>Verified: ${format(verifiedCount)}</strong>`);
        creditSlider.eq(2).html(`<strong>Pending: ${format(pendingVerification)}</strong>`);

        creditOverlay.eq(0).html(`Total: ${format(totalVouchers)}`);
        creditOverlay.eq(1).html(`Verified: ${format(verifiedCount)}`);
        creditOverlay.eq(2).html(`Pending: ${format(pendingVerification)}`);

        // === CardVoucher: Count based on VoucherDate ===
        const voucherSlider = $("#cardVoucher .value-slider span");
        const voucherOverlay = $("#cardVoucher .overlay .detail");

        voucherSlider.eq(0).html(`<i class="fas fa-file-invoice-dollar"></i> Total: ${format(voucherDateTotal)}`);
        voucherSlider.eq(1).html(`<i class="fas fa-file-invoice-dollar"></i> This Month: ${format(voucherDateMonth)}`);
        voucherSlider.eq(2).html(`<i class="fas fa-file-invoice-dollar"></i> This Year: ${format(voucherDateYear)}`);

        voucherOverlay.eq(0).html(`<i class="fas fa-file-invoice-dollar"></i> Total: ${format(voucherDateTotal)}`);
        voucherOverlay.eq(1).html(`<i class="fas fa-file-invoice-dollar"></i> This Month: ${format(voucherDateMonth)}`);
        voucherOverlay.eq(2).html(`<i class="fas fa-file-invoice-dollar"></i> This Year: ${format(voucherDateYear)}`);

       
    }

  
