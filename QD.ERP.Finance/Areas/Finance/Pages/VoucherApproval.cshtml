            .DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy")
            .Visible(false)
           ;

                columns.Add().DataField("VoucherModifiedBy").Caption(new JS("formatMessage('Modified By')")).Width(120)
            .Visible(false)
           ;

                columns.Add().DataField("VoucherModifiedOn").Caption(new JS("formatMessage('Modified On')")).Width(120)
            .DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy")
            .Visible(false)
           ;

                columns.Add().DataField("AuditVerifiedOn").Caption(new JS("formatMessage('Audit Verified On')")).Width(120)
            .DataType(GridColumnDataType.Date).Format("dd-MMM-yyyy")
            .Visible(false)
        ;


            })
        .Summary(summary =>
        {
            summary.TotalItems(items =>
            {
                items.Add().Column("VoucherNo").SummaryType(SummaryType.Count).DisplayFormat("{0}");
                items.Add().Column("DebitAmount").SummaryType(SummaryType.Sum).CustomizeText(
        @"function(e) {
    return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }");
                items.Add().Column("CreditAmount").SummaryType(SummaryType.Sum).CustomizeText(
        @"function(e) {
    return e.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }");
            });
        })
        .ColumnChooser(columnChooser => columnChooser.Enabled(true).Title(new JS("formatMessage('Column Chooser')")).Mode(GridColumnChooserMode.DragAndDrop))
        .AllowColumnReordering(true)
        .AllowColumnResizing(true)
        .ColumnFixing(fixing => fixing.Enabled(true))
        .ColumnAutoWidth(true)
        .HeaderFilter(filter => filter.Visible(false))
        .ColumnResizingMode(ColumnResizingMode.Widget)
        .Height("60vh")
        .Width("100%")
        .Paging(paging => paging.Enabled(false))
        .Scrolling(scrolling => scrolling.Mode(GridScrollingMode.Virtual))
