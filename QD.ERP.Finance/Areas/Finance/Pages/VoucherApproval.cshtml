         function injectHeaderSVG() {
               $.ajax({
                   url: '/api/AccountingLedgers/GetCurrencyIcon',
                   type: 'GET',
                   success: function (response) {
                       
                       let svgIcon = response.Icon;
                       if (!svgIcon) return;

                       // Set default width/height for SVG if needed
                       if (svgIcon.startsWith("<svg")) {
                           svgIcon = svgIcon.replace(/<svg\b([^>]*)>/, `<svg width="12" height="12" $1>`);
                       } else {
                           // If symbol is text (e.g., "$" or "SAR"), wrap in styled span
                           svgIcon = `<span style="font-weight: bold;">${svgIcon}</span>`;
                       }

                       let $grid = $('#dataGrid');
                       let gridInstance = $grid.dxDataGrid("instance");
                       if (!gridInstance) return;

                       $grid.find(".dx-header-row td").each(function () {
                           const $cell = $(this);

                           const $debitHeader = $(".debit-header");
                           const debitText = $debitHeader.data("original-text") || $debitHeader.text().trim();
                           $debitHeader.data("original-text", debitText);
                           $debitHeader.html(`
                               <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                   ${svgIcon}
                                   <span style="font-weight: bold;">${debitText}</span>
                               </div>
                           `);

                           const $creditHeader = $(".credit-header");
                           const creditText = $creditHeader.data("original-text") || $creditHeader.text().trim();
                           $creditHeader.data("original-text", creditText);
                           $creditHeader.html(`
                               <div style="display: flex; align-items: center; justify-content: center; gap: 4px;">
                                   ${svgIcon}
                                   <span style="font-weight: bold;">${creditText}</span>
                               </div>
                           `);


                       });
                   },
                   error: function (xhr) {
                       console.error("Failed to load currency icon:", xhr.responseText);
                   }
               });
           }

