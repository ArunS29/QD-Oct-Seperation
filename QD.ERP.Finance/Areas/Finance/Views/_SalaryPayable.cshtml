                // Wait for the content to load completely
                dropdownBox.on("opened", function () {
                    // Locate the DataGrid inside the DropDownBox
                    var dataGridElement = $("#againstDropDownBoxPayable").find(".dx-datagrid");

                    if (dataGridElement.length > 0) {
                        var dataGrid = dataGridElement.dxDataGrid("instance");

                        if (dataGrid) {
                            // Get selected row data
                            selectedRowData = dataGrid.getSelectedRowsData();
                            if (selectedRowData.length > 0) {
                                // Assign selected row values to VE
                                VE.ReferenceNo = selectedRowData[0].ReferenceNo;
                                VE.EmployeeNo = selectedRowData[0].EmployeeNo;
                                // Uncomment if needed
                                VE.EmployeeName = selectedRowData[0].EmployeeName;
                                empName = VE.EmployeeName;
                                console.log("Selected ReferenceNo:", VE.ReferenceNo);
                                console.log("Selected EmployeeNo:", VE.EmployeeNo);
                            } else {
                                console.log("No row selected.");
                            }
                        } else {
                            console.error("DataGrid instance not found.");
                        }
                    } else {
                        console.error("DataGrid element not found inside DropDownBox.");
                    }
                });
            } else {
                console.error("DropDownBox instance not found.");
            }





            $.ajax({
                type: "POST",
                url: `/api/LedgerAccountMaster/AddEmployeeEntry?EmployeeName=${encodeURIComponent(employeeval)}`, // Pass value as a query parameter
                // url: "/api/LedgerAccountMaster/AddEmployeeEntry?MasterGroup=${encodeURIComponent(selectedValue)}`",
                contentType: "application/json",
                data: JSON.stringify(VE),
                dataType: "json",
                success: function (response) {
                    $("#salarydataGrid").dxDataGrid("instance").option("dataSource", response.data);
                    // DevExpress.ui.notify("Data saved successfully!", "success", 2000);
                },
                error: function (xhr) {
                    DevExpress.ui.notify(xhr.responseJSON?.message || "An error occurred.", "error", 2000);
                },
            });
        } else {
            DevExpress.ui.notify("Please fill required details!", "error", 2000);
        }
    }



