<script>

    // Function to hide the popup
    function hidePopup() {
        document.getElementById('SalaryPaidEntryPopup').style.display = 'none';
        document.getElementById('popupOverlay').style.display = 'none';
    }


    function hidePopup() {
        const popup = document.getElementById("SalaryPaidEntryPopup");
        if (popup) {
            popup.style.display = "none"; // Attempt to hide

        } else {
            console.error("Popup element not found!");
        }
    }


    $("#btncancel").on("click", function (e) {
        e.preventDefault();

        // Get the instance of the SalaryPaidEntryPopup
        const salaryPaidEntryPopup = $("#SalaryPaidEntryPopup").dxPopup("instance");


        if (salaryPaidEntryPopup) {

            const content = salaryPaidEntryPopup.content();

            const ddbInstance = $("#accountEmployeeDropDownBox").dxDropDownBox("instance");
            ddbInstance.option("value", "");


            const ddbInstance1 = $("#againstDropDownBoxPayable").dxDropDownBox("instance");
            ddbInstance1.option("value", "-");




            // Reset the number box value to "0.00"
            const voucherAmountBox = $("#txtVoucherAmount1").dxNumberBox("instance");
            if (voucherAmountBox) {
                voucherAmountBox.option("value", "0.00");
            }

            // Clear the salarydataGrid by setting its dataSource to an empty array
            const dataGrid = $("#salarydataGrid").dxDataGrid("instance");
            if (dataGrid) {
                dataGrid.option("dataSource", []);
            }

            // Hide the popup
            salaryPaidEntryPopup.hide();


            const grid = $("#againstDropDownBoxPayable").dxDropDownBox("instance");
            const dataSource = grid.getDataSource();
            dataSource.reload();


        }
    });

    function reloademployeedetails() {

        $.ajax({
            type: "GET",
            url: "/api/LedgerAccountMaster/GetEmployeeDetails",
            contentType: "application/json",
            dataType: "json",
            success: function (response) {
                if (response) {
                    // Notify user of successful reload
                    console.log(response);
                    dataGridEmployeeSelectionChanged({ selectedRowKeys: response.data });
                    DevExpress.ui.notify("Employee details reloaded successfully!", "success", 2000);
                } else {
                    DevExpress.ui.notify("Update failed: Unable to reload employee details!", "error", 2000);
                }
            },
            error: function (xhr, status, error) {
                // Notify user of the error
                DevExpress.ui.notify("Error reloading employee details: " + error, "error", 2000);
            }
        });
    }




    function reloademployeeagainstpayable() {
        if (!employeeval) {
            DevExpress.ui.notify("Employee value is not defined!", "warning", 2000);
            return;
        }

        // Fetch data via AJAX
        $.ajax({
            type: "GET",
            url: `/api/LedgerAccountMaster/GetAgainstPayable?inputParameter=${encodeURIComponent(employeeval)}`,
            success: function (response) {
                // Debugging: Log the response
                console.log(response);

                if (response) {
                    const dropdownBox = $("#againstDropDownBoxPayable").dxDropDownBox("instance");
                    if (dropdownBox) {
                        // Update the DataSource dynamically
                        const dataGrid = $("<div>")
                            .dxDataGrid({
                                dataSource: response, // Use the fetched data
                                keyExpr: "EmployeeNo",
                                columns: [
                                    { dataField: "EmployeeNo", caption: "Employee No" },
                                    { dataField: "EmployeeName", caption: "Employee Name" },
                                    { dataField: "ReferenceNo", caption: "Reference No" },
                                    { dataField: "PayableAmount", caption: "Payable Amount" },
                                    { dataField: "Paid", caption: "Paid" },
                                    { dataField: "Balance", caption: "Balance" }
                                ],
                                showBorders: true,
                                selection: {
                                    mode: "single"
                                },
                                hoverStateEnabled: true,
                                paging: {
                                    pageSize: 15
                                },
                                filterRow: {
                                    visible: true
                                },
                                scrolling: {
                                    mode: "virtual"
                                },
                                height: 345,
                                deferredRendering: true, // Ensure grid is rendered after data is ready
                                onSelectionChanged: function (e) {
                                    // Set selected key in DropDownBox
                                    const selectedData = e.selectedRowsData[0];
                                    if (selectedData) {
                                        dropdownBox.option("value", selectedData.ReferenceNo);

                                    }
                                }
                            });

                        // Assign the new template to the DropDownBox
                        dropdownBox.option("contentTemplate", function () {
                            return dataGrid;
                        });

                    }
                } else {
                    DevExpress.ui.notify("No data available to reload!", "warning", 2000);
                }
            },
            error: function (xhr, status, error) {
                DevExpress.ui.notify("Error reloading employee details: " + error, "error", 2000);
            }
        });
    }





    function dataGridSelectionChangedPaymentAccount(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#SPaccountDropDownBox").dxDropDownBox("instance");

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }

    }



    function dataGridEmployeeSelectionChanged(e) {
        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#accountEmployeeDropDownBox").dxDropDownBox("instance");
        employeeval = selectedKey;

        if (selectedKey) {
            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }
        }
        reloademployeeagainstpayable();


    }
    function dataGridAgainstPayableSelectionChanged(e) {

        const selectedKey = e.selectedRowKeys[0];
        const ddbInstance = $("#againstDropDownBoxPayable").dxDropDownBox("instance");
        const payableAmount = e.selectedRowsData[0].PayableAmount;

        if (selectedKey) {

            ddbInstance.option("value", selectedKey);
            if (ddbInstance.option("opened")) {
                ddbInstance.close();
            }

        }

    }




    function addSalaryPaidEntry() {
        // var AccountEmployeeValidator = $("#accountEmployeeDropDownBox").dxValidator("instance");
        var AccountDropDownPayableValidator = $("#againstDropDownBoxPayable").dxValidator("instance");
        var voucherAmtValidator = $("#txtVoucherAmount1").dxValidator("instance");
