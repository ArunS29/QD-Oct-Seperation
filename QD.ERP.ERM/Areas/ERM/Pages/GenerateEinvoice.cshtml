@page
@model QD.ERP.ERM.Areas.ERM.Pages.GenerateEinvoiceModel
@{
}

<style>
    .panel {
        background: #dbeaf7; /* light blue background */
        border: 2px solid #c2d5ea;
        padding: 22px;
        border-radius: 6px;
        width: 760px;
        position: relative;
        font-family: "Segoe UI", Roboto, Arial, sans-serif;
    }

    .action-block {
        margin-bottom: 36px;
    }

    /* Big button look: dark rounded rectangle */
    .big-action-btn .dx-button-content {
        display: block; /* use template content only */
        padding: 0;
    }

    .btn-template {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        background: linear-gradient(#4b4b4b, #3d3d3d);
        color: #efefef;
        border-radius: 8px;
        box-shadow: 0 2px 0 rgba(0,0,0,0.25) inset;
    }

    .btn-title {
        font-size: 22px;
        font-weight: 500;
        letter-spacing: 0.2px;
    }

    .btn-subtext {
        margin-top: 6px;
        font-size: 12px;
        color: #222;
    }

    /* right-side icon box */
    .btn-icon-box {
        min-width: 56px;
        height: 56px;
        border-radius: 6px;
        background: linear-gradient(#2d2d2d,#1f1f1f);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 18px;
    }

        .btn-icon-box .icon {
            border: 2px dashed #3ea8e6;
            width: 28px;
            height: 18px;
            display: inline-block;
        }

    /* small numbered badges */
    .badge {
        display: inline-block;
        width: 18px;
        height: 18px;
        line-height: 18px;
        text-align: center;
        border-radius: 50%;
        background: #eeb;
        color: #a00;
        font-size: 11px;
        margin-left: 4px;
    }

    /* caption under button */
    .caption {
        margin-top: 8px;
        font-size: 13px;
        color: #2f4f6f;
        font-weight: 600;
    }

    /* close button bottom-right */
    .close-area {
        position: absolute;
        right: 18px;
        bottom: 14px;
    }

    /* responsive tweak */
    @@media (max-width: 820px) {
        .panel

    {
        width: 100%;
    }

    }
</style>

<div class="panel">
    <div style="margin-bottom:14px;">
        <strong>Generate eInvoice</strong>
    </div>

    <div class="action-block">
        @(Html.DevExtreme().Button()
                .ID("btnSummary")
                .Width(660)
                .Height(86)
                .ElementAttr(new { @class = "big-action-btn" })
                .Template(@<text>
            <div class="btn-template">
                <div style="flex:1">
                    <div class="btn-title">Create Summary VAT Invoice</div>
                </div>
                <div class="btn-icon-box"><span class="icon"></span></div>
            </div>
        </text>)
                .OnClick("onCreateSummary")
                )
        <div class="caption">* Generate eInvoice with Single Summary Line in Invoice as Total.</div>
    </div>

    <div class="action-block">
        @(Html.DevExtreme().Button()
                .ID("btnDetailed")
                .Width(660)
                .Height(86)
                .ElementAttr(new { @class = "big-action-btn" })
                .Template(@<text>
            <div class="btn-template">
                <div style="flex:1">
                    <div class="btn-title">
                        Create Detailed VAT Invoice
                        <span class="badge">1</span>
                        <span class="badge">2</span>
                    </div>
                </div>
                <div class="btn-icon-box"><span class="icon"></span></div>
            </div>
        </text>)
                .OnClick("onCreateDetailed")
                )
        <div class="caption">* Generate eInvoice with Multiple Line Items in Invoice Detailed.</div>
    </div>

    <div class="close-area">
        @(Html.DevExtreme().Button()
                .ID("btnClose")
                .Text("Close")
                .Width(140)
                .Height(46)
                .Icon("close")
                .OnClick("onClosePopover")
                )
    </div>
</div>
<script>
    function onCreateSummary() {
        DevExpress.ui.notify("Creating summary eInvoice...", "info", 2000);

        $.ajax({
            url: '/MaterialReceipt1/CreateSummary',
            type: 'POST',
            data: {
                invoiceNo: $("#SelectedInvoiceNo").val(),
                invoiceDueDate: $("#DueDate").val()
            },
            success: function (res) {
                if (res.success) {
                    DevExpress.ui.notify("Summary Invoice Created", "success", 2000);
                    window.location.href = "/Invoice/View?invoiceNo=" + res.invoiceNo;
                } else {
                    DevExpress.ui.notify(res.message || "Failed to create invoice", "error", 2000);
                }
            },
            error: function (xhr) {
                DevExpress.ui.notify("Error: " + xhr.responseText, "error", 3000);
            }
        });
    }

    function onCreateDetailed() {
        DevExpress.ui.notify("Creating detailed eInvoice...", "info", 2000);
        // TODO: Add your detailed API logic here
    }

    function onClosePopover() {
        const popover = $("#GenerateEinvoicePopover").dxPopover("instance");
        popover.hide();
    }

</script>
