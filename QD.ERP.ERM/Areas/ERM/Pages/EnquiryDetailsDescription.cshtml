@page
@model QD.ERP.ERM.Areas.ERM.Pages.EnquiryDetailsDescriptionModel
@{
}

<style>

    .container {
        display: none !important;
    }

    .frame {
        display: none !important;
    }

    .footerContainer {
        display: none !important;
    }

    .bodyContainer {
        display: flex;
        justify-content: center;
    }

    .imagecontainer {
        border-bottom: 2px;
    }

    .mainContainer {
        margin-top: 1em;
        width: 100%;
    }

    .playIcon {
        display: none;
    }

    .modal-content {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70%;
        max-width: 1400px;
        height: 90%;
        max-height: 470px;
        background: white;
        border-radius: 8px;
        padding: 0;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }
</style>

<div style="padding: 10px; border-radius: 5px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <label style="font-weight: bold;">Detailed Description / Specification:</label>
        <div>
            @(Html.DevExtreme().Button()
                        .ID("btnUseDetailedDescription")
                        .Text("Use Detailed Description")
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Contained)
                        .ElementAttr("style", "margin-right: 10px;")
                        //.OnClick("getDetailedDescription1")
                        )
            @(Html.DevExtreme().Button()
                        .ID("btnUseItemDesc")
                        .Text("Use Item Desc.")
                        .Icon("info")
                        .Type(ButtonType.Normal)
                        .StylingMode(ButtonStylingMode.Contained)
                        //.OnClick("getItemDescription1")
                        )
        </div>
    </div>

    <!-- TextArea -->
    <div style="margin-top: 10px;">
        @(Html.DevExtreme().TextArea()
                .ID("DetailedDescription")
                .Label("Detailed Description / Specification")
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%; height: 80px !important;"))
    </div>

    <!-- Remarks -->
    <div style="margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("Remarks")
                .Label("Remarks")
                .LabelMode(EditorLabelMode.Floating)
                .ElementAttr("style", "width: 100%;"))
    </div>

    <!-- Size / Manufacturer / Brand -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("Size")
                .Disabled(true)
                .Label("Size")
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("Manufacturer")
                .Disabled(true)
                .Label("Manufacturer")
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("Brand")
                .Disabled(true)
                .Label("Brand")
                .LabelMode(EditorLabelMode.Floating))
    </div>

    <!-- Part No / Delivery Period / Plan No -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
        @(Html.DevExtreme().TextBox()
                .ID("PartNo")
                .Label("Part No")
                .Disabled(true)
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("DeliveryPeriod")
                .Label("Delivery Period")
                .LabelMode(EditorLabelMode.Floating))

        @(Html.DevExtreme().TextBox()
                .ID("PlanNo")
                .Label("Plan No")
                .LabelMode(EditorLabelMode.Floating))
    @* </div>
            @(Html.DevExtreme().Button()
                .ID("btnApplyAndClose")
                .Text("Apply & Close")
                .OnClick("applyAndClose1")
                .Icon("check"))
</div> *@
<script>
       function getQueryParam(name) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(name);
    }

    // Get values from URL
    const propertyType = getQueryParam('PropertyType');
    const equipmentRequestNo = getQueryParam('EqiupmentRequestNo');

    $(function () {
        $("#btnUseItemDesc").dxButton("instance").option("onClick", function () {
            if (!propertyType) {
                DevExpress.ui.notify("Property Type is missing.", "error", 2000);
                return;
            }

            // 🔑 Get the existing text from the textarea
            const textArea = $("#DetailedDescription").dxTextArea("instance");
            const existingValue = textArea.option("value") || "";

            // 🔑 Append the PropertyType (with a space or new line)
            const newValue = existingValue
                ? existingValue + " " + propertyType
                : propertyType;

            // 🔑 Set the updated value back
            textArea.option("value", newValue);
        });
    });

      function applyAndClose1() {
          debugger;
        var equipmentRequestNo = getQueryParam('EqiupmentRequestNo'); // Note: spelling matches your code
        var deliveryPeriod = $("#DeliveryPeriod").dxTextBox("instance").option("value");
        var addlDescription = $("#DetailedDescription").dxTextArea("instance").option("value");
        var itemRemarks = $("#Remarks").dxTextBox("instance").option("value");
        var planNo = $("#PlanNo").dxTextBox("instance").option("value");

        if (!equipmentRequestNo) {
            DevExpress.ui.notify("Equipment Request No is missing.", "error", 2000);
            return;
        }

        var data = {
            EquipmentRequestNo: equipmentRequestNo,
            DeliveryPeriod: deliveryPeriod,
            AddlDescription: addlDescription,
            ItemRemarks: itemRemarks,
            PlanNo: planNo
        };

        $.ajax({
            url: `/api/AddNewClientRequest1/SaveOrUpdateEnquiryChild`,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 2000);
                    // Optionally close modal or redirect
                    window.close(); // Or use your modal close logic
                } else {
                    DevExpress.ui.notify(response.message, "error", 2000);
                }
            },
            error: function (xhr) {
                DevExpress.ui.notify("Error: " + (xhr.responseJSON?.message || xhr.statusText), "error", 2000);
            }
        });
    }

</script>
    