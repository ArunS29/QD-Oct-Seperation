<script>

	function loadClientTimesheet() {

    $.ajax({
        url: `/api/AddNewClientRequest1/GetEqpCostClientTimesheet`,
        type: 'GET',
        success: function (statusData) {
            const grid = $("#gridClientTimesheet").dxDataGrid("instance");
            if (grid) {
                grid.option("dataSource", statusData);
            }
        },
        error: function () {
            DevExpress.ui.notify("Failed to load status data", "error", 3000);
        }
    });
}
// Load when page ready
$(document).ready(function () {
    loadClientTimesheet();
});




</script>