}
@using DevExtreme.AspNet.Mvc
@using DevExtreme.AspNet.Mvc.Builders

<div>
      <div> Equipment's Client Timesheet Records </div> 
    @(Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.sp40109Eqp_Cost_ClientTimesheetResult>()
        .ID("gridClientTimesheet")
        .ShowBorders(true)
         .DataSource(d => d.WebApi()
        .Controller("AddNewClientRequest1")
        .LoadAction("GetEqpCostClientTimesheet")
    )
        .ColumnAutoWidth(true)
        .Columns(columns => {
             columns.AddFor(m => m.PropertyNo)
            .Caption(new JS("formatMessage('Property No')"));

        columns.AddFor(m => m.PropertySummInvoiceNo)
            .Caption(new JS("formatMessage('Property Summ Invoice No')"));

        columns.AddFor(m => m.ClientName)
            .Caption(new JS("formatMessage('Client Name')"));

        columns.AddFor(m => m.DayDescription)
            .Caption(new JS("formatMessage('Day Description')"));

        columns.AddFor(m => m.NoOfDays)
            .Caption(new JS("formatMessage('No Of Days')"));

        columns.AddFor(m => m.ClientRegHoursTotal)
            .Caption(new JS("formatMessage('Client Reg Hours Total')"));

        columns.AddFor(m => m.ClientOTHoursTotal)
            .Caption(new JS("formatMessage('Client OT Hours Total')"));

        columns.AddFor(m => m.ClientAmountTotal)
            .Caption(new JS("formatMessage('Client Amount Total')"));
        })
        .ColumnChooser(columnChooser => columnChooser
			.Enabled(true)
			.Title(new JS("formatMessage('Show/Hide Column')"))
			.Mode(GridColumnChooserMode.DragAndDrop))
            .ColumnAutoWidth(true)
			.Width("99%")
			.WordWrapEnabled(true)
			.AllowColumnReordering(true)
			.AllowColumnResizing(true)
			.ColumnFixing(fixing => fixing.Enabled(true))
			.HeaderFilter(filter => filter.Visible(false))
			.Grouping(grouping => grouping.AutoExpandAll(true))
			.FilterRow(filterRow => filterRow.Visible(false))
			.GroupPanel(groupPanel => groupPanel.Visible(false))
			.ShowBorders(true)
			.ShowRowLines(true)
			.Editing(editing => editing
			.Mode(GridEditMode.Row)
			.AllowUpdating(false)   
			.AllowAdding(false)
			.AllowDeleting(false))
			.Paging(p => p.PageSize(10))
			.Pager(pager =>
			{
				pager.ShowPageSizeSelector(true);
				pager.AllowedPageSizes(new[] { 5, 10, 20, 50 });
				pager.ShowNavigationButtons(true);
				pager.Visible(true);
			})
    )

