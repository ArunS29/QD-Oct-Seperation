<style>
    .timesheet-container {
        padding: 10px;
    }

    .footer-section {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }

    .summary-box {
        padding: 10px;
        flex: 1;
        margin-right: 10px;
        font-weight: bold;
        text-align: center;
        border-radius: 5px;
    }

        .summary-box:last-child {
            margin-right: 0;
        }

    .footer-section {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }

    .summary-box {
