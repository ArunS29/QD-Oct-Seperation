       function loadTimeSheetByPropertyAndMonth(propertyNo, timeSheetMaster) {
           $.ajax({
               url: '/api/ERRequestforQuotationList/GetTimesheetGrid',
               type: 'GET',
               data: { propertyNo: propertyNo, timeSheetMaster: timeSheetMaster },
               success: function (data) {
                   var grid = $("#timesheetGrid").dxDataGrid("instance");
                   if (!grid) return;
                   grid.option("dataSource", data && data.data ? data.data : data);
                   grid.refresh();
                   showClientTimesheet();
               },
               error: function (xhr) {
                   console.error("AJAX Error", xhr.responseText || xhr);
                   DevExpress.ui.notify("Error while loading data", "error", 2000);
               }
           });
       }
                // ✅ Reusable DropDownBox + DataGrid editor function
     // ----------------------------
    // Global variable
    // ----------------------------


    // ----------------------------
    // Generic DropDownGrid Creator
    // ----------------------------
    function createDropDownGridEditor(options) {
        const { container, listRef, valueField, displayField, placeholder, apiUrl, cellInfo, gridColumns, width } = options;

        function init(list) {
            const $dd = $("<div>").appendTo(container).dxDropDownBox({
                dataSource: list,
                valueExpr: valueField,
                displayExpr: displayField,
                value: cellInfo.value,
                placeholder: placeholder,
                showClearButton: true,
                dropDownOptions: { width: width || 400 },
                contentTemplate: function (e) {
                    const ddb = e.component;

                    const $grid = $("<div>").dxDataGrid({
                        dataSource: list,
                        keyExpr: valueField,
                        selection: { mode: "single" },
                        hoverStateEnabled: true,
                        columns: gridColumns,
                        searchPanel: { visible: true, placeholder: "Search..." },
                        height: 300,
                        onSelectionChanged: function (args) {
                            const selected = args.selectedRowsData[0];
                            if (selected) {
                                ddb.option("value", selected[valueField]);
                                cellInfo.setValue(selected[valueField]);
                                cellInfo.component.saveEditData();
                                ddb.close();
                            }
                        }
                    });

                    // Pre-select if already has value
                    setTimeout(() => {
                        if (cellInfo.value != null) {
                            $grid.dxDataGrid("instance").selectRows([cellInfo.value], false);
                        }
                    }, 100);

                    return $grid;
                }
            });
        }

        // Initialize data
        if (Array.isArray(listRef.data) && listRef.data.length > 0) {
            init(listRef.data);
        } else {
            container.text("Loading...");
            $.get(apiUrl)
                .done(function (data) {
                    listRef.data = data || [];
                    container.empty();
                    init(listRef.data);
                })
                .fail(function () {
                    container.text("Failed to load data");
                });
        }
    }

        var workStatusList = { data: [] };
