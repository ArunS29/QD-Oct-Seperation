          $("#btnSave").on("click", function () {
        const $btn = $(this).dxButton("instance");
        $btn.option("disabled", true); // Disable button while processing

        const propertyNo = $("#txtPropertyNo").dxTextBox("instance").option("value");
        if (!propertyNo) {
            DevExpress.ui.notify("Property number is mandatory.", "error", 3000);
            $btn.option("disabled", false);
            return;
        }

        const children = $("#timesheetGrid").dxDataGrid("instance").getDataSource().items();
        if (!children || children.length === 0) {
            DevExpress.ui.notify("No timesheet records to save.", "error", 3000);
            $btn.option("disabled", false);
            return;
        }

        // Optional: compute monthID from first child date if needed
        const monthID = $("#ddlMonthID").dxDropDownBox("instance").option("value") ||
            (children[0].TimeSheetDate ? new Date(children[0].TimeSheetDate).getMonth() + 1 : null);

        const master = {
            PropertyNo: propertyNo,
            MonthID: monthID,
            RatePerHour: $("#txtRatePerHour").dxNumberBox("instance").option("value") || 0
        };

        const model = { ...master, TimesheetChild: children };

        $.ajax({
            type: "POST",
            url: "/api/ERRequestforQuotationList/UpdatePropertyTimesheet",
            contentType: "application/json",
            data: JSON.stringify(model),
            success: function (response) {
                DevExpress.ui.notify(response.message || "Timesheet saved successfully", "success", 3000);
                const dataGrid = $("#timesheetGrid").dxDataGrid("instance");
                if (dataGrid) dataGrid.refresh();
            },
            error: function (xhr) {
                DevExpress.ui.notify("Error: " + (xhr.responseJSON?.message || xhr.statusText), "error", 3000);
            },
            complete: function () {
                $btn.option("disabled", false);
            }
        });
    });



