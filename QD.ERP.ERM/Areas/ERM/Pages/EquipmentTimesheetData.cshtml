<div class="timesheet-container">


    <!-- ================= Header Section ================= -->
    <table class="header-grid" style="width:75%;">
        <tr>
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("txtPropertyNo")
                                .Label("Property No:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width(250)
                                )
            </td>
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("txtPropertyDesc")
                                .Label("Property Description:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width(300)
                                )
            </td>
            <td>
                @(Html.DevExtreme().TextArea()
                                .ID("txtComments")
                                .Label("Comments:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width(400)
                                .ElementAttr("style", "height:60px !important;")
                                )
            </td>
            <td>
                @(Html.DevExtreme().NumberBox()
                                .ID("txtSupplierDeduction")
                                .Label("Supplier Deductions:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width(200)
                                )
            </td>
        </tr>

        <tr>
            <td>
                @(Html.DevExtreme().TextBox()
                        .ID("txtPlateNo")
                        .Label("Plate No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width(250)
                        )
            </td>
            <td>
                @(Html.DevExtreme().TextBox()
                        .ID("txtSerialNo")
                        .Label("Serial No:")
                        .LabelMode(EditorLabelMode.Floating)
                        .Width(300)
                        )
            </td>
            <td>
                @(Html.DevExtreme().TextBox()
                                .ID("txtDoorNo")
                                .Label("Door No:")
                                .LabelMode(EditorLabelMode.Floating)
                                .Width(400)
                                )
            </td>
          
            <td>
                @(Html.DevExtreme().TextBox()
                    .ID("txtMonthId")
                    .Label("")
                    .Disabled(true)
                    .LabelMode(EditorLabelMode.Floating)
                    .Width(200)
                    )
            </td>
        </tr>
    </table>

    <!-- Header (dxForm for alignment) -->

    <h4 style="margin-top:20px;">Time Sheet Entries:</h4>
    <div>
        <!-- Timesheet DataGrid -->
                    @(Html.DevExtreme().DataGrid()
                        .ID("timesheetGrid")
                        .ShowBorders(true)
                        .DataSource(d => d.WebApi()
                        .Controller("ERRequestforQuotationList")
                        .LoadAction("GetTimesheetGrid")
                        )
                        .ColumnAutoWidth(true)
                        .Paging(p => p.Enabled(false))
                        .Scrolling(s => s.Mode(GridScrollingMode.Standard))
                        .Editing(edit => edit.Mode(GridEditMode.Cell).AllowUpdating(true))
                @* .OnInitialized("onGridInitialized")
                .Selection(s => s
                .Mode(SelectionMode.Multiple)      // ✅ Allow multiple selection
                .ShowCheckBoxesMode(GridSelectionShowCheckBoxesMode.Always) // ✅ Show checkboxes
                ) *@
                        .Columns(columns =>
                        {
                            // Equipment columns with dynamic caption
                            columns.Add()
                    .Caption(new JS("formatMessage('Equipment TimeSheet Details')"))
                    .Columns(subColumns =>
                    {
                        subColumns.Add().DataField("PropertyNo").Caption("Property No").Width(120);
                        subColumns.Add().DataField("TimeSheetMasterId").Caption("TimeSheet Master Id").Width(120).Visible(false);
                        subColumns.Add().DataField("TimeSheetDate").Caption(new JS("formatMessage('Date')")).DataType(GridColumnDataType.Date);
                        subColumns.Add()
                    .DataField("WorkStatus")
                    .Caption("Status")
                    .Width(200)
                    .EditCellTemplate(new JS("function(cellElement, cellInfo){ workStatusDropDownEditor(cellElement, cellInfo); }"))
                    .CellTemplate(new JS(@"
                function(container, options) {
                if (Array.isArray(workStatusList.data)) {
                var item = workStatusList.data.find(function(d) {
                return d.DayCode === options.value;
                });
                container.text(item ? item.DayDescription : '');
                }
                }
                "));


                    });

                    // Client columns with dynamic caption
                    columns.Add()
                    .Caption(new JS("formatMessage('Client TimeSheet Details')")).Alignment(HorizontalAlignment.Center)
                    .Columns(subColumns =>
                    {
                        subColumns.Add().DataField("ClientName").Caption(new JS("formatMessage('Client Name')")).Width(200);
                                                                                                                             // ClientRegHours
                                                                                                                             // ClientRegHours
                        subColumns.Add()
                    .DataField("ClientRegHours")
                    .Caption(new JS("formatMessage('Reg Hours (C)')"))
                    .Format("fixedPoint")
                    .Format("#,##0.00")
                    .Alignment(HorizontalAlignment.Center)
                    .EditCellTemplate(new JS("function(cellElement, cellInfo){ timeSlotDropDownEditor(cellElement, cellInfo); }"))
                    .CellTemplate(new JS(
                    "function(container, options) { " +
                    "container.text(options.value || ''); " +
                    "}"
                    ));

                        // ClientOthours
                        subColumns.Add()
                    .DataField("ClientOthours")
                    .Caption(new JS("formatMessage('OT Hours (C)')"))
                    .Alignment(HorizontalAlignment.Center)
                    .Format("#,##0.00")
                    .EditCellTemplate(new JS("function(cellElement, cellInfo){ timeSlotDropDownEditor(cellElement, cellInfo); }"))
                    .CellTemplate(new JS(
                    "function(container, options) { " +
                    "container.text(options.value || ''); " +
                    "}"
                    ));



                        subColumns.Add().DataField("TotalHoursM").Caption(new JS("formatMessage('Total Hours (C)')")).Format("fixedPoint").Alignment(HorizontalAlignment.Center);
                        subColumns.Add().DataField("ClientRatePerHour").Caption(new JS("formatMessage('Rate/Hour (C)')")).Format("fixedPoint").Alignment(HorizontalAlignment.Center);
                        subColumns.Add().DataField("ClientOtratePerHour").Caption(new JS("formatMessage('OT Rate/Hour (C)')")).Format("fixedPoint").Alignment(HorizontalAlignment.Center);
                    });
                })
                .Height("60vh")
                .Width("100%")
                .ColumnFixing(fixing => fixing.Enabled(true))
                .HeaderFilter(filter => filter.Visible(true))
                .FilterRow(f => f.Visible(true))
                .ShowRowLines(true)               
                 )
    </div>
   


    <!-- Footer / Summary Panels -->
    <div class="footer-section">
        <div class="timesheet-box"> <div class="timesheet-header">Client Timesheet:</div> 
        <div class="timesheet-row"> <label>Reg.Hours:</label> @(Html.DevExtreme().NumberBox().ID("clientReg").Format("#0.0").OnValueChanged("updateClientTotal")) 
        </div> 
        <div class="timesheet-row"> <label>OT Hours:</label> @(Html.DevExtreme().NumberBox().ID("clientOT").Format("#0.0").OnValueChanged("updateClientTotal"))
        </div> <div class="timesheet-row"> <label>Total Hours:</label> @(Html.DevExtreme().NumberBox().ID("clientTotal").Format("#0.0").ReadOnly(true).ElementAttr("class", "total-box")) 
        </div></div>
        
        <div class="timesheet-box">
           <div class="timesheet-header" style="display:flex;">Supplier Timesheet:
                @(Html.DevExtreme().Button().ID("Clienttosup").Icon("send").OnClick("copyClientToSupplier"))
            </div>
            <div class="timesheet-row">
           <label>Reg.Hours:</label> @(Html.DevExtreme().NumberBox().ID("supplierReg").Value(50.0).Format("#0.0").OnValueChanged("updateSupplierTotal"))
        </div>
        <div class="timesheet-row"> 
            <label>OT Hours:</label> @(Html.DevExtreme().NumberBox().ID("supplierOT").Format("#0.0").OnValueChanged("updateSupplierTotal")) </div>
        <div class="timesheet-row">
            <label>Total Hours:</label> @(Html.DevExtreme().NumberBox().ID("supplierTotal").Format("#0.0").ReadOnly(true).ElementAttr("class", "total-box"))
        </div> </div> 
        
        <div class="timesheet-box"> <div class="timesheet-header">Day Shift Operator Timesheet:</div>
            @(Html.DevExtreme().Button().ID("SuptoDay").Icon("send").OnClick("copySupplierToDayOperator"))
        <div class="timesheet-row"> <label>Reg.Hours:</label> @(Html.DevExtreme().NumberBox().ID("dayReg").Value(0.0).Format("#0.0").OnValueChanged("updateDayTotal")) </div>
        <div class="timesheet-row"> <label>OT Hours:</label> @(Html.DevExtreme().NumberBox().ID("dayOT").Format("#0.0").OnValueChanged("updateDayTotal")) </div> 
        <div class="timesheet-row"> <label>Total Hours:</label> @(Html.DevExtreme().NumberBox().ID("dayTotal").Format("#0.0").ReadOnly(true).ElementAttr("class", "total-box")) </div> </div>

        <div class="timesheet-box"> <div class="timesheet-header">Night Shift Operator Timesheet:</div>
            @(Html.DevExtreme().Button().ID("Suptonight").Icon("send").OnClick("copyDayOperatortonight"))
        <div class="timesheet-row"> <label>Reg.Hours:</label> @(Html.DevExtreme().NumberBox().ID("nightReg").Value(0.0).Format("#0.0").OnValueChanged("updateNightTotal")) </div>
        <div class="timesheet-row"> <label>OT Hours:</label> @(Html.DevExtreme().NumberBox().ID("nightOT").Format("#0.0").OnValueChanged("updateNightTotal")) </div>
        <div class="timesheet-row"> <label>Total Hours:</label> @(Html.DevExtreme().NumberBox().ID("nightTotal").Format("#0.0").ReadOnly(true).ElementAttr("class", "total-box")) </div> </div>
    </div>
</div>
<div class="footer-fixed" style="height: 15px;">
    @await Html.PartialAsync("/Pages/Shared/ERM/EquipmentTimeSheetDatafooter.cshtml")
</div>

