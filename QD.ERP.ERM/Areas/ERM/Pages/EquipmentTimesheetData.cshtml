        function submitSupplierTimesheet() {
        debugger;
        const $btn = $("#btnSubmit");
        const dxBtn = $btn.dxButton("instance");
        $btn.prop("disabled", true);
        dxBtn.option("disabled", true);

        const propertyNo = $("#txtPropertyNo").dxTextBox("instance").option("value");
        if (!propertyNo) {
            DevExpress.ui.notify("Property number is required!", "error", 2000);
            $btn.prop("disabled", false);
            dxBtn.option("disabled", false);
            return;
        }

        DevExpress.ui.dialog.custom({
            title: "Confirm Submission",
            message: "Are you sure you want to submit the Supplier Timesheet?",
            buttons: [
                { text: "Yes", onClick: () => true },
                { text: "No", onClick: () => false }
            ]
        }).show().done(function (result) {
            if (result) {
                $.ajax({
                    type: "POST",
                    url: `/api/ERRequestforQuotationList/SubmitSupplierTimesheet?propertyNo=${encodeURIComponent(propertyNo)}`,
                    contentType: "application/json",
                    success: function (res) {
                        DevExpress.ui.notify(res.message || "Supplier Timesheet submitted successfully.", "success", 3000);
                    },
                    error: function (xhr) {
                        const errMsg = xhr.responseJSON?.message || "Submission failed.";
                        DevExpress.ui.notify(errMsg, "error", 3000); // ✅ show error message
                    },
                    complete: function () {
                        $btn.prop("disabled", false);
                        dxBtn.option("disabled", false);
                    }
                });
            } else {
                $btn.prop("disabled", false);
                dxBtn.option("disabled", false);
            }
        });
    }

        $("#btnApprove").on("click", function () {
        const dataGrid = $("#itemGrid").dxDataGrid("instance");
        if (!dataGrid) {
            console.error("DataGrid instance not found.");
            return;
        }

        const rowCount = dataGrid.getVisibleRows().length;
        if (rowCount === 0) {
            DevExpress.ui.dialog.custom({
                title: "Equipment Enquiry Request approval has failed.",
                message: "Equipment Enquiry Request has not been approved. Please enter transactions to proceed with approval.",
                buttons: [{ text: "Ok", onClick: () => false }],
                showTitle: true
            }).show();
            return;
        }

        DevExpress.ui.dialog.custom({
            title: "Confirm Approval",
            message: "Are you sure you want to approve this Enquiry Request?",
            buttons: [
                { text: "Yes", onClick: () => true },
                { text: "No", onClick: () => false }
            ],
            showTitle: true
        }).show().done(function (dialogResult) {
            if (dialogResult) proceedWithApproval();
        });
    });

            function approveSupplierTimesheet() {
        const propertyNo = $("#txtPropertyNo").dxTextBox("instance").option("value");
        if (!propertyNo) {
            DevExpress.ui.notify("Property number is required!", "error", 2000);
            return;
        }

        DevExpress.ui.dialog.custom({
            title: "Confirm Approval",
            message: "Are you sure you want to approve the Supplier Timesheet?",
            buttons: [
                { text: "Yes", onClick: () => true },
                { text: "No", onClick: () => false }
            ]
        }).show().done(result => {
            if (result) {
                $.ajax({
                    url: `/api/ERRequestforQuotationList/ApproveSupplierTimesheet?propertyNo=${encodeURIComponent(propertyNo)}`,
                    type: "POST",
                    contentType: "application/json",
                    success: res => {
                        DevExpress.ui.notify(res.message || "Supplier Timesheet approved successfully.", "success", 3000);
                    },
                    error: xhr => {
                        const errMsg = xhr.responseJSON?.message || "Approval failed or already approved.";
                        DevExpress.ui.notify(errMsg, "error", 3000);
                    }
                });
            }
        });
    }



    function unlockTimesheet() {
        const propertyNo = $("#txtPropertyNo").dxTextBox("instance").option("value");
        if (!propertyNo) {
            DevExpress.ui.notify("Property number is required!", "error", 2000);
            return;
        }

        DevExpress.ui.dialog.custom({
            title: "Confirm Unlock",
            message: "Are you sure you want to unlock the timesheet?",
            buttons: [
                { text: "Yes", onClick: () => true },
                { text: "No", onClick: () => false }
            ]
        }).show().done(result => {
            if (result) {
                $.ajax({
                    url: `/api/ERRequestforQuotationList/UnlockTimesheet?propertyNo=${encodeURIComponent(propertyNo)}`,
                    type: "POST",
                    contentType: "application/json",
                    success: res => {
                        DevExpress.ui.notify(res.message || "Timesheet unlocked successfully.", "success", 3000);
                    },
                    error: xhr => {
                        DevExpress.ui.notify(xhr.responseJSON?.message || "Unlock failed.", "error", 3000);
                    }
                });
            }
        });
    }

      
