       window.workStatusDropDownEditor = function (cellElement, cellInfo) {
        const $container = $("<div>").css({ width: "100%" }).appendTo(cellElement);
        createDropDownGridEditor({
            container: $container,
            listRef: workStatusList,
            valueField: "DayCode",
            displayField: "DayDescription",
            placeholder: "Select Work Status",
            apiUrl: "/api/ERRequestforQuotationList/GetWorkStatus",
            cellInfo,
            gridColumns: [
                { dataField: "DayCode", caption: "Code", width: 120, alignment: "center" },
                { dataField: "DayDescription", caption: "Description", alignment: "center" }
            ],
            width: 520
        });
    };


    // ----------------------------------------------------------------------
