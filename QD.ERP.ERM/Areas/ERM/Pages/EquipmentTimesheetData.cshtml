    var ot = $("#nightOT").dxNumberBox("instance").option("value") || 0; $("#nightTotal").dxNumberBox("instance").option("value", reg + ot); }

                function copyClientToSupplier() {
        var grid = $("#timesheetGrid").dxDataGrid("instance");
        var allRows = grid.getDataSource().items();

        var dataToSend = allRows.map(row => ({
            PropertyNo: row.PropertyNo,
            TimeSheetMasterID: row.TimeSheetMasterId
