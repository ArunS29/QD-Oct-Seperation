    function onClientSelected(e) {

            const clientCode = e.value;

            if (!clientCode) return;

            // Get the full item from the data source
            const dataSource = e.component.getDataSource();

            dataSource.load().done(function (items) {
                const selected = items.find(x => x.ClientCode === clientCode);

                if (selected) {
                    console.log("Autofill data:", selected);

                    $("#ClientRefName").dxTextBox("instance").option("value", selected.ContactPerson || "");
                    $("#ClientContactNo").dxTextBox("instance").option("value", selected.ContactMobile1 || "");
                    $("#ClientEmail").dxTextBox("instance").option("value", selected.ContactEmail || "");
                    $("#clientProject").dxTextBox("instance").option("value", selected.ClientAddress || "");
                }
            });
        }

