        width: 20vh;
    }

    .imagecontainer {
        background-color: #e0f7fa;
        border: 1px solid #90caf9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .imagecontainer img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .imagecontainer span {
            color: #555;
            font-style: italic;
            position: absolute;
        }

    .layout-container {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-column {
        flex: 1 1 48%;
        display: flex;
        flex-direction: column;
    }

    .field-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.3rem;
    }

    .field-label {
        font-size: 0.95rem;
        font-weight: 500;
        color: #333;
    }

    .field-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-solid {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: #6c757d;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-outline {
        padding: 4px 10px;
        font-size: 0.875rem;
        background-color: transparent;
        color: #6c757d;
        border: 1px solid #6c757d;
        border-radius: 4px;
        cursor: pointer;
    }

    .flex-row {
        display: flex;
        align-items: end;
    }

    .form-container {
        gap: 20px;
        font-family: Arial, sans-serif;
        width: 100%;
        box-sizing: border-box;
    }

    .form-card1 {
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 1%;
    }

    .form-row1 {
        display: flex;
        gap: 20px;
    }

    .form-group1 {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .containers {
        display: flex;
    }

    .dx-card {
        background: var(--background-color);
    }

    .important-height {
        height: 190px !important;             
    }

  .icon-green.dx-icon-attach::before {
    color: green !important;
}
 
.icon-red.dx-icon-attach::before {
    color: red !important;
}



