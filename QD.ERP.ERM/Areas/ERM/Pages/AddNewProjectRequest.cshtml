    const unitRate           = $("#UnitRate").dxNumberBox("instance").option("value");
    const rateHour           = $("#RateHour").dxNumberBox("instance").option("value");
    const otHour             = $("#OTHour").dxNumberBox("instance").option("value");
    const deliveryNoteNo     = $("#deliveryNoteNo").dxTextBox("instance").option("value");
    const uom = $("#UOM").dxTextBox("instance").option("value");

    // Get current grid & its datasource
    let grid = $("#B2BdataGrid").dxDataGrid("instance");
