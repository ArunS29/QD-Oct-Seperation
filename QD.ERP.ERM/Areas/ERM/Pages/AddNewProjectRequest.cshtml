<script>

    $(function () {
    $("#addNewDeliverytoClient").dxTextBox({
    text: formatMessage("Add New Delivery to Project"),
        readOnly: true,
        onContentReady: function (e) {
        $(e.element).addClass("dx-textbox-heading");
        }
        });
    });
    function onOpened(e) {
        setTimeout(() => {
            e.component.focus();
        });
    }


    $(document).ready(function () {
    const urlParams = new URLSearchParams(window.location.search);
    const deliveryNoteNo = urlParams.get("DeliveryNoteNo");
    const mode = urlParams.get("mode");

    if (mode === "edit" && deliveryNoteNo) {
        // Editing an existing record
        loadDeliveryNote(deliveryNoteNo);
    } else {
        // Add new record → generate new delivery note no
        $.get("/api/DeliveryNote1/GetNewDeliveryNoteNo", function (res) {
            if (res.success) {
                $("#deliveryNoteNo").dxTextBox("instance").option("value", res.deliveryNoteNo);
                getDocumentCount();
            } else {
                DevExpress.ui.notify(res.message, "error", 3000);
            }
        });
    }
});


async function loadDeliveryNote(deliveryNoteNo) {
    debugger;
    try {
        let response = await $.ajax({
            url: `/api/DeliveryNote1/GetDeliveryNoteByNo?deliveryNoteNo=${encodeURIComponent(deliveryNoteNo)}`,
            method: "GET"
        });

        if (!response.success) {
            DevExpress.ui.notify(response.message, "error", 2000);
            return;
        }

        // 🔹 Map master fields                                                   PropertyIssueNo
        $("#deliveryNoteNo").dxTextBox("instance").option("value", response.data.PropertyIssueNo);
        $("#deliveryNoteDate").dxDateBox("instance").option("value", response.data.PropertyIssuedDate);
        $("#GetProjectDropDown").dxDropDownBox("instance").option("value", response.data.ClientCode);
        $("#ddGetSalesPerson").dxDropDownBox("instance").option("value", response.data.OrderNo);
        $("#clientPOnumber").dxTextBox("instance").option("value", response.data.QuotationNo);
        $("#ClientRefName").dxTextBox("instance").option("value", response.data.Attention );
        $("#ClientContactNo").dxTextBox("instance").option("value", response.data.ClientContactNo);
        $("#ClientSite").dxTextBox("instance").option("value", response.data.ClientSite );
        $("#clientPoNo").dxTextBox("instance").option("value", response.data.ClientPono);
        $("#ClientPODate").dxDateBox("instance").option("value", response.data.ClientPodate );
        $("#clientProject").dxTextBox("instance").option("value", response.data.ProjectId );
        $("#ClientEmail").dxTextBox("instance").option("value", response.data.ClientContactEmail );

        $("#DeliveryNoteRemarks").dxTextArea("instance").option("value", response.data.PropertyIssueRemarks );
        $("#CoordinatorDropdown").dxSelectBox("instance").option("value", response.data.coordinatorIncharge );
        $("#ExpectedHireDate").dxDateBox("instance").option("value", response.data.ExpectedOffHireDate );
        $("#Salesman").dxTextBox("instance").option("value", response.data.Salesman );
        $("#DeliveredBy").dxTextBox("instance").option("value", response.data.TransportedBy );
        $("#DriverName").dxTextBox("instance").option("value", response.data.DriversName );
        $("#VehicleNo").dxTextBox("instance").option("value", response.data.VehicleNo );
        $("#DriverID").dxTextBox("instance").option("value", response.data.DriversId );
        $("#GatePassNo").dxTextBox("instance").option("value", response.data.GatePassNo );

        $("#Dnsignatory").dxDropDownBox("instance").option("value", response.data.deliverySignatory );

        $("#CompanyName").dxSelectBox("instance").option("value", response.data.CompanyBranch );
        $("#DeliveryType").dxSelectBox("instance").option("value", response.data.DeliveryType );

       if (response.data.Detailses && response.data.Detailses.length > 0) {
           let grid = $("#B2BdataGrid").dxDataGrid("instance");

             const rowData = response.data.Detailses.map((item, index) => ({
                    LineOrderNo: index + 1,   // sequence number for grid
                    PropertyNo: item.PropertyNo,
                    Description: item.PropertyDetailedDescription,
                    QuantityIssued: item.QuantityIssued,
                    UOM: item.UoM,
                    UnitRateMethod: item.UnitRateMethod,
                    UnitRate: item.UnitRate,
                    Operator: item.Operator,
                    MeterReading: item.MeterReading,
                    IssueNotes: item.IssueNotes
             }));

             grid.option("dataSource", rowData);
       }


        DevExpress.ui.notify("Delivery Note loaded successfully", "success", 2000);
        getDocumentCount();

    } catch (err) {
        console.error("Error loading delivery note:", err);
        DevExpress.ui.notify("Error loading delivery note", "error", 2000);
    }
}



$("#btnSave").on("click", function (e) {
    e.preventDefault();

var clientValue = $("#GetProjectDropDown").dxDropDownBox("instance").option("value");

    if (clientValue) {

    // Example: Collect your form/grid values into a model
    let deliveryNoteModel = {  

        PropertyIssueNo: $("#deliveryNoteNo").dxTextBox("instance").option("value"),
        PropertyIssuedDate: $("#deliveryNoteDate").dxDateBox("instance").option("value"),
        ClientCode: $("#GetProjectDropDown").dxDropDownBox("instance").option("value"),
        OrderNo: $("#ddGetSalesPerson").dxDropDownBox("instance").option("value"),
        QuotationNo: $("#clientPOnumber").dxTextBox("instance").option("value"),
        Attention: $("#ClientRefName").dxTextBox("instance").option("value"),
        ClientContactNo: $("#ClientContactNo").dxTextBox("instance").option("value"),
        ClientSite: $("#ClientSite").dxTextBox("instance").option("value"),
        ClientPONo: $("#clientPoNo").dxTextBox("instance").option("value"),
        ClientPODate: $("#ClientPODate").dxDateBox("instance").option("value"),
