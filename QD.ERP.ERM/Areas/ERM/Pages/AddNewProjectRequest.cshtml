                UnitRateMethod: unitRateMethodValue || null,
                UnitRate: row.UnitRate || null,
                UoM: row.Unit || ""
            }));

            // Combine master + children
            const model = {
                ...deliveryNoteModel,
                Detailses: mappedChildren
            };

            console.log("Saving Delivery Note:", model);

        // Call API
        $.ajax({
            url: "/api/DeliveryNote1/SaveDeliveryNote",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(model),
            success: function (response) {
                if (response.success) {
                    DevExpress.ui.notify(response.message, "success", 2000);
                    console.log("Saved Delivery Note:", response.deliveryNoteNo);
                } else {
