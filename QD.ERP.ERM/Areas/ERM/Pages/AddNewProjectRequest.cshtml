                }
            },
            error: function (xhr) {
                console.error("Error saving delivery note:", xhr.responseText);
                DevExpress.ui.notify("Error saving delivery note", "error", 2000);
            }
        });

    } else {
        DevExpress.ui.dialog.alert(
            "Cannot continue saving with errors, please clear the errors and continue.",
