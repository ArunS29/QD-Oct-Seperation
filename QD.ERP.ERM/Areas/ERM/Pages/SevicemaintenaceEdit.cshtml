                        history.back();   // goes to the last visited page
                    }, 1500);
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.error || "Failed to delete record.";
                    DevExpress.ui.notify(msg, "error", 4000);
                }
            });
        }
    });
