function descriptionDropDownTemplate(cellElement, cellInfo) {
    const $container = $("<div>").css({
        display: "flex",
        alignItems: "center",
        gap: "5px",
        width: "100%"
    }).appendTo(cellElement);

    const dropdownStore = new DevExpress.data.CustomStore({
        key: "GSCode",
        load: function (loadOptions) {
            const pageNumber = Math.floor((loadOptions.skip || 0) / (loadOptions.take || 20)) + 1;
            const pageSize = loadOptions.take || 20;
            return $.getJSON("/api/GoodsandServices/GetGoodsAndServices", { pageNumber, pageSize })
                .then(response => ({
                    data: response.data,
                    totalCount: response.totalCount
                }));
        },
        byKey: function (key) {
            return $.getJSON(`/api/GoodsandServices/GetGoodsAndServiceByCode?code=${key}`);
        }
    });

    $("<div>").css({ flex: 1 }).appendTo($container).dxDropDownBox({
        valueExpr: "GSCode",
        displayExpr: "GSDescrpition",
        value: cellInfo.value,
        dataSource: dropdownStore,
        searchEnabled: true,
        searchExpr: ["GSDescrpition", "ItemPartNo"],
        dropDownOptions: { width: 800 },
        contentTemplate: function (e) {
            return $("<div>").dxDataGrid({
                dataSource: dropdownStore,
                keyExpr: "GSCode",
                height: 300,
                remoteOperations: true,
                selection: { mode: "single" },
                columns: [
                    { dataField: "GSCode", caption: "Code", width: 80 },
                    { dataField: "ItemPartNo", caption: "Item Part No", width: 100 },
                    { dataField: "GSDescrpition", caption: "Description", width: 200 },
                    { dataField: "GsdescriptionAr", caption: "Arabic Description", width: 200 }
                ],
                onSelectionChanged: function (selected) {
                    const item = selected.selectedRowsData[0];
                    if (!item) return;

                    // Set the description field value
                    cellInfo.setValue(item.GSDescrpition);

                    // Update Gscode in the grid row
                    const grid = $("#itemGrid").dxDataGrid("instance");
                    const rowIndex = grid.getRowIndexByKey(cellInfo.key);
                    if (rowIndex !== -1) {
                        grid.cellValue(rowIndex, "Gscode", item.GSCode); // <-- Binds Gscode
                        grid.cellValue(rowIndex, "CostPrice", item.CostPrice || 0);
                        grid.cellValue(rowIndex, "GsuoM", item.GsuoM || "");
                        grid.cellvalue(rowIndex, "QtyUsed", item.QtyUsed || 1 );
                    }
                    e.component.close();
                }
            });
        }
    });

    // Add new item button (optional)
    $("<div>").dxButton({
        icon: "plus",
        hint: "Add new item",
        onClick: function () {
            openModal(`/${tenantName}/IMS/GoodsAndService`, "Goods and Services");
        }
    }).appendTo($container);
}
 

