                   <div class="dx-field ledgerResult">
				        @(Html.DevExtreme().DataGrid()
					        .ID("itemGrid") 
					        .Height("38vh")
					        .DataSource(new JS("window.itemGridDataSource"))
					        .Columns(columns =>
					        {
						        columns.Add().DataField("SpareSlNo").Caption("#").Width(50).AllowEditing(false).CellTemplate(new JS("serialTemplate")).Visible(false);
						       columns.Add()
                                    .DataField("Gscode")
                                    .Caption(new JS("formatMessage('Item Code')"))
                                    .Width(120)
                                    .AllowEditing(false)
                                   @*  .CellTemplate(new JS(@"
                                        function(container, options) {
                                            container.text(options.data?.GSCode || '');
                                        }
                                    ") *@
                                    ;

                               columns.Add()
                                .DataField("Gsdescription")
                                .Caption(new JS("formatMessage('Item Description')"))
                                .Width(400)
                                .EditCellTemplate(new JS("descriptionDropDownTemplate"))
                                .CellTemplate(new JS(@"
                                    function(container, options) {
                                        // Show description if present, else fetch by Gscode
                                        if (options.data?.GSDescrpition) {
                                            container.text(options.data.GSDescrpition);
                                        } else if (options.data?.Gscode) {
                                            $.getJSON('/api/GoodsandServices/GetGoodsAndServiceByCode?code=' + options.data.Gscode)
                                                .done(function(data) {
                                                    container.text(data.GSDescrpition || '');
                                                });
                                        } else {
                                            container.text('');
                                        }
                                    }
                                "));

                                columns.Add()
                                    .DataField("GsuoM")
                                    .Caption(new JS("formatMessage('Unit Rate Method')"))
                                    .Width(400)
                                    .EditCellTemplate(new JS("unitRateMethodDropDownTemplate"))
                                    .CellTemplate(new JS(@"
                                        function(container, options) {
                                            const unit = unitCodesList.find(u => u.UnitCode === options.value);
                                            container.text(unit ? unit.UnitDesc : options.value);
                                        }
                                    "));
						        columns.Add()
						        .DataField("QtyUsed")
						        .Caption(new JS("formatMessage('Qty Used')"))
						        .DataType(GridColumnDataType.Number) 
                                .EditorOptions(new {value = 0})
						        .Width(150)
						        .EditorOptions(new {
							        maxLength = 8
							        });
						        columns.Add().DataField("CostPrice").Caption(new JS("formatMessage('Cost Price')")).DataType(GridColumnDataType.Number).EditorOptions(new {value = 0});

						        columns.Add().DataField("TotalCost").Caption(new JS("formatMessage('Total Cost')")).DataType(GridColumnDataType.Number).AllowEditing(false).EditorOptions(new {value = 0});

						        columns.Add()
							        .Type(GridCommandColumnType.Buttons)
							        .Width(60)
							        .Buttons(b =>
							        {
								        b.Add()
								         .Hint("Delete")
								         .Icon("remove")            
								         .OnClick("deleteChild");
							        });
					        })
					        .ColumnAutoWidth(true)
					        .Width("100%")
					        .WordWrapEnabled(false)
					        .AllowColumnReordering(true)
					        .AllowColumnResizing(true)
					        .ColumnFixing(fixing => fixing.Enabled(true))
					        .HeaderFilter(filter => filter.Visible(false))
					        .Paging(p => p.Enabled(false))
					        .Pager(pager => pager.Visible(false))
					        .Grouping(grouping => grouping.AutoExpandAll(true))
					        .FilterRow(filterRow => filterRow.Visible(false))
					        .GroupPanel(groupPanel => groupPanel.Visible(false))
					        .ShowBorders(true)
					        .ShowRowLines(true)
					        .Editing(editing => editing
					        .Mode(GridEditMode.Cell)
					        .AllowUpdating(true)
					        .AllowDeleting(true)
					        )
					        .OnContextMenuPreparing("onGridRightClick")
					        )
		                      </div>
