                   function loadClientDetails(ServiceSheetNo) {

                        debugger;

                        if (!ServiceSheetNo) {
                            DevExpress.ui.notify("Service Sheet No is missing.", "warning", 2000);
                            return;
                        }

                        console.log("🔍 Loading service details for:", ServiceSheetNo);

                        $.ajax({
                            url: `/api/ServiceMaintenance/GetServiceProperty?ServiceSheetNo=${encodeURIComponent(ServiceSheetNo)}`, // ✅ fixed param name
                            type: 'GET',
                            dataType: 'json',
                            success: function (response) {
                                if (!response) {
                                    console.warn("⚠️ No client details found in the response.");
                                    return;
                                }

                                console.log("✅ Client details received:", response);

                                // Extract master and child data properly
                                const master = response.Master || {};
                                const children = response.Children || [];

                                // 🔘 Change Save button to Update
                                const saveBtn = $("#btnSave").dxButton("instance");
                                if (saveBtn) saveBtn.option("text", "Update");

                                // 🧱 Row 1
                                $("#txtServiceOrderNo").dxTextBox("instance")?.option("value", master.ServiceSheetNo);
                                $("#ServiceEntryDate").dxDateBox("instance")?.option("value", master.ServiceDate);
                                $("#ddlVehicleDescription").dxDropDownBox("instance")?.option("value", master.PropertyNo);

                                // 🧱 Row 2
                                $("#ddlMechanicName").dxSelectBox("instance")?.option("value", master.ServicedBy);
                                $("#ddlPropertyBroughtBy").dxSelectBox("instance")?.option("value", master.PropertyBroughtBy);
                                $("#txtOperatorName").dxTextBox("instance")?.option("value", master.OperatorName);
                                $("#txtDriverContact").dxTextBox("instance")?.option("value", master.OperatorContactNo);

                                // 🧱 Row 3
                                $("#ddlServiceType").dxSelectBox("instance")?.option("value", master.ServiceOrderType);
                                $("#ddlServiceStatus").dxSelectBox("instance")?.option("value", master.ServiceStatus);
                                $("#txtLocation").dxTextBox("instance")?.option("value", master.Location);
                                $("#txtProject").dxTextBox("instance")?.option("value", master.Project);
                                $("#ddlPropertyComplaint").dxTextArea("instance")?.option("value", master.Complaint);
                                $("#currencyexchangerate").dxNumberBox("instance")?.option("value", master.CurrencyRate);
                                $("#ddlGoodsGroup4").dxDropDownBox("instance")?.option("value", master.BaseCurrencyId);
                                $("#ddlGoodsGroup3").dxDropDownBox("instance")?.option("value", master.CurrencyId);

                                // 🧾 Child grid handling
                                if (Array.isArray(children) && children.length > 0) {
                                    // ✅ Clean and fix property names for DataGrid binding
                                    const cleanChildren = children.map((row, index) => ({
                                        SNo: index + 1,
                                        SpareSlNo: row.SpareSlNo,
                                        ServiceSheetNo: row.ServiceSheetNo,
                                        Gscode: row.Gscode,
                                        GsuoM: row.GsuoM,
                                        UnitDesc: row.UnitDesc,
                                        QtyUsed: row.QtyUsed,
                                        CostPrice: row.CostPrice,
                                        TotalCost: row.TotalCost,
                                        Gsdescription: row.Gsdescription || row.Gsdescrpition || "" // ✅ handles both spellings
                                    }));

                                    console.log("🧩 Cleaned children data:", cleanChildren);

                                    const grid = $("#itemGrid").dxDataGrid("instance");
                                    if (grid) {
                                        grid.option("dataSource", cleanChildren);
                                        grid.refresh();
                                    } else {
                                        console.warn("⚠️ itemGrid instance not found.");
                                    }
                                } else {
                                    console.warn("⚠️ No child items found for this Service Sheet No.");
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error("❌ Error fetching client details:", error);
                                DevExpress.ui.notify("Failed to load service details. Check console for errors.", "error", 3000);
                            }
                        });
                    }


