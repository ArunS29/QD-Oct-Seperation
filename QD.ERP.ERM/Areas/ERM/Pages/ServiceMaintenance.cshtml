<div class="dx-field ledgerResult">
	@(Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.Qry40501propertyServiceView>()
		.ID("dataGrid")
		.RemoteOperations(false)
		.DataSource(new JS("[]"))
		.Columns(columns =>{
	    	columns.Add().Caption(new JS("formatMessage('Property Service Details')")).Columns(subColumns =>
		{
			subColumns.AddFor(m => m.ServiceSheetNo).Caption("Service sheet No").Visible(true);
			subColumns.AddFor(m => m.ServiceDate).Caption("Service Date").Visible(true);
			subColumns.AddFor(m => m.ServiceStatus).Caption("Service Status").Visible(true);
			subColumns.AddFor(m => m.PropertyDescription).Caption("Property Description").Visible(true);
			subColumns.AddFor(m => m.ServicedBy).Caption("Service By").Visible(true);
			subColumns.AddFor(m => m.OperatorName).Caption("Operator Name").Visible(true);
			subColumns.AddFor(m => m.Complaint).Caption("Complaint").Visible(true);
			subColumns.AddFor(m => m.TotalCost).Caption("Total Service Cost").Visible(true);
			});
				})
		.Height("45vh")
		.ColumnAutoWidth(true)
		.Width("98%")
		.WordWrapEnabled(true)
		.OnCellClick("function(e) {handleCellClick(e);}")
		.ColumnChooser(columnChooser => columnChooser.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")).Mode(GridColumnChooserMode.DragAndDrop))
		.AllowColumnReordering(true)
		.AllowColumnResizing(true)
		.ColumnFixing(fixing => fixing.Enabled(true))
		.HeaderFilter(filter => filter.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.Paging(p => p.PageSize(10))
		.Pager(pager =>
		{
			pager.ShowPageSizeSelector(true);
			pager.AllowedPageSizes(new[] { 5, 10, 20, 50 });
			pager.ShowNavigationButtons(true);
			pager.Visible(true);
		})

		.ShowBorders(true)
		.ShowRowLines(true)
		.FilterRow(filterRow => filterRow.Visible(false))
		.GroupPanel(groupPanel => groupPanel.Visible(false))
		.ShowBorders(true)
		.OnContextMenuPreparing("onContextMenuPreparing")
		.StateStoring(stateStoring =>
		{
			stateStoring
			.Enabled(true)
			.Type(StateStoringType.LocalStorage)
			.StorageKey("gridContainerState");
		})
		.OnInitialized("function(e) { loadGridState(); }")
		)

</div>
<div id="invoiceErrorPopup"></div>

<script>
	$(function () {
			var now = new Date();
			var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
			var tillmonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
			$("#frmdateBox").dxDateBox("instance").option("value", firstDay);
			$("#todateBox").dxDateBox("instance").option("value", tillmonth);
			ddBtnShowRecords_click('range');
	});
	function ddBtnShowRecords_click(duration) {
		var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		var toDateBox = $("#todateBox").dxDateBox("instance");
		var frmDate = new Date(frmDateBox.option("value"));
		var toDate = new Date(toDateBox.option("value"));
		var currentDate = new Date();

		switch (duration) {
			case 'today':
				frmDate = toDate = currentDate;
				break;
			case 'yesterday':
				var dateObj = new Date();
				dateObj.setDate(dateObj.getDate() - 1);
				frmDate = toDate = dateObj;
				break;
			case 'week':
				var dayOfWeek = currentDate.getDay();
				var startOfWeek = currentDate.getDate() - (dayOfWeek + 1) % 7;
				frmDate = new Date(currentDate.setDate(startOfWeek));
				toDate = new Date(currentDate.setDate(startOfWeek + 6));
				break;
			case 'tillmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = currentDate;
				break;
			case 'fullmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
				break;
			case 'tillyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = currentDate;
				break;
			case 'fullyear':
				frmDate = new Date(currentDate.getFullYear(), 0, 1);
				toDate = new Date(currentDate.getFullYear(), 11, 31);
				break;
			case 'lastyear':
				frmDate = new Date(currentDate.getFullYear() - 1, 0, 1);
				toDate = new Date(currentDate.getFullYear() - 1, 11, 31);
				break;
			case 'lastmonth':
				frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
				toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
				break;
		}

		frmDate = frmDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		toDate = toDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
		FromDate = frmDate;
		ToDate = toDate;

		frmDateBox.option("value", frmDate);
		toDateBox.option("value", toDate);

		$.ajax({
			url: '/api/ServiceMaintenance/Getservicemaintance',
			type: 'GET',
			data: {
				fromDate: frmDate,
				toDate: toDate       
			},
			success: function (data) {
				$("#dataGrid").dxDataGrid("instance").option("dataSource", data);
				updateTotalRequestCount(data);
				updateTodayRequestCount(data);

				var dataGrid = $("#dataGrid").dxDataGrid("instance");
				var dataSource = dataGrid.option("dataSource");
				if (dataSource && dataSource.length > 0) {
					var lastRow = dataSource[dataSource.length - 1];
					VoucherAmountFormatted = lastRow.VoucherAmountFormatted;
					var firstRow = dataSource[0];
					firstrowVoucherAmountFormatted = firstRow.VoucherAmountFormatted;
				}
			},
			error: function () {
				DevExpress.ui.notify("Error while loading data", "error", 2000);
			}
		});
	}
		function onContextMenuPreparing(e) {
				if (e.target === "content" && e.row && e.row.data) {
					const rowData = e.row.data;
					const ServiceSheetNo = encodeURIComponent(rowData.ServiceSheetNo);
					const tenantName = window.tenantName || "defaultTenant";
				 e.items = [
				{
                text: "Edit Service Order",
                icon: "edit",
                onItemClick: function () {
                const url = `/${tenantName}/ERM/SevicemaintenaceEdit?code=${ServiceSheetNo}`;
                window.location.href = url;
					}
				},
					{
					text: "Delete Service Order",
					icon: "trash",
					onItemClick: function () {
						const ServiceSheetNo = encodeURIComponent(e.row.data.ServiceSheetNo);

						DevExpress.ui.dialog.confirm(
							`Are you sure you want to delete Service Sheet No ${ServiceSheetNo}?`,
							"Delete Confirmation"
						).done(function (dialogResult) {
							if (dialogResult) {
								fetch(`/api/ServiceMaintenance/DeleteServiceMaster/${ServiceSheetNo}`, {
									method: 'DELETE'
								})
								.then(response => {
									if (response.ok) {
										DevExpress.ui.notify(
											`Service Sheet No ${ServiceSheetNo} deleted successfully.`,
											"success",
											3000
										);
										// ✅ Refresh the DataGrid by ID
										 ddBtnShowRecords_click('range');
									} else {
										response.json().then(err => {
											DevExpress.ui.notify(err?.error || "Failed to delete the service sheet.", "error", 4000);
										});
									}
								})
								.catch(error => {
									console.error('Error deleting ServiceSheetNo:', error);
									DevExpress.ui.notify('An error occurred while deleting the service sheet.', "error", 4000);
								});
							}
						});
					}
				},
				];
			}
		}

	 $(function () {
		$("#ServiceMaintenance").dxTextBox({
		text: formatMessage("Service Maintenance"),
			readOnly: true,
			onContentReady: function (e) {
			$(e.element).addClass("dx-textbox-heading");
			}
			});
		});

</script>