        ClientEmail: $("#txtReqEmail").dxTextBox("instance").option("value"),
        QuotationNo: $("#txtQuotationNo").dxTextBox("instance").option("value"),
        PONo: $("#txtPONo").dxTextBox("instance").option("value"),
        Podates: $("#PODate").dxDateBox("instance").option("value"),
        ReferenceNo: $("#txtProjectDeptPR").dxTextBox("instance").option("value"),
        DeliveryNoteNos: $("#txtDeliveryNotes").dxTextBox("instance").option("value"),
        VatinvoiceNo: $("#txtVATInvoice").dxTextBox("instance").option("value"),
        InvoiceStartDate: $("#InvoiceStartDate").dxDateBox("instance").option("value"),
        InvoiceEndDate: $("#InvoiceEndDate").dxDateBox("instance").option("value"),
        Subject: $("#Subject").dxTextBox("instance").option("value"),
        QuoteSummary: $("#QuoteSummary").dxTextArea("instance").option("value"),
        QuoteIntro: $("#QuoteIntro").dxTextBox("instance").option("value"),
        QuoteSignatory: $("#ddPreparedby").dxDropDownBox("instance").option("value"),
        InvoiceNotes: $("#txtInvoiceNotes").dxTextArea("instance").option("value"),
        VatapplicableRate: $("#ddGetTax").dxDropDownBox("instance").option("value"),
        AdditionLabel: $("#txtAdditionLabel").dxTextBox("instance").option("value"),
