		$("#btnSave").on("click", function (e) {
    const $btn = $(this).dxButton("instance");

    // ✅ Step 1: Validate required field
    const clientValidator = $("#GetProjectDropDown").dxValidator("instance");
    const clientValidation = clientValidator.validate();

    if (!clientValidation.isValid) {
        DevExpress.ui.dialog.alert(
            "Cannot continue saving with errors, please clear the errors and continue.",
            "Clear Errors"
        );
        return;
    }

    // ✅ Step 2: Build master object
    const master = {
        BillingRefNo: $("#txtBillingRefNo").dxTextBox("instance").option("value"),
        InvoiceDate: $("#InvoiceDate").dxDateBox("instance").option("value"),
        ClientCode: $("#GetProjectDropDown").dxDropDownBox("instance").option("value"),
        EffectiveDate: $("#EffectiveDate").dxDateBox("instance").option("value"),
