		function loadRequestChildren(InvoiceNo) {
			debugger;
    $.ajax({
        url: `/api/MaterialReceipt1/GetInvoiceChildren?InvoiceNo=${encodeURIComponent(InvoiceNo)}`,
        type: "GET",
