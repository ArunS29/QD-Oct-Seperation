    console.log("Invoice data bound to UI:", data);
}

$(document).ready(function () {
    const urlParams = new URLSearchParams(window.location.search);
    let invoiceNo = urlParams.get("InvoiceNo"); // e.g. ?InvoiceNo=EQP-SUM-25-0002

    if (invoiceNo) {
        $.ajax({
            url: `/api/MaterialReceipt1/GetInvoiceSummary?invoiceNo=${encodeURIComponent(invoiceNo)}`,
            type: "GET",
            dataType: "json",
            success: function (res) {
                if (res.Master) {
                    bindInvoiceMasterData(res.Master);   // ✅ bind all header fields
                }

                // ✅ Bind details grid
                $("#itemGrid").dxDataGrid("instance").option("dataSource", res.Details || []);

                // ✅ Always load children
                loadRequestChildren(invoiceNo);
            },
            error: function (xhr, status, error) {
                DevExpress.ui.notify(
                    "Error loading invoice: " + (xhr.responseJSON?.message || error),
                    "error",
                    3000
                );
            }
        });
    } else {
