                        // ✅ Initialize DevExtreme button for Close
    function handleInvoiceCreation(buttonType) {
    var grid = $("#itemGrid").dxDataGrid("instance");
    var selectedItems = grid.getSelectedRowsData();

    if (!selectedItems || selectedItems.length === 0) {
        DevExpress.ui.notify("Please select at least one row.", "warning", 2000);
        return;
    }

    // Single selection → btnSummaryInvoice, Multiple → btnDetailedInvoice
    if (buttonType === "summary" && selectedItems.length > 1) {
        DevExpress.ui.notify("Please select only one row for Summary Invoice.", "warning", 2000);
        return;
    }

    var payload = selectedItems.map(function(item) {
        return {
            BillingSummaryNo: item.PropertyNo, // your summary number field
            InvoiceDueDate: item.InvoiceDueDate || new Date().toISOString().split("T")[0]
        };
    });

    $.ajax({
        url: '/api/MaterialReceipt1/CreateOrUpdateDetailedInvoice',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        success: function(response) {
            if (response.success) {
                response.results.forEach(function(r) {
                    if (r.status === "Created") {
                        DevExpress.ui.notify("VAT Invoice created for " + r.BillingSummaryNo, "success", 2000);
                        window.open("/VAT/frm20161VATInvoiceEdit?InvoiceNo=" + r.invoiceNo, "_blank");
                    } else if (r.status === "Updated") {
                        DevExpress.ui.notify("Invoice due date updated for " + r.BillingSummaryNo, "info", 2000);
                    } else if (r.status === "Failed") {
                        DevExpress.ui.notify("Failed to create invoice for " + r.BillingSummaryNo, "error", 2000);
                    }
                });
            }
        },
        error: function(xhr, status, error) {
            DevExpress.ui.notify("Server Error: " + error, "error", 2000);
        }
    });
}

// Bind buttons
$("#btnSummaryInvoice").on("click", function() {
    handleInvoiceCreation("summary");
});

$("#btnDetailedInvoice").on("click", function() {
    handleInvoiceCreation("detailed");
});



