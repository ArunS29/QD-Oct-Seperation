<div class="horizontal-container">
	@(Html.DevExtreme().DateBox()
		.ID("frmdateBox")
		.Label(new JS("formatMessage('Start Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)) // First day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(2)
		)

	@(Html.DevExtreme().DateBox()
		.ID("todateBox")
		.Label(new JS("formatMessage('End Date')"))
		.LabelMode(EditorLabelMode.Floating)
		.InputAttr("aria-label", "Date")
		.Type(DateBoxType.Date)
		.Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))) // Last day of the month
		.DisplayFormat("dd-MMM-yyyy")
		.TabIndex(3)
		)


	@(Html.DevExtreme().DropDownButton()
		.ID("ddBtnShowRecords")
		.Text(new JS("formatMessage('Show Records')"))
		.Icon("smalliconslayout")
		.Width(180)
		.SplitButton(true)
		.OnButtonClick("function(e) { ddBtnShowRecords_click('range'); }")
		.DropDownOptions(options => options.Width(230))
		.Items(items =>
		{
			items.Add().Text(new JS("formatMessage('Today')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('today'); }");
			items.Add().Text(new JS("formatMessage('Yesterday')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('yesterday'); }");
			items.Add().Text(new JS("formatMessage('This Week')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('week'); }");
			items.Add().Text(new JS("formatMessage('This Month Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillmonth'); }");
			items.Add().Text(new JS("formatMessage('This Month (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullmonth'); }");
			items.Add().Text(new JS("formatMessage('This Year Till Date')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('tillyear'); }");
			items.Add().Text(new JS("formatMessage('This Year (Full)')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('fullyear'); }");
			items.Add().Text(new JS("formatMessage('Last Month')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastmonth'); }");
			items.Add().Text(new JS("formatMessage('Last Year')")).Icon("event").OnClick("function() { ddBtnShowRecords_click('lastyear'); }");
		})
		)
	
</div>
<div class="dx-field ledgerResult">
	@(Html.DevExtreme().DataGrid<QD.ERP.Shared.DAL.Entities.Qry40135PropertyPowithDetail>()
		.ID("dataGrid")
		 .DataSource(new JS("[]"))
        //.ColumnChooser(c => c.Enabled(false).Title(new JS("formatMessage('Show/Hide Column')")))
        .Height("73vh")
        .Width("98%")
        .ShowBorders(true)
        .ShowRowLines(true)
        .WordWrapEnabled(true)
        .ColumnAutoWidth(true)
        .AllowColumnResizing(true)
        .Grouping(g => g.AutoExpandAll(true))
        .GroupPanel(p => p.Visible(true))
        .Paging(p => p.PageSize(10))
        .Pager(pager => {
            pager.ShowPageSizeSelector(true);
            pager.AllowedPageSizes(new[] { 5, 10, 20, 50 });
            pager.ShowNavigationButtons(true);
            pager.Visible(true);
        })
		.Columns(columns =>
		{
			columns.Add().Caption(new JS("formatMessage('Supplier Details')")).Columns(subColumns =>
			{
			@* 	subColumns.AddFor(m => m.InvoiceNo).Caption("Invoice No").Alignment(HorizontalAlignment.Center).GroupIndex(0); *@
				subColumns.AddFor(m => m.Pono).Caption(new JS("formatMessage('Po No')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.RevisionNo).Caption(new JS("formatMessage('Po Revision No')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.SupplierName).Caption(new JS("formatMessage('Supplier Name')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.Podate).Caption(new JS("formatMessage('Po Date')")).Alignment(HorizontalAlignment.Center).Format("dd-MMM-yyyy").Visible(true);
				subColumns.AddFor(m => m.PodueDate).Caption(new JS("formatMessage('Po due Date')")).Alignment(HorizontalAlignment.Center).Format("dd-MMM-yyyy").Visible(true);
				subColumns.AddFor(m => m.SupplierQuoteNo).Caption(new JS("formatMessage('Supplier Quote No')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.SupplierRefNo).Caption(new JS("formatMessage('Supplier Ref No')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.UnitDesc).Caption(new JS("formatMessage('Unit Description')")).Alignment(HorizontalAlignment.Center).Visible(true);
				subColumns.AddFor(m => m.OperatorName).Caption(new JS("formatMessage('Operator Name')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.OperatorId).Caption(new JS("formatMessage('Operator Id')")).Alignment(HorizontalAlignment.Right).Visible(true);
				});
			columns.Add().Caption(new JS("formatMessage('Other Details')")).Columns(subColumns =>
			{
				subColumns.AddFor(m => m.PropertyTypeId).Caption(new JS("formatMessage('Property Type Id')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.PropertyType).Caption(new JS("formatMessage('Property Type')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.UnitRate).Caption(new JS("formatMessage('Unit Rate')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.Project).Caption(new JS("formatMessage('Discount')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.CalcLineTotal).Caption(new JS("formatMessage('Project')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.QuotedQuantity).Caption(new JS("formatMessage('Quoted Quantity')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.TotalAmount).Caption(new JS("formatMessage('Total Amount')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.TotalTaxAmount).Caption(new JS("formatMessage('Total Tax Amount')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.TotalAmountWithTax).Caption(new JS("formatMessage('Total Amount With Tax')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.AdditionsAmount).Caption(new JS("formatMessage('Additions Amount')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.DeductionsAmount).Caption(new JS("formatMessage('Deductions Amount')")).Alignment(HorizontalAlignment.Right).Visible(true);
				subColumns.AddFor(m => m.NetAmount).Caption(new JS("formatMessage('Net Amount')")).Alignment(HorizontalAlignment.Right).Visible(true);
			});

			
		})

		.OnInitialized("function(e) { loadGridState(); }")
		)
</div>

<div id="overlay" class="overlay">
	<div class="overlay-content">
		<span class="close-btn" onclick="closeOverlay()">×</span>
		<iframe id="overlay-frame" src="" frameborder="0"></iframe>
	</div>
</div>

<script>
		   $(function () {
	 $("#PurchaseInvoiceWithDetails").text(formatMessage("Purchase Order Details"));
	
		   var now = new Date();
		   var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		   var toDateBox = $("#todateBox").dxDateBox("instance");
		   frmDateBox.option("value", new Date(now.getFullYear(), now.getMonth(), 1));
		   toDateBox.option("value", new Date(now.getFullYear(), now.getMonth() + 1, 0));

		   // load initial
		   ddBtnShowRecords_click('range');
	   });

	   function ddBtnShowRecords_click(duration) {
		   var frmDateBox = $("#frmdateBox").dxDateBox("instance");
		   var toDateBox = $("#todateBox").dxDateBox("instance");

		   var frmDate = new Date(frmDateBox.option("value"));
		   var toDate = new Date(toDateBox.option("value"));
		   var currentDate = new Date();

		   switch (duration) {
			   case 'today': frmDate = toDate = currentDate; break;
			   case 'yesterday': var d = new Date(); d.setDate(d.getDate() - 1); frmDate = toDate = d; break;
			   case 'week': var day = currentDate.getDay(); var start = currentDate.getDate() - day; frmDate = new Date(currentDate.setDate(start)); toDate = new Date(currentDate.setDate(start + 6)); break;
			   case 'tillmonth': frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); toDate = currentDate; break;
			   case 'fullmonth': frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1); toDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0); break;
			   case 'tillyear': frmDate = new Date(currentDate.getFullYear(), 0, 1); toDate = currentDate; break;
			   case 'fullyear': frmDate = new Date(currentDate.getFullYear(), 0, 1); toDate = new Date(currentDate.getFullYear(), 11, 31); break;
			   case 'lastmonth': frmDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1); toDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0); break;
			   case 'lastyear': frmDate = new Date(currentDate.getFullYear() - 1, 0, 1); toDate = new Date(currentDate.getFullYear() - 1, 11, 31); break;
		   }

		   frmDateBox.option("value", frmDate);
		   toDateBox.option("value", toDate);

		   $.ajax({
			   url: '/api/EQPurchaseOrder/GetpurchaseDetails',
			   type: 'GET',
			   data: { fromDate: frmDate.toISOString().split('T')[0], toDate: toDate.toISOString().split('T')[0] },
			   success: function (data) {
				   $("#dataGrid").dxDataGrid("instance").option("dataSource", data);
			   },
			   error: function (xhr) {
				   DevExpress.ui.notify("Error while loading data", "error", 2000);
			   }
		   });
	   }

</script>