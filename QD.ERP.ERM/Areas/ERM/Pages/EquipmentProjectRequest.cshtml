	<script>

		  $(function () {
        $("#descPopup").dxPopup({
            title: "Enquiry Detail Description",
            width: 800,
            height: 600,
            showTitle: true,
            visible: false, // hidden by default
            dragEnabled: true,
            closeOnOutsideClick: true,
            contentTemplate: function (contentElement) {
                contentElement.append(`
                    <div class="p-3">
                        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-bottom: 10px;">
                            <div id="btnUseDetailedDescription"></div>
                            <div id="btnUseItemDesc"></div>
                        </div>

                        <div id="DetailedDescription"></div>
                        <div id="Remarks"></div>

                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px;">
                            <div id="Size"></div>
                            <div id="Manufacturer"></div>
                            <div id="Brand"></div>
                            <div id="PartNo"></div>
                            <div id="DeliveryPeriod"></div>
                            <div id="PlanNo"></div>
                        </div>
                    </div>
                `);

                // init DevExtreme widgets inside popup
                $("#btnUseDetailedDescription").dxButton({
                    text: "Use Detailed Description",
                    icon: "info",
                    stylingMode: "outlined"
                });

                $("#btnUseItemDesc").dxButton({
                    text: "Use Item Desc.",
                    icon: "info",
                    stylingMode: "outlined"
                });

                $("#DetailedDescription").dxTextArea({
                    label: "Detailed Description / Specification",
                    labelMode: "floating",
                    height: 80,
                    width: "100%"
                });

                $("#Remarks").dxTextBox({
                    label: "Remarks",
                    labelMode: "floating",
                    width: "100%"
                });

                $("#Size").dxTextBox({
                    label: "Size",
                    labelMode: "floating",
                    disabled: true
                });

                $("#Manufacturer").dxTextBox({
                    label: "Manufacturer",
                    labelMode: "floating",
                    disabled: true
                });

                $("#Brand").dxTextBox({
                    label: "Brand",
                    labelMode: "floating",
                    disabled: true
                });

                $("#PartNo").dxTextBox({
                    label: "Part No",
                    labelMode: "floating",
                    disabled: true
                });

                $("#DeliveryPeriod").dxTextBox({
                    label: "Delivery Period",
                    labelMode: "floating"
                });

                $("#PlanNo").dxTextBox({
                    label: "Plan No",
                    labelMode: "floating"
                });
            }
        });
    });

    // Function to open popup
    function openDescriptionEditor(RequestChildSlNo) {
        var popup = $("#descPopup").dxPopup("instance");
        popup.show();

