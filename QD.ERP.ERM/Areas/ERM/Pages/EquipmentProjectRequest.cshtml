			// Master data fetch
			function loadRequestData(EqiupmentRequestNo) {
				debugger;
				$.ajax({
						url: `/api/AddNewClientRequest1/GetEnquiryProperty?EqiupmentRequestNo=${encodeURIComponent(EqiupmentRequestNo)}`,
					type: "GET",
					dataType: "json",
					success: function (data) {
						if (!data) {
							DevExpress.ui.notify("No data found.", "error", 3000);
							return;
						}

						console.log("Master Response:", data);

						// ✅ Capture approval flag
						isApproved = data.IsApproved;

						// ✅ Disable UI if already approved
						if (isApproved === true) {
							hideAllButtonsExcept([
								"btnPrint1",
								"ddButtonLayout",
								"btnBack",
								"btnAttach"
							]);
							disableAllDropDownsAndSelects();

							const gridInstance = $("#itemGrid").dxDataGrid("instance");
							if (gridInstance) {
								gridInstance.option({
									editing: {
										allowUpdating: false,
										allowAdding: false,
										allowDeleting: false
									},
									selection: {
										mode: "none"
									}
								});
							}
						}

							$("#btnSave").dxButton("instance").option("text", "Update");
							// ✅ Populate master fields
						$("#txtRequestNo").dxTextBox("instance").option("value", data.EqiupmentRequestNo ?? "");
						$("#InvoiceDueDate").dxDateBox("instance").option("value", data.RequestDate ?? null);
						$("#GetProjectDropDown").dxDropDownBox("instance").option("value", data.ClientCode ?? "");
						$("#txtContactName").dxTextBox("instance").option("value", data.RequestedBy ?? "");
						$("#txtReqEmail").dxTextBox("instance").option("value", data.RequesterContactEmail ?? "");
						$("#ContactNo").dxTextBox("instance").option("value", data.RequesterContact ?? "");
						$("#ddGetModeOfRequest").dxDropDownBox("instance").option("value", data.ModeOfRequest ?? "");
						$("#ddGetTypeOfRequest").dxDropDownBox("instance").option("value", data.TypeOfRequest ?? "");
						$("#txtReferenceNo").dxTextBox("instance").option("value", data.ClientRefNo ?? "");
						$("#txtExpectedDate").dxDateBox("instance").option("value", data.ExpectedDate ?? null);
						$("#txtRemarks").dxTextArea("instance").option("value", data.Remarks ?? "");
						$("#ddRequestedBy").dxDropDownBox("instance").option("value", data.TypeOfMpr ?? "");
						$("#ddGetCompany").dxDropDownBox("instance").option("value", data.CompanyBranch ?? "");
						$('#currencyexchangerate').dxNumberBox("instance")?.option("value", data.CurrencyRate);
						$("#ddlGoodsGroup4").dxDropDownBox("instance").option("value", data.BaseCurrencyId);
						$("#ddlGoodsGroup3").dxDropDownBox("instance").option("value", data.CurrencyId);
						$("#ddProject").dxDropDownBox("instance").option("value", data.ProjectMasterCode);

						loadRequestChildren(EqiupmentRequestNo);
					},
					error: function (xhr, status, error) {
						console.error("Error loading master request data:", error);
						DevExpress.ui.notify("Error loading request data: " + (xhr.responseJSON?.message || xhr.statusText), "error", 3000);
					}
				});
			}

				function loadRequestChildren(EqiupmentRequestNo) {
				debugger;
				$.ajax({
						url: `/api/AddNewClientRequest1/GetEnquiryChildren?EquipmentRequestNo=${encodeURIComponent(EqiupmentRequestNo)}`,
					type: "GET",
					dataType: "json",
					success: function (gridData) {
						console.log("Children Response:", gridData);

						if (!Array.isArray(gridData) || gridData.length === 0) {
							DevExpress.ui.notify("No child records found.", "info", 3000);
						}

						const rowData = gridData.map((item, index) => ({
							SNo: index + 1,
							...item
						}));

						const gridInstance = $("#itemGrid").dxDataGrid("instance");
						if (gridInstance) {
							gridInstance.option("dataSource", rowData);
						} else {
							// If not initialized, call initializeItemGrid(rowData);
						}
					},
					error: function (xhr, status, error) {
						console.error("Error loading children:", error);
						DevExpress.ui.notify("Error loading child records: " + (xhr.responseJSON?.message || xhr.statusText), "error", 3000);
					}
				});
			}

