			function unitRateMethodDropDownTemplate(cellElement, cellInfo) {
			const wrapper = $("<div>").css({
				display: "flex",
				alignItems: "center",
				width: "100%",
				minWidth: "600px",
				boxSizing: "border-box",
				gap: "1px"
			});

			const dropDown = $("<div>").dxDropDownBox({
				value: cellInfo.value,
				valueExpr: "UnitCode",
				displayExpr: "UnitDesc",
				deferRendering: false,
				showClearButton: true,
				showDropDownButton: true,
				width: 250,
