		border: 3px solid #282222 !important;
		/*  border-radius: 8px !important; */
	}


	.close {
		color: #aaa;
		float: right;
		font-size: 28px;
		font-weight: bold;
		cursor: pointer;
	}

		.close:hover,
		.close:focus {
			color: black;
		}

	.containerLedgerAccount {
		display: flex;
		align-items: center;
		justify-content: flex-start;
	}

	.titleLedgerAccount {
		display: flex;
		align-items: center;
		justify-content: center;
