	}

	.card1 {
		padding: 15px;
		border: 1px solid #ddd;
		border-radius: 5px;
		box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
		background: #fff;
	}

	.playIcon {
		display: none;
	}

	.plusbtn {
		justify-content: center;
	}

	.center-icon-button {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.mainContainer {
		width: 100%;
		overflow-x: hidden;
	}

	.content-container-top {
		width: 100%;
	}

	.dx-datagrid .dx-data-row td[aria-colindex="3"] {
		text-align: center !important;
	}

	.header-wrap {
		white-space: normal !important; /* Enable word wrap */
		text-align: center !important; /* Center align text */
		display: flex;
		justify-content: center;
		align-items: center;
		font-weight: bold;
	}

	.dx-datagrid-headers .dx-datagrid-table .dx-row > td {
		text-align: center !important;
	}
</style>
<link rel="stylesheet" href="~/css/Site.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
<input id="formId" value="EquipmentEnquiryEdit" type="hidden" />
<div class="dx-card-container">
	<div class="dx-card-header minimal-header">
		<div class="card-title-icon">
			<i class="fas fa-file-invoice-dollar"></i>
		</div>
		<div id="ClientRequestMasterForm" class="titleText no-border-title"></div>
	</div>
</div>
<div class="containerLedgerAccount">
	<div class="content-container-top">
		<div class="dx-fieldset horizontal-container">
			@(Html.DevExtreme().Tabs()
						.Items(items =>
						{
							items.Add().Icon("optionsgear").Text(new JS("formatMessage('Material Requests/Enquiry Details')"));
							items.Add().Icon("accountbox").Text(new JS("formatMessage('Request Details')"));
							items.Add().Icon("card").Text(new JS("formatMessage('Branch/Divisions')"));
							items.Add().Icon("attach").Text(new JS("formatMessage('Signatories')"));
							items.Add().Icon("doller").Text(new JS("formatMessage('Deductions & Currency Details')"));
						})
						.SelectedIndex(0)
						.OnSelectionChanged("onTabSelectionChanged")
						)
		</div>

		<!-- Tab Content -->
		<div class="dx-fieldset">
			<div id="tab-content-1" class="tab-content" style="height: 150px;">
				<table style="width:100%;">
					<!-- Row 1 -->
					<tr style="display:flex; gap: 10px; align-items:end; width:100%;">
						<td colspan="3" style="width:100%;">
							@(Html.DevExtreme().TextBox()
														.Label(new JS("formatMessage('Request No')"))
														.ID("txtRequestNo")
														.ReadOnly(true)
														.LabelMode(EditorLabelMode.Floating)
														.Width("100%")
														)
						</td>

						<td colspan="2" style="width:100%;">
							@(Html.DevExtreme().DateBox()
														.Label(new JS("formatMessage('Requested On')"))
														.ID("InvoiceDueDate")
														.Type(DateBoxType.Date)
														.DisplayFormat("dd-MMM-yyyy")
														.Value(DateTime.Now)
														.LabelMode(EditorLabelMode.Floating)
														.Width("100%")
														)
						</td>

						<td style="display: flex; align-items: end; width:100%;" colspan="2">
							@(Html.DevExtreme().DropDownBox()
														.ID("GetProjectDropDown")
														.Label(new JS("formatMessage('Client Name:')"))
														.LabelMode(EditorLabelMode.Floating)
														.DataSource(d => d.WebApi()
														.Controller("AddNewClientRequest")
														.LoadAction("GetClientDetails")
														.LoadMode(DataSourceLoadMode.Raw)
														.Key("CategoryCode")
														)
														.ValueExpr("ClientCode")
														.DisplayExpr("ClientName")
														.AcceptCustomValue(true)
														.ValueChangeEvent("input")
														.HoverStateEnabled(true)
														.OpenOnFieldClick(false)
														.TabIndex(1)
														.Width("100%")
														.OnInput("dropDownBoxOnInput")
														.Disabled(true)
														.OnOpened("onOpened")
														.OnKeyDown("onKeyDown")
														.ContentTemplate(new TemplateName("GetProjectContentTemplate"))
														.Buttons(buttons =>
														{
							  							// Clear Button
															buttons.Add()
															.Name("clear");

															// Add Client Button
															buttons.Add()
															.Name("AddDebits")
															.Location(TextEditorButtonLocation.After)
															.Widget(w => w.Button()
															.Type(ButtonType.Default)
															.Icon("plus")
															.ElementAttr(new { @class = "custom-hover-button add-hover" })
															.OnClick("AddNewClient")
															);

															// Edit Client Button
															buttons.Add()
															.Name("btnEditClient")
															.Location(TextEditorButtonLocation.After)
															.Widget(w => w.Button()
															.Type(ButtonType.Default)
															.Icon("edit")
															.ElementAttr(new { @class = "custom-hover-button edit-hover" })
															.OnClick(@<text>
										  								function() {
										  								var dropDownBox = $('#GetProjectDropDown').dxDropDownBox('instance');
										  								var selectedValue = dropDownBox.option('value');
										  								if (!selectedValue) {
										  								DevExpress.ui.notify('Please select a client.', 'warning', 2000);
										  								return;
										  								}
										  								var url = '/' + tenantName + '/IMS/ClientLeadMaster?clientCode=' + encodeURIComponent(selectedValue);
										  								openModal(url, 'Client Master');
										  								}
										  							</text>)
															);
															buttons.Add().Name("dropDown");
														})
														)
						</td>
					</tr>

					<!-- Row 2 -->
					<tr style="display: flex; gap: 10px; align-items:end; width:100%;">
						<td colspan="2" style="width:100%; display:flex; align-items:end;">
							@(Html.DevExtreme().TextBox()
														.Label(new JS("formatMessage('Client Contact Name:')"))
														.ID("txtContactName")
														.LabelMode(EditorLabelMode.Floating)
														.Width("100%")
														.Buttons(buttons =>
														{
															buttons.Add()
															.Name("Addcontactname")
															.Location(TextEditorButtonLocation.After)
															.Widget(w => w.Button()
															.Type(ButtonType.Default)
															.Icon("plus")
															.Disabled(true)
															.ElementAttr(new { @class = "custom-hover-button add-hover" })
															.OnClick("AddContactName")
															);
														})
														)
						</td>

						<td colspan="2" style="width:100%;">
							@(Html.DevExtreme().TextBox()
														.Label(new JS("formatMessage('Client Email:')"))
														.ID("txtReqEmail")
														.LabelMode(EditorLabelMode.Floating)													
														.Width("100%")
														.Disabled(true)
														)
						</td>

						<td colspan="2" style="width:100%;">
							@(Html.DevExtreme().TextBox() 
														.ID("ContactNo")
														.Label(new JS("formatMessage('Client Contact No:')"))
														.LabelMode(EditorLabelMode.Floating)
														.Disabled(true)
														.InputAttr(new
														{
															onkeypress = "return event.charCode >= 48 && event.charCode <= 57",
															type = "text",
															maxlength = "15"
														})
														.Width("100%")
														)
						</td>
					</tr>

					<!-- Row 3 -->
					<tr style="display: flex; align-items:end; gap: 10px; width:100%;">
						<td style="display: flex; align-items:end;width:100%;" colspan="2">
							@(Html.DevExtreme().DropDownBox()
														.AcceptCustomValue(true)
														.Label(new JS("formatMessage('Mode of Request:')"))
														.DataSource(d => d.WebApi()
														.Controller("AddNewClientRequest")
														.LoadAction("GetModeOfRequest")
														.LoadMode(DataSourceLoadMode.Raw)
														.Key("ModeOfRequestId")
														)
														.LabelMode(EditorLabelMode.Floating)
														.ID("ddGetModeOfRequest")
														.OpenOnFieldClick(false)
														.ValueChangeEvent("input")
														.HoverStateEnabled(true)
														.ValueExpr("ModeOfRequestId")
														.DisplayExpr("ModeOfRequest")
														.OnInput("dropDownBoxOnInput")
														.OnOpened("onOpened")
														.TabIndex(1)
														.Width("100%")
														.OnKeyDown("onKeyDown")
														.ContentTemplate(new TemplateName("GetModeOfRequestContentTemplate"))
														.Buttons(buttons =>
														{
															buttons.Add()
															.Name("AddModeReq")
															.Location(TextEditorButtonLocation.After)
															.Widget(w => w.Button()
															.Type(ButtonType.Default)
															.Icon("plus")
															.ElementAttr(new { @class = "custom-hover-button add-hover" })
															.OnClick("AddModeReq")
															);
															buttons.Add().Name("dropDown");
														})
														)
						</td>

						<td style="display: flex; align-items:end;width:100%;" colspan="2">
							@(Html.DevExtreme().DropDownBox()
														.AcceptCustomValue(true)
														.Label(new JS("formatMessage('Type of Request:')"))
														.DataSource(d => d.WebApi()
														.Controller("AddNewClientRequest")
														.LoadAction("GetTypeOfRequest")
														.LoadMode(DataSourceLoadMode.Raw)
														.Key("TypeOfRequestId")
														)
														.LabelMode(EditorLabelMode.Floating)
														.ID("ddGetTypeOfRequest")
														.OpenOnFieldClick(false)
														.ValueChangeEvent("input")
														.HoverStateEnabled(true)
														.ValueExpr("TypeOfRequestId")
														.DisplayExpr("TypeOfRequest")
														.OnInput("dropDownBoxOnInput")
														.OnOpened("onOpened")
														.TabIndex(1)
														.Width("100%")
														.OnKeyDown("onKeyDown")
														.ContentTemplate(new TemplateName("GetTypeOfRequestContentTemplate"))
														.Buttons(buttons =>
														{
															buttons.Add()
															.Name("AddTypeReq")
															.Location(TextEditorButtonLocation.After)
															.Widget(w => w.Button()
															.Type(ButtonType.Default)
															.Icon("plus")
															.ElementAttr(new { @class = "custom-hover-button add-hover" })
															.OnClick("AddTypeReq")
															);
															buttons.Add().Name("dropDown");
														})
														)
						</td>

						<td colspan="2" style="width:100%;">
							@(Html.DevExtreme().TextBox()
														.Label(new JS("formatMessage('Client Reference No:')"))
														.ID("txtReferenceNo")
														.Disabled(true)
														.LabelMode(EditorLabelMode.Floating)
														.Width("100%")
														)
						</td>
						<td style="display: flex;align-items:end;width:100%;" colspan="2">
							@(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
											.Label(new JS("formatMessage('Project:')"))
											.DataSource(d => d.WebApi()
											.Controller("AddNewClientRequest")
											.LoadAction("GetProject")
											.LoadMode(DataSourceLoadMode.Raw)
											.Key("ProjectId")
											)
											.LabelMode(EditorLabelMode.Floating)
											.ID("ddProject")
											.Width(900)
											.OpenOnFieldClick(false)
											.ValueChangeEvent("input")
											.HoverStateEnabled(true)
											.ValueExpr("ProjectId")
											.DisplayExpr("ProjectDescription")
											.OnInput("dropDownBoxOnInput")
											.OnOpened("onOpened")
											.TabIndex(1)
											.Width("100%")
											.OnKeyDown("onKeyDown")
											.ContentTemplate(new TemplateName("GetProjectTemplate"))
											)
						</td>
					</tr>
				</table>
			</div>

			<!-- Tab 2 -->
			<div id="tab-content-2" class="tab-content" style="height: 150px;">
				<div class="card-container">
					<!-- First Card (Left Side) -->
					<table width="100%" style="font-size:14px; margin:5px 0;" cellpadding="5">
						<tr>
							<td colspan="1" style="display:flex; gap: 5px;">
								@(Html.DevExtreme().DateBox()
																.Label(new JS("formatMessage('Expected Date:')"))
																.ID("txtExpectedDate")
																.Type(DateBoxType.Date)
																.DisplayFormat("dd-MMM-yyyy")
																.LabelMode(EditorLabelMode.Floating)
																)
							</td>
						</tr>
					</table>

					<!-- Second Card (Right Side) -->
					<table width="100%" style="font-size:14px; margin:10px 0;" cellpadding="5">
						<tr>
							<td>
								@(Html.DevExtreme().TextArea()
																.ID("txtRemarks")
																.Label(new JS("formatMessage('Remarks:')"))
																.ElementAttr("style", "height:120px !important;")
																.LabelMode(EditorLabelMode.Floating)
																.Width(775)
																)
							</td>
						</tr>
					</table>
				</div>
			</div>

			<!-- Tab 3 -->
			<div id="tab-content-3" class="tab-content" style="height: 150px;">
				<div class="row">
					<!-- Card 1 -->
					<div class="col-6">
						<div class="row" style="font-size:14px;">
							<div class="col-12">
								@(Html.DevExtreme().DropDownBox()
																.AcceptCustomValue(true)
																.Label(new JS("formatMessage('Company Branch/Division:')"))
																.DataSource(d => d.WebApi()
																.Controller("AddNewClientRequest")
																.LoadAction("GetCompany")
																.LoadMode(DataSourceLoadMode.Raw)
																.Key("CompanyId")
																)
																.LabelMode(EditorLabelMode.Floating)
																.ID("ddGetCompany")
																.Width(900)
																.OpenOnFieldClick(false)
																.ValueChangeEvent("input")
																.HoverStateEnabled(true)
																.ValueExpr("CompanyId")
																.DisplayExpr("CompanyName")
																.OnInput("dropDownBoxOnInput")
																.OnOpened("onOpened")
																.TabIndex(1)
																.Width("100%")
																.OnKeyDown("onKeyDown")
																.ContentTemplate(new TemplateName("GetCompanyContentTemplate"))
																)
							</div>

							<div class="col-6">
								@(Html.DevExtreme().DropDownBox()
											.Label(new JS("formatMessage('Requested By(MPR Type):')"))
											.DataSource(d => d.WebApi()
											.Controller("AddNewClientRequest")
											.LoadAction("GetMPRRequesterBy")
											.LoadMode(DataSourceLoadMode.Raw)
											.Key("RequestedByCode")
											)
											.LabelMode(EditorLabelMode.Floating)
											.ID("ddRequestedBy")
											.Width(900)
											.Disabled(true)
											.OpenOnFieldClick(false)
											.ValueChangeEvent("input")
											.HoverStateEnabled(true)
											.Value(4)
											.ValueExpr("RequestedByCode")
											.DisplayExpr("RequestedBy")
											.OnInput("dropDownBoxOnInput")
											.OnOpened("onOpened")
											.TabIndex(1)
											.Width("100%")
											.OnKeyDown("onKeyDown")
											.ContentTemplate(new TemplateName("GetMPRRequesterByContentTemplate"))
											)
							</div>
							<div class="col-6">
								@(Html.DevExtreme().DropDownBox().AcceptCustomValue(true)
																.Label(new JS("formatMessage('Requested/Enquiry Status:')"))
																.DataSource(d => d.WebApi()
																.Controller("AddNewClientRequest")
																.LoadAction("GetEnquiry")
																.LoadMode(DataSourceLoadMode.Raw)
																.Key("PurchaseRequestStatusId")
																)
																.LabelMode(EditorLabelMode.Floating)
																.ID("ddGetEnquiry")
																.Width(900)
																.OpenOnFieldClick(false)
																.ValueChangeEvent("input")
																.HoverStateEnabled(true)
																.ValueExpr("PurchaseRequestStatusId")
																.DisplayExpr("PurchaseRequestStatus")
																.OnInput("dropDownBoxOnInput")
																.OnOpened("onOpened")
																.TabIndex(1)
																.Width("100%")
																.OnKeyDown("onKeyDown")
																.ContentTemplate(new TemplateName("GetEnquiryContentTemplate"))
																)

							</div>
						</div>
					</div>
				</div>
			</div>

